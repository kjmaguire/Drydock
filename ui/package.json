{
  "name": "drydock-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Drydock UI: Remix 3 components + TypeScript. A projection of the Go core's persisted events plus RPC reads; it holds no authority.",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "e2e": "playwright test",
    "doctor": "remix doctor"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@remix-run/ui": "0.12.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide": "1.54.0",
    "marked": "18.1.0",
    "monaco-editor": "0.57.0",
    "remix": "3.0.0"
  },
  "devDependencies": {
    "@pitlane/vite-plugin-remix": "0.8.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "esbuild": "0.28.2"
  }
}
