// Wrangler configuration for the Drydock golden starter (Wrangler 4.148.0).
//
// ---------------------------------------------------------------------------
// D6: PREVIEW / PRODUCTION SEPARATION (read before editing this file)
// ---------------------------------------------------------------------------
// Cloudflare is an agent-side template in Drydock (decision D6), not part of
// Drydock's own infrastructure. The rules that protect a project built from
// this starter are:
//   1. The top-level bindings below are PRODUCTION. Agents never deploy them.
//      `wrangler deploy` is not on any agent's command allowlist, and no
//      production API token may exist in an agent process.
//   2. Agents may only run `wrangler preview` (or `wrangler versions upload`
//      for CI that cannot use previews). A preview does NOT inherit production
//      settings, and its KV / D1 / R2 are isolated ONLY IF the `previews` block
//      binds SEPARATE resources. That is what the `previews` block below does:
//      every preview binding points at a different D1 database, KV namespace
//      and R2 bucket than production. Never copy a production id into it.
//   3. Cloudflare API tokens cannot separate "upload a preview" from "go live"
//      (both need Workers Scripts Write). The real boundary is therefore an
//      account boundary (use a separate Cloudflare account for previews, or
//      none) plus the agent command allowlist, not a token scope.
//   4. `wrangler versions upload` Version URLs reuse the Worker's TOP-LEVEL
//      (production) bindings. Prefer `wrangler preview`.
//   5. Services, routes, cron triggers, Workflows and queue consumers are NOT
//      isolated by the previews block. This starter declares none of them. If
//      you add one, give the preview its own copy or leave it out of previews.
//
// The ids below are placeholders: this repository holds no Cloudflare
// credentials. `wrangler dev` and the test suite run entirely against local
// simulators and never read them. Replace them (via `wrangler d1 create`,
// `wrangler kv namespace create`, `wrangler r2 bucket create`) in the account
// that owns each environment.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "starter-cloudflare-saas",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Non-secret configuration. ALLOW_DEV_LOGIN must never be "true" here: it is
  // switched on only locally, through .dev.vars (see .dev.vars.example).
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOW_DEV_LOGIN": "false"
  },

  // Secrets are never written in this file. Locally they come from .dev.vars;
  // remotely from `wrangler secret put` / `wrangler preview secret put`.
  "secrets": { "required": ["SESSION_SECRET"] },

  // PRODUCTION bindings.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starter-saas-prod",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_PRODUCTION_KV_NAMESPACE_ID" }],
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "starter-saas-attachments-prod" }],

  // PREVIEW bindings (D6). Same binding names, DIFFERENT resources.
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "ALLOW_DEV_LOGIN": "false"
    },
    // Preview secrets are set per preview: `wrangler preview secret put SESSION_SECRET`.
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "starter-saas-preview",
        "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
        "migrations_dir": "migrations"
      }
    ],
    "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID" }],
    "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "starter-saas-attachments-preview" }]
  }
}
