{
  "name": "starter-cloudflare-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drydock golden starter: minimal Cloudflare SaaS (Workers + Hono + D1 + KV + R2 + React Router 7 SSR).",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "install:deps": "npm install",
    "types": "wrangler types",
    "build": "react-router build",
    "test": "vitest run",
    "lint": "biome lint --reporter=github .",
    "lint:json": "biome lint --reporter=json .",
    "typecheck": "react-router typegen && wrangler types --check && tsc --noEmit",
    "e2e": "playwright test",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/preview.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state"
  },
  "dependencies": {
    "hono": "4.13.13",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/vitest-plugin": "1.3.7",
    "@playwright/test": "1.64.0",
    "@react-router/dev": "7.18.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  }
}
