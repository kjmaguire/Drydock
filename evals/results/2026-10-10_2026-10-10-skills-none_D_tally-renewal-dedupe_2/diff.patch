+func TestRenewDueGoesOnPastAFailure(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	broken, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	healthy, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// An invoice already exists for the period the renewal would invoice, as an older renewal left it. The renewal moves the
+	// subscription on without a second invoice or a second charge, and the other subscription is renewed too.
+	end := broken.CurrentPeriodEnd
+	existing, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, SubscriptionID: broken.ID, Currency: money.USD,
+		PeriodStart: &end, PeriodEnd: &end}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	charges := len(e.Gateway.Charges())
+	e.Clock.Set(end)
+	n, err := e.Subs.RenewDue(ctx)
+	if err != nil || n != 2 {
+		t.Fatalf("RenewDue = %d, %v, want both subscriptions renewed", n, err)
+	}
+	for _, id := range []string{healthy.ID, broken.ID} {
+		if got, _ := e.Store.Subscription(e.Acme.ID, id); !got.CurrentPeriodStart.Equal(e.Clock.Now()) || got.Status != store.Active {
+			t.Fatalf("subscription %s = %+v, not renewed", id, got)
+		}
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: broken.ID}); len(invs) != 2 || !hasInvoice(invs, existing.ID) {
+		t.Fatalf("broken subscription's invoices = %+v, want the first period and the existing one, nothing new", invs)
+	}
+	if got := len(e.Gateway.Charges()); got != charges+1 {
+		t.Fatalf("charges = %d, want %d: only the healthy subscription's renewal is charged", got, charges+1)
+	}
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+		t.Fatalf("RenewDue again = %d, %v, want nothing due", n, err)
+	}
+}
