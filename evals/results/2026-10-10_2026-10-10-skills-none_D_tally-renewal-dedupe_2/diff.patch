+		if got.Status != want.status || !got.CurrentPeriodStart.Equal(e.Clock.Now()) {
+			t.Fatalf("subscription = %+v, want status %s in the new period", got, want.status)
+		}
+	}
+	if open := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{Status: store.InvoiceOpen}); len(open) != 3 {
+		t.Fatalf("open invoices = %d, want the two renewals and the declined first period", len(open))
+	}
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+		t.Fatalf("RenewDue again = %d, %v", n, err)
+	}
+	if n := countCharges(e.Gateway.Calls(), "pm_gateway_down"); n != 2 {
+		t.Fatalf("the gateway was asked %d times, want once per subscription", n)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{}); len(invs) != 4 {
+		t.Fatalf("invoices = %d after a second run, want no new ones", len(invs))
+	}
+}
+
+func hasInvoice(invs []store.Invoice, id string) bool {
+	for _, inv := range invs {
+		if inv.ID == id {
+			return true
+		}
+	}
+	return false
+}
+
+func countCharges(calls []payments.ChargeRequest, paymentMethod string) int {
+	n := 0
+	for _, c := range calls {
+		if c.PaymentMethod == paymentMethod {
+			n++
+		}
+	}
+	return n
+}
