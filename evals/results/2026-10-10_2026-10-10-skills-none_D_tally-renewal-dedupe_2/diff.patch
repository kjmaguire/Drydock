+func TestMeteredRenewalOfAnAlreadyInvoicedPeriod(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, UnitAmount: 2, Interval: store.Monthly, UsageType: store.Metered}, e.Clock.Now())
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	start, end := sub.CurrentPeriodStart, sub.CurrentPeriodEnd
+	if _, err := e.Store.AddUsage(e.Acme.ID, sub.ID, 100, start, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	// An older renewal invoiced the ended period and gave up without moving the subscription on, so the period is still
+	// current and its invoice exists already.
+	dup, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, SubscriptionID: sub.ID, Currency: money.USD,
+		PeriodStart: &start, PeriodEnd: &end}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	charges := len(e.Gateway.Calls())
+	e.Clock.Set(end)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v, want the subscription renewed", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(end) || !got.CurrentPeriodEnd.Equal(end.AddDate(0, 1, 0)) {
+		t.Fatalf("subscription = %+v, want the next period", got)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 || invs[0].ID != dup.ID {
+		t.Fatalf("invoices = %+v, want only the existing invoice (a metered plan is not invoiced in advance)", invs)
+	}
+	if n := len(e.Gateway.Calls()); n != charges {
+		t.Fatalf("the gateway was asked %d more times, want no charge for the period", n-charges)
+	}
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+		t.Fatalf("RenewDue again = %d, %v, want nothing due", n, err)
+	}
+}
