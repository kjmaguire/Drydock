diff --git a/start/internal/billing/invoice.go b/result/internal/billing/invoice.go
index b22d367..ea24ccf 100644
--- a/start/internal/billing/invoice.go
+++ b/result/internal/billing/invoice.go
@@ -11,15 +11,21 @@ type Totals struct {
 	TotalCents    int64 `json:"total_cents"`
 }
 
-// Compute returns the totals of an invoice: the subtotal of its lines, the credit and the coupon, then tax.
+// Compute returns the totals of an invoice. The coupon is taken off the subtotal first, then the credit,
+// and tax is charged on what remains. The amount after discounts never goes below zero.
 func Compute(inv store.Invoice) Totals {
 	var subtotal int64
 	for _, l := range inv.Lines {
 		subtotal += int64(l.Quantity) * l.UnitCents
 	}
-	afterCredit := subtotal - inv.CreditCents
-	coupon := afterCredit * int64(inv.CouponPercent) / 100
-	discounted := afterCredit - coupon
-	tax := discounted * int64(inv.TaxRateBP) / 10000
-	return Totals{SubtotalCents: subtotal, DiscountCents: subtotal - discounted, TaxCents: tax, TotalCents: discounted + tax}
+	coupon := roundHalfUp(subtotal*int64(inv.CouponPercent), 100)
+	afterDiscounts := max(subtotal-coupon-inv.CreditCents, 0)
+	tax := roundHalfUp(afterDiscounts*int64(inv.TaxRateBP), 10000)
+	return Totals{SubtotalCents: subtotal, DiscountCents: subtotal - afterDiscounts, TaxCents: tax, TotalCents: afterDiscounts + tax}
+}
+
+// roundHalfUp returns num/den rounded to the nearest integer, with halves rounded up.
+// It expects num >= 0 and den > 0.
+func roundHalfUp(num, den int64) int64 {
+	return (2*num + den) / (2 * den)
 }
diff --git a/start/internal/billing/invoice_test.go b/result/internal/billing/invoice_test.go
index 7e5563c..b08b928 100644
--- a/start/internal/billing/invoice_test.go
+++ b/result/internal/billing/invoice_test.go
@@ -21,3 +21,75 @@ func TestTaxIsAddedToTheSubtotal(t *testing.T) {
 		t.Fatalf("got %+v, want %+v", got, want)
 	}
 }
+
+func TestComputeFollowsTheDiscountAndTaxRules(t *testing.T) {
+	tests := []struct {
+		name string
+		inv  store.Invoice
+		want Totals
+	}{
+		{
+			name: "coupon is taken off the subtotal before the credit",
+			inv: store.Invoice{
+				Lines:         []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 10000}},
+				CouponPercent: 10,
+				CreditCents:   500,
+			},
+			want: Totals{SubtotalCents: 10000, DiscountCents: 1500, TotalCents: 8500},
+		},
+		{
+			name: "coupon, credit and tax together",
+			inv: store.Invoice{
+				Lines:         []store.LineItem{{Description: "Pro plan", Quantity: 3, UnitCents: 1999}},
+				CouponPercent: 15,
+				CreditCents:   297,
+				TaxRateBP:     825,
+			},
+			want: Totals{SubtotalCents: 5997, DiscountCents: 1197, TaxCents: 396, TotalCents: 5196},
+		},
+		{
+			name: "coupon amount rounds half up to a cent",
+			inv: store.Invoice{
+				Lines:         []store.LineItem{{Description: "Add-on", Quantity: 1, UnitCents: 1005}},
+				CouponPercent: 50,
+			},
+			// 502.5 rounds to 503, so 502 is left.
+			want: Totals{SubtotalCents: 1005, DiscountCents: 503, TotalCents: 502},
+		},
+		{
+			name: "tax rounds half up to a cent",
+			inv: store.Invoice{
+				Lines:     []store.LineItem{{Description: "Pro plan", Quantity: 1, UnitCents: 1000}},
+				TaxRateBP: 825,
+			},
+			// 82.5 rounds to 83.
+			want: Totals{SubtotalCents: 1000, TaxCents: 83, TotalCents: 1083},
+		},
+		{
+			name: "credit larger than the invoice leaves zero and no tax",
+			inv: store.Invoice{
+				Lines:       []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 1000}},
+				CreditCents: 5000,
+				TaxRateBP:   825,
+			},
+			want: Totals{SubtotalCents: 1000, DiscountCents: 1000},
+		},
+		{
+			name: "coupon and credit together never take the amount below zero",
+			inv: store.Invoice{
+				Lines:         []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 1000}},
+				CouponPercent: 50,
+				CreditCents:   800,
+				TaxRateBP:     825,
+			},
+			want: Totals{SubtotalCents: 1000, DiscountCents: 1000},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := Compute(tt.inv); got != tt.want {
+				t.Fatalf("got %+v, want %+v", got, tt.want)
+			}
+		})
+	}
+}
