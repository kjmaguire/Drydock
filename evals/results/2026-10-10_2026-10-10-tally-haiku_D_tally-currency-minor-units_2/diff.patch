+// FormatMajor renders an amount in major units with the currency's decimals and no symbol or thousands separator: "12.50",
+// "1000", "1.250". It is the form ParseMajor reads back.
+func FormatMajor(amount int64, c Currency) string {
+	sign := ""
+	if amount < 0 {
+		sign, amount = "-", -amount
+	}
+	whole, frac := split(amount, c)
+	return sign + strconv.FormatInt(whole, 10) + frac
+}
+
+// split divides a non-negative amount into its major units and the decimal part, which is "" for a currency with no decimals
+// and ".50" for USD 50 cents.
+func split(amount int64, c Currency) (int64, string) {
+	d := c.MinorUnits()
+	if d == 0 {
+		return amount, ""
+	}
+	scale := int64(1)
+	for i := 0; i < d; i++ {
+		scale *= 10
+	}
+	return amount / scale, fmt.Sprintf(".%0*d", d, amount%scale)
 }
 
