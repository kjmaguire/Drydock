+// signedPayload is what a v1 signature covers: "<t>.<body>", t being the timestamp in Unix seconds.
+func signedPayload(t int64, body []byte) []byte {
+	return append([]byte(strconv.FormatInt(t, 10)+"."), body...)
+}
+
+// SignatureHeader returns the Tally-Signature header of a delivery of body sent at t: "t=<unix seconds>" and a "v1=" entry
+// for each secret, the signature of "<t>.<body>". The secrets are listed current first.
+func SignatureHeader(secrets []string, t time.Time, body []byte) string {
+	ts := t.Unix()
+	parts := []string{"t=" + strconv.FormatInt(ts, 10)}
+	for _, secret := range secrets {
+		parts = append(parts, "v1="+Sign(secret, signedPayload(ts, body)))
+	}
+	return strings.Join(parts, ",")
+}
+
+// Verify checks a delivery's Tally-Signature header against its payload. The header's timestamp must be within tolerance of
+// now in either direction (0 means 5 minutes), and one of its v1 entries must equal the signature of the payload with one
+// of the secrets. The signatures are compared in constant time.
+func Verify(payload []byte, header string, secrets []string, tolerance time.Duration, now time.Time) error {
+	var (
+		ts      int64
+		hasTime bool
+		v1s     []string
+	)
+	for _, pair := range strings.Split(header, ",") {
+		k, v, ok := strings.Cut(strings.TrimSpace(pair), "=")
+		if !ok {
+			return fmt.Errorf("%w: %q is not key=value", ErrMalformedHeader, strings.TrimSpace(pair))
+		}
+		k, v = strings.TrimSpace(k), strings.TrimSpace(v)
+		switch k {
+		case "t":
+			n, err := strconv.ParseInt(v, 10, 64)
+			if err != nil {
+				return fmt.Errorf("%w: the timestamp %q is not an integer", ErrMalformedHeader, v)
+			}
+			if !hasTime {
+				ts, hasTime = n, true
+			}
+		case "v1":
+			v1s = append(v1s, v)
+		}
+	}
+	if !hasTime {
+		return ErrNoTimestamp
+	}
+	if tolerance == 0 {
+		tolerance = defaultTolerance
+	}
+	age := now.Sub(time.Unix(ts, 0))
+	if age < 0 {
+		age = -age
+	}
+	if age > tolerance {
+		return fmt.Errorf("%w: the timestamp is %v from now, the tolerance is %v", ErrTimestampTolerance, age.Round(time.Second), tolerance)
+	}
+	if len(v1s) == 0 {
+		return ErrNoSignature
+	}
+	signed := signedPayload(ts, payload)
+	for _, secret := range secrets {
+		want := Sign(secret, signed)
+		for _, got := range v1s {
+			if hmac.Equal([]byte(got), []byte(want)) {
+				return nil
+			}
+		}
+	}
+	return ErrSignatureMismatch
+}
