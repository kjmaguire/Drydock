+// rotateSecret gives an endpoint a new signing secret. The previous one keeps signing its deliveries for webhooks.SecretOverlap.
+func (s *Server) rotateSecret(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	ep, err := s.store.UpdateWebhookEndpoint(p.OrgID, r.PathValue("id"), func(ep *store.WebhookEndpoint) error {
+		now := s.clock.Now()
+		ep.PreviousSecret, ep.Secret = ep.Secret, webhooks.NewSecret()
+		ep.RotatedAt = &now
+		return nil
+	})
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusOK, ep)
+}
