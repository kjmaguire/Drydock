+// secretsAt returns the secrets that sign a delivery sent at now: the endpoint's secret, then its previous secret while it is
+// within SecretOverlap of the last rotation.
+func secretsAt(ep store.WebhookEndpoint, now time.Time) []string {
+	secrets := []string{ep.Secret}
+	if ep.PreviousSecret != "" && ep.RotatedAt != nil && now.Before(ep.RotatedAt.Add(SecretOverlap)) {
+		secrets = append(secrets, ep.PreviousSecret)
+	}
+	return secrets
+}
