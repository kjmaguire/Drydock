+func TestVerify(t *testing.T) {
+	now := time.Unix(1700000000, 0)
+	ts := now.Unix()
+	body := []byte(`{"id":"evt_1"}`)
+	sig := func(secret string) string { return webhooks.Sign(secret, []byte(fmt.Sprintf("%d.%s", ts, body))) }
+	valid := fmt.Sprintf("t=%d,v1=%s", ts, sig("whsec_a"))
+	one := []string{"whsec_a"}
+	cases := []struct {
+		name    string
+		header  string
+		payload []byte
+		secrets []string
+		tol     time.Duration
+		now     time.Time
+		want    error
+	}{
+		{"valid", valid, body, one, 0, now, nil},
+		{"spaces, unknown keys and order", fmt.Sprintf(" v0=zz , v1=%s , t=%d ", sig("whsec_a"), ts), body, one, 0, now, nil},
+		{"any of the secrets", valid, body, []string{"whsec_b", "whsec_a"}, 0, now, nil},
+		{"any v1 entry", fmt.Sprintf("t=%d,v1=bad,v1=%s", ts, sig("whsec_a")), body, one, 0, now, nil},
+		{"wrong secret", valid, body, []string{"whsec_b"}, 0, now, webhooks.ErrSignatureMismatch},
+		{"no secrets", valid, body, nil, 0, now, webhooks.ErrSignatureMismatch},
+		{"changed payload", valid, []byte(`{"id":"evt_2"}`), one, 0, now, webhooks.ErrSignatureMismatch},
+		{"signature of another timestamp", fmt.Sprintf("t=%d,v1=%s", ts+1, sig("whsec_a")), body, one, 0, now, webhooks.ErrSignatureMismatch},
+		{"default tolerance, 5 minutes old", valid, body, one, 0, now.Add(5 * time.Minute), nil},
+		{"default tolerance, older", valid, body, one, 0, now.Add(5*time.Minute + time.Second), webhooks.ErrTimestampTolerance},
+		{"default tolerance, 5 minutes ahead", valid, body, one, 0, now.Add(-5 * time.Minute), nil},
+		{"default tolerance, further ahead", valid, body, one, 0, now.Add(-5*time.Minute - time.Second), webhooks.ErrTimestampTolerance},
+		{"explicit tolerance", valid, body, one, 10 * time.Second, now.Add(-10 * time.Second), nil},
+		{"explicit tolerance exceeded", valid, body, one, 10 * time.Second, now.Add(11 * time.Second), webhooks.ErrTimestampTolerance},
+		{"empty header", "", body, one, 0, now, webhooks.ErrMalformedHeader},
+		{"pair without =", "t=1,v1", body, one, 0, now, webhooks.ErrMalformedHeader},
+		{"empty pair", valid + ",", body, one, 0, now, webhooks.ErrMalformedHeader},
+		{"timestamp not an integer", "t=soon,v1=x", body, one, 0, now, webhooks.ErrMalformedHeader},
+		{"timestamp with a fraction", "t=1.5,v1=x", body, one, 0, now, webhooks.ErrMalformedHeader},
+		{"no timestamp", fmt.Sprintf("v1=%s", sig("whsec_a")), body, one, 0, now, webhooks.ErrNoTimestamp},
+		{"no v1 entry", fmt.Sprintf("t=%d,v0=%s", ts, sig("whsec_a")), body, one, 0, now, webhooks.ErrNoSignature},
+		{"malformed before no timestamp", "v1=x,oops", body, one, 0, now, webhooks.ErrMalformedHeader},
+		{"tolerance before no v1 entry", fmt.Sprintf("t=%d", ts), body, one, 0, now.Add(time.Hour), webhooks.ErrTimestampTolerance},
