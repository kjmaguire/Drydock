+func TestRotatedSecretSignsDeliveries(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	secret := regexp.MustCompile(`^whsec_[0-9a-f]{32}$`)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	original := ep.Secret
+
+	// deliver publishes an event, delivers it and returns what the receiver got.
+	deliver := func() apitest.Request {
+		t.Helper()
+		if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+			t.Fatal(err)
+		}
+		if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+			t.Fatalf("RunDue = %d, %v", n, err)
+		}
+		reqs := e.HTTP.Requests()
+		return reqs[len(reqs)-1]
+	}
+	// header is the signature header the receiver should get for r, sent now, signed with secrets.
+	header := func(r apitest.Request, secrets ...string) string {
+		return webhooks.SignatureHeader(secrets, e.Clock.Now(), r.Body)
+	}
+	// rotate rotates the endpoint's secret, checks that the previous one is previous, and returns the new one.
+	rotate := func(previous string) string {
+		t.Helper()
+		var rotated store.WebhookEndpoint
+		e.MustDo(http.StatusOK, "POST", "/v1/webhook-endpoints/"+ep.ID+"/rotate-secret", e.Acme.Key, nil, &rotated)
+		if !secret.MatchString(rotated.Secret) || rotated.Secret == previous || rotated.PreviousSecret != previous {
+			t.Fatalf("rotated endpoint = %+v", rotated)
+		}
+		return rotated.Secret
+	}
+
+	if r := e.Do("POST", "/v1/webhook-endpoints/we_missing/rotate-secret", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("rotating a missing endpoint: %s", r)
+	}
+	if r := deliver(); r.Header.Get("Tally-Signature") != header(r, original) {
+		t.Fatalf("before rotation: signature %q", r.Header.Get("Tally-Signature"))
+	}
+
+	first := rotate(original)
+	e.Clock.Advance(time.Hour)
+	second := rotate(first)
+	r := deliver()
+	got := r.Header.Get("Tally-Signature")
+	if want := header(r, second, first); got != want {
+		t.Fatalf("after two rotations: signature %q, want %q", got, want)
+	}
+	if err := webhooks.Verify(r.Body, got, []string{second}, 0, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if err := webhooks.Verify(r.Body, got, []string{original}, 0, e.Clock.Now()); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Fatalf("the secret before the previous one still verifies: %v", err)
+	}
+
+	// The previous secret signs for SecretOverlap after the last rotation, and no longer.
+	e.Clock.Advance(webhooks.SecretOverlap - time.Minute)
+	if r = deliver(); r.Header.Get("Tally-Signature") != header(r, second, first) {
+		t.Fatalf("23h59m after the last rotation: signature %q", r.Header.Get("Tally-Signature"))
+	}
+	e.Clock.Advance(time.Minute)
+	if r = deliver(); r.Header.Get("Tally-Signature") != header(r, second) {
+		t.Fatalf("a day after the last rotation: signature %q", r.Header.Get("Tally-Signature"))
+	}
+}
