+// RestoreCustomer undoes the deletion of a customer. It works only within customerRetention of the deletion: for a customer
+// that is not deleted, or was deleted longer ago, it returns ErrNotFound. When another customer of the organization now uses
+// the email address, it returns ErrEmailTaken.
+func (s *Store) RestoreCustomer(orgID, id string, now time.Time) (Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt == nil || c.DeletedAt.Before(now.Add(-customerRetention)) {
+		return Customer{}, ErrNotFound
+	}
+	key := normEmail(c.Email)
+	for otherID, other := range s.customers {
+		if otherID != id && other.OrgID == orgID && other.DeletedAt == nil && normEmail(other.Email) == key {
+			return Customer{}, ErrEmailTaken
+		}
+	}
+	c.DeletedAt = nil
+	s.customers[id] = c
+	s.customersByEmail[key] = id
+	return copyCustomer(c), nil
+}
+
+// PurgeDeletedCustomers removes the customers deleted more than customerRetention before now, for good. Their invoices and
+// payments stay, with no customer. It returns how many customers it removed.
+func (s *Store) PurgeDeletedCustomers(now time.Time) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	cutoff := now.Add(-customerRetention)
+	n := 0
+	for id, c := range s.customers {
+		if c.DeletedAt != nil && c.DeletedAt.Before(cutoff) {
+			delete(s.customers, id)
+			n++
+		}
+	}
+	return n
+}
