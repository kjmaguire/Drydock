+	a := newOrg(t, s, "A")
+	jane, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	john, _ := s.CreateCustomer(a.ID, "John", "john@example.com", t0)
+	p, _ := s.CreatePlan(Plan{OrgID: a.ID, Name: "Pro", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, t0)
+	sub, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: jane.ID, PlanID: p.ID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.DeleteCustomerAt(a.ID, jane.ID, t0); !errors.Is(err, ErrHasActiveSubscriptions) {
+		t.Fatalf("delete with an active subscription: %v", err)
+	}
+	if _, err := s.UpdateSubscription(a.ID, sub.ID, func(x *Subscription) error { x.Status = Canceled; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	inv, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: jane.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	deletedAt := t0.Add(time.Hour)
+	if err := s.DeleteCustomerAt(a.ID, jane.ID, deletedAt); err != nil {
+		t.Fatalf("delete: %v", err)
+	}
+	if err := s.DeleteCustomerAt(a.ID, jane.ID, deletedAt); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("delete twice: %v", err)
+	}
+	if _, ok := s.Customer(a.ID, jane.ID); ok {
+		t.Fatal("deleted customer is visible")
+	}
+	if _, err := s.UpdateCustomer(a.ID, jane.ID, func(c *Customer) error { c.Name = "Jane 2"; return nil }); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("update deleted: %v", err)
+	}
+	if got := s.Customers(a.ID); len(got) != 1 || got[0].ID != john.ID {
+		t.Fatalf("Customers = %+v", got)
+	}
+	if got := s.SearchCustomers(a.ID, "jane"); len(got) != 0 {
+		t.Fatalf("SearchCustomers = %+v", got)
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); ok {
+		t.Fatal("FindCustomerByEmail found a deleted customer")
+	}
+	if c, ok := s.CustomerIncludingDeleted(a.ID, jane.ID); !ok || c.DeletedAt == nil || !c.DeletedAt.Equal(deletedAt) {
+		t.Fatalf("CustomerIncludingDeleted = %+v, %v", c, ok)
+	}
+	if got := s.CustomersIncludingDeleted(a.ID); len(got) != 2 {
+		t.Fatalf("CustomersIncludingDeleted = %+v", got)
+	}
+	if _, ok := s.Invoice(a.ID, inv.ID); !ok {
+		t.Fatal("the deleted customer's invoice is gone")
+	}
+	if _, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: jane.ID, PlanID: p.ID, Quantity: 1, Status: Active}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for a deleted customer: %v", err)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: jane.ID, Currency: money.USD, Lines: []Line{{Description: "y", Quantity: 1, UnitAmount: 1}}}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for a deleted customer: %v", err)
+	}
+
+	loaded, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := loaded.CreateCustomer(a.ID, "Jane", "jane@example.com", t0); err != nil {
+		t.Fatalf("a deleted customer's email after loading the state: %v", err)
+	}
+
+	again, err := s.CreateCustomer(a.ID, "Jane Again", "JANE@example.com", t0)
+	if err != nil {
+		t.Fatalf("a deleted customer's email is not free: %v", err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, jane.ID, deletedAt); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("restore with the email taken: %v", err)
+	}
+	if _, err := s.UpdateCustomer(a.ID, again.ID, func(c *Customer) error { c.Email = "jane.new@example.com"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := s.RestoreCustomer(a.ID, jane.ID, deletedAt.Add(customerRetention))
+	if err != nil || restored.DeletedAt != nil {
+		t.Fatalf("restore within 30 days = %+v, %v", restored, err)
+	}
+	if _, ok := s.Customer(a.ID, jane.ID); !ok {
+		t.Fatal("restored customer is not visible")
+	}
+	if _, err := s.RestoreCustomer(a.ID, jane.ID, deletedAt); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore a customer that is not deleted: %v", err)
+	}
+
+	if err := s.DeleteCustomerAt(a.ID, john.ID, deletedAt); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, john.ID, deletedAt.Add(customerRetention+time.Second)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore after 30 days: %v", err)
+	}
+	if n := s.PurgeDeletedCustomers(deletedAt.Add(customerRetention)); n != 0 {
+		t.Fatalf("purged %d customers within 30 days", n)
+	}
+	if n := s.PurgeDeletedCustomers(deletedAt.Add(customerRetention + time.Second)); n != 1 {
+		t.Fatalf("purged %d customers, want 1", n)
+	}
+	if _, ok := s.CustomerIncludingDeleted(a.ID, john.ID); ok {
+		t.Fatal("purged customer is still there")
+	}
+	if _, ok := s.CustomerIncludingDeleted(a.ID, jane.ID); !ok {
+		t.Fatal("purge removed a customer that was restored")
+	}
+}
