+func TestRenewalKeepsTheAnchorDayAtMonthEnd(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	e.Clock.Set(time.Date(2026, 1, 31, 9, 0, 0, 0, time.UTC))
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Each renewal lands on the period boundary that the anchor (Jan 31) gives: Feb 28, Mar 31, Apr 30, May 31.
+	for _, r := range []struct{ at, start, end time.Time }{
+		{time.Date(2026, 2, 28, 9, 0, 0, 0, time.UTC), time.Date(2026, 2, 28, 9, 0, 0, 0, time.UTC), time.Date(2026, 3, 31, 9, 0, 0, 0, time.UTC)},
+		{time.Date(2026, 3, 31, 9, 0, 0, 0, time.UTC), time.Date(2026, 3, 31, 9, 0, 0, 0, time.UTC), time.Date(2026, 4, 30, 9, 0, 0, 0, time.UTC)},
+		{time.Date(2026, 4, 30, 9, 0, 0, 0, time.UTC), time.Date(2026, 4, 30, 9, 0, 0, 0, time.UTC), time.Date(2026, 5, 31, 9, 0, 0, 0, time.UTC)},
+	} {
+		e.Clock.Set(r.at)
+		if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+			t.Fatalf("RenewDue at %v = %d, %v", r.at, n, err)
+		}
+		got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+		if !got.CurrentPeriodStart.Equal(r.start) || !got.CurrentPeriodEnd.Equal(r.end) {
+			t.Fatalf("period at %v = %v to %v, want %v to %v", r.at, got.CurrentPeriodStart, got.CurrentPeriodEnd, r.start, r.end)
+		}
+	}
+}
