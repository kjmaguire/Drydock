+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The renewal job did not run for two months.
+	e.Clock.Set(time.Date(2026, 4, 2, 17, 45, 0, 0, time.UTC))
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v; want the subscription renewed once", n, err)
+	}
