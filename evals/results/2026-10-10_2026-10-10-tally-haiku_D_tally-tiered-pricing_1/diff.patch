+// TieredAmount is the charge for quantity units on a tiered plan, in minor units. Graduated: each unit is priced at the
+// unit amount of the tier it falls in, and every tier that a unit falls in adds its flat amount. Volume: every unit is
+// priced at the unit amount of the tier the quantity falls in, and that tier adds its flat amount. A tier's UpTo is
+// inclusive, and a quantity of 0 costs nothing. The tiers must be valid (see store.Plan).
+func TieredAmount(tiers []store.Tier, mode store.TiersMode, quantity int64) int64 {
+	if quantity <= 0 {
+		return 0
+	}
+	var total, from int64 // the units up to from are priced
+	switch mode {
+	case store.Graduated:
+		for _, t := range tiers {
+			if quantity <= from {
+				break
+			}
+			top := quantity
+			if t.UpTo != nil && *t.UpTo < top {
+				top = *t.UpTo
+			}
+			total += (top-from)*t.UnitAmount + t.FlatAmount
+			if t.UpTo == nil {
+				break
+			}
+			from = *t.UpTo
+		}
+	case store.Volume:
+		for _, t := range tiers {
+			if t.UpTo == nil || quantity <= *t.UpTo {
+				return quantity*t.UnitAmount + t.FlatAmount
+			}
+		}
+	}
+	return total
+}
