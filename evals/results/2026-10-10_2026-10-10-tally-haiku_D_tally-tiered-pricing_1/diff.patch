+// majorString reads an amount given as a JSON string. A missing or null amount is "".
+func majorString(raw json.RawMessage) (string, error) {
+	if len(raw) == 0 || string(raw) == "null" {
+		return "", nil
+	}
+	var s string
+	if err := json.Unmarshal(raw, &s); err != nil {
+		return "", errors.New("an amount is a string in major units")
+	}
+	return s, nil
+}
