+// parseTiers reads tiers in major units into tiers in minor units. Any error wraps store.ErrInvalidTiers.
+func parseTiers(in []tierIn, c money.Currency) ([]store.Tier, error) {
+	tiers := make([]store.Tier, 0, len(in))
+	for _, t := range in {
+		var upTo *int64
+		if len(t.UpTo) > 0 && string(t.UpTo) != "null" {
+			n, err := strconv.ParseInt(string(t.UpTo), 10, 64)
+			if err != nil {
+				return nil, fmt.Errorf("%w: up_to is a whole number or null", store.ErrInvalidTiers)
+			}
+			upTo = &n
+		}
+		unitStr, err := majorString(t.UnitAmount)
+		if err != nil {
+			return nil, fmt.Errorf("%w: unit_amount: %v", store.ErrInvalidTiers, err)
+		}
+		unit, err := money.ParseMajor(unitStr, c)
+		if err != nil {
+			return nil, fmt.Errorf("%w: unit_amount: %v", store.ErrInvalidTiers, err)
+		}
+		flatStr, err := majorString(t.FlatAmount)
+		if err != nil {
+			return nil, fmt.Errorf("%w: flat_amount: %v", store.ErrInvalidTiers, err)
+		}
+		var flat int64
+		if flatStr != "" {
+			if flat, err = money.ParseMajor(flatStr, c); err != nil {
+				return nil, fmt.Errorf("%w: flat_amount: %v", store.ErrInvalidTiers, err)
+			}
+		}
+		tiers = append(tiers, store.Tier{UpTo: upTo, UnitAmount: unit, FlatAmount: flat})
+	}
+	return tiers, nil
+}
