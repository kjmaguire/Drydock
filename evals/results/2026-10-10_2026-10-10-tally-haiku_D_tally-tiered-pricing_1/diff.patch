+func TestTieredMeteredBillsOneLinePerPeriod(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	ten := int64(10)
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, Interval: store.Monthly, UsageType: store.Metered,
+		TiersMode: store.Graduated, Tiers: []store.Tier{{UpTo: &ten, UnitAmount: 100}, {UnitAmount: 50}}}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, q := range []int64{4, 20} {
+		if _, err := e.Store.AddUsage(e.Acme.ID, sub.ID, q, sub.CurrentPeriodStart.Add(time.Hour), e.Clock.Now()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	// 24 units graduated: the first 10 at 1.00 and the other 14 at 0.50, on one line.
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 1 || len(invs[0].Lines) != 1 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	if l := invs[0].Lines[0]; l.Quantity != 1 || l.UnitAmount != 1700 || !strings.HasPrefix(l.Description, "API calls") {
+		t.Fatalf("line = %+v", l)
+	}
+	// The next period has no usage, so nothing is invoiced.
+	next, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	e.Clock.Set(next.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("a period without usage was invoiced: %+v", invs)
+	}
+	if next, _ = e.Store.Subscription(e.Acme.ID, sub.ID); next.Status != store.Active {
+		t.Fatalf("status = %s, want active", next.Status)
+	}
+}
