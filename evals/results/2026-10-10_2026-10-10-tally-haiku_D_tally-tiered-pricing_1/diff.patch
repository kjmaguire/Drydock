+// checkTiers accepts a plan without tiers, or a metered plan whose tiers have a valid mode, at least one tier, and up_to
+// limits that strictly increase, positive except the last tier's, which is nil. Amounts cannot be negative.
+func checkTiers(p Plan) error {
+	if !p.Tiered() && p.TiersMode == "" {
+		return nil
+	}
+	switch {
+	case p.UsageType != Metered:
+		return fmt.Errorf("%w: only a metered plan has tiers", ErrInvalidTiers)
+	case p.TiersMode != Graduated && p.TiersMode != Volume:
+		return fmt.Errorf("%w: tiers_mode is graduated or volume", ErrInvalidTiers)
+	case !p.Tiered():
+		return fmt.Errorf("%w: a tiered plan needs at least one tier", ErrInvalidTiers)
+	}
+	for i, t := range p.Tiers {
+		last := i == len(p.Tiers)-1
+		switch {
+		case t.UnitAmount < 0 || t.FlatAmount < 0:
+			return fmt.Errorf("%w: a tier's amounts cannot be negative", ErrInvalidTiers)
+		case last && t.UpTo != nil:
+			return fmt.Errorf("%w: the last tier has no up_to", ErrInvalidTiers)
+		case !last && (t.UpTo == nil || *t.UpTo <= 0):
+			return fmt.Errorf("%w: every tier but the last needs a positive up_to", ErrInvalidTiers)
+		case i > 0 && !last && *t.UpTo <= *p.Tiers[i-1].UpTo:
+			return fmt.Errorf("%w: up_to must increase from tier to tier", ErrInvalidTiers)
+		}
+	}
 	return nil
 }
 
+// copyPlan is a deep copy of a plan's tiers, so callers cannot change stored tiers.
+func copyPlan(p Plan) Plan {
+	if p.Tiers != nil {
+		tiers := make([]Tier, len(p.Tiers))
+		for i, t := range p.Tiers {
+			if t.UpTo != nil {
+				u := *t.UpTo
+				t.UpTo = &u
+			}
+			tiers[i] = t
+		}
+		p.Tiers = tiers
+	}
+	return p
+}
