+// isPublic reports whether a is a public address. An IPv4 address written as IPv6 is judged as the IPv4 address it holds.
+func isPublic(a netip.Addr) bool {
+	if !a.IsValid() {
+		return false
+	}
+	a = a.Unmap()
+	return !slices.ContainsFunc(nonPublic, func(p netip.Prefix) bool { return p.Contains(a) })
+}
+
+// hostAddrs returns the addresses host stands for: host itself when it is an IP address, else every address the Resolver
+// finds for it. An address that cannot be read is returned as the zero netip.Addr, which isPublic refuses.
+func (s *Service) hostAddrs(ctx context.Context, host string) ([]netip.Addr, error) {
+	if a, err := netip.ParseAddr(host); err == nil {
+		return []netip.Addr{a}, nil
+	}
+	ips, err := s.resolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	addrs := make([]netip.Addr, 0, len(ips))
+	for _, ip := range ips {
+		a, _ := netip.AddrFromSlice(ip.IP)
+		addrs = append(addrs, a)
+	}
+	return addrs, nil
+}
