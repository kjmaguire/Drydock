+func TestDeliveryRefusesAnEndpointWhoseHostMovedToANonPublicAddress(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	now := e.Clock.Now()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/all", Events: []string{"*"}, Secret: "whsec_a", Enabled: true}, now)
+
+	// DNS now answers with the metadata address: nothing may be sent.
+	e.DNS.Set("hooks.acme.example", "169.254.169.254")
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v", n, err)
+	}
+	if reqs := e.HTTP.Requests(); len(reqs) != 0 {
+		t.Fatalf("a request was sent to a non-public address: %+v", reqs)
+	}
+	ds := e.Store.Deliveries(e.Acme.ID, ep.ID)
+	if len(ds) != 1 || ds[0].Status != store.DeliveryFailed || ds[0].Attempts != 1 || !strings.Contains(ds[0].Error, "not public") {
+		t.Fatalf("deliveries = %+v", ds)
+	}
+	saved, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if saved.URL != ep.URL || !saved.Enabled {
+		t.Fatalf("endpoint changed: %+v", saved)
+	}
+
+	// The host is public again: the next delivery is sent.
+	e.DNS.Set("hooks.acme.example", "93.184.216.34")
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_2"}); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v", n, err)
+	}
+	if reqs := e.HTTP.Requests(); len(reqs) != 1 || reqs[0].URL != ep.URL {
+		t.Fatalf("requests = %+v", reqs)
+	}
+}
