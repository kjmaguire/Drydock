+// blockUntilCanceled returns a job that signals started, then waits for its context to end.
+func blockUntilCanceled(name string, started chan<- string) Job {
+	return Job{Name: name, Run: func(ctx context.Context) error {
+		started <- name
+		<-ctx.Done()
+		return ctx.Err()
+	}}
+}
+
+func names(jobs []Job) []string {
+	var out []string
+	for _, j := range jobs {
+		out = append(out, j.Name)
+	}
+	return out
+}
+
+func TestEnqueueAfterShutdownReturnsErrStopped(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	job := Job{Name: "late", Run: func(context.Context) error { t.Error("late job ran"); return nil }}
+	if err := r.Enqueue(job); !errors.Is(err, ErrStopped) {
+		t.Fatalf("err = %v, want ErrStopped", err)
+	}
+	if got := names(r.Pending()); len(got) != 0 {
+		t.Fatalf("pending = %v, want none", got)
+	}
+}
+
+func TestEnqueueDuringShutdownReturnsErrStopped(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started := make(chan string, 1)
+	release := make(chan struct{})
+	if err := r.Enqueue(Job{Name: "slow", Run: func(context.Context) error {
+		started <- "slow"
+		<-release
+		return nil
