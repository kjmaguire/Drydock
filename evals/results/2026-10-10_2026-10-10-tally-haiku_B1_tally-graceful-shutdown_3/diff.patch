-func (r *Runner) Stop() {
+// Shutdown stops the runner. Enqueue returns ErrStopped from the moment Shutdown is called, and jobs that have
+// not started are not started. Shutdown waits for the running jobs to finish. If ctx ends first, it cancels the
+// context of every running job, waits for them to return, and returns ctx.Err(). It returns nil when every
+// running job finished before ctx ended. Calls after the first return nil at once.
+func (r *Runner) Shutdown(ctx context.Context) error {
+	r.mu.Lock()
+	if r.closing {
+		r.mu.Unlock()
+		return nil
+	}
+	r.closing = true
+	r.notStart = r.waiting
+	r.waiting = nil
 	close(r.queue)
+	r.mu.Unlock()
+
+	done := make(chan struct{})
+	go func() {
+		r.wg.Wait()
+		close(done)
+	}()
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+	}
+	select {
+	case <-done:
+		return nil
+	default:
+	}
+
+	r.mu.Lock()
+	for _, a := range r.running {
+		a.canceled = true
+		a.cancel()
+	}
+	r.mu.Unlock()
+	<-done
+	return ctx.Err()
+}
+
+// Stop stops the runner like Shutdown, waiting at most 30 seconds for running jobs.
+func (r *Runner) Stop() {
+	ctx, cancel := context.WithTimeout(context.Background(), stopTimeout)
+	defer cancel()
+	if err := r.Shutdown(ctx); err != nil {
+		r.log.Warn("job runner stopped with jobs still running", "err", err)
+	}
+}
+
+// Pending returns the jobs that still need to run, in the order they were enqueued. Before Shutdown these are
+// the queued jobs not started yet. After Shutdown they are the jobs that were never started, followed by the
+// jobs whose context Shutdown canceled and that returned an error.
+func (r *Runner) Pending() []Job {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	var es []entry
+	if r.closing {
+		es = slices.Clone(r.notStart)
+		canceled := slices.Clone(r.canceled)
+		slices.SortFunc(canceled, func(a, b entry) int { return cmp.Compare(a.seq, b.seq) })
+		es = append(es, canceled...)
+	} else {
+		es = slices.Clone(r.waiting)
+	}
+	jobs := make([]Job, 0, len(es))
+	for _, e := range es {
+		jobs = append(jobs, e.job)
+	}
+	return jobs
 }
