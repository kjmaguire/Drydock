+// numberInvoices gives the invoices of a snapshot older than version 3 their numbers: per organization, in creation order
+// (created_at, then ID), from INV-000001. It also sets each organization's next number.
+func numberInvoices(st *store.State) {
+	order := make([]int, len(st.Invoices))
+	for i := range order {
+		order[i] = i
+	}
+	sort.Slice(order, func(a, b int) bool {
+		x, y := st.Invoices[order[a]], st.Invoices[order[b]]
+		if !x.CreatedAt.Equal(y.CreatedAt) {
+			return x.CreatedAt.Before(y.CreatedAt)
+		}
+		return x.ID < y.ID
+	})
+	st.InvoiceNext = map[string]int{}
+	for _, i := range order {
+		org := st.Invoices[i].OrgID
+		n := st.InvoiceNext[org]
+		if n == 0 {
+			n = 1
+		}
+		st.Invoices[i].Number = store.InvoiceNumber(n)
+		st.InvoiceNext[org] = n + 1
+	}
+}
