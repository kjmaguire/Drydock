index 0000000..b7ae0e1
--- /dev/null
+++ b/result/internal/api/idempotency_test.go
@@ -0,0 +1,220 @@
+package api_test
+
+import (
+	"bytes"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/payments"
+	"example.com/tally/internal/store"
+)
+
+// invoiceFor creates a 40.00 invoice for a customer of org.
+func invoiceFor(t *testing.T, e *apitest.Env, org apitest.Org, customerID string) store.Invoice {
+	t.Helper()
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", org.Key, map[string]any{
+		"customer_id": customerID, "currency": "USD", "lines": []map[string]any{{"description": "Team", "quantity": 1, "unit_amount": 4000}},
+	}, &inv)
+	return inv
+}
+
+// newCustomer creates a customer of org with a unique address.
+func newCustomer(e *apitest.Env, org apitest.Org, email string) string {
+	return e.CreateCustomer(org, "Jane", email).ID
+}
+
+// pay sends a pay request for invoiceID with the given headers.
+func pay(e *apitest.Env, org apitest.Org, invoiceID string, h http.Header, body any) *apitest.Response {
+	return e.DoWith("POST", "/v1/invoices/"+invoiceID+"/pay", org.Key, body, h)
+}
+
+// key is the header of a request with an Idempotency-Key.
+func key(k string) http.Header { return http.Header{"Idempotency-Key": {k}} }
+
+func TestIdempotentPayChargesOnce(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(t, e, e.Acme, newCustomer(e, e.Acme, "jane@acme.example"))
+	body := map[string]string{"payment_method": "pm_card_visa"}
+
+	first := pay(e, e.Acme, inv.ID, key("order-1"), body)
+	if first.Code != http.StatusOK || first.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("first pay: %s", first)
+	}
+	again := pay(e, e.Acme, inv.ID, key("order-1"), body)
+	if again.Code != http.StatusOK || again.Header.Get("Idempotent-Replayed") != "true" || !bytes.Equal(again.Body, first.Body) {
+		t.Fatalf("replay: want %d with the first body and Idempotent-Replayed: true, got %s (replayed %q)", first.Code, again, again.Header.Get("Idempotent-Replayed"))
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("charges = %d, want 1", n)
+	}
+	// Without a key the invoice is simply paid now.
+	if r := pay(e, e.Acme, inv.ID, nil, body); r.Code != http.StatusConflict || r.Map(t)["error"] != "already_paid" {
+		t.Fatalf("pay without a key after payment: %s", r)
+	}
+}
+
+func TestIdempotencyKeyValidation(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(t, e, e.Acme, newCustomer(e, e.Acme, "jane@acme.example"))
+	declined := map[string]string{"payment_method": "pm_card_declined"}
+
+	for _, k := range []string{"", strings.Repeat("k", 256), "tab\there", "café", "ctrl\x01"} {
+		r := pay(e, e.Acme, inv.ID, http.Header{"Idempotency-Key": {k}}, declined)
+		if r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_idempotency_key" {
+			t.Fatalf("key %q: %s", k, r)
+		}
+	}
+	if r := pay(e, e.Acme, inv.ID, http.Header{"Idempotency-Key": {"a", "b"}}, declined); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_idempotency_key" {
+		t.Fatalf("two keys: %s", r)
+	}
+	for _, k := range []string{"x", strings.Repeat("k", 255), "with a space"} {
+		if r := pay(e, e.Acme, inv.ID, key(k), declined); r.Code != http.StatusPaymentRequired {
+			t.Fatalf("key %q: want the decline, got %s", k, r)
+		}
+	}
+}
+
+func TestIdempotencyKeyBelongsToOrganization(t *testing.T) {
+	e := apitest.New(t)
+	acme := invoiceFor(t, e, e.Acme, newCustomer(e, e.Acme, "jane@acme.example"))
+	globex := invoiceFor(t, e, e.Globex, newCustomer(e, e.Globex, "jane@globex.example"))
+	body := map[string]string{"payment_method": "pm_card_visa"}
+
+	a := pay(e, e.Acme, acme.ID, key("shared"), body)
+	g := pay(e, e.Globex, globex.ID, key("shared"), body)
+	if a.Code != http.StatusOK || g.Code != http.StatusOK || g.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("acme %s, globex %s: want two payments", a, g)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("charges = %d, want 2", n)
+	}
+}
+
+func TestIdempotencyKeyReuseIsRefused(t *testing.T) {
+	e := apitest.New(t)
+	customer := newCustomer(e, e.Acme, "jane@acme.example")
+	inv := invoiceFor(t, e, e.Acme, customer)
+	other := invoiceFor(t, e, e.Acme, customer)
+	declined := map[string]string{"payment_method": "pm_card_declined"}
+
+	if r := pay(e, e.Acme, inv.ID, key("k"), declined); r.Code != http.StatusPaymentRequired {
+		t.Fatalf("first: %s", r)
+	}
+	if r := pay(e, e.Acme, other.ID, key("k"), declined); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("same key, other invoice: %s", r)
+	}
+	if r := pay(e, e.Acme, inv.ID, key("k"), map[string]string{"payment_method": "pm_card_insufficient_funds"}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("same key, other body: %s", r)
+	}
+	// The refusals changed nothing: the first response is still the one replayed.
+	if r := pay(e, e.Acme, inv.ID, key("k"), declined); r.Code != http.StatusPaymentRequired || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("retry: %s", r)
+	}
+}
+
+func TestIdempotencyKeepsClientErrors(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(t, e, e.Acme, newCustomer(e, e.Acme, "jane@acme.example"))
+	body := map[string]string{"payment_method": "pm_card_declined"}
+
+	first := pay(e, e.Acme, inv.ID, key("d"), body)
+	again := pay(e, e.Acme, inv.ID, key("d"), body)
+	if first.Code != http.StatusPaymentRequired || again.Code != http.StatusPaymentRequired || !bytes.Equal(first.Body, again.Body) || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("declined: first %s, again %s", first, again)
+	}
+	missing := pay(e, e.Acme, "inv_missing", key("n"), body)
+	if missing.Code != http.StatusNotFound {
+		t.Fatalf("missing invoice: %s", missing)
+	}
+	if r := pay(e, e.Acme, "inv_missing", key("n"), body); r.Code != http.StatusNotFound || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("missing invoice again: %s", r)
+	}
+	if n := len(e.Gateway.Calls()); n != 1 {
+		t.Fatalf("gateway calls = %d, want 1: a replayed decline is not charged again", n)
+	}
+}
+
+func TestIdempotencyRetriesAfterServerError(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(t, e, e.Acme, newCustomer(e, e.Acme, "jane@acme.example"))
+	body := map[string]string{"payment_method": "pm_gateway_down"}
+
+	for i := 1; i <= 2; i++ {
+		r := pay(e, e.Acme, inv.ID, key("g"), body)
+		if r.Code != http.StatusServiceUnavailable || r.Map(t)["error"] != "gateway_unavailable" || r.Header.Get("Idempotent-Replayed") != "" {
+			t.Fatalf("attempt %d: %s", i, r)
+		}
+	}
+	if n := len(e.Gateway.Calls()); n != 2 {
+		t.Fatalf("gateway calls = %d, want 2: a 503 is not kept, so the retry pays again", n)
+	}
+}
+
+func TestIdempotentReplayExpiresAfterADay(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(t, e, e.Acme, newCustomer(e, e.Acme, "jane@acme.example"))
+	body := map[string]string{"payment_method": "pm_card_visa"}
+	first := pay(e, e.Acme, inv.ID, key("day"), body)
+	if first.Code != http.StatusOK {
+		t.Fatalf("first: %s", first)
+	}
+
+	e.Clock.Advance(24*time.Hour - time.Minute)
+	if r := pay(e, e.Acme, inv.ID, key("day"), body); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("23h59m later: %s", r)
+	}
+	e.Clock.Advance(time.Minute)
+	if r := pay(e, e.Acme, inv.ID, key("day"), body); r.Code != http.StatusConflict || r.Map(t)["error"] != "already_paid" || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("a day later the key is new: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("charges = %d, want 1", n)
+	}
+}
+
+func TestIdempotencyWhilePaymentIsUnderWay(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(t, e, e.Acme, newCustomer(e, e.Acme, "jane@acme.example"))
+	body := map[string]string{"payment_method": "pm_card_visa"}
+
+	entered, release := make(chan struct{}, 1), make(chan struct{})
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		select {
+		case entered <- struct{}{}:
+		default:
+		}
+		<-release
+	}
+	done := make(chan *apitest.Response, 1)
+	go func() { done <- pay(e, e.Acme, inv.ID, key("slow"), body) }()
+	<-entered
+
+	if r := pay(e, e.Acme, inv.ID, key("slow"), body); r.Code != http.StatusConflict || r.Map(t)["error"] != "request_in_progress" {
+		t.Fatalf("same key while in progress: %s", r)
+	}
+	if r := pay(e, e.Acme, inv.ID, key("slow"), map[string]string{"payment_method": "pm_card_declined"}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("same key, other body, while in progress: %s", r)
+	}
+	if r := pay(e, e.Acme, inv.ID, key("other"), body); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("other key while in progress: %s", r)
+	}
+	if r := pay(e, e.Acme, inv.ID, nil, body); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("no key while in progress: %s", r)
+	}
+
+	close(release)
+	first := <-done
+	if first.Code != http.StatusOK {
+		t.Fatalf("first: %s", first)
+	}
+	if r := pay(e, e.Acme, inv.ID, key("slow"), body); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("retry after completion: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("charges = %d, want 1", n)
+	}
+}
