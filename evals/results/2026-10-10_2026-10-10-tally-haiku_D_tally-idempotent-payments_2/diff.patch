diff --git a/result/internal/api/idempotency.go b/result/internal/api/idempotency.go
new file mode 100644
index 0000000..b9da24e
--- /dev/null
+++ b/result/internal/api/idempotency.go
@@ -0,0 +1,165 @@
+package api
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"example.com/tally/internal/auth"
+)
+
+// idempotencyTTL is how long a kept response is replayed.
+const idempotencyTTL = 24 * time.Hour
+
+// idemRecord is what the server remembers of a request that carried an Idempotency-Key.
+type idemRecord struct {
+	invoiceID string
+	bodyHash  string
+	done      bool      // false while the request is being handled
+	status    int       // once done: the response
+	body      []byte    // once done: the response
+	expires   time.Time // once done: when the response stops being replayed
+}
+
+// idemKey names a record: keys belong to an organization.
+type idemKey struct{ org, key string }
+
+// idempotency holds the records of keyed requests. It is safe for concurrent use.
+type idempotency struct {
+	mu   sync.Mutex
+	recs map[idemKey]*idemRecord
+}
+
+// idempotencyKey reads the request's Idempotency-Key: "" when there is none, or it answers 400 and returns false when the
+// key is not 1 to 255 printable ASCII characters.
+func idempotencyKey(w http.ResponseWriter, r *http.Request) (string, bool) {
+	vals := r.Header.Values("Idempotency-Key")
+	if len(vals) == 0 {
+		return "", true
+	}
+	k := vals[0]
+	if len(vals) > 1 || len(k) < 1 || len(k) > 255 || !isPrintableASCII(k) {
+		writeError(w, http.StatusBadRequest, "invalid_idempotency_key", "Idempotency-Key is 1 to 255 printable ASCII characters")
+		return "", false
+	}
+	return k, true
+}
+
+func isPrintableASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < 0x20 || s[i] > 0x7e {
+			return false
+		}
+	}
+	return true
+}
+
+// bufferedResponse holds a response until it is complete, so that it can be kept before the client sees it.
+type bufferedResponse struct {
+	header http.Header
+	status int
+	body   bytes.Buffer
+}
+
+func (b *bufferedResponse) Header() http.Header { return b.header }
+
+func (b *bufferedResponse) WriteHeader(status int) {
+	if b.status == 0 {
+		b.status = status
+	}
+}
+
+func (b *bufferedResponse) Write(p []byte) (int, error) {
+	if b.status == 0 {
+		b.status = http.StatusOK
+	}
+	return b.body.Write(p)
+}
+
+// keyed handles a request that carries an Idempotency-Key. The first request with a key is handled and its response kept;
+// a later one with the same key, invoice and body gets that response again. Responses of 500 or more are not kept.
+func (s *Server) keyed(w http.ResponseWriter, p auth.Principal, key, invoiceID string, body []byte, handle func(http.ResponseWriter)) {
+	sum := sha256.Sum256(body)
+	bodyHash := hex.EncodeToString(sum[:])
+	now := s.clock.Now()
+	k := idemKey{p.OrgID, key}
+
+	s.idem.mu.Lock()
+	if s.idem.recs == nil {
+		s.idem.recs = map[idemKey]*idemRecord{}
+	}
+	if rec, ok := s.idem.recs[k]; ok && rec.done && !now.Before(rec.expires) {
+		delete(s.idem.recs, k)
+	}
+	rec, ok := s.idem.recs[k]
+	if !ok {
+		rec = &idemRecord{invoiceID: invoiceID, bodyHash: bodyHash}
+		s.idem.recs[k] = rec
+		s.idem.mu.Unlock()
+		s.runKeyed(w, k, rec, handle)
+		return
+	}
+	seen := *rec
+	s.idem.mu.Unlock()
+
+	switch {
+	case seen.invoiceID != invoiceID || seen.bodyHash != bodyHash:
+		writeError(w, http.StatusUnprocessableEntity, "idempotency_key_reused", "this Idempotency-Key was used for another invoice or request body")
+	case !seen.done:
+		writeError(w, http.StatusConflict, "request_in_progress", "a request with this Idempotency-Key is still being handled")
+	default:
+		w.Header().Set("Idempotent-Replayed", "true")
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(seen.status)
+		_, _ = w.Write(seen.body)
+	}
+}
+
+// runKeyed handles a new keyed request and keeps its record, unless it fails with a 5xx or does not finish.
+func (s *Server) runKeyed(w http.ResponseWriter, k idemKey, rec *idemRecord, handle func(http.ResponseWriter)) {
+	kept := false
+	defer func() {
+		if !kept {
+			s.idem.mu.Lock()
+			if s.idem.recs[k] == rec {
+				delete(s.idem.recs, k)
+			}
+			s.idem.mu.Unlock()
+		}
+	}()
+
+	bw := &bufferedResponse{header: http.Header{}}
+	handle(bw)
+	status := bw.status
+	if status == 0 {
+		status = http.StatusOK
+	}
+	if status < http.StatusInternalServerError {
+		s.idem.mu.Lock()
+		rec.done, rec.status, rec.body = true, status, bw.body.Bytes()
+		rec.expires = s.clock.Now().Add(idempotencyTTL)
+		s.idem.mu.Unlock()
+		kept = true
+	}
+
+	for name, vals := range bw.header {
+		w.Header()[name] = vals
+	}
+	w.WriteHeader(status)
+	_, _ = w.Write(bw.body.Bytes())
+}
+
+// readBody reads a request body (at most 1 MiB) and puts it back for the handler, or answers 400 and returns false.
+func readBody(w http.ResponseWriter, r *http.Request) ([]byte, bool) {
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 1<<20))
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_json", "the body could not be read: "+err.Error())
+		return nil, false
+	}
+	r.Body = io.NopCloser(bytes.NewReader(raw))
+	return raw, true
+}
diff --git a/result/internal/api/idempotency_test.go b/result/internal/api/idempotency_test.go
