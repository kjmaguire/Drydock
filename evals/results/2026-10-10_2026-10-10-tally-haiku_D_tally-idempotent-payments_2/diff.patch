@@ -149,7 +149,26 @@ func (s *Server) getInvoiceLines(w http.ResponseWriter, r *http.Request, p auth.
 }
 
 // payInvoice charges an invoice: {"payment_method": "pm_..."}, or the customer's default payment method when it is absent.
+// With an Idempotency-Key header, a retry of the same request gets the first response again (see keyed).
 func (s *Server) payInvoice(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	key, ok := idempotencyKey(w, r)
+	if !ok {
+		return
+	}
+	if key == "" {
+		s.payInvoiceOnce(w, r, p)
+		return
+	}
+	body, ok := readBody(w, r)
+	if !ok {
+		return
+	}
+	s.keyed(w, p, key, r.PathValue("id"), body, func(w http.ResponseWriter) {
+		s.payInvoiceOnce(w, r, p)
+	})
+}
+
+func (s *Server) payInvoiceOnce(w http.ResponseWriter, r *http.Request, p auth.Principal) {
 	var in struct {
 		PaymentMethod string `json:"payment_method"`
 	}
@@ -175,6 +194,8 @@ func (s *Server) payError(w http.ResponseWriter, err error) {
 		writeError(w, http.StatusConflict, "invoice_void", err.Error())
 	case errors.Is(err, payments.ErrNoPaymentMethod):
 		writeError(w, http.StatusUnprocessableEntity, "no_payment_method", err.Error())
+	case errors.Is(err, payments.ErrPaymentInProgress):
+		writeError(w, http.StatusConflict, "payment_in_progress", err.Error())
 	case errors.Is(err, payments.ErrUnavailable):
 		writeError(w, http.StatusServiceUnavailable, "gateway_unavailable", "the payment gateway is unavailable; nothing was charged, try again")
 	default:
