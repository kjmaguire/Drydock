@@ -44,6 +45,8 @@ var (
 	ErrAlreadyPaid     = errors.New("the invoice is already paid")
 	ErrInvoiceVoid     = errors.New("the invoice is void")
 	ErrNoPaymentMethod = errors.New("no payment method to charge")
+	// ErrPaymentInProgress means another payment of the same invoice is under way; it is refused at once, never queued.
+	ErrPaymentInProgress = errors.New("a payment for the invoice is already in progress")
 )
 
 // Publisher sends events to the organization's webhook endpoints (webhooks.Service).
@@ -57,13 +60,43 @@ type Service struct {
 	Gateway   Gateway
 	Clock     clock.Clock
 	Publisher Publisher // nil: no events
+
+	mu       sync.Mutex
+	charging map[invoiceKey]bool // the invoices a Pay is working on now
+}
+
+type invoiceKey struct{ org, invoice string }
+
+// begin claims an invoice for a Pay; it is false when another Pay holds it.
+func (s *Service) begin(k invoiceKey) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.charging[k] {
+		return false
+	}
+	if s.charging == nil {
