+func (s *Store) SoftDeleteCustomer(orgID, id string, now time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt != nil {
+		return ErrNotFound
+	}
+	for _, sub := range s.subs {
+		if sub.CustomerID == id && sub.Status != Canceled {
+			return ErrHasActiveSubscriptions
+		}
