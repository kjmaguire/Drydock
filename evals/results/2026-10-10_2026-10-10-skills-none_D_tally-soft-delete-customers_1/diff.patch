+	if err := s.SoftDeleteCustomer(other.ID, jane.ID, deletedAt); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleted through another org: %v", err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, deletedAt); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, deletedAt); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleted twice: %v", err)
+	}
+
+	if _, ok := s.Customer(a.ID, jane.ID); ok {
+		t.Fatal("deleted customer still there")
+	}
+	if got, ok := s.CustomerIncludingDeleted(a.ID, jane.ID); !ok || got.DeletedAt == nil || !got.DeletedAt.Equal(deletedAt) {
+		t.Fatalf("CustomerIncludingDeleted = %+v %v", got, ok)
+	}
+	if got := s.Customers(a.ID); len(got) != 1 || got[0].ID != john.ID {
+		t.Fatalf("Customers = %+v", got)
+	}
+	if got := s.CustomersIncludingDeleted(a.ID); len(got) != 2 {
+		t.Fatalf("CustomersIncludingDeleted = %+v", got)
+	}
+	if got := s.SearchCustomers(a.ID, "jane"); len(got) != 0 {
+		t.Fatalf("SearchCustomers = %+v", got)
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "Jane@Example.com"); ok {
+		t.Fatal("deleted customer found by email")
+	}
+	if _, err := s.UpdateCustomer(a.ID, jane.ID, func(*Customer) error { return nil }); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("update of a deleted customer: %v", err)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: jane.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for a deleted customer: %v", err)
+	}
+	if _, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: jane.ID, PlanID: p.ID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for a deleted customer: %v", err)
+	}
+	if got, ok := s.Invoice(a.ID, inv.ID); !ok || got.CustomerID != jane.ID {
+		t.Fatal("the deleted customer's invoice is gone")
+	}
+
+	// The email address is free again, so a new customer may use it. Restoring Jane then fails until that customer changes it.
+	jane2, err := s.CreateCustomer(a.ID, "Jane Two", "Jane@Example.com", t0.Add(2*time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, jane.ID, deletedAt); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("restore with the email taken: %v", err)
+	}
+	if _, err := s.UpdateCustomer(a.ID, jane2.ID, func(c *Customer) error { c.Email = "jane.two@example.com"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := s.RestoreCustomer(a.ID, jane.ID, deletedAt.Add(customerRestoreWindow))
+	if err != nil || restored.DeletedAt != nil || restored.Name != "Jane" {
+		t.Fatalf("restore on the 30th day = %+v, %v", restored, err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != jane.ID {
+		t.Fatalf("FindCustomerByEmail after restore = %+v %v", got, ok)
+	}
+	if _, err := s.RestoreCustomer(a.ID, jane.ID, deletedAt); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore of a customer that is not deleted: %v", err)
+	}
+
+	// John is deleted, and cannot be restored after 30 days.
+	if err := s.SoftDeleteCustomer(a.ID, john.ID, deletedAt); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, john.ID, deletedAt.Add(customerRestoreWindow+time.Second)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore after 30 days: %v", err)
+	}
+}
