+func TestPurgeDeletedCustomers(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	jane, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	john, _ := s.CreateCustomer(a.ID, "John", "john@example.com", t0)
+	inv, _ := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: john.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+	if err := s.SoftDeleteCustomer(a.ID, john.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, t0.Add(10*24*time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+
+	if n := s.PurgeDeletedCustomers(t0.Add(customerRestoreWindow)); n != 0 {
+		t.Fatalf("purged %d customers within 30 days", n)
+	}
+	if n := s.PurgeDeletedCustomers(t0.Add(customerRestoreWindow + time.Second)); n != 1 {
+		t.Fatalf("purged %d customers, want 1", n)
+	}
+	if _, ok := s.CustomerIncludingDeleted(a.ID, john.ID); ok {
+		t.Fatal("purged customer still there")
+	}
+	if got, ok := s.Invoice(a.ID, inv.ID); !ok || got.CustomerID != john.ID {
+		t.Fatal("a purged customer's invoice is gone")
+	}
+	if _, err := s.RestoreCustomer(a.ID, john.ID, t0.Add(time.Minute)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore of a purged customer: %v", err)
+	}
+	if n := s.PurgeDeletedCustomers(t0.Add(40 * 24 * time.Hour)); n != 0 {
+		t.Fatalf("purged %d customers, want 0 (Jane was deleted 30 days before)", n)
+	}
+	if n := s.PurgeDeletedCustomers(t0.Add(41 * 24 * time.Hour)); n != 1 {
+		t.Fatalf("purged %d customers, want 1 (Jane)", n)
+	}
+	if n := s.PurgeDeletedCustomers(t0.Add(41 * 24 * time.Hour)); n != 0 {
+		t.Fatalf("purged %d customers again", n)
+	}
+}
