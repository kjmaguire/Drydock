+// RestoreCustomer undoes a soft delete made within the last 30 days. It fails with ErrEmailTaken when another of the
+// organization's customers now uses the customer's email address.
+func (s *Store) RestoreCustomer(orgID, id string, now time.Time) (Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt == nil || now.Sub(*c.DeletedAt) > customerRestoreWindow {
+		return Customer{}, ErrNotFound
+	}
+	key := normEmail(c.Email)
+	if other, ok := s.customersByEmail[key]; ok && other != id && s.customers[other].OrgID == orgID {
+		return Customer{}, ErrEmailTaken
+	}
+	c.DeletedAt = nil
+	s.customers[id] = c
+	s.customersByEmail[key] = id
+	return copyCustomer(c), nil
+}
+
+// PurgeDeletedCustomers removes the customers deleted more than 30 days before now and returns how many it removed. Their
+// invoices and payments stay, but no longer name a customer.
+func (s *Store) PurgeDeletedCustomers(now time.Time) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n := 0
+	for id, c := range s.customers {
+		if c.DeletedAt != nil && now.Sub(*c.DeletedAt) > customerRestoreWindow {
+			delete(s.customers, id)
+			s.unindexEmail(c)
+			n++
+		}
+	}
+	return n
+}
+
+// unindexEmail forgets c's email address if it is the one that points at c. The caller holds the lock.
+func (s *Store) unindexEmail(c Customer) {
+	if s.customersByEmail[normEmail(c.Email)] == c.ID {
+		delete(s.customersByEmail, normEmail(c.Email))
+	}
+}
