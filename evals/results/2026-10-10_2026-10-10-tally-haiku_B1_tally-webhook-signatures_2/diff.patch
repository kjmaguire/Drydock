+func TestSecretRotation(t *testing.T) {
+	e := apitest.New(t)
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/all", Events: []string{"*"}, Secret: "whsec_1", Enabled: true}, e.Clock.Now())
+
+	// Before any rotation a delivery carries one signature.
+	header, body := publishAndSend(t, e)
+	if strings.Count(header, ",v1=") != 1 || webhooks.Verify(body, header, []string{"whsec_1"}, 0, e.Clock.Now()) != nil {
+		t.Fatalf("before rotation: %q", header)
+	}
+
+	rotated, err := e.Webhooks.RotateSecret(e.Acme.ID, ep.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(rotated.Secret, "whsec_") || rotated.Secret == "whsec_1" || rotated.PreviousSecret != "whsec_1" ||
+		rotated.SecretRotatedAt == nil || !rotated.SecretRotatedAt.Equal(e.Clock.Now()) {
+		t.Fatalf("rotated endpoint = %+v", rotated)
+	}
+	secret2 := rotated.Secret
+
+	// For 24 hours a delivery carries the new secret's signature first, then the previous secret's.
+	header, body = publishAndSend(t, e)
+	if want := webhooks.SignatureHeader([]string{secret2, "whsec_1"}, e.Clock.Now(), body); header != want {
+		t.Fatalf("during the overlap: %q, want %q", header, want)
+	}
+
+	e.Clock.Advance(24*time.Hour - time.Second)
+	header, body = publishAndSend(t, e)
+	if strings.Count(header, ",v1=") != 2 {
+		t.Fatalf("one second before the end of the overlap: %q", header)
+	}
+
+	e.Clock.Advance(time.Second)
+	header, body = publishAndSend(t, e)
+	if want := webhooks.SignatureHeader([]string{secret2}, e.Clock.Now(), body); header != want {
+		t.Fatalf("24 hours after the rotation: %q, want %q", header, want)
+	}
+
+	// Rotating again within 24 hours drops the oldest secret at once.
+	e.Clock.Advance(time.Hour)
+	again, err := e.Webhooks.RotateSecret(e.Acme.ID, ep.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if again.PreviousSecret != secret2 {
+		t.Fatalf("previous secret = %q, want %q", again.PreviousSecret, secret2)
+	}
+	header, body = publishAndSend(t, e)
+	if want := webhooks.SignatureHeader([]string{again.Secret, secret2}, e.Clock.Now(), body); header != want {
+		t.Fatalf("after the second rotation: %q, want %q", header, want)
+	}
+	if err := webhooks.Verify(body, header, []string{"whsec_1"}, 0, e.Clock.Now()); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Fatalf("the secret before the previous one still verifies: %v", err)
+	}
+
+	// The rotation survives a restart.
+	path := filepath.Join(t.TempDir(), "snapshot.json")
+	if err := snapshot.Save(e.Store, path, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	st, err := snapshot.Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	back, ok := st.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if !ok || back.Secret != again.Secret || back.PreviousSecret != secret2 || back.SecretRotatedAt == nil || !back.SecretRotatedAt.Equal(*again.SecretRotatedAt) {
+		t.Fatalf("after a snapshot: %+v", back)
+	}
+}
+
+func TestRotateSecretOfAnotherOrganization(t *testing.T) {
+	e := apitest.New(t)
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Globex.ID, URL: "https://hooks.globex.example/", Events: []string{"*"}, Secret: "whsec_g", Enabled: true}, e.Clock.Now())
+	if _, err := e.Webhooks.RotateSecret(e.Acme.ID, ep.ID); !errors.Is(err, store.ErrNotFound) {
+		t.Fatalf("RotateSecret of another organization's endpoint = %v", err)
+	}
+	if got, _ := e.Store.WebhookEndpoint(e.Globex.ID, ep.ID); got.Secret != "whsec_g" || got.PreviousSecret != "" {
+		t.Fatalf("endpoint changed: %+v", got)
+	}
+}
