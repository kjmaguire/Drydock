+// Verify checks a delivery's Tally-Signature header against the payload it came with (the body, as received). It returns nil
+// when the header's timestamp is within tolerance of now, in either direction (a tolerance of 0, or less, means 5 minutes),
+// and one of the header's v1 signatures is the signature of "<t>.<payload>" under one of secrets. Other keys in the header,
+// such as v0, are ignored.
+func Verify(payload []byte, header string, secrets []string, tolerance time.Duration, now time.Time) error {
+	if header == "" {
+		return fmt.Errorf("%w: the header is empty", ErrMalformedHeader)
+	}
+	var (
+		ts      int64
+		hasTime bool
+		sigs    []string
+	)
+	for _, pair := range strings.Split(header, ",") {
+		k, v, ok := strings.Cut(strings.TrimSpace(pair), "=")
+		if !ok {
+			return fmt.Errorf("%w: %q is not key=value", ErrMalformedHeader, strings.TrimSpace(pair))
+		}
+		k, v = strings.TrimSpace(k), strings.TrimSpace(v)
+		switch k {
+		case "t":
+			n, err := strconv.ParseInt(v, 10, 64)
+			if err != nil {
+				return fmt.Errorf("%w: the timestamp %q is not an integer", ErrMalformedHeader, v)
+			}
+			if !hasTime {
+				ts, hasTime = n, true
+			}
+		case "v1":
+			sigs = append(sigs, v)
+		}
