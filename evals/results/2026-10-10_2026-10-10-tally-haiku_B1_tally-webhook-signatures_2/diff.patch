+	if !hasTime {
+		return ErrNoTimestamp
+	}
+	if tolerance <= 0 {
+		tolerance = defaultTolerance
+	}
+	if age := now.Sub(time.Unix(ts, 0)); age > tolerance || age < -tolerance {
+		return fmt.Errorf("%w: the timestamp is %s from now", ErrTimestampTolerance, age.Round(time.Second))
+	}
+	if len(sigs) == 0 {
+		return ErrNoSignature
+	}
+	// Every secret and signature is compared, so the time taken does not show which one matched.
+	matched := false
+	for _, secret := range secrets {
+		want := []byte(Sign(secret, signedPayload(ts, payload)))
+		for _, sig := range sigs {
+			if hmac.Equal([]byte(sig), want) {
+				matched = true
+			}
+		}
+	}
+	if !matched {
+		return ErrSignatureMismatch
+	}
+	return nil
+}
