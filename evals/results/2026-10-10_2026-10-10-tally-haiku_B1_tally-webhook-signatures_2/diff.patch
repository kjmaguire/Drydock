+// SignatureHeader returns the Tally-Signature header for a delivery sent at t: "t=<unix seconds>,v1=<signature>" with one v1
+// entry per secret, in the order given (the current secret first). Each signature is Sign of "<t>.<body>".
+func SignatureHeader(secrets []string, t time.Time, body []byte) string {
+	ts := t.Unix()
+	var b strings.Builder
+	b.WriteString("t=" + strconv.FormatInt(ts, 10))
+	for _, secret := range secrets {
+		b.WriteString(",v1=" + Sign(secret, signedPayload(ts, body)))
+	}
