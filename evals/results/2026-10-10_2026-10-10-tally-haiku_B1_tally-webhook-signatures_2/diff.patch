+func TestRotateEndpointSecret(t *testing.T) {
+	e := apitest.New(t)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	path := "/v1/webhook-endpoints/" + ep.ID + "/rotate-secret"
+
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	if r := e.Do("POST", path, viewer, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer rotated a secret: %s", r)
+	}
+	if r := e.Do("POST", path, e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("another organization rotated a secret: %s", r)
+	}
+	if r := e.Do("POST", "/v1/webhook-endpoints/we_000000/rotate-secret", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("unknown endpoint: %s", r)
+	}
+
+	var rotated store.WebhookEndpoint
+	e.MustDo(http.StatusOK, "POST", path, e.Acme.Key, nil, &rotated)
+	if !regexp.MustCompile(`^whsec_[0-9a-f]{32}$`).MatchString(rotated.Secret) || rotated.Secret == ep.Secret {
+		t.Fatalf("new secret = %q (old %q)", rotated.Secret, ep.Secret)
+	}
+	if rotated.PreviousSecret != ep.Secret || rotated.SecretRotatedAt == nil || rotated.ID != ep.ID {
+		t.Fatalf("rotated endpoint = %+v", rotated)
+	}
+	var got store.WebhookEndpoint
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, nil, &got)
+	if got.Secret != rotated.Secret {
+		t.Fatalf("GET shows secret %q, want %q", got.Secret, rotated.Secret)
+	}
+}
