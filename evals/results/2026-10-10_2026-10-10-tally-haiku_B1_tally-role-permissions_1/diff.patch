+	}
+	if err := s.RemoveMemberChecked(o.ID, a.ID, func(Member) error { return nil }); !errors.Is(err, ErrLastOwner) {
+		t.Fatalf("removing the only owner: %v", err)
+	}
+	if m, _ := s.Member(o.ID, a.ID); m.Role != RoleOwner {
+		t.Fatalf("the only owner's role = %s", m.Role)
+	}
+
+	refused := errors.New("refused")
+	if _, err := s.UpdateMember(o.ID, b.ID, func(m *Member) error { return refused }); !errors.Is(err, refused) {
