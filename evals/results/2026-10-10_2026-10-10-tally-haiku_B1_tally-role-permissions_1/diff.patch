+		t.Fatal(err)
+	}
+	if _, err := s.UpdateMember(o.ID, a.ID, func(m *Member) error { m.Role = RoleAdmin; return nil }); err != nil {
+		t.Fatalf("demoting an owner while another owner remains: %v", err)
