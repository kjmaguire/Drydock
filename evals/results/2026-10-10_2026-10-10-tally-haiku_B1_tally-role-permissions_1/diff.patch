--- /dev/null
+++ b/result/internal/api/roles_test.go
@@ -0,0 +1,302 @@
+package api_test
+
+import (
+	"net/http"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// The roles of the permissions table, as sets.
+var (
+	allRoles = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer}
+	writers  = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember}
+	billers  = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling}
+	admins   = []store.Role{store.RoleOwner, store.RoleAdmin}
+)
+
+// roleKeys gives Acme one member per role besides owner (whose key is the org's) and returns every role's API key.
+func roleKeys(e *apitest.Env) map[store.Role]string {
+	keys := map[store.Role]string{store.RoleOwner: e.Acme.Key}
+	for _, role := range []store.Role{store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		_, keys[role] = e.AddMember(e.Acme, string(role)+"@acme.example", role)
+	}
+	return keys
+}
+
+func TestRolePermissionsMatrix(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	calls := []struct {
+		method, path string
+		body         any
+		allowed      []store.Role
+	}{
+		{"GET", "/v1/me", nil, allRoles},
+		{"GET", "/v1/org", nil, allRoles},
+		{"PATCH", "/v1/org", map[string]any{"tax_rate_bp": 0}, admins},
+		{"GET", "/v1/members", nil, allRoles},
+		{"PATCH", "/v1/members/usr_nope", map[string]string{"role": "member"}, admins},
+		{"DELETE", "/v1/members/usr_nope", nil, admins},
+		{"GET", "/v1/invites", nil, allRoles},
+		{"POST", "/v1/invites", map[string]string{"email": "new@people.example", "role": "viewer"}, admins},
+		{"DELETE", "/v1/invites/inv_nope", nil, admins},
+		{"GET", "/v1/api-keys", nil, allRoles},
+		{"POST", "/v1/api-keys", map[string]string{"name": "CI"}, allRoles},
+
+		{"GET", "/v1/customers", nil, allRoles},
+		{"GET", "/v1/customers/export.csv", nil, allRoles},
+		{"GET", "/v1/customers/cus_nope", nil, allRoles},
+		{"POST", "/v1/customers", map[string]string{"name": "Jane", "email": "jane@example.com"}, writers},
+		{"PATCH", "/v1/customers/cus_nope", map[string]string{"name": "X"}, writers},
+		{"DELETE", "/v1/customers/cus_nope", nil, writers},
+
+		{"GET", "/v1/plans", nil, allRoles},
+		{"GET", "/v1/plans/pln_nope", nil, allRoles},
+		{"POST", "/v1/plans", map[string]string{"name": "Pro", "currency": "USD", "price": "10.00", "interval": "month"}, billers},
+		{"PATCH", "/v1/plans/pln_nope", map[string]string{"name": "Pro 2"}, billers},
+
+		{"GET", "/v1/subscriptions", nil, allRoles},
+		{"GET", "/v1/subscriptions/sub_nope", nil, allRoles},
+		{"POST", "/v1/subscriptions", map[string]string{"customer_id": "cus_nope", "plan_id": "pln_nope"}, writers},
+		{"PATCH", "/v1/subscriptions/sub_nope", map[string]string{"quantity": "2"}, writers},
+		{"POST", "/v1/subscriptions/sub_nope/cancel", nil, writers},
+		{"POST", "/v1/subscriptions/sub_nope/usage", map[string]int{"quantity": 1}, writers},
+
+		{"GET", "/v1/invoices", nil, allRoles},
+		{"GET", "/v1/invoices/inv_nope", nil, allRoles},
+		{"GET", "/v1/invoices/inv_nope/lines", nil, allRoles},
+		{"GET", "/v1/payments", nil, allRoles},
+		{"POST", "/v1/invoices", map[string]string{"customer_id": "cus_nope"}, billers},
+		{"POST", "/v1/invoices/inv_nope/pay", nil, billers},
+		{"POST", "/v1/invoices/inv_nope/void", nil, billers},
+		{"GET", "/v1/reports/revenue?from=2026-01-01&to=2026-01-31", nil, billers},
+
+		{"GET", "/v1/webhook-endpoints", nil, admins},
+		{"POST", "/v1/webhook-endpoints", map[string]any{"url": "https://hooks.acme.example/a", "events": []string{"invoice.paid"}}, admins},
+		{"GET", "/v1/webhook-endpoints/wh_nope", nil, admins},
+		{"PATCH", "/v1/webhook-endpoints/wh_nope", map[string]bool{"enabled": false}, admins},
+		{"DELETE", "/v1/webhook-endpoints/wh_nope", nil, admins},
+		{"GET", "/v1/webhook-endpoints/wh_nope/deliveries", nil, admins},
+		{"GET", "/v1/events", nil, admins},
+		{"GET", "/v1/events/evt_nope", nil, admins},
+	}
+	for _, c := range calls {
+		for _, role := range allRoles {
+			r := e.Do(c.method, c.path, keys[role], c.body)
+			if r.Code >= 500 {
+				t.Fatalf("%s %s as %s: %s", c.method, c.path, role, r)
+			}
+			if contains(c.allowed, role) {
+				if r.Code == http.StatusUnauthorized || r.Code == http.StatusForbidden {
+					t.Fatalf("%s %s as %s: want the request to be allowed, got %s", c.method, c.path, role, r)
+				}
+				continue
+			}
+			if r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+				t.Fatalf("%s %s as %s: want 403 forbidden, got %s", c.method, c.path, role, r)
+			}
+		}
+	}
+}
+
+func contains(roles []store.Role, role store.Role) bool {
+	for _, r := range roles {
+		if r == role {
+			return true
+		}
+	}
+	return false
+}
+
+func TestRefusedRequestsChangeNothing(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	admin, _ := e.Store.UserByEmail("admin@acme.example")
+	member, _ := e.Store.UserByEmail("member@acme.example")
+	customers := len(e.Store.Customers(e.Acme.ID))
+	plans := len(e.Store.Plans(e.Acme.ID))
+
+	if r := e.Do("POST", "/v1/customers", keys[store.RoleViewer], map[string]string{"name": "X", "email": "x@example.com"}); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer creates a customer: %s", r)
+	}
+	if r := e.Do("POST", "/v1/plans", keys[store.RoleMember], map[string]string{"name": "Pro", "currency": "USD", "price": "10.00", "interval": "month"}); r.Code != http.StatusForbidden {
+		t.Fatalf("member creates a plan: %s", r)
+	}
+	if got := len(e.Store.Customers(e.Acme.ID)); got != customers {
+		t.Fatalf("customers = %d, want %d", got, customers)
+	}
+	if got := len(e.Store.Plans(e.Acme.ID)); got != plans {
+		t.Fatalf("plans = %d, want %d", got, plans)
+	}
+
+	if r := e.Do("PATCH", "/v1/org", keys[store.RoleBilling], map[string]string{"name": "Hacked"}); r.Code != http.StatusForbidden {
+		t.Fatalf("billing renames the org: %s", r)
+	}
+	if o, _ := e.Store.Org(e.Acme.ID); o.Name != "Acme" {
+		t.Fatalf("org name = %q", o.Name)
+	}
+
+	if r := e.Do("POST", "/v1/invites", keys[store.RoleAdmin], map[string]string{"email": "boss@people.example", "role": "admin"}); r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+		t.Fatalf("admin invites an admin: %s", r)
+	}
+	if n := len(e.Store.Invites(e.Acme.ID)); n != 0 {
+		t.Fatalf("invites = %d after a refused invite", n)
+	}
+
+	if r := e.Do("PATCH", "/v1/members/"+member.ID, keys[store.RoleAdmin], map[string]string{"role": "admin"}); r.Code != http.StatusForbidden {
+		t.Fatalf("admin promotes a member to admin: %s", r)
+	}
+	if m, _ := e.Store.Member(e.Acme.ID, member.ID); m.Role != store.RoleMember {
+		t.Fatalf("member's role = %s", m.Role)
+	}
+
+	if r := e.Do("DELETE", "/v1/members/"+member.ID, keys[store.RoleViewer], nil); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer removes a member: %s", r)
+	}
+	if _, ok := e.Store.Member(e.Acme.ID, member.ID); !ok {
+		t.Fatal("a refused removal removed the member")
+	}
+	if _, ok := e.Store.Member(e.Acme.ID, admin.ID); !ok {
+		t.Fatal("admin missing")
+	}
+}
+
+func TestRoleChangeAppliesToExistingKeys(t *testing.T) {
+	e := apitest.New(t)
+	member, key := e.AddMember(e.Acme, "dev@acme.example", store.RoleMember)
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, map[string]string{"name": "Jane", "email": "jane@example.com"}, nil)
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, e.Acme.Key, map[string]string{"role": "viewer"}, nil)
+	if r := e.Do("POST", "/v1/customers", key, map[string]string{"name": "Joe", "email": "joe@example.com"}); r.Code != http.StatusForbidden {
+		t.Fatalf("demoted member writes with an old key: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", key, nil, nil)
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, e.Acme.Key, map[string]string{"role": "billing"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", key, map[string]string{"name": "Pro", "currency": "USD", "price": "10.00", "interval": "month"}, nil)
+}
+
+func TestMemberRoleRules(t *testing.T) {
+	e := apitest.New(t)
+	adminUser, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	otherAdmin, _ := e.AddMember(e.Acme, "admin2@acme.example", store.RoleAdmin)
+	billing, _ := e.AddMember(e.Acme, "billing@acme.example", store.RoleBilling)
+	member, _ := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	owner, _ := e.Store.UserByEmail("owner@acme.example")
+
+	// Nobody changes their own role.
+	if r := e.Do("PATCH", "/v1/members/"+owner.ID, e.Acme.Key, map[string]string{"role": "admin"}); r.Code != http.StatusForbidden {
+		t.Fatalf("owner changes their own role: %s", r)
+	}
+	if r := e.Do("PATCH", "/v1/members/"+adminUser.ID, adminKey, map[string]string{"role": "member"}); r.Code != http.StatusForbidden {
+		t.Fatalf("admin changes their own role: %s", r)
+	}
+
+	// Only owners give the owner or admin role, or change or remove an owner or an admin.
+	if r := e.Do("PATCH", "/v1/members/"+member.ID, adminKey, map[string]string{"role": "admin"}); r.Code != http.StatusForbidden {
+		t.Fatalf("admin makes an admin: %s", r)
+	}
+	if r := e.Do("PATCH", "/v1/members/"+member.ID, adminKey, map[string]string{"role": "owner"}); r.Code != http.StatusForbidden {
+		t.Fatalf("admin makes an owner: %s", r)
+	}
+	if r := e.Do("PATCH", "/v1/members/"+otherAdmin.ID, adminKey, map[string]string{"role": "billing"}); r.Code != http.StatusForbidden {
+		t.Fatalf("admin demotes another admin: %s", r)
+	}
+	if r := e.Do("PATCH", "/v1/members/"+owner.ID, adminKey, map[string]string{"role": "member"}); r.Code != http.StatusForbidden {
+		t.Fatalf("admin demotes the owner: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/members/"+owner.ID, adminKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("admin removes the owner: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/members/"+otherAdmin.ID, adminKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("admin removes another admin: %s", r)
+	}
+	if r := e.Do("POST", "/v1/invites", adminKey, map[string]string{"email": "boss@people.example", "role": "admin"}); r.Code != http.StatusForbidden {
+		t.Fatalf("admin invites an admin: %s", r)
+	}
+
+	// Within those limits, admins manage billing and member roles.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+billing.ID, adminKey, map[string]string{"role": "member"}, nil)
+	if r := e.Do("PATCH", "/v1/members/"+billing.ID, adminKey, map[string]string{"role": "superuser"}); r.Code != http.StatusUnprocessableEntity {
+		t.Fatalf("unknown role: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+member.ID, adminKey, nil, nil)
+
+	// Owners may do all of it.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+otherAdmin.ID, e.Acme.Key, map[string]string{"role": "member"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "boss@people.example", "role": "admin"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+otherAdmin.ID, e.Acme.Key, nil, nil)
+}
+
+func TestLeavingAndLastOwner(t *testing.T) {
+	e := apitest.New(t)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+viewer.ID, viewerKey, nil, nil)
+	if r := e.Do("GET", "/v1/me", viewerKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a member who left: %s", r)
+	}
+
+	second, secondKey := e.AddMember(e.Acme, "second@acme.example", store.RoleOwner)
+	owner, _ := e.Store.UserByEmail("owner@acme.example")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+second.ID, e.Acme.Key, nil, nil)
+	if r := e.Do("GET", "/v1/me", secondKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a removed owner's key: %s", r)
+	}
+
+	// The only owner may not leave, and nothing changes.
+	var out struct {
+		Code string `json:"error"`
+	}
+	r := e.Do("DELETE", "/v1/members/"+owner.ID, e.Acme.Key, nil)
+	r.JSON(t, &out)
+	if r.Code != http.StatusConflict || out.Code != "last_owner" {
+		t.Fatalf("the only owner leaves: %s", r)
+	}
+	if m, _ := e.Store.Member(e.Acme.ID, owner.ID); m.Role != store.RoleOwner {
+		t.Fatalf("owner's role = %s", m.Role)
+	}
+}
+
+func TestAPIKeyRevocationRules(t *testing.T) {
+	e := apitest.New(t)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	_, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	ownerKey, _ := e.Store.APIKeyByToken(e.Acme.Key)
+
+	// Everyone may create keys; a viewer lists only their own.
+	var mine store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", viewerKey, map[string]string{"name": "laptop"}, &mine)
+	var list struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", viewerKey, nil, &list)
+	if len(list.Items) != 2 {
+		t.Fatalf("viewer's keys = %+v", list.Items)
+	}
+	for _, k := range list.Items {
+		if k.UserID != viewer.ID {
+			t.Fatalf("viewer sees someone else's key: %+v", k)
+		}
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, &list)
+	if len(list.Items) != 5 {
+		t.Fatalf("owner's view of keys = %d, want 5", len(list.Items))
+	}
+
+	// Anyone may revoke their own; others' keys need an owner or admin.
+	if r := e.Do("DELETE", "/v1/api-keys/"+ownerKey.ID, viewerKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer revokes the owner's key: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/api-keys/"+ownerKey.ID, memberKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("member revokes the owner's key: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+mine.ID, viewerKey, nil, nil)
+	if r := e.Do("GET", "/v1/org", mine.Token, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("revoked own key: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+ownerKey.ID, adminKey, nil, nil)
+	if r := e.Do("GET", "/v1/org", e.Acme.Key, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("admin revoked the owner's key, which still works: %s", r)
+	}
+}
