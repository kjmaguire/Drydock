 	Role   store.Role
 }
 
+// Capability is a set of roles: what an endpoint needs of the member who calls it. The sets are the columns of the
+// permissions table in the README.
+type Capability int
+
+const (
+	// Everyone is every role, viewers included.
+	Everyone Capability = iota
+	// Editors is every role but viewers. They create and change customers and subscriptions and report usage.
+	Editors
+	// BillingStaff is owners, admins and billing. They create and change plans, create, pay and void invoices, and read
+	// the revenue report.
+	BillingStaff
+	// Admins is owners and admins. They manage webhooks, the organization, invites and members.
+	Admins
+)
+
+// Allows reports whether a role is in the set.
+func (c Capability) Allows(r store.Role) bool {
+	switch c {
+	case Everyone:
+		return true
+	case Editors:
+		return r != store.RoleViewer
+	case BillingStaff:
+		return r == store.RoleOwner || r == store.RoleAdmin || r == store.RoleBilling
+	case Admins:
+		return r == store.RoleOwner || r == store.RoleAdmin
+	}
+	return false
+}
+
 // CanWrite reports whether a role may change anything. Viewers only read.
-func CanWrite(r store.Role) bool { return r != store.RoleViewer }
+func CanWrite(r store.Role) bool { return Editors.Allows(r) }
 
 // CanManageTeam reports whether a role may manage the organization's settings, members and invites.
-func CanManageTeam(r store.Role) bool { return r == store.RoleOwner || r == store.RoleAdmin }
+func CanManageTeam(r store.Role) bool { return Admins.Allows(r) }
