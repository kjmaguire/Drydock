+// UpdateMember changes a member with f, under the store's lock, so that the caller's checks see the role the change
+// replaces. f may refuse by returning an error, which is returned unchanged. A change that would leave the organization
+// without an owner fails with ErrLastOwner.
+func (s *Store) UpdateMember(orgID, userID string, f func(*Member) error) (Member, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := memberKey{orgID, userID}
+	old, ok := s.members[k]
+	if !ok {
+		return Member{}, ErrNotFound
+	}
+	m := old
+	if err := f(&m); err != nil {
+		return Member{}, err
+	}
+	if !m.Role.Valid() {
+		return Member{}, invalid("unknown role %q", m.Role)
+	}
+	if old.Role == RoleOwner && m.Role != RoleOwner && s.ownersLocked(orgID) == 1 {
+		return Member{}, ErrLastOwner
+	}
+	s.members[k] = m
+	return m, nil
+}
+
+// RemoveMemberChecked removes a member, under the store's lock, after check has approved the removal (check may refuse by
+// returning an error, which is returned unchanged). A removal that would leave the organization without an owner fails
+// with ErrLastOwner.
+func (s *Store) RemoveMemberChecked(orgID, userID string, check func(Member) error) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := memberKey{orgID, userID}
+	m, ok := s.members[k]
+	if !ok {
+		return ErrNotFound
+	}
+	if err := check(m); err != nil {
+		return err
+	}
+	if m.Role == RoleOwner && s.ownersLocked(orgID) == 1 {
+		return ErrLastOwner
+	}
+	delete(s.members, k)
+	return nil
+}
+
+// ownersLocked counts an organization's owners. The caller holds s.mu.
+func (s *Store) ownersLocked(orgID string) int {
+	n := 0
+	for _, m := range s.members {
+		if m.OrgID == orgID && m.Role == RoleOwner {
+			n++
+		}
+	}
+	return n
+}
+
