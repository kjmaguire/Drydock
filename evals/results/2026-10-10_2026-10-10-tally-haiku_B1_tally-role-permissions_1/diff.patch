+// refusal is a request that the member's role does not allow, for a reason the caller is told. It answers 403 forbidden.
+type refusal string
+
+func (r refusal) Error() string { return string(r) }
+
 // storeError answers for an error from the store or a service.
 func (s *Server) storeError(w http.ResponseWriter, err error) {
+	var ref refusal
 	switch {
+	case errors.As(err, &ref):
+		writeError(w, http.StatusForbidden, "forbidden", string(ref))
+	case errors.Is(err, store.ErrLastOwner):
+		writeError(w, http.StatusConflict, "last_owner", err.Error())
 	case errors.Is(err, store.ErrNotFound):
 		writeError(w, http.StatusNotFound, "not_found", "no such object")
 	case errors.Is(err, store.ErrEmailTaken):
diff --git a/result/internal/api/roles_test.go b/result/internal/api/roles_test.go
