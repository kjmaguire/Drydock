+// sign returns the v1 signature of a delivery made at unix time t: the hex HMAC-SHA256 of "<t>.<body>", keyed with the secret.
+func sign(secret string, t int64, body []byte) string {
+	m := hmac.New(sha256.New, []byte(secret))
+	m.Write([]byte(strconv.FormatInt(t, 10) + "."))
+	m.Write(body)
+	return hex.EncodeToString(m.Sum(nil))
+}
+
+// SignatureHeader returns the Tally-Signature header of a delivery made at t: "t=<unix seconds>,v1=<signature>", with one v1
+// entry per secret, current first.
+func SignatureHeader(secrets []string, t time.Time, body []byte) string {
+	ts := t.Unix()
+	var b strings.Builder
+	b.WriteString("t=" + strconv.FormatInt(ts, 10))
+	for _, secret := range secrets {
+		b.WriteString(",v1=" + sign(secret, ts, body))
+	}
+	return b.String()
+}
+
+// SigningSecrets returns the secrets that sign an endpoint's deliveries at now: its current secret and, for 24 hours after a
+// rotation, the previous one.
+func SigningSecrets(ep store.WebhookEndpoint, now time.Time) []string {
+	secrets := []string{ep.Secret}
+	if ep.PreviousSecret != "" && ep.SecretRotatedAt != nil && now.Before(ep.SecretRotatedAt.Add(secretGrace)) {
+		secrets = append(secrets, ep.PreviousSecret)
+	}
+	return secrets
+}
+
+// Verify checks a delivery's Tally-Signature header against its payload. The header's timestamp must be within tolerance of
+// now, in either direction (0 means five minutes), and one of its v1 signatures must match the payload signed with one of the
+// secrets. Unknown keys in the header are ignored.
+func Verify(payload []byte, header string, secrets []string, tolerance time.Duration, now time.Time) error {
+	if tolerance == 0 {
+		tolerance = defaultTolerance
+	}
+	if strings.TrimSpace(header) == "" {
+		return fmt.Errorf("%w: the header is empty", ErrMalformedHeader)
+	}
+	var (
+		ts    int64
+		hasTS bool
+		v1s   []string
+	)
+	for _, pair := range strings.Split(header, ",") {
+		key, value, ok := strings.Cut(pair, "=")
+		if !ok {
+			return fmt.Errorf("%w: %q has no =", ErrMalformedHeader, strings.TrimSpace(pair))
+		}
+		key, value = strings.TrimSpace(key), strings.TrimSpace(value)
+		switch key {
+		case "t":
+			t, err := strconv.ParseInt(value, 10, 64)
+			if err != nil {
+				return fmt.Errorf("%w: t=%q is not an integer", ErrMalformedHeader, value)
+			}
+			if !hasTS {
+				ts, hasTS = t, true
+			}
+		case "v1":
+			v1s = append(v1s, value)
+		}
+	}
+	if !hasTS {
+		return fmt.Errorf("%w: the header has no t", ErrNoTimestamp)
+	}
+	at := time.Unix(ts, 0)
+	if at.Before(now.Add(-tolerance)) || at.After(now.Add(tolerance)) {
+		return fmt.Errorf("%w: t=%d is more than %s from now", ErrTimestampTolerance, ts, tolerance)
+	}
+	if len(v1s) == 0 {
+		return fmt.Errorf("%w: the header has no v1 entry", ErrNoSignature)
+	}
+	for _, secret := range secrets {
+		want := []byte(sign(secret, ts, payload))
+		for _, got := range v1s {
+			if hmac.Equal([]byte(got), want) {
+				return nil
+			}
+		}
+	}
+	return ErrSignatureMismatch
+}
