+// Group is how a revenue report divides its range into buckets.
+type Group string
+
+// Groups. A week starts on Monday; a month is a calendar month.
+const (
+	GroupDay   Group = "day"
+	GroupWeek  Group = "week"
+	GroupMonth Group = "month"
+)
+
+// Valid reports whether g is a known group.
+func (g Group) Valid() bool { return g == GroupDay || g == GroupWeek || g == GroupMonth }
+
 // Errors.
 var (
 	ErrInvalidDate  = errors.New("invalid date")
 	ErrInvalidRange = errors.New("invalid date range")
+	ErrInvalidGroup = errors.New("invalid group")
 )
 
 // MaxDays is the longest range a report covers.
 const MaxDays = 366
 
+// Bucket is what an organization took in one day, week or month, in each currency. Start is the first day of the
+// bucket (YYYY-MM-DD) in the organization's time zone.
+type Bucket struct {
+	Start    string                   `json:"start"`
+	Amounts  map[money.Currency]int64 `json:"amounts"`
+	Payments int                      `json:"payments"`
+}
+
+// GroupedRevenue is a revenue report: the buckets from the one holding from to the one holding to, in order.
+type GroupedRevenue struct {
+	TimeZone string   `json:"time_zone"`
+	Group    Group    `json:"group"`
+	Buckets  []Bucket `json:"buckets"`
+}
+
 // Revenue adds up the organization's succeeded payments per day and currency, from the day from to the day to (YYYY-MM-DD,
-// both included). Days are UTC days. The result is in date order, currencies in alphabetical order within a day; days
-// without payments are left out.
+// both included). Days are days in the organization's time zone. The result is in date order, currencies in alphabetical
+// order within a day; days without payments are left out.
 func Revenue(st *store.Store, orgID, from, to string) ([]DayRevenue, error) {
+	rep, counts, err := groupRevenue(st, orgID, from, to, GroupDay)
+	if err != nil {
+		return nil, err
+	}
+	out := []DayRevenue{}
+	for i, b := range rep.Buckets {
+		curs := make([]money.Currency, 0, len(b.Amounts))
+		for c := range b.Amounts {
+			curs = append(curs, c)
+		}
+		sort.Slice(curs, func(i, j int) bool { return curs[i] < curs[j] })
+		for _, c := range curs {
+			out = append(out, DayRevenue{Date: b.Start, Currency: c, Amount: b.Amounts[c], Payments: counts[i][c]})
+		}
+	}
+	return out, nil
+}
+
+// RevenueByGroup adds up the organization's succeeded payments per bucket and currency, from the day from to the day to
+// (YYYY-MM-DD, both included). Days are days in the organization's time zone, so a payment belongs to the day, in that
+// time zone, when it was made. An empty group means day. Every bucket from the one holding from to the one holding to is
+// in the result, in order, also those without payments.
+func RevenueByGroup(st *store.Store, orgID, from, to string, group Group) (GroupedRevenue, error) {
+	rep, _, err := groupRevenue(st, orgID, from, to, group)
+	return rep, err
+}
+
+// groupRevenue is RevenueByGroup, and also counts each bucket's payments per currency (counts[i][currency]).
+func groupRevenue(st *store.Store, orgID, from, to string, group Group) (GroupedRevenue, []map[money.Currency]int, error) {
 	start, err := time.Parse(time.DateOnly, from)
 	if err != nil {
