+		return GroupedRevenue{}, nil, fmt.Errorf("%w: to %q", ErrInvalidDate, to)
 	}
 	if last.Before(start) {
-		return nil, fmt.Errorf("%w: to is before from", ErrInvalidRange)
+		return GroupedRevenue{}, nil, fmt.Errorf("%w: to is before from", ErrInvalidRange)
 	}
 	if last.Sub(start) >= MaxDays*24*time.Hour {
-		return nil, fmt.Errorf("%w: at most %d days", ErrInvalidRange, MaxDays)
+		return GroupedRevenue{}, nil, fmt.Errorf("%w: at most %d days", ErrInvalidRange, MaxDays)
+	}
+	if group == "" {
+		group = GroupDay
+	}
+	if !group.Valid() {
+		return GroupedRevenue{}, nil, fmt.Errorf("%w: %q", ErrInvalidGroup, group)
 	}
-	end := last.AddDate(0, 0, 1)
-	type key struct {
-		day string
-		cur money.Currency
+	org, ok := st.Org(orgID)
+	if !ok {
+		return GroupedRevenue{}, nil, store.ErrNotFound
+	}
+	loc, err := time.LoadLocation(org.TimeZone)
+	if err != nil {
+		return GroupedRevenue{}, nil, fmt.Errorf("organization time zone %q: %w", org.TimeZone, err)
+	}
+
+	// Buckets are counted in civil dates, held as UTC midnights so that adding days and months never meets daylight saving.
+	buckets := []Bucket{}
+	counts := []map[money.Currency]int{}
+	index := map[string]int{}
+	for b := bucketOf(start, group); !b.After(bucketOf(last, group)); b = nextBucket(b, group) {
+		index[b.Format(time.DateOnly)] = len(buckets)
+		buckets = append(buckets, Bucket{Start: b.Format(time.DateOnly), Amounts: map[money.Currency]int64{}})
+		counts = append(counts, map[money.Currency]int{})
 	}
-	sums := map[key]*DayRevenue{}
 	for _, p := range st.Payments(orgID, "") {
-		if p.Status != store.PaymentSucceeded || p.CreatedAt.Before(start) || !p.CreatedAt.Before(end) {
+		if p.Status != store.PaymentSucceeded {
 			continue
 		}
-		k := key{p.CreatedAt.UTC().Format(time.DateOnly), p.Currency}
-		d, ok := sums[k]
-		if !ok {
