-			sums[k] = d
+		local := p.CreatedAt.In(loc)
+		day := time.Date(local.Year(), local.Month(), local.Day(), 0, 0, 0, 0, time.UTC)
+		if day.Before(start) || day.After(last) {
+			continue
 		}
-		d.Amount += p.Amount
-		d.Payments++
+		i := index[bucketOf(day, group).Format(time.DateOnly)]
+		buckets[i].Amounts[p.Currency] += p.Amount
+		buckets[i].Payments++
+		counts[i][p.Currency]++
 	}
-	out := make([]DayRevenue, 0, len(sums))
-	for _, d := range sums {
-		out = append(out, *d)
+	return GroupedRevenue{TimeZone: org.TimeZone, Group: group, Buckets: buckets}, counts, nil
+}
+
+// bucketOf returns the first day of the bucket that holds day (a UTC midnight).
+func bucketOf(day time.Time, g Group) time.Time {
+	switch g {
+	case GroupWeek:
+		return day.AddDate(0, 0, -((int(day.Weekday()) + 6) % 7)) // Monday is the first day of the week
+	case GroupMonth:
+		return time.Date(day.Year(), day.Month(), 1, 0, 0, 0, 0, time.UTC)
 	}
-	sort.Slice(out, func(i, j int) bool {
-		if out[i].Date != out[j].Date {
-			return out[i].Date < out[j].Date
-		}
-		return out[i].Currency < out[j].Currency
-	})
-	return out, nil
+	return day
+}
+
+// nextBucket returns the first day of the bucket after b.
+func nextBucket(b time.Time, g Group) time.Time {
+	switch g {
+	case GroupWeek:
+		return b.AddDate(0, 0, 7)
+	case GroupMonth:
+		return b.AddDate(0, 1, 0)
+	}
+	return b.AddDate(0, 0, 1)
 }
