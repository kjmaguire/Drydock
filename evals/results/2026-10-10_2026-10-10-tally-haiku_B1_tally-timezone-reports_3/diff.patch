+
+// newOrgWithPayments makes an organization in tz and a succeeded payment of amount in cur at each of the given times.
+func newOrgWithPayments(t *testing.T, tz string, cur money.Currency, times map[int64]time.Time, amounts ...int64) (*store.Store, string) {
+	t.Helper()
+	st := store.New()
+	created := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	o, err := st.CreateOrg("A", store.OrgTeam, tz, 0, created)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, _ := st.CreateCustomer(o.ID, "Jane", "jane@example.com", created)
+	inv, _ := st.CreateInvoice(store.Invoice{OrgID: o.ID, CustomerID: c.ID, Currency: cur, Lines: []store.Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, created)
+	for i, at := range times {
+		if _, err := st.CreatePayment(store.Payment{OrgID: o.ID, InvoiceID: inv.ID, Amount: amounts[i], Currency: cur, Status: store.PaymentSucceeded}, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return st, o.ID
+}
+
+func utc(y int, m time.Month, d, h, min int) time.Time {
+	return time.Date(y, m, d, h, min, 0, 0, time.UTC)
+}
+
+func TestRevenueByGroupUsesOrgTimeZone(t *testing.T) {
+	// 02:00 UTC on March 2 is still March 1 in New York; 12:00 UTC is March 2 there.
+	times := map[int64]time.Time{0: utc(2026, 3, 2, 2, 0), 1: utc(2026, 3, 2, 12, 0)}
+	st, org := newOrgWithPayments(t, "America/New_York", money.USD, times, 100, 200)
+	got, err := RevenueByGroup(st, org, "2026-03-01", "2026-03-02", GroupDay)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.TimeZone != "America/New_York" || got.Group != GroupDay {
+		t.Fatalf("report = %+v", got)
+	}
+	want := []Bucket{
+		{Start: "2026-03-01", Amounts: map[money.Currency]int64{money.USD: 100}, Payments: 1},
+		{Start: "2026-03-02", Amounts: map[money.Currency]int64{money.USD: 200}, Payments: 1},
+	}
+	checkBuckets(t, got.Buckets, want)
+}
+
+func TestRevenueByGroupDaylightSaving(t *testing.T) {
+	// New York springs forward on March 8, 2026 (a 23-hour day: midnight EST is 05:00 UTC, the next midnight EDT is 04:00 UTC)
+	// and falls back on November 1 (a 25-hour day).
+	times := map[int64]time.Time{
+		0: utc(2026, 3, 9, 3, 59),  // March 8, 23:59 EDT
+		1: utc(2026, 3, 9, 4, 0),   // March 9, 00:00 EDT
+		2: utc(2026, 11, 2, 4, 59), // November 1, 23:59 EDT
+		3: utc(2026, 11, 2, 5, 0),  // November 2, 00:00 EST
+	}
+	st, org := newOrgWithPayments(t, "America/New_York", money.USD, times, 1, 10, 100, 1000)
+	got, err := RevenueByGroup(st, org, "2026-03-08", "2026-03-09", GroupDay)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkBuckets(t, got.Buckets, []Bucket{
+		{Start: "2026-03-08", Amounts: map[money.Currency]int64{money.USD: 1}, Payments: 1},
+		{Start: "2026-03-09", Amounts: map[money.Currency]int64{money.USD: 10}, Payments: 1},
+	})
+	got, err = RevenueByGroup(st, org, "2026-11-01", "2026-11-02", GroupDay)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkBuckets(t, got.Buckets, []Bucket{
+		{Start: "2026-11-01", Amounts: map[money.Currency]int64{money.USD: 100}, Payments: 1},
+		{Start: "2026-11-02", Amounts: map[money.Currency]int64{money.USD: 1000}, Payments: 1},
+	})
+}
+
+func TestRevenueByGroupWeeksAndMonths(t *testing.T) {
+	times := map[int64]time.Time{
+		0: utc(2026, 3, 4, 12, 0),  // Wednesday, week of March 2
+		1: utc(2026, 3, 8, 12, 0),  // Sunday, week of March 2
+		2: utc(2026, 3, 9, 0, 0),   // Monday, week of March 9
+		3: utc(2026, 3, 2, 12, 0),  // Monday, before from: not counted
+		4: utc(2026, 1, 20, 12, 0), // January
+		5: utc(2026, 1, 10, 12, 0), // January, before from: not counted
+	}
+	st, org := newOrgWithPayments(t, "UTC", money.USD, times, 100, 50, 200, 7, 10, 5000)
+	got, err := RevenueByGroup(st, org, "2026-03-04", "2026-03-10", GroupWeek)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkBuckets(t, got.Buckets, []Bucket{
+		{Start: "2026-03-02", Amounts: map[money.Currency]int64{money.USD: 150}, Payments: 2},
+		{Start: "2026-03-09", Amounts: map[money.Currency]int64{money.USD: 200}, Payments: 1},
+	})
+	got, err = RevenueByGroup(st, org, "2026-01-15", "2026-03-02", GroupMonth)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkBuckets(t, got.Buckets, []Bucket{
+		{Start: "2026-01-01", Amounts: map[money.Currency]int64{money.USD: 10}, Payments: 1},
+		{Start: "2026-02-01", Amounts: map[money.Currency]int64{}},
+		{Start: "2026-03-01", Amounts: map[money.Currency]int64{money.USD: 7}, Payments: 1},
+	})
+}
+
+func TestRevenueByGroupEmptyBucketsAndDefault(t *testing.T) {
+	st, org := newOrgWithPayments(t, "UTC", money.EUR, map[int64]time.Time{0: utc(2026, 3, 2, 12, 0)}, 25)
+	got, err := RevenueByGroup(st, org, "2026-03-01", "2026-03-03", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Group != GroupDay {
+		t.Fatalf("an empty group gave %q", got.Group)
+	}
+	checkBuckets(t, got.Buckets, []Bucket{
+		{Start: "2026-03-01", Amounts: map[money.Currency]int64{}},
+		{Start: "2026-03-02", Amounts: map[money.Currency]int64{money.EUR: 25}, Payments: 1},
+		{Start: "2026-03-03", Amounts: map[money.Currency]int64{}},
+	})
+}
+
+func TestRevenueByGroupErrors(t *testing.T) {
+	st, org := newOrgWithPayments(t, "UTC", money.USD, nil)
+	for _, c := range []struct {
+		from, to string
+		group    Group
+		want     error
+	}{
+		{"2026-03-01", "2026-03-05", "Day", ErrInvalidGroup},
+		{"2026-03-01", "2026-03-05", "year", ErrInvalidGroup},
+		{"", "2026-03-05", GroupDay, ErrInvalidDate},
+		{"2026-03-01", "", GroupMonth, ErrInvalidDate},
+		{"2026-03-05", "2026-03-01", GroupWeek, ErrInvalidRange},
+		{"2025-01-01", "2026-01-02", GroupDay, ErrInvalidRange},
+	} {
+		if _, err := RevenueByGroup(st, org, c.from, c.to, c.group); !errors.Is(err, c.want) {
+			t.Errorf("RevenueByGroup(%s, %s, %q) = %v, want %v", c.from, c.to, c.group, err, c.want)
+		}
+	}
+	if got, err := RevenueByGroup(st, org, "2025-01-01", "2026-01-01", GroupDay); err != nil || len(got.Buckets) != MaxDays {
+		t.Fatalf("a range of %d days: %d buckets, %v", MaxDays, len(got.Buckets), err)
+	}
+}
+
+func checkBuckets(t *testing.T, got, want []Bucket) {
+	t.Helper()
+	if len(got) != len(want) {
+		t.Fatalf("buckets = %+v, want %+v", got, want)
+	}
+	for i := range want {
+		if got[i].Start != want[i].Start || got[i].Payments != want[i].Payments || !maps.Equal(got[i].Amounts, want[i].Amounts) {
+			t.Fatalf("bucket %d = %+v, want %+v", i, got[i], want[i])
+		}
+	}
 }
