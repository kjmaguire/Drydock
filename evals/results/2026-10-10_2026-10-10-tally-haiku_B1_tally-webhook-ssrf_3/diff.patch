+// checkDestination resolves the endpoint's host again, just before a delivery, and fails when any address it resolves to is
+// not public. DNS answers can change after the URL was saved.
+func (s *Service) checkDestination(ctx context.Context, raw string) error {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return errors.New("the endpoint's URL is invalid")
+	}
+	addrs, err := s.hostAddrs(ctx, u.Hostname())
+	if err != nil {
+		return errors.New("the endpoint's host does not resolve")
+	}
+	for _, a := range addrs {
+		if !isPublic(a) {
+			return errors.New("the endpoint's address is not public")
+		}
+	}
 	return nil
 }
 
