+func TestDeliveryRefusesAddressThatBecameNonPublic(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	now := e.Clock.Now()
+	ep, err := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/in", Events: []string{"*"}, Secret: "whsec_a", Enabled: true}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The host was public when the URL was saved; now its DNS answer points into our network.
+	e.DNS.Set("hooks.acme.example", "93.184.216.34", "169.254.169.254")
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v", n, err)
+	}
+	if reqs := e.HTTP.Requests(); len(reqs) != 0 {
+		t.Fatalf("a request was sent to a non-public address: %+v", reqs)
+	}
+	ds := e.Store.Deliveries(e.Acme.ID, ep.ID)
+	if len(ds) != 1 || ds[0].Status != store.DeliveryFailed || !strings.Contains(ds[0].Error, "not public") {
+		t.Fatalf("deliveries = %+v", ds)
+	}
+	kept, ok := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if !ok || kept.URL != ep.URL || !kept.Enabled {
+		t.Fatalf("endpoint changed: %+v", kept)
+	}
+
+	// Once the host points at public addresses again, the next delivery goes out.
+	e.DNS.Set("hooks.acme.example", "93.184.216.34")
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.updated", map[string]string{"id": "cus_1"})
+	if n, _ := e.Webhooks.RunDue(ctx); n != 1 || len(e.HTTP.Requests()) != 1 {
+		t.Fatalf("RunDue = %d, requests = %d", n, len(e.HTTP.Requests()))
+	}
+}
