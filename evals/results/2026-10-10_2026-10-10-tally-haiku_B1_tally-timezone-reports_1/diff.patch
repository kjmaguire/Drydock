+// zonedOrg is an organization in tz with an invoice to take payments on, and a function that records a payment.
+func zonedOrg(t *testing.T, tz string) (*store.Store, string, func(int64, money.Currency, store.PaymentStatus, time.Time)) {
+	t.Helper()
+	st := store.New()
+	at := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	o, err := st.CreateOrg("Z", store.OrgTeam, tz, 0, at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, _ := st.CreateCustomer(o.ID, "Jane", "jane@example.com", at)
+	inv, _ := st.CreateInvoice(store.Invoice{OrgID: o.ID, CustomerID: c.ID, Currency: money.USD, Lines: []store.Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, at)
+	pay := func(amount int64, cur money.Currency, status store.PaymentStatus, when time.Time) {
+		if _, err := st.CreatePayment(store.Payment{OrgID: o.ID, InvoiceID: inv.ID, Amount: amount, Currency: cur, Status: status}, when); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return st, o.ID, pay
+}
+
+func TestRevenueUsesOrgTimeZone(t *testing.T) {
+	ny, err := time.LoadLocation("America/New_York")
+	if err != nil {
+		t.Fatal(err)
+	}
+	st, orgID, pay := zonedOrg(t, "America/New_York")
+	// 23:30 on 2 March in New York is 04:30 UTC on 3 March.
+	pay(1000, money.USD, store.PaymentSucceeded, time.Date(2026, 3, 2, 23, 30, 0, 0, ny))
+	got, err := Revenue(st, orgID, "2026-03-02", "2026-03-02")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0] != (DayRevenue{Date: "2026-03-02", Currency: money.USD, Amount: 1000, Payments: 1}) {
+		t.Fatalf("Revenue = %+v", got)
+	}
+}
