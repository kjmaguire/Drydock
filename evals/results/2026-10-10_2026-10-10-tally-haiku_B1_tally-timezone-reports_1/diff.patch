+
+// RevenueReport adds up the organization's succeeded payments from the day from to the day to (YYYY-MM-DD, both included),
+// grouped by day, week or month. A payment belongs to the day, in the organization's time zone, when it was made. The
+// buckets run from the one holding from to the one holding to, in order, and include those without payments. An empty
+// group means ByDay.
+func RevenueReport(st *store.Store, orgID, from, to string, group Group) (Report, error) {
+	start, last, err := span(from, to)
+	if err != nil {
+		return Report{}, err
+	}
+	if group == "" {
+		group = ByDay
+	}
+	if group != ByDay && group != ByWeek && group != ByMonth {
+		return Report{}, fmt.Errorf("%w: %q", ErrInvalidGroup, group)
+	}
+	loc, err := zone(st, orgID)
+	if err != nil {
+		return Report{}, err
+	}
+
+	out := Report{TimeZone: loc.String(), Group: group}
+	index := map[string]int{}
+	for b := bucketStart(start, group); !b.After(bucketStart(last, group)); b = nextBucket(b, group) {
+		index[b.Format(time.DateOnly)] = len(out.Buckets)
+		out.Buckets = append(out.Buckets, Bucket{Start: b.Format(time.DateOnly), Amounts: map[money.Currency]int64{}})
+	}
+	for _, p := range paid(st, orgID, loc, start, last) {
+		bk := &out.Buckets[index[bucketStart(p.day, group).Format(time.DateOnly)]]
+		bk.Amounts[p.Currency] += p.Amount
+		bk.Payments++
+	}
+	return out, nil
+}
+
+// dayPayment is a succeeded payment and the day it belongs to.
+type dayPayment struct {
+	store.Payment
+	day time.Time // the civil day in the organization's time zone, as a UTC midnight
+}
+
+// paid returns the organization's succeeded payments whose day, in loc, is from start to last (both included).
+func paid(st *store.Store, orgID string, loc *time.Location, start, last time.Time) []dayPayment {
+	var out []dayPayment
+	for _, p := range st.Payments(orgID, "") {
+		if p.Status != store.PaymentSucceeded {
+			continue
+		}
+		y, m, d := p.CreatedAt.In(loc).Date()
+		day := time.Date(y, m, d, 0, 0, 0, 0, time.UTC)
+		if day.Before(start) || day.After(last) {
+			continue
+		}
+		out = append(out, dayPayment{Payment: p, day: day})
+	}
+	return out
+}
+
+// span reads from and to, both included, as UTC midnights. They are days on the calendar, not instants, so their
+// length in hours is meaningless; only the calendar arithmetic on them is used.
+func span(from, to string) (time.Time, time.Time, error) {
+	start, err := time.Parse(time.DateOnly, from)
+	if err != nil {
+		return time.Time{}, time.Time{}, fmt.Errorf("%w: from %q", ErrInvalidDate, from)
+	}
+	last, err := time.Parse(time.DateOnly, to)
+	if err != nil {
+		return time.Time{}, time.Time{}, fmt.Errorf("%w: to %q", ErrInvalidDate, to)
+	}
+	if last.Before(start) {
+		return time.Time{}, time.Time{}, fmt.Errorf("%w: to is before from", ErrInvalidRange)
+	}
+	if last.Sub(start) >= MaxDays*24*time.Hour {
+		return time.Time{}, time.Time{}, fmt.Errorf("%w: at most %d days", ErrInvalidRange, MaxDays)
+	}
+	return start, last, nil
+}
+
+// zone is the location of the organization's time zone. An organization that does not exist has no payments, so its
+// reports are in UTC.
+func zone(st *store.Store, orgID string) (*time.Location, error) {
+	name := "UTC"
+	if o, ok := st.Org(orgID); ok {
+		name = o.TimeZone
+	}
+	loc, err := time.LoadLocation(name)
+	if err != nil {
+		return nil, fmt.Errorf("time zone %q: %w", name, err)
+	}
+	return loc, nil
+}
+
+// bucketStart is the first day of the bucket that holds day.
+func bucketStart(day time.Time, g Group) time.Time {
+	switch g {
+	case ByWeek:
+		monday := (int(day.Weekday()) + 6) % 7 // Sunday is 6 days after Monday
+		return day.AddDate(0, 0, -monday)
+	case ByMonth:
+		return time.Date(day.Year(), day.Month(), 1, 0, 0, 0, 0, time.UTC)
+	}
+	return day
+}
+
+// nextBucket is the first day of the bucket after the one starting at b.
+func nextBucket(b time.Time, g Group) time.Time {
+	switch g {
+	case ByWeek:
+		return b.AddDate(0, 0, 7)
+	case ByMonth:
+		return b.AddDate(0, 1, 0)
+	}
+	return b.AddDate(0, 0, 1)
+}
