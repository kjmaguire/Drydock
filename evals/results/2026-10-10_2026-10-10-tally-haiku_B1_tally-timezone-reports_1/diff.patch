+	want := []Bucket{
+		{Start: "2026-03-07", Amounts: map[money.Currency]int64{money.USD: 100}, Payments: 1},
+		{Start: "2026-03-08", Amounts: map[money.Currency]int64{money.USD: 500}, Payments: 2},
+		{Start: "2026-03-09", Amounts: map[money.Currency]int64{money.USD: 400}, Payments: 1},
+	}
+	if r.TimeZone != "America/New_York" || r.Group != ByDay || len(r.Buckets) != len(want) {
