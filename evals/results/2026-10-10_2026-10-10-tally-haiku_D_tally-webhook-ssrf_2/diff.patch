+// isPublic reports whether a is a public address. An IPv4-mapped IPv6 address is judged as the IPv4 address it holds. An
+// invalid address is not public.
+func isPublic(a netip.Addr) bool {
+	if !a.IsValid() {
+		return false
+	}
+	a = a.Unmap().WithZone("")
+	for _, p := range notPublic {
+		if p.Contains(a) {
+			return false
+		}
+	}
+	return true
+}
+
+// hostAddrs returns the addresses a URL host stands for: the host itself when it is an IP address, else every address the
+// host resolves to. An address the resolver returns that is not a valid IP is returned invalid, so that it is not public.
+func (s *Service) hostAddrs(ctx context.Context, host string) ([]netip.Addr, error) {
+	if a, err := netip.ParseAddr(host); err == nil {
+		return []netip.Addr{a}, nil
+	}
+	ips, err := s.resolver.LookupIPAddr(ctx, host)
+	if err != nil || len(ips) == 0 {
+		return nil, fmt.Errorf("the host %q does not resolve", host)
+	}
+	out := make([]netip.Addr, 0, len(ips))
+	for _, ip := range ips {
+		a, _ := netip.AddrFromSlice(ip.IP)
+		out = append(out, a)
+	}
+	return out, nil
+}
