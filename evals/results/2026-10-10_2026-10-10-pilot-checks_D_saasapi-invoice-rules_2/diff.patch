+func TestCompute(t *testing.T) {
+	seats := func(qty int, unit int64) []store.LineItem {
+		return []store.LineItem{{Description: "Seats", Quantity: qty, UnitCents: unit}}
+	}
+	tests := []struct {
+		name string
+		inv  store.Invoice
+		want Totals
+	}{
+		{
+			name: "coupon applies to the subtotal before the credit",
+			inv:  store.Invoice{Lines: seats(1, 10000), CouponPercent: 10, CreditCents: 500},
+			// 10% of 10000 is 1000; credit is taken after: 10000 - 1000 - 500.
+			want: Totals{SubtotalCents: 10000, DiscountCents: 1500, TotalCents: 8500},
+		},
+		{
+			name: "coupon amount rounds half up",
+			inv:  store.Invoice{Lines: seats(1, 1005), CouponPercent: 50},
+			// 502.5 cents rounds to 503.
+			want: Totals{SubtotalCents: 1005, DiscountCents: 503, TotalCents: 502},
+		},
+		{
+			name: "tax rounds half up",
+			inv:  store.Invoice{Lines: seats(1, 1010), TaxRateBP: 500},
+			// 50.5 cents of tax rounds to 51.
+			want: Totals{SubtotalCents: 1010, TaxCents: 51, TotalCents: 1061},
+		},
+		{
+			name: "tax below half a cent rounds down",
+			inv:  store.Invoice{Lines: seats(1, 1009), TaxRateBP: 500},
+			// 50.45 cents of tax rounds to 50.
+			want: Totals{SubtotalCents: 1009, TaxCents: 50, TotalCents: 1059},
+		},
+		{
+			name: "credit larger than the remainder leaves zero",
+			inv:  store.Invoice{Lines: seats(1, 1000), CouponPercent: 50, CreditCents: 800, TaxRateBP: 825},
+			// 1000 - 500 - 800 is negative, so the amount after discounts is 0 and so is the tax.
+			want: Totals{SubtotalCents: 1000, DiscountCents: 1000, TaxCents: 0, TotalCents: 0},
+		},
+		{
+			name: "coupon, credit and tax together over several lines",
+			inv: store.Invoice{
+				Lines: []store.LineItem{
+					{Description: "Seats", Quantity: 2, UnitCents: 1000},
+					{Description: "Storage", Quantity: 1, UnitCents: 500},
+				},
+				CouponPercent: 20,
+				CreditCents:   300,
+				TaxRateBP:     825,
+			},
+			// Subtotal 2500; coupon 500; after credit 1700; tax 1700 * 8.25% = 140.25 rounds to 140.
+			want: Totals{SubtotalCents: 2500, DiscountCents: 800, TaxCents: 140, TotalCents: 1840},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := Compute(tt.inv)
+			if got != tt.want {
+				t.Fatalf("got %+v, want %+v", got, tt.want)
+			}
+		})
+	}
+}
