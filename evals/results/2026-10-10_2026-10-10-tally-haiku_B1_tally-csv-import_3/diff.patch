diff --git a/start/internal/store/customers.go b/result/internal/store/customers.go
index 73ff6bc..ec7f3c8 100644
--- a/start/internal/store/customers.go
+++ b/result/internal/store/customers.go
@@ -1,11 +1,107 @@
 package store
 
 import (
+	"fmt"
 	"sort"
 	"strings"
 	"time"
 )
 
+// NewCustomer is a customer of a batch for CheckCustomers and CreateCustomers.
+type NewCustomer struct {
+	Name                 string
+	Email                string
+	DefaultPaymentMethod string
+	Metadata             map[string]string
+}
+
+// CustomerProblem says why the customer at Index in a batch cannot be created. Code is the first of these that applies:
+// "missing_name", "invalid_email", "invalid_payment_method", "email_taken" (a customer of the organization has the address)
+// or "duplicate_email" (an earlier customer of the batch has it, ignoring case).
+type CustomerProblem struct {
+	Index int
+	Code  string
+}
+
+// CustomerProblemsError is returned by CreateCustomers when a batch has problems. Nothing was created.
+type CustomerProblemsError struct {
+	Problems []CustomerProblem
+}
+
+func (e *CustomerProblemsError) Error() string {
+	return fmt.Sprintf("%d customers cannot be created", len(e.Problems))
+}
+
+// CheckCustomers reports the problems CreateCustomers would find in a batch, in order, without creating anything.
+func (s *Store) CheckCustomers(orgID string, batch []NewCustomer) []CustomerProblem {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.checkCustomers(orgID, batch)
+}
+
+// CreateCustomers adds a batch of customers to an organization, in order, or none of them: when any customer has a problem
+// (see CustomerProblem) it returns a *CustomerProblemsError and creates nothing.
+func (s *Store) CreateCustomers(orgID string, batch []NewCustomer, now time.Time) ([]Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return nil, ErrNotFound
+	}
+	if problems := s.checkCustomers(orgID, batch); len(problems) > 0 {
+		return nil, &CustomerProblemsError{Problems: problems}
+	}
+	out := make([]Customer, 0, len(batch))
+	for _, nc := range batch {
+		nc = trimNewCustomer(nc)
+		c := copyCustomer(Customer{ID: s.newID("cus"), OrgID: orgID, Name: nc.Name, Email: nc.Email,
+			DefaultPaymentMethod: nc.DefaultPaymentMethod, Metadata: nc.Metadata, CreatedAt: now.UTC()})
+		s.customers[c.ID] = c
+		s.customersByEmail[normEmail(c.Email)] = c.ID
+		out = append(out, copyCustomer(c))
+	}
+	return out, nil
+}
+
+// hasCustomerEmail reports whether one of the organization's customers has this (lower-case) email address. The caller
+// holds the lock.
+func (s *Store) hasCustomerEmail(orgID, key string) bool {
+	id, ok := s.customersByEmail[key]
+	return ok && s.customers[id].OrgID == orgID
+}
+
+// checkCustomers finds the problems in a batch. The caller holds the lock.
+func (s *Store) checkCustomers(orgID string, batch []NewCustomer) []CustomerProblem {
+	var problems []CustomerProblem
+	earlier := map[string]bool{} // lower-case email addresses of the batch's earlier customers
+	for i, nc := range batch {
+		nc = trimNewCustomer(nc)
+		key := normEmail(nc.Email)
+		code := ""
+		switch {
+		case nc.Name == "":
+			code = "missing_name"
+		case !validEmail(nc.Email):
+			code = "invalid_email"
+		case nc.DefaultPaymentMethod != "" && !strings.HasPrefix(nc.DefaultPaymentMethod, "pm_"):
+			code = "invalid_payment_method"
+		case s.hasCustomerEmail(orgID, key):
+			code = "email_taken"
+		case earlier[key]:
