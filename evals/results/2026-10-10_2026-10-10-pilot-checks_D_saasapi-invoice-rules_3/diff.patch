+func TestCompute(t *testing.T) {
+	seats := []store.LineItem{{Description: "Seats", Quantity: 3, UnitCents: 335}} // subtotal 1005
+	tests := []struct {
+		name string
+		inv  store.Invoice
+		want Totals
+	}{
+		{
+			name: "coupon rounds half up to a cent",
+			inv:  store.Invoice{Lines: seats, CouponPercent: 10},
+			// coupon 100.5 -> 101; after discounts 904
+			want: Totals{SubtotalCents: 1005, DiscountCents: 101, TotalCents: 904},
+		},
+		{
+			name: "coupon is applied before the credit",
+			inv:  store.Invoice{Lines: seats, CouponPercent: 10, CreditCents: 200},
+			// coupon 101; after coupon 904; credit 200 -> 704
+			want: Totals{SubtotalCents: 1005, DiscountCents: 301, TotalCents: 704},
+		},
+		{
+			name: "tax rounds half up on the amount after discounts",
+			inv:  store.Invoice{Lines: seats, CouponPercent: 10, CreditCents: 200, TaxRateBP: 825},
+			// 704 * 825 / 10000 = 58.08 -> 58; total 762
+			want: Totals{SubtotalCents: 1005, DiscountCents: 301, TaxCents: 58, TotalCents: 762},
+		},
+		{
+			name: "half cent tax goes up",
+			inv:  store.Invoice{Lines: []store.LineItem{{Quantity: 1, UnitCents: 10}}, TaxRateBP: 500},
+			// 10 * 500 / 10000 = 0.5 -> 1
+			want: Totals{SubtotalCents: 10, TaxCents: 1, TotalCents: 11},
+		},
+		{
+			name: "credit larger than the amount due leaves zero",
+			inv:  store.Invoice{Lines: seats, CreditCents: 5000, TaxRateBP: 825},
+			// after discounts clamps to 0, so no tax and the whole subtotal is discount
+			want: Totals{SubtotalCents: 1005, DiscountCents: 1005},
+		},
+		{
+			name: "full coupon leaves zero",
+			inv:  store.Invoice{Lines: seats, CouponPercent: 100, CreditCents: 50, TaxRateBP: 825},
+			want: Totals{SubtotalCents: 1005, DiscountCents: 1005},
+		},
+		{
+			name: "no lines",
+			inv:  store.Invoice{CouponPercent: 10, CreditCents: 50, TaxRateBP: 825},
+			want: Totals{},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := Compute(tc.inv); got != tc.want {
+				t.Fatalf("got %+v, want %+v", got, tc.want)
+			}
+		})
+	}
+}
