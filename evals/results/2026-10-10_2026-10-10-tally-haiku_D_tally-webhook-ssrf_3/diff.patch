+// checkDeliveryHost fails unless the host of an endpoint's URL resolves to public addresses only. It runs before every
+// delivery, because DNS answers can change after the endpoint was saved.
+func (s *Service) checkDeliveryHost(ctx context.Context, raw string) error {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return fmt.Errorf("the endpoint's URL does not parse: %w", err)
+	}
+	addrs, err := s.hostAddrs(ctx, u.Hostname())
+	if err != nil {
+		return fmt.Errorf("the endpoint's host does not resolve: %w", err)
+	}
+	if len(addrs) == 0 {
+		return errors.New("the endpoint's host does not resolve")
+	}
+	if slices.ContainsFunc(addrs, func(a netip.Addr) bool { return !isPublic(a) }) {
