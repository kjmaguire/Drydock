+func TestDeliveryRefusesNonPublicAddress(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, err := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/all", Events: []string{"*"}, Secret: "whsec_a", Enabled: true}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The host resolved to a public address when the endpoint was saved; it now points at a private one.
+	e.DNS.Set("hooks.acme.example", "10.0.0.9")
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v", n, err)
+	}
+	if reqs := e.HTTP.Requests(); len(reqs) != 0 {
+		t.Fatalf("a request was sent to a private address: %+v", reqs)
+	}
+	ds := e.Store.Deliveries(e.Acme.ID, ep.ID)
+	if len(ds) != 1 || ds[0].Status != store.DeliveryFailed || !strings.Contains(ds[0].Error, "not public") {
+		t.Fatalf("deliveries = %+v", ds)
+	}
+	if got, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID); got.URL != ep.URL || !got.Enabled {
+		t.Fatalf("endpoint changed: %+v", got)
+	}
+}
