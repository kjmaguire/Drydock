+// isPublic reports whether a is a public address. An IPv4 address written as IPv6 (::ffff:127.0.0.1) is judged as the IPv4
+// address it holds, and a zone (fe80::1%eth0) is ignored. The zero Addr, which is no address at all, is not public.
+func isPublic(a netip.Addr) bool {
+	if !a.IsValid() {
+		return false
+	}
+	a = a.Unmap().WithZone("")
+	return !slices.ContainsFunc(nonPublic, func(p netip.Prefix) bool { return p.Contains(a) })
+}
+
+// hostAddrs returns the addresses a host stands for: the host itself when it is an IP address, else every address the
+// Resolver finds for it. An address the Resolver returns that is not a valid IP comes back as the zero Addr, which is not
+// public.
+func (s *Service) hostAddrs(ctx context.Context, host string) ([]netip.Addr, error) {
+	if a, err := netip.ParseAddr(host); err == nil {
+		return []netip.Addr{a}, nil
+	}
+	ips, err := s.resolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	addrs := make([]netip.Addr, 0, len(ips))
+	for _, ip := range ips {
+		a, _ := netip.AddrFromSlice(ip.IP)
+		addrs = append(addrs, a)
+	}
+	return addrs, nil
+}
