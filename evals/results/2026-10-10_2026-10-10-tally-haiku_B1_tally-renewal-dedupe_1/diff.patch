+package subscriptions_test
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/payments"
+	"example.com/tally/internal/store"
+	"example.com/tally/internal/subscriptions"
+)
+
+// newSub starts a licensed subscription ($20.00 a seat, quantity 1) for a new customer whose first period is paid with a
+// card that works. Renewals are charged to pm, which the customer has from now on.
+func newSub(t *testing.T, e *apitest.Env, email, pm string) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", email)
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	setPaymentMethod(t, e, c.ID, pm)
+	return sub
+}
+
+func setPaymentMethod(t *testing.T, e *apitest.Env, customerID, pm string) {
+	t.Helper()
+	if _, err := e.Store.UpdateCustomer(e.Acme.ID, customerID, func(c *store.Customer) error { c.DefaultPaymentMethod = pm; return nil }); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// renewalInvoices returns the subscription's invoices after the first one.
+func renewalInvoices(e *apitest.Env, subID string) []store.Invoice {
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: subID})
+	if len(invs) == 0 {
+		return nil
+	}
+	return invs[1:]
+}
+
+func TestConcurrentRenewDueChargesEachPeriodOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := newSub(t, e, "jane@example.com", "pm_card_visa")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+
+	const callers = 16
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	var mu sync.Mutex
+	total := 0
+	errs := make(chan error, callers)
+	for i := 0; i < callers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			n, err := e.Subs.RenewDue(ctx)
+			mu.Lock()
+			total += n
+			mu.Unlock()
+			if err != nil {
+				errs <- err
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		t.Fatalf("RenewDue: %v", err)
+	}
+
+	if total != 1 {
+		t.Fatalf("renewed %d times in total, want 1", total)
+	}
+	if invs := renewalInvoices(e, sub.ID); len(invs) != 1 || invs[0].Status != store.InvoicePaid || invs[0].Lines[0].Quantity != 1 {
+		t.Fatalf("renewal invoices = %+v, want one paid invoice", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 {
+		t.Fatalf("charges = %d, want 2 (the first period and one renewal)", len(cs))
+	}
+}
+
+func TestRenewDueAnotherCallDuringACharge(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := newSub(t, e, "jane@example.com", "pm_card_visa")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+
+	// Hold the renewal's charge while a second RenewDue runs, as a second server instance would.
+	charging, release := make(chan struct{}), make(chan struct{})
+	var held atomic.Bool
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		if held.CompareAndSwap(false, true) {
+			close(charging)
+			<-release
+		}
+	}
+	type result struct {
+		n   int
+		err error
+	}
+	done := make(chan result, 1)
+	go func() {
+		n, err := e.Subs.RenewDue(ctx)
+		done <- result{n, err}
+	}()
+	<-charging
+	if n, err := e.Subs.RenewDue(ctx); n != 0 || err != nil {
+		t.Fatalf("second RenewDue during a charge = %d, %v; want 0, nil", n, err)
+	}
+	close(release)
+	r := <-done
+	if r.n != 1 || r.err != nil {
+		t.Fatalf("first RenewDue = %d, %v; want 1, nil", r.n, r.err)
+	}
+	if invs := renewalInvoices(e, sub.ID); len(invs) != 1 {
+		t.Fatalf("renewal invoices = %d, want 1", len(invs))
+	}
+	if n := len(e.Gateway.Calls()); n != 2 {
+		t.Fatalf("gateway calls = %d, want 2", n)
+	}
+}
+
+func TestGatewayDownMovesThePeriodAndLeavesTheInvoiceOpen(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := newSub(t, e, "jane@example.com", "pm_gateway_down")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	now := e.Clock.Now()
+
+	n, err := e.Subs.RenewDue(ctx)
+	if !errors.Is(err, payments.ErrUnavailable) || n != 1 {
+		t.Fatalf("RenewDue = %d, %v; want 1 and ErrUnavailable", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(now) || !got.CurrentPeriodEnd.Equal(now.AddDate(0, 1, 0)) {
+		t.Fatalf("subscription = %+v, want active in the next period", got)
+	}
+	invs := renewalInvoices(e, sub.ID)
+	if len(invs) != 1 || invs[0].Status != store.InvoiceOpen || !invs[0].PeriodStart.Equal(now) {
+		t.Fatalf("renewal invoices = %+v, want one open invoice for the new period", invs)
+	}
+
+	// The next run does not invoice or charge the period again.
+	if n, err := e.Subs.RenewDue(ctx); n != 0 || err != nil {
+		t.Fatalf("second RenewDue = %d, %v; want 0, nil", n, err)
+	}
+	if n := len(renewalInvoices(e, sub.ID)); n != 1 {
+		t.Fatalf("renewal invoices = %d after a second run, want 1", n)
+	}
+	if n := len(e.Gateway.Calls()); n != 2 {
+		t.Fatalf("gateway calls = %d, want 2 (the first period and one attempt)", n)
+	}
+
+	// The open invoice can be paid later, once the gateway is back.
+	if inv, _, err := e.Payments.Pay(ctx, e.Acme.ID, invs[0].ID, "pm_card_visa"); err != nil || inv.Status != store.InvoicePaid {
+		t.Fatalf("paying later = %+v, %v", inv, err)
+	}
+}
+
+func TestGatewayDownKeepsATrialingStatus(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Team", Currency: "USD", UnitAmount: 2000, Interval: store.Monthly, TrialDays: 14}, e.Clock.Now())
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil || sub.Status != store.Trialing {
+		t.Fatalf("subscription = %+v, %v", sub, err)
+	}
+	setPaymentMethod(t, e, c.ID, "pm_gateway_down")
+	e.Clock.Set(*sub.TrialEnd)
+
+	if n, err := e.Subs.RenewDue(ctx); n != 1 || !errors.Is(err, payments.ErrUnavailable) {
+		t.Fatalf("RenewDue = %d, %v; want 1 and ErrUnavailable", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Trialing || !got.CurrentPeriodStart.Equal(*sub.TrialEnd) {
+		t.Fatalf("subscription = %+v, want still trialing in the next period", got)
+	}
+}
+
+func TestDeclinedRenewalIsPastDueAndNotRetried(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := newSub(t, e, "jane@example.com", "pm_card_declined")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+
+	if n, err := e.Subs.RenewDue(ctx); n != 1 || err != nil {
+		t.Fatalf("RenewDue = %d, %v; want 1, nil", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.PastDue {
+		t.Fatalf("status = %s, want past_due", got.Status)
+	}
+	if invs := renewalInvoices(e, sub.ID); len(invs) != 1 || invs[0].Status != store.InvoiceOpen {
+		t.Fatalf("renewal invoices = %+v, want one open invoice", invs)
+	}
+	if n, err := e.Subs.RenewDue(ctx); n != 0 || err != nil {
+		t.Fatalf("second RenewDue = %d, %v; want 0, nil", n, err)
+	}
+	if n := len(e.Gateway.Calls()); n != 2 {
+		t.Fatalf("gateway calls = %d, want 2", n)
+	}
+}
+
+func TestAFailedRenewalDoesNotStopTheOthers(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	// The first subscription sorts first (same period end, lower ID) and its renewal fails.
+	failing := newSub(t, e, "jane@example.com", "pm_gateway_down")
+	working := newSub(t, e, "john@example.com", "pm_card_visa")
+	e.Clock.Set(working.CurrentPeriodEnd)
+
+	n, err := e.Subs.RenewDue(ctx)
+	if !errors.Is(err, payments.ErrUnavailable) {
+		t.Fatalf("RenewDue error = %v, want ErrUnavailable", err)
+	}
+	if n != 2 {
+		t.Fatalf("RenewDue = %d, want 2 (both periods moved)", n)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, working.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(e.Clock.Now()) {
+		t.Fatalf("working subscription = %+v", got)
+	}
+	if invs := renewalInvoices(e, working.ID); len(invs) != 1 || invs[0].Status != store.InvoicePaid {
+		t.Fatalf("working renewal invoices = %+v, want one paid", invs)
+	}
+	if invs := renewalInvoices(e, failing.ID); len(invs) != 1 || invs[0].Status != store.InvoiceOpen {
+		t.Fatalf("failing renewal invoices = %+v, want one open", invs)
+	}
+}
