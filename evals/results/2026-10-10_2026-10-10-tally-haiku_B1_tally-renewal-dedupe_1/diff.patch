+// RenewSubscription moves a subscription from the period [from, to) it is in to the period [start, end). When inv is not nil
+// it is stored as an open invoice in the same step; inv's PeriodStart identifies the period it bills. The step is refused
+// with ErrNotDue, and changes nothing, when the subscription is no longer in [from, to), is canceled, or already has an
+// invoice for inv's period. So when several renewals of one period race, exactly one of them gets through.
+func (s *Store) RenewSubscription(orgID, subID string, from, to, start, end time.Time, inv *Invoice, now time.Time) (Subscription, *Invoice, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	old, ok := s.subs[subID]
+	if !ok || old.OrgID != orgID {
+		return Subscription{}, nil, ErrNotFound
+	}
+	if old.Status == Canceled || !old.CurrentPeriodStart.Equal(from) || !old.CurrentPeriodEnd.Equal(to) {
+		return Subscription{}, nil, ErrNotDue
+	}
+	var created *Invoice
+	if inv != nil {
+		if inv.PeriodStart == nil {
+			return Subscription{}, nil, invalid("an invoice of a period needs the period's start")
+		}
+		if err := checkInvoice(*inv); err != nil {
+			return Subscription{}, nil, err
+		}
+		for _, x := range s.invoices {
+			if x.SubscriptionID == subID && x.PeriodStart != nil && x.PeriodStart.Equal(*inv.PeriodStart) {
+				return Subscription{}, nil, ErrNotDue
+			}
+		}
+		c, err := s.createInvoiceLocked(*inv, now)
+		if err != nil {
+			return Subscription{}, nil, err
+		}
+		created = &c
+	}
+	sub := copySub(old)
+	sub.CurrentPeriodStart, sub.CurrentPeriodEnd = start, end
+	s.subs[subID] = sub
+	return copySub(sub), created, nil
+}
