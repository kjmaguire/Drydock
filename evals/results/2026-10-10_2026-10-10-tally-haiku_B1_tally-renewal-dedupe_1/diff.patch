+package store
+
+import (
+	"errors"
+	"testing"
+
+	"example.com/tally/internal/money"
+)
+
+func TestRenewSubscriptionMovesThePeriodAndStoresTheInvoiceOnce(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(o.ID, "Jane", "jane@example.com", t0)
+	p, _ := s.CreatePlan(Plan{OrgID: o.ID, Name: "Pro", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, t0)
+	end0 := t0.AddDate(0, 1, 0)
+	sub, err := s.CreateSubscription(Subscription{OrgID: o.ID, CustomerID: c.ID, PlanID: p.ID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: end0}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	next, nextEnd := end0, end0.AddDate(0, 1, 0)
+	draft := func() *Invoice {
+		return &Invoice{OrgID: o.ID, CustomerID: c.ID, SubscriptionID: sub.ID, Currency: money.USD,
+			Lines: []Line{{Description: "Pro", Quantity: 1, UnitAmount: 2000}}, PeriodStart: &next, PeriodEnd: &nextEnd}
+	}
+
+	got, inv, err := s.RenewSubscription(o.ID, sub.ID, t0, end0, next, nextEnd, draft(), next)
+	if err != nil || inv == nil || inv.Status != InvoiceOpen || !got.CurrentPeriodStart.Equal(next) || !got.CurrentPeriodEnd.Equal(nextEnd) {
+		t.Fatalf("RenewSubscription = %+v, %+v, %v", got, inv, err)
+	}
+
+	// The same period again, as a second caller holding the old state would ask: refused, nothing changes.
+	if _, _, err := s.RenewSubscription(o.ID, sub.ID, t0, end0, next, nextEnd, draft(), next); !errors.Is(err, ErrNotDue) {
+		t.Fatalf("second renewal of the same period: %v", err)
+	}
+	if n := len(s.ListInvoices(o.ID, InvoiceFilter{SubscriptionID: sub.ID})); n != 1 {
+		t.Fatalf("invoices = %d, want 1", n)
+	}
+
+	// A period that already has an invoice is refused even when the subscription is still in the period it renews.
+	if _, _, err := s.RenewSubscription(o.ID, sub.ID, next, nextEnd, nextEnd, nextEnd.AddDate(0, 1, 0), draft(), next); !errors.Is(err, ErrNotDue) {
+		t.Fatalf("renewal of an invoiced period: %v", err)
+	}
+	if after, _ := s.Subscription(o.ID, sub.ID); !after.CurrentPeriodStart.Equal(next) || !after.CurrentPeriodEnd.Equal(nextEnd) {
+		t.Fatalf("period changed by a refused renewal: %+v", after)
+	}
+
+	// A canceled subscription is not renewed.
+	if _, err := s.UpdateSubscription(o.ID, sub.ID, func(x *Subscription) error { x.Status = Canceled; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := s.RenewSubscription(o.ID, sub.ID, next, nextEnd, nextEnd, nextEnd.AddDate(0, 1, 0), nil, next); !errors.Is(err, ErrNotDue) {
+		t.Fatalf("renewal of a canceled subscription: %v", err)
+	}
+}
+
+func TestRenewSubscriptionRefusedInvoiceChangesNothing(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(o.ID, "Jane", "jane@example.com", t0)
+	p, _ := s.CreatePlan(Plan{OrgID: o.ID, Name: "Pro", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, t0)
+	end0 := t0.AddDate(0, 1, 0)
+	sub, _ := s.CreateSubscription(Subscription{OrgID: o.ID, CustomerID: c.ID, PlanID: p.ID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: end0}, t0)
+	next, nextEnd := end0, end0.AddDate(0, 1, 0)
+	bad := &Invoice{OrgID: o.ID, CustomerID: c.ID, SubscriptionID: sub.ID, Currency: money.USD,
+		Lines: []Line{{Description: "Pro", Quantity: 0, UnitAmount: 2000}}, PeriodStart: &next, PeriodEnd: &nextEnd}
+	if _, _, err := s.RenewSubscription(o.ID, sub.ID, t0, end0, next, nextEnd, bad, next); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("invalid invoice: %v", err)
+	}
+	if after, _ := s.Subscription(o.ID, sub.ID); !after.CurrentPeriodStart.Equal(t0) || !after.CurrentPeriodEnd.Equal(end0) {
+		t.Fatalf("period moved although the invoice was refused: %+v", after)
+	}
+	if n := len(s.ListInvoices(o.ID, InvoiceFilter{SubscriptionID: sub.ID})); n != 0 {
+		t.Fatalf("invoices = %d, want 0", n)
+	}
+}
