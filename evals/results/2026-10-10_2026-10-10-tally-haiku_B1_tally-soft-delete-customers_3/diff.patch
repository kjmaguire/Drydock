+func TestDeletedCustomersSurviveSnapshot(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	if err := s.SoftDeleteCustomer(a.ID, c.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s2.CustomerIncludingDeleted(a.ID, c.ID); !ok || got.DeletedAt == nil {
+		t.Fatalf("the deletion was lost: %+v, %v", got, ok)
+	}
+	if _, err := s2.CreateCustomer(a.ID, "Jane 2", "jane@example.com", t0); err != nil {
+		t.Fatalf("email of a deleted customer is taken after FromState: %v", err)
+	}
+	if _, err := s2.RestoreCustomer(a.ID, c.ID, t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("restore after FromState: %v", err)
+	}
+}
