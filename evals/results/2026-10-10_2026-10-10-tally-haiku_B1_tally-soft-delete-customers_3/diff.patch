+func TestSoftDeleteCustomer(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	jane, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	bJane, _ := s.CreateCustomer(b.ID, "Jane B", "jane@example.com", t0)
+	p, _ := s.CreatePlan(Plan{OrgID: a.ID, Name: "Pro", Currency: money.USD, UnitAmount: 100, Interval: Monthly}, t0)
+	sub, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: jane.ID, PlanID: p.ID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inv, _ := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: jane.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, t0); !errors.Is(err, ErrHasActiveSubscriptions) {
+		t.Fatalf("delete with an active subscription: %v", err)
+	}
+	if _, err := s.UpdateSubscription(a.ID, sub.ID, func(x *Subscription) error { x.Status = Canceled; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	later := t0.Add(time.Hour)
+	if err := s.SoftDeleteCustomer(b.ID, jane.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("another org deletes the customer: %v", err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, later); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleting twice: %v", err)
+	}
+
+	if _, ok := s.Customer(a.ID, jane.ID); ok {
+		t.Fatal("deleted customer is still found")
+	}
+	if got, ok := s.CustomerIncludingDeleted(a.ID, jane.ID); !ok || got.DeletedAt == nil || !got.DeletedAt.Equal(later) {
+		t.Fatalf("CustomerIncludingDeleted = %+v, %v", got, ok)
+	}
+	if got := s.Customers(a.ID); len(got) != 0 {
+		t.Fatalf("Customers = %+v", got)
+	}
+	if got := s.CustomersIncludingDeleted(a.ID); len(got) != 1 || got[0].ID != jane.ID {
+		t.Fatalf("CustomersIncludingDeleted = %+v", got)
+	}
+	if got := s.SearchCustomers(a.ID, "jane"); len(got) != 0 {
+		t.Fatalf("SearchCustomers = %+v", got)
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "JANE@example.com"); ok {
+		t.Fatal("FindCustomerByEmail finds the deleted customer")
+	}
+	if _, err := s.UpdateCustomer(a.ID, jane.ID, func(c *Customer) error { c.Name = "Changed"; return nil }); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("update of a deleted customer: %v", err)
+	}
+	if _, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: jane.ID, PlanID: p.ID, Quantity: 1, Status: Active}, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for a deleted customer: %v", err)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: jane.ID, Currency: money.USD, Lines: []Line{{Description: "y", Quantity: 1, UnitAmount: 1}}}, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for a deleted customer: %v", err)
+	}
+	if got, ok := s.Invoice(a.ID, inv.ID); !ok || got.CustomerID != jane.ID {
+		t.Fatal("the deleted customer's invoice is gone")
+	}
+
+	// The email address is free again, and another organization's customer with it is untouched.
+	again, err := s.CreateCustomer(a.ID, "Jane 2", "Jane@example.com", later)
+	if err != nil {
+		t.Fatalf("reusing a deleted customer's email: %v", err)
+	}
+	if got, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); !ok || got.ID != bJane.ID {
+		t.Fatalf("FindCustomerByEmail in another org = %+v, %v", got, ok)
+	}
+	if _, err := s.RestoreCustomer(a.ID, jane.ID, later); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("restore while the email is in use: %v", err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, again.ID, later); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := s.RestoreCustomer(a.ID, jane.ID, later.Add(time.Hour))
+	if err != nil || restored.ID != jane.ID || restored.DeletedAt != nil {
+		t.Fatalf("RestoreCustomer = %+v, %v", restored, err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != jane.ID {
+		t.Fatalf("after restore FindCustomerByEmail = %+v, %v", got, ok)
+	}
+}
