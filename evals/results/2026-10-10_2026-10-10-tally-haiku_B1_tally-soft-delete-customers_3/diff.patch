+func TestRestoreWindowAndPurge(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	kept, _ := s.CreateCustomer(a.ID, "Kept", "kept@example.com", t0)
+	lost, _ := s.CreateCustomer(a.ID, "Lost", "lost@example.com", t0)
+	stale, _ := s.CreateCustomer(a.ID, "Stale", "stale@example.com", t0)
+	if err := s.SoftDeleteCustomer(a.ID, kept.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, stale.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, lost.ID, t0.Add(time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+
+	// Exactly 30 days after its deletion a customer can still be restored, so nothing is purged yet.
+	edge := t0.Add(CustomerRestoreWindow)
+	if n := s.PurgeDeletedCustomers(edge); n != 0 {
+		t.Fatalf("purged %d at the edge of the window", n)
+	}
+	// A second later, the customers deleted at t0 are past the window and the one deleted an hour later is not.
+	later := edge.Add(time.Second)
+	if _, err := s.RestoreCustomer(a.ID, stale.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore past the window: %v", err)
+	}
+	if n := s.PurgeDeletedCustomers(later); n != 2 {
+		t.Fatalf("PurgeDeletedCustomers = %d, want 2", n)
+	}
+	if _, ok := s.CustomerIncludingDeleted(a.ID, kept.ID); ok {
+		t.Fatal("a purged customer is still there")
+	}
+	if _, err := s.RestoreCustomer(a.ID, kept.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore after purge: %v", err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, lost.ID, later); err != nil {
+		t.Fatalf("restore within the window: %v", err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, lost.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore of a customer that is not deleted: %v", err)
+	}
+}
