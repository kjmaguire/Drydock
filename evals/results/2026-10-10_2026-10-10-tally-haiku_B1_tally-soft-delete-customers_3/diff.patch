+// SoftDeleteCustomer marks a customer deleted at now. Its invoices and payments are kept, and its email address is free
+// again. It cannot be deleted while it has a subscription that is not canceled (ErrHasActiveSubscriptions). Deleting a
+// customer that is already deleted is ErrNotFound.
+func (s *Store) SoftDeleteCustomer(orgID, id string, now time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt != nil {
+		return ErrNotFound
+	}
+	for _, sub := range s.subs {
+		if sub.CustomerID == id && sub.Status != Canceled {
+			return ErrHasActiveSubscriptions
+		}
 	}
+	t := now.UTC()
+	c.DeletedAt = &t
+	s.customers[id] = c
+	s.unindexEmail(c)
 	return nil
 }
 
+// RestoreCustomer undoes SoftDeleteCustomer within CustomerRestoreWindow. It is ErrNotFound for a customer that is not
+// deleted or whose window has passed, and ErrEmailTaken when another customer now uses its email address.
+func (s *Store) RestoreCustomer(orgID, id string, now time.Time) (Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt == nil || c.DeletedAt.Before(now.Add(-CustomerRestoreWindow)) {
+		return Customer{}, ErrNotFound
+	}
+	key := customerEmailKey(orgID, c.Email)
+	if _, ok := s.customersByEmail[key]; ok {
+		return Customer{}, ErrEmailTaken
+	}
+	c.DeletedAt = nil
+	s.customers[id] = c
+	s.customersByEmail[key] = id
+	return copyCustomer(c), nil
+}
+
+// PurgeDeletedCustomers removes the customers deleted more than CustomerRestoreWindow before now, and returns how many it
+// removed. Their invoices and payments stay, with no customer.
+func (s *Store) PurgeDeletedCustomers(now time.Time) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	cutoff := now.Add(-CustomerRestoreWindow)
+	n := 0
+	for id, c := range s.customers {
+		if c.DeletedAt != nil && c.DeletedAt.Before(cutoff) {
+			delete(s.customers, id)
+			n++
+		}
+	}
+	return n
+}
