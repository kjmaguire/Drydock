+// failForGood marks a delivery failed without sending it again.
+func (s *Service) failForGood(id, reason string) {
+	_, _ = s.store.UpdateDelivery(id, func(d *store.Delivery) error {
+		d.Status = store.DeliveryFailed
+		d.NextAttemptAt = nil
+		d.Error = reason
+		return nil
+	})
+}
+
+// failPending fails every pending delivery of an endpoint.
+func (s *Service) failPending(orgID, endpointID string) {
+	for _, d := range s.store.Deliveries(orgID, endpointID) {
+		if d.Status == store.DeliveryPending {
+			s.failForGood(d.ID, "the endpoint is disabled or was deleted")
+		}
+	}
