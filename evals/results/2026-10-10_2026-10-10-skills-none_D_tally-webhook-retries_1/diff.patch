+// notifyOwners emails every owner of the endpoint's organization that the endpoint keeps failing. It emails at most once per
+// endpoint in 24 hours.
+func (s *Service) notifyOwners(ctx context.Context, ep store.WebhookEndpoint, lastErr string) error {
+	now := s.clock.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if last, ok := s.lastMail[ep.ID]; ok && now.Sub(last) < 24*time.Hour {
+		return nil
+	}
+	s.lastMail[ep.ID] = now
+	var errs error
+	for _, m := range s.store.Members(ep.OrgID) {
+		if m.Role != store.RoleOwner {
+			continue
+		}
+		u, ok := s.store.User(m.UserID)
+		if !ok {
+			continue
+		}
+		errs = errors.Join(errs, s.mail.Send(ctx, mail.Message{
+			To:      u.Email,
+			Subject: "Webhook endpoint failing: " + ep.URL,
+			Body: fmt.Sprintf("Tally could not deliver webhook events to %s after %d attempts, and has stopped trying the failed delivery.\n\n"+
+				"The last attempt failed: %s\n\nCheck that the endpoint is up and answers with a 2xx status.\n", ep.URL, maxAttempts, lastErr),
+		}))
+	}
+	return errs
 }
 
