+	}
+	if status == http.StatusGone {
+		// The endpoint is gone: stop sending to it, and fail its other pending deliveries without sending them.
+		_, _ = s.store.UpdateWebhookEndpoint(ep.OrgID, ep.ID, func(ep *store.WebhookEndpoint) error {
+			ep.Enabled = false
+			ep.DisabledReason = "gone"
