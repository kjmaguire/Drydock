+
+	ep, _ := e.Store.WebhookEndpoint(e.Acme.ID, gone.ID)
+	if ep.Enabled || ep.DisabledReason != "gone" {
+		t.Fatalf("endpoint = %+v, want disabled for gone", ep)
+	}
+	ds := e.Store.Deliveries(e.Acme.ID, gone.ID)
+	if len(ds) != 2 || ds[0].Status != store.DeliveryFailed || ds[0].ResponseStatus != http.StatusGone || ds[0].Attempts != 1 ||
+		ds[1].Status != store.DeliveryFailed || ds[1].Attempts != 0 || ds[1].NextAttemptAt != nil {
+		t.Fatalf("gone deliveries = %+v", ds)
+	}
+	for _, d := range e.Store.Deliveries(e.Acme.ID, other.ID) {
+		if d.Status != store.DeliverySucceeded {
+			t.Fatalf("other endpoint's delivery = %+v", d)
+		}
+	}
+	if n := len(e.HTTP.Requests()); n != 3 {
+		t.Fatalf("requests = %d, want 3", n)
+	}
+	e.Clock.Advance(24 * time.Hour)
+	if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+		t.Fatalf("a gone endpoint got %d more deliveries", n)
+	}
+	if msgs := e.Mail.Messages(); len(msgs) != 0 {
+		t.Fatalf("a 410 emailed the owners: %+v", msgs)
+	}
+}
+
+func TestOwnersEmailedOncePerDay(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	second, _ := e.AddMember(e.Acme, "second@acme.example", store.RoleOwner)
+	_, _ = e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/fail", Events: []string{"*"}, Secret: "whsec_f", Enabled: true}, e.Clock.Now())
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusInternalServerError, nil }
+
+	// The first delivery fails for good; the second fails for good an hour later, within 24 hours of that email, so the
+	// owners get one email each in all.
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"})
+	if _, err := e.Webhooks.RunDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Advance(time.Hour)
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.updated", map[string]string{"id": "cus_1"})
+	runUntilSettled(t, e, ep.ID)
+	for _, d := range e.Store.Deliveries(e.Acme.ID, ep.ID) {
+		if d.Status != store.DeliveryFailed || d.Attempts != 7 {
+			t.Fatalf("delivery = %+v, want failed after 7 attempts", d)
+		}
+	}
+	msgs := e.Mail.Messages()
+	if len(msgs) != 2 {
+		t.Fatalf("messages = %+v, want one to each owner", msgs)
+	}
+	to := map[string]bool{}
+	for _, m := range msgs {
+		to[m.To] = true
+		if m.Subject != "Webhook endpoint failing: https://hooks.acme.example/fail" {
+			t.Fatalf("subject = %q", m.Subject)
+		}
+	}
+	if !to[e.Acme.Owner.Email] || !to[second.Email] || to["admin@acme.example"] {
+		t.Fatalf("recipients = %v", to)
+	}
+
+	// A day later another delivery fails for good: the owners are emailed again.
+	e.Clock.Advance(24 * time.Hour)
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.deleted", map[string]string{"id": "cus_1"})
+	runUntilSettled(t, e, ep.ID)
+	if n := len(e.Mail.Messages()); n != 4 {
+		t.Fatalf("messages = %d, want 4 after a day", n)
+	}
 }
