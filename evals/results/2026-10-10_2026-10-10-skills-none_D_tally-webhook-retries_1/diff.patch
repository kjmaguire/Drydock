+// deliver makes one attempt at a due delivery and reports whether it made one. A delivery that can no longer be sent (its
+// endpoint is disabled or deleted, or its event is gone) fails for good without an attempt.
+func (s *Service) deliver(ctx context.Context, due store.Delivery) (bool, error) {
+	d, ok := s.store.Delivery(due.ID)
+	if !ok || d.Status != store.DeliveryPending {
+		// An earlier delivery in this run may have failed it already.
+		return false, nil
+	}
+	ep, epOK := s.store.WebhookEndpoint(d.OrgID, d.EndpointID)
+	e, eOK := s.store.EventByID(d.EventID)
+	if !epOK || !ep.Enabled || !eOK {
+		reason := "the endpoint is disabled or was deleted"
+		if !eOK {
+			reason = "the event no longer exists"
+		}
+		s.failForGood(d.ID, reason)
+		return false, nil
