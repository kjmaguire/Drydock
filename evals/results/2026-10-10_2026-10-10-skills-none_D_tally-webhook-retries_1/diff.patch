+
+// deadlineDoer checks the deadline of each request and fails it.
+type deadlineDoer struct {
+	sawDeadline bool
+}
+
+func (d *deadlineDoer) Do(req *http.Request) (*http.Response, error) {
+	dl, ok := req.Context().Deadline()
+	if ok && time.Until(dl) > 9*time.Second && time.Until(dl) <= 10*time.Second {
+		d.sawDeadline = true
+	}
+	return nil, context.DeadlineExceeded
+}
