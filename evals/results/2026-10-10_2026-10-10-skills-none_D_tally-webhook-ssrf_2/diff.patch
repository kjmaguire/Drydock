+// hostAddrs returns the addresses a host stands for: the address itself when host is an IP address, else every address
+// the Resolver finds for it.
+func (s *Service) hostAddrs(ctx context.Context, host string) ([]netip.Addr, error) {
+	if a, err := netip.ParseAddr(host); err == nil {
+		return []netip.Addr{a}, nil
+	}
+	ips, err := s.resolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	if len(ips) == 0 {
+		return nil, errNoAddrs
+	}
+	out := make([]netip.Addr, 0, len(ips))
+	for _, ip := range ips {
+		a, ok := netip.AddrFromSlice(ip.IP)
+		if !ok {
+			return nil, fmt.Errorf("%w: %v", errNoAddrs, ip.IP)
+		}
+		out = append(out, a)
+	}
+	return out, nil
+}
+
+// notPublic are the ranges that publicAddr refuses on top of the ones net/netip knows: "this network" and carrier-grade NAT,
+// and the broadcast address.
+var notPublic = []netip.Prefix{
+	netip.MustParsePrefix("0.0.0.0/8"),
+	netip.MustParsePrefix("100.64.0.0/10"),
+	netip.MustParsePrefix("255.255.255.255/32"),
+}
+
+// publicAddr reports whether a is a public address: not loopback, private, link-local, multicast or unspecified, and not in
+// notPublic. An IPv4-mapped IPv6 address is judged as the IPv4 address it holds.
+func publicAddr(a netip.Addr) bool {
+	a = a.Unmap()
+	if !a.IsValid() || a.IsLoopback() || a.IsPrivate() || a.IsLinkLocalUnicast() || a.IsMulticast() || a.IsUnspecified() {
+		return false
+	}
+	for _, p := range notPublic {
+		if p.Contains(a) {
+			return false
+		}
+	}
+	return true
+}
