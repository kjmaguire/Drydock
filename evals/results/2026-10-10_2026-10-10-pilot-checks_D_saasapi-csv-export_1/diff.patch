+func TestCustomersCSVIsTheAccountsCustomersAsCSV(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	// Created with a non-UTC time: the export must write it in UTC.
+	local := now.In(time.FixedZone("UTC+2", 2*3600))
+	st.CreateCustomer("acc_acme", `Doe, "Jane"`, "jane@example.com", store.PlanPro, now)
+	st.CreateCustomer("acc_acme", "=2+3", "@ops@example.com", store.PlanFree, local)
+	st.CreateCustomer("acc_acme", "+multi\nline", "-m@example.com", store.PlanFree, now)
+	st.CreateCustomer("acc_globex", "Hank", "hank@globex.test", store.PlanFree, now)
+
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("status %d: %s", r.Code, r.Body)
+	}
+	if got := r.Header().Get("Content-Type"); got != "text/csv; charset=utf-8" {
+		t.Fatalf("Content-Type %q", got)
+	}
+	if got := r.Header().Get("Content-Disposition"); got != `attachment; filename="customers.csv"` {
+		t.Fatalf("Content-Disposition %q", got)
+	}
+	want := "id,name,email,plan,created_at\r\n" +
+		"cus_00001,\"Doe, \"\"Jane\"\"\",jane@example.com,pro,2026-01-02T03:04:05Z\r\n" +
+		"cus_00002,'=2+3,'@ops@example.com,free,2026-01-02T03:04:05Z\r\n" +
+		"cus_00003,\"'+multi\r\nline\",'-m@example.com,free,2026-01-02T03:04:05Z\r\n"
+	if r.Body.String() != want {
+		t.Fatalf("body:\n%q\nwant:\n%q", r.Body.String(), want)
+	}
+}
