+func TestCustomersCSVIsTheAccountsCustomersAsADownload(t *testing.T) {
+	srv, st := newServer(t)
+	cest := time.FixedZone("CEST", 2*60*60)
+	jane, _ := st.CreateCustomer("acc_acme", "Jane Doe", "jane@example.com", store.PlanPro, time.Date(2026, 3, 4, 5, 6, 7, 0, cest))
+	st.CreateCustomer("acc_globex", "Hank", "hank@globex.test", store.PlanFree, time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC))
+	bob, _ := st.CreateCustomer("acc_acme", "Bob", "bob@example.com", store.PlanFree, time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC))
+
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("status %d: %s", r.Code, r.Body)
+	}
+	if ct := r.Header().Get("Content-Type"); ct != "text/csv; charset=utf-8" {
+		t.Fatalf("Content-Type %q", ct)
+	}
+	if cd := r.Header().Get("Content-Disposition"); cd != `attachment; filename="customers.csv"` {
+		t.Fatalf("Content-Disposition %q", cd)
+	}
+	want := "id,name,email,plan,created_at\r\n" +
+		jane.ID + ",Jane Doe,jane@example.com,pro,2026-03-04T03:06:07Z\r\n" +
+		bob.ID + ",Bob,bob@example.com,free,2026-01-01T00:00:00Z\r\n"
+	if got := r.Body.String(); got != want {
+		t.Fatalf("body:\n%q\nwant:\n%q", got, want)
+	}
+}
