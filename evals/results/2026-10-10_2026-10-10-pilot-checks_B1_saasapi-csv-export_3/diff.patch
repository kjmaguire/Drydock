+func TestCustomersCSVGuardsAgainstFormulaInjection(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	cases := []struct{ name, email, wantName, wantEmail string }{
+		{`=HYPERLINK("http://evil.test","x")`, "=evil@example.com", `'=HYPERLINK("http://evil.test","x")`, "'=evil@example.com"},
+		{"+1+1", "+plus@example.com", "'+1+1", "'+plus@example.com"},
+		{"-2+3", "-minus@example.com", "'-2+3", "'-minus@example.com"},
+		{"@SUM(A1)", "at@example.com", "'@SUM(A1)", "at@example.com"},
+		{"Plain = Name", "a=b@example.com", "Plain = Name", "a=b@example.com"},
+	}
+	for _, tc := range cases {
+		if _, err := st.CreateCustomer("acc_acme", tc.name, tc.email, store.PlanFree, now); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	rows := parseCSV(t, do(t, srv, "GET", "/api/customers.csv", "key-acme", "").Body.String())
+	if len(rows) != len(cases)+1 {
+		t.Fatalf("got %d rows", len(rows))
+	}
+	for i, tc := range cases {
+		row := rows[i+1]
+		if row[1] != tc.wantName || row[2] != tc.wantEmail {
+			t.Fatalf("row %q: name %q email %q, want %q and %q", row, row[1], row[2], tc.wantName, tc.wantEmail)
+		}
+	}
+}
