+func parseCSV(t *testing.T, body string) [][]string {
+	t.Helper()
+	rows, err := csv.NewReader(strings.NewReader(body)).ReadAll()
+	if err != nil {
+		t.Fatalf("not valid CSV: %v\n%q", err, body)
+	}
+	return rows
+}
