+func TestCustomersCSVQuotesFieldsAsRFC4180(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	name := "Doe, \"Jane\"\nJr"
+	c, _ := st.CreateCustomer("acc_acme", name, `jane"@example.com`, store.PlanFree, now)
+
+	body := do(t, srv, "GET", "/api/customers.csv", "key-acme", "").Body.String()
+	if strings.Contains(strings.ReplaceAll(body, "\r\n", ""), "\n") {
+		t.Fatalf("a bare LF line ending in %q", body)
+	}
+	if !strings.HasSuffix(body, "\r\n") {
+		t.Fatalf("the body does not end with CRLF: %q", body)
+	}
+	rows := parseCSV(t, body)
+	if len(rows) != 2 || len(rows[1]) != 5 {
+		t.Fatalf("rows %q", rows)
+	}
+	if rows[1][0] != c.ID || rows[1][1] != name || rows[1][2] != `jane"@example.com` {
+		t.Fatalf("the quoted fields did not survive: %q", rows[1])
+	}
+}
