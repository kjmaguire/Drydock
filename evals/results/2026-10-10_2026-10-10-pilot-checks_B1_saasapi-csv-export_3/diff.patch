+func TestCustomersCSVNeverListsAnotherAccountsCustomers(t *testing.T) {
+	srv, st := newServer(t)
+	c, _ := st.CreateCustomer("acc_globex", "Hank", "hank@globex.test", store.PlanFree, time.Now())
+	body := do(t, srv, "GET", "/api/customers.csv", "key-acme", "").Body.String()
+	if rows := parseCSV(t, body); len(rows) != 1 {
+		t.Fatalf("another account's customer is exported: %q", rows)
+	}
+	if strings.Contains(body, c.ID) {
+		t.Fatalf("another account's customer ID is exported: %q", body)
+	}
+}
