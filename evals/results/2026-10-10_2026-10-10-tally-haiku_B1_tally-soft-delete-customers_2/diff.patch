+	if got := s.SearchCustomers(a.ID, "jane"); len(got) != 0 {
+		t.Fatalf("SearchCustomers = %+v", got)
+	}
+	if got := s.CustomersIncludingDeleted(a.ID); len(got) != 2 {
+		t.Fatalf("CustomersIncludingDeleted = %+v", got)
+	}
+	got, ok := s.CustomerIncludingDeleted(a.ID, jane.ID)
