+func TestDeleteAndRestoreCustomer(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane Doe", "jane@example.com")
+	john := e.CreateCustomer(e.Acme, "John Roe", "john@example.com")
+	var inv struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": jane.ID, "currency": "USD", "lines": []map[string]any{{"description": "Pro", "quantity": 1, "unit_amount": 1000}}}, &inv)
+
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil, nil)
+	for _, req := range [][2]string{{"GET", ""}, {"PATCH", ""}, {"DELETE", ""}} {
+		r := e.Do(req[0], "/v1/customers/"+jane.ID, e.Acme.Key, map[string]string{"name": "Jane"})
+		if r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+			t.Fatalf("%s deleted customer: %s", req[0], r)
+		}
+	}
+	var page struct {
+		Items []store.Customer `json:"items"`
+	}
+	for _, path := range []string{"/v1/customers", "/v1/customers?q=jane", "/v1/customers?email=JANE@example.com"} {
+		page.Items = nil
+		e.MustDo(http.StatusOK, "GET", path, e.Acme.Key, nil, &page)
+		for _, c := range page.Items {
+			if c.ID == jane.ID {
+				t.Fatalf("%s lists the deleted customer: %+v", path, page.Items)
+			}
+		}
+	}
+	if r := e.MustDo(http.StatusOK, "GET", "/v1/customers/export.csv", e.Acme.Key, nil, nil); strings.Contains(string(r.Body), jane.ID) {
+		t.Fatalf("export has the deleted customer:\n%s", r.Body)
+	}
+	if r := e.Do("POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": jane.ID, "currency": "USD", "lines": []map[string]any{{"description": "Pro", "quantity": 1, "unit_amount": 1000}}}); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("invoice for a deleted customer: %s", r)
+	}
+	plan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	if r := e.Do("POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": jane.ID, "plan_id": plan.ID}); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("subscription for a deleted customer: %s", r)
+	}
+	var shown struct {
+		Customer map[string]any `json:"customer"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &shown)
+	if shown.Customer["id"] != jane.ID || shown.Customer["deleted"] != true || shown.Customer["email"] != "jane@example.com" {
+		t.Fatalf("invoice of a deleted customer shows %v", shown.Customer)
+	}
+	if r := e.Do("DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("deleted twice: %s", r)
+	}
+
+	// The email address is free again, but a restore needs it to stay free.
+	again := e.CreateCustomer(e.Acme, "Jane 2", "jane@example.com")
+	if r := e.Do("POST", "/v1/customers/"+jane.ID+"/restore", e.Acme.Key, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "email_taken" {
+		t.Fatalf("restore with the email taken: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+again.ID, e.Acme.Key, nil, nil)
+	var restored store.Customer
+	e.MustDo(http.StatusOK, "POST", "/v1/customers/"+jane.ID+"/restore", e.Acme.Key, nil, &restored)
+	if restored.ID != jane.ID || restored.DeletedAt != nil || restored.Name != "Jane Doe" {
+		t.Fatalf("restored = %+v", restored)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers/"+jane.ID, e.Acme.Key, nil, nil)
+	if r := e.Do("POST", "/v1/customers/"+jane.ID+"/restore", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("restore a customer that is not deleted: %s", r)
+	}
+	if r := e.Do("POST", "/v1/customers/"+john.ID+"/restore", e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("restore another org's customer: %s", r)
+	}
+	var events struct {
+		Items []store.Event `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/events?type=customer.restored", e.Acme.Key, nil, &events)
+	if len(events.Items) != 1 {
+		t.Fatalf("restored events = %+v", events.Items)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/events?type=customer.deleted", e.Acme.Key, nil, &events)
+	if len(events.Items) != 2 {
+		t.Fatalf("deleted events = %+v", events.Items)
+	}
+}
