+	if _, err := s.CreateCustomer(a.ID, "Jane Again", "JANE@example.com", t0); err != nil {
+		t.Fatalf("the email of a deleted customer is not free: %v", err)
+	}
+	if _, err := s.CreateCustomer(b.ID, "Jane", "jane@example.com", t0); err != nil {
