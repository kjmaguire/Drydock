+// SoftDeleteCustomer deletes a customer at now. It is hidden from the API and its email address is free again, but it is
+// kept with its invoices and payments: RestoreCustomer undoes the deletion until PurgeDeletedCustomers removes it. A
+// customer with a subscription that is not canceled cannot be deleted (ErrHasActiveSubscriptions).
+func (s *Store) SoftDeleteCustomer(orgID, id string, now time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt != nil {
+		return ErrNotFound
 	}
+	for _, sub := range s.subs {
+		if sub.OrgID == orgID && sub.CustomerID == id && sub.Status != Canceled {
+			return ErrHasActiveSubscriptions
+		}
+	}
+	s.unindexCustomer(c)
+	t := now.UTC()
+	c.DeletedAt = &t
+	s.customers[id] = c
 	return nil
 }
 
+// RestoreCustomer undoes SoftDeleteCustomer, if the customer was deleted no more than 30 days before now. Its email address
+// must not be in use by another customer of the organization (ErrEmailTaken).
+func (s *Store) RestoreCustomer(orgID, id string, now time.Time) (Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt == nil || c.DeletedAt.Before(now.Add(-deletedKeep)) {
+		return Customer{}, ErrNotFound
+	}
+	key := emailKey(orgID, c.Email)
+	if _, ok := s.customersByEmail[key]; ok {
+		return Customer{}, ErrEmailTaken
+	}
+	c.DeletedAt = nil
+	s.customers[id] = c
+	s.customersByEmail[key] = id
+	return copyCustomer(c), nil
