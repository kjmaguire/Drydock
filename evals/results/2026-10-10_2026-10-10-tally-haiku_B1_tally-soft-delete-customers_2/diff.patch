+func TestDeletedCustomerIsPurged(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	var inv struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": jane.ID, "currency": "USD", "lines": []map[string]any{{"description": "Pro", "quantity": 1, "unit_amount": 1000}}}, &inv)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil, nil)
+	e.Clock.Advance(30 * 24 * time.Hour)
+	if n := e.Store.PurgeDeletedCustomers(e.Clock.Now()); n != 0 {
+		t.Fatalf("purged %d customers 30 days after the deletion", n)
+	}
+	e.Clock.Advance(time.Hour)
+	if n := e.Store.PurgeDeletedCustomers(e.Clock.Now()); n != 1 {
+		t.Fatalf("purged %d customers, want 1", n)
+	}
+	if r := e.Do("POST", "/v1/customers/"+jane.ID+"/restore", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("restore a purged customer: %s", r)
+	}
+	var shown struct {
+		Customer *map[string]any `json:"customer"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &shown)
+	if shown.Customer != nil {
+		t.Fatalf("invoice of a purged customer shows %v", *shown.Customer)
+	}
+}
