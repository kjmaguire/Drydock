+func TestPurgeDeletedCustomers(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	old, _ := s.CreateCustomer(a.ID, "Old", "old@example.com", t0)
+	recent, _ := s.CreateCustomer(a.ID, "Recent", "recent@example.com", t0)
+	kept, _ := s.CreateCustomer(a.ID, "Kept", "kept@example.com", t0)
+	inv, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: old.ID, Currency: "USD", Lines: []Line{{Description: "Pro", Quantity: 1, UnitAmount: 100}}}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, old.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, recent.ID, t0.Add(20*24*time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	now := t0.Add(31 * 24 * time.Hour)
+	if n := s.PurgeDeletedCustomers(now); n != 1 {
+		t.Fatalf("purged %d customers, want 1", n)
+	}
+	if _, ok := s.CustomerIncludingDeleted(a.ID, old.ID); ok {
+		t.Fatal("purged customer is still there")
+	}
+	if _, ok := s.CustomerByID(recent.ID); !ok {
+		t.Fatal("a customer deleted 11 days ago was purged")
+	}
+	if _, ok := s.Customer(a.ID, kept.ID); !ok {
+		t.Fatal("a live customer was purged")
+	}
+	if got, ok := s.Invoice(a.ID, inv.ID); !ok || got.CustomerID != old.ID {
+		t.Fatalf("invoice of a purged customer = %+v, %v", got, ok)
+	}
+	if n := s.PurgeDeletedCustomers(now); n != 0 {
+		t.Fatalf("second purge removed %d", n)
+	}
+}
