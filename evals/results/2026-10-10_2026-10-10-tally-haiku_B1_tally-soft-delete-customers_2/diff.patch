+func TestDeleteCustomerWithActiveSubscription(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": p.ID}, &sub)
+	r := e.Do("DELETE", "/v1/customers/"+c.ID, e.Acme.Key, nil)
+	if r.Code != http.StatusConflict || r.Map(t)["error"] != "has_active_subscriptions" {
+		t.Fatalf("delete with a subscription: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers/"+c.ID, e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", e.Acme.Key, map[string]any{}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+c.ID, e.Acme.Key, nil, nil)
+}
