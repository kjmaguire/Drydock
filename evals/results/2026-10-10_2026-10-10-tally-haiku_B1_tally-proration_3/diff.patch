+func TestPendingChangeIsClearedByPatchBackOrAnUpgrade(t *testing.T) {
+	e := apitest.New(t)
+	pro := newPlan(t, e, "Pro", money.USD, 5000, store.Monthly, store.Licensed, 0)
+	sub := subscribe(t, e, pro, 3, "pm_card_visa")
+	afterTenDays(e)
+	one, three, four := 1, 3, 4
+
+	got := change(t, e, sub, subscriptions.UpdateInput{Quantity: &one})
+	if got.PendingQuantity == nil || *got.PendingQuantity != 1 || got.Quantity != 3 {
+		t.Fatalf("downgraded = %+v", got)
+	}
+	got = change(t, e, sub, subscriptions.UpdateInput{Quantity: &three})
+	if got.PendingPlanID != nil || got.PendingQuantity != nil || got.Quantity != 3 {
+		t.Fatalf("back to the current quantity = %+v, want nothing pending", got)
+	}
+	if n := len(invoicesOf(e, sub)); n != 1 {
+		t.Fatalf("returning to the current quantity billed: %d invoices", n)
+	}
+
+	change(t, e, sub, subscriptions.UpdateInput{Quantity: &one})
+	got = change(t, e, sub, subscriptions.UpdateInput{Quantity: &four})
+	if got.PendingPlanID != nil || got.PendingQuantity != nil || got.Quantity != 4 {
+		t.Fatalf("upgraded = %+v, want the pending downgrade cleared", got)
+	}
+	if n := len(invoicesOf(e, sub)); n != 2 {
+		t.Fatalf("upgrade invoices = %d", n)
+	}
+}
