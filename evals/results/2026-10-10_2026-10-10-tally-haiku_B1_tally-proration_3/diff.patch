+	e := apitest.New(t)
+	if _, err := e.Store.UpdateOrg(e.Acme.ID, func(o *store.Org) error { o.TaxRateBP = 2000; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	team := newPlan(t, e, "Team", money.USD, 2000, store.Monthly, store.Licensed, 0)
+	pro := newPlan(t, e, "Pro", money.USD, 5000, store.Monthly, store.Licensed, 0)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: team.ID, Quantity: 1, DiscountPercent: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	afterTenDays(e)
+	change(t, e, sub, subscriptions.UpdateInput{PlanID: &pro.ID})
+	// The lines net to 2032 (not paid here: no payment method). The 10% discount is 203.2, rounded to 203; the 20% tax on
+	// 1829 is 365.8, rounded to 366.
+	inv := invoicesOf(e, sub)[1]
+	if got := billing.Compute(inv); got != (billing.Totals{Subtotal: 2032, Discount: 203, Tax: 366, Total: 2195}) {
+		t.Fatalf("totals = %+v", got)
+	}
+	if inv.DiscountPercent != 10 || inv.TaxRateBP != 2000 || inv.Status != store.InvoiceOpen {
+		t.Fatalf("invoice = %+v", inv)
+	}
+}
