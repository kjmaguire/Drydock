+func TestUpgradeBillsTheRemainingTimeAtOnce(t *testing.T) {
+	e := apitest.New(t)
+	team := newPlan(t, e, "Team", money.USD, 2000, store.Monthly, store.Licensed, 0)
+	pro := newPlan(t, e, "Pro", money.USD, 5000, store.Monthly, store.Licensed, 0)
+	sub := subscribe(t, e, team, 1, "pm_card_visa")
+	afterTenDays(e)
+
+	got := change(t, e, sub, subscriptions.UpdateInput{PlanID: &pro.ID})
+	if got.PlanID != pro.ID || got.Quantity != 1 || got.Status != store.Active || got.PendingPlanID != nil || got.PendingQuantity != nil {
+		t.Fatalf("upgraded = %+v", got)
+	}
+	if !got.CurrentPeriodStart.Equal(sub.CurrentPeriodStart) || !got.CurrentPeriodEnd.Equal(sub.CurrentPeriodEnd) {
+		t.Fatalf("the period moved: %+v", got)
+	}
+	// 21 of the period's 31 days remain: 2000 × 21/31 = 1354.84 is credited, 5000 × 21/31 = 3387.10 is charged.
+	invs := invoicesOf(e, sub)
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %+v, want the first period's and the proration", invs)
+	}
+	inv := invs[1]
+	if want := []store.Line{{Description: "Unused time on Team", Quantity: 1, UnitAmount: -1355}, {Description: "Remaining time on Pro", Quantity: 1, UnitAmount: 3387}}; !reflect.DeepEqual(inv.Lines, want) {
+		t.Fatalf("lines = %+v", inv.Lines)
+	}
+	if inv.Status != store.InvoicePaid || billing.Compute(inv).Total != 2032 || inv.PeriodStart == nil || !inv.PeriodStart.Equal(sub.CurrentPeriodStart) {
+		t.Fatalf("proration invoice = %+v", inv)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[1].Amount != 2032 || cs[1].PaymentMethod != "pm_card_visa" {
