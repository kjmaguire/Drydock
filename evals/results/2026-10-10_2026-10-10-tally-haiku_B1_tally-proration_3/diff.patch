+func TestPartialChangeKeepsThePendingPlan(t *testing.T) {
+	e := apitest.New(t)
+	team := newPlan(t, e, "Team", money.USD, 2000, store.Monthly, store.Licensed, 0)
+	pro := newPlan(t, e, "Pro", money.USD, 5000, store.Monthly, store.Licensed, 0)
+	sub := subscribe(t, e, pro, 3, "pm_card_visa")
+	two := 2
+	got := change(t, e, sub, subscriptions.UpdateInput{PlanID: &team.ID})
+	if got.PendingPlanID == nil || *got.PendingPlanID != team.ID {
+		t.Fatalf("downgraded = %+v", got)
+	}
+	// Team is 2000 × 2 = 4000 in the pending change; the quantity alone changes it, not the plan.
+	got = change(t, e, sub, subscriptions.UpdateInput{Quantity: &two})
+	if got.PlanID != pro.ID || got.PendingPlanID == nil || *got.PendingPlanID != team.ID || *got.PendingQuantity != 2 {
+		t.Fatalf("after a quantity change = %+v, want Team still pending at quantity 2", got)
+	}
+}
