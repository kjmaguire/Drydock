+func TestDowngradeTakesEffectAtRenewal(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	team := newPlan(t, e, "Team", money.USD, 2000, store.Monthly, store.Licensed, 0)
+	pro := newPlan(t, e, "Pro", money.USD, 5000, store.Monthly, store.Licensed, 0)
+	sub := subscribe(t, e, pro, 1, "pm_card_visa")
+	afterTenDays(e)
+
+	got := change(t, e, sub, subscriptions.UpdateInput{PlanID: &team.ID})
+	if got.PlanID != pro.ID || got.Quantity != 1 || got.PendingPlanID == nil || *got.PendingPlanID != team.ID ||
+		got.PendingQuantity == nil || *got.PendingQuantity != 1 {
+		t.Fatalf("downgraded = %+v, want Pro still in effect and Team pending", got)
+	}
+	if n := len(invoicesOf(e, sub)); n != 1 {
+		t.Fatalf("a downgrade billed: %d invoices", n)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("a downgrade charged: %d charges", n)
+	}
+
+	e.Clock.Set(got.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	renewed, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if renewed.PlanID != team.ID || renewed.Quantity != 1 || renewed.PendingPlanID != nil || renewed.PendingQuantity != nil || renewed.Status != store.Active {
+		t.Fatalf("renewed = %+v", renewed)
+	}
+	invs := invoicesOf(e, sub)
+	if len(invs) != 2 || len(invs[1].Lines) != 1 || invs[1].Lines[0].UnitAmount != 2000 || invs[1].Lines[0].Quantity != 1 {
+		t.Fatalf("renewal invoice = %+v", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[1].Amount != 2000 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
