+func TestIncompatiblePlansAreRefused(t *testing.T) {
+	e := apitest.New(t)
+	team := newPlan(t, e, "Team", money.USD, 2000, store.Monthly, store.Licensed, 0)
+	sub := subscribe(t, e, team, 1, "pm_card_visa")
+	eur := newPlan(t, e, "EUR", money.EUR, 9900, store.Monthly, store.Licensed, 0)
+	yearly := newPlan(t, e, "Yearly", money.USD, 90000, store.Yearly, store.Licensed, 0)
+	metered := newPlan(t, e, "Metered", money.USD, 2, store.Monthly, store.Metered, 0)
+	for _, p := range []store.Plan{eur, yearly, metered} {
+		_, err := e.Subs.Update(context.Background(), e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &p.ID})
+		if !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+			t.Fatalf("change to %s: err = %v", p.Name, err)
+		}
+	}
+	if got, _ := e.Store.Subscription(e.Acme.ID, sub.ID); got.PlanID != team.ID {
+		t.Fatalf("a refused change applied: %+v", got)
+	}
+	// A metered plan is never compatible, even with itself: its usage is what is billed.
+	meteredSub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: sub.CustomerID, PlanID: metered.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	two := 2
+	if _, err := e.Subs.Update(context.Background(), e.Acme.ID, meteredSub.ID, subscriptions.UpdateInput{Quantity: &two}); !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+		t.Fatalf("quantity of a metered subscription: err = %v", err)
+	}
+}
