+// A free plan's invoices have one line for the plan, so the list and get answers show them. An invoice stored without
+// lines is answered too, with an empty description.
+func TestInvoicesWithoutPriceOrLines(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	free := e.CreatePlan(e.Acme, "Free", "USD", "0")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": free.ID, "quantity": 2}, &sub)
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+
+	type invoice struct {
+		store.Invoice
+		Total       int64  `json:"total"`
+		Description string `json:"description"`
+	}
+	var list struct{ Items []invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &list)
+	if len(list.Items) != 2 {
+		t.Fatalf("invoices = %+v, want the first period and one renewal", list.Items)
+	}
+	for _, inv := range list.Items {
+		if !strings.HasPrefix(inv.Description, "Free, ") || len(inv.Lines) != 1 || inv.Lines[0].Quantity != 2 || inv.Lines[0].UnitAmount != 0 ||
+			inv.Status != store.InvoicePaid || inv.Total != 0 {
+			t.Fatalf("free invoice = %+v", inv)
+		}
+	}
+	var got invoice
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+list.Items[1].ID, e.Acme.Key, nil, &got)
+	if got.Description != list.Items[1].Description {
+		t.Fatalf("get = %+v", got)
+	}
+
+	bare, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: money.USD}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var one invoice
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+bare.ID, e.Acme.Key, nil, &one)
+	if one.Description != "" || one.Status != store.InvoiceOpen || one.Lines == nil {
+		t.Fatalf("invoice without lines = %+v", one)
+	}
+	var paid struct{ Invoice invoice }
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+bare.ID+"/pay", e.Acme.Key, nil, &paid)
+	if paid.Invoice.Status != store.InvoicePaid || paid.Invoice.Description != "" {
+		t.Fatalf("paid invoice without lines = %+v", paid.Invoice)
+	}
+	bare2, _ := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: money.USD}, e.Clock.Now())
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+bare2.ID+"/void", e.Acme.Key, nil, &one)
+	if one.Status != store.InvoiceVoid || one.Description != "" {
+		t.Fatalf("voided invoice without lines = %+v", one)
+	}
+}
