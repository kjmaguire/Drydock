@@ -0,0 +1,75 @@
+package store
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestCreateCustomers(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	if _, err := s.CreateCustomer(b.ID, "Other", "shared@example.com", t0); err != nil {
+		t.Fatal(err)
+	}
+
+	// Refused batches add nothing, not even the records before the one that is refused.
+	refused := map[string][]NewCustomer{
+		"no name":             {{Name: "Ann", Email: "ann@example.com"}, {Name: " ", Email: "bob@example.com"}},
+		"bad payment method":  {{Name: "Ann", Email: "ann@example.com", DefaultPaymentMethod: "card_1"}},
+		"duplicate in batch":  {{Name: "Ann", Email: "ann@example.com"}, {Name: "Ann 2", Email: "ANN@example.com"}},
+		"invalid email, last": {{Name: "Ann", Email: "ann@example.com"}, {Name: "Bob", Email: "bob"}},
+	}
+	for name, batch := range refused {
+		if _, err := s.CreateCustomers(a.ID, batch, t0); err == nil {
+			t.Fatalf("%s: no error", name)
+		}
+	}
+	if n := len(s.Customers(a.ID)); n != 0 {
+		t.Fatalf("refused batches left %d customers", n)
+	}
+	if _, err := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateCustomers(a.ID, []NewCustomer{{Name: "Ann", Email: "ann@example.com"}, {Name: "Jane 2", Email: "JANE@example.com"}}, t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("email taken in the org: %v", err)
+	}
+	if n := len(s.Customers(a.ID)); n != 1 {
+		t.Fatalf("a refused batch left %d customers", n)
+	}
+	// An email used by another organization is fine.
+	if _, err := s.CreateCustomers(a.ID, []NewCustomer{{Name: "Ann", Email: "ann@example.com"}, {Name: "Bob", Email: "shared@example.com"}}, t0); err != nil {
+		t.Fatalf("an email used by another organization is refused: %v", err)
+	}
+	if _, err := s.CreateCustomers(a.ID, []NewCustomer{{Name: "Cid", Email: "cid@example.com"}, {Name: "Dee", Email: "dee@example.com"}}, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateCustomers("org_nope", nil, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("unknown org: %v", err)
+	}
+}
+
+func TestCreateCustomersInOrder(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	meta := map[string]string{"crm": "7"}
+	got, err := s.CreateCustomers(a.ID, []NewCustomer{
+		{Name: " Ann ", Email: " ann@example.com ", DefaultPaymentMethod: "pm_1", Metadata: meta},
+		{Name: "Bob", Email: "bob@example.com"},
+	}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0].Name != "Ann" || got[0].Email != "ann@example.com" || got[1].Name != "Bob" || got[0].ID >= got[1].ID {
+		t.Fatalf("created = %+v", got)
+	}
+	if got[0].Metadata["crm"] != "7" || got[1].Metadata != nil {
+		t.Fatalf("metadata = %+v, %+v", got[0].Metadata, got[1].Metadata)
+	}
+	meta["crm"] = "changed"
+	if c, _ := s.Customer(a.ID, got[0].ID); c.Metadata["crm"] != "7" {
+		t.Fatal("the stored metadata shares the caller's map")
+	}
+	if emails := s.CustomerEmails(a.ID); !emails["ann@example.com"] || !emails["bob@example.com"] || len(emails) != 2 {
+		t.Fatalf("CustomerEmails = %v", emails)
+	}
+}
