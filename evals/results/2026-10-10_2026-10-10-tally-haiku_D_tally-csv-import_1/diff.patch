index 0000000..f56d070
--- /dev/null
+++ b/result/internal/api/customers_import.go
@@ -0,0 +1,193 @@
+package api
+
+import (
+	"bytes"
+	"encoding/csv"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// maxImportRows is the most data records one import may carry.
+const maxImportRows = 10000
+
+// metadataPrefix starts the header of a column that fills one metadata key.
+const metadataPrefix = "metadata."
+
+// importRecord is one non-blank record of an import's CSV body: the line it starts on and its fields.
+type importRecord struct {
+	line   int
+	fields []string
+}
+
+// importColumns says which field of a record fills each customer field; -1 means the header has no such column.
+type importColumns struct {
+	name, email, paymentMethod int
+	metadata                   []metadataColumn
+}
+
+type metadataColumn struct {
+	index int
+	key   string
+}
+
+// rowError is one bad record of an import: the line it starts on and the first problem with it.
+type rowError struct {
+	Row   int    `json:"row"`
+	Error string `json:"error"`
+}
+
+// importCustomers creates the customers in a CSV body. The first record is a header; every other record is one customer.
+// Either every customer is created or none is.
+func (s *Server) importCustomers(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid_csv"})
+		return
+	}
+	records, err := readImport(body)
+	if err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid_csv"})
+		return
+	}
+	cols, ok := importHeader(records)
+	if !ok {
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]string{"error": "invalid_header"})
+		return
+	}
+	rows := records[1:]
+	if len(rows) > maxImportRows {
+		writeJSON(w, http.StatusRequestEntityTooLarge, map[string]string{"error": "too_many_rows"})
+		return
+	}
+
+	taken := s.store.CustomerEmails(p.OrgID)
+	seen := map[string]bool{}
+	var ins []store.NewCustomer
+	var bad []rowError
+	for _, rec := range rows {
+		in := cols.customer(rec.fields)
+		key := strings.ToLower(in.Email)
+		if problem := importProblem(in, taken[key], seen[key]); problem != "" {
+			bad = append(bad, rowError{Row: rec.line, Error: problem})
+		} else {
+			ins = append(ins, in)
+		}
+		seen[key] = true
+	}
+	if len(bad) > 0 {
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]any{"error": "invalid_rows", "rows": bad})
+		return
+	}
+	if r.URL.Query().Get("dry_run") == "true" {
+		writeJSON(w, http.StatusOK, map[string]int{"created": 0, "would_create": len(ins)})
+		return
+	}
+	created, err := s.store.CreateCustomers(p.OrgID, ins, s.clock.Now())
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	for _, c := range created {
+		s.publish(r.Context(), p.OrgID, "customer.created", c)
+	}
+	writeJSON(w, http.StatusCreated, map[string]any{"created": len(created), "items": created})
+}
+
+// readImport parses a CSV body into its non-blank records. Every record must have as many fields as the first one.
+func readImport(body []byte) ([]importRecord, error) {
+	cr := csv.NewReader(bytes.NewReader(bytes.TrimPrefix(body, []byte("\xef\xbb\xbf"))))
+	cr.FieldsPerRecord = -1
+	var out []importRecord
+	for {
+		fields, err := cr.Read()
+		if err == io.EOF {
+			return out, nil
+		}
+		if err != nil {
+			return nil, err
+		}
+		if blankLine(fields) {
+			continue
+		}
+		if len(out) > 0 && len(fields) != len(out[0].fields) {
+			return nil, errors.New("a record has a different number of fields from the header")
+		}
+		line, _ := cr.FieldPos(0)
+		out = append(out, importRecord{line: line, fields: fields})
+	}
+}
+
+// blankLine says a record is a blank line: one field of only spaces. A line of commas is a record, not a blank line.
+// csv.Reader already drops lines that are empty.
+func blankLine(fields []string) bool {
+	return len(fields) == 1 && strings.TrimSpace(fields[0]) == ""
+}
+
+// importHeader finds the columns of an import from its first record, matching names ignoring case and surrounding
+// spaces. It reports false when there is no header or the header lacks name or email. Records after the header are rows.
+func importHeader(records []importRecord) (importColumns, bool) {
+	cols := importColumns{name: -1, email: -1, paymentMethod: -1}
+	if len(records) == 0 {
+		return cols, false
+	}
+	for i, h := range records[0].fields {
+		name := strings.TrimSpace(h)
+		lower := strings.ToLower(name)
+		switch {
+		case lower == "name" && cols.name < 0:
+			cols.name = i
+		case lower == "email" && cols.email < 0:
+			cols.email = i
+		case lower == "default_payment_method" && cols.paymentMethod < 0:
+			cols.paymentMethod = i
+		case len(name) > len(metadataPrefix) && strings.EqualFold(name[:len(metadataPrefix)], metadataPrefix):
+			if key := strings.TrimSpace(name[len(metadataPrefix):]); key != "" {
+				cols.metadata = append(cols.metadata, metadataColumn{index: i, key: key})
+			}
+		}
+	}
+	return cols, cols.name >= 0 && cols.email >= 0
+}
+
+// customer reads the customer a record asks for. Blank metadata cells set nothing.
+func (cols importColumns) customer(fields []string) store.NewCustomer {
+	cell := func(i int) string {
+		if i < 0 {
+			return ""
+		}
+		return strings.TrimSpace(fields[i])
+	}
+	in := store.NewCustomer{Name: cell(cols.name), Email: cell(cols.email), DefaultPaymentMethod: cell(cols.paymentMethod)}
+	for _, m := range cols.metadata {
+		if v := cell(m.index); v != "" {
+			if in.Metadata == nil {
+				in.Metadata = map[string]string{}
+			}
+			in.Metadata[m.key] = v
+		}
+	}
+	return in
+}
+
+// importProblem returns the first code that applies to a customer from an import, or "" when it is fine. taken says an
+// existing customer of the organization has its email address; seen says an earlier record of the import has it.
+func importProblem(in store.NewCustomer, taken, seen bool) string {
+	switch {
+	case in.Name == "":
+		return "missing_name"
+	case !store.ValidEmail(in.Email):
+		return "invalid_email"
+	case in.DefaultPaymentMethod != "" && !strings.HasPrefix(in.DefaultPaymentMethod, "pm_"):
+		return "invalid_payment_method"
+	case taken:
+		return "email_taken"
+	case seen:
+		return "duplicate_email"
+	}
+	return ""
+}
