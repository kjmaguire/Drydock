+package api_test
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+type importResponse struct {
+	Created     int              `json:"created"`
+	WouldCreate int              `json:"would_create"`
+	Items       []store.Customer `json:"items"`
+}
+
+func TestImportCustomers(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Globex, "Shared", "shared@example.com")
+
+	// A byte order mark, CRLF line ends, a blank line, a quoted comma and a quoted line break; the header is in another
+	// order, with other columns and odd spacing. Bob's email is taken in another organization, which does not matter.
+	bom := string([]byte{0xEF, 0xBB, 0xBF})
+	body := bom + " Email ,Ignored, NAME ,metadata.CRM,default_payment_method,metadata.plan\r\n" +
+		"\r\n" +
+		`ann@example.com,x,"Lee, Ann",7,pm_123,"pro"` + "\r\n" +
+		"\r\n" +
+		"shared@example.com,,\"Bob\nRoe\",,,\r\n"
+	var got importResponse
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers/import", e.Acme.Key, body, &got)
+	if got.Created != 2 || len(got.Items) != 2 {
+		t.Fatalf("import = %+v", got)
+	}
+	ann, bob := got.Items[0], got.Items[1]
+	if ann.Name != "Lee, Ann" || ann.Email != "ann@example.com" || ann.DefaultPaymentMethod != "pm_123" ||
+		ann.Metadata["CRM"] != "7" || ann.Metadata["plan"] != "pro" || len(ann.Metadata) != 2 {
+		t.Fatalf("ann = %+v", ann)
+	}
+	if bob.Name != "Bob\nRoe" || bob.Email != "shared@example.com" || bob.Metadata != nil || bob.DefaultPaymentMethod != "" {
+		t.Fatalf("bob = %+v", bob)
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 2 {
+		t.Fatalf("Acme has %d customers, want 2", n)
+	}
+	if n := len(e.Store.Events(e.Acme.ID, "customer.created")); n != 2 {
+		t.Fatalf("%d customer.created events, want 2", n)
+	}
+}
+
+func TestImportCustomersHeader(t *testing.T) {
+	e := apitest.New(t)
+	for _, body := range []string{"", "\n\n", "name,phone\nJane,555", "email\njane@example.com", "name,\nJane,"} {
+		r := e.Do("POST", "/v1/customers/import", e.Acme.Key, body)
+		if r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_header" {
+			t.Fatalf("%q: %s", body, r)
+		}
+	}
+	if r := e.Do("POST", "/v1/customers/import", e.Acme.Key, "name,email\n"); r.Code != http.StatusCreated {
+		t.Fatalf("header only: %s", r)
+	}
+}
+
+func TestImportCustomersInvalidCSV(t *testing.T) {
+	e := apitest.New(t)
+	for _, body := range []string{
+		"name,email\n\"Jane,jane@example.com\n",
+		"name,email\nJa\"ne,jane@example.com\n",
+		"name,email\nJane,jane@example.com,extra\n",
+	} {
+		if r := e.Do("POST", "/v1/customers/import", e.Acme.Key, body); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_csv" {
+			t.Fatalf("%q: %s", body, r)
+		}
+	}
+}
+
+func TestImportCustomersInvalidRows(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	// Line 2 starts a record that spans lines 2 and 3, so the record after it starts on line 5 (line 4 is blank).
+	body := "name,email,default_payment_method\n" +
+		"\"Multi\nLine\",multi@example.com,\n" +
+		"\n" +
+		",blank@example.com,\n" +
+		"Bad,not-an-email,\n" +
+		"Pay,pay@example.com,card_1\n" +
+		"Taken,JANE@acme.example,\n" +
+		"Dup,MULTI@example.com,\n" +
+		",NEW@example.com,\n"
+	var got struct {
+		Error string `json:"error"`
+		Rows  []struct {
+			Row   int    `json:"row"`
+			Error string `json:"error"`
+		} `json:"rows"`
+	}
+	e.MustDo(http.StatusUnprocessableEntity, "POST", "/v1/customers/import", e.Acme.Key, body, &got)
+	want := []struct {
+		row  int
+		code string
+	}{{5, "missing_name"}, {6, "invalid_email"}, {7, "invalid_payment_method"}, {8, "email_taken"}, {9, "duplicate_email"}, {10, "missing_name"}}
+	if got.Error != "invalid_rows" || len(got.Rows) != len(want) {
+		t.Fatalf("answer = %+v", got)
+	}
+	for i, w := range want {
+		if got.Rows[i].Row != w.row || got.Rows[i].Error != w.code {
+			t.Fatalf("row %d = %+v, want %d %s", i, got.Rows[i], w.row, w.code)
+		}
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 1 {
+		t.Fatalf("a refused import created customers: %d", n)
+	}
+}
+
+func TestImportCustomersEmptyFieldsAreRecords(t *testing.T) {
+	e := apitest.New(t)
+	// Line 3 is a line of spaces, which is blank and skipped. Line 4 is a record with every field empty, so it is
+	// reported as missing its name.
+	body := "name,email,default_payment_method\n" +
+		"Ann,ann@example.com,\n" +
+		"   \n" +
+		",,\n" +
+		"Bob,bob@example.com,\n"
+	var got struct {
+		Error string `json:"error"`
+		Rows  []struct {
+			Row   int    `json:"row"`
+			Error string `json:"error"`
+		} `json:"rows"`
+	}
+	e.MustDo(http.StatusUnprocessableEntity, "POST", "/v1/customers/import", e.Acme.Key, body, &got)
+	if got.Error != "invalid_rows" || len(got.Rows) != 1 || got.Rows[0].Row != 4 || got.Rows[0].Error != "missing_name" {
+		t.Fatalf("answer = %+v", got)
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 0 {
+		t.Fatalf("a refused import created customers: %d", n)
+	}
+}
+
+func TestImportCustomersAllOrNothing(t *testing.T) {
+	e := apitest.New(t)
+	// The first two records are fine; the third is refused, so none is created.
+	body := "name,email\nAnn,ann@example.com\nBob,bob@example.com\nCid,ann@example.com\n"
+	if r := e.Do("POST", "/v1/customers/import", e.Acme.Key, body); r.Code != http.StatusUnprocessableEntity {
+		t.Fatalf("import: %s", r)
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 0 {
+		t.Fatalf("Acme has %d customers after a refused import", n)
+	}
+}
+
+func TestImportCustomersDryRun(t *testing.T) {
+	e := apitest.New(t)
+	good := "name,email\nAnn,ann@example.com\nBob,bob@example.com\n"
+	var got importResponse
+	e.MustDo(http.StatusOK, "POST", "/v1/customers/import?dry_run=true", e.Acme.Key, good, &got)
+	if got.Created != 0 || got.WouldCreate != 2 {
+		t.Fatalf("dry run = %+v", got)
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 0 {
+		t.Fatalf("a dry run created %d customers", n)
+	}
+	if n := len(e.Store.Events(e.Acme.ID, "customer.created")); n != 0 {
+		t.Fatalf("a dry run sent %d events", n)
+	}
+
+	bad := "name,email\nAnn,ann@example.com\n,bob@example.com\n"
+	if r := e.Do("POST", "/v1/customers/import?dry_run=true", e.Acme.Key, bad); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_rows" {
+		t.Fatalf("dry run of bad rows: %s", r)
+	}
+}
+
+func TestImportCustomersTooManyRows(t *testing.T) {
+	e := apitest.New(t)
+	rows := func(n int) string {
+		var b strings.Builder
+		b.WriteString("name,email\n")
+		for i := range n {
+			b.WriteString("Customer,c" + strconv.Itoa(i) + "@example.com\n")
+		}
+		return b.String()
+	}
+	if r := e.Do("POST", "/v1/customers/import", e.Acme.Key, rows(10001)); r.Code != http.StatusRequestEntityTooLarge || r.Map(t)["error"] != "too_many_rows" {
+		t.Fatalf("10001 rows: %s", r)
+	}
+	var got importResponse
+	e.MustDo(http.StatusOK, "POST", "/v1/customers/import?dry_run=true", e.Acme.Key, rows(10000), &got)
+	if got.WouldCreate != 10000 {
+		t.Fatalf("10000 rows: %+v", got)
+	}
+}
+
+func TestImportCustomersViewer(t *testing.T) {
+	e := apitest.New(t)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	if r := e.Do("POST", "/v1/customers/import", viewer, "name,email\nAnn,ann@example.com\n"); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer import: %s", r)
+	}
+}
