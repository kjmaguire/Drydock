+// NewCustomer is a customer to add with CreateCustomers.
+type NewCustomer struct {
+	Name                 string
+	Email                string
+	DefaultPaymentMethod string
+	Metadata             map[string]string
+}
+
+// CreateCustomers adds customers to an organization, in order, all or none: every customer is checked, and its email
+// address compared with the organization's customers and with the earlier customers of the batch (ignoring case), before
+// any is added.
+func (s *Store) CreateCustomers(orgID string, ins []NewCustomer, now time.Time) ([]Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return nil, ErrNotFound
+	}
+	taken := map[string]bool{}
+	for _, c := range s.customers {
+		if c.OrgID == orgID {
+			taken[normEmail(c.Email)] = true
+		}
+	}
+	for _, in := range ins {
+		name, email := strings.TrimSpace(in.Name), strings.TrimSpace(in.Email)
+		if name == "" || !validEmail(email) {
+			return nil, invalid("a customer needs a name and a valid email address")
+		}
+		if in.DefaultPaymentMethod != "" && !strings.HasPrefix(in.DefaultPaymentMethod, "pm_") {
+			return nil, invalid("a payment method looks like pm_...")
+		}
+		if taken[normEmail(email)] {
+			return nil, ErrEmailTaken
+		}
+		taken[normEmail(email)] = true
+	}
+	out := make([]Customer, 0, len(ins))
+	for _, in := range ins {
+		c := Customer{
+			ID: s.newID("cus"), OrgID: orgID, Name: strings.TrimSpace(in.Name), Email: strings.TrimSpace(in.Email),
+			DefaultPaymentMethod: in.DefaultPaymentMethod, CreatedAt: now.UTC(),
+		}
+		if len(in.Metadata) > 0 {
+			c.Metadata = in.Metadata
+		}
+		c = copyCustomer(c)
+		s.customers[c.ID] = c
+		s.customersByEmail[normEmail(c.Email)] = c.ID
+		out = append(out, copyCustomer(c))
+	}
+	return out, nil
+}
+
+// CustomerEmails returns the email addresses of an organization's customers, lower-cased.
+func (s *Store) CustomerEmails(orgID string) map[string]bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := map[string]bool{}
+	for _, c := range s.customers {
+		if c.OrgID == orgID {
+			out[normEmail(c.Email)] = true
+		}
+	}
+	return out
+}
+
+// ValidEmail reports whether an email address is well formed enough to be a customer's.
+func ValidEmail(email string) bool { return validEmail(strings.TrimSpace(email)) }
