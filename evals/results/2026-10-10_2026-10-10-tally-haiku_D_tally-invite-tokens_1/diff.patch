@@ -0,0 +1,101 @@
+package store
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestInviteTokenIsHashed(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv, token, err := s.IssueInvite(o.ID, "new@people.example", RoleMember, "", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(token)
+	if err != nil || len(raw) != 32 || len(token) != 43 {
+		t.Fatalf("token %q is not 32 random bytes in unpadded base64url", token)
+	}
+	if inv.TokenHash != hashToken(token) || inv.TokenHash == token {
+		t.Fatalf("invite stores %q, want only the SHA-256 of the token", inv.TokenHash)
+	}
+	state, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(state), token) {
+		t.Fatal("the snapshot contains the token")
+	}
+	if got, _ := s.Invite(o.ID, inv.ID); strings.Contains(got.TokenHash, token) {
+		t.Fatal("the stored invite contains the token")
+	}
+}
+
+func TestAcceptInvite(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	_, token, _ := s.IssueInvite(o.ID, "new@people.example", RoleMember, "", t0)
+
+	for _, bad := range []string{"", "invite_nope", token + "x"} {
+		if _, _, _, err := s.AcceptInvite(bad, "New", t0); !errors.Is(err, ErrNotFound) {
+			t.Errorf("AcceptInvite(%q) = %v, want ErrNotFound", bad, err)
+		}
+	}
+	if _, m, _, err := s.AcceptInvite(token, "New Person", t0.Add(time.Hour)); err != nil || m.Role != RoleMember {
+		t.Fatalf("AcceptInvite = %+v, %v", m, err)
+	}
+	if _, _, _, err := s.AcceptInvite(token, "New Person", t0.Add(time.Hour)); !errors.Is(err, ErrInviteUsed) {
+		t.Fatalf("second accept = %v, want ErrInviteUsed", err)
+	}
+	if len(s.InvitesAt(o.ID, t0.Add(time.Hour))) != 0 {
+		t.Fatal("an accepted invite is still pending")
+	}
+}
+
+func TestInviteExpiry(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	_, onTime, _ := s.IssueInvite(o.ID, "a@people.example", RoleMember, "", t0)
+	_, late, _ := s.IssueInvite(o.ID, "b@people.example", RoleMember, "", t0)
+
+	seven := t0.Add(7 * 24 * time.Hour)
+	if n := len(s.InvitesAt(o.ID, seven)); n != 2 {
+		t.Fatalf("pending exactly 7 days after creation = %d, want 2", n)
+	}
+	if n := len(s.InvitesAt(o.ID, seven.Add(time.Second))); n != 0 {
+		t.Fatalf("pending a second after 7 days = %d, want 0", n)
+	}
+	if _, _, _, err := s.AcceptInvite(late, "B", seven.Add(time.Second)); !errors.Is(err, ErrInviteExpired) {
+		t.Fatalf("accept after 7 days = %v, want ErrInviteExpired", err)
+	}
+	if _, _, _, err := s.AcceptInvite(onTime, "A", seven); err != nil {
+		t.Fatalf("accept exactly 7 days after creation: %v", err)
+	}
+}
+
+func TestReinviteRevokesOldInvite(t *testing.T) {
+	s := New()
+	acme := newOrg(t, s, "Acme")
+	globex := newOrg(t, s, "Globex")
+	_, oldToken, _ := s.IssueInvite(acme.ID, "ann@people.example", RoleMember, "", t0)
+	_, otherOrgToken, _ := s.IssueInvite(globex.ID, "ann@people.example", RoleMember, "", t0)
+	_, newToken, _ := s.IssueInvite(acme.ID, "Ann@People.example", RoleViewer, "", t0.Add(time.Minute))
+
+	pending := s.InvitesAt(acme.ID, t0.Add(time.Hour))
+	if len(pending) != 1 || pending[0].Role != RoleViewer {
+		t.Fatalf("pending after a re-invite = %+v, want only the newest", pending)
+	}
+	if _, _, _, err := s.AcceptInvite(oldToken, "Ann", t0.Add(time.Hour)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("old token = %v, want ErrNotFound", err)
+	}
+	if _, _, _, err := s.AcceptInvite(otherOrgToken, "Ann", t0.Add(time.Hour)); err != nil {
+		t.Fatalf("another organization's invite was revoked: %v", err)
+	}
+	if _, m, _, err := s.AcceptInvite(newToken, "Ann", t0.Add(time.Hour)); err != nil || m.Role != RoleViewer {
+		t.Fatalf("new token = %+v, %v", m, err)
+	}
+}
