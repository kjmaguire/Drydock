+package api_test
+
+import (
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// inviteEmail invites an address to Acme and returns the token from the invitation email.
+func inviteEmail(t *testing.T, e *apitest.Env, email string) (store.Invite, string) {
+	t.Helper()
+	var inv store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": email, "role": "member"}, &inv)
+	msgs := e.Mail.Messages()
+	m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[len(msgs)-1].Body)
+	if m == nil || msgs[len(msgs)-1].To != email {
+		t.Fatalf("no invitation link for %s in %+v", email, msgs)
+	}
+	token, _ := url.QueryUnescape(m[1])
+	return inv, token
+}
+
+func accept(e *apitest.Env, token string) *apitest.Response {
+	return e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "New Person"})
+}
+
+func TestInviteTokenNeverInAPI(t *testing.T) {
+	e := apitest.New(t)
+	_, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	_, token := inviteEmail(t, e, "new@people.example")
+
+	posted := e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "other@people.example", "role": "member"}, nil)
+	listed := e.MustDo(http.StatusOK, "GET", "/v1/invites", viewerKey, nil, nil)
+	for _, body := range []string{string(posted.Body), string(listed.Body)} {
+		if strings.Contains(body, token) || strings.Contains(body, `"token"`) {
+			t.Fatalf("an invite answer shows the token: %s", body)
+		}
+	}
+	if !strings.Contains(string(listed.Body), `"expires_at"`) {
+		t.Fatalf("GET /v1/invites does not show expires_at: %s", listed.Body)
+	}
+}
+
+func TestAcceptInviteErrors(t *testing.T) {
+	e := apitest.New(t)
+	_, token := inviteEmail(t, e, "new@people.example")
+
+	if r := accept(e, "invite_nope"); r.Code != http.StatusNotFound || !strings.Contains(string(r.Body), "invite_not_found") {
+		t.Fatalf("unknown token: %s", r.Body)
+	}
+	if r := accept(e, token); r.Code != http.StatusCreated {
+		t.Fatalf("accept: %s", r.Body)
+	}
+	if r := accept(e, token); r.Code != http.StatusGone || !strings.Contains(string(r.Body), "invite_used") {
+		t.Fatalf("accepted twice: %s", r.Body)
+	}
+
+	_, expiring := inviteEmail(t, e, "late@people.example")
+	e.Clock.Advance(7*24*time.Hour + time.Second)
+	if r := accept(e, expiring); r.Code != http.StatusGone || !strings.Contains(string(r.Body), "invite_expired") {
+		t.Fatalf("expired: %s", r.Body)
+	}
+}
+
+func TestRevokedInviteIsNotFound(t *testing.T) {
+	e := apitest.New(t)
+	inv, token := inviteEmail(t, e, "new@people.example")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+inv.ID, e.Acme.Key, nil, nil)
+	if r := accept(e, token); r.Code != http.StatusNotFound || !strings.Contains(string(r.Body), "invite_not_found") {
+		t.Fatalf("revoked: %s", r.Body)
+	}
+}
+
+func TestReinviteSendsNewToken(t *testing.T) {
+	e := apitest.New(t)
+	_, oldToken := inviteEmail(t, e, "new@people.example")
+	_, newToken := inviteEmail(t, e, "New@People.example")
+	if oldToken == newToken {
+		t.Fatal("the new invite has the old token")
+	}
+	if r := accept(e, oldToken); r.Code != http.StatusNotFound {
+		t.Fatalf("the old token: %s", r.Body)
+	}
+	if r := accept(e, newToken); r.Code != http.StatusCreated {
+		t.Fatalf("the new token: %s", r.Body)
+	}
+}
