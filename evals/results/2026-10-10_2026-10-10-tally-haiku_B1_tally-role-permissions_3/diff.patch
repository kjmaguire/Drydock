+// MemberCheck decides whether a change to a member may go ahead. It runs under the store's lock, against the member as it is
+// then and with how many owners the organization has, so a check that passes still holds when the change is made.
+type MemberCheck func(cur Member, owners int) error
+
+// UpdateMemberRole is SetMemberRole, applied only if check allows it. The check's error is returned unchanged.
+func (s *Store) UpdateMemberRole(orgID, userID string, role Role, check MemberCheck) (Member, error) {
+	if !role.Valid() {
+		return Member{}, invalid("unknown role %q", role)
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := memberKey{orgID, userID}
+	m, ok := s.members[k]
+	if !ok {
+		return Member{}, ErrNotFound
+	}
+	if err := check(m, s.ownerCount(orgID)); err != nil {
+		return Member{}, err
+	}
+	m.Role = role
+	s.members[k] = m
+	return m, nil
+}
+
+// RemoveMemberIf is RemoveMember, applied only if check allows it. The check's error is returned unchanged.
+func (s *Store) RemoveMemberIf(orgID, userID string, check MemberCheck) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := memberKey{orgID, userID}
+	m, ok := s.members[k]
+	if !ok {
+		return ErrNotFound
+	}
+	if err := check(m, s.ownerCount(orgID)); err != nil {
+		return err
+	}
+	delete(s.members, k)
+	return nil
+}
+
+// ownerCount counts an organization's owners. The caller holds s.mu.
+func (s *Store) ownerCount(orgID string) int {
+	n := 0
+	for _, m := range s.members {
+		if m.OrgID == orgID && m.Role == RoleOwner {
+			n++
+		}
+	}
+	return n
+}
+
