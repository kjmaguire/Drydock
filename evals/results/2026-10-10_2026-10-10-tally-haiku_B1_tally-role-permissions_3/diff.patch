--- /dev/null
+++ b/result/internal/api/roles_test.go
@@ -0,0 +1,273 @@
+package api_test
+
+import (
+	"net/http"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// roleKeys returns an API key of the Acme organization for each role: its owner's, and one new member per other role.
+func roleKeys(e *apitest.Env) map[store.Role]string {
+	keys := map[store.Role]string{store.RoleOwner: e.Acme.Key}
+	for _, role := range []store.Role{store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		_, keys[role] = e.AddMember(e.Acme, string(role)+"@acme.example", role)
+	}
+	return keys
+}
+
+// TestRoleTable checks each endpoint of the role table against every role. A role that may not use the endpoint must get
+// 403 and no other status; a role that may must get past the role check, so its answer is anything but 403. The endpoints
+// are called with IDs that do not exist, so the calls that get through change nothing.
+func TestRoleTable(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	// Who may use an endpoint, as role names.
+	const (
+		all    = "owner admin billing member viewer"
+		noView = "owner admin billing member"
+		bill   = "owner admin billing"
+		manage = "owner admin"
+	)
+	type row struct {
+		method, path string
+		body         any
+		allowed      string
+	}
+	rows := []row{
+		{"GET", "/v1/me", nil, all},
+		{"GET", "/v1/org", nil, all},
+		{"PATCH", "/v1/org", map[string]any{"name": "Acme 2"}, manage},
+		{"GET", "/v1/members", nil, all},
+		{"GET", "/v1/invites", nil, all},
+		{"POST", "/v1/invites", map[string]any{"email": "new@people.example", "role": "member"}, manage},
+		{"DELETE", "/v1/invites/nope", nil, manage},
+		{"GET", "/v1/customers", nil, all},
+		{"GET", "/v1/customers/export.csv", nil, all},
+		{"GET", "/v1/customers/nope", nil, all},
+		{"POST", "/v1/customers", map[string]string{"name": "X", "email": "x@example.com"}, noView},
+		{"PATCH", "/v1/customers/nope", map[string]string{"name": "Y"}, noView},
+		{"DELETE", "/v1/customers/nope", nil, noView},
+		{"GET", "/v1/plans", nil, all},
+		{"GET", "/v1/plans/nope", nil, all},
+		{"POST", "/v1/plans", map[string]string{"name": "Pro"}, bill},
+		{"PATCH", "/v1/plans/nope", map[string]string{"name": "Pro"}, bill},
+		{"GET", "/v1/subscriptions", nil, all},
+		{"GET", "/v1/subscriptions/nope", nil, all},
+		{"POST", "/v1/subscriptions", map[string]string{"customer_id": "nope"}, noView},
+		{"PATCH", "/v1/subscriptions/nope", map[string]string{"quantity": "2"}, noView},
+		{"POST", "/v1/subscriptions/nope/cancel", nil, noView},
+		{"POST", "/v1/subscriptions/nope/usage", map[string]any{"quantity": 1}, noView},
+		{"GET", "/v1/invoices", nil, all},
+		{"GET", "/v1/invoices/nope", nil, all},
+		{"GET", "/v1/invoices/nope/lines", nil, all},
+		{"POST", "/v1/invoices", map[string]string{"subscription_id": "nope"}, bill},
+		{"POST", "/v1/invoices/nope/pay", nil, bill},
+		{"POST", "/v1/invoices/nope/void", nil, bill},
+		{"GET", "/v1/payments", nil, all},
+		{"GET", "/v1/reports/revenue", nil, bill},
+		{"GET", "/v1/webhook-endpoints", nil, manage},
+		{"POST", "/v1/webhook-endpoints", map[string]string{"url": "https://hooks.example.com/x"}, manage},
+		{"GET", "/v1/webhook-endpoints/nope", nil, manage},
+		{"PATCH", "/v1/webhook-endpoints/nope", map[string]bool{"enabled": false}, manage},
+		{"DELETE", "/v1/webhook-endpoints/nope", nil, manage},
+		{"GET", "/v1/webhook-endpoints/nope/deliveries", nil, manage},
+		{"GET", "/v1/events", nil, manage},
+		{"GET", "/v1/events/nope", nil, manage},
+		{"PATCH", "/v1/members/nope", map[string]string{"role": "member"}, manage},
+		{"DELETE", "/v1/members/nope", nil, manage},
+	}
+	for _, rw := range rows {
+		for _, role := range []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer} {
+			allowed := slices.Contains(strings.Fields(rw.allowed), string(role))
+			r := e.Do(rw.method, rw.path, keys[role], rw.body)
+			if allowed && r.Code == http.StatusForbidden {
+				t.Errorf("%s %s as %s: refused, want allowed: %s", rw.method, rw.path, role, r)
+			}
+			if !allowed && (r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden") {
+				t.Errorf("%s %s as %s: %s, want 403 forbidden", rw.method, rw.path, role, r)
+			}
+		}
+	}
+}
+
+// TestRefusedWritesChangeNothing checks that a refused request leaves the data as it was.
+func TestRefusedWritesChangeNothing(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	before := len(e.Store.Customers(e.Acme.ID))
+	if r := e.Do("POST", "/v1/customers", keys[store.RoleViewer], map[string]string{"name": "X", "email": "x@example.com"}); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer creates a customer: %s", r)
+	}
+	if got := len(e.Store.Customers(e.Acme.ID)); got != before {
+		t.Fatalf("customers = %d, want %d", got, before)
+	}
+}
+
+// TestViewerBecomesMember checks that a role change applies to the member's existing key at once.
+func TestViewerBecomesMember(t *testing.T) {
+	e := apitest.New(t)
+	user, key := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	if r := e.Do("POST", "/v1/customers", key, map[string]string{"name": "X", "email": "x@example.com"}); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer writes: %s", r)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+user.ID, e.Acme.Key, map[string]string{"role": "member"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, map[string]string{"name": "X", "email": "x@example.com"}, nil)
+}
+
+func TestMemberRoleRules(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	admin, _ := e.AddMember(e.Acme, "admin2@acme.example", store.RoleAdmin)
+	member, _ := e.AddMember(e.Acme, "member2@acme.example", store.RoleMember)
+	ownerID := e.Acme.Owner.ID
+
+	setRole := func(key, target, role string) *apitest.Response {
+		t.Helper()
+		return e.Do("PATCH", "/v1/members/"+target, key, map[string]string{"role": role})
+	}
+	// Only an owner may give the owner or admin role.
+	if r := setRole(keys[store.RoleAdmin], member.ID, "admin"); r.Code != http.StatusForbidden {
+		t.Fatalf("admin makes an admin: %s", r)
+	}
+	if r := setRole(keys[store.RoleAdmin], member.ID, "billing"); r.Code != http.StatusOK {
+		t.Fatalf("admin makes a billing member: %s", r)
+	}
+	// Only an owner may change an owner's or an admin's role.
+	if r := setRole(keys[store.RoleAdmin], admin.ID, "member"); r.Code != http.StatusForbidden {
+		t.Fatalf("admin demotes an admin: %s", r)
+	}
+	if r := setRole(keys[store.RoleAdmin], ownerID, "member"); r.Code != http.StatusForbidden {
+		t.Fatalf("admin demotes the owner: %s", r)
+	}
+	// A member may not change roles or remove anyone but themselves.
+	if r := setRole(keys[store.RoleMember], member.ID, "viewer"); r.Code != http.StatusForbidden {
+		t.Fatalf("member changes a role: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/members/"+admin.ID, keys[store.RoleMember], nil); r.Code != http.StatusForbidden {
+		t.Fatalf("member removes an admin: %s", r)
+	}
+	// Nobody changes their own role.
+	if r := setRole(e.Acme.Key, ownerID, "admin"); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("sole owner demotes self: %s", r)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+admin.ID, e.Acme.Key, map[string]string{"role": "owner"}, nil)
+	if r := setRole(e.Acme.Key, ownerID, "admin"); r.Code != http.StatusForbidden {
+		t.Fatalf("owner changes own role with two owners: %s", r)
+	}
+}
+
+// TestLastOwner checks that the organization keeps an owner, also when the owner removes themselves.
+func TestLastOwner(t *testing.T) {
+	e := apitest.New(t)
+	ownerID := e.Acme.Owner.ID
+	second, secondKey := e.AddMember(e.Acme, "second@acme.example", store.RoleOwner)
+
+	if r := e.Do("DELETE", "/v1/members/"+ownerID, e.Acme.Key, nil); r.Code != http.StatusNoContent {
+		t.Fatalf("owner leaves with another owner: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/members/"+second.ID, secondKey, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("sole owner leaves: %s", r)
+	}
+	if r := e.Do("PATCH", "/v1/members/"+second.ID, secondKey, map[string]string{"role": "member"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("sole owner demotes self: %s", r)
+	}
+	if _, ok := e.Store.Member(e.Acme.ID, second.ID); !ok {
+		t.Fatal("the sole owner was removed")
+	}
+}
+
+// TestLastOwnerConcurrent checks that two owners who demote each other at once cannot both succeed.
+func TestLastOwnerConcurrent(t *testing.T) {
+	e := apitest.New(t)
+	ownerID := e.Acme.Owner.ID
+	second, secondKey := e.AddMember(e.Acme, "second@acme.example", store.RoleOwner)
+	var wg sync.WaitGroup
+	codes := make([]int, 2)
+	for i, c := range []struct{ key, target string }{{e.Acme.Key, ownerID}, {secondKey, second.ID}} {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			codes[i] = e.Do("DELETE", "/v1/members/"+c.target, c.key, nil).Code
+		}()
+	}
+	wg.Wait()
+	if codes[0] == http.StatusNoContent && codes[1] == http.StatusNoContent {
+		t.Fatalf("both owners left: %v", codes)
+	}
+	owners := 0
+	for _, m := range e.Store.Members(e.Acme.ID) {
+		if m.Role == store.RoleOwner {
+			owners++
+		}
+	}
+	if owners != 1 {
+		t.Fatalf("owners = %d, codes %v", owners, codes)
+	}
+}
+
+func TestInviteGrantsRole(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	if r := e.Do("POST", "/v1/invites", keys[store.RoleAdmin], map[string]string{"email": "a@people.example", "role": "admin"}); r.Code != http.StatusForbidden {
+		t.Fatalf("admin invites an admin: %s", r)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "a@people.example", "role": "admin"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", keys[store.RoleAdmin], map[string]string{"email": "b@people.example", "role": "billing"}, nil)
+}
+
+func TestAPIKeyOwnership(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	var own store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", keys[store.RoleViewer], map[string]string{"name": "mine"}, &own)
+
+	var me struct {
+		User store.User `json:"user"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", keys[store.RoleViewer], nil, &me)
+	var viewerKeys struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", keys[store.RoleViewer], nil, &viewerKeys)
+	// The viewer's key from roleKeys and the one just made; nobody else's.
+	if len(viewerKeys.Items) != 2 {
+		t.Fatalf("a viewer sees %+v", viewerKeys.Items)
+	}
+	for _, k := range viewerKeys.Items {
+		if k.UserID != me.User.ID {
+			t.Fatalf("a viewer sees another member's key: %+v", k)
+		}
+	}
+	var ownerKeys struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, &ownerKeys)
+	if len(ownerKeys.Items) != 6 {
+		t.Fatalf("the owner sees %d keys, want all 6", len(ownerKeys.Items))
+	}
+
+	// A member may not revoke someone else's key, and nothing changes.
+	if r := e.Do("DELETE", "/v1/api-keys/"+own.ID, keys[store.RoleMember], nil); r.Code != http.StatusForbidden {
+		t.Fatalf("member revokes another's key: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", own.Token, nil, nil)
+	// An admin may revoke anyone's key in the organization.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+own.ID, keys[store.RoleAdmin], nil, nil)
+	if r := e.Do("GET", "/v1/org", own.Token, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("revoked key: %s", r)
+	}
+	// Anyone may revoke their own key, viewers included.
+	var mine store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", keys[store.RoleViewer], map[string]string{"name": "again"}, &mine)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+mine.ID, keys[store.RoleViewer], nil, nil)
+}
+
+func TestAnyoneMayLeave(t *testing.T) {
+	e := apitest.New(t)
+	user, key := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+user.ID, key, nil, nil)
+	if r := e.Do("GET", "/v1/me", key, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a member who left: %s", r)
+	}
+}
