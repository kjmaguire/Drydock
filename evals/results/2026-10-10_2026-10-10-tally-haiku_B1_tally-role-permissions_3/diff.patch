-// Package auth says who a request is and what they may do.
+// Package auth says who a request is and what they may do. The Can functions are the role table: each one is one row of it,
+// and each endpoint is guarded by the one for its row.
 package auth
 
-import "example.com/tally/internal/store"
+import (
+	"fmt"
+
+	"example.com/tally/internal/store"
+)
 
 // Principal is the member a request acts for: the owner of the API key it presented, in that key's organization, with the
 // member's current role.
@@ -12,8 +17,99 @@ type Principal struct {
 	Role   store.Role
 }
 
+// Forbidden is a refusal: the member's role may not make the change. Its text says why, for people.
+type Forbidden string
+
+func (f Forbidden) Error() string { return string(f) }
+
+// Anyone allows every role, viewers included.
+func Anyone(store.Role) bool { return true }
+
 // CanWrite reports whether a role may change anything. Viewers only read.
 func CanWrite(r store.Role) bool { return r != store.RoleViewer }
 
+// CanManageCustomers reports whether a role may create, update or delete customers.
+func CanManageCustomers(r store.Role) bool { return CanWrite(r) }
+
+// CanManageSubscriptions reports whether a role may create, update or cancel subscriptions and report usage.
+func CanManageSubscriptions(r store.Role) bool { return CanWrite(r) }
+
+// CanManagePlans reports whether a role may create or update plans.
+func CanManagePlans(r store.Role) bool {
+	return r == store.RoleOwner || r == store.RoleAdmin || r == store.RoleBilling
+}
+
+// CanManageInvoices reports whether a role may create, pay or void invoices.
+func CanManageInvoices(r store.Role) bool { return CanManagePlans(r) }
+
+// CanViewRevenue reports whether a role may read the revenue report.
+func CanViewRevenue(r store.Role) bool { return CanManagePlans(r) }
+
+// CanManageWebhooks reports whether a role may use webhook endpoints, their deliveries, and events.
+func CanManageWebhooks(r store.Role) bool { return CanManageTeam(r) }
+
 // CanManageTeam reports whether a role may manage the organization's settings, members and invites.
 func CanManageTeam(r store.Role) bool { return r == store.RoleOwner || r == store.RoleAdmin }
+
+// CanGrant reports whether a member with role actor may give someone the role. Only an owner may give owner or admin.
+func CanGrant(actor, role store.Role) bool {
+	if role == store.RoleOwner || role == store.RoleAdmin {
+		return actor == store.RoleOwner
+	}
+	return true
+}
+
+// CheckRoleChange says whether actor may change target's role to next. owners is how many owners the organization has. It
+// returns store.ErrLastOwner when the change would leave the organization without an owner, and a Forbidden otherwise.
+func CheckRoleChange(actor Principal, target store.Member, next store.Role, owners int) error {
+	self := actor.UserID == target.UserID
+	lastOwner := target.Role == store.RoleOwner && owners == 1
+	if !CanManageTeam(actor.Role) {
+		return Forbidden("only owners and admins manage members")
+	}
+	if lastOwner && next != store.RoleOwner && self {
+		return store.ErrLastOwner
+	}
+	if self {
+		return Forbidden("nobody may change their own role")
+	}
+	if (target.Role == store.RoleOwner || target.Role == store.RoleAdmin) && actor.Role != store.RoleOwner {
+		return Forbidden("only an owner may change the role of an owner or an admin")
+	}
+	if !CanGrant(actor.Role, next) {
+		return Forbidden("only an owner may give the owner or admin role")
+	}
+	if lastOwner && next != store.RoleOwner {
+		return store.ErrLastOwner
+	}
+	return nil
+}
+
+// CheckRemoval says whether actor may remove target from the organization. Anyone may leave, unless they are its only owner.
+// owners is how many owners the organization has. It returns store.ErrLastOwner or a Forbidden, as CheckRoleChange does.
+func CheckRemoval(actor Principal, target store.Member, owners int) error {
+	self := actor.UserID == target.UserID
+	lastOwner := target.Role == store.RoleOwner && owners == 1
+	if self {
+		if lastOwner {
+			return store.ErrLastOwner
+		}
+		return nil
+	}
+	if !CanManageTeam(actor.Role) {
+		return Forbidden("only owners and admins remove members")
+	}
+	if (target.Role == store.RoleOwner || target.Role == store.RoleAdmin) && actor.Role != store.RoleOwner {
+		return Forbidden(fmt.Sprintf("only an owner may remove an %s", target.Role))
+	}
+	if lastOwner {
+		return store.ErrLastOwner
+	}
+	return nil
+}
+
+// CanRevokeAPIKey reports whether actor may revoke a key that belongs to keyOwner: anyone may revoke their own keys, and owners
+// and admins may revoke anyone's.
+func CanRevokeAPIKey(actor Principal, keyOwner string) bool {
+	return actor.UserID == keyOwner || CanManageTeam(actor.Role)
+}
