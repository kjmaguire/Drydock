+package auth
+
+import (
+	"errors"
+	"testing"
+
+	"example.com/tally/internal/store"
+)
+
+func TestMemberRules(t *testing.T) {
+	const (
+		owner  = store.RoleOwner
+		admin  = store.RoleAdmin
+		member = store.RoleMember
+	)
+	// actor acts; target is the member they act on, a different person unless self is set.
+	actor := func(role store.Role, self bool) (Principal, store.Member) {
+		p := Principal{OrgID: "org", UserID: "actor", Role: role}
+		target := store.Member{OrgID: "org", UserID: "target", Role: member}
+		if self {
+			target.UserID = "actor"
+		}
+		return p, target
+	}
+	forbidden := func(err error) bool {
+		var f Forbidden
+		return errors.As(err, &f)
+	}
+	type row struct {
+		name   string
+		actor  store.Role
+		self   bool
+		from   store.Role // the target's role now
+		to     store.Role // the role they change to (role changes only)
+		owners int
+		want   string // "ok", "forbidden" or "last_owner"
+	}
+	role := []row{
+		{"owner makes admin", owner, false, member, admin, 1, "ok"},
+		{"owner makes owner", owner, false, member, owner, 1, "ok"},
+		{"admin makes member billing", admin, false, member, store.RoleBilling, 1, "ok"},
+		{"admin makes admin", admin, false, member, admin, 1, "forbidden"},
+		{"admin demotes admin", admin, false, admin, member, 1, "forbidden"},
+		{"admin demotes owner", admin, false, owner, member, 2, "forbidden"},
+		{"owner demotes admin", owner, false, admin, member, 1, "ok"},
+		{"owner demotes self with another owner", owner, true, owner, admin, 2, "forbidden"},
+		{"sole owner demotes self", owner, true, owner, admin, 1, "last_owner"},
+		{"sole owner keeps the role", owner, true, owner, owner, 1, "forbidden"},
+		{"member changes a role", member, false, member, admin, 1, "forbidden"},
+	}
+	for _, rw := range role {
+		p, target := actor(rw.actor, rw.self)
+		target.Role = rw.from
+		err := CheckRoleChange(p, target, rw.to, rw.owners)
+		if got := outcome(err, forbidden); got != rw.want {
+			t.Errorf("%s: %s, want %s (err %v)", rw.name, got, rw.want, err)
+		}
+	}
+
+	remove := []struct {
+		name   string
+		actor  store.Role
+		self   bool
+		from   store.Role
+		owners int
+		want   string
+	}{
+		{"anyone leaves", member, true, member, 1, "ok"},
+		{"viewer leaves", store.RoleViewer, true, store.RoleViewer, 1, "ok"},
+		{"sole owner leaves", owner, true, owner, 1, "last_owner"},
+		{"owner leaves with another owner", owner, true, owner, 2, "ok"},
+		{"member removes a member", member, false, member, 1, "forbidden"},
+		{"admin removes a member", admin, false, member, 1, "ok"},
+		{"admin removes an admin", admin, false, admin, 1, "forbidden"},
+		{"owner removes an admin", owner, false, admin, 2, "ok"},
+	}
+	for _, rw := range remove {
+		p, target := actor(rw.actor, rw.self)
+		target.Role = rw.from
+		err := CheckRemoval(p, target, rw.owners)
+		if got := outcome(err, forbidden); got != rw.want {
+			t.Errorf("%s: %s, want %s (err %v)", rw.name, got, rw.want, err)
+		}
+	}
+}
+
+func outcome(err error, forbidden func(error) bool) string {
+	switch {
+	case err == nil:
+		return "ok"
+	case errors.Is(err, store.ErrLastOwner):
+		return "last_owner"
+	case forbidden(err):
+		return "forbidden"
+	}
+	return "other: " + err.Error()
+}
+
+func TestCanGrant(t *testing.T) {
+	for _, c := range []struct {
+		actor, role store.Role
+		want        bool
+	}{
+		{store.RoleOwner, store.RoleOwner, true},
+		{store.RoleOwner, store.RoleAdmin, true},
+		{store.RoleAdmin, store.RoleAdmin, false},
+		{store.RoleAdmin, store.RoleBilling, true},
+		{store.RoleAdmin, store.RoleMember, true},
+	} {
+		if got := CanGrant(c.actor, c.role); got != c.want {
+			t.Errorf("CanGrant(%s, %s) = %v", c.actor, c.role, got)
+		}
+	}
+}
+
+func TestCanRevokeAPIKey(t *testing.T) {
+	member := Principal{UserID: "me", Role: store.RoleMember}
+	if !CanRevokeAPIKey(member, "me") || CanRevokeAPIKey(member, "someone") {
+		t.Fatal("a member revokes only their own keys")
+	}
+	if !CanRevokeAPIKey(Principal{UserID: "me", Role: store.RoleAdmin}, "someone") {
+		t.Fatal("an admin revokes anyone's key")
+	}
+}
