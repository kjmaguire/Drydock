+// checkTiers checks a metered plan's tiers: a valid mode, at least one tier, every up_to a positive whole number and strictly
+// ascending, and only the last tier without one. Amounts cannot be negative.
+func checkTiers(mode TiersMode, tiers []Tier) error {
+	if mode != Graduated && mode != Volume {
+		return fmt.Errorf("%w: tiers_mode is graduated or volume", ErrInvalidTiers)
+	}
+	if len(tiers) == 0 {
+		return fmt.Errorf("%w: a tiered plan needs at least one tier", ErrInvalidTiers)
+	}
+	var prev int64
+	for i, t := range tiers {
+		if t.UnitAmount < 0 || t.FlatAmount < 0 {
+			return fmt.Errorf("%w: a tier's amounts cannot be negative", ErrInvalidTiers)
+		}
+		last := i == len(tiers)-1
+		if t.UpTo == nil {
+			if !last {
+				return fmt.Errorf("%w: only the last tier can have no up_to", ErrInvalidTiers)
+			}
+			continue
+		}
+		if last {
+			return fmt.Errorf("%w: the last tier must have no up_to", ErrInvalidTiers)
+		}
+		if *t.UpTo <= prev {
+			return fmt.Errorf("%w: up_to must be a positive whole number, ascending", ErrInvalidTiers)
+		}
+		prev = *t.UpTo
+	}
+	return nil
+}
