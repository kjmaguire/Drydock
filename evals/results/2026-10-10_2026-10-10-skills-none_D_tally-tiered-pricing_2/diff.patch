+func TestTieredRenewalBillsOneLine(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	upTo := int64(100)
+	p, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, Interval: store.Monthly, UsageType: store.Metered,
+		TiersMode: store.Volume, Tiers: []store.Tier{{UpTo: &upTo, UnitAmount: 2}, {UnitAmount: 1, FlatAmount: 500}}}, e.Clock.Now())
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	start, end := sub.CurrentPeriodStart, sub.CurrentPeriodEnd
+	if _, err := e.Store.AddUsage(e.Acme.ID, sub.ID, 150, start, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(end)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	// 150 units fall in the unlimited tier under volume pricing: 150 * 1 + 500 flat.
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 1 || len(invs[0].Lines) != 1 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	if l := invs[0].Lines[0]; l.Quantity != 1 || l.UnitAmount != 650 || !strings.HasPrefix(l.Description, "API calls") {
+		t.Fatalf("line = %+v", l)
+	}
+	// The next period has no usage, so it is not invoiced.
+	e.Clock.Set(end.AddDate(0, 1, 0))
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("a period with no usage was invoiced: %+v", invs)
+	}
+}
