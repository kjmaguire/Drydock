@@ -0,0 +1,295 @@
+package subscriptions_test
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+	"example.com/tally/internal/subscriptions"
+)
+
+// subscribeWith starts a subscription of customer c to plan p with the given quantity, on c's default payment method.
+func subscribeWith(t *testing.T, e *apitest.Env, c store.Customer, p store.Plan, quantity int) store.Subscription {
+	t.Helper()
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: quantity})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+func setPaymentMethod(t *testing.T, e *apitest.Env, c store.Customer, pm string) {
+	t.Helper()
+	if _, err := e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = pm; return nil }); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func planOf(t *testing.T, e *apitest.Env, p store.Plan) store.Plan {
+	t.Helper()
+	p.OrgID = e.Acme.ID
+	if p.Interval == "" {
+		p.Interval = store.Monthly
+	}
+	if p.Currency == "" {
+		p.Currency = money.USD
+	}
+	created, err := e.Store.CreatePlan(p, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return created
+}
+
+func TestUpgradeIsProratedAndBilledAtOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setPaymentMethod(t, e, c, "pm_card_visa")
+	small := e.CreatePlan(e.Acme, "Small", "USD", "10.00")
+	big := e.CreatePlan(e.Acme, "Big", "USD", "30.00")
+	sub := subscribeWith(t, e, c, small, 1)
+
+	// 10 of the period's 31 days are gone: 21 days remain.
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &big.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != big.ID || got.Quantity != 1 || got.Status != store.Active || got.PendingPlanID != nil || got.PendingQuantity != nil {
+		t.Fatalf("upgraded = %+v", got)
+	}
+	if !got.CurrentPeriodStart.Equal(sub.CurrentPeriodStart) || !got.CurrentPeriodEnd.Equal(sub.CurrentPeriodEnd) {
+		t.Fatalf("the period changed: %+v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	pro := invs[1]
+	// Unused: 1000 * 21 / 31 = 677.4. Remaining: 3000 * 21 / 31 = 2032.3.
+	want := []store.Line{
+		{Description: "Unused time on Small", Quantity: 1, UnitAmount: -677},
+		{Description: "Remaining time on Big", Quantity: 1, UnitAmount: 2032},
+	}
+	if pro.Status != store.InvoicePaid || len(pro.Lines) != 2 || pro.Lines[0] != want[0] || pro.Lines[1] != want[1] {
+		t.Fatalf("proration invoice = %+v", pro)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[0].Amount != 1000 || cs[1].Amount != 1355 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
+
+func TestProrationRoundsHalfAwayFromZeroAndKeepsDiscount(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setPaymentMethod(t, e, c, "pm_card_visa")
+	a := planOf(t, e, store.Plan{Name: "A", UnitAmount: 1})
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: a.ID, Quantity: 1, DiscountPercent: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Exactly half the period is left, so each line is half a cent, which rounds away from zero to one cent. The change
+	// raises the value (quantity 1 to 2), so it is an upgrade.
+	e.Clock.Set(sub.CurrentPeriodStart.Add(sub.CurrentPeriodEnd.Sub(sub.CurrentPeriodStart) / 2))
+	qty := 2
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: &qty}); err != nil {
+		t.Fatal(err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	pro := invs[1]
+	if pro.DiscountPercent != 10 || pro.Lines[0].UnitAmount != -1 || pro.Lines[1].UnitAmount != 1 {
+		t.Fatalf("proration invoice = %+v", pro)
+	}
+}
+
+func TestUpgradeWithoutPaymentMethodStaysOpen(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	small := e.CreatePlan(e.Acme, "Small", "USD", "10.00")
+	big := e.CreatePlan(e.Acme, "Big", "USD", "30.00")
+	sub := subscribeWith(t, e, c, small, 1)
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &big.ID})
+	if err != nil || got.PlanID != big.ID || got.Status != store.Active {
+		t.Fatalf("upgrade = %+v, %v", got, err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoiceOpen || len(invs[1].Lines) != 2 {
+		t.Fatalf("invoices = %+v (the first has no payment method either: both stay open)", invs)
+	}
+}
+
+func TestDeclinedUpgradeAppliesAndIsPastDue(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	small := e.CreatePlan(e.Acme, "Small", "USD", "10.00")
+	big := e.CreatePlan(e.Acme, "Big", "USD", "30.00")
+	sub := subscribeWith(t, e, c, small, 1)
+	setPaymentMethod(t, e, c, "pm_card_declined")
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &big.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != big.ID || got.Status != store.PastDue {
+		t.Fatalf("declined upgrade = %+v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoiceOpen || len(invs[1].Lines) != 2 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+}
+
+func TestDowngradeWaitsForTheRenewal(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setPaymentMethod(t, e, c, "pm_card_visa")
+	small := e.CreatePlan(e.Acme, "Small", "USD", "10.00")
+	big := e.CreatePlan(e.Acme, "Big", "USD", "30.00")
+	sub := subscribeWith(t, e, c, big, 2)
+
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+	qty := 1
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &small.ID, Quantity: &qty})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != big.ID || got.Quantity != 2 || got.PendingPlanID == nil || *got.PendingPlanID != small.ID ||
+		got.PendingQuantity == nil || *got.PendingQuantity != 1 {
+		t.Fatalf("pending downgrade = %+v", got)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("a downgrade was invoiced: %+v", invs)
+	}
+
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.PlanID != small.ID || got.Quantity != 1 || got.PendingPlanID != nil || got.PendingQuantity != nil || got.Status != store.Active {
+		t.Fatalf("after the renewal = %+v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || len(invs[1].Lines) != 1 || invs[1].Lines[0].Quantity != 1 || invs[1].Lines[0].UnitAmount != 1000 ||
+		!strings.HasPrefix(invs[1].Lines[0].Description, "Small, ") {
+		t.Fatalf("renewal invoices = %+v", invs)
+	}
+}
+
+func TestBackToTheCurrentPlanClearsThePendingChange(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	small := e.CreatePlan(e.Acme, "Small", "USD", "10.00")
+	big := e.CreatePlan(e.Acme, "Big", "USD", "30.00")
+	sub := subscribeWith(t, e, c, big, 2)
+	qty := 1
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &small.ID, Quantity: &qty}); err != nil {
+		t.Fatal(err)
+	}
+	backQty := 2
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &big.ID, Quantity: &backQty})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PendingPlanID != nil || got.PendingQuantity != nil || got.PlanID != big.ID || got.Quantity != 2 {
+		t.Fatalf("after going back = %+v", got)
+	}
+}
+
+func TestEqualValueAppliesAtOnceWithoutBilling(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setPaymentMethod(t, e, c, "pm_card_visa")
+	small := e.CreatePlan(e.Acme, "Small", "USD", "10.00")
+	big := e.CreatePlan(e.Acme, "Big", "USD", "30.00")
+	sub := subscribeWith(t, e, c, small, 3)
+	qty := 1
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &big.ID, Quantity: &qty})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != big.ID || got.Quantity != 1 || got.PendingPlanID != nil {
+		t.Fatalf("equal-value change = %+v", got)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("an equal-value change was invoiced: %+v", invs)
+	}
+}
+
+func TestTrialingChangesAtOnceWithoutBilling(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	trial := planOf(t, e, store.Plan{Name: "Trial", UnitAmount: 1000, TrialDays: 14})
+	big := planOf(t, e, store.Plan{Name: "Big", UnitAmount: 3000})
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: trial.ID, Quantity: 1})
+	if err != nil || sub.Status != store.Trialing {
+		t.Fatalf("subscription = %+v, %v", sub, err)
+	}
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &big.ID})
+	if err != nil || got.PlanID != big.ID || got.Status != store.Trialing || got.PendingPlanID != nil {
+		t.Fatalf("trial upgrade = %+v, %v", got, err)
+	}
+	qty := 1
+	small := planOf(t, e, store.Plan{Name: "Small", UnitAmount: 500})
+	got, err = e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &small.ID, Quantity: &qty})
+	if err != nil || got.PlanID != small.ID || got.PendingPlanID != nil {
+		t.Fatalf("trial downgrade = %+v, %v", got, err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{}); len(invs) != 0 {
+		t.Fatalf("a trial change was invoiced: %+v", invs)
+	}
+}
+
+func TestIncompatiblePlansAreRefused(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	usd := planOf(t, e, store.Plan{Name: "USD", UnitAmount: 1000})
+	eur := planOf(t, e, store.Plan{Name: "EUR", Currency: money.EUR, UnitAmount: 1000})
+	yearly := planOf(t, e, store.Plan{Name: "Yearly", UnitAmount: 1000, Interval: store.Yearly})
+	metered := planOf(t, e, store.Plan{Name: "Metered", UnitAmount: 1, UsageType: store.Metered})
+	sub := subscribeWith(t, e, c, usd, 1)
+	for _, other := range []store.Plan{eur, yearly, metered} {
+		_, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &other.ID})
+		if !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+			t.Fatalf("change to %s: err = %v", other.Name, err)
+		}
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.PlanID != usd.ID || got.PendingPlanID != nil {
+		t.Fatalf("a refused change applied: %+v", got)
+	}
+}
+
+func TestUpgradeAfterThePeriodEndBillsNothing(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setPaymentMethod(t, e, c, "pm_card_visa")
+	small := e.CreatePlan(e.Acme, "Small", "USD", "10.00")
+	big := e.CreatePlan(e.Acme, "Big", "USD", "30.00")
+	sub := subscribeWith(t, e, c, small, 1)
+	// The period has ended but the renewal has not run yet: no time remains, so the prorated lines are zero.
+	e.Clock.Set(sub.CurrentPeriodEnd.Add(24 * time.Hour))
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &big.ID}); err != nil {
+		t.Fatal(err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Lines[0].UnitAmount != 0 || invs[1].Lines[1].UnitAmount != 0 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+}
