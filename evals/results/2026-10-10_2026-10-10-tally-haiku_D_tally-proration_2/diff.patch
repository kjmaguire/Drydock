+package api_test
+
+import (
+	"net/http"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func TestSubscriptionChangesAreProrated(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	small := e.CreatePlan(e.Acme, "Small", "USD", "10.00")
+	big := e.CreatePlan(e.Acme, "Big", "USD", "30.00")
+	euro := e.CreatePlan(e.Acme, "Euro", "EUR", "10.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": small.ID, "quantity": 1}, &sub)
+	if m := e.Do("GET", "/v1/subscriptions/"+sub.ID, e.Acme.Key, nil).Map(t); m["pending_plan_id"] != nil || m["pending_quantity"] != nil {
+		t.Fatalf("a new subscription has a pending change: %v", m)
+	}
+
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": big.ID}, &sub)
+	if sub.PlanID != big.ID || sub.PendingPlanID != nil {
+		t.Fatalf("upgrade = %+v", sub)
+	}
+	var invs struct{ Items []store.Invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 2 || len(invs.Items[1].Lines) != 2 || invs.Items[1].Lines[1].UnitAmount != 2032 {
+		t.Fatalf("invoices = %+v", invs.Items)
+	}
+
+	r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": small.ID, "quantity": 1})
+	if m := r.Map(t); r.Code != http.StatusOK || m["plan_id"] != big.ID || m["pending_plan_id"] != small.ID || m["pending_quantity"] != float64(1) {
+		t.Fatalf("downgrade: %s", r)
+	}
+
+	if r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": euro.ID}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "incompatible_plan" {
+		t.Fatalf("incompatible plan: %s", r)
+	}
+
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", e.Acme.Key, nil, &sub)
+	if r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"quantity": 2}); r.Code != http.StatusConflict {
+		t.Fatalf("change a canceled subscription: %s", r)
+	}
+}
