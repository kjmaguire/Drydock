+// prorationLines are the two lines of an upgrade's invoice: the unused time on the old plan as a credit, and the remaining
+// time on the new plan. Both are the share of the value that the rest of the current period is of its whole length.
+func prorationLines(from, to store.Plan, oldValue, newValue int64, remaining, length time.Duration) []store.Line {
+	left, whole := math.Max(remaining.Seconds(), 0), length.Seconds()
+	left = math.Min(left, whole)
+	unused := math.Round(float64(oldValue) * left / whole)
+	rest := math.Round(float64(newValue) * left / whole)
+	return []store.Line{
+		{Description: "Unused time on " + from.Name, Quantity: 1, UnitAmount: -int64(unused)},
+		{Description: "Remaining time on " + to.Name, Quantity: 1, UnitAmount: int64(rest)},
+	}
 }
 
