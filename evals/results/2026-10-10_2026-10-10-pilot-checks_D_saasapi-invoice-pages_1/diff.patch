+func TestInvoicePagesNeitherSkipNorRepeatWhenInvoicesArrive(t *testing.T) {
+	srv, st := newServer(t)
+	c, _ := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, time.Now())
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	ids := seedInvoices(t, st, c.ID, base, base, base.Add(time.Second), base.Add(time.Second), base.Add(2*time.Second))
+
+	p, _ := listPage(t, srv, "limit=2")
+	var got []string
+	for _, it := range p.Items {
+		got = append(got, it.ID)
+	}
+	// New invoices arrive between page requests: one at the last position's timestamp, others later.
+	ids = append(ids, seedInvoices(t, st, c.ID, base.Add(2*time.Second), base.Add(3*time.Second), base.Add(3*time.Second))...)
+	for cursor := p.NextCursor; cursor != ""; {
+		p, r := listPage(t, srv, "limit=2&cursor="+url.QueryEscape(cursor))
+		if r.Code != http.StatusOK {
+			t.Fatalf("page: %d %s", r.Code, r.Body)
+		}
+		for _, it := range p.Items {
+			got = append(got, it.ID)
+		}
+		cursor = p.NextCursor
+	}
+	if len(got) != len(ids) {
+		t.Fatalf("got %d invoices %v, want %d %v", len(got), got, len(ids), ids)
+	}
+	for i := range ids {
+		if got[i] != ids[i] {
+			t.Fatalf("position %d: got %s, want %s", i, got[i], ids[i])
+		}
+	}
+}
