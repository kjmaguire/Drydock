+func TestInvoicesPageInCreationOrderWithTheDefaultLimit(t *testing.T) {
+	srv, st := newServer(t)
+	c, _ := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, time.Now())
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	var at []time.Time
+	for i := 0; i < 45; i++ {
+		// Two invoices share each timestamp, so ties must be broken by ID.
+		at = append(at, base.Add(time.Duration(i/2)*time.Second))
+	}
+	seedInvoices(t, st, c.ID, at...)
+
+	p, r := listPage(t, srv, "")
+	if r.Code != http.StatusOK || len(p.Items) != 20 || p.NextCursor == "" {
+		t.Fatalf("first page: %d, %d items, cursor %q", r.Code, len(p.Items), p.NextCursor)
+	}
+	var want []string
+	for _, inv := range st.Invoices("acc_acme") {
+		want = append(want, inv.ID)
+	}
+	got := walkInvoices(t, srv, "20")
+	if len(got) != len(want) {
+		t.Fatalf("walked %d invoices, want %d", len(got), len(want))
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("position %d: got %s, want %s", i, got[i], want[i])
+		}
+	}
+	if p, _ := listPage(t, srv, "limit=100"); len(p.Items) != 45 || p.NextCursor != "" {
+		t.Fatalf("one page of 100: %d items, cursor %q", len(p.Items), p.NextCursor)
+	}
+}
