+// InvoicePosition is a place in the oldest-first order of invoices, named by an invoice's creation time and ID.
+type InvoicePosition struct {
+	CreatedAt time.Time
+	ID        string
+}
+
+// before reports whether p comes before q in the oldest-first order.
+func (p InvoicePosition) before(q InvoicePosition) bool {
+	if !p.CreatedAt.Equal(q.CreatedAt) {
+		return p.CreatedAt.Before(q.CreatedAt)
+	}
+	return p.ID < q.ID
+}
+
 // Invoices returns an account's invoices, oldest first (ties by ID).
 func (s *Store) Invoices(accountID string) []Invoice {
 	s.mu.Lock()
 	defer s.mu.Unlock()
+	return s.sortedInvoices(accountID)
+}
+
+// InvoicesAfter returns up to limit of an account's invoices that come after pos in the oldest-first
+// order, or from the first one when pos is nil. more reports whether any invoices follow the page.
+func (s *Store) InvoicesAfter(accountID string, pos *InvoicePosition, limit int) (page []Invoice, more bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	all := s.sortedInvoices(accountID)
+	start := 0
+	if pos != nil {
+		start = sort.Search(len(all), func(i int) bool { return pos.before(positionOf(all[i])) })
+	}
+	rest := all[start:]
+	if len(rest) > limit {
+		return rest[:limit], true
+	}
+	return rest, false
+}
