+// seedInvoices adds one invoice to acme's customer per entry of at, each created at its time.
+func seedInvoices(t *testing.T, st *store.Store, customerID string, at ...time.Time) []string {
+	t.Helper()
+	var ids []string
+	for _, when := range at {
+		inv, err := st.CreateInvoice(store.Invoice{AccountID: "acc_acme", CustomerID: customerID, Lines: []store.LineItem{{Description: "Pro plan", Quantity: 1, UnitCents: 100}}}, when)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
+
+type invoicePage struct {
+	Items []struct {
+		ID string `json:"id"`
+	} `json:"items"`
+	NextCursor string `json:"next_cursor"`
+}
+
+// listPage fetches one page of acme's invoices with the given query string and decodes it.
+func listPage(t *testing.T, srv *api.Server, query string) (invoicePage, *httptest.ResponseRecorder) {
+	t.Helper()
+	r := do(t, srv, "GET", "/api/invoices?"+query, "key-acme", "")
+	var p invoicePage
+	if r.Code == http.StatusOK {
+		if err := json.Unmarshal(r.Body.Bytes(), &p); err != nil {
+			t.Fatalf("page %s: %v", r.Body, err)
+		}
+	}
+	return p, r
+}
+
+// walkInvoices follows next_cursor from the first page until it is empty and returns every invoice ID in order.
+func walkInvoices(t *testing.T, srv *api.Server, limit string) []string {
+	t.Helper()
+	var ids []string
+	cursor := ""
+	for pages := 0; ; pages++ {
+		if pages > 1000 {
+			t.Fatal("paging does not end")
+		}
+		query := "limit=" + limit
+		if cursor != "" {
+			query += "&cursor=" + url.QueryEscape(cursor)
+		}
+		p, r := listPage(t, srv, query)
+		if r.Code != http.StatusOK {
+			t.Fatalf("list %s: %d %s", query, r.Code, r.Body)
+		}
+		for _, it := range p.Items {
+			ids = append(ids, it.ID)
+		}
+		if p.NextCursor == "" {
+			return ids
+		}
+		cursor = p.NextCursor
+	}
+}
