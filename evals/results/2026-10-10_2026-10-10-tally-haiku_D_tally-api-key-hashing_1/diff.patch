+// newAPIKeyToken returns an API key token: "tly_" followed by 40 random characters from [A-Za-z0-9].
+func newAPIKeyToken() string {
+	const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+	const n = 40
+	out := make([]byte, 0, n)
+	buf := make([]byte, 64)
+	for len(out) < n {
+		if _, err := rand.Read(buf); err != nil {
+			panic(err) // crypto/rand does not fail on supported platforms
+		}
+		for _, b := range buf {
+			// 248 is the largest multiple of 62 below 256, so every character is equally likely.
+			if b < 248 && len(out) < n {
+				out = append(out, alphabet[int(b)%len(alphabet)])
+			}
+		}
+	}
+	return "tly_" + string(out)
+}
+
+// hashToken returns the SHA-256 of a token, hex encoded. It is what the store keeps instead of the token.
+func hashToken(token string) string {
+	sum := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(sum[:])
+}
+
+// lastFour returns the last four characters of a token.
+func lastFour(token string) string {
+	return token[len(token)-4:]
+}
