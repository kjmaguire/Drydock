@@ -0,0 +1,53 @@
+package snapshot
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// A snapshot written before API keys were hashed holds the plain-text token. Loading it keeps the key working, and the
+// next snapshot must not contain the token.
+func TestLoadPlainTokenSnapshotThenSaveHashed(t *testing.T) {
+	const token = "tly_00000000000000000000000000000007"
+	now := time.Date(2026, 2, 1, 12, 0, 0, 0, time.UTC)
+	dir := t.TempDir()
+	old := filepath.Join(dir, "old.json")
+	body := `{"version": 2, "saved_at": "2026-01-01T00:00:00Z", "state": {"seq": 7, "api_keys": [` +
+		`{"id": "key_000007", "org_id": "org_000001", "user_id": "usr_000001", "name": "CI", "token": "` + token + `", "created_at": "2026-01-01T00:00:00Z"}` +
+		`]}}`
+	if err := os.WriteFile(old, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	st, err := Load(old)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if k, ok := st.APIKeyByToken(token); !ok || k.ID != "key_000007" {
+		t.Fatal("the key from the old snapshot does not work")
+	}
+
+	next := filepath.Join(dir, "next.json")
+	if err := Save(st, next, now); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), token) {
+		t.Fatal("the new snapshot contains the plain-text token")
+	}
+	if !strings.Contains(string(b), `"last4": "0007"`) || !strings.Contains(string(b), `"token_hash"`) {
+		t.Fatalf("the new snapshot does not hold the hash and last4:\n%s", b)
+	}
+	reloaded, err := Load(next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := reloaded.APIKeyByToken(token); !ok {
+		t.Fatal("the key does not work after the second reload")
+	}
+}
