+package api_test
+
+import (
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func TestAPIKeyTokenIsShownOnlyWhenCreated(t *testing.T) {
+	e := apitest.New(t)
+	var created map[string]any
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "CI"}, &created)
+	token, _ := created["token"].(string)
+	if !regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`).MatchString(token) {
+		t.Fatalf("token = %q", token)
+	}
+	if created["last4"] != token[len(token)-4:] {
+		t.Fatalf("last4 = %v for token %q", created["last4"], token)
+	}
+	if _, ok := created["token_hash"]; ok {
+		t.Fatal("the create answer shows the token's hash")
+	}
+
+	r := e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, nil)
+	if strings.Contains(r.String(), token) {
+		t.Fatalf("the list shows the token: %s", r)
+	}
+	var list struct {
+		Items []map[string]any `json:"items"`
+	}
+	r.JSON(t, &list)
+	if len(list.Items) != 2 {
+		t.Fatalf("keys = %+v", list.Items)
+	}
+	for _, k := range list.Items {
+		if _, ok := k["token"]; ok {
+			t.Fatalf("the list has a token field: %+v", k)
+		}
+		if _, ok := k["token_hash"]; ok {
+			t.Fatalf("the list has a token_hash field: %+v", k)
+		}
+		if _, ok := k["last4"]; !ok {
+			t.Fatalf("the list has no last4: %+v", k)
+		}
+	}
+}
+
+func TestInviteAcceptShowsTokenOnce(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"}, nil)
+	msgs := e.Mail.Messages()
+	if len(msgs) == 0 {
+		t.Fatal("no invite mail")
+	}
+	m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[0].Body)
+	if m == nil {
+		t.Fatalf("no link in %q", msgs[0].Body)
+	}
+	inviteToken, _ := url.QueryUnescape(m[1])
+	var accepted struct {
+		APIKey map[string]any `json:"api_key"`
+	}
+	r := e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": inviteToken, "name": "New Person"}, &accepted)
+	token, _ := accepted.APIKey["token"].(string)
+	if !strings.HasPrefix(token, "tly_") || len(token) != len("tly_")+40 {
+		t.Fatalf("accept answer = %s", r)
+	}
+	if strings.Count(r.String(), token) != 1 {
+		t.Fatalf("the token appears more than once in %s", r)
+	}
+	r = e.MustDo(http.StatusOK, "GET", "/v1/api-keys", token, nil, nil)
+	if strings.Contains(r.String(), token) {
+		t.Fatalf("the list shows the token: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", token, nil, nil)
+}
+
+func TestRemovedMemberKeyGets401(t *testing.T) {
+	e := apitest.New(t)
+	user, key := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	e.MustDo(http.StatusOK, "GET", "/v1/org", key, nil, nil)
+	if err := e.Store.RemoveMember(e.Acme.ID, user.ID); err != nil {
+		t.Fatal(err)
+	}
+	if r := e.Do("GET", "/v1/org", key, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("removed member's key: %s", r)
+	}
+}
