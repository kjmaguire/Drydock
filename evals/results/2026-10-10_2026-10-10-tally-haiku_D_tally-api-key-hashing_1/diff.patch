+package store
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+)
+
+var tokenFormat = regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`)
+
+func TestAPIKeyTokenIsHashedAtRest(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(a.ID, u.ID, RoleOwner, t0)
+
+	k, err := s.CreateAPIKey(a.ID, u.ID, "CI", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !tokenFormat.MatchString(k.Token) {
+		t.Fatalf("token %q does not match %s", k.Token, tokenFormat)
+	}
+	sum := sha256.Sum256([]byte(k.Token))
+	if k.TokenHash != hex.EncodeToString(sum[:]) {
+		t.Fatalf("token hash = %q", k.TokenHash)
+	}
+	if k.Last4 != k.Token[len(k.Token)-4:] {
+		t.Fatalf("last4 = %q for token %q", k.Last4, k.Token)
+	}
+
+	// The stored key and the snapshot carry the hash, never the token.
+	stored, ok := s.APIKey(a.ID, k.ID)
+	if !ok || stored.Token != "" || stored.TokenHash != k.TokenHash {
+		t.Fatalf("stored key = %+v", stored)
+	}
+	b, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), k.Token) {
+		t.Fatal("the snapshot contains the plain-text token")
+	}
+	if got, ok := s.APIKeyByToken(k.Token); !ok || got.ID != k.ID {
+		t.Fatal("the token does not authenticate")
+	}
+	if _, ok := s.APIKeyByToken(k.TokenHash); ok {
+		t.Fatal("the hash authenticates")
+	}
+}
+
+func TestAPIKeyTokensAreDistinct(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(a.ID, u.ID, RoleOwner, t0)
+	seen := map[string]bool{}
+	for range 50 {
+		k, _ := s.CreateAPIKey(a.ID, u.ID, "k", t0)
+		if seen[k.Token] {
+			t.Fatalf("token %q repeated", k.Token)
+		}
+		seen[k.Token] = true
+	}
+}
+
+func TestTouchAPIKeyWritesAtMostOncePerMinute(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(a.ID, u.ID, RoleOwner, t0)
+	k, _ := s.CreateAPIKey(a.ID, u.ID, "k", t0)
+
+	s.TouchAPIKey(k.ID, t0)
+	first, _ := s.APIKey(a.ID, k.ID)
+	if first.LastUsedAt == nil || !first.LastUsedAt.Equal(t0) {
+		t.Fatalf("first use = %v", first.LastUsedAt)
+	}
+	s.TouchAPIKey(k.ID, t0.Add(59*time.Second))
+	if got, _ := s.APIKey(a.ID, k.ID); !got.LastUsedAt.Equal(t0) {
+		t.Fatalf("a use 59s later changed last_used_at to %v", got.LastUsedAt)
+	}
+	s.TouchAPIKey(k.ID, t0.Add(60*time.Second))
+	if got, _ := s.APIKey(a.ID, k.ID); !got.LastUsedAt.Equal(t0.Add(60*time.Second)) {
+		t.Fatalf("a use 60s later left last_used_at at %v", got.LastUsedAt)
+	}
+}
+
+func TestLegacyPlainTokenIsHashedOnLoad(t *testing.T) {
+	const token = "tly_00000000000000000000000000000003"
+	s := New()
+	a := newOrg(t, s, "A")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(a.ID, u.ID, RoleOwner, t0)
+	st := s.Export()
+	st.APIKeys = []APIKey{{ID: "key_000009", OrgID: a.ID, UserID: u.ID, Name: "old", Token: token, CreatedAt: t0}}
+
+	s2, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s2.APIKeyByToken(token); !ok || got.ID != "key_000009" {
+		t.Fatal("the legacy key does not work")
+	}
+	saved := s2.Export().APIKeys
+	if len(saved) != 1 || saved[0].Token != "" || saved[0].TokenHash == "" || saved[0].Last4 != "0003" {
+		t.Fatalf("after load = %+v", saved)
+	}
+	b, _ := json.Marshal(s2.Export())
+	if strings.Contains(string(b), token) {
+		t.Fatal("the next snapshot contains the legacy plain-text token")
+	}
+}
