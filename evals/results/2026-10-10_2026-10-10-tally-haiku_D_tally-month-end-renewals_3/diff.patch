+// AddInterval returns t moved forward by one billing interval: a month or a year. It is PeriodStart of period 1.
 func AddInterval(t time.Time, iv store.Interval) time.Time {
+	return PeriodStart(t, iv, 1)
+}
+
+// PeriodStart returns the start of period n (n = 0, 1, 2, ...) of a subscription whose anchor is anchor: n intervals after
+// the anchor, on the anchor's day of the month or on the last day of that month when it is shorter, at the anchor's time of
+// day. Times are UTC. It counts from the anchor, not from the previous period, so a short month never moves later periods.
+func PeriodStart(anchor time.Time, iv store.Interval, n int) time.Time {
+	anchor = anchor.UTC()
+	months := n
+	if iv == store.Yearly {
+		months = 12 * n
+	}
+	first := time.Date(anchor.Year(), anchor.Month()+time.Month(months), 1, 0, 0, 0, 0, time.UTC)
+	day := min(anchor.Day(), daysIn(first))
+	return time.Date(first.Year(), first.Month(), day, anchor.Hour(), anchor.Minute(), anchor.Second(), anchor.Nanosecond(), time.UTC)
+}
+
+// NextBoundary returns the first period start after t, for a subscription whose anchor is anchor. A period that ends at t
+// is followed by the period that starts at NextBoundary(anchor, iv, t), so each period ends where the next one starts.
+func NextBoundary(anchor time.Time, iv store.Interval, t time.Time) time.Time {
+	anchor, t = anchor.UTC(), t.UTC()
+	unit := 1
 	if iv == store.Yearly {
-		return t.AddDate(1, 0, 0)
+		unit = 12
 	}
-	return t.AddDate(0, 1, 0)
+	// Begin one interval early: the boundary there is never after t, so no later boundary is skipped.
+	n := max(monthsBetween(anchor, t)/unit-1, 0)
+	for {
+		if b := PeriodStart(anchor, iv, n); b.After(t) {
+			return b
+		}
+		n++
+	}
+}
+
+// monthsBetween returns the number of calendar months from a to b, in UTC.
+func monthsBetween(a, b time.Time) int {
+	return (b.Year()-a.Year())*12 + int(b.Month()-a.Month())
+}
+
+// daysIn returns the number of days in the month of t.
+func daysIn(t time.Time) int {
+	return time.Date(t.Year(), t.Month()+1, 0, 0, 0, 0, 0, time.UTC).Day()
 }
