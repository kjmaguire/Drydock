+func TestSoftDeleteCustomer(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	jane, _ := s.CreateCustomer(a.ID, "Jane Doe", "jane@example.com", t0)
+	john, _ := s.CreateCustomer(a.ID, "John Roe", "john@example.com", t0.Add(time.Minute))
+	del := t0.Add(time.Hour)
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, del); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, del); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleting twice: %v", err)
+	}
+	if _, ok := s.Customer(a.ID, jane.ID); ok {
+		t.Fatal("deleted customer is still visible")
+	}
+	if _, ok := s.CustomerByID(jane.ID); ok {
+		t.Fatal("deleted customer is still visible by ID")
+	}
+	if got, ok := s.CustomerWithDeleted(a.ID, jane.ID); !ok || got.DeletedAt == nil || !got.DeletedAt.Equal(del) {
+		t.Fatalf("CustomerWithDeleted = %+v, %v", got, ok)
+	}
+	if got := s.Customers(a.ID); len(got) != 1 || got[0].ID != john.ID {
+		t.Fatalf("Customers = %+v", got)
+	}
+	if got := s.CustomersWithDeleted(a.ID); len(got) != 2 || got[0].ID != jane.ID {
+		t.Fatalf("CustomersWithDeleted = %+v", got)
+	}
+	if got := s.SearchCustomers(a.ID, "jane"); len(got) != 0 {
+		t.Fatalf("SearchCustomers finds the deleted customer: %+v", got)
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); ok {
+		t.Fatal("FindCustomerByEmail finds the deleted customer")
+	}
+	if _, err := s.UpdateCustomer(a.ID, jane.ID, func(c *Customer) error { c.Name = "Changed"; return nil }); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("updating a deleted customer: %v", err)
+	}
+	if err := s.DeleteCustomer(a.ID, jane.ID); err != nil {
+		t.Fatalf("removing a deleted customer outright: %v", err)
+	}
+	if _, ok := s.CustomerWithDeleted(a.ID, jane.ID); ok {
+		t.Fatal("removed customer is still there")
+	}
+
+	// Its email address is free again.
+	again, err := s.CreateCustomer(a.ID, "Jane Again", "JANE@example.com", t0)
+	if err != nil {
+		t.Fatalf("email of a deleted customer is not free: %v", err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, again.ID, del); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateCustomer(a.ID, "Jane Third", "jane@example.com", t0); err != nil {
+		t.Fatalf("email of a deleted customer is not free: %v", err)
+	}
+}
