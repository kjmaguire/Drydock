+func TestDeleteAndRestoreCustomer(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane Doe", "jane@example.com")
+	john := e.CreateCustomer(e.Acme, "John Roe", "john@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var inv struct {
+		ID       string `json:"id"`
+		Customer *struct {
+			ID, Name, Email string
+			Deleted         bool
+		} `json:"customer"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": jane.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 500}}}, &inv)
+
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil, nil)
+	if n := len(e.Store.Events(e.Acme.ID, "customer.deleted")); n != 1 {
+		t.Fatalf("customer.deleted events = %d", n)
+	}
+	for _, c := range []struct {
+		method string
+		body   any
+	}{{"GET", nil}, {"PATCH", map[string]string{"name": "Changed"}}, {"DELETE", nil}} {
+		if r := e.Do(c.method, "/v1/customers/"+jane.ID, e.Acme.Key, c.body); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+			t.Fatalf("%s on a deleted customer: %s", c.method, r)
+		}
+	}
+	if r := e.Do("POST", "/v1/customers/"+john.ID+"/restore", e.Acme.Key, nil); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("restoring a customer that is not deleted: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("deleting twice: %s", r)
+	}
+
+	var page struct {
+		Items []store.Customer `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", e.Acme.Key, nil, &page)
+	if len(page.Items) != 1 || page.Items[0].ID != john.ID {
+		t.Fatalf("list = %+v", page.Items)
+	}
+	page.Items = nil
+	e.MustDo(http.StatusOK, "GET", "/v1/customers?q=jane", e.Acme.Key, nil, &page)
+	if len(page.Items) != 0 {
+		t.Fatalf("search finds the deleted customer: %+v", page.Items)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers?email=jane@example.com", e.Acme.Key, nil, &page)
+	if len(page.Items) != 0 {
+		t.Fatalf("email lookup finds the deleted customer: %+v", page.Items)
+	}
+	rows, err := csv.NewReader(strings.NewReader(string(e.MustDo(http.StatusOK, "GET", "/v1/customers/export.csv", e.Acme.Key, nil, nil).Body))).ReadAll()
+	if err != nil || len(rows) != 2 || rows[1][0] != john.ID {
+		t.Fatalf("csv = %v, %v", rows, err)
+	}
+
+	if r := e.Do("POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": jane.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "x", "quantity": 1, "unit_amount": 1}}}); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("invoice for a deleted customer: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": jane.ID, "plan_id": p.ID}); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("subscription for a deleted customer: %s", r)
+	}
+
+	// Its invoice still names it, marked as deleted.
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &inv)
+	if inv.Customer == nil || inv.Customer.ID != jane.ID || inv.Customer.Name != "Jane Doe" || !inv.Customer.Deleted {
+		t.Fatalf("invoice customer = %+v", inv.Customer)
+	}
+	var raw struct {
+		Customer map[string]any `json:"customer"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &raw)
+	if len(raw.Customer) != 4 || raw.Customer["deleted"] != true {
+		t.Fatalf("invoice customer JSON = %v", raw.Customer)
+	}
+	var invs struct {
+		Items []struct {
+			Customer map[string]any `json:"customer"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?customer_id="+jane.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 1 || invs.Items[0].Customer["deleted"] != true {
+		t.Fatalf("invoice list = %+v", invs)
+	}
+
+	// Its email address is free again, and restoring it then conflicts.
+	again := e.CreateCustomer(e.Acme, "Jane Again", "jane@example.com")
+	if r := e.Do("POST", "/v1/customers/"+jane.ID+"/restore", e.Acme.Key, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "email_taken" {
+		t.Fatalf("restore over another customer's email: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+again.ID, e.Acme.Key, nil, nil)
+	var restored store.Customer
+	e.MustDo(http.StatusOK, "POST", "/v1/customers/"+jane.ID+"/restore", e.Acme.Key, nil, &restored)
+	if restored.ID != jane.ID || restored.Email != "jane@example.com" || restored.DeletedAt != nil {
+		t.Fatalf("restored = %+v", restored)
+	}
+	if n := len(e.Store.Events(e.Acme.ID, "customer.updated")); n == 0 {
+		t.Fatal("restoring sent no customer.updated event")
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers/"+jane.ID, e.Acme.Key, nil, &restored)
+	if r := e.Do("GET", "/v1/customers/"+jane.ID, e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("restored customer seen by another org: %s", r)
+	}
+
+	// Restoring works up to 30 days after a deletion; after that the customer is purged, and its invoice names no one.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil, nil)
+	e.Clock.Advance(30 * 24 * time.Hour)
+	if r := e.Do("POST", "/v1/customers/"+jane.ID+"/restore", e.Acme.Key, nil); r.Code != http.StatusOK {
+		t.Fatalf("restore at 30 days: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil, nil)
+	e.Clock.Advance(31 * 24 * time.Hour)
+	if r := e.Do("POST", "/v1/customers/"+jane.ID+"/restore", e.Acme.Key, nil); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("restore at 31 days: %s", r)
+	}
+	if n := e.Store.PurgeDeletedCustomers(e.Clock.Now()); n != 2 { // jane, and again, deleted above
+		t.Fatalf("purged %d customers, want 2", n)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &inv)
+	if inv.Customer != nil {
+		t.Fatalf("invoice of a purged customer names it: %+v", inv.Customer)
+	}
+}
+
+func TestDeleteCustomerWithActiveSubscription(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": jane.ID, "plan_id": p.ID}, &sub)
+	r := e.Do("DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil)
+	if r.Code != http.StatusConflict || r.Map(t)["error"] != "has_active_subscriptions" {
+		t.Fatalf("delete with an active subscription: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers/"+jane.ID, e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil, nil)
+}
+
+// A customer's email is looked up within its own organization only.
+func TestCustomerEmailLookupStaysInOrganization(t *testing.T) {
+	e := apitest.New(t)
+	mine := e.CreateCustomer(e.Acme, "Acme Jane", "shared@example.com")
+	e.CreateCustomer(e.Globex, "Globex Jane", "shared@example.com")
+	var page struct {
+		Items []store.Customer `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers?email=shared@example.com", e.Acme.Key, nil, &page)
+	if len(page.Items) != 1 || page.Items[0].ID != mine.ID {
+		t.Fatalf("Acme's email lookup = %+v", page.Items)
+	}
+}
