+func TestUpgradeMidPeriodBillsTheRemainingTime(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	sub := subscribe(t, e, c, team, 1)
+
+	// 10 of the 31 days of the first period have passed: 21 days remain.
+	e.Clock.Advance(10 * 24 * time.Hour)
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &pro.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != pro.ID || got.Status != store.Active || got.PendingPlanID != nil || got.PendingQuantity != nil {
+		t.Fatalf("upgraded subscription = %+v", got)
+	}
+	if !got.CurrentPeriodStart.Equal(sub.CurrentPeriodStart) || !got.CurrentPeriodEnd.Equal(sub.CurrentPeriodEnd) {
+		t.Fatalf("the period changed: %+v", got)
+	}
+	invs := invoicesOf(e, sub)
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %+v, want the first and the proration", invs)
+	}
+	inv := invs[1]
+	want := []store.Line{
+		{Description: "Unused time on Team", Quantity: 1, UnitAmount: -1355}, // 2000 * 21/31 = 1354.84
+		{Description: "Remaining time on Pro", Quantity: 1, UnitAmount: 3387}, // 5000 * 21/31 = 3387.10
+	}
+	if len(inv.Lines) != 2 || inv.Lines[0] != want[0] || inv.Lines[1] != want[1] {
+		t.Fatalf("lines = %+v", inv.Lines)
+	}
+	if inv.Status != store.InvoicePaid || inv.SubscriptionID != sub.ID {
+		t.Fatalf("proration invoice = %+v", inv)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[1].Amount != 2032 || cs[1].PaymentMethod != "pm_card_visa" {
