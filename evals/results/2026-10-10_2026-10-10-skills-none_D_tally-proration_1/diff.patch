+// prorate bills an upgrade for the time left in the current period. The invoice credits the unused time on the old plan and
+// charges the remaining time on the new plan, each the share of the period that is left, rounded to a whole minor unit. It is
+// charged like any invoice and reports false when the charge was declined.
+func (s *Service) prorate(ctx context.Context, sub store.Subscription, from, to store.Plan, fromValue, toValue int64) (bool, error) {
+	now := s.Clock.Now()
+	length := int64(sub.CurrentPeriodEnd.Sub(sub.CurrentPeriodStart) / time.Second)
+	remaining := min(max(int64(sub.CurrentPeriodEnd.Sub(now)/time.Second), 0), length)
+	lines := []store.Line{
+		{Description: "Unused time on " + from.Name, Quantity: 1, UnitAmount: -money.Prorate(fromValue, remaining, length)},
+		{Description: "Remaining time on " + to.Name, Quantity: 1, UnitAmount: money.Prorate(toValue, remaining, length)},
+	}
+	inv, err := s.Store.CreateInvoice(store.Invoice{OrgID: sub.OrgID, CustomerID: sub.CustomerID, SubscriptionID: sub.ID, Currency: to.Currency,
+		Lines: lines, DiscountPercent: sub.DiscountPercent}, now)
+	if err != nil {
+		return false, err
+	}
+	return s.charge(ctx, sub, inv)
+}
