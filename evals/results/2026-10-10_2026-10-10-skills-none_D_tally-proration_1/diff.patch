+func TestPatchSubscriptionProration(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	eur := e.CreatePlan(e.Acme, "Team EUR", "EUR", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": team.ID}, &sub)
+	if m := e.Do("GET", "/v1/subscriptions/"+sub.ID, e.Acme.Key, nil).Map(t); m["pending_plan_id"] != nil || m["pending_quantity"] != nil {
+		t.Fatalf("a new subscription has pending changes: %v", m)
+	}
+
+	if r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": eur.ID}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "incompatible_plan" {
+		t.Fatalf("change to another currency: %s", r)
+	}
+
+	e.Clock.Advance(10 * 24 * time.Hour)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": pro.ID}, &sub)
+	if sub.PlanID != pro.ID || sub.PendingPlanID != nil {
+		t.Fatalf("upgrade = %+v", sub)
+	}
+	var invs struct{ Items []store.Invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 2 || invs.Items[1].Lines[1].UnitAmount != 3387 || invs.Items[1].Lines[0].UnitAmount != -1355 {
+		t.Fatalf("proration invoice = %+v", invs.Items)
+	}
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": team.ID}, &sub)
+	if sub.PlanID != pro.ID || sub.PendingPlanID == nil || *sub.PendingPlanID != team.ID || sub.PendingQuantity == nil || *sub.PendingQuantity != 1 {
+		t.Fatalf("downgrade = %+v", sub)
+	}
+	if m := e.Do("GET", "/v1/subscriptions/"+sub.ID, e.Acme.Key, nil).Map(t); m["pending_plan_id"] != team.ID || m["pending_quantity"] != float64(1) {
+		t.Fatalf("pending fields = %v", m)
+	}
+}
