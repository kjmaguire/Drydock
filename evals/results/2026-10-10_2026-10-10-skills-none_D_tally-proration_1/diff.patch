+func TestIncompatiblePlansAreRefused(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	now := e.Clock.Now()
+	eur, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "EUR", Currency: money.EUR, UnitAmount: 2000, Interval: store.Monthly}, now)
+	yearly, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Yearly", Currency: money.USD, UnitAmount: 2000, Interval: store.Yearly}, now)
+	metered, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Calls", Currency: money.USD, UnitAmount: 2, Interval: store.Monthly, UsageType: store.Metered}, now)
+	sub := subscribe(t, e, c, team, 1)
+
+	for _, p := range []store.Plan{eur, yearly, metered} {
+		if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &p.ID}); !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+			t.Fatalf("change to %s: err = %v", p.Name, err)
+		}
+	}
+	if got, _ := e.Store.Subscription(e.Acme.ID, sub.ID); got.PlanID != team.ID || got.Status != store.Active {
+		t.Fatalf("a refused change applied: %+v", got)
+	}
+}
