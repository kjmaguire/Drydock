+	got, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.PlanID != team.ID || got.Quantity != 1 || got.PendingPlanID != nil || got.PendingQuantity != nil || got.Status != store.Active {
+		t.Fatalf("after renewal = %+v", got)
+	}
+	invs := invoicesOf(e, sub)
+	if len(invs) != 2 || len(invs[1].Lines) != 1 || invs[1].Lines[0].UnitAmount != 2000 {
+		t.Fatalf("renewal invoices = %+v", invs)
+	}
+}
