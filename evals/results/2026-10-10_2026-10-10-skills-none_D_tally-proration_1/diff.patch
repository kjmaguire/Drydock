+func TestPendingDowngradeIsClearedByAnUpgradeOrByReturning(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub := subscribe(t, e, c, team, 3)
+
+	two := 2
+	if got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: &two}); err != nil || got.PendingQuantity == nil || *got.PendingQuantity != 2 || got.Quantity != 3 {
+		t.Fatalf("downgrade = %+v, %v", got, err)
+	}
+	back := 3
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: &back})
+	if err != nil || got.PendingPlanID != nil || got.PendingQuantity != nil || got.Quantity != 3 {
+		t.Fatalf("back to the current quantity = %+v, %v", got, err)
+	}
+
+	one := 1
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: &one}); err != nil {
+		t.Fatal(err)
+	}
+	five := 5
+	got, err = e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: &five})
+	if err != nil || got.PendingQuantity != nil || got.Quantity != 5 {
+		t.Fatalf("upgrade = %+v, %v", got, err)
+	}
+	if n := len(invoicesOf(e, sub)); n != 2 {
+		t.Fatalf("invoices = %d, want the first and the upgrade", n)
+	}
+}
