+	trial, err := e.Store.CreateSubscription(store.Subscription{OrgID: e.Acme.ID, CustomerID: c.ID, PlanID: basic.ID, Quantity: 1, Status: store.Trialing,
+		StartedAt: now, CurrentPeriodStart: now, CurrentPeriodEnd: now.AddDate(0, 0, 14)}, now)
