+		return fmt.Errorf("snapshot %s: version %d: %w", path, v, err)
+	}
+	s, err := store.FromState(st)
+	if err != nil {
+		return fmt.Errorf("snapshot %s: version %d: %w", path, v, err)
+	}
+	backup := fmt.Sprintf("%s.v%d.bak", path, v)
+	old, err := os.ReadFile(backup)
+	switch {
+	case err == nil && !bytes.Equal(old, b):
+		return fmt.Errorf("snapshot %s: %s exists and differs from the file; move it aside first", path, backup)
