+// Upgrade rewrites the snapshot at path as the current version. The original bytes are first copied to
+// "<path>.v<old version>.bak", for example tally.json.v2.bak. A file already at the current version is left alone, without
+// a backup. A file of a newer version fails with ErrUnsupportedVersion and is not touched.
+func Upgrade(path string) error {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	v, err := versionOf(b)
+	if err != nil {
+		return fmt.Errorf("snapshot %s: %w", path, err)
+	}
