+func TestUpgradeRefusesNewerVersions(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "tally.json")
+	future := []byte(`{"version": 4, "state": {}}` + "\n")
+	if err := os.WriteFile(path, future, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := Upgrade(path); !errors.Is(err, ErrUnsupportedVersion) {
+		t.Fatalf("err = %v", err)
+	}
+	if _, err := Load(path); !errors.Is(err, ErrUnsupportedVersion) {
+		t.Fatalf("Load err = %v", err)
+	}
+	if b, _ := os.ReadFile(path); !bytes.Equal(b, future) {
+		t.Fatal("Upgrade changed a file of a newer version")
+	}
+	if names := dirNames(t, dir); !reflect.DeepEqual(names, []string{"tally.json"}) {
+		t.Fatalf("files = %v", names)
+	}
+}
