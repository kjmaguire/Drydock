+// parseInvoiceNumber is the inverse of InvoiceNumber: it rejects anything InvoiceNumber would not have written.
+func parseInvoiceNumber(number string) (int, error) {
+	n, err := strconv.Atoi(strings.TrimPrefix(number, "INV-"))
