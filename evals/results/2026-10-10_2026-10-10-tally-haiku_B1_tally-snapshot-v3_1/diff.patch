+func TestInvoiceNumbers(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Joe", "joe@example.com", t0)
+	create := func(orgID, customerID string) Invoice {
+		t.Helper()
+		inv, err := s.CreateInvoice(Invoice{OrgID: orgID, CustomerID: customerID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	a1 := create(a.ID, ca.ID)
+	a2 := create(a.ID, ca.ID)
+	b1 := create(b.ID, cb.ID)
+	if a1.Number != "INV-000001" || a2.Number != "INV-000002" || b1.Number != "INV-000001" {
+		t.Fatalf("numbers = %s, %s, %s; want each organization numbered from 1", a1.Number, a2.Number, b1.Number)
+	}
+	if _, err := s.UpdateInvoice(a.ID, a1.ID, func(i *Invoice) error { i.Status = InvoiceVoid; i.Number = "INV-999999"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := s.Invoice(a.ID, a1.ID); got.Number != "INV-000001" {
+		t.Fatalf("UpdateInvoice changed the number to %s", got.Number)
+	}
+	if a3 := create(a.ID, ca.ID); a3.Number != "INV-000003" {
+		t.Fatalf("after voiding, the next number is %s; a voided number must not be reused", a3.Number)
+	}
+}
+
+func TestInvoiceNumbersSurviveExport(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	for i := 0; i < 2; i++ {
+		_, _ = s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+	}
+	st := s.Export()
+	if st.InvoiceNext[a.ID] != 3 {
+		t.Fatalf("InvoiceNext = %v", st.InvoiceNext)
+	}
+	// A stored counter that lags behind the invoices is raised past them.
+	st.InvoiceNext[a.ID] = 1
+	s2, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	next, _ := s2.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: []Line{{Description: "y", Quantity: 1, UnitAmount: 1}}}, t0)
+	if next.Number != "INV-000003" {
+		t.Fatalf("the next number after a reload is %s", next.Number)
+	}
+}
+
+func TestFromStateRejectsBadInvoiceNumbers(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	_, _ = s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+	good := s.Export()
+	for _, number := range []string{"", "INV-1", "in-000001", "INV-000000", "INV-0000001x"} {
+		st := good
+		st.Invoices = append([]Invoice(nil), good.Invoices...)
+		st.Invoices[0].Number = number
+		if _, err := FromState(st); !errors.Is(err, ErrInvalid) {
+			t.Fatalf("number %q was accepted: %v", number, err)
+		}
+	}
+	st := good
+	st.Invoices = append(append([]Invoice(nil), good.Invoices...), good.Invoices[0])
+	st.Invoices[1].ID = "in_999999"
+	if _, err := FromState(st); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("a repeated number was accepted: %v", err)
+	}
+}
