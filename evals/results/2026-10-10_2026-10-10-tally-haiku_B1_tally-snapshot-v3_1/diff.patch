+func TestUpgradeWillNotOverwriteADifferentBackup(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "tally.json")
+	copyFile(t, filepath.Join("testdata", "v2.json"), path)
+	original, _ := os.ReadFile(path)
+	backup := filepath.Join(dir, "tally.json.v2.bak")
+	other := []byte("someone else's backup")
+	if err := os.WriteFile(backup, other, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := Upgrade(path); err == nil {
+		t.Fatal("Upgrade replaced a backup it did not write")
+	}
+	if b, _ := os.ReadFile(backup); !bytes.Equal(b, other) {
+		t.Fatal("the existing backup changed")
+	}
+	if b, _ := os.ReadFile(path); !bytes.Equal(b, original) {
+		t.Fatal("the file changed although Upgrade failed")
+	}
+}
