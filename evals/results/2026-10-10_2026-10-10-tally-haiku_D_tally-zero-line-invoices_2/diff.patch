+func TestFreePlanInvoicesOneZeroLine(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	// A declined card would make the subscription past due if a charge were attempted.
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_declined"; return nil })
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Free", Currency: money.USD, Interval: store.Monthly}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 2})
+	if err != nil || sub.Status != store.Active {
+		t.Fatalf("subscription = %+v, %v", sub, err)
+	}
+	period := func(s store.Subscription) string {
+		return s.CurrentPeriodStart.Format("Jan 2, 2006") + " to " + s.CurrentPeriodEnd.Format("Jan 2, 2006")
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 1 || invs[0].Status != store.InvoicePaid || len(invs[0].Lines) != 1 {
+		t.Fatalf("first invoice = %+v", invs)
+	}
+	if l := invs[0].Lines[0]; l.Description != "Free, "+period(sub) || l.Quantity != 2 || l.UnitAmount != 0 {
+		t.Fatalf("first line = %+v", l)
+	}
+
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active {
+		t.Fatalf("after renewal = %+v", got)
+	}
+	invs = e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoicePaid || len(invs[1].Lines) != 1 {
+		t.Fatalf("renewal invoices = %+v", invs)
+	}
+	if l := invs[1].Lines[0]; l.Description != "Free, "+period(got) || l.Quantity != 2 || l.UnitAmount != 0 {
+		t.Fatalf("renewal line = %+v", l)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 0 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
