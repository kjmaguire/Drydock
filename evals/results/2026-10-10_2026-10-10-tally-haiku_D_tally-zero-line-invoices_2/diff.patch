+// An invoice without lines (a free plan's invoice, or a metered period's before it was skipped) used to panic in the
+// list and get answers.
+func TestInvoiceWithoutLines(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: money.USD}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var list struct {
+		Items []struct {
+			ID          string `json:"id"`
+			Description string `json:"description"`
+		}
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices", e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 || list.Items[0].ID != inv.ID || list.Items[0].Description != "" {
+		t.Fatalf("list = %+v", list)
+	}
+	var got struct {
+		ID          string `json:"id"`
+		Description string `json:"description"`
+		Total       int64  `json:"total"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &got)
+	if got.ID != inv.ID || got.Description != "" || got.Total != 0 {
+		t.Fatalf("get = %+v", got)
+	}
+	var paid struct {
+		Invoice store.Invoice `json:"invoice"`
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+inv.ID+"/pay", e.Acme.Key, nil, &paid)
+	if paid.Invoice.Status != store.InvoicePaid {
+		t.Fatalf("pay = %+v", paid)
+	}
+	if n := len(e.Gateway.Charges()); n != 0 {
+		t.Fatalf("%d charges for a zero invoice", n)
+	}
+	other := e.CreateCustomer(e.Acme, "Joe", "joe@example.com")
+	void, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: other.ID, Currency: money.USD}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var voided struct {
+		Description string `json:"description"`
+		Status      string `json:"status"`
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+void.ID+"/void", e.Acme.Key, nil, &voided)
+	if voided.Status != string(store.InvoiceVoid) || voided.Description != "" {
+		t.Fatalf("void = %+v", voided)
+	}
+}
