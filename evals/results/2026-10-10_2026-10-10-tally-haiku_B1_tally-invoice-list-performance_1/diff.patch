+// invoiceBefore is the order of invoice lists: oldest first, ties by ID.
+func invoiceBefore(a, b Invoice) bool {
+	if !a.CreatedAt.Equal(b.CreatedAt) {
+		return a.CreatedAt.Before(b.CreatedAt)
+	}
+	return a.ID < b.ID
+}
+
+// indexInvoice adds a stored invoice to its organization's list, at its place in list order. The caller holds the lock.
+// Invoices are normally created in order, so this is usually an append.
+func (s *Store) indexInvoice(inv Invoice) {
+	ids := s.invoiceIDs[inv.OrgID]
+	if n := len(ids); n == 0 || invoiceBefore(s.invoices[ids[n-1]], inv) {
+		s.invoiceIDs[inv.OrgID] = append(ids, inv.ID)
+		return
+	}
+	i := sort.Search(len(ids), func(i int) bool { return invoiceBefore(inv, s.invoices[ids[i]]) })
+	ids = append(ids, "")
+	copy(ids[i+1:], ids[i:])
+	ids[i] = inv.ID
+	s.invoiceIDs[inv.OrgID] = ids
+}
+
+// indexInvoices rebuilds every organization's list from the stored invoices. It is used when a store is loaded.
+func (s *Store) indexInvoices() {
+	s.invoiceIDs = map[string][]string{}
+	for id, inv := range s.invoices {
+		s.invoiceIDs[inv.OrgID] = append(s.invoiceIDs[inv.OrgID], id)
+	}
+	for _, ids := range s.invoiceIDs {
+		sort.Slice(ids, func(i, j int) bool { return invoiceBefore(s.invoices[ids[i]], s.invoices[ids[j]]) })
+	}
+}
