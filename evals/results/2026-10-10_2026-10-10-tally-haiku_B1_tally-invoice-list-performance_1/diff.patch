+package store
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+func ids(invs []Invoice) []string {
+	out := []string{}
+	for _, inv := range invs {
+		out = append(out, inv.ID)
+	}
+	return out
+}
+
+func TestInvoiceListIsInCreationOrderWhateverTheInsertOrder(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Bob", "bob@example.com", t0)
+	line := []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}
+	// Created out of time order: a back-dated invoice, and two at the same time.
+	times := []time.Time{t0.Add(2 * time.Minute), t0, t0.Add(time.Minute), t0.Add(time.Minute), t0.Add(3 * time.Minute)}
+	var all []Invoice
+	for _, at := range times {
+		inv, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.EUR, Lines: line}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		all = append(all, inv)
+	}
+	other, _ := s.CreateInvoice(Invoice{OrgID: b.ID, CustomerID: cb.ID, Currency: money.EUR, Lines: line}, t0)
+	if _, err := s.UpdateInvoice(a.ID, all[1].ID, func(i *Invoice) error { i.Status = InvoicePaid; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{all[1].ID, all[2].ID, all[3].ID, all[0].ID, all[4].ID}
+	if got := ids(s.ListInvoices(a.ID, InvoiceFilter{})); !reflect.DeepEqual(got, want) {
+		t.Fatalf("ListInvoices = %v, want %v (oldest first, ties by ID; not B's %s)", got, want, other.ID)
+	}
+	if got := ids(s.ListInvoices(a.ID, InvoiceFilter{Status: InvoicePaid})); !reflect.DeepEqual(got, want[:1]) {
+		t.Fatalf("paid invoices = %v", got)
+	}
+	if got := ids(s.ListInvoices(a.ID, InvoiceFilter{CustomerID: cb.ID})); len(got) != 0 {
+		t.Fatalf("another organization's customer's invoices = %v", got)
+	}
+	// Pages of two, from the start and after a cursor that is not an invoice.
+	page, more := s.InvoicesPage(a.ID, InvoiceFilter{}, time.Time{}, "", 2)
+	if !reflect.DeepEqual(ids(page), want[:2]) || !more {
+		t.Fatalf("first page = %v, more %v", ids(page), more)
+	}
+	page, more = s.InvoicesPage(a.ID, InvoiceFilter{}, page[1].CreatedAt, page[1].ID, 2)
+	if !reflect.DeepEqual(ids(page), want[2:4]) || !more {
+		t.Fatalf("second page = %v, more %v", ids(page), more)
+	}
+	page, more = s.InvoicesPage(a.ID, InvoiceFilter{}, page[1].CreatedAt, page[1].ID, 2)
+	if !reflect.DeepEqual(ids(page), want[4:]) || more {
+		t.Fatalf("last page = %v, more %v", ids(page), more)
+	}
+	page, more = s.InvoicesPage(a.ID, InvoiceFilter{}, t0.Add(90*time.Second), "zzz", 10)
+	if !reflect.DeepEqual(ids(page), []string{all[0].ID, all[4].ID}) || more {
+		t.Fatalf("after a time with no invoice = %v, more %v", ids(page), more)
+	}
+	page, more = s.InvoicesPage(a.ID, InvoiceFilter{Status: InvoiceOpen}, t0, all[1].ID, 10)
+	if !reflect.DeepEqual(ids(page), []string{all[2].ID, all[3].ID, all[0].ID, all[4].ID}) || more {
+		t.Fatalf("open invoices after the paid one = %v, more %v", ids(page), more)
+	}
+	if page, more := s.InvoicesPage(a.ID, InvoiceFilter{}, all[4].CreatedAt, all[4].ID, 10); len(page) != 0 || more {
+		t.Fatalf("after the last invoice = %v, more %v", ids(page), more)
+	}
+	if page, more := s.InvoicesPage(b.ID, InvoiceFilter{}, time.Time{}, "", 10); !reflect.DeepEqual(ids(page), []string{other.ID}) || more {
+		t.Fatalf("B's page = %v, more %v", ids(page), more)
+	}
+	// The order survives a snapshot.
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := s2.ListInvoices(a.ID, InvoiceFilter{}); !reflect.DeepEqual(ids(got), want) {
+		t.Fatalf("after FromState, ListInvoices = %v, want %v", ids(got), want)
+	}
+	// A new invoice goes into place too.
+	late, _ := s2.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.EUR, Lines: line}, t0.Add(time.Minute))
+	want = []string{all[1].ID, all[2].ID, all[3].ID, late.ID, all[0].ID, all[4].ID}
+	if got := ids(s2.ListInvoices(a.ID, InvoiceFilter{})); !reflect.DeepEqual(got, want) {
+		t.Fatalf("after a new invoice, ListInvoices = %v, want %v", got, want)
+	}
+}
+
+func TestInvoiceListManyInvoices(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	for i := 0; i < 500; i++ {
+		// Shuffle the creation times a little, so some inserts land in the middle.
+		at := t0.Add(time.Duration((i*37)%500) * time.Second)
+		if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: []Line{{Description: fmt.Sprint(i), Quantity: 1, UnitAmount: 1}}}, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	all := s.ListInvoices(a.ID, InvoiceFilter{})
+	for i := 1; i < len(all); i++ {
+		if !invoiceBefore(all[i-1], all[i]) {
+			t.Fatalf("invoice %d (%s) is not after invoice %d", i, all[i].ID, i-1)
+		}
+	}
+	var walked []string
+	var after Invoice
+	for {
+		page, more := s.InvoicesPage(a.ID, InvoiceFilter{}, after.CreatedAt, after.ID, 7)
+		for _, inv := range page {
+			walked = append(walked, inv.ID)
+		}
+		if !more {
+			break
+		}
+		after = page[len(page)-1]
+	}
+	if !reflect.DeepEqual(walked, ids(all)) {
+		t.Fatal("walking the pages gives a different list than ListInvoices")
+	}
+}
