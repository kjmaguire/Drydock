+package api_test
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sort"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+// invoiceCursor is the cursor the API gives out for an invoice: where a page starts after it.
+func invoiceCursor(inv store.Invoice) string {
+	b, _ := json.Marshal(map[string]any{"t": inv.CreatedAt, "id": inv.ID})
+	return base64.RawURLEncoding.EncodeToString(b)
+}
+
+// fillInvoices gives org customers customers and invoices invoices, a few of them paid, voided or of a subscription, in
+// creation order. Every third invoice shares its creation time with the one before it.
+func fillInvoices(t testing.TB, e *apitest.Env, org store.Org, customers, invoices int) ([]store.Customer, []store.Invoice) {
+	t.Helper()
+	now := apitest.Start
+	var cs []store.Customer
+	for i := 0; i < customers; i++ {
+		c, err := e.Store.CreateCustomer(org.ID, fmt.Sprintf("Customer %d", i), fmt.Sprintf("c%d@%s.example", i, org.Name), now)
+		if err != nil {
+			t.Fatal(err)
+		}
+		cs = append(cs, c)
+	}
+	var invs []store.Invoice
+	for i := 0; i < invoices; i++ {
+		at := now.Add(time.Duration(i/3) * time.Minute)
+		sub := ""
+		if i%10 == 0 {
+			sub = fmt.Sprintf("sub_%06d", i%300)
+		}
+		inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: org.ID, CustomerID: cs[(i*7)%len(cs)].ID, SubscriptionID: sub, Currency: money.USD,
+			Lines: []store.Line{{Description: fmt.Sprintf("Seats %d", i), Quantity: int64(1 + i%4), UnitAmount: int64(500 + i%900)}}}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		switch i % 4 {
+		case 1:
+			inv, _ = e.Store.UpdateInvoice(org.ID, inv.ID, func(x *store.Invoice) error { x.Status = store.InvoicePaid; x.PaidAt = &at; return nil })
+		case 3:
+			inv, _ = e.Store.UpdateInvoice(org.ID, inv.ID, func(x *store.Invoice) error { x.Status = store.InvoiceVoid; x.VoidedAt = &at; return nil })
+		}
+		invs = append(invs, inv)
+	}
+	return cs, invs
+}
+
+// listedIDs walks every page of a listing with the given limit and returns the IDs in order.
+func listedIDs(t testing.TB, e *apitest.Env, key, path string, limit int) []string {
+	t.Helper()
+	var ids []string
+	cursor := ""
+	for i := 0; i < 100000; i++ {
+		p := fmt.Sprintf("%s%slimit=%d", path, sep(path), limit)
+		if cursor != "" {
+			p += "&cursor=" + cursor
+		}
+		var page struct {
+			Items []struct {
+				ID string `json:"id"`
+			} `json:"items"`
+			NextCursor string `json:"next_cursor"`
+		}
+		e.MustDo(http.StatusOK, "GET", p, key, nil, &page)
+		for _, it := range page.Items {
+			ids = append(ids, it.ID)
+		}
+		if page.NextCursor == "" {
+			return ids
+		}
+		cursor = page.NextCursor
+	}
+	t.Fatal("the listing never ended")
+	return nil
+}
+
+func sep(path string) string {
+	for _, c := range path {
+		if c == '?' {
+			return "&"
+		}
+	}
+	return "?"
+}
+
+func TestInvoiceListPagesAreTheWholeListInOrder(t *testing.T) {
+	e := apitest.New(t)
+	cs, invs := fillInvoices(t, e, e.Acme.Org, 40, 300)
+	fillInvoices(t, e, e.Globex.Org, 5, 50)
+
+	// The expected order, worked out without the store's listing: creation time, then ID.
+	sorted := append([]store.Invoice(nil), invs...)
+	sort.Slice(sorted, func(i, j int) bool {
+		if !sorted[i].CreatedAt.Equal(sorted[j].CreatedAt) {
+			return sorted[i].CreatedAt.Before(sorted[j].CreatedAt)
+		}
+		return sorted[i].ID < sorted[j].ID
+	})
+	for _, c := range []struct {
+		query  string
+		keep   func(store.Invoice) bool
+		filter string
+	}{
+		{"", func(store.Invoice) bool { return true }, ""},
+		{"?customer_id=" + cs[3].ID, func(i store.Invoice) bool { return i.CustomerID == cs[3].ID }, ""},
+		{"?subscription_id=sub_000020", func(i store.Invoice) bool { return i.SubscriptionID == "sub_000020" }, ""},
+		{"?status=paid", func(i store.Invoice) bool { return i.Status == store.InvoicePaid }, ""},
+		{"?status=void", func(i store.Invoice) bool { return i.Status == store.InvoiceVoid }, ""},
+		{"?status=open&customer_id=" + cs[0].ID, func(i store.Invoice) bool { return i.Status == store.InvoiceOpen && i.CustomerID == cs[0].ID }, ""},
+	} {
+		var want []string
+		for _, inv := range sorted {
+			if c.keep(inv) {
+				want = append(want, inv.ID)
+			}
+		}
+		for _, limit := range []int{1, 7, 20, 100} {
+			got := listedIDs(t, e, e.Acme.Key, "/v1/invoices"+c.query, limit)
+			if fmt.Sprint(got) != fmt.Sprint(want) {
+				t.Fatalf("%s with limit %d: got %d invoices %v, want %d %v", c.query, limit, len(got), got, len(want), want)
+			}
+		}
+	}
+}
+
+func TestInvoiceListCursorsSurviveNewInvoices(t *testing.T) {
+	e := apitest.New(t)
+	cs, invs := fillInvoices(t, e, e.Acme.Org, 10, 30)
+
+	var first struct {
+		Items      []struct{ ID string } `json:"items"`
+		NextCursor string                `json:"next_cursor"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=10", e.Acme.Key, nil, &first)
+	if first.NextCursor == "" || len(first.Items) != 10 {
+		t.Fatalf("first page = %+v", first)
+	}
+	// Created after the first page: they come last. Created with a time before the cursor: they are behind it, so they
+	// never show up in this walk.
+	late, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: cs[0].ID, Currency: money.USD, Lines: []store.Line{{Description: "late", Quantity: 1, UnitAmount: 1}}}, apitest.Start.Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	early, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: cs[0].ID, Currency: money.USD, Lines: []store.Line{{Description: "early", Quantity: 1, UnitAmount: 1}}}, apitest.Start)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var rest []string
+	cursor := first.NextCursor
+	for cursor != "" {
+		var page struct {
+			Items      []struct{ ID string } `json:"items"`
+			NextCursor string                `json:"next_cursor"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=10&cursor="+cursor, e.Acme.Key, nil, &page)
+		for _, it := range page.Items {
+			rest = append(rest, it.ID)
+		}
+		cursor = page.NextCursor
+	}
+	var want []string
+	for _, inv := range invs[10:] {
+		want = append(want, inv.ID)
+	}
+	want = append(want, late.ID)
+	if fmt.Sprint(rest) != fmt.Sprint(want) {
+		t.Fatalf("the rest of the walk = %v, want %v (not %s, which is behind the cursor)", rest, want, early.ID)
+	}
+}
+
+// TestInvoiceListAtScale builds a large organization next to a busy one, and checks that a page answers quickly on
+// every kind of listing, first and deep in the list.
+func TestInvoiceListAtScale(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds 80,000 invoices")
+	}
+	e := apitest.New(t)
+	cs, invs := fillInvoices(t, e, e.Acme.Org, 5000, 60000)
+	fillInvoices(t, e, e.Globex.Org, 500, 20000)
+
+	deep := invoiceCursor(invs[30000])
+	for _, path := range []string{
+		"/v1/invoices",
+		"/v1/invoices?customer_id=" + cs[17].ID,
+		"/v1/invoices?subscription_id=sub_000020",
+		"/v1/invoices?status=open",
+		"/v1/invoices?status=void&customer_id=" + cs[17].ID,
+	} {
+		for _, p := range []string{path, path + sep(path) + "cursor=" + deep} {
+			p = p + sep(p) + "limit=20"
+			best := time.Hour
+			for run := 0; run < 3; run++ {
+				start := time.Now()
+				r := e.Do("GET", p, e.Acme.Key, nil)
+				if d := time.Since(start); d < best {
+					best = d
+				}
+				if r.Code != http.StatusOK {
+					t.Fatalf("GET %s: %s", p, r)
+				}
+			}
+			t.Logf("%v  %s", best, p)
+			if best > 100*time.Millisecond {
+				t.Errorf("GET %s took %v, want under 100ms", p, best)
+			}
+		}
+	}
+}
