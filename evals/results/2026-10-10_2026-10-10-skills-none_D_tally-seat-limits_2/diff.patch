+// Seats returns how many seats an organization uses. A member who is not a viewer uses a seat, and so does a pending
+// invite (neither accepted nor revoked) whose role is not viewer.
+func (s *Store) Seats(orgID string) (Seats, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	o, ok := s.orgs[orgID]
+	if !ok {
+		return Seats{}, false
+	}
+	return s.seatsLocked(orgID, o.Plan), true
+}
+
+// seatsLocked counts the seats of an organization on plan. The caller holds the lock.
+func (s *Store) seatsLocked(orgID string, plan OrgPlan) Seats {
+	used := 0
+	for _, m := range s.members {
+		if m.OrgID == orgID && m.Role != RoleViewer {
+			used++
+		}
+	}
+	for _, inv := range s.invites {
+		if inv.OrgID == orgID && inv.Role != RoleViewer && inv.AcceptedAt == nil && inv.RevokedAt == nil {
+			used++
+		}
+	}
+	st := Seats{Used: used}
+	if limit, ok := plan.SeatLimit(); ok {
+		st.Limit = &limit
+	}
+	return st
+}
+
+// fit returns a SeatLimitError unless n more seats fit within the limit.
+func (st Seats) fit(n int) error {
+	if st.Limit != nil && st.Used+n > *st.Limit {
+		return SeatLimitError{Limit: *st.Limit, Used: st.Used}
+	}
+	return nil
+}
