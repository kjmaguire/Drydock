+
+// wantBody fails unless the answer has the status and exactly the JSON body want.
+func wantBody(t *testing.T, r *apitest.Response, status int, want map[string]any) {
+	t.Helper()
+	if r.Code != status || !reflect.DeepEqual(r.Map(t), want) {
+		t.Fatalf("want %d %v, got %s", status, want, r)
+	}
+}
+
+// inviteAs invites email with role through the API and returns the invite.
