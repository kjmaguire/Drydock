+// acceptInvite accepts the invite that was emailed to address.
+func acceptInvite(t *testing.T, e *apitest.Env, address string) {
+	t.Helper()
+	for _, m := range e.Mail.Messages() {
+		g := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(m.Body)
+		if m.To == address && g != nil {
+			token, _ := url.QueryUnescape(g[1])
+			e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": address}, nil)
+			return
+		}
+	}
+	t.Fatalf("no invite emailed to %s", address)
+}
