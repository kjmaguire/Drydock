+// seatsOf is the organization's seats as GET /v1/org shows them.
+func seatsOf(t *testing.T, e *apitest.Env, key string) store.Seats {
+	t.Helper()
+	var o struct {
+		Seats store.Seats `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", key, nil, &o)
+	return o.Seats
