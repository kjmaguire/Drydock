+// checkSeats fails unless the organization uses used seats out of limit.
+func checkSeats(t *testing.T, e *apitest.Env, key string, used, limit int) {
+	t.Helper()
+	if s := seatsOf(t, e, key); s.Used != used || s.Limit == nil || *s.Limit != limit {
+		t.Fatalf("seats = %+v, want %d used of %d", s, used, limit)
+	}
