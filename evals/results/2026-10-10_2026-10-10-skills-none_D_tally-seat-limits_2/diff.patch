+func TestSeatLimits(t *testing.T) {
+	e := apitest.New(t)
+	acme := e.Acme.Key
+	// Acme is on the team plan (10 seats), and its owner uses one. Business is unlimited.
+	checkSeats(t, e, acme, 1, 10)
+	if s := seatsOf(t, e, e.Globex.Key); s.Limit != nil {
+		t.Fatalf("business seats = %+v, want no limit", s)
+	}
+
+	// Pending invites hold seats; viewers' invites do not.
+	a := inviteAs(t, e, acme, "a@acme.example", "member")
+	inviteAs(t, e, acme, "b@acme.example", "member")
+	c := inviteAs(t, e, acme, "c@acme.example", "member")
+	inviteAs(t, e, acme, "v@acme.example", "viewer")
+	checkSeats(t, e, acme, 4, 10)
+
+	// Four seats are in use, one more than the free plan has, so the downgrade is refused and nothing changes.
+	wantBody(t, e.Do("PATCH", "/v1/org", acme, map[string]string{"plan": "free"}), http.StatusConflict,
+		map[string]any{"error": "over_seat_limit", "limit": 3.0, "used": 4.0})
+	if o, _ := e.Store.Org(e.Acme.ID); o.Plan != store.OrgTeam {
+		t.Fatalf("plan = %s after a refused downgrade", o.Plan)
+	}
+
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+c.ID, acme, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", acme, map[string]string{"plan": "free"}, nil)
+	checkSeats(t, e, acme, 3, 3)
+
+	// At the free plan's limit, an invite for a seat is refused, and a viewer's invite is not.
+	wantBody(t, e.Do("POST", "/v1/invites", acme, map[string]string{"email": "d@acme.example", "role": "member"}), http.StatusPaymentRequired,
+		map[string]any{"error": "seat_limit_reached", "limit": 3.0, "used": 3.0})
+	inviteAs(t, e, acme, "w@acme.example", "viewer")
+	checkSeats(t, e, acme, 3, 3)
+
+	// Revoking an invite frees its seat, which a new invite takes. Accepting the pending invites never needs a seat.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+a.ID, acme, nil, nil)
+	inviteAs(t, e, acme, "d@acme.example", "member")
+	checkSeats(t, e, acme, 3, 3)
+	for _, address := range []string{"b@acme.example", "d@acme.example", "v@acme.example", "w@acme.example"} {
+		acceptInvite(t, e, address)
+	}
+	checkSeats(t, e, acme, 3, 3)
+
+	// Members now: the owner, b and d (members), v and w (viewers). A viewer who becomes a member needs a free seat.
+	v, _ := e.Store.UserByEmail("v@acme.example")
+	b, _ := e.Store.UserByEmail("b@acme.example")
+	wantBody(t, e.Do("PATCH", "/v1/members/"+v.ID, acme, map[string]string{"role": "member"}), http.StatusPaymentRequired,
+		map[string]any{"error": "seat_limit_reached", "limit": 3.0, "used": 3.0})
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+b.ID, acme, map[string]string{"role": "viewer"}, nil)
+	checkSeats(t, e, acme, 2, 3)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+v.ID, acme, map[string]string{"role": "member"}, nil)
+	checkSeats(t, e, acme, 3, 3)
+}
+
+func TestSeatLimitHoldsUnderConcurrentInvites(t *testing.T) {
+	e := apitest.New(t)
+	// Fill nine of the team plan's ten seats with the owner and eight pending invites. One seat is left.
+	for i := range 8 {
+		inviteAs(t, e, e.Acme.Key, fmt.Sprintf("p%d@acme.example", i), "member")
+	}
+	checkSeats(t, e, e.Acme.Key, 9, 10)
+
+	codes := make(chan int, 5)
+	var wg sync.WaitGroup
+	for i := range 5 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			codes <- e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": fmt.Sprintf("r%d@acme.example", i), "role": "member"}).Code
+		}()
+	}
+	wg.Wait()
+	close(codes)
+	created := 0
+	for code := range codes {
+		switch code {
+		case http.StatusCreated:
+			created++
+		case http.StatusPaymentRequired:
+		default:
+			t.Fatalf("unexpected status %d", code)
+		}
+	}
+	if created != 1 {
+		t.Fatalf("%d of 5 concurrent invites succeeded with one seat left, want 1", created)
+	}
+	checkSeats(t, e, e.Acme.Key, 10, 10)
+}
