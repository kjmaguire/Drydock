+func TestFreePlanInvoicesEachPeriodWithALine(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Free", Currency: money.USD, Interval: store.Monthly}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %d, want the first and the renewal", len(invs))
+	}
+	for _, inv := range invs {
+		if inv.Status != store.InvoicePaid || len(inv.Lines) != 1 || inv.Lines[0].Quantity != 4 || inv.Lines[0].UnitAmount != 0 || !strings.HasPrefix(inv.Lines[0].Description, "Free, ") {
+			t.Fatalf("invoice = %+v", inv)
+		}
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 0 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
