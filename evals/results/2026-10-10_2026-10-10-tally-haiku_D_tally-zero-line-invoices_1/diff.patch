+// TestInvoiceWithoutLines reproduces the incident: an invoice with no lines (stored before free plans got a line) made the
+// list and the get answer 500, because its description indexed the first line.
+func TestInvoiceWithoutLines(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: money.USD}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var list struct {
+		Items []struct {
+			ID          string `json:"id"`
+			Description string `json:"description"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices", e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 || list.Items[0].ID != inv.ID || list.Items[0].Description != "" {
+		t.Fatalf("invoices = %+v", list.Items)
+	}
+	var got struct {
+		Description string `json:"description"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &got)
+	if got.Description != "" {
+		t.Fatalf("invoice = %+v", got)
+	}
+	var paid struct {
+		Invoice struct {
+			Status store.InvoiceStatus `json:"status"`
+		} `json:"invoice"`
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+inv.ID+"/pay", e.Acme.Key, nil, &paid)
+	if paid.Invoice.Status != store.InvoicePaid || len(e.Gateway.Charges()) != 0 {
+		t.Fatalf("paid = %+v", paid)
+	}
+}
