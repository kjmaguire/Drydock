+// TestInvoiceListOrder checks the list order and paging when invoices are created out of time order and share creation times,
+// before and after the store is rebuilt from its state.
+func TestInvoiceListOrder(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	for i, at := range []time.Time{t0.Add(time.Hour), t0, t0.Add(2 * time.Hour), t0, t0.Add(time.Minute), t0.Add(time.Hour)} {
+		inv := Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: int64(i + 1)}}}
+		if _, err := s.CreateInvoice(inv, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	check := func(s *Store) {
+		t.Helper()
+		want := listOrder(s, a.ID)
+		if got := idsOf(s.ListInvoices(a.ID, InvoiceFilter{})); !reflect.DeepEqual(got, want) {
+			t.Fatalf("ListInvoices = %v, want %v", got, want)
+		}
+		var got []string
+		var after *InvoiceKey
+		for {
+			page, more := s.InvoicePage(a.ID, InvoiceFilter{}, after, 2)
+			got = append(got, idsOf(page)...)
+			if !more {
+				break
+			}
+			last := page[len(page)-1]
+			after = &InvoiceKey{CreatedAt: last.CreatedAt, ID: last.ID}
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Fatalf("pages of two list %v, want %v", got, want)
+		}
+	}
+	check(s)
+
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	check(s2)
+	if _, err := s2.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: []Line{{Description: "y", Quantity: 1, UnitAmount: 1}}}, t0.Add(90*time.Minute)); err != nil {
+		t.Fatal(err)
+	}
+	check(s2)
+}
