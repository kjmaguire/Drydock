+
+// InvoiceKey is an invoice's place in the list order: its creation time and ID.
+type InvoiceKey struct {
+	CreatedAt time.Time
+	ID        string
+}
+
+// less reports whether the key comes before inv in the list order.
+func (k InvoiceKey) less(inv Invoice) bool {
+	if !k.CreatedAt.Equal(inv.CreatedAt) {
+		return k.CreatedAt.Before(inv.CreatedAt)
+	}
+	return k.ID < inv.ID
+}
+
+// invoiceLess is the list order of invoices: oldest first, ties by ID. An invoice's creation time and ID never change, so its
+// place in the order never does.
+func invoiceLess(a, b Invoice) bool {
+	return InvoiceKey{CreatedAt: a.CreatedAt, ID: a.ID}.less(b)
+}
