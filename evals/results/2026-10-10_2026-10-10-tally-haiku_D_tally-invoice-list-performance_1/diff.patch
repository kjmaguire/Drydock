+// listOrder is the organization's invoice IDs in list order (oldest first, ties by ID), worked out from the exported state.
+func listOrder(s *Store, orgID string) []string {
+	var invs []Invoice
+	for _, inv := range s.Export().Invoices {
+		if inv.OrgID == orgID {
+			invs = append(invs, inv)
+		}
+	}
+	sort.Slice(invs, func(i, j int) bool {
+		if !invs[i].CreatedAt.Equal(invs[j].CreatedAt) {
+			return invs[i].CreatedAt.Before(invs[j].CreatedAt)
+		}
+		return invs[i].ID < invs[j].ID
+	})
+	out := []string{}
+	for _, inv := range invs {
+		out = append(out, inv.ID)
+	}
+	return out
+}
+
+func idsOf(invs []Invoice) []string {
+	out := []string{}
+	for _, inv := range invs {
+		out = append(out, inv.ID)
+	}
+	return out
+}
