+package api_test
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+// seedCustomers adds n customers to org through the store.
+func seedCustomers(t testing.TB, e *apitest.Env, org apitest.Org, n int) []store.Customer {
+	t.Helper()
+	out := make([]store.Customer, 0, n)
+	for i := 0; i < n; i++ {
+		c, err := e.Store.CreateCustomer(org.ID, fmt.Sprintf("Customer %d", i), fmt.Sprintf("%s%d@example.com", strings.ToLower(org.Name), i), e.Clock.Now())
+		if err != nil {
+			t.Fatal(err)
+		}
+		out = append(out, c)
+	}
+	return out
+}
+
+// seedInvoices adds n invoices to org through the store, to the customers in turn. Every third one is on a subscription,
+// every fourth is paid and every fifth is void. The clock moves every third invoice, so some share a creation time.
+func seedInvoices(t testing.TB, e *apitest.Env, org apitest.Org, customers []store.Customer, n int) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		if i%3 == 0 {
+			e.Clock.Advance(time.Second)
+		}
+		inv := store.Invoice{OrgID: org.ID, CustomerID: customers[i%len(customers)].ID, Currency: money.USD,
+			Lines: []store.Line{{Description: fmt.Sprintf("Seats %d", i), Quantity: int64(1 + i%4), UnitAmount: int64(1000 + i%700)}}}
+		if i%3 == 0 {
+			inv.SubscriptionID = fmt.Sprintf("sub_%d", i%6)
+		}
+		created, err := e.Store.CreateInvoice(inv, e.Clock.Now())
+		if err != nil {
+			t.Fatal(err)
+		}
+		status := store.InvoiceOpen
+		switch {
+		case i%5 == 4:
+			status = store.InvoiceVoid
+		case i%4 == 3:
+			status = store.InvoicePaid
+		}
+		if status != store.InvoiceOpen {
+			if _, err := e.Store.UpdateInvoice(org.ID, created.ID, func(x *store.Invoice) error { x.Status = status; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
+
+// listFilter is a query string for GET /v1/invoices (starting with "&", or empty) and the invoices it should match.
+type listFilter struct {
+	query string
+	match func(store.Invoice) bool
+}
+
+func listFilters(customerID string) []listFilter {
+	return []listFilter{
+		{"", func(store.Invoice) bool { return true }},
+		{"&customer_id=" + customerID, func(i store.Invoice) bool { return i.CustomerID == customerID }},
+		{"&subscription_id=sub_3", func(i store.Invoice) bool { return i.SubscriptionID == "sub_3" }},
+		{"&status=open", func(i store.Invoice) bool { return i.Status == store.InvoiceOpen }},
+		{"&status=void&customer_id=" + customerID, func(i store.Invoice) bool {
+			return i.Status == store.InvoiceVoid && i.CustomerID == customerID
+		}},
+	}
+}
+
+// oracle is the organization's invoices that match, oldest first, ties by ID, worked out from the store's full state rather than
+// from the code under test.
+func oracle(e *apitest.Env, orgID string, match func(store.Invoice) bool) []store.Invoice {
+	var out []store.Invoice
+	for _, inv := range e.Store.Export().Invoices {
+		if inv.OrgID == orgID && match(inv) {
+			out = append(out, inv)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// expectPage is the page of list that follows the invoice after (nil for the first page), and whether more follow it.
+func expectPage(list []store.Invoice, after *store.Invoice, limit int) ([]store.Invoice, bool) {
+	start := 0
+	if after != nil {
+		start = sort.Search(len(list), func(i int) bool {
+			return list[i].CreatedAt.After(after.CreatedAt) || (list[i].CreatedAt.Equal(after.CreatedAt) && list[i].ID > after.ID)
+		})
+	}
+	end := min(start+limit, len(list))
+	return list[start:end], end < len(list)
+}
+
+// cursorFor is the cursor the API gives out after inv.
+func cursorFor(inv store.Invoice) string {
+	b, _ := json.Marshal(map[string]any{"t": inv.CreatedAt, "id": inv.ID})
+	return base64.RawURLEncoding.EncodeToString(b)
+}
+
+type listPage struct {
+	Items      []map[string]any `json:"items"`
+	NextCursor string           `json:"next_cursor"`
+}
+
+// walk follows next_cursor from the first page to the last and returns every item in order.
+func walk(t testing.TB, e *apitest.Env, query string, limit int) []map[string]any {
+	t.Helper()
+	var items []map[string]any
+	cursor := ""
+	for {
+		path := fmt.Sprintf("/v1/invoices?limit=%d%s", limit, query)
+		if cursor != "" {
+			path += "&cursor=" + cursor
+		}
+		var page listPage
+		e.MustDo(http.StatusOK, "GET", path, e.Acme.Key, nil, &page)
+		items = append(items, page.Items...)
+		if page.NextCursor == "" {
+			return items
+		}
+		cursor = page.NextCursor
+	}
+}
+
+func itemIDs(items []map[string]any) []string {
+	ids := make([]string, len(items))
+	for i, it := range items {
+		ids[i] = it["id"].(string)
+	}
+	return ids
+}
+
+func invoiceIDs(invs []store.Invoice) []string {
+	ids := make([]string, len(invs))
+	for i, inv := range invs {
+		ids[i] = inv.ID
+	}
+	return ids
+}
+
+// TestListInvoicesPagesMatchTheOrder walks every filter with several page sizes and checks the items, their order and each
+// item's fields against the invoice's own page, and the errors.
+func TestListInvoicesPagesMatchTheOrder(t *testing.T) {
+	e := apitest.New(t)
+	acme := seedCustomers(t, e, e.Acme, 40)
+	seedInvoices(t, e, e.Acme, acme, 1000)
+	globex := seedCustomers(t, e, e.Globex, 10)
+	seedInvoices(t, e, e.Globex, globex, 300)
+
+	for _, f := range listFilters(acme[7].ID) {
+		want := oracle(e, e.Acme.ID, f.match)
+		for _, limit := range []int{3, 100} {
+			got := walk(t, e, f.query, limit)
+			if !reflect.DeepEqual(itemIDs(got), invoiceIDs(want)) {
+				t.Fatalf("filter %q, limit %d: %d items in order %v, want %d items in order %v", f.query, limit, len(got), itemIDs(got), len(want), invoiceIDs(want))
+			}
+		}
+		for _, it := range walk(t, e, f.query, 100) {
+			single := e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+it["id"].(string), e.Acme.Key, nil, nil)
+			var one map[string]any
+			single.JSON(t, &one)
+			if !reflect.DeepEqual(one, it) {
+				t.Fatalf("filter %q: the list shows %v, the invoice shows %v", f.query, it, one)
+			}
+		}
+	}
+
+	if got := walk(t, e, "&customer_id="+globex[0].ID, 100); len(got) != 0 {
+		t.Fatalf("another organization's customer lists %d invoices", len(got))
+	}
+	for _, path := range []string{"/v1/invoices?limit=0", "/v1/invoices?limit=101", "/v1/invoices?cursor=bad", "/v1/invoices?status=lost"} {
+		if r := e.Do("GET", path, e.Acme.Key, nil); r.Code != http.StatusBadRequest {
+			t.Fatalf("GET %s: %s", path, r)
+		}
+	}
+}
+
+// TestListInvoicesPagingSeesNewInvoices creates invoices between two pages: one at the cursor's time (sorting after it by
+// ID), one a second after it (in the middle of the rest), and one at the end. The rest of the walk must list them in place.
+func TestListInvoicesPagingSeesNewInvoices(t *testing.T) {
+	e := apitest.New(t)
+	acme := seedCustomers(t, e, e.Acme, 40)
+	seedInvoices(t, e, e.Acme, acme, 500)
+
+	var first listPage
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=7", e.Acme.Key, nil, &first)
+	if first.NextCursor == "" || len(first.Items) != 7 {
+		t.Fatalf("first page = %d items, next_cursor %q", len(first.Items), first.NextCursor)
+	}
+	last, _ := e.Store.InvoiceByID(first.Items[6]["id"].(string))
+	now := e.Clock.Now()
+
+	e.Clock.Set(last.CreatedAt)
+	if _, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: acme[0].ID, Currency: money.USD, Lines: []store.Line{{Description: "tie", Quantity: 1, UnitAmount: 1}}}, last.CreatedAt); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(last.CreatedAt.Add(time.Second))
+	if _, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: acme[1].ID, Currency: money.USD, Lines: []store.Line{{Description: "middle", Quantity: 1, UnitAmount: 1}}}, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(now.Add(time.Hour))
+	if _, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: acme[2].ID, Currency: money.USD, Lines: []store.Line{{Description: "last", Quantity: 1, UnitAmount: 1}}}, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+
+	var got []map[string]any
+	cursor := first.NextCursor
+	for cursor != "" {
+		var page listPage
+		e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=7&cursor="+cursor, e.Acme.Key, nil, &page)
+		got = append(got, page.Items...)
+		cursor = page.NextCursor
+	}
+	want, _ := expectPage(oracle(e, e.Acme.ID, func(store.Invoice) bool { return true }), &last, 1<<30)
+	if !reflect.DeepEqual(itemIDs(got), invoiceIDs(want)) {
+		t.Fatalf("after the first page, the walk lists %v, want %v", itemIDs(got), invoiceIDs(want))
+	}
+}
+
+// TestListInvoicesAtScale lists a 60,000-invoice organization, with 5,000 customers and another organization's invoices in
+// the store, on the first page and from the middle, with and without filters. Each answer must be the right page and take
+// well under 100 milliseconds (the best of three requests, so one slow moment on a busy machine does not fail it).
+func TestListInvoicesAtScale(t *testing.T) {
+	if testing.Short() {
+		t.Skip("seeds 65,000 invoices")
+	}
+	e := apitest.New(t)
+	acme := seedCustomers(t, e, e.Acme, 5000)
+	seedInvoices(t, e, e.Acme, acme, 60000)
+	globex := seedCustomers(t, e, e.Globex, 300)
+	seedInvoices(t, e, e.Globex, globex, 5000)
+
+	filters := listFilters(acme[1234].ID)
+	all := oracle(e, e.Acme.ID, filters[0].match)
+	mid := all[30000]
+	for _, f := range filters {
+		list := oracle(e, e.Acme.ID, f.match)
+		for _, after := range []*store.Invoice{nil, &mid} {
+			want, more := expectPage(list, after, 100)
+			path := "/v1/invoices?limit=100" + f.query
+			if after != nil {
+				path += "&cursor=" + cursorFor(*after)
+			}
+			best := time.Duration(1<<63 - 1)
+			var r *apitest.Response
+			for i := 0; i < 3; i++ {
+				start := time.Now()
+				r = e.Do("GET", path, e.Acme.Key, nil)
+				best = min(best, time.Since(start))
+			}
+			var page listPage
+			r.JSON(t, &page)
+			if r.Code != http.StatusOK || !reflect.DeepEqual(itemIDs(page.Items), invoiceIDs(want)) || (page.NextCursor != "") != more {
+				t.Fatalf("GET %s: %d, %d items, want %d", path, r.Code, len(page.Items), len(want))
+			}
+			if best >= 100*time.Millisecond {
+				t.Errorf("GET %s took %v, want well under 100ms", path, best)
+			}
+			t.Logf("GET %s: %v", path, best)
+		}
+	}
+}
