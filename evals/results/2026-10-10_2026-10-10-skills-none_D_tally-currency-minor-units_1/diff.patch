+func TestPlansInOtherDecimals(t *testing.T) {
+	e := apitest.New(t)
+	var p struct {
+		store.Plan
+		Price          string `json:"price"`
+		PriceFormatted string `json:"price_formatted"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "Pro", "currency": "JPY", "price": "1000", "interval": "month"}, &p)
+	if p.UnitAmount != 1000 || p.Price != "1000" || p.PriceFormatted != "¥1,000" {
+		t.Fatalf("JPY plan = %+v", p)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "Kuwait", "currency": "KWD", "price": "7", "interval": "month"}, &p)
+	if p.UnitAmount != 7000 || p.Price != "7.000" || p.PriceFormatted != "KWD 7.000" {
+		t.Fatalf("KWD plan = %+v", p)
+	}
+	for _, bad := range []map[string]any{
+		{"name": "X", "currency": "JPY", "price": "1.5", "interval": "month"},
+		{"name": "X", "currency": "KWD", "price": "1.2345", "interval": "month"},
+	} {
+		if r := e.Do("POST", "/v1/plans", e.Acme.Key, bad); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_amount" {
+			t.Fatalf("%v: %s", bad, r)
+		}
+	}
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	plan := e.CreatePlan(e.Acme, "Pro", "JPY", "1000")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": plan.ID, "quantity": 2}, &sub)
+	var invs struct {
+		Items []struct {
+			TotalFormatted string `json:"total_formatted"`
+		}
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?customer_id="+c.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 1 || invs.Items[0].TotalFormatted != "¥2,000" {
+		t.Fatalf("JPY invoices = %+v", invs.Items)
+	}
+}
