+}
+
+func TestPagingNeitherSkipsNorRepeatsInvoicesCreatedBetweenPages(t *testing.T) {
+	srv, st := newServer(t)
+	start := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	before := seedInvoices(t, st, start, 5)
+	first, cursor := getPage(t, srv, "limit=2")
+
+	// Created between the page requests: one sharing the newest timestamp, then three later ones.
+	same := seedInvoices(t, st, start.Add(4*time.Second), 1)
+	later := seedInvoices(t, st, start.Add(10*time.Second), 3)
+	want := append(append(append([]string{}, before...), same...), later...)
+
+	rest := walkPages(t, srv, "limit=2", cursor)
+	if got := append(first, rest...); !equalIDs(got, want) {
+		t.Fatalf("paging around new invoices:\n got %v\nwant %v", got, want)
+	}
+}
+
+func TestInvoicesAreOrderedByCreationTimeNotByID(t *testing.T) {
+	srv, st := newServer(t)
+	start := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	c, err := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, start)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var newestFirst []string
+	for i := 2; i >= 0; i-- {
+		inv, err := st.CreateInvoice(store.Invoice{AccountID: "acc_acme", CustomerID: c.ID, Lines: []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 100}}}, start.Add(time.Duration(i)*time.Second))
+		if err != nil {
+			t.Fatal(err)
+		}
+		newestFirst = append([]string{inv.ID}, newestFirst...)
+	}
+	// IDs were issued in the order the invoices were created, but times run backwards, so the oldest by time is last issued.
+	if got := walkPages(t, srv, "limit=1", ""); !equalIDs(got, newestFirst) {
+		t.Fatalf("got %v, want %v", got, newestFirst)
+	}
+}
+
+func equalIDs(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
