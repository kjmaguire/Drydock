+// pageBody is the part of a GET /api/invoices response the tests read.
+type pageBody struct {
+	Items []struct {
+		ID string `json:"id"`
+	} `json:"items"`
+	NextCursor string `json:"next_cursor"`
+}
+
+// seedInvoices gives acc_acme a customer and n invoices, one per second from start, and returns their IDs in order.
+func seedInvoices(t *testing.T, st *store.Store, start time.Time, n int) []string {
+	t.Helper()
+	c, err := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, start)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ids []string
+	for i := 0; i < n; i++ {
+		inv, err := st.CreateInvoice(store.Invoice{AccountID: "acc_acme", CustomerID: c.ID, Lines: []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 100}}}, start.Add(time.Duration(i)*time.Second))
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
+
+// getPage fetches one page of acc_acme's invoices and returns its IDs and next cursor.
+func getPage(t *testing.T, h http.Handler, query string) ([]string, string) {
+	t.Helper()
+	r := do(t, h, "GET", "/api/invoices?"+query, "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("list %q: %d %s", query, r.Code, r.Body)
+	}
+	var p pageBody
+	if err := json.Unmarshal(r.Body.Bytes(), &p); err != nil {
+		t.Fatal(err)
+	}
+	var ids []string
+	for _, it := range p.Items {
+		ids = append(ids, it.ID)
+	}
+	return ids, p.NextCursor
+}
+
+// walkPages follows next_cursor from start (empty for the first page) until the last page and returns every ID seen,
+// in order. query holds the other parameters.
+func walkPages(t *testing.T, h http.Handler, query, start string) []string {
+	t.Helper()
+	var all []string
+	for cursor := start; ; {
+		q := query
+		if cursor != "" {
+			q += "&cursor=" + cursor
+		}
+		ids, next := getPage(t, h, q)
+		all = append(all, ids...)
+		if next == "" {
+			return all
+		}
+		if len(all) > 1000 {
+			t.Fatal("paging does not end")
+		}
+		cursor = next
+	}
+}
+
+func TestInvoicesArePagedInCreationOrder(t *testing.T) {
+	srv, st := newServer(t)
+	want := seedInvoices(t, st, time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC), 25)
+	if got := walkPages(t, srv, "limit=7", ""); !equalIDs(got, want) {
+		t.Fatalf("walk with limit 7:\n got %v\nwant %v", got, want)
+	}
+	if got := walkPages(t, srv, "", ""); !equalIDs(got, want) {
+		t.Fatalf("walk with the default limit:\n got %v\nwant %v", got, want)
+	}
+}
+
+func TestThePageSizeDefaultsToTwentyAndNextCursorIsEmptyOnTheLastPage(t *testing.T) {
+	srv, st := newServer(t)
