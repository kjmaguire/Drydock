+// Position is a place in an account's invoice list: an invoice's creation time and ID.
+type Position struct {
+	CreatedAt time.Time
+	ID        string
+}
+
+// InvoicePage returns up to limit of an account's invoices in the same order as Invoices. With after set, the page
+// starts just past that position, so invoices created later sort after it and are never skipped or repeated.
+func (s *Store) InvoicePage(accountID string, after *Position, limit int) []Invoice {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Invoice{}
+	for _, inv := range s.invoices {
+		if inv.AccountID != accountID {
+			continue
+		}
+		if after != nil && !before(after.CreatedAt, after.ID, inv.CreatedAt, inv.ID) {
+			continue
+		}
+		out = append(out, inv)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		return before(out[i].CreatedAt, out[i].ID, out[j].CreatedAt, out[j].ID)
+	})
+	if len(out) > limit {
+		out = out[:limit]
+	}
+	return out
+}
+
+// before reports whether the position (atA, idA) comes before (atB, idB) in creation order. It compares wall-clock
+// nanoseconds, so a time read from a cursor orders the same as the stored time it came from.
+func before(atA time.Time, idA string, atB time.Time, idB string) bool {
+	if a, b := atA.UnixNano(), atB.UnixNano(); a != b {
+		return a < b
+	}
+	return idA < idB
+}
