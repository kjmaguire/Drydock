+const (
+	defaultPageLimit = 20
+	maxPageLimit     = 100
+)
+
+// listInvoices returns one page of the account's invoices, oldest first. next_cursor is empty on the last page.
 func (s *Server) listInvoices(w http.ResponseWriter, r *http.Request, acct store.Account) {
+	q := r.URL.Query()
+	limit, ok := pageLimit(q["limit"])
+	if !ok {
+		writeError(w, http.StatusBadRequest, "invalid_limit")
+		return
+	}
+	after, ok := pageAfter(q["cursor"])
+	if !ok {
+		writeError(w, http.StatusBadRequest, "invalid_cursor")
+		return
+	}
+	// One extra invoice tells whether there is a next page.
+	invs := s.store.InvoicePage(acct.ID, after, limit+1)
+	next := ""
+	if len(invs) > limit {
+		invs = invs[:limit]
+		last := invs[len(invs)-1]
+		next = encodeCursor(store.Position{CreatedAt: last.CreatedAt, ID: last.ID})
+	}
 	items := []invoiceView{}
-	for _, inv := range s.store.Invoices(acct.ID) {
+	for _, inv := range invs {
 		items = append(items, view(inv))
 	}
-	writeJSON(w, http.StatusOK, map[string]any{"items": items})
+	writeJSON(w, http.StatusOK, map[string]any{"items": items, "next_cursor": next})
+}
+
+// pageLimit reads the limit parameter: absent means the default, otherwise a whole number from 1 to 100.
+func pageLimit(vals []string) (int, bool) {
+	if len(vals) == 0 {
+		return defaultPageLimit, true
+	}
+	if len(vals) > 1 || vals[0] == "" {
+		return 0, false
+	}
+	for _, c := range vals[0] {
+		if c < '0' || c > '9' {
+			return 0, false
+		}
+	}
+	n, err := strconv.Atoi(vals[0])
+	if err != nil || n < 1 || n > maxPageLimit {
+		return 0, false
+	}
+	return n, true
+}
+
+// pageAfter reads the cursor parameter: absent means the first page, otherwise the position to start after.
+func pageAfter(vals []string) (*store.Position, bool) {
+	if len(vals) == 0 {
+		return nil, true
+	}
+	if len(vals) > 1 {
+		return nil, false
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(vals[0])
+	if err != nil {
+		return nil, false
+	}
+	nanos, id, found := strings.Cut(string(raw), "|")
+	n, err := strconv.ParseInt(nanos, 10, 64)
+	if !found || err != nil || id == "" {
+		return nil, false
+	}
+	return &store.Position{CreatedAt: time.Unix(0, n), ID: id}, true
+}
+
+// encodeCursor returns the opaque cursor for a position: its creation time in nanoseconds and its ID, base64url-encoded.
+func encodeCursor(p store.Position) string {
+	return base64.RawURLEncoding.EncodeToString([]byte(strconv.FormatInt(p.CreatedAt.UnixNano(), 10) + "|" + p.ID))
 }
 
