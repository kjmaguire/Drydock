+func TestAnUnreadableCursorIsInvalid(t *testing.T) {
+	srv, st := newServer(t)
+	seedInvoices(t, st, time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC), 3)
+	garbage := base64.RawURLEncoding.EncodeToString([]byte("nonsense"))
