+// TestInvoiceWithoutLines reproduces the incident: an invoice without lines (the renewals of a free plan made them) made
+// the list and the get answer 500. Every answer shows such an invoice with an empty description.
+func TestInvoiceWithoutLines(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	empty, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: "USD"}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	type invoice struct {
+		ID          string `json:"id"`
+		Status      string `json:"status"`
+		Description string `json:"description"`
+	}
+	var list struct{ Items []invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices", e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 || list.Items[0].ID != empty.ID || list.Items[0].Description != "" {
+		t.Fatalf("list = %+v", list)
+	}
+	var got invoice
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+empty.ID, e.Acme.Key, nil, &got)
+	if got.ID != empty.ID || got.Description != "" {
+		t.Fatalf("get = %+v", got)
+	}
+	var paid struct{ Invoice invoice }
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+empty.ID+"/pay", e.Acme.Key, nil, &paid)
+	if paid.Invoice.Status != "paid" || paid.Invoice.Description != "" {
+		t.Fatalf("pay = %+v", paid.Invoice)
+	}
+	other, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: "USD"}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var voided invoice
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+other.ID+"/void", e.Acme.Key, nil, &voided)
+	if voided.Status != "void" || voided.Description != "" {
+		t.Fatalf("void = %+v", voided)
+	}
+}
