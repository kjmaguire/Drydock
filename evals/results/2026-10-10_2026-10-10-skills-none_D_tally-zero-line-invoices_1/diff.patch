+func TestFreePlanIsInvoicedWithALine(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p := e.CreatePlan(e.Acme, "Free", "USD", "0.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %+v, want the first and the renewal", invs)
+	}
+	for _, inv := range invs {
+		if inv.Status != store.InvoicePaid || len(inv.Lines) != 1 || !strings.HasPrefix(inv.Lines[0].Description, "Free, ") ||
+			inv.Lines[0].Quantity != 4 || inv.Lines[0].UnitAmount != 0 {
+			t.Fatalf("invoice = %+v", inv)
+		}
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 0 {
+		t.Fatalf("charges = %+v, a free plan charges nothing", cs)
+	}
+}
