+// ---- seats
+
+// SeatLimitError says a change needs seats that the organization's plan does not have. Limit is the plan's limit and Used
+// is the number of seats in use.
+type SeatLimitError struct{ Limit, Used int }
+
+func (e *SeatLimitError) Error() string {
+	return fmt.Sprintf("the plan allows %d seats and %d are in use", e.Limit, e.Used)
+}
+
+// SeatsUsed returns how many seats an organization uses: its members and its pending invites, except viewers, who are free.
+func (s *Store) SeatsUsed(orgID string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.seatsUsedLocked(orgID)
+}
+
+func (s *Store) seatsUsedLocked(orgID string) int {
+	used := 0
+	for _, m := range s.members {
+		if m.OrgID == orgID && m.Role != RoleViewer {
+			used++
+		}
+	}
+	for _, inv := range s.invites {
+		if inv.OrgID == orgID && inv.AcceptedAt == nil && inv.RevokedAt == nil && inv.Role != RoleViewer {
+			used++
+		}
+	}
+	return used
+}
+
+// checkSeatsLocked returns a SeatLimitError unless plan has room for need more seats than the organization uses. The caller
+// holds the lock.
+func (s *Store) checkSeatsLocked(orgID string, plan OrgPlan, need int) error {
+	limit, limited := plan.SeatLimit()
+	if !limited {
+		return nil
+	}
+	if used := s.seatsUsedLocked(orgID); used+need > limit {
+		return &SeatLimitError{Limit: limit, Used: used}
+	}
+	return nil
+}
