+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"sync"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// unlimited is the limit that expectSeats takes for a plan without one.
+const unlimited = -1
+
+// expectSeats checks the seats GET /v1/org reports.
+func expectSeats(t *testing.T, e *apitest.Env, key string, used, limit int) {
+	t.Helper()
+	var o struct {
+		Seats struct {
+			Used  int  `json:"used"`
+			Limit *int `json:"limit"`
+		} `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", key, nil, &o)
+	if o.Seats.Used != used {
+		t.Fatalf("seats used = %d, want %d", o.Seats.Used, used)
+	}
+	switch {
+	case limit == unlimited && o.Seats.Limit != nil:
+		t.Fatalf("seats limit = %d, want null", *o.Seats.Limit)
+	case limit != unlimited && (o.Seats.Limit == nil || *o.Seats.Limit != limit):
+		t.Fatalf("seats limit = %v, want %d", o.Seats.Limit, limit)
+	}
+}
+
+// wantSeatLimit checks for the 402 that says the plan has no free seat.
+func wantSeatLimit(t *testing.T, r *apitest.Response, limit, used int) {
+	t.Helper()
+	if r.Code != http.StatusPaymentRequired {
+		t.Fatalf("want 402: %s", r)
+	}
+	if m := r.Map(t); m["error"] != "seat_limit_reached" || m["limit"] != float64(limit) || m["used"] != float64(used) {
+		t.Fatalf("body = %v", m)
+	}
+}
+
+// pendingInvite finds the pending invite for an email address.
+func pendingInvite(t *testing.T, e *apitest.Env, orgID, email string) store.Invite {
+	t.Helper()
+	for _, inv := range e.Store.Invites(orgID) {
+		if inv.Email == email {
+			return inv
+		}
+	}
+	t.Fatalf("no pending invite for %s", email)
+	return store.Invite{}
+}
+
+func TestSeatLimits(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Free", store.OrgFree, "UTC") // the owner takes one of the plan's 3 seats
+	key := free.Key
+	expectSeats(t, e, key, 1, 3)
+
+	invite := func(email string, role store.Role) *apitest.Response {
+		return e.Do("POST", "/v1/invites", key, map[string]string{"email": email, "role": string(role)})
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "a@free.example", "role": "member"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "b@free.example", "role": "admin"}, nil)
+	wantSeatLimit(t, invite("c@free.example", store.RoleMember), 3, 3)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "v@free.example", "role": "viewer"}, nil)
+	expectSeats(t, e, key, 3, 3)
+
+	// A revoked invite frees its seat.
+	b := pendingInvite(t, e, free.ID, "b@free.example")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+b.ID, key, nil, nil)
+	expectSeats(t, e, key, 2, 3)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "c@free.example", "role": "member"}, nil)
+	expectSeats(t, e, key, 3, 3)
+
+	// Accepting an invite never needs a seat: the invite already holds one, so the org is full and still accepts.
+	a := pendingInvite(t, e, free.ID, "a@free.example")
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": a.Token, "name": "A"}, nil)
+	v := pendingInvite(t, e, free.ID, "v@free.example")
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": v.Token, "name": "V"}, nil)
+	expectSeats(t, e, key, 3, 3)
+	aUser, _ := e.Store.UserByEmail("a@free.example")
+	vUser, _ := e.Store.UserByEmail("v@free.example")
+
+	// A viewer who becomes anything else needs a free seat; the full org refuses.
+	wantSeatLimit(t, e.Do("PATCH", "/v1/members/"+vUser.ID, key, map[string]string{"role": "member"}), 3, 3)
+	// Leaving a seat free makes room.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+aUser.ID, key, map[string]string{"role": "viewer"}, nil)
+	expectSeats(t, e, key, 2, 3)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+vUser.ID, key, map[string]string{"role": "member"}, nil)
+	expectSeats(t, e, key, 3, 3)
+	// A change between two non-viewer roles needs no new seat.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+vUser.ID, key, map[string]string{"role": "billing"}, nil)
+	expectSeats(t, e, key, 3, 3)
+}
+
+func TestPlanChangeMustFitSeats(t *testing.T) {
+	e := apitest.New(t)
+	acme := e.Acme // team plan: 10 seats; the owner takes one
+	key := acme.Key
+	expectSeats(t, e, key, 1, 10)
+
+	// Team to free with 3 seats in use fits exactly.
+	for _, email := range []string{"a@acme.example", "b@acme.example"} {
+		e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": email, "role": "member"}, nil)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]string{"plan": "free"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]string{"plan": "team"}, nil)
+	expectSeats(t, e, key, 3, 10)
+
+	// With 5 in use, free is refused, and nothing changes, not even the name.
+	for _, email := range []string{"c@acme.example", "d@acme.example"} {
+		e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": email, "role": "member"}, nil)
+	}
+	r := e.Do("PATCH", "/v1/org", key, map[string]string{"name": "Renamed", "plan": "free"})
+	if r.Code != http.StatusConflict {
+		t.Fatalf("downgrade: %s", r)
+	}
+	if m := r.Map(t); m["error"] != "over_seat_limit" || m["limit"] != float64(3) || m["used"] != float64(5) {
+		t.Fatalf("body = %v", m)
+	}
+	var o store.Org
+	e.MustDo(http.StatusOK, "GET", "/v1/org", key, nil, &o)
+	if o.Plan != store.OrgTeam || o.Name != "Acme" {
+		t.Fatalf("org changed by a refused downgrade: %+v", o)
+	}
+	expectSeats(t, e, key, 5, 10)
+
+	// Business has no limit, so any number of seats fits it.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]string{"plan": "business"}, nil)
+	expectSeats(t, e, key, 5, unlimited)
+}
+
+func TestSeatLimitHeldUnderConcurrency(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Race", store.OrgFree, "UTC")
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "first@race.example", "role": "member"}, nil)
+	expectSeats(t, e, free.Key, 2, 3) // one seat left
+
+	const n = 8
+	codes := make(chan int, n)
+	var wg sync.WaitGroup
+	for i := range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			codes <- e.Do("POST", "/v1/invites", free.Key, map[string]string{"email": fmt.Sprintf("p%d@race.example", i), "role": "admin"}).Code
+		}()
+	}
+	wg.Wait()
+	close(codes)
+	created := 0
+	for c := range codes {
+		switch c {
+		case http.StatusCreated:
+			created++
+		case http.StatusPaymentRequired:
+		default:
+			t.Errorf("invite answered %d", c)
+		}
+	}
+	if created != 1 {
+		t.Fatalf("%d of %d invites were created with one seat left, want 1", created, n)
+	}
+	expectSeats(t, e, free.Key, 3, 3)
+}
