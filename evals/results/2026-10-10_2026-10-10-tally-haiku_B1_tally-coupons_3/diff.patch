diff --git a/result/internal/store/coupons.go b/result/internal/store/coupons.go
new file mode 100644
index 0000000..a01a68e
--- /dev/null
+++ b/result/internal/store/coupons.go
@@ -0,0 +1,180 @@
+package store
+
+import (
+	"errors"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Coupon errors. Callers check them with errors.Is.
+var (
+	// ErrCodeTaken is returned when the organization already has a coupon with the code, ignoring case.
+	ErrCodeTaken = errors.New("the coupon code is already in use")
+	// ErrCouponExpired is returned when a coupon is applied after its redeem-by time.
+	ErrCouponExpired = errors.New("the coupon can no longer be redeemed")
+	// ErrCouponExhausted is returned when as many subscriptions as the coupon's max redemptions already have it.
+	ErrCouponExhausted = errors.New("the coupon has no redemptions left")
+	// ErrCurrencyMismatch is returned when an amount coupon is applied to a plan in another currency.
+	ErrCurrencyMismatch = errors.New("the coupon's currency is not the plan's currency")
+	// ErrCouponAlreadyApplied is returned when a subscription already has a coupon.
+	ErrCouponAlreadyApplied = errors.New("the subscription already has a coupon")
+	// ErrSubscriptionCanceled is returned when a canceled subscription is changed in a way that needs it to be live.
+	ErrSubscriptionCanceled = errors.New("the subscription is canceled")
+)
+
+var couponCodeRe = regexp.MustCompile(`^[A-Za-z0-9_-]{3,32}$`)
+
+func normCode(code string) string { return strings.ToLower(code) }
+
+// CreateCoupon adds a coupon to an organization. Its code is unique in the organization, ignoring case. Its amount, if it
+// has one, is in minor units. Its currency is kept only for an amount coupon, and its redeem-by time is kept in UTC.
+func (s *Store) CreateCoupon(c Coupon, now time.Time) (Coupon, error) {
+	if c.PercentOff != nil && c.AmountOff == nil {
+		c.Currency = ""
+	}
+	if err := checkCoupon(c); err != nil {
+		return Coupon{}, err
+	}
+	if c.RedeemBy != nil {
+		t := c.RedeemBy.UTC()
+		c.RedeemBy = &t
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[c.OrgID]; !ok {
+		return Coupon{}, ErrNotFound
+	}
+	key := couponKey{c.OrgID, normCode(c.Code)}
+	if _, taken := s.couponsByCode[key]; taken {
+		return Coupon{}, ErrCodeTaken
+	}
+	c.ID = s.newID("cpn")
+	c.CreatedAt = now.UTC()
+	c.TimesRedeemed = 0
+	s.coupons[c.ID] = copyCoupon(c)
+	s.couponsByCode[key] = c.ID
+	return copyCoupon(c), nil
+}
+
+func checkCoupon(c Coupon) error {
+	switch {
+	case !couponCodeRe.MatchString(c.Code):
+		return invalid("a coupon code is 3 to 32 letters, digits, dashes or underscores")
+	case (c.PercentOff == nil) == (c.AmountOff == nil):
+		return invalid("a coupon takes a percent off or an amount off, not both and not neither")
+	case c.PercentOff != nil && (*c.PercentOff < 1 || *c.PercentOff > 100):
+		return invalid("a percent off is 1 to 100")
+	case c.AmountOff != nil && *c.AmountOff <= 0:
+		return invalid("an amount off is more than zero")
+	case c.AmountOff != nil && !c.Currency.Valid():
+		return invalid("unknown currency %q", c.Currency)
+	case c.Duration != CouponOnce && c.Duration != CouponRepeating && c.Duration != CouponForever:
+		return invalid("a coupon lasts once, repeating or forever")
+	case c.Duration == CouponRepeating && (c.DurationInMonths < 1 || c.DurationInMonths > 36):
+		return invalid("a repeating coupon lasts 1 to 36 months")
+	case c.Duration != CouponRepeating && c.DurationInMonths != 0:
+		return invalid("only a repeating coupon has a duration in months")
+	case c.MaxRedemptions < 0:
+		return invalid("a coupon's max redemptions is at least 1")
+	}
+	return nil
+}
+
+// CouponByCode returns one of an organization's coupons by its code, ignoring case.
+func (s *Store) CouponByCode(orgID, code string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	id, ok := s.couponsByCode[couponKey{orgID, normCode(code)}]
+	if !ok {
+		return Coupon{}, false
+	}
+	return s.couponView(s.coupons[id]), true
+}
+
+// Coupons returns an organization's coupons, oldest first.
+func (s *Store) Coupons(orgID string) []Coupon {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Coupon{}
+	for _, c := range s.coupons {
+		if c.OrgID == orgID {
+			out = append(out, s.couponView(c))
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// ApplyCoupon applies one of the organization's coupons to one of its subscriptions at now. The coupon then discounts the
+// subscription's invoices created after now. It refuses a coupon past its redeem-by time, one with no redemptions left, an
+// amount coupon in another currency than the plan's, and a subscription that already has a coupon or is canceled.
+func (s *Store) ApplyCoupon(orgID, subID, code string, now time.Time) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	sub, ok := s.subs[subID]
+	if !ok || sub.OrgID != orgID {
+		return Subscription{}, ErrNotFound
+	}
+	id, ok := s.couponsByCode[couponKey{orgID, normCode(code)}]
+	if !ok {
+		return Subscription{}, ErrNotFound
+	}
+	c := s.coupons[id]
+	switch {
+	case c.RedeemBy != nil && now.After(*c.RedeemBy):
+		return Subscription{}, ErrCouponExpired
+	case c.MaxRedemptions > 0 && s.redemptions(orgID, c.Code) >= c.MaxRedemptions:
+		return Subscription{}, ErrCouponExhausted
+	case c.AmountOff != nil && s.plans[sub.PlanID].Currency != c.Currency:
+		return Subscription{}, ErrCurrencyMismatch
+	case sub.Coupon != "":
+		return Subscription{}, ErrCouponAlreadyApplied
+	case sub.Status == Canceled:
+		return Subscription{}, ErrSubscriptionCanceled
+	}
+	redeemed := now.UTC()
+	sub.Coupon, sub.CouponRedeemedAt = c.Code, &redeemed
+	s.subs[subID] = sub
+	return copySub(sub), nil
+}
+
+// redemptions counts the subscriptions of an organization that have the coupon with this code. The caller holds the lock.
+func (s *Store) redemptions(orgID, code string) int {
+	n := 0
+	for _, sub := range s.subs {
+		if sub.OrgID == orgID && sub.Coupon == code {
+			n++
+		}
+	}
+	return n
+}
+
+// couponView is the coupon with its redemption count. The caller holds the lock.
+func (s *Store) couponView(c Coupon) Coupon {
+	c = copyCoupon(c)
+	c.TimesRedeemed = s.redemptions(c.OrgID, c.Code)
+	return c
+}
+
+func copyCoupon(c Coupon) Coupon {
+	if c.PercentOff != nil {
+		v := *c.PercentOff
+		c.PercentOff = &v
+	}
+	if c.AmountOff != nil {
+		v := *c.AmountOff
+		c.AmountOff = &v
+	}
+	if c.RedeemBy != nil {
+		t := *c.RedeemBy
+		c.RedeemBy = &t
+	}
+	return c
+}
