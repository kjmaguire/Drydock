+package api_test
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func TestCreateCoupon(t *testing.T) {
+	e := apitest.New(t)
+	var c store.Coupon
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "SPRING_25", "amount_off": "12.50", "currency": "USD",
+		"duration": "repeating", "duration_in_months": 3, "max_redemptions": 10, "redeem_by": "2026-06-30T00:00:00Z"}, &c)
+	if c.Code != "SPRING_25" || c.AmountOff == nil || *c.AmountOff != 1250 || c.PercentOff != nil || c.Currency != "USD" ||
+		c.Duration != store.CouponRepeating || c.DurationInMonths != 3 || c.MaxRedemptions != 10 || c.TimesRedeemed != 0 || c.RedeemBy == nil {
+		t.Fatalf("coupon = %+v", c)
+	}
+	var raw map[string]any
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/SPRING_25", e.Acme.Key, nil, &raw)
+	if raw["amount_off"] != float64(1250) || raw["percent_off"] != nil || raw["times_redeemed"] != float64(0) {
+		t.Fatalf("shape = %v", raw)
+	}
+
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "half", "percent_off": 50, "duration": "forever"}, &c)
+	if c.PercentOff == nil || *c.PercentOff != 50 || c.AmountOff != nil || c.Duration != store.CouponForever {
+		t.Fatalf("percent coupon = %+v", c)
+	}
+}
+
+func TestCreateCouponRefusals(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "SPRING", "percent_off": 10, "duration": "once"}, nil)
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "spring", "percent_off": 10, "duration": "once"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "code_taken" {
+		t.Fatalf("code taken, ignoring case: %s", r)
+	}
+	// The same code in another organization is fine.
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Globex.Key, map[string]any{"code": "SPRING", "percent_off": 10, "duration": "once"}, nil)
+
+	invalid := []map[string]any{
+		{"code": "ab", "percent_off": 10, "duration": "once"},
+		{"code": "has space", "percent_off": 10, "duration": "once"},
+		{"code": strings.Repeat("A", 33), "percent_off": 10, "duration": "once"},
+		{"code": "BOTH", "percent_off": 10, "amount_off": "1.00", "currency": "USD", "duration": "once"},
+		{"code": "NEITHER", "duration": "once"},
+		{"code": "ZERO", "percent_off": 0, "duration": "once"},
+		{"code": "OVER", "percent_off": 101, "duration": "once"},
+		{"code": "FREE", "amount_off": "0", "currency": "USD", "duration": "once"},
+		{"code": "NEG", "amount_off": "-1.00", "currency": "USD", "duration": "once"},
+		{"code": "NOCUR", "amount_off": "1.00", "duration": "once"},
+		{"code": "BADAMT", "amount_off": "1.005", "currency": "USD", "duration": "once"},
+		{"code": "WEEKLY", "percent_off": 10, "duration": "weekly"},
+		{"code": "NOMONTHS", "percent_off": 10, "duration": "repeating"},
+		{"code": "ONCEMONTHS", "percent_off": 10, "duration": "once", "duration_in_months": 3},
+		{"code": "LONG", "percent_off": 10, "duration": "repeating", "duration_in_months": 37},
+		{"code": "ZEROMAX", "percent_off": 10, "duration": "once", "max_redemptions": 0},
+		{"code": "BADDATE", "percent_off": 10, "duration": "once", "redeem_by": "tomorrow"},
+	}
+	for _, body := range invalid {
+		if r := e.Do("POST", "/v1/coupons", e.Acme.Key, body); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid" {
+			t.Fatalf("%v: %s", body, r)
+		}
+	}
+	if r := e.Do("GET", "/v1/coupons/ZERO", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("a refused coupon was kept: %s", r)
+	}
+}
+
+func TestListAndGetCoupons(t *testing.T) {
+	e := apitest.New(t)
+	for _, code := range []string{"AAA", "BBB", "CCC"} {
+		e.Clock.Advance(time.Minute)
+		e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": code, "percent_off": 5, "duration": "forever"}, nil)
+	}
+	var first, second struct {
+		Items      []store.Coupon `json:"items"`
+		NextCursor string         `json:"next_cursor"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons?limit=2", e.Acme.Key, nil, &first)
+	if len(first.Items) != 2 || first.Items[0].Code != "AAA" || first.Items[1].Code != "BBB" || first.NextCursor == "" {
+		t.Fatalf("first page = %+v", first)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons?limit=2&cursor="+first.NextCursor, e.Acme.Key, nil, &second)
+	if len(second.Items) != 1 || second.Items[0].Code != "CCC" || second.NextCursor != "" {
+		t.Fatalf("second page = %+v", second)
+	}
+	var got store.Coupon
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/bbb", e.Acme.Key, nil, &got)
+	if got.Code != "BBB" {
+		t.Fatalf("get ignoring case = %+v", got)
+	}
+	if r := e.Do("GET", "/v1/coupons/AAA", e.Globex.Key, nil); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("another organization's coupon: %s", r)
+	}
+}
+
+// subscribers numbers the customers that subscribe, so each has its own email address.
+var subscribers int
+
+// subscribe starts a subscription of the Acme organization to a monthly 20.00 USD plan.
+func subscribe(t *testing.T, e *apitest.Env) store.Subscription {
+	t.Helper()
+	subscribers++
+	c := e.CreateCustomer(e.Acme, "Jane", fmt.Sprintf("jane%d@example.com", subscribers))
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": p.ID}, &sub)
+	return sub
+}
+
+func TestApplyCoupon(t *testing.T) {
+	e := apitest.New(t)
+	sub := subscribe(t, e)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "WELCOME", "percent_off": 25, "duration": "forever"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "OTHER", "percent_off": 10, "duration": "forever"}, nil)
+
+	var applied store.Subscription
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]any{"code": "welcome"}, &applied)
+	if applied.Coupon != "WELCOME" || applied.CouponRedeemedAt == nil || !applied.CouponRedeemedAt.Equal(e.Clock.Now()) {
+		t.Fatalf("applied = %+v", applied)
+	}
+	var got store.Subscription
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions/"+sub.ID, e.Acme.Key, nil, &got)
+	if got.Coupon != "WELCOME" {
+		t.Fatalf("subscription does not show the coupon: %+v", got)
+	}
+
+	cases := []struct {
+		name, path, key, code, want string
+		status                      int
+	}{
+		{"second coupon", "/v1/subscriptions/" + sub.ID + "/coupon", e.Acme.Key, "OTHER", "coupon_already_applied", http.StatusConflict},
+		{"no such coupon", "/v1/subscriptions/" + sub.ID + "/coupon", e.Acme.Key, "NOPE", "not_found", http.StatusNotFound},
+		{"no such subscription", "/v1/subscriptions/sub_999999/coupon", e.Acme.Key, "OTHER", "not_found", http.StatusNotFound},
+		{"another organization", "/v1/subscriptions/" + sub.ID + "/coupon", e.Globex.Key, "OTHER", "not_found", http.StatusNotFound},
+	}
+	for _, c := range cases {
+		r := e.Do("POST", c.path, c.key, map[string]any{"code": c.code})
+		if r.Code != c.status || r.Map(t)["error"] != c.want {
+			t.Fatalf("%s: %s", c.name, r)
+		}
+	}
+}
+
+func TestApplyCouponRefusals(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "ONEUSE", "percent_off": 10, "duration": "forever", "max_redemptions": 1}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "SOONGONE", "percent_off": 10, "duration": "forever",
+		"redeem_by": e.Clock.Now().Add(time.Hour).Format(time.RFC3339)}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "EUROS", "amount_off": "5.00", "currency": "EUR", "duration": "once"}, nil)
+
+	first := subscribe(t, e)
+	second := subscribe(t, e)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+first.ID+"/coupon", e.Acme.Key, map[string]any{"code": "ONEUSE"}, nil)
+	if r := e.Do("POST", "/v1/subscriptions/"+second.ID+"/coupon", e.Acme.Key, map[string]any{"code": "ONEUSE"}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_exhausted" {
+		t.Fatalf("exhausted: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions/"+second.ID+"/coupon", e.Acme.Key, map[string]any{"code": "EUROS"}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "currency_mismatch" {
+		t.Fatalf("currency: %s", r)
+	}
+
+	e.Clock.Advance(2 * time.Hour)
+	if r := e.Do("POST", "/v1/subscriptions/"+second.ID+"/coupon", e.Acme.Key, map[string]any{"code": "SOONGONE"}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_expired" {
+		t.Fatalf("expired: %s", r)
+	}
+
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+second.ID+"/cancel", e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "LATE", "percent_off": 10, "duration": "once"}, nil)
+	if r := e.Do("POST", "/v1/subscriptions/"+second.ID+"/coupon", e.Acme.Key, map[string]any{"code": "LATE"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "subscription_canceled" {
+		t.Fatalf("canceled: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions/"+second.ID+"/coupon", e.Acme.Key, map[string]any{"code": "LATE"}); r.Code != http.StatusConflict {
+		t.Fatalf("canceled again: %s", r)
+	}
+}
+
+func TestInvoicesShowTheCoupon(t *testing.T) {
+	e := apitest.New(t)
+	sub := subscribe(t, e)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "TENOFF", "amount_off": "3.00", "currency": "USD", "duration": "forever"}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]any{"code": "TENOFF"}, nil)
+
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	var list struct {
+		Items []map[string]any `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &list)
+	if len(list.Items) != 2 {
+		t.Fatalf("invoices = %v", list.Items)
+	}
+	first, renewal := list.Items[0], list.Items[1]
+	if first["coupon"] != "" || first["discount"] != float64(0) || first["total"] != float64(2000) {
+		t.Fatalf("first invoice = %v", first)
+	}
+	if renewal["coupon"] != "TENOFF" || renewal["discount"] != float64(300) || renewal["total"] != float64(1700) || renewal["total_formatted"] != "$17.00" {
+		t.Fatalf("renewal = %v", renewal)
+	}
+}
