+		t.Fatalf("plan change to EUR: %v", err)
+	}
+}
+
+func TestAmountCouponNeverTakesMoreThanTheSubtotal(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := couponSub(t, e, 0)
+	newCoupon(t, e, store.Coupon{Code: "BIGOFF", AmountOff: int64Ptr(5000), Currency: money.USD, Duration: store.CouponForever})
+	if _, err := e.Subs.ApplyCoupon(ctx, e.Acme.ID, sub.ID, "BIGOFF"); err != nil {
+		t.Fatal(err)
