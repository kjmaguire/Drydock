diff --git a/result/internal/api/coupons.go b/result/internal/api/coupons.go
new file mode 100644
index 0000000..5b25625
--- /dev/null
+++ b/result/internal/api/coupons.go
@@ -0,0 +1,124 @@
+package api
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+func couponKey(c store.Coupon) cursor { return cursor{T: c.CreatedAt, ID: c.ID} }
+
+// couponError answers for an error from creating or applying a coupon.
+func (s *Server) couponError(w http.ResponseWriter, err error) {
+	switch {
+	case errors.Is(err, store.ErrCodeTaken):
+		writeError(w, http.StatusConflict, "code_taken", err.Error())
+	case errors.Is(err, store.ErrCouponExpired):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_expired", err.Error())
+	case errors.Is(err, store.ErrCouponExhausted):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_exhausted", err.Error())
+	case errors.Is(err, store.ErrCurrencyMismatch):
+		writeError(w, http.StatusUnprocessableEntity, "currency_mismatch", err.Error())
+	case errors.Is(err, store.ErrCouponAlreadyApplied):
+		writeError(w, http.StatusConflict, "coupon_already_applied", err.Error())
+	case errors.Is(err, store.ErrSubscriptionCanceled):
+		writeError(w, http.StatusConflict, "subscription_canceled", err.Error())
+	default:
+		s.storeError(w, err)
+	}
+}
+
+func (s *Server) listCoupons(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	items, next := pageOf(s.store.Coupons(p.OrgID), couponKey, pg)
+	writeJSON(w, http.StatusOK, list{Items: items, NextCursor: next})
+}
+
+// createCoupon creates a coupon: {"code", "percent_off" (1 to 100) or "amount_off" (major units, as a string) with "currency",
+// "duration" (once, repeating or forever), "duration_in_months" (repeating only), "max_redemptions", "redeem_by" (RFC 3339)}.
+func (s *Server) createCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in struct {
+		Code             string               `json:"code"`
+		PercentOff       *int                 `json:"percent_off"`
+		AmountOff        *string              `json:"amount_off"`
+		Currency         money.Currency       `json:"currency"`
+		Duration         store.CouponDuration `json:"duration"`
+		DurationInMonths *int                 `json:"duration_in_months"`
+		MaxRedemptions   *int                 `json:"max_redemptions"`
+		RedeemBy         *string              `json:"redeem_by"`
+	}
+	if !decode(w, r, &in) {
+		return
+	}
+	c := store.Coupon{OrgID: p.OrgID, Code: in.Code, PercentOff: in.PercentOff, Currency: in.Currency, Duration: in.Duration}
+	if in.AmountOff != nil {
+		amount, err := money.ParseMajor(*in.AmountOff, in.Currency)
+		if err != nil {
+			s.storeError(w, fmt.Errorf("%w: amount_off %v", store.ErrInvalid, err))
+			return
+		}
+		c.AmountOff = &amount
+	}
+	if in.DurationInMonths != nil {
+		if in.Duration != store.CouponRepeating {
+			s.storeError(w, fmt.Errorf("%w: only a repeating coupon has a duration_in_months", store.ErrInvalid))
+			return
+		}
+		c.DurationInMonths = *in.DurationInMonths
+	}
+	if in.MaxRedemptions != nil {
+		if *in.MaxRedemptions < 1 {
+			s.storeError(w, fmt.Errorf("%w: max_redemptions is at least 1", store.ErrInvalid))
+			return
+		}
+		c.MaxRedemptions = *in.MaxRedemptions
+	}
+	if in.RedeemBy != nil {
+		t, err := time.Parse(time.RFC3339, *in.RedeemBy)
+		if err != nil {
+			s.storeError(w, fmt.Errorf("%w: redeem_by is an RFC 3339 time", store.ErrInvalid))
+			return
+		}
+		c.RedeemBy = &t
+	}
+	created, err := s.store.CreateCoupon(c, s.clock.Now())
+	if err != nil {
+		s.couponError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusCreated, created)
+}
+
+// getCoupon answers one of the organization's coupons by its code, ignoring case.
+func (s *Server) getCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	c, ok := s.store.CouponByCode(p.OrgID, r.PathValue("code"))
+	if !ok {
+		writeError(w, http.StatusNotFound, "not_found", "no such coupon")
+		return
+	}
+	writeJSON(w, http.StatusOK, c)
+}
+
+// applyCoupon applies a coupon to a subscription: {"code": "..."}.
+func (s *Server) applyCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in struct {
+		Code string `json:"code"`
+	}
+	if !decode(w, r, &in) {
+		return
+	}
+	sub, err := s.subs.ApplyCoupon(r.Context(), p.OrgID, r.PathValue("id"), in.Code)
+	if err != nil {
+		s.couponError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusOK, sub)
+}
diff --git a/result/internal/api/coupons_test.go b/result/internal/api/coupons_test.go
