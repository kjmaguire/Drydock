+package billing
+
+import (
+	"testing"
+
+	"example.com/tally/internal/store"
+)
+
+func TestCouponDiscounts(t *testing.T) {
+	lines := []store.Line{{Description: "x", Quantity: 1, UnitAmount: 5499}}
+	cases := []struct {
+		name string
+		inv  store.Invoice
+		want Totals
+	}{
+		// 25% of 5499 is 1374.75, rounded to 1375; no tax here.
+		{"percent coupon", store.Invoice{Lines: lines, Coupon: "Q", CouponPercentOff: 25}, Totals{Subtotal: 5499, Discount: 1375, Total: 4124}},
+		// The coupon replaces the invoice's own percentage.
+		{"coupon over discount_percent", store.Invoice{Lines: lines, DiscountPercent: 10, Coupon: "Q", CouponPercentOff: 25}, Totals{Subtotal: 5499, Discount: 1375, Total: 4124}},
+		{"amount coupon", store.Invoice{Lines: lines, Coupon: "A", CouponAmountOff: 500}, Totals{Subtotal: 5499, Discount: 500, Total: 4999}},
+		{"amount coupon is capped at the subtotal", store.Invoice{Lines: lines, Coupon: "A", CouponAmountOff: 9000}, Totals{Subtotal: 5499, Discount: 5499, Total: 0}},
+		// Tax is charged on what is left after the coupon: 10% of 4999 is 499.9, rounded to 500.
+		{"tax after the coupon", store.Invoice{Lines: lines, TaxRateBP: 1000, Coupon: "A", CouponAmountOff: 500}, Totals{Subtotal: 5499, Discount: 500, Tax: 500, Total: 5499}},
+		{"no coupon", store.Invoice{Lines: lines, DiscountPercent: 10}, Totals{Subtotal: 5499, Discount: 550, Total: 4949}},
+	}
+	for _, c := range cases {
+		if got := Compute(c.inv); got != c.want {
+			t.Errorf("%s: got %+v, want %+v", c.name, got, c.want)
+		}
+	}
+}
