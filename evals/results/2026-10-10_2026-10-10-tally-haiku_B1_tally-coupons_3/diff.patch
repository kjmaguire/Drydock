+// couponFor returns the coupon that discounts an invoice of sub created now for the period starting at start, or nil. A
+// coupon discounts the invoices created after it was applied: a once coupon only the first of them, a repeating coupon those
+// whose period starts less than its duration in months after the redemption, and a forever coupon all of them.
+func (s *Service) couponFor(sub store.Subscription, start, now time.Time) (*store.Coupon, error) {
+	if sub.Coupon == "" || sub.CouponRedeemedAt == nil || !now.After(*sub.CouponRedeemedAt) {
+		return nil, nil
+	}
+	c, ok := s.Store.CouponByCode(sub.OrgID, sub.Coupon)
+	if !ok {
+		return nil, store.ErrNotFound
+	}
+	switch c.Duration {
+	case store.CouponOnce:
+		for _, inv := range s.Store.ListInvoices(sub.OrgID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+			if inv.Coupon == c.Code {
+				return nil, nil
+			}
+		}
+	case store.CouponRepeating:
+		if !start.Before(sub.CouponRedeemedAt.AddDate(0, c.DurationInMonths, 0)) {
+			return nil, nil
+		}
+	}
+	return &c, nil
+}
