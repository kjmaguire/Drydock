+)
+
+// couponSub starts a monthly 20.00 USD subscription with no payment method (its invoices stay open) and returns it with the
+// Acme plan's ID.
+func couponSub(t *testing.T, e *apitest.Env, discountPercent int) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1, DiscountPercent: discountPercent})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+func newCoupon(t *testing.T, e *apitest.Env, c store.Coupon) store.Coupon {
+	t.Helper()
+	c.OrgID = e.Acme.ID
+	out, err := e.Store.CreateCoupon(c, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+// renew moves the clock to the end of sub's current period and renews every due subscription; it returns the subscription.
+func renew(t *testing.T, e *apitest.Env, sub store.Subscription) store.Subscription {
+	t.Helper()
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	return got
+}
+
+// lastInvoice returns the subscription's newest invoice and its discount.
+func lastInvoice(e *apitest.Env, sub store.Subscription) (store.Invoice, int64) {
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	inv := invs[len(invs)-1]
+	return inv, billing.Compute(inv).Discount
+}
