+func TestForeverPercentCouponDiscountsEveryRenewal(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := couponSub(t, e, 10)
+	newCoupon(t, e, store.Coupon{Code: "QUARTER", PercentOff: intPtr(25), Duration: store.CouponForever})
+	if _, err := e.Subs.ApplyCoupon(ctx, e.Acme.ID, sub.ID, "quarter"); err != nil {
+		t.Fatal(err)
+	}
+	// The invoice created before the coupon keeps the subscription's own 10 percent.
+	if inv, d := lastInvoice(e, sub); d != 200 || inv.Coupon != "" {
+		t.Fatalf("first invoice = %+v discount %d", inv, d)
+	}
+	for range 3 {
+		sub = renew(t, e, sub)
+		inv, d := lastInvoice(e, sub)
+		// The coupon takes the place of the subscription's 10 percent.
+		if inv.Coupon != "QUARTER" || inv.DiscountPercent != 0 || d != 500 || billing.Compute(inv).Total != 1500 {
+			t.Fatalf("renewal invoice = %+v discount %d", inv, d)
+		}
+	}
+}
+
+func TestOnceCouponDiscountsOnlyTheFirstInvoiceAfterIt(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := couponSub(t, e, 0)
+	newCoupon(t, e, store.Coupon{Code: "FIVEOFF", AmountOff: int64Ptr(500), Currency: money.USD, Duration: store.CouponOnce})
+	if _, err := e.Subs.ApplyCoupon(ctx, e.Acme.ID, sub.ID, "FIVEOFF"); err != nil {
+		t.Fatal(err)
+	}
+	sub = renew(t, e, sub)
+	if inv, d := lastInvoice(e, sub); d != 500 || inv.Coupon != "FIVEOFF" {
+		t.Fatalf("first renewal = %+v discount %d", inv, d)
+	}
+	sub = renew(t, e, sub)
+	if inv, d := lastInvoice(e, sub); d != 0 || inv.Coupon != "" || billing.Compute(inv).Total != 2000 {
+		t.Fatalf("second renewal = %+v discount %d", inv, d)
+	}
+}
+
+func TestRepeatingCouponStopsAfterItsMonths(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := couponSub(t, e, 0)
+	newCoupon(t, e, store.Coupon{Code: "HALFTWO", PercentOff: intPtr(50), Duration: store.CouponRepeating, DurationInMonths: 2})
+	if _, err := e.Subs.ApplyCoupon(ctx, e.Acme.ID, sub.ID, "HALFTWO"); err != nil {
+		t.Fatal(err)
+	}
+	// Periods starting in the first two months after the redemption are discounted; the third is not.
+	want := []int64{1000, 0}
+	for i, d := range want {
+		sub = renew(t, e, sub)
+		if _, got := lastInvoice(e, sub); got != d {
+			t.Fatalf("renewal %d: discount %d, want %d", i+1, got, d)
+		}
+	}
+}
+
+func TestCouponAppliedMidPeriodWaitsForTheNextInvoice(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := couponSub(t, e, 0)
+	e.Clock.Advance(10 * 24 * time.Hour)
+	newCoupon(t, e, store.Coupon{Code: "LATER", PercentOff: intPtr(20), Duration: store.CouponOnce})
+	if _, err := e.Subs.ApplyCoupon(ctx, e.Acme.ID, sub.ID, "LATER"); err != nil {
+		t.Fatal(err)
+	}
+	// Nothing is due yet, so the coupon waits for the period's end.
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	sub = renew(t, e, sub)
+	if inv, d := lastInvoice(e, sub); d != 400 || inv.Coupon != "LATER" {
+		t.Fatalf("renewal = %+v discount %d", inv, d)
+	}
+}
+
+func TestPlanChangeKeepsTheAmountCouponsCurrency(t *testing.T) {
+	e := apitest.New(t)
