@@ -0,0 +1,67 @@
+package store
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+func TestCouponsSurviveExportAndFromState(t *testing.T) {
+	now := time.Date(2026, 3, 1, 9, 0, 0, 0, time.UTC)
+	s := New()
+	o, _ := s.CreateOrg("Acme", OrgTeam, "UTC", 0, now)
+	cus, _ := s.CreateCustomer(o.ID, "Jane", "jane@example.com", now)
+	plan, _ := s.CreatePlan(Plan{OrgID: o.ID, Name: "Team", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, now)
+	sub, _ := s.CreateSubscription(Subscription{OrgID: o.ID, CustomerID: cus.ID, PlanID: plan.ID, Quantity: 1, Status: Active}, now)
+	pct := 15
+	c, err := s.CreateCoupon(Coupon{OrgID: o.ID, Code: "Spring_15", PercentOff: &pct, Duration: CouponForever}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.ApplyCoupon(o.ID, sub.ID, "SPRING_15", now.Add(time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+
+	loaded, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, ok := loaded.CouponByCode(o.ID, "spring_15")
+	if !ok || got.ID != c.ID || got.PercentOff == nil || *got.PercentOff != 15 || got.TimesRedeemed != 1 {
+		t.Fatalf("loaded coupon = %+v, %v", got, ok)
+	}
+	again, _ := loaded.Subscription(o.ID, sub.ID)
+	if again.Coupon != "Spring_15" || again.CouponRedeemedAt == nil || !again.CouponRedeemedAt.Equal(now.Add(time.Hour)) {
+		t.Fatalf("loaded subscription = %+v", again)
+	}
+	if _, err := loaded.CreateCoupon(Coupon{OrgID: o.ID, Code: "SPRING_15", PercentOff: &pct, Duration: CouponOnce}, now); !errors.Is(err, ErrCodeTaken) {
+		t.Fatalf("code after load: %v", err)
+	}
+}
+
+func TestApplyCouponRefusesWhatItMust(t *testing.T) {
+	now := time.Date(2026, 3, 1, 9, 0, 0, 0, time.UTC)
+	s := New()
+	o, _ := s.CreateOrg("Acme", OrgTeam, "UTC", 0, now)
+	cus, _ := s.CreateCustomer(o.ID, "Jane", "jane@example.com", now)
+	plan, _ := s.CreatePlan(Plan{OrgID: o.ID, Name: "Team", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, now)
+	sub, _ := s.CreateSubscription(Subscription{OrgID: o.ID, CustomerID: cus.ID, PlanID: plan.ID, Quantity: 1, Status: Active}, now)
+	pct := 10
+	if _, err := s.CreateCoupon(Coupon{OrgID: o.ID, Code: "TENOFF", PercentOff: &pct, Duration: CouponOnce}, now); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.ApplyCoupon(o.ID, sub.ID, "TENOFF", now); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.ApplyCoupon(o.ID, sub.ID, "TENOFF", now); !errors.Is(err, ErrCouponAlreadyApplied) {
+		t.Fatalf("second coupon: %v", err)
+	}
+	if _, err := s.ApplyCoupon(o.ID, sub.ID, "MISSING", now); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("missing coupon: %v", err)
+	}
+	if _, err := s.ApplyCoupon("org_other", sub.ID, "TENOFF", now); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("another organization's subscription: %v", err)
+	}
+}
