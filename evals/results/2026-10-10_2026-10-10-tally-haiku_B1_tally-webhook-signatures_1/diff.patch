+// hmacV1 is the v1 signature of a payload sent at t, computed here rather than with the package, to pin the scheme.
+func hmacV1(secret string, t int64, payload []byte) string {
+	m := hmac.New(sha256.New, []byte(secret))
+	fmt.Fprintf(m, "%d.", t)
+	m.Write(payload)
+	return hex.EncodeToString(m.Sum(nil))
+}
+
+func TestSignatureHeader(t *testing.T) {
+	body := []byte(`{"id":"evt_1"}`)
+	at := time.Unix(1_700_000_000, 999)
+	got := webhooks.SignatureHeader([]string{"whsec_new", "whsec_old"}, at, body)
+	want := "t=1700000000,v1=" + hmacV1("whsec_new", 1_700_000_000, body) + ",v1=" + hmacV1("whsec_old", 1_700_000_000, body)
+	if got != want {
+		t.Fatalf("SignatureHeader = %s\nwant %s", got, want)
+	}
+	if got := webhooks.SignatureHeader([]string{"whsec_new"}, at, body); got != "t=1700000000,v1="+hmacV1("whsec_new", 1_700_000_000, body) {
+		t.Fatalf("one secret: %s", got)
+	}
+}
