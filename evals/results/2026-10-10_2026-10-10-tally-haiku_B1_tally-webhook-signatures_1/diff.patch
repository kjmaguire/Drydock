+func TestRotateSecret(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/rot", Events: []string{"*"}, Secret: "whsec_old", Enabled: true}, e.Clock.Now())
+	path := "/v1/webhook-endpoints/" + ep.ID + "/rotate-secret"
+
+	if r := e.Do("POST", path, e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("another organization rotated the secret: %s", r)
+	}
+	if r := e.Do("POST", "/v1/webhook-endpoints/we_nope/rotate-secret", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("unknown endpoint: %s", r)
+	}
+
+	var rotated store.WebhookEndpoint
+	e.MustDo(http.StatusOK, "POST", path, e.Acme.Key, nil, &rotated)
+	if !strings.HasPrefix(rotated.Secret, "whsec_") || len(rotated.Secret) != len("whsec_")+32 || rotated.Secret == "whsec_old" {
+		t.Fatalf("new secret = %q", rotated.Secret)
+	}
+	if rotated.PreviousSecret != "whsec_old" || !rotated.PreviousSecretValidUntil.Equal(e.Clock.Now().Add(webhooks.SecretGracePeriod)) {
+		t.Fatalf("previous secret = %q until %v", rotated.PreviousSecret, rotated.PreviousSecretValidUntil)
+	}
+
+	// Deliveries carry the new secret's signature first, then the previous one's, for 24 hours.
+	publish := func() ([]byte, string) {
+		t.Helper()
+		if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := e.Webhooks.RunDue(ctx); err != nil {
+			t.Fatal(err)
+		}
+		reqs := e.HTTP.Requests()
+		last := reqs[len(reqs)-1]
+		return last.Body, last.Header.Get("Tally-Signature")
+	}
+	body, header := publish()
+	if n := strings.Count(header, ",v1="); n != 2 || !strings.HasPrefix(header, "t=") {
+		t.Fatalf("header = %q, want two v1 entries", header)
+	}
+	if err := webhooks.Verify(body, header, []string{rotated.Secret}, 0, e.Clock.Now()); err != nil {
+		t.Fatalf("new secret: %v", err)
+	}
+	if err := webhooks.Verify(body, header, []string{"whsec_old"}, 0, e.Clock.Now()); err != nil {
+		t.Fatalf("previous secret: %v", err)
+	}
+	if want := webhooks.SignatureHeader([]string{rotated.Secret, "whsec_old"}, e.Clock.Now(), body); header != want {
+		t.Fatalf("header = %q, want %q", header, want)
+	}
+
+	// Just before the window closes the previous secret still signs; at 24 hours only the new one does.
+	e.Clock.Advance(webhooks.SecretGracePeriod - time.Second)
+	body, header = publish()
+	if n := strings.Count(header, ",v1="); n != 2 {
+		t.Fatalf("23h59m59s after the rotation: header = %q", header)
+	}
+	e.Clock.Advance(time.Second)
+	body, header = publish()
+	if n := strings.Count(header, ",v1="); n != 1 {
+		t.Fatalf("24 hours after the rotation: header = %q", header)
+	}
+	if err := webhooks.Verify(body, header, []string{"whsec_old"}, 0, e.Clock.Now()); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Fatalf("previous secret after 24 hours: %v", err)
+	}
+	if err := webhooks.Verify(body, header, []string{rotated.Secret}, 0, e.Clock.Now()); err != nil {
+		t.Fatalf("new secret after 24 hours: %v", err)
+	}
+
+	// A second rotation drops the oldest secret at once: only the current and the one before it sign.
+	e.Clock.Advance(time.Hour)
+	e.MustDo(http.StatusOK, "POST", path, e.Acme.Key, nil, &rotated)
+	secondNew := rotated.Secret
+	body, header = publish()
+	if n := strings.Count(header, ",v1="); n != 2 {
+		t.Fatalf("after a second rotation: header = %q", header)
+	}
+	if err := webhooks.Verify(body, header, []string{"whsec_old"}, 0, e.Clock.Now()); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Fatalf("the oldest secret still signs: %v", err)
+	}
+	if err := webhooks.Verify(body, header, []string{secondNew}, 0, e.Clock.Now()); err != nil {
+		t.Fatalf("current secret: %v", err)
+	}
+
+	// The window is kept in snapshots, so a restart does not cut it short.
+	st, err := store.FromState(e.Store.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	restored, ok := st.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if !ok || restored.PreviousSecret == "" || !restored.PreviousSecretValidUntil.Equal(rotated.PreviousSecretValidUntil) {
+		t.Fatalf("restored endpoint = %+v", restored)
+	}
+}
