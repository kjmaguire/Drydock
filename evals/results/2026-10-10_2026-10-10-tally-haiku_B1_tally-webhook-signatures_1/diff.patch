+// RotateSecret gives an endpoint a new signing secret and returns the endpoint. The secret it had keeps signing the
+// endpoint's deliveries for SecretGracePeriod; a rotation within that period replaces it at once.
+func (s *Service) RotateSecret(orgID, endpointID string) (store.WebhookEndpoint, error) {
+	now := s.clock.Now()
+	return s.store.UpdateWebhookEndpoint(orgID, endpointID, func(ep *store.WebhookEndpoint) error {
+		ep.PreviousSecret = ep.Secret
+		ep.PreviousSecretValidUntil = now.Add(SecretGracePeriod)
+		ep.Secret = NewSecret()
+		return nil
+	})
+}
