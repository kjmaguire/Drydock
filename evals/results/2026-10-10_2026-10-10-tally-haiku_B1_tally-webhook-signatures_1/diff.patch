+// signed returns the HMAC-SHA256 of "<t>.<body>" keyed with secret, where t is a Unix time in seconds.
+func signed(secret string, t int64, body []byte) []byte {
+	m := hmac.New(sha256.New, []byte(secret))
+	m.Write([]byte(strconv.FormatInt(t, 10) + "."))
+	m.Write(body)
+	return m.Sum(nil)
+}
+
+// SignatureHeader returns the Tally-Signature header of a delivery of body sent at t: "t=<unix seconds>" and a "v1=" entry
+// for each secret, in the order given (current first).
+func SignatureHeader(secrets []string, t time.Time, body []byte) string {
+	ts := t.Unix()
+	var b strings.Builder
+	b.WriteString("t=" + strconv.FormatInt(ts, 10))
+	for _, secret := range secrets {
+		b.WriteString(",v1=" + hex.EncodeToString(signed(secret, ts, body)))
+	}
+	return b.String()
+}
+
+// Verify checks a delivery's Tally-Signature header against its payload. It returns nil when the header's timestamp is
+// within tolerance of now (either way; 0 means DefaultTolerance) and one of its v1 entries is the signature of the payload
+// under one of the secrets. The comparison is in constant time.
+func Verify(payload []byte, header string, secrets []string, tolerance time.Duration, now time.Time) error {
+	if strings.TrimSpace(header) == "" {
+		return fmt.Errorf("%w: the header is empty", ErrMalformedHeader)
+	}
+	var (
+		ts    int64
+		hasTS bool
+		sigs  []string
+	)
+	for _, pair := range strings.Split(header, ",") {
+		k, v, ok := strings.Cut(pair, "=")
+		if !ok {
+			return fmt.Errorf("%w: %q is not key=value", ErrMalformedHeader, strings.TrimSpace(pair))
+		}
+		k, v = strings.TrimSpace(k), strings.TrimSpace(v)
+		switch k {
+		case "t":
+			n, err := strconv.ParseInt(v, 10, 64)
+			if err != nil {
+				return fmt.Errorf("%w: the timestamp %q is not an integer", ErrMalformedHeader, v)
+			}
+			if !hasTS {
+				ts, hasTS = n, true
+			}
+		case "v1":
+			sigs = append(sigs, v)
+		}
+	}
+	if !hasTS {
+		return ErrNoTimestamp
+	}
+	if tolerance <= 0 {
+		tolerance = DefaultTolerance
+	}
+	at := time.Unix(ts, 0)
+	if now.Before(at.Add(-tolerance)) || now.After(at.Add(tolerance)) {
+		return fmt.Errorf("%w: the timestamp is %d and the time is %d", ErrTimestampTolerance, ts, now.Unix())
+	}
+	if len(sigs) == 0 {
+		return ErrNoSignature
+	}
+	for _, sig := range sigs {
+		got, err := hex.DecodeString(sig)
+		if err != nil {
+			continue
+		}
+		for _, secret := range secrets {
+			if hmac.Equal(got, signed(secret, ts, payload)) {
+				return nil
+			}
+		}
+	}
+	return ErrSignatureMismatch
+}
