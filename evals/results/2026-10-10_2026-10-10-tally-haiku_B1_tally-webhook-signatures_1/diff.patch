+func TestVerify(t *testing.T) {
+	body := []byte(`{"id":"evt_1","type":"invoice.paid"}`)
+	now := time.Unix(1_700_000_000, 0)
+	ts := now.Unix()
+	header := func(secrets ...string) string { return webhooks.SignatureHeader(secrets, now, body) }
+	v1 := hmacV1("whsec_new", ts, body)
+	errs := []struct {
+		name   string
+		header string
+		secret []string
+		tol    time.Duration
+		now    time.Time
+		want   error
+	}{
+		{"valid", header("whsec_new"), []string{"whsec_new"}, 0, now, nil},
+		{"spaces and unknown keys", fmt.Sprintf(" v0=ff , t = %d ,  v1=%s ", ts, v1), []string{"whsec_new"}, 0, now, nil},
+		{"uppercase hex", fmt.Sprintf("t=%d,v1=%s", ts, strings.ToUpper(v1)), []string{"whsec_new"}, 0, now, nil},
+		{"new secret of two", header("whsec_new", "whsec_old"), []string{"whsec_new"}, 0, now, nil},
+		{"previous secret of two", header("whsec_new", "whsec_old"), []string{"whsec_old"}, 0, now, nil},
+		{"any of several secrets", header("whsec_new"), []string{"whsec_x", "whsec_y", "whsec_new"}, 0, now, nil},
+		{"wrong secret", header("whsec_new"), []string{"whsec_other"}, 0, now, webhooks.ErrSignatureMismatch},
+		{"no secrets", header("whsec_new"), nil, 0, now, webhooks.ErrSignatureMismatch},
+		{"v1 not hex", fmt.Sprintf("t=%d,v1=zz", ts), []string{"whsec_new"}, 0, now, webhooks.ErrSignatureMismatch},
+		{"timestamp changed", fmt.Sprintf("t=%d,v1=%s", ts+1, v1), []string{"whsec_new"}, 0, now, webhooks.ErrSignatureMismatch},
+		{"exactly the default tolerance ahead", header("whsec_new"), []string{"whsec_new"}, 0, now.Add(-5 * time.Minute), nil},
+		{"exactly the default tolerance behind", header("whsec_new"), []string{"whsec_new"}, 0, now.Add(5 * time.Minute), nil},
+		{"past the default tolerance", header("whsec_new"), []string{"whsec_new"}, 0, now.Add(5*time.Minute + time.Second), webhooks.ErrTimestampTolerance},
+		{"future past the default tolerance", header("whsec_new"), []string{"whsec_new"}, 0, now.Add(-5*time.Minute - time.Second), webhooks.ErrTimestampTolerance},
+		{"explicit tolerance", header("whsec_new"), []string{"whsec_new"}, time.Hour, now.Add(30 * time.Minute), nil},
+		{"explicit tolerance exceeded", header("whsec_new"), []string{"whsec_new"}, time.Minute, now.Add(2 * time.Minute), webhooks.ErrTimestampTolerance},
+		{"empty header", "", []string{"whsec_new"}, 0, now, webhooks.ErrMalformedHeader},
+		{"blank header", "  ", []string{"whsec_new"}, 0, now, webhooks.ErrMalformedHeader},
+		{"pair without =", fmt.Sprintf("t=%d,v1", ts), []string{"whsec_new"}, 0, now, webhooks.ErrMalformedHeader},
+		{"timestamp not an integer", "t=yesterday,v1=" + v1, []string{"whsec_new"}, 0, now, webhooks.ErrMalformedHeader},
+		{"timestamp with a fraction", fmt.Sprintf("t=%d.5,v1=%s", ts, v1), []string{"whsec_new"}, 0, now, webhooks.ErrMalformedHeader},
+		{"no timestamp", "v1=" + v1, []string{"whsec_new"}, 0, now, webhooks.ErrNoTimestamp},
+		{"no signature", fmt.Sprintf("t=%d", ts), []string{"whsec_new"}, 0, now, webhooks.ErrNoSignature},
+		{"only other schemes", fmt.Sprintf("t=%d,v0=%s", ts, v1), []string{"whsec_new"}, 0, now, webhooks.ErrNoSignature},
+		{"old and unsigned", fmt.Sprintf("t=%d", ts), []string{"whsec_new"}, 0, now.Add(time.Hour), webhooks.ErrTimestampTolerance},
+		{"malformed before no timestamp", "v1=" + v1 + ",oops", []string{"whsec_new"}, 0, now, webhooks.ErrMalformedHeader},
+		{"no timestamp before tolerance", "v1=" + v1, []string{"whsec_new"}, 0, now.Add(time.Hour), webhooks.ErrNoTimestamp},
+	}
+	for _, c := range errs {
+		err := webhooks.Verify(body, c.header, c.secret, c.tol, c.now)
+		if c.want == nil && err != nil {
+			t.Errorf("%s: Verify = %v", c.name, err)
+		}
+		if c.want != nil && !errors.Is(err, c.want) {
+			t.Errorf("%s: Verify = %v, want %v", c.name, err, c.want)
+		}
+	}
+	if err := webhooks.Verify([]byte(`{"id":"evt_2"}`), header("whsec_new"), []string{"whsec_new"}, 0, now); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Errorf("a changed body: Verify = %v", err)
+	}
+}
