+// A free plan's renewals and an invoice stored without lines used to panic when the API described them (a 500 for the
+// whole invoice list); every invoice shows, with an empty description when it has no lines.
+func TestInvoicesWithoutLinesAnswer(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	free := e.CreatePlan(e.Acme, "Free", "USD", "0")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": free.ID, "quantity": 2}, &sub)
+
+	stored, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: "USD"}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var list struct {
+		Items []struct{ ID, Description, Status string }
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices", e.Acme.Key, nil, &list)
+	if len(list.Items) != 2 {
+		t.Fatalf("invoices = %+v", list.Items)
+	}
+	first := list.Items[0]
+	if !strings.HasPrefix(first.Description, "Free, ") || first.Status != string(store.InvoicePaid) {
+		t.Fatalf("free plan's invoice = %+v", first)
+	}
+	if list.Items[1].ID != stored.ID || list.Items[1].Description != "" {
+		t.Fatalf("invoice without lines = %+v", list.Items[1])
+	}
+
+	var got struct{ ID, Description string }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+stored.ID, e.Acme.Key, nil, &got)
+	if got.Description != "" {
+		t.Fatalf("invoice without lines = %+v", got)
+	}
+	var paid struct {
+		Invoice struct{ Status string } `json:"invoice"`
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+stored.ID+"/pay", e.Acme.Key, nil, &paid)
+	if paid.Invoice.Status != string(store.InvoicePaid) || len(e.Gateway.Calls()) != 0 {
+		t.Fatalf("paying an invoice with nothing to charge = %+v, charges %+v", paid, e.Gateway.Calls())
+	}
+}
