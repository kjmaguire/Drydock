+func TestFreePlanIsInvoicedWithOneLineAndPaidAtOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Free", Currency: money.USD, UnitAmount: 0, Interval: store.Monthly}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 2})
+	if err != nil || sub.Status != store.Active {
+		t.Fatalf("subscription = %+v, %v", sub, err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %+v, want the first period and its renewal", invs)
+	}
+	for _, inv := range invs {
+		if len(inv.Lines) != 1 || inv.Lines[0].Quantity != 2 || inv.Lines[0].UnitAmount != 0 || inv.Lines[0].Description == "" ||
+			inv.Status != store.InvoicePaid || inv.PaidAt == nil {
+			t.Fatalf("free invoice = %+v", inv)
+		}
+	}
+	if !strings.HasPrefix(invs[1].Lines[0].Description, "Free, ") {
+		t.Fatalf("renewal line = %+v", invs[1].Lines[0])
+	}
+	if cs := e.Gateway.Calls(); len(cs) != 0 {
+		t.Fatalf("a free plan was charged: %+v", cs)
+	}
+}
