+func TestListInvoicesFollowsStatusChanges(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	inv, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.UpdateInvoice(a.ID, inv.ID, func(x *Invoice) error { x.Status = InvoiceVoid; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if got := s.ListInvoices(a.ID, InvoiceFilter{Status: InvoiceOpen}); len(got) != 0 {
+		t.Fatalf("open invoices after voiding = %v", invoiceIDs(got))
+	}
+	if got := walkInvoicePages(t, s, a.ID, InvoiceFilter{Status: InvoiceVoid}, 1); !reflect.DeepEqual(got, []string{inv.ID}) {
+		t.Fatalf("void invoices = %v", got)
+	}
+}
