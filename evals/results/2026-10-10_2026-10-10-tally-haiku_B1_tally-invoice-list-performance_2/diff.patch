+func TestListInvoicesPagesMatchWholeList(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Ben", "ben@example.com", t0)
+	// Creation order is not time order, several invoices share a time, and the organizations' invoices interleave.
+	minutes := []int{5, 1, 3, 3, 0, 5, 2, 3, 1, 4, 0, 4}
+	for i, m := range minutes {
+		org, c := a, ca
+		if i%3 == 2 {
+			org, c = b, cb
+		}
+		inv := Invoice{OrgID: org.ID, CustomerID: c.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}
+		if i%4 != 3 {
+			inv.SubscriptionID = fmt.Sprintf("sub_%d", i%2)
+		}
+		created, err := s.CreateInvoice(inv, t0.Add(time.Duration(m)*time.Minute))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i == 4 {
+			if _, err := s.UpdateInvoice(org.ID, created.ID, func(x *Invoice) error { x.Status = InvoicePaid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if i == 7 {
+			if _, err := s.UpdateInvoice(org.ID, created.ID, func(x *Invoice) error { x.Status = InvoiceVoid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	filters := []InvoiceFilter{
+		{}, {CustomerID: ca.ID}, {CustomerID: cb.ID}, {CustomerID: "cus_nope"}, {SubscriptionID: "sub_0"}, {SubscriptionID: "sub_1"},
+		{Status: InvoiceOpen}, {Status: InvoicePaid}, {Status: InvoiceVoid}, {CustomerID: ca.ID, Status: InvoiceOpen},
+		{SubscriptionID: "sub_1", Status: InvoicePaid},
+	}
+	for _, org := range []Org{a, b} {
+		for _, f := range filters {
+			want := wantInvoiceIDs(s, org.ID, f)
+			if got := s.ListInvoices(org.ID, f); !reflect.DeepEqual(invoiceIDs(got), want) {
+				t.Fatalf("ListInvoices(%+v) = %v, want %v", f, invoiceIDs(got), want)
+			}
+			for limit := 1; limit <= len(want)+1; limit++ {
+				if got := walkInvoicePages(t, s, org.ID, f, limit); !reflect.DeepEqual(got, want) {
+					t.Fatalf("pages of %d for %+v = %v, want %v", limit, f, got, want)
+				}
+			}
+		}
+	}
+}
+
+func invoiceIDs(invs []Invoice) []string {
+	ids := []string{}
+	for _, inv := range invs {
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
