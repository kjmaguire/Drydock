+// invoiceAfter reports whether inv comes after the invoice created at t with ID id, in an organization's list (oldest
+// first, ties by ID).
+func invoiceAfter(t time.Time, id string, inv Invoice) bool {
+	if !t.Equal(inv.CreatedAt) {
+		return t.Before(inv.CreatedAt)
+	}
+	return id < inv.ID
+}
