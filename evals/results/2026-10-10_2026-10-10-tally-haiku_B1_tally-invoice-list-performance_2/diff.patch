+package api_test
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+// listedInvoice is the part of an invoice in a list answer that these tests read.
+type listedInvoice struct {
+	ID         string `json:"id"`
+	CustomerID string `json:"customer_id"`
+	Customer   *struct {
+		ID   string `json:"id"`
+		Name string `json:"name"`
+	} `json:"customer"`
+}
+
+type invoicePage struct {
+	Items      []listedInvoice `json:"items"`
+	NextCursor string          `json:"next_cursor"`
+}
+
+// invoiceCursor is the cursor that starts a page just after inv, as the API writes them.
+func invoiceCursor(inv store.Invoice) string {
+	b, _ := json.Marshal(map[string]any{"t": inv.CreatedAt, "id": inv.ID})
+	return base64.RawURLEncoding.EncodeToString(b)
+}
+
+// withQuery adds a query parameter to a path that may already have a query.
+func withQuery(path, param string) string {
+	if strings.Contains(path, "?") {
+		return path + "&" + param
+	}
+	return path + "?" + param
+}
+
+// walkInvoices follows next_cursor from path, with pages of limit, and returns the invoices it sees.
+func walkInvoices(t *testing.T, e *apitest.Env, key, path string, limit int) []listedInvoice {
+	t.Helper()
+	var all []listedInvoice
+	first := withQuery(path, fmt.Sprintf("limit=%d", limit))
+	p := first
+	for pages := 0; ; pages++ {
+		if pages > 100000 {
+			t.Fatalf("paging %s does not end", path)
+		}
+		var page invoicePage
+		e.MustDo(http.StatusOK, "GET", p, key, nil, &page)
+		if len(page.Items) > limit {
+			t.Fatalf("%s returned %d items for limit %d", path, len(page.Items), limit)
+		}
+		all = append(all, page.Items...)
+		if page.NextCursor == "" {
+			return all
+		}
+		p = withQuery(first, "cursor="+page.NextCursor)
+	}
+}
+
+// expectedInvoiceIDs is the answer a list should give, computed from the store's export: the invoices of org that match
+// the filter, oldest first, ties by ID.
+func expectedInvoiceIDs(e *apitest.Env, orgID string, match func(store.Invoice) bool) []string {
+	var invs []store.Invoice
+	for _, inv := range e.Store.Export().Invoices {
+		if inv.OrgID == orgID && match(inv) {
+			invs = append(invs, inv)
+		}
+	}
+	sort.Slice(invs, func(i, j int) bool {
+		if !invs[i].CreatedAt.Equal(invs[j].CreatedAt) {
+			return invs[i].CreatedAt.Before(invs[j].CreatedAt)
+		}
+		return invs[i].ID < invs[j].ID
+	})
+	ids := []string{}
+	for _, inv := range invs {
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
+
+func listedIDs(invs []listedInvoice) []string {
+	ids := []string{}
+	for _, inv := range invs {
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
+
+func TestListInvoicesPagesFollowTheList(t *testing.T) {
+	e := apitest.New(t)
+	base := apitest.Start
+	ann, err := e.Store.CreateCustomer(e.Acme.ID, "Ann", "ann@example.com", base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bob, err := e.Store.CreateCustomer(e.Acme.ID, "Bob", "bob@example.com", base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, err := e.Store.CreateCustomer(e.Globex.ID, "Gil", "gil@example.com", base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	create := func(org apitest.Org, c store.Customer, sub string, at time.Time) store.Invoice {
+		inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: org.ID, CustomerID: c.ID, SubscriptionID: sub, Currency: money.USD,
+			Lines: []store.Line{{Description: "Seats", Quantity: 2, UnitAmount: 500}}}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	// Creation order is not time order, several invoices share a time, and Globex's invoices interleave.
+	for i, m := range []int{3, 1, 2, 2, 0, 4, 1, 3, 0, 2} {
+		c := ann
+		if i%2 == 1 {
+			c = bob
+		}
+		sub := ""
+		if i%3 == 0 {
+			sub = "sub_1"
+		}
+		inv := create(e.Acme, c, sub, base.Add(time.Duration(m)*time.Minute))
+		if i == 2 {
+			if _, err := e.Store.UpdateInvoice(e.Acme.ID, inv.ID, func(x *store.Invoice) error { x.Status = store.InvoicePaid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if i == 5 {
+			if _, err := e.Store.UpdateInvoice(e.Acme.ID, inv.ID, func(x *store.Invoice) error { x.Status = store.InvoiceVoid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+		create(e.Globex, other, "", base.Add(time.Duration(m)*time.Minute))
+	}
+	// Bob is deleted (his invoices show no customer) and Ann is renamed (her invoices show the new name).
+	if err := e.Store.DeleteCustomer(e.Acme.ID, bob.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.Store.UpdateCustomer(e.Acme.ID, ann.ID, func(c *store.Customer) error { c.Name = "Ann Lee"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+
+	filters := map[string]func(store.Invoice) bool{
+		"":                                   func(store.Invoice) bool { return true },
+		"?status=open":                       func(inv store.Invoice) bool { return inv.Status == store.InvoiceOpen },
+		"?status=paid":                       func(inv store.Invoice) bool { return inv.Status == store.InvoicePaid },
+		"?status=void":                       func(inv store.Invoice) bool { return inv.Status == store.InvoiceVoid },
+		"?customer_id=" + ann.ID:             func(inv store.Invoice) bool { return inv.CustomerID == ann.ID },
+		"?customer_id=" + other.ID:           func(inv store.Invoice) bool { return inv.CustomerID == other.ID },
+		"?subscription_id=sub_1":             func(inv store.Invoice) bool { return inv.SubscriptionID == "sub_1" },
+		"?subscription_id=sub_1&status=open": func(inv store.Invoice) bool { return inv.SubscriptionID == "sub_1" && inv.Status == store.InvoiceOpen },
+	}
+	for query, match := range filters {
+		want := expectedInvoiceIDs(e, e.Acme.ID, match)
+		for _, limit := range []int{1, 2, 3, 100} {
+			if got := listedIDs(walkInvoices(t, e, e.Acme.Key, "/v1/invoices"+query, limit)); !reflect.DeepEqual(got, want) {
+				t.Fatalf("pages of %d for %q = %v, want %v", limit, query, got, want)
+			}
+		}
+	}
+
+	// Views: a deleted customer is null, a renamed one shows its name.
+	for _, inv := range walkInvoices(t, e, e.Acme.Key, "/v1/invoices", 100) {
+		switch inv.CustomerID {
+		case bob.ID:
+			if inv.Customer != nil {
+				t.Fatalf("invoice %s of a deleted customer shows %+v", inv.ID, inv.Customer)
+			}
+		case ann.ID:
+			if inv.Customer == nil || inv.Customer.Name != "Ann Lee" {
+				t.Fatalf("invoice %s shows customer %+v, want Ann Lee", inv.ID, inv.Customer)
+			}
+		}
+	}
+
+	e.MustDo(http.StatusBadRequest, "GET", "/v1/invoices?status=lost", e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusBadRequest, "GET", "/v1/invoices?cursor=zz", e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusBadRequest, "GET", "/v1/invoices?limit=101", e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?customer_id="+other.ID, e.Acme.Key, nil, nil)
+}
+
+func TestListInvoicesFollowsNewInvoices(t *testing.T) {
+	e := apitest.New(t)
+	base := apitest.Start
+	c, err := e.Store.CreateCustomer(e.Acme.ID, "Ann", "ann@example.com", base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	add := func(at time.Time) store.Invoice {
+		inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: money.USD,
+			Lines: []store.Line{{Description: "Seats", Quantity: 1, UnitAmount: 100}}}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	for m := 0; m < 5; m++ {
+		add(base.Add(time.Duration(m) * time.Minute))
+	}
+	var first invoicePage
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=2", e.Acme.Key, nil, &first)
+	if len(first.Items) != 2 || first.NextCursor == "" {
+		t.Fatalf("first page = %+v", first)
+	}
+	// Invoices created between two requests: one after everything, and one that sorts before the cursor.
+	newest := add(base.Add(time.Hour))
+	early := add(base.Add(30 * time.Second))
+	var rest invoicePage
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=100&cursor="+first.NextCursor, e.Acme.Key, nil, &rest)
+	want := expectedInvoiceIDs(e, e.Acme.ID, func(store.Invoice) bool { return true })
+	cut := 0
+	for want[cut] != first.Items[len(first.Items)-1].ID {
+		cut++
+	}
+	if got := listedIDs(rest.Items); !reflect.DeepEqual(got, want[cut+1:]) || rest.Items[len(rest.Items)-1].ID != newest.ID || rest.NextCursor != "" {
+		t.Fatalf("rest = %v (next %q), want %v ending with %s (and not %s)", got, rest.NextCursor, want[cut+1:], newest.ID, early.ID)
+	}
+	if got := walkInvoices(t, e, e.Acme.Key, "/v1/invoices", 2); !reflect.DeepEqual(listedIDs(got), want) {
+		t.Fatalf("a walk after the new invoices = %v, want %v", listedIDs(got), want)
+	}
+}
+
+// largeOrg fills e with the target workload: Acme has 60,000 invoices for 5,000 customers and Globex has 60,000 of its own.
+// It returns Acme's invoices, oldest first.
+func largeOrg(t testing.TB, e *apitest.Env) []store.Invoice {
+	t.Helper()
+	base := apitest.Start
+	customers := make([]store.Customer, 5000)
+	for i := range customers {
+		c, err := e.Store.CreateCustomer(e.Acme.ID, fmt.Sprintf("Customer %d", i), fmt.Sprintf("c%d@acme.example", i), base)
+		if err != nil {
+			t.Fatal(err)
+		}
+		customers[i] = c
+	}
+	gil, err := e.Store.CreateCustomer(e.Globex.ID, "Gil", "gil@globex.example", base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var acme []store.Invoice
+	for i := 0; i < 60000; i++ {
+		at := base.Add(time.Duration(i) * time.Second)
+		sub := ""
+		if i%3 == 0 {
+			sub = fmt.Sprintf("sub_%d", i%50)
+		}
+		inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: customers[i%len(customers)].ID, SubscriptionID: sub, Currency: money.USD,
+			Lines: []store.Line{{Description: "Seats", Quantity: int64(1 + i%5), UnitAmount: 1000}}}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		acme = append(acme, inv)
+		if i%7 == 0 {
+			if _, err := e.Store.UpdateInvoice(e.Acme.ID, inv.ID, func(x *store.Invoice) error { x.Status = store.InvoicePaid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if i%11 == 0 {
+			if _, err := e.Store.UpdateInvoice(e.Acme.ID, inv.ID, func(x *store.Invoice) error { x.Status = store.InvoiceVoid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if _, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Globex.ID, CustomerID: gil.ID, Currency: money.USD,
+			Lines: []store.Line{{Description: "Seats", Quantity: 1, UnitAmount: 1000}}}, at.Add(500*time.Millisecond)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return acme
+}
+
+// TestListInvoicesLargeOrganizationPagesAreFast checks the brief's target: a page of GET /v1/invoices answers within 250
+// milliseconds for an organization with 60,000 invoices and 5,000 customers, with another organization's invoices in the store
+// too. Each request is timed three times and the fastest counts, to keep a busy machine from failing it.
+func TestListInvoicesLargeOrganizationPagesAreFast(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds 120,000 invoices")
+	}
+	e := apitest.New(t)
+	acme := largeOrg(t, e)
+	deep := invoiceCursor(acme[50000])
+	paths := []string{
+		"/v1/invoices",
+		"/v1/invoices?limit=100",
+		"/v1/invoices?cursor=" + deep,
+		"/v1/invoices?status=open&cursor=" + deep,
+		"/v1/invoices?status=void&limit=100",
+		"/v1/invoices?status=paid&limit=100",
+		"/v1/invoices?customer_id=" + acme[0].CustomerID,
+		"/v1/invoices?customer_id=" + acme[0].CustomerID + "&cursor=" + deep,
+		"/v1/invoices?subscription_id=sub_1&limit=100",
+		"/v1/invoices?subscription_id=sub_1&status=open&cursor=" + deep,
+	}
+	for _, p := range paths {
+		fastest := time.Duration(1<<63 - 1)
+		for i := 0; i < 3; i++ {
+			start := time.Now()
+			e.MustDo(http.StatusOK, "GET", p, e.Acme.Key, nil, nil)
+			fastest = min(fastest, time.Since(start))
+		}
+		t.Logf("GET %s: %v", p, fastest)
+		if fastest > 250*time.Millisecond {
+			t.Errorf("GET %s took %v", p, fastest)
+		}
+	}
+}
