+func (s *Store) indexInvoice(inv Invoice) {
+	ids := s.invoicesByOrg[inv.OrgID]
+	i := sort.Search(len(ids), func(i int) bool { return invoiceAfter(inv.CreatedAt, inv.ID, s.invoices[ids[i]]) })
+	s.invoicesByOrg[inv.OrgID] = slices.Insert(ids, i, inv.ID)
