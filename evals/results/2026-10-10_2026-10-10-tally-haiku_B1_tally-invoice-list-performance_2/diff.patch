+func TestListInvoicesAfterSeesInsertsBetweenPages(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	add := func(at time.Time) Invoice {
+		inv, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	for m := 0; m < 4; m++ {
+		add(t0.Add(time.Duration(10+m) * time.Minute))
+	}
+	first, more := s.ListInvoicesAfter(a.ID, InvoiceFilter{}, time.Time{}, "", 2)
+	if !more || len(first) != 2 {
+		t.Fatalf("first page = %d items, more %v", len(first), more)
+	}
+	last := first[1]
+	// One invoice lands before the cursor (a clock that moved back), one after everything.
+	add(t0.Add(5 * time.Minute))
+	after := add(t0.Add(time.Hour))
+	page, more := s.ListInvoicesAfter(a.ID, InvoiceFilter{}, last.CreatedAt, last.ID, 10)
+	if more {
+		t.Fatalf("the rest should fit one page: %v", invoiceIDs(page))
+	}
+	all := wantInvoiceIDs(s, a.ID, InvoiceFilter{})
+	pos := 0
+	for all[pos] != last.ID {
+		pos++
+	}
+	// The rest of the list, which is everything after the cursor's position, the invoice that landed before it excluded.
+	if want := all[pos+1:]; !reflect.DeepEqual(invoiceIDs(page), want) || page[len(page)-1].ID != after.ID {
+		t.Fatalf("rest after the cursor = %v, want %v ending with %s", invoiceIDs(page), want, after.ID)
+	}
+	if !reflect.DeepEqual(walkInvoicePages(t, s, a.ID, InvoiceFilter{}, 1), all) {
+		t.Fatal("a walk after the inserts does not match the whole list")
+	}
+}
