+// wantInvoiceIDs is the answer a list should give, computed without the store's own list code: the invoices of the
+// organization that match f, sorted by creation time then ID.
+func wantInvoiceIDs(s *Store, orgID string, f InvoiceFilter) []string {
+	var matching []Invoice
+	for _, inv := range s.Export().Invoices {
+		if inv.OrgID != orgID || (f.CustomerID != "" && inv.CustomerID != f.CustomerID) ||
+			(f.SubscriptionID != "" && inv.SubscriptionID != f.SubscriptionID) || (f.Status != "" && inv.Status != f.Status) {
+			continue
+		}
+		matching = append(matching, inv)
+	}
+	sort.Slice(matching, func(i, j int) bool {
+		if !matching[i].CreatedAt.Equal(matching[j].CreatedAt) {
+			return matching[i].CreatedAt.Before(matching[j].CreatedAt)
+		}
+		return matching[i].ID < matching[j].ID
+	})
+	ids := []string{}
+	for _, inv := range matching {
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
+
+// walkInvoicePages follows ListInvoicesAfter from the start, pages of limit, and returns the IDs it sees.
+func walkInvoicePages(t *testing.T, s *Store, orgID string, f InvoiceFilter, limit int) []string {
+	t.Helper()
+	ids := []string{}
+	var afterT time.Time
+	afterID := ""
+	for pages := 0; ; pages++ {
+		if pages > 10000 {
+			t.Fatal("paging does not end")
+		}
+		page, more := s.ListInvoicesAfter(orgID, f, afterT, afterID, limit)
+		if len(page) > limit || (more && len(page) == 0) {
+			t.Fatalf("page of %d for limit %d (more %v)", len(page), limit, more)
+		}
+		for _, inv := range page {
+			ids = append(ids, inv.ID)
+		}
+		if !more {
+			return ids
+		}
+		last := page[len(page)-1]
+		afterT, afterID = last.CreatedAt, last.ID
+	}
+}
