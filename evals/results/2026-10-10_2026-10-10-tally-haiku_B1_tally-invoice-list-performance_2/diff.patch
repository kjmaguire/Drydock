+func TestFromStateRebuildsInvoiceOrder(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Ben", "ben@example.com", t0)
+	for i := 0; i < 20; i++ {
+		org, c := a, ca
+		if i%2 == 1 {
+			org, c = b, cb
+		}
+		if _, err := s.CreateInvoice(Invoice{OrgID: org.ID, CustomerID: c.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, t0.Add(time.Duration((i*7)%5)*time.Minute)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	st := s.Export()
+	for i, j := 0, len(st.Invoices)-1; i < j; i, j = i+1, j-1 {
+		st.Invoices[i], st.Invoices[j] = st.Invoices[j], st.Invoices[i]
+	}
+	loaded, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, org := range []Org{a, b} {
+		want := wantInvoiceIDs(s, org.ID, InvoiceFilter{})
+		if got := invoiceIDs(loaded.ListInvoices(org.ID, InvoiceFilter{})); !reflect.DeepEqual(got, want) {
+			t.Fatalf("loaded list = %v, want %v", got, want)
+		}
+		if got := walkInvoicePages(t, loaded, org.ID, InvoiceFilter{}, 3); !reflect.DeepEqual(got, want) {
+			t.Fatalf("loaded pages = %v, want %v", got, want)
+		}
+	}
+}
