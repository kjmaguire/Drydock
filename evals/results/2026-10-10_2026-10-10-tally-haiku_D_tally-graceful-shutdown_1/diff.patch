+// blocker returns a job that signals started and then runs until release is closed or its context ends.
+func blocker(name string, started, release chan struct{}) Job {
+	return Job{Name: name, Run: func(ctx context.Context) error {
+		close(started)
+		select {
+		case <-release:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}}
+}
+
+// names returns the job names in order.
+func names(jobs []Job) []string {
+	out := make([]string, 0, len(jobs))
+	for _, j := range jobs {
+		out = append(out, j.Name)
+	}
+	return out
+}
+
+// waitFor polls cond until it is true or 5 seconds pass.
+func waitFor(t *testing.T, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatal("condition not reached")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func TestEnqueueAfterShutdown(t *testing.T) {
+	r := NewRunner(2, 10, nil)
+	r.Start()
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	ran := false
+	err := r.Enqueue(Job{Name: "late", Run: func(context.Context) error { ran = true; return nil }})
+	if !errors.Is(err, ErrStopped) {
+		t.Fatalf("err = %v, want ErrStopped", err)
+	}
+	if ran {
+		t.Fatal("job enqueued after Shutdown ran")
+	}
+	if p := r.Pending(); len(p) != 0 {
+		t.Fatalf("Pending = %v, want none", names(p))
+	}
+}
+
+func TestShutdownWaitsForRunningJobs(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started, release := make(chan struct{}), make(chan struct{})
+	var finished atomic.Bool
+	if err := r.Enqueue(Job{Name: "slow", Run: func(ctx context.Context) error {
+		close(started)
+		<-release
+		finished.Store(true)
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	<-started
+	go func() {
+		time.Sleep(50 * time.Millisecond)
+		close(release)
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if err := r.Shutdown(ctx); err != nil {
+		t.Fatalf("Shutdown = %v, want nil", err)
+	}
+	if !finished.Load() {
+		t.Fatal("Shutdown returned before the running job finished")
+	}
+	if p := r.Pending(); len(p) != 0 {
+		t.Fatalf("Pending = %v, want none", names(p))
+	}
+}
+
+func TestShutdownCancelsRunningJobsWhenContextEnds(t *testing.T) {
