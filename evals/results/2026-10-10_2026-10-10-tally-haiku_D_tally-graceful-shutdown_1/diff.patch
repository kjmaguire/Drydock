+// Pending returns the jobs that still need to run, in enqueue order. Before Shutdown these are the queued
+// jobs not started yet. After Shutdown they are the jobs never started, then the jobs that Shutdown canceled
+// and that returned an error.
+func (r *Runner) Pending() []Job {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	sort.Slice(r.failed, func(i, j int) bool { return r.failed[i].seq < r.failed[j].seq })
+	jobs := make([]Job, 0, len(r.waiting)+len(r.failed))
+	for _, e := range r.waiting {
+		jobs = append(jobs, e.job)
+	}
+	for _, e := range r.failed {
+		jobs = append(jobs, e.job)
+	}
+	return jobs
 }
