+func TestPanickingJobIsRecovered(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	var panics atomic.Int32
+	if err := r.Enqueue(Job{Name: "boom", Run: func(context.Context) error {
+		panics.Add(1)
+		panic("boom")
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	ran := make(chan struct{})
+	if err := r.Enqueue(Job{Name: "after", Run: func(context.Context) error {
+		close(ran)
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-ran:
+	case <-time.After(5 * time.Second):
+		t.Fatal("worker did not go on after a panic")
+	}
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if n := panics.Load(); n != 1 {
+		t.Fatalf("panicking job ran %d times, want 1", n)
+	}
+	if p := r.Pending(); len(p) != 0 {
+		t.Fatalf("Pending = %v, want none", names(p))
+	}
+}
