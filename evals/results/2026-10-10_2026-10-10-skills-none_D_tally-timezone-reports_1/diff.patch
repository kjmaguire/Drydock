+	pay(1000, money.USD, store.PaymentSucceeded, at(3, 2, 22, 30)) // 03-03 in UTC, 03-02 in New York
+	pay(500, money.USD, store.PaymentSucceeded, at(3, 2, 9, 0))
+	pay(700, money.EUR, store.PaymentSucceeded, at(3, 3, 0, 0))
+	pay(999, money.USD, store.PaymentFailed, at(3, 2, 12, 0))
+	pay(300, money.USD, store.PaymentSucceeded, at(3, 4, 23, 59))
+	pay(100, money.USD, store.PaymentSucceeded, at(3, 5, 0, 0))  // after the range
