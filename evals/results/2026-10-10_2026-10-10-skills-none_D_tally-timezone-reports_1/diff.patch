+// RevenueReport adds up the organization's succeeded payments per bucket (a day, a week starting on Monday, or a calendar
+// month, by group; "" means day), in the organization's time zone. It answers every bucket from the one holding from to
+// the one holding to (YYYY-MM-DD, both included), in order, named by its first day, also those without payments.
+func RevenueReport(st *store.Store, orgID, from, to, group string) (Report, error) {
+	if group == "" {
+		group = GroupDay
+	}
+	if group != GroupDay && group != GroupWeek && group != GroupMonth {
+		return Report{}, fmt.Errorf("%w: %q", ErrInvalidGroup, group)
+	}
+	start, last, err := parseRange(from, to)
+	if err != nil {
+		return Report{}, err
+	}
+	payments, loc, err := successful(st, orgID, start, last)
+	if err != nil {
+		return Report{}, err
+	}
+	rep := Report{TimeZone: loc.String(), Group: group, Buckets: []Bucket{}}
+	index := map[string]int{}
+	for b := bucketStart(start, group); !b.After(last); b = nextBucket(b, group) {
+		index[b.Format(time.DateOnly)] = len(rep.Buckets)
+		rep.Buckets = append(rep.Buckets, Bucket{Start: b.Format(time.DateOnly), Amounts: map[money.Currency]int64{}})
+	}
+	for _, p := range payments {
+		b := &rep.Buckets[index[bucketStart(p.day, group).Format(time.DateOnly)]]
+		b.Amounts[p.cur] += p.amount
+		b.Payments++
+	}
+	return rep, nil
+}
+
+// bucketStart is the first day of the bucket of group that holds day (a civil date in UTC).
+func bucketStart(day time.Time, group string) time.Time {
+	switch group {
+	case GroupWeek:
+		return day.AddDate(0, 0, -((int(day.Weekday()) + 6) % 7))
+	case GroupMonth:
+		return time.Date(day.Year(), day.Month(), 1, 0, 0, 0, 0, time.UTC)
+	}
+	return day
+}
+
+// nextBucket is the first day of the bucket after the one starting on b.
+func nextBucket(b time.Time, group string) time.Time {
+	switch group {
+	case GroupWeek:
+		return b.AddDate(0, 0, 7)
+	case GroupMonth:
+		return b.AddDate(0, 1, 0)
+	}
+	return b.AddDate(0, 0, 1)
+}
