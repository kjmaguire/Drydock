+	pay(10, money.USD, store.PaymentSucceeded, at(3, 8, 0, 30))   // EST, still 03-08
+	pay(20, money.USD, store.PaymentSucceeded, at(3, 8, 23, 59))  // EDT, 03-09 in UTC, still 03-08
+	pay(40, money.USD, store.PaymentSucceeded, at(3, 9, 0, 0))    // EDT
