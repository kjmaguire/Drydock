+// paymentsFixture is an organization in time zone tz with one invoice, and a function that records a payment on it.
+func paymentsFixture(t *testing.T, tz string) (*store.Store, string, func(int64, money.Currency, store.PaymentStatus, time.Time)) {
+	t.Helper()
+	st := store.New()
+	utc := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	o, err := st.CreateOrg("A", store.OrgTeam, tz, 0, utc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, _ := st.CreateCustomer(o.ID, "Jane", "jane@example.com", utc)
+	inv, _ := st.CreateInvoice(store.Invoice{OrgID: o.ID, CustomerID: c.ID, Currency: money.USD, Lines: []store.Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, utc)
+	pay := func(amount int64, cur money.Currency, status store.PaymentStatus, at time.Time) {
+		if _, err := st.CreatePayment(store.Payment{OrgID: o.ID, InvoiceID: inv.ID, Amount: amount, Currency: cur, Status: status}, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return st, o.ID, pay
+}
+
+// summary lists each bucket as "start payments amounts", for comparing whole reports.
+func summary(rep Report) []string {
+	var out []string
+	for _, b := range rep.Buckets {
+		out = append(out, fmt.Sprintf("%s %d %v", b.Start, b.Payments, b.Amounts))
+	}
+	return out
+}
