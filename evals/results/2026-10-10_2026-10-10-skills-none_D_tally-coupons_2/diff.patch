+
+func TestCouponsCreateListAndGet(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+
+	var pct store.Coupon
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", key, map[string]any{"code": "SPRING-26", "percent_off": 10, "duration": "once"}, &pct)
+	if pct.Code != "SPRING-26" || pct.PercentOff == nil || *pct.PercentOff != 10 || pct.AmountOff != nil || pct.Duration != store.CouponOnce || pct.TimesRedeemed != 0 {
+		t.Fatalf("percent coupon = %+v", pct)
+	}
+
+	redeemBy := e.Clock.Now().AddDate(1, 0, 0).Format(time.RFC3339)
+	var amt store.Coupon
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", key, map[string]any{"code": "fiveoff", "amount_off": "5.00", "currency": "USD",
+		"duration": "repeating", "duration_in_months": 3, "max_redemptions": 10, "redeem_by": redeemBy}, &amt)
+	if amt.AmountOff == nil || *amt.AmountOff != 500 || amt.Currency != money.USD || amt.DurationInMonths != 3 || amt.MaxRedemptions == nil || *amt.MaxRedemptions != 10 || amt.RedeemBy == nil {
+		t.Fatalf("amount coupon = %+v", amt)
+	}
+
+	var got store.Coupon
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/FIVEOFF", key, nil, &got)
+	if got.ID != amt.ID || got.Code != "fiveoff" {
+		t.Fatalf("GET by code, ignoring case = %+v", got)
+	}
+	if r := e.Do("GET", "/v1/coupons/NOPE", key, nil); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("unknown coupon: %s", r)
+	}
+
+	var list struct{ Items []store.Coupon }
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons", key, nil, &list)
+	if len(list.Items) != 2 || list.Items[0].Code != "SPRING-26" || list.Items[1].Code != "fiveoff" {
+		t.Fatalf("list = %+v", list)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons", e.Globex.Key, nil, &list)
+	if len(list.Items) != 0 {
+		t.Fatalf("another organization sees %d coupons", len(list.Items))
+	}
+}
+
+func TestCouponCreateErrors(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", key, map[string]any{"code": "SPRING-26", "percent_off": 10, "duration": "once"}, nil)
+
+	if r := e.Do("POST", "/v1/coupons", key, map[string]any{"code": "spring-26", "percent_off": 5, "duration": "forever"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "code_taken" {
+		t.Fatalf("a code taken ignoring case: %s", r)
+	}
+	for _, body := range []map[string]any{
+		{"code": "ab", "percent_off": 10, "duration": "once"},
+		{"code": "NO SPACES", "percent_off": 10, "duration": "once"},
+		{"code": "BOTH", "percent_off": 10, "amount_off": "5.00", "currency": "USD", "duration": "once"},
+		{"code": "NEITHER", "duration": "once"},
+		{"code": "BIG", "percent_off": 101, "duration": "once"},
+		{"code": "ZERO", "percent_off": 0, "duration": "once"},
+		{"code": "CENTS", "amount_off": "5.001", "currency": "USD", "duration": "once"},
+		{"code": "NOCUR", "amount_off": "5.00", "duration": "once"},
+		{"code": "NOMONTHS", "percent_off": 10, "duration": "repeating"},
