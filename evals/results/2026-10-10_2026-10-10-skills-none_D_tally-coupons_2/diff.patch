+package store
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+func intPtr(n int) *int {
+	return &n
+}
+
+func int64Ptr(n int64) *int64 {
+	return &n
+}
+
+func timePtr(t time.Time) *time.Time {
+	return &t
+}
+
+// newSubscription adds an active subscription of org's, to a plan in cur, for a new customer with this email address.
+func newSubscription(t *testing.T, s *Store, org Org, email string, cur money.Currency) Subscription {
+	t.Helper()
+	c, err := s.CreateCustomer(org.ID, "Jane", email, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := s.CreatePlan(Plan{OrgID: org.ID, Name: "Team", Currency: cur, UnitAmount: 2000, Interval: Monthly}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := s.CreateSubscription(Subscription{OrgID: org.ID, CustomerID: c.ID, PlanID: p.ID, Quantity: 1, Status: Active,
+		CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+func TestCouponValidation(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	for _, c := range []Coupon{
+		{Code: "ab", PercentOff: intPtr(10), Duration: CouponOnce},
+		{Code: "has space", PercentOff: intPtr(10), Duration: CouponOnce},
+		{Code: strings.Repeat("a", 33), PercentOff: intPtr(10), Duration: CouponOnce},
+		{Code: "SAVE", PercentOff: intPtr(10), AmountOff: int64Ptr(500), Currency: money.USD, Duration: CouponOnce},
+		{Code: "SAVE", Duration: CouponOnce},
+		{Code: "SAVE", PercentOff: intPtr(0), Duration: CouponOnce},
+		{Code: "SAVE", PercentOff: intPtr(101), Duration: CouponOnce},
+		{Code: "SAVE", AmountOff: int64Ptr(0), Currency: money.USD, Duration: CouponOnce},
+		{Code: "SAVE", AmountOff: int64Ptr(500), Currency: "XYZ", Duration: CouponOnce},
+		{Code: "SAVE", PercentOff: intPtr(10), Duration: "weekly"},
+		{Code: "SAVE", PercentOff: intPtr(10), Duration: CouponRepeating},
+		{Code: "SAVE", PercentOff: intPtr(10), Duration: CouponRepeating, DurationInMonths: 37},
+		{Code: "SAVE", PercentOff: intPtr(10), Duration: CouponOnce, DurationInMonths: 3},
+		{Code: "SAVE", PercentOff: intPtr(10), Duration: CouponOnce, MaxRedemptions: intPtr(0)},
+	} {
+		c.OrgID = o.ID
+		if _, err := s.CreateCoupon(c, t0); !errors.Is(err, ErrInvalid) {
+			t.Errorf("CreateCoupon(%+v) = %v, want ErrInvalid", c, err)
+		}
+	}
+
+	for _, c := range []Coupon{
+		{Code: "abc", PercentOff: intPtr(100), Duration: CouponOnce},
+		{Code: "SPRING-26_x", PercentOff: intPtr(10), Duration: CouponForever},
+		{Code: strings.Repeat("Z", 32), PercentOff: intPtr(10), Duration: CouponRepeating, DurationInMonths: 36},
+		{Code: "FIVEOFF", AmountOff: int64Ptr(500), Currency: money.USD, Duration: CouponForever, MaxRedemptions: intPtr(1)},
+	} {
+		c.OrgID = o.ID
+		if _, err := s.CreateCoupon(c, t0); err != nil {
+			t.Errorf("CreateCoupon(%q) = %v", c.Code, err)
+		}
+	}
+	if c, _ := s.CouponByCode(o.ID, "FIVEOFF"); c.Currency != money.USD || *c.AmountOff != 500 || c.PercentOff != nil {
+		t.Fatalf("amount coupon = %+v", c)
+	}
+}
+
+func TestCouponCodesAreUniqueIgnoringCase(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	other := newOrg(t, s, "Globex")
+	c := Coupon{OrgID: o.ID, Code: "Spring-26", PercentOff: intPtr(10), Duration: CouponOnce}
+	if _, err := s.CreateCoupon(c, t0); err != nil {
+		t.Fatal(err)
+	}
+	c.Code = "SPRING-26"
+	if _, err := s.CreateCoupon(c, t0); !errors.Is(err, ErrCouponCodeTaken) || !errors.Is(err, ErrConflict) {
+		t.Fatalf("a code taken ignoring case: %v", err)
+	}
+	c.OrgID = other.ID
+	if _, err := s.CreateCoupon(c, t0); err != nil {
+		t.Fatalf("another organization's coupon with the same code: %v", err)
+	}
+	if got, ok := s.CouponByCode(o.ID, "spring-26"); !ok || got.Code != "Spring-26" {
+		t.Fatalf("CouponByCode = %+v, %v", got, ok)
+	}
+	if _, ok := s.CouponByCode(o.ID, "spring"); ok {
+		t.Fatal("found a coupon by a different code")
+	}
+}
+
+func TestCouponsOldestFirstWithTimesRedeemed(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	other := newOrg(t, s, "Globex")
+	if _, err := s.CreateCoupon(Coupon{OrgID: o.ID, Code: "LATER-ONE", PercentOff: intPtr(10), Duration: CouponOnce}, t0.Add(time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateCoupon(Coupon{OrgID: o.ID, Code: "FIRST-ONE", PercentOff: intPtr(10), Duration: CouponOnce}, t0); err != nil {
+		t.Fatal(err)
+	}
+	sub := newSubscription(t, s, o, "jane@example.com", money.USD)
+	if _, err := s.RedeemCoupon(o.ID, sub.ID, "FIRST-ONE", t0); err != nil {
+		t.Fatal(err)
+	}
+	got := s.Coupons(o.ID)
+	if len(got) != 2 || got[0].Code != "FIRST-ONE" || got[1].Code != "LATER-ONE" || got[0].TimesRedeemed != 1 || got[1].TimesRedeemed != 0 {
+		t.Fatalf("Coupons = %+v", got)
+	}
+	if n := len(s.Coupons(other.ID)); n != 0 {
+		t.Fatalf("another organization sees %d coupons", n)
+	}
+}
+
+func TestRedeemCoupon(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	sub := newSubscription(t, s, o, "jane@example.com", money.USD)
+	now := t0.Add(time.Hour)
+	if _, err := s.CreateCoupon(Coupon{OrgID: o.ID, Code: "SAVE10", PercentOff: intPtr(10), Duration: CouponForever}, t0); err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := s.RedeemCoupon(o.ID, sub.ID, "NOPE", now); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("an unknown coupon: %v", err)
+	}
+	got, err := s.RedeemCoupon(o.ID, sub.ID, "save10", now)
+	if err != nil || got.Coupon != "SAVE10" || got.CouponRedeemedAt == nil || !got.CouponRedeemedAt.Equal(now) {
+		t.Fatalf("RedeemCoupon = %+v, %v", got, err)
+	}
+	if stored, _ := s.Subscription(o.ID, sub.ID); stored.Coupon != "SAVE10" {
+		t.Fatalf("the subscription has coupon %q", stored.Coupon)
+	}
+	if _, err := s.RedeemCoupon(o.ID, sub.ID, "SAVE10", now); !errors.Is(err, ErrCouponAlreadyApplied) {
+		t.Fatalf("a second coupon: %v", err)
+	}
+	if c, _ := s.CouponByCode(o.ID, "SAVE10"); c.TimesRedeemed != 1 {
+		t.Fatalf("times redeemed = %d", c.TimesRedeemed)
+	}
+
+	if _, err := s.CreateCoupon(Coupon{OrgID: o.ID, Code: "OLD", PercentOff: intPtr(10), Duration: CouponOnce, RedeemBy: timePtr(t0)}, t0); err != nil {
+		t.Fatal(err)
+	}
+	other := newSubscription(t, s, o, "joe@example.com", money.USD)
+	if _, err := s.RedeemCoupon(o.ID, other.ID, "OLD", now); !errors.Is(err, ErrCouponExpired) {
+		t.Fatalf("an expired coupon: %v", err)
+	}
+
+	if _, err := s.CreateCoupon(Coupon{OrgID: o.ID, Code: "ONE", PercentOff: intPtr(10), Duration: CouponForever, MaxRedemptions: intPtr(1)}, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RedeemCoupon(o.ID, other.ID, "ONE", now); err != nil {
+		t.Fatal(err)
+	}
+	third := newSubscription(t, s, o, "ann@example.com", money.USD)
+	if _, err := s.RedeemCoupon(o.ID, third.ID, "ONE", now); !errors.Is(err, ErrCouponExhausted) {
+		t.Fatalf("an exhausted coupon: %v", err)
+	}
+
+	if _, err := s.CreateCoupon(Coupon{OrgID: o.ID, Code: "EURO5", AmountOff: int64Ptr(500), Currency: money.EUR, Duration: CouponForever}, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RedeemCoupon(o.ID, third.ID, "EURO5", now); !errors.Is(err, ErrCurrencyMismatch) {
+		t.Fatalf("an amount in another currency: %v", err)
+	}
+
+	canceled := newSubscription(t, s, o, "cy@example.com", money.USD)
+	if _, err := s.UpdateSubscription(o.ID, canceled.ID, func(x *Subscription) error { x.Status = Canceled; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RedeemCoupon(o.ID, canceled.ID, "SAVE10", now); !errors.Is(err, ErrSubscriptionCanceled) {
+		t.Fatalf("a canceled subscription: %v", err)
+	}
+}
