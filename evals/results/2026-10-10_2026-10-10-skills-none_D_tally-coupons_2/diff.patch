+++ b/result/internal/store/coupons.go
@@ -0,0 +1,179 @@
+package store
+
+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Coupon errors, returned by RedeemCoupon. Callers check them with errors.Is.
+var (
+	ErrCouponCodeTaken      = fmt.Errorf("%w: coupon code already in use", ErrConflict)
+	ErrCouponExpired        = errors.New("the coupon has expired")
+	ErrCouponExhausted      = errors.New("the coupon has no redemptions left")
+	ErrCouponAlreadyApplied = errors.New("the subscription already has a coupon")
+	ErrCurrencyMismatch     = errors.New("the coupon's currency is not the plan's currency")
+	// ErrSubscriptionCanceled is returned when a change is made to a canceled subscription.
+	ErrSubscriptionCanceled = errors.New("the subscription is canceled")
+)
+
+// couponCodeRe is what a coupon code may look like: 3 to 32 letters, digits, dashes or underscores.
+var couponCodeRe = regexp.MustCompile(`^[A-Za-z0-9_-]{3,32}$`)
+
+// couponKey finds a coupon by its code, ignoring case.
+type couponKey struct{ org, code string }
+
+func couponKeyOf(orgID, code string) couponKey { return couponKey{orgID, strings.ToLower(code)} }
+
+// CreateCoupon adds a coupon. Exactly one of PercentOff and AmountOff must be set; a repeating coupon needs
+// DurationInMonths and no other duration takes it. The code must be unique in the organization, ignoring case.
+func (s *Store) CreateCoupon(c Coupon, now time.Time) (Coupon, error) {
+	if err := checkCoupon(c); err != nil {
+		return Coupon{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[c.OrgID]; !ok {
+		return Coupon{}, ErrNotFound
+	}
+	if _, taken := s.couponsByKey[couponKeyOf(c.OrgID, c.Code)]; taken {
+		return Coupon{}, ErrCouponCodeTaken
+	}
+	c.ID = s.newID("cpn")
+	c.CreatedAt = now.UTC()
+	c.TimesRedeemed = 0
+	if c.AmountOff == nil {
+		c.Currency = ""
+	}
+	c = copyCoupon(c)
+	if c.RedeemBy != nil {
+		*c.RedeemBy = c.RedeemBy.UTC()
+	}
+	s.coupons[c.ID] = c
+	s.couponsByKey[couponKeyOf(c.OrgID, c.Code)] = c.ID
+	return s.couponView(c), nil
+}
+
+func checkCoupon(c Coupon) error {
+	switch {
+	case !couponCodeRe.MatchString(c.Code):
+		return invalid("a coupon code is 3 to 32 letters, digits, dashes or underscores")
+	case (c.PercentOff == nil) == (c.AmountOff == nil):
+		return invalid("a coupon takes percent_off or amount_off, exactly one")
+	case c.PercentOff != nil && (*c.PercentOff < 1 || *c.PercentOff > 100):
+		return invalid("percent_off is 1 to 100")
+	case c.AmountOff != nil && *c.AmountOff <= 0:
+		return invalid("amount_off must be more than 0")
+	case c.AmountOff != nil && !c.Currency.Valid():
+		return invalid("unknown currency %q", c.Currency)
+	case c.Duration == CouponRepeating && (c.DurationInMonths < 1 || c.DurationInMonths > 36):
+		return invalid("a repeating coupon lasts 1 to 36 months")
+	case c.Duration != CouponRepeating && c.DurationInMonths != 0:
+		return invalid("only a repeating coupon has duration_in_months")
+	case c.Duration != CouponOnce && c.Duration != CouponRepeating && c.Duration != CouponForever:
+		return invalid("a coupon's duration is once, repeating or forever")
+	case c.MaxRedemptions != nil && *c.MaxRedemptions < 1:
+		return invalid("max_redemptions is at least 1")
+	}
+	return nil
+}
+
+// CouponByCode returns one of an organization's coupons by its code, ignoring case.
+func (s *Store) CouponByCode(orgID, code string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	id, ok := s.couponsByKey[couponKeyOf(orgID, code)]
+	if !ok {
+		return Coupon{}, false
+	}
+	return s.couponView(s.coupons[id]), true
+}
+
+// Coupons returns an organization's coupons, oldest first.
+func (s *Store) Coupons(orgID string) []Coupon {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Coupon{}
+	for _, c := range s.coupons {
+		if c.OrgID == orgID {
+			out = append(out, s.couponView(c))
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// couponView is a copy of c with TimesRedeemed counted. The caller holds the lock.
+func (s *Store) couponView(c Coupon) Coupon {
+	c = copyCoupon(c)
+	c.TimesRedeemed = 0
+	for _, sub := range s.subs {
+		if sub.OrgID == c.OrgID && sub.Coupon == c.Code {
+			c.TimesRedeemed++
+		}
+	}
+	return c
+}
+
+// RedeemCoupon applies the coupon with this code to a subscription; the redemption is at now. It refuses when the
+// subscription is canceled or already has a coupon, when the coupon has expired or has no redemptions left, and when an
+// amount off is in another currency than the subscription's plan. The check and the change happen under one lock, so
+// max_redemptions holds under concurrent requests.
+func (s *Store) RedeemCoupon(orgID, subID, code string, now time.Time) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	sub, ok := s.subs[subID]
+	if !ok || sub.OrgID != orgID {
+		return Subscription{}, ErrNotFound
+	}
+	id, ok := s.couponsByKey[couponKeyOf(orgID, code)]
+	if !ok {
+		return Subscription{}, ErrNotFound
+	}
+	c := s.coupons[id]
+	switch {
+	case sub.Status == Canceled:
+		return Subscription{}, ErrSubscriptionCanceled
+	case sub.Coupon != "":
+		return Subscription{}, ErrCouponAlreadyApplied
+	case c.RedeemBy != nil && now.After(*c.RedeemBy):
+		return Subscription{}, ErrCouponExpired
+	case c.MaxRedemptions != nil && s.couponView(c).TimesRedeemed >= *c.MaxRedemptions:
+		return Subscription{}, ErrCouponExhausted
+	case c.AmountOff != nil && s.plans[sub.PlanID].Currency != c.Currency:
+		return Subscription{}, ErrCurrencyMismatch
+	}
+	redeemed := now.UTC()
+	sub.Coupon, sub.CouponRedeemedAt = c.Code, &redeemed
+	s.subs[subID] = sub
+	return copySub(sub), nil
+}
+
+// copyCoupon is a deep copy, so callers cannot change stored coupons.
+func copyCoupon(c Coupon) Coupon {
+	if c.PercentOff != nil {
+		v := *c.PercentOff
+		c.PercentOff = &v
+	}
+	if c.AmountOff != nil {
+		v := *c.AmountOff
+		c.AmountOff = &v
+	}
+	if c.MaxRedemptions != nil {
+		v := *c.MaxRedemptions
+		c.MaxRedemptions = &v
+	}
+	if c.RedeemBy != nil {
+		t := *c.RedeemBy
+		c.RedeemBy = &t
+	}
+	return c
+}
