+		if r := e.Do("POST", "/v1/coupons", key, body); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid" {
+			t.Errorf("%v: %s", body, r)
+		}
+	}
+}
+
+func TestApplyCouponToASubscription(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	ctx := context.Background()
+	now := e.Clock.Now()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	usd := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	eur := e.CreatePlan(e.Acme, "Team EU", "EUR", "20.00")
+	newSub := func(planID string) store.Subscription {
+		t.Helper()
+		var sub store.Subscription
+		e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", key, map[string]any{"customer_id": c.ID, "plan_id": planID, "quantity": 1}, &sub)
+		return sub
+	}
+	first, second, euro, canceled := newSub(usd.ID), newSub(usd.ID), newSub(eur.ID), newSub(usd.ID)
+
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", key, map[string]any{"code": "ONEUSE", "percent_off": 10, "duration": "forever", "max_redemptions": 1}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", key, map[string]any{"code": "OLDIE", "percent_off": 10, "duration": "once",
+		"redeem_by": now.Add(-time.Hour).Format(time.RFC3339)}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", key, map[string]any{"code": "FIVEOFF", "amount_off": "5.00", "currency": "USD", "duration": "forever"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", key, map[string]any{"code": "SPRING-26", "percent_off": 10, "duration": "once"}, nil)
+	if r := e.Do("POST", "/v1/subscriptions/"+canceled.ID+"/cancel", key, nil); r.Code != http.StatusOK {
+		t.Fatalf("cancel: %s", r)
+	}
+
+	apply := func(subID, code string) *apitest.Response {
+		return e.Do("POST", "/v1/subscriptions/"+subID+"/coupon", key, map[string]string{"code": code})
+	}
+	assertError := func(r *apitest.Response, status int, code string) {
+		t.Helper()
+		if r.Code != status || r.Map(t)["error"] != code {
+			t.Fatalf("want %d %s, got %s", status, code, r)
+		}
+	}
+	assertError(apply(first.ID, "NOPE"), http.StatusNotFound, "not_found")
+	assertError(apply("sub_missing", "ONEUSE"), http.StatusNotFound, "not_found")
+	assertError(apply(second.ID, "OLDIE"), http.StatusUnprocessableEntity, "coupon_expired")
+	assertError(apply(euro.ID, "FIVEOFF"), http.StatusUnprocessableEntity, "currency_mismatch")
+	assertError(apply(canceled.ID, "SPRING-26"), http.StatusConflict, "subscription_canceled")
+
+	var applied store.Subscription
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+first.ID+"/coupon", key, map[string]string{"code": "oneuse"}, &applied)
+	if applied.Coupon != "ONEUSE" || applied.CouponRedeemedAt == nil {
+		t.Fatalf("applied = %+v", applied)
+	}
+	assertError(apply(second.ID, "ONEUSE"), http.StatusUnprocessableEntity, "coupon_exhausted")
+	assertError(apply(first.ID, "SPRING-26"), http.StatusConflict, "coupon_already_applied")
+
+	// The coupon discounts the invoice of the next period, which the subscription's renewal creates.
+	e.Clock.Set(applied.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	var invs struct {
+		Items []struct {
+			store.Invoice
+			Discount int64
+			Total    int64
+		}
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+first.ID, key, nil, &invs)
+	if len(invs.Items) != 2 || invs.Items[0].Coupon != "" || invs.Items[1].Coupon != "ONEUSE" || invs.Items[1].Discount != 200 || invs.Items[1].Total != 1800 {
+		t.Fatalf("invoices = %+v", invs.Items)
+	}
+	var sub store.Subscription
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions/"+first.ID, key, nil, &sub)
+	if sub.Coupon != "ONEUSE" {
+		t.Fatalf("subscription = %+v", sub)
+	}
+	var one store.Coupon
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/ONEUSE", key, nil, &one)
+	if one.TimesRedeemed != 1 {
+		t.Fatalf("times redeemed = %d", one.TimesRedeemed)
+	}
+}
