@@ -0,0 +1,139 @@
+package subscriptions_test
+
+import (
+	"context"
+	"slices"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/billing"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+	"example.com/tally/internal/subscriptions"
+)
+
+// subscribe starts a $20.00 monthly subscription of Acme's, with the subscription's own discount.
+func subscribe(t *testing.T, e *apitest.Env, discountPercent int) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1, DiscountPercent: discountPercent})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+// renew moves the clock to the end of sub's period and renews it, which invoices the next period.
+func renew(t *testing.T, e *apitest.Env, sub store.Subscription) store.Subscription {
+	t.Helper()
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	return got
+}
+
+// discounts returns the discount on each of sub's invoices, oldest first.
+func discounts(e *apitest.Env, sub store.Subscription) []int64 {
+	var out []int64
+	for _, inv := range e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+		out = append(out, billing.Compute(inv).Discount)
+	}
+	return out
+}
+
+func createCoupon(t *testing.T, e *apitest.Env, c store.Coupon) {
+	t.Helper()
+	c.OrgID = e.Acme.ID
+	if _, err := e.Store.CreateCoupon(c, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func intPtr(n int) *int {
+	return &n
+}
+
+func TestOnceCouponDiscountsOnlyTheFirstInvoiceAfterRedemption(t *testing.T) {
+	e := apitest.New(t)
+	sub := subscribe(t, e, 0)
+	createCoupon(t, e, store.Coupon{Code: "ONCE10", PercentOff: intPtr(10), Duration: store.CouponOnce})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "ONCE10"); err != nil {
+		t.Fatal(err)
+	}
+	sub = renew(t, e, sub)
+	sub = renew(t, e, sub)
+
+	// The first invoice was created before the coupon was applied.
+	if got := discounts(e, sub); !slices.Equal(got, []int64{0, 200, 0}) {
+		t.Fatalf("discounts = %v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if inv := invs[1]; inv.Coupon != "ONCE10" || inv.CouponPercentOff != 10 || inv.DiscountPercent != 0 || invs[2].Coupon != "" {
+		t.Fatalf("invoices = %+v", invs)
+	}
+}
+
+func TestRepeatingCouponDiscountsInvoicesWithinItsMonths(t *testing.T) {
+	e := apitest.New(t)
+	sub := subscribe(t, e, 0)
+	createCoupon(t, e, store.Coupon{Code: "TWICE", PercentOff: intPtr(10), Duration: store.CouponRepeating, DurationInMonths: 2})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "TWICE"); err != nil {
+		t.Fatal(err)
+	}
+	for range 3 {
+		sub = renew(t, e, sub)
+	}
+	// The period that starts a month after the redemption is within the two months; the one that starts two months after is not.
+	if got := discounts(e, sub); !slices.Equal(got, []int64{0, 200, 0, 0}) {
+		t.Fatalf("discounts = %v", got)
+	}
+}
+
+func TestForeverCouponDiscountsEveryInvoiceAfterRedemption(t *testing.T) {
+	e := apitest.New(t)
+	sub := subscribe(t, e, 0)
+	createCoupon(t, e, store.Coupon{Code: "ALWAYS", PercentOff: intPtr(10), Duration: store.CouponForever})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "always"); err != nil {
+		t.Fatal(err)
+	}
+	for range 3 {
+		sub = renew(t, e, sub)
+	}
+	if got := discounts(e, sub); !slices.Equal(got, []int64{0, 200, 200, 200}) {
+		t.Fatalf("discounts = %v", got)
+	}
+}
+
+func TestCouponReplacesTheSubscriptionsDiscount(t *testing.T) {
+	e := apitest.New(t)
+	sub := subscribe(t, e, 50)
+	sub = renew(t, e, sub)
+	createCoupon(t, e, store.Coupon{Code: "TENOFF", PercentOff: intPtr(10), Duration: store.CouponForever})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "TENOFF"); err != nil {
+		t.Fatal(err)
+	}
+	sub = renew(t, e, sub)
+
+	// Before the coupon the subscription's 50% applies; after it, only the coupon's 10%.
+	if got := discounts(e, sub); !slices.Equal(got, []int64{1000, 1000, 200}) {
+		t.Fatalf("discounts = %v", got)
+	}
+}
+
+func TestAmountCouponIsCappedAtTheSubtotal(t *testing.T) {
+	e := apitest.New(t)
+	sub := subscribe(t, e, 0)
+	off := int64(3000)
+	createCoupon(t, e, store.Coupon{Code: "THIRTY", AmountOff: &off, Currency: money.USD, Duration: store.CouponForever})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "THIRTY"); err != nil {
+		t.Fatal(err)
+	}
+	sub = renew(t, e, sub)
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if got := billing.Compute(invs[1]); got.Subtotal != 2000 || got.Discount != 2000 || got.Total != 0 {
+		t.Fatalf("totals = %+v", got)
+	}
+}
