+package billing
+
+import (
+	"testing"
+
+	"example.com/tally/internal/store"
+)
+
+func TestCouponPercentOffTakesTheDiscount(t *testing.T) {
+	// A coupon's invoice has DiscountPercent 0: the subscription's discount does not apply on top of it.
+	inv := store.Invoice{
+		Lines:            []store.Line{{Description: "Seats", Quantity: 3, UnitAmount: 1500}, {Description: "Setup", Quantity: 1, UnitAmount: 999}},
+		Coupon:           "SAVE10",
+		CouponPercentOff: 10,
+		TaxRateBP:        825,
+	}
+	// subtotal 5499; discount 549.9 -> 550; taxable 4949; tax 408.2925 -> 408
+	want := Totals{Subtotal: 5499, Discount: 550, Tax: 408, Total: 5357}
+	if got := Compute(inv); got != want {
+		t.Fatalf("Compute = %+v, want %+v", got, want)
+	}
+}
+
+func TestCouponAmountOffIsCappedAtTheSubtotal(t *testing.T) {
+	inv := store.Invoice{
+		Lines:           []store.Line{{Description: "Seats", Quantity: 3, UnitAmount: 1500}, {Description: "Setup", Quantity: 1, UnitAmount: 999}},
+		Coupon:          "FIVEOFF",
+		CouponAmountOff: 1000,
+		TaxRateBP:       825,
+	}
+	// subtotal 5499; discount 1000; taxable 4499; tax 371.1675 -> 371
+	if got, want := Compute(inv), (Totals{Subtotal: 5499, Discount: 1000, Tax: 371, Total: 4870}); got != want {
+		t.Fatalf("Compute = %+v, want %+v", got, want)
+	}
+
+	inv.CouponAmountOff = 9999
+	if got, want := Compute(inv), (Totals{Subtotal: 5499, Discount: 5499}); got != want {
+		t.Fatalf("Compute with an amount above the subtotal = %+v, want %+v", got, want)
+	}
+}
