+// couponFor returns the coupon that discounts the invoice of sub for the period starting at start, created at now, if one
+// applies. A coupon discounts only invoices created after it was applied: a once coupon the first of them, a repeating
+// coupon those whose period starts less than its duration in months after the redemption, a forever coupon all of them.
+// An amount off in another currency than the plan's does not apply.
+func (s *Service) couponFor(sub store.Subscription, plan store.Plan, start, now time.Time) (store.Coupon, bool) {
+	if sub.Coupon == "" || sub.CouponRedeemedAt == nil || !now.After(*sub.CouponRedeemedAt) {
+		return store.Coupon{}, false
+	}
+	redeemed := *sub.CouponRedeemedAt
+	c, ok := s.Store.CouponByCode(sub.OrgID, sub.Coupon)
+	if !ok || (c.AmountOff != nil && c.Currency != plan.Currency) {
+		return store.Coupon{}, false
+	}
+	switch c.Duration {
+	case store.CouponOnce:
+		for _, inv := range s.Store.ListInvoices(sub.OrgID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+			if inv.CreatedAt.After(redeemed) {
+				return store.Coupon{}, false
+			}
+		}
+	case store.CouponRepeating:
+		if !start.Before(redeemed.AddDate(0, c.DurationInMonths, 0)) {
+			return store.Coupon{}, false
+		}
+	}
+	return c, true
+}
