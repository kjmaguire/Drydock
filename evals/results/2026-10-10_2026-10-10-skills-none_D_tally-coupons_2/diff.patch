 }
 
+// discountOf is the invoice's discount. A coupon's percentage or amount replaces the subscription's DiscountPercent; an
+// amount off is never more than the subtotal.
+func discountOf(inv store.Invoice, subtotal int64) int64 {
+	switch {
+	case inv.CouponAmountOff > 0:
+		return max(0, min(inv.CouponAmountOff, subtotal))
+	case inv.CouponPercentOff > 0:
+		return money.Percent(subtotal, inv.CouponPercentOff)
+	}
+	return money.Percent(subtotal, inv.DiscountPercent)
+}
