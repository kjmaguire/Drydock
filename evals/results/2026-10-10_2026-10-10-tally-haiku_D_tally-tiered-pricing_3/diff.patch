@@ -0,0 +1,38 @@
+package billing
+
+import (
+	"testing"
+
+	"example.com/tally/internal/store"
+)
+
+func TestTieredAmount(t *testing.T) {
+	up := func(n int64) *int64 { return &n }
+	tiers := []store.Tier{
+		{UpTo: up(100), UnitAmount: 10},
+		{UpTo: up(200), UnitAmount: 5, FlatAmount: 100},
+		{UpTo: nil, UnitAmount: 1},
+	}
+	for _, c := range []struct {
+		mode store.TiersMode
+		q    int64
+		want int64
+	}{
+		{store.Graduated, 0, 0},
+		{store.Graduated, 1, 10},
+		{store.Graduated, 100, 1000}, // up_to is inclusive, so the next tier's flat amount is not reached
+		{store.Graduated, 101, 1105}, // 100 units at 10, then 1 unit at 5 plus that tier's flat 100
+		{store.Graduated, 200, 1600},
+		{store.Graduated, 250, 1650},
+		{store.Volume, 0, 0},
+		{store.Volume, 1, 10},
+		{store.Volume, 100, 1000},
+		{store.Volume, 101, 605}, // all 101 units at 5, plus the flat 100
+		{store.Volume, 200, 1100},
+		{store.Volume, 250, 250}, // all 250 units at 1
+	} {
+		if got := TieredAmount(tiers, c.mode, c.q); got != c.want {
+			t.Errorf("TieredAmount(%s, %d) = %d, want %d", c.mode, c.q, got, c.want)
+		}
+	}
+}
