+// TieredAmount returns the charge for quantity units on a metered plan's tiers, in minor units. Graduated tiers price each
+// unit at the tier it falls in and add the flat amount of every tier at least one unit falls in. Volume tiers price every
+// unit at the one tier the quantity falls in, and add that tier's flat amount once. A tier's UpTo is inclusive; a quantity
+// of 0 costs 0.
+func TieredAmount(tiers []store.Tier, mode store.TiersMode, quantity int64) int64 {
+	if quantity <= 0 {
+		return 0
+	}
+	if mode == store.Volume {
+		for _, t := range tiers {
+			if t.UpTo == nil || quantity <= *t.UpTo {
+				return quantity*t.UnitAmount + t.FlatAmount
+			}
+		}
+		return 0
+	}
+	var total, prev int64
+	for _, t := range tiers {
+		if quantity <= prev {
+			break
+		}
+		upper := quantity
+		if t.UpTo != nil && *t.UpTo < quantity {
+			upper = *t.UpTo
+		}
+		total += (upper-prev)*t.UnitAmount + t.FlatAmount
+		if t.UpTo == nil {
+			break
+		}
+		prev = *t.UpTo
+	}
+	return total
+}
