+)
+
+func TestTieredUsageIsOneLinePerPeriod(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	up := func(n int64) *int64 { return &n }
+	// Graduated: 100 units at 2 cents, then each unit above 100 at 1 cent plus a 50 cent flat fee.
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, Interval: store.Monthly,
+		UsageType: store.Metered, TiersMode: store.Graduated,
+		Tiers: []store.Tier{{UpTo: up(100), UnitAmount: 2}, {UpTo: nil, UnitAmount: 1, FlatAmount: 50}}}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	start, end := sub.CurrentPeriodStart, sub.CurrentPeriodEnd
+	for _, u := range []struct {
+		q  int64
+		at time.Time
+	}{{100, start}, {150, start.Add(48 * time.Hour)}} {
+		if _, err := e.Store.AddUsage(e.Acme.ID, sub.ID, u.q, u.at, e.Clock.Now()); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// 250 units: 100 at 2 = 200, then 150 at 1 = 150 plus the flat 50, so 400 cents.
+	e.Clock.Set(end)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 1 || len(invs[0].Lines) != 1 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	if l := invs[0].Lines[0]; l.Quantity != 1 || l.UnitAmount != 400 || !strings.HasPrefix(l.Description, "API calls") {
+		t.Fatalf("line = %+v", l)
+	}
+
+	// A period without usage has no invoice.
+	renewed, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	e.Clock.Set(renewed.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("a period without usage was invoiced: %+v", invs)
+	}
+	if s, _ := e.Store.Subscription(e.Acme.ID, sub.ID); s.Status != store.Active {
+		t.Fatalf("status = %s", s.Status)
+	}
+}
