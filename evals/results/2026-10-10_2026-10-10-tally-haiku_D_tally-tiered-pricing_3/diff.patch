+package api_test
+
+import (
+	"net/http"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func TestTieredPlans(t *testing.T) {
+	e := apitest.New(t)
+	var p struct {
+		store.Plan
+		Price string `json:"price"`
+	}
+	// No price: a tiered plan is priced by its tiers. A missing flat_amount is 0.
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{
+		"name": "API calls", "currency": "USD", "interval": "month", "usage_type": "metered", "tiers_mode": "graduated",
+		"tiers": []map[string]any{
+			{"up_to": 100, "unit_amount": "0.02"},
+			{"up_to": 1000, "unit_amount": "0.01", "flat_amount": "5"},
+			{"up_to": nil, "unit_amount": "0.01"},
+		},
+	}, &p)
+	if p.TiersMode != store.Graduated || len(p.Tiers) != 3 || p.UnitAmount != 0 {
+		t.Fatalf("plan = %+v", p.Plan)
+	}
+	if p.Tiers[0].UpTo == nil || *p.Tiers[0].UpTo != 100 || p.Tiers[0].UnitAmount != 2 || p.Tiers[0].FlatAmount != 0 {
+		t.Fatalf("first tier = %+v", p.Tiers[0])
+	}
+	if p.Tiers[1].UpTo == nil || *p.Tiers[1].UpTo != 1000 || p.Tiers[1].UnitAmount != 1 || p.Tiers[1].FlatAmount != 500 {
+		t.Fatalf("second tier = %+v", p.Tiers[1])
+	}
+	if p.Tiers[2].UpTo != nil || p.Tiers[2].UnitAmount != 1 {
+		t.Fatalf("last tier = %+v", p.Tiers[2])
+	}
+
+	base := func(tiersMode string, usage string, tiers []map[string]any) map[string]any {
+		return map[string]any{"name": "X", "currency": "USD", "interval": "month", "usage_type": usage, "tiers_mode": tiersMode, "tiers": tiers}
+	}
+	one := func(upTo any, unit string) map[string]any { return map[string]any{"up_to": upTo, "unit_amount": unit} }
+	// Tiers on a licensed plan, without a mode or with an unknown one, with no tiers, unsorted or repeated limits, a limit on
+	// the last tier or none on another, a limit that is not a positive whole number, and an amount that is negative or unreadable.
+	for _, bad := range []map[string]any{
+		base("graduated", "licensed", []map[string]any{one(nil, "1")}),
+		base("", "metered", []map[string]any{one(nil, "1")}),
+		base("flat", "metered", []map[string]any{one(nil, "1")}),
+		base("volume", "metered", []map[string]any{}),
+		base("volume", "metered", []map[string]any{one(50, "1"), one(10, "1")}),
+		base("volume", "metered", []map[string]any{one(10, "1"), one(10, "1"), one(nil, "1")}),
+		base("volume", "metered", []map[string]any{one(nil, "1"), one(10, "1")}),
+		base("volume", "metered", []map[string]any{one(10, "1")}),
+		base("volume", "metered", []map[string]any{one(0, "1"), one(nil, "1")}),
+		base("volume", "metered", []map[string]any{one(2.5, "1"), one(nil, "1")}),
+		base("volume", "metered", []map[string]any{one(nil, "-1")}),
+		base("volume", "metered", []map[string]any{one(nil, "abc")}),
+	} {
+		if r := e.Do("POST", "/v1/plans", e.Acme.Key, bad); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_tiers" {
+			t.Fatalf("%v: %s", bad, r)
+		}
+	}
+}
