+func TestZeroAndThreeDecimalCurrencies(t *testing.T) {
+	e := apitest.New(t)
+	var jpy struct {
+		store.Plan
+		Price          string `json:"price"`
+		PriceFormatted string `json:"price_formatted"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "Yen", "currency": "JPY", "price": "1000", "interval": "month"}, &jpy)
+	if jpy.UnitAmount != 1000 || jpy.Price != "1000" || jpy.PriceFormatted != "¥1,000" {
+		t.Fatalf("JPY plan = %+v", jpy)
+	}
+	var kwd struct {
+		store.Plan
+		Price          string `json:"price"`
+		PriceFormatted string `json:"price_formatted"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "Dinar", "currency": "KWD", "price": "1.250", "interval": "month"}, &kwd)
+	if kwd.UnitAmount != 1250 || kwd.Price != "1.250" || kwd.PriceFormatted != "KWD 1.250" {
+		t.Fatalf("KWD plan = %+v", kwd)
+	}
+	for _, bad := range []map[string]any{
+		{"name": "X", "currency": "JPY", "price": "1000.00", "interval": "month"},
+		{"name": "X", "currency": "JPY", "price": "1.5", "interval": "month"},
+		{"name": "X", "currency": "KWD", "price": "1.2345", "interval": "month"},
+	} {
+		if r := e.Do("POST", "/v1/plans", e.Acme.Key, bad); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_amount" {
+			t.Fatalf("%v: %s", bad, r)
+		}
+	}
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	var inv struct {
+		Total          int64  `json:"total"`
+		TotalFormatted string `json:"total_formatted"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": c.ID, "currency": "KWD",
+		"lines": []map[string]any{{"description": "Seat", "quantity": 2, "unit_amount": 1250}}}, &inv)
+	if inv.Total != 2500 || inv.TotalFormatted != "KWD 2.500" {
+		t.Fatalf("KWD invoice = %+v", inv)
+	}
+}
