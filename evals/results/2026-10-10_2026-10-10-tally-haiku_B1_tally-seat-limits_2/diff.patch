--- /dev/null
+++ b/result/internal/store/seats_test.go
@@ -0,0 +1,84 @@
+package store
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestSeatLimits(t *testing.T) {
+	for _, c := range []struct {
+		plan  OrgPlan
+		limit int
+		ok    bool
+	}{{OrgFree, 3, true}, {OrgTeam, 10, true}, {OrgBusiness, 0, false}} {
+		if limit, ok := c.plan.SeatLimit(); limit != c.limit || ok != c.ok {
+			t.Errorf("%s: SeatLimit() = %d, %v", c.plan, limit, ok)
+		}
+	}
+}
+
+func TestSeatsCountMembersAndPendingInvites(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	owner, _ := s.CreateUser("owner@acme.example", "Owner", t0)
+	_, _ = s.AddMember(o.ID, owner.ID, RoleOwner, t0)
+	viewer, _ := s.CreateUser("viewer@acme.example", "Viewer", t0)
+	_, _ = s.AddMember(o.ID, viewer.ID, RoleViewer, t0)
+	if got := s.SeatsUsed(o.ID); got != 1 {
+		t.Fatalf("owner and a viewer: seats used = %d, want 1", got)
+	}
+	inv, err := s.CreateInvite(o.ID, "a@people.example", RoleMember, owner.ID, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := s.SeatsUsed(o.ID); got != 2 {
+		t.Fatalf("with a pending invite: seats used = %d, want 2", got)
+	}
+	if _, err := s.RevokeInvite(o.ID, inv.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if got := s.SeatsUsed(o.ID); got != 1 {
+		t.Fatalf("after a revoke: seats used = %d, want 1", got)
+	}
+	if _, err := s.CreateInvite(o.ID, "v@people.example", RoleViewer, owner.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if got := s.SeatsUsed(o.ID); got != 1 {
+		t.Fatalf("a viewer invite is free: seats used = %d, want 1", got)
+	}
+}
+
+func TestSeatLimitErrors(t *testing.T) {
+	s := New()
+	o, _ := s.CreateOrg("Acme", OrgFree, "UTC", 0, t0)
+	owner, _ := s.CreateUser("owner@acme.example", "Owner", t0)
+	_, _ = s.AddMember(o.ID, owner.ID, RoleOwner, t0)
+	for i := range 2 {
+		if _, err := s.CreateInvite(o.ID, []string{"a@x.example", "b@x.example"}[i], RoleAdmin, owner.ID, t0); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_, err := s.CreateInvite(o.ID, "c@x.example", RoleMember, owner.ID, t0)
+	var sl *SeatLimitError
+	if !errors.As(err, &sl) || sl.Limit != 3 || sl.Used != 3 || !errors.Is(err, ErrSeatLimit) {
+		t.Fatalf("CreateInvite at the limit: %v", err)
+	}
+	if errors.Is(err, ErrConflict) || errors.Is(err, ErrInvalid) {
+		t.Fatalf("a seat limit error is not a conflict or invalid: %v", err)
+	}
+
+	// Lowering the plan below the seats in use is refused, and nothing changes.
+	if _, err := s.UpdateOrg(o.ID, func(o *Org) error { o.Plan = OrgTeam; return nil }); err != nil {
+		t.Fatalf("team holds 10: %v", err)
+	}
+	if _, err := s.CreateInvite(o.ID, "c@x.example", RoleMember, owner.ID, t0); err != nil {
+		t.Fatalf("team has a seat free: %v", err)
+	}
+	_, err = s.UpdateOrg(o.ID, func(o *Org) error { o.Plan = OrgFree; o.Name = "Renamed"; return nil })
+	if !errors.As(err, &sl) || sl.Limit != 3 || sl.Used != 4 {
+		t.Fatalf("free with 4 seats: %v", err)
+	}
+	if got, _ := s.Org(o.ID); got.Plan != OrgTeam || got.Name != "Acme" {
+		t.Fatalf("a refused plan change was applied: %+v", got)
+	}
+}
