+package api_test
+
+import (
+	"net/http"
+	"net/url"
+	"regexp"
+	"sync"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// seats is the "seats" object of GET /v1/org.
+type seats struct {
+	Used  int  `json:"used"`
+	Limit *int `json:"limit"`
+}
+
+func getSeats(t *testing.T, e *apitest.Env, key string) seats {
+	t.Helper()
+	var o struct {
+		Seats seats `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", key, nil, &o)
+	return o.Seats
+}
+
+// seatLimitBody checks a 402 answer: {"error":"seat_limit_reached","limit":...,"used":...}.
+func seatLimitBody(t *testing.T, r *apitest.Response, limit, used int) {
+	t.Helper()
+	if r.Code != http.StatusPaymentRequired {
+		t.Fatalf("want 402, got %s", r)
+	}
+	want := map[string]any{"error": "seat_limit_reached", "limit": float64(limit), "used": float64(used)}
+	got := r.Map(t)
+	if len(got) != len(want) {
+		t.Fatalf("body = %s, want %v", r, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("body = %s, want %v", r, want)
+		}
+	}
+}
+
+func TestSeatsShownOnOrg(t *testing.T) {
+	e := apitest.New(t)
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 1 || got.Limit == nil || *got.Limit != 10 {
+		t.Fatalf("team seats = %+v", got)
+	}
+	if got := getSeats(t, e, e.Globex.Key); got.Used != 1 || got.Limit != nil {
+		t.Fatalf("business seats = %+v", got)
+	}
+	e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 2 {
+		t.Fatalf("viewers are free, so seats = %+v", got)
+	}
+	var o struct {
+		Seats seats `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"name": "Acme Inc"}, &o)
+	if o.Seats.Used != 2 {
+		t.Fatalf("PATCH org seats = %+v", o.Seats)
+	}
+}
+
+func TestInviteNeedsASeat(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"plan": "free"}, nil)
+	if got := getSeats(t, e, e.Acme.Key); got.Limit == nil || *got.Limit != 3 || got.Used != 1 {
+		t.Fatalf("free seats = %+v", got)
+	}
+	var first, second store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "a@people.example", "role": "member"}, &first)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "b@people.example", "role": "admin"}, &second)
+	// Pending invites hold seats: owner + 2 invites = 3.
+	seatLimitBody(t, e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "c@people.example", "role": "member"}), 3, 3)
+	// Viewers are free.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "v@people.example", "role": "viewer"}, nil)
+	// Revoking an invite frees its seat.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+second.ID, e.Acme.Key, nil, nil)
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 2 {
+		t.Fatalf("after a revoke, seats = %+v", got)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "c@people.example", "role": "member"}, nil)
+	seatLimitBody(t, e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "d@people.example", "role": "member"}), 3, 3)
+}
+
+func TestAcceptingAnInviteNeverNeedsASeat(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"plan": "free"}, nil)
+	var a, b store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "a@people.example", "role": "member"}, &a)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "b@people.example", "role": "member"}, &b)
+	e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer) // free: still 3 of 3 seats used
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 3 {
+		t.Fatalf("seats = %+v", got)
+	}
+	// The invite holds its seat, so accepting it succeeds with the organization at its limit.
+	tokenOf := func(email string) string {
+		msgs := e.Mail.Messages()
+		for _, msg := range msgs {
+			if msg.To == email {
+				m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msg.Body)
+				tok, _ := url.QueryUnescape(m[1])
+				return tok
+			}
+		}
+		t.Fatalf("no email to %s", email)
+		return ""
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": tokenOf("a@people.example"), "name": "A"}, nil)
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 3 {
+		t.Fatalf("after accepting, seats = %+v", got)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": tokenOf("b@people.example"), "name": "B"}, nil)
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 3 {
+		t.Fatalf("after accepting both, seats = %+v", got)
+	}
+}
+
+func TestViewerPromotionNeedsASeat(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"plan": "free"}, nil)
+	viewer, _ := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	m1, _ := e.AddMember(e.Acme, "m1@acme.example", store.RoleMember)
+	e.AddMember(e.Acme, "m2@acme.example", store.RoleMember)
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 3 {
+		t.Fatalf("seats = %+v", got)
+	}
+	path := "/v1/members/" + viewer.ID
+	seatLimitBody(t, e.Do("PATCH", path, e.Acme.Key, map[string]string{"role": "member"}), 3, 3)
+	// Moving a member to viewer frees a seat, which the viewer can then take.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+m1.ID, e.Acme.Key, map[string]string{"role": "viewer"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", path, e.Acme.Key, map[string]string{"role": "admin"}, nil)
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 3 {
+		t.Fatalf("seats = %+v", got)
+	}
+}
+
+func TestPlanChangeCannotLeaveMoreSeatsInUseThanTheLimit(t *testing.T) {
+	e := apitest.New(t)
+	for _, email := range []string{"m1@acme.example", "m2@acme.example", "m3@acme.example"} {
+		e.AddMember(e.Acme, email, store.RoleMember)
+	}
+	e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 4 {
+		t.Fatalf("seats = %+v", got)
+	}
+	// The name is refused along with the plan: nothing changes.
+	r := e.Do("PATCH", "/v1/org", e.Acme.Key, map[string]any{"name": "Renamed", "plan": "free"})
+	if r.Code != http.StatusConflict {
+		t.Fatalf("downgrade: %s", r)
+	}
+	if body := r.Map(t); body["error"] != "over_seat_limit" || body["limit"] != float64(3) || body["used"] != float64(4) {
+		t.Fatalf("body = %s", r)
+	}
+	if o, _ := e.Store.Org(e.Acme.ID); o.Plan != store.OrgTeam || o.Name != "Acme" {
+		t.Fatalf("a refused change was applied: %+v", o)
+	}
+	// Changes that keep the plan are not checked.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"name": "Acme Inc"}, nil)
+	// Free up a seat and the downgrade goes through.
+	members := e.Store.Members(e.Acme.ID)
+	var demote store.Member
+	for _, m := range members {
+		if m.Role == store.RoleMember {
+			demote = m
+			break
+		}
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+demote.UserID, e.Acme.Key, map[string]string{"role": "viewer"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"plan": "free"}, nil)
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 3 || got.Limit == nil || *got.Limit != 3 {
+		t.Fatalf("seats after downgrade = %+v", got)
+	}
+	// Business is unlimited, so any number of seats fits.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"plan": "business"}, nil)
+	if got := getSeats(t, e, e.Acme.Key); got.Limit != nil {
+		t.Fatalf("business seats = %+v", got)
+	}
+}
+
+func TestSeatLimitHoldsUnderConcurrency(t *testing.T) {
+	e := apitest.New(t)
+	for i := range 8 { // owner + 8 members = 9 of 10 seats
+		e.AddMember(e.Acme, "m"+string(rune('a'+i))+"@acme.example", store.RoleMember)
+	}
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 9 {
+		t.Fatalf("seats = %+v", got)
+	}
+	const n = 6
+	codes := make([]int, n)
+	var wg sync.WaitGroup
+	for i := range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r := e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "race" + string(rune('a'+i)) + "@people.example", "role": "member"})
+			codes[i] = r.Code
+		}()
+	}
+	wg.Wait()
+	created := 0
+	for _, c := range codes {
+		switch c {
+		case http.StatusCreated:
+			created++
+		case http.StatusPaymentRequired:
+		default:
+			t.Fatalf("unexpected status %d in %v", c, codes)
+		}
+	}
+	if created != 1 {
+		t.Fatalf("%d invites created with one seat left: %v", created, codes)
+	}
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 10 {
+		t.Fatalf("seats = %+v", got)
+	}
+}
+
+func TestViewerPromotionsUnderConcurrency(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"plan": "free"}, nil)
+	e.AddMember(e.Acme, "m@acme.example", store.RoleMember) // owner + member = 2 of 3
+	var viewers []store.User
+	for i := range 4 {
+		u, _ := e.AddMember(e.Acme, "v"+string(rune('a'+i))+"@acme.example", store.RoleViewer)
+		viewers = append(viewers, u)
+	}
+	codes := make([]int, len(viewers))
+	var wg sync.WaitGroup
+	for i, u := range viewers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			codes[i] = e.Do("PATCH", "/v1/members/"+u.ID, e.Acme.Key, map[string]string{"role": "member"}).Code
+		}()
+	}
+	wg.Wait()
+	ok := 0
+	for _, c := range codes {
+		switch c {
+		case http.StatusOK:
+			ok++
+		case http.StatusPaymentRequired:
+		default:
+			t.Fatalf("unexpected status %d in %v", c, codes)
+		}
+	}
+	if ok != 1 {
+		t.Fatalf("%d viewers promoted with one seat left: %v", ok, codes)
+	}
+	if got := getSeats(t, e, e.Acme.Key); got.Used != 3 {
+		t.Fatalf("seats = %+v", got)
+	}
+}
