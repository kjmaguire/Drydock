+// orgView is an organization with its seats: the limit its plan holds (null when unlimited) and how many are used.
+type orgView struct {
+	store.Org
+	Seats seatsView `json:"seats"`
+}
+
+type seatsView struct {
+	Used  int  `json:"used"`
+	Limit *int `json:"limit"`
+}
+
+func (s *Server) viewOrg(o store.Org) orgView {
+	v := orgView{Org: o, Seats: seatsView{Used: s.store.SeatsUsed(o.ID)}}
+	if limit, ok := o.Plan.SeatLimit(); ok {
+		v.Seats.Limit = &limit
+	}
+	return v
+}
+
+// seatLimitReached answers 402 when err is a SeatLimitError and reports whether it did.
+func seatLimitReached(w http.ResponseWriter, err error) bool {
+	var sl *store.SeatLimitError
+	if !errors.As(err, &sl) {
+		return false
+	}
+	writeJSON(w, http.StatusPaymentRequired, map[string]any{"error": "seat_limit_reached", "limit": sl.Limit, "used": sl.Used})
+	return true
+}
