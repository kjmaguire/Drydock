+// SeatLimitError is returned when a change needs a seat the organization's plan does not have (Limit seats, Used of them
+// taken), or when a plan change would leave the organization with more seats in use than the plan holds.
+type SeatLimitError struct {
+	Limit, Used int
+}
+
+func (e *SeatLimitError) Error() string {
+	return fmt.Sprintf("%v: the plan holds %d seats and %d are in use", ErrSeatLimit, e.Limit, e.Used)
+}
+
+// Unwrap makes errors.Is(err, ErrSeatLimit) true.
+func (e *SeatLimitError) Unwrap() error { return ErrSeatLimit }
+
 // Store holds everything.
 type Store struct {
 	mu  sync.Mutex
@@ -139,6 +154,7 @@ func (s *Store) UpdateOrg(id string, f func(*Org) error) (Org, error) {
 	if !ok {
 		return Org{}, ErrNotFound
 	}
+	prev := o.Plan
 	if err := f(&o); err != nil {
 		return Org{}, err
 	}
@@ -146,10 +162,52 @@ func (s *Store) UpdateOrg(id string, f func(*Org) error) (Org, error) {
 	if err := checkOrg(o); err != nil {
 		return Org{}, err
 	}
+	if limit, limited := o.Plan.SeatLimit(); limited && o.Plan != prev {
+		if used := s.seatsUsed(id); used > limit {
+			return Org{}, &SeatLimitError{Limit: limit, Used: used}
+		}
+	}
 	s.orgs[id] = o
 	return o, nil
 }
 
+// SeatsUsed is how many seats an organization uses: its members whose role is not viewer, and its pending invites for
+// such roles.
+func (s *Store) SeatsUsed(orgID string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.seatsUsed(orgID)
+}
+
+// seatsUsed is SeatsUsed for a caller that holds the lock.
+func (s *Store) seatsUsed(orgID string) int {
+	n := 0
+	for _, m := range s.members {
+		if m.OrgID == orgID && m.Role != RoleViewer {
+			n++
+		}
