+// begin reserves an invoice for a payment; it reports false when the invoice already has one under way.
+func (s *Service) begin(orgID, invoiceID string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	ref := invoiceRef{orgID, invoiceID}
+	if s.inFlight[ref] {
+		return false
+	}
+	if s.inFlight == nil {
+		s.inFlight = map[invoiceRef]bool{}
+	}
+	s.inFlight[ref] = true
+	return true
+}
+
+func (s *Service) end(orgID, invoiceID string) {
