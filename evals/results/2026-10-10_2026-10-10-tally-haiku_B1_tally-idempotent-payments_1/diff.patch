+func TestPayOneChargePerInvoiceAtATime(t *testing.T) {
+	s, gw, _, inv := setup(t, store.Line{Description: "x", Quantity: 1, UnitAmount: 500})
+	other, err := s.Store.CreateInvoice(store.Invoice{OrgID: inv.OrgID, CustomerID: inv.CustomerID, Currency: money.USD,
+		Lines: []store.Line{{Description: "y", Quantity: 1, UnitAmount: 700}}}, time.Date(2026, 2, 1, 12, 0, 0, 0, time.UTC))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Hold the charge of inv while the test pays it again, and pays other.
+	started, release := make(chan struct{}, 2), make(chan struct{})
+	gw.OnCharge = func(req ChargeRequest) {
+		if req.Description == "Invoice "+inv.ID {
+			started <- struct{}{}
+			<-release
+		}
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa")
+		done <- err
+	}()
+	<-started
+
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); !errors.Is(err, ErrPaymentInProgress) {
+		t.Fatalf("second pay of the same invoice: %v", err)
+	}
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, ""); !errors.Is(err, ErrPaymentInProgress) {
+		t.Fatalf("second pay of the same invoice without a method: %v", err)
+	}
+	if paid, _, err := s.Pay(context.Background(), other.OrgID, other.ID, "pm_card_visa"); err != nil || paid.Status != store.InvoicePaid {
+		t.Fatalf("another invoice while one is charged: %+v, %v", paid, err)
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatalf("first pay: %v", err)
+	}
+	if cs := gw.Charges(); len(cs) != 2 {
+		t.Fatalf("%d charges, want 2 (one per invoice)", len(cs))
+	}
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); !errors.Is(err, ErrAlreadyPaid) {
+		t.Fatalf("pay after the charge: %v", err)
+	}
+}
