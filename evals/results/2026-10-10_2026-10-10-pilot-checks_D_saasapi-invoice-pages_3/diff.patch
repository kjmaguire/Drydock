+// InvoicePosition is a place in an account's invoice list, given by one of its invoices.
+type InvoicePosition struct {
+	CreatedAt time.Time
+	ID        string
+}
+
+// InvoicePage returns up to limit of an account's invoices after pos, oldest first (ties by ID), and whether
+// more invoices follow. A nil pos starts at the oldest invoice.
+func (s *Store) InvoicePage(accountID string, pos *InvoicePosition, limit int) ([]Invoice, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Invoice{}
+	for _, inv := range s.invoices {
+		if inv.AccountID != accountID {
+			continue
+		}
+		if pos != nil && !invoiceLess(Invoice{CreatedAt: pos.CreatedAt, ID: pos.ID}, inv) {
+			continue
+		}
+		out = append(out, inv)
+	}
+	sort.Slice(out, func(i, j int) bool { return invoiceLess(out[i], out[j]) })
+	if len(out) > limit {
+		return out[:limit], true
+	}
+	return out, false
+}
+
+// invoiceLess orders invoices oldest first, ties by ID.
+func invoiceLess(a, b Invoice) bool {
+	if !a.CreatedAt.Equal(b.CreatedAt) {
+		return a.CreatedAt.Before(b.CreatedAt)
+	}
+	return a.ID < b.ID
+}
