+	// "!!!" is not base64; "e30" is the JSON object {}; the last one is a cursor with no invoice ID.
+	for _, cursor := range []string{"!!!", "e30", "eyJjIjoiMjAyNi0wMS0wMlQwMzowNDowNVoifQ"} {
+		r := do(t, srv, "GET", "/api/invoices?cursor="+cursor, "key-acme", "")
+		if r.Code != http.StatusBadRequest || !strings.Contains(r.Body.String(), `"invalid_cursor"`) {
+			t.Fatalf("cursor %q: %d %s", cursor, r.Code, r.Body)
