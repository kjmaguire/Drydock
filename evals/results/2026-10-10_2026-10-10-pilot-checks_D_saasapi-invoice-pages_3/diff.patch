+const (
+	defaultPageLimit = 20
+	maxPageLimit     = 100
+)
+
+// invoiceCursor is the position after the last invoice of a page. Clients get it as an opaque string.
+type invoiceCursor struct {
+	CreatedAt time.Time `json:"c"`
+	ID        string    `json:"i"`
+}
+
+func encodeCursor(inv store.Invoice) string {
+	b, _ := json.Marshal(invoiceCursor{CreatedAt: inv.CreatedAt, ID: inv.ID})
+	return base64.RawURLEncoding.EncodeToString(b)
+}
+
+// decodeCursor returns the position a cursor names, or false if the cursor is not one the server issued.
+func decodeCursor(s string) (*store.InvoicePosition, bool) {
+	b, err := base64.RawURLEncoding.DecodeString(s)
+	if err != nil {
+		return nil, false
+	}
+	var c invoiceCursor
+	if err := json.Unmarshal(b, &c); err != nil || c.CreatedAt.IsZero() || c.ID == "" {
+		return nil, false
+	}
+	return &store.InvoicePosition{CreatedAt: c.CreatedAt, ID: c.ID}, true
+}
+
 func (s *Server) listInvoices(w http.ResponseWriter, r *http.Request, acct store.Account) {
+	q := r.URL.Query()
+	limit := defaultPageLimit
+	if q.Has("limit") {
+		n, err := strconv.Atoi(q.Get("limit"))
+		if err != nil || n < 1 || n > maxPageLimit {
+			writeError(w, http.StatusBadRequest, "invalid_limit")
+			return
+		}
+		limit = n
+	}
+	var after *store.InvoicePosition
+	if c := q.Get("cursor"); c != "" {
+		pos, ok := decodeCursor(c)
+		if !ok {
+			writeError(w, http.StatusBadRequest, "invalid_cursor")
+			return
+		}
+		after = pos
+	}
+	page, more := s.store.InvoicePage(acct.ID, after, limit)
 	items := []invoiceView{}
-	for _, inv := range s.store.Invoices(acct.ID) {
+	for _, inv := range page {
 		items = append(items, view(inv))
 	}
-	writeJSON(w, http.StatusOK, map[string]any{"items": items})
+	next := ""
+	if more {
+		next = encodeCursor(page[len(page)-1])
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"items": items, "next_cursor": next})
 }
 
