+func TestPagingSkipsAndRepeatsNothingWhenInvoicesAreCreatedBetweenPages(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	var want []string
+	for i := 0; i < 5; i++ {
+		want = append(want, addInvoice(t, st, now))
+	}
+	got, next := listPage(t, srv, "?limit=2")
+	// New invoices arrive while the client is partway through: one at the same instant, two later.
+	want = append(want, addInvoice(t, st, now))
+	want = append(want, addInvoice(t, st, now.Add(time.Minute)))
+	want = append(want, addInvoice(t, st, now.Add(time.Minute)))
+	for next != "" {
+		var ids []string
+		ids, next = listPage(t, srv, "?limit=2&cursor="+next)
+		got = append(got, ids...)
+	}
+	if strings.Join(got, ",") != strings.Join(want, ",") {
+		t.Fatalf("paged ids %v, want %v", got, want)
+	}
+}
