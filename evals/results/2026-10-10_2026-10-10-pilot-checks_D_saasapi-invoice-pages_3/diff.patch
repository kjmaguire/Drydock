+// addInvoice stores an invoice for Jane of acc_acme, created at the given time, and returns its ID.
+func addInvoice(t *testing.T, st *store.Store, at time.Time) string {
+	t.Helper()
+	c, err := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inv, err := st.CreateInvoice(store.Invoice{AccountID: "acc_acme", CustomerID: c.ID, Lines: []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 100}}}, at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return inv.ID
+}
+
+// listPage fetches one page of acme's invoice list and returns the IDs on it and the next cursor.
+func listPage(t *testing.T, srv http.Handler, query string) ([]string, string) {
+	t.Helper()
+	r := do(t, srv, "GET", "/api/invoices"+query, "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("list %q: %d %s", query, r.Code, r.Body)
+	}
+	var body struct {
+		Items []struct {
+			ID string `json:"id"`
+		} `json:"items"`
+		NextCursor string `json:"next_cursor"`
+	}
+	if err := json.Unmarshal(r.Body.Bytes(), &body); err != nil {
+		t.Fatalf("list %q: %v", query, err)
+	}
+	ids := []string{}
+	for _, it := range body.Items {
+		ids = append(ids, it.ID)
+	}
+	return ids, body.NextCursor
+}
+
+func TestInvoicesArePagedInCreationOrder(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	var want []string
+	for i := 0; i < 45; i++ {
+		want = append(want, addInvoice(t, st, now)) // all at one instant, so the order is by ID
+	}
+	var got []string
+	query := ""
+	pages := 0
+	for {
+		ids, next := listPage(t, srv, query)
+		pages++
+		if len(ids) > 20 {
+			t.Fatalf("page %d has %d items, want at most 20", pages, len(ids))
+		}
+		got = append(got, ids...)
+		if next == "" {
+			break
+		}
+		query = "?cursor=" + next
+	}
+	if pages != 3 {
+		t.Fatalf("got %d pages, want 3", pages)
+	}
+	if strings.Join(got, ",") != strings.Join(want, ",") {
+		t.Fatalf("paged ids %v, want %v", got, want)
+	}
+}
+
+func TestLimitSetsThePageSize(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	for i := 0; i < 3; i++ {
+		addInvoice(t, st, now)
+	}
+	if ids, next := listPage(t, srv, "?limit=1"); len(ids) != 1 || next == "" {
+		t.Fatalf("limit=1: %v, next %q", ids, next)
+	}
+	if ids, next := listPage(t, srv, "?limit=100"); len(ids) != 3 || next != "" {
+		t.Fatalf("limit=100: %v, next %q", ids, next)
+	}
+	if ids, next := listPage(t, srv, ""); len(ids) != 3 || next != "" {
