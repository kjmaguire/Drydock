+
+func TestNextPeriodRealignsADriftedEnd(t *testing.T) {
+	// A period that ended on March 3 (drifted by an old AddDate) realigns onto the anchor's schedule at March 31.
+	anchor := time.Date(2026, 1, 31, 10, 0, 0, 0, time.UTC)
+	start, stop := NextPeriod(anchor, store.Monthly, time.Date(2026, 3, 3, 10, 0, 0, 0, time.UTC))
+	if !start.Equal(time.Date(2026, 3, 3, 10, 0, 0, 0, time.UTC)) || !stop.Equal(time.Date(2026, 3, 31, 10, 0, 0, 0, time.UTC)) {
+		t.Errorf("NextPeriod = %v, %v", start, stop)
+	}
+}
+
+func TestAnchorIsTrialEndWhenThereIsATrial(t *testing.T) {
+	started := time.Date(2026, 1, 31, 10, 0, 0, 0, time.UTC)
+	trialEnd := time.Date(2026, 2, 14, 10, 0, 0, 0, time.UTC)
+	if got := Anchor(store.Subscription{StartedAt: started}); !got.Equal(started) {
+		t.Errorf("Anchor = %v, want StartedAt", got)
