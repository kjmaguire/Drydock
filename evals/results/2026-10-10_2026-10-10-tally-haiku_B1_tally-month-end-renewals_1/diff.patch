 }
 
-// AddInterval returns t moved forward by one billing interval: a month or a year.
+// Anchor is the start of a subscription's billing periods: its trial's end for one that started with a trial, otherwise
+// the time it started.
+func Anchor(sub store.Subscription) time.Time {
+	if sub.TrialEnd != nil {
+		return sub.TrialEnd.UTC()
+	}
+	return sub.StartedAt.UTC()
+}
+
+// PeriodStart returns the start of period n (n = 0, 1, 2, ...) of a schedule anchored at anchor. Period n starts n months
+// (or years) after the anchor, on the anchor's day of the month and at its time of day, or on the month's last day when
+// that month is shorter, so the anchor never drifts: after a short month the schedule is back on the anchor's day. The
+// result is in UTC.
+func PeriodStart(anchor time.Time, iv store.Interval, n int) time.Time {
+	a := anchor.UTC()
+	months := n
+	if iv == store.Yearly {
+		months = 12 * n
+	}
+	first := time.Date(a.Year(), a.Month()+time.Month(months), 1, 0, 0, 0, 0, time.UTC)
+	lastDay := time.Date(first.Year(), first.Month()+1, 0, 0, 0, 0, 0, time.UTC).Day()
+	return time.Date(first.Year(), first.Month(), min(a.Day(), lastDay), a.Hour(), a.Minute(), a.Second(), a.Nanosecond(), time.UTC)
+}
+
+// AddInterval returns t moved forward by one billing interval: a month or a year, on the same day of the month or on the
+// month's last day when the later month is shorter. The result is in UTC.
 func AddInterval(t time.Time, iv store.Interval) time.Time {
+	return PeriodStart(t, iv, 1)
+}
+
+// NextPeriod returns the period that follows one ending at end, on the schedule anchored at anchor. The new period starts
+// at end and ends at the schedule's next boundary after end. When end is on the schedule, that is the boundary of the
+// following period. When end is off it (a period that drifted before the schedule was enforced), the new period is a short
+// one that brings the subscription back onto the schedule.
+func NextPeriod(anchor time.Time, iv store.Interval, end time.Time) (start, stop time.Time) {
+	n := periodIndexFrom(anchor, iv, end)
+	if PeriodStart(anchor, iv, n).Equal(end.UTC()) {
+		n++
+	}
+	return end.UTC(), PeriodStart(anchor, iv, n)
+}
+
+// periodIndexFrom returns the smallest n >= 0 whose period start is not before t.
+func periodIndexFrom(anchor time.Time, iv store.Interval, t time.Time) int {
+	a, u := anchor.UTC(), t.UTC()
+	step := 1
 	if iv == store.Yearly {
-		return t.AddDate(1, 0, 0)
+		step = 12
+	}
+	months := (u.Year()-a.Year())*12 + int(u.Month()-a.Month())
+	n := max(months/step, 0)
+	for n > 0 && !PeriodStart(anchor, iv, n-1).Before(u) {
+		n--
+	}
+	for PeriodStart(anchor, iv, n).Before(u) {
+		n++
 	}
-	return t.AddDate(0, 1, 0)
+	return n
 }
