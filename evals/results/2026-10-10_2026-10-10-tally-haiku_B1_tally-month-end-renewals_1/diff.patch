+// monthEndSub starts a licensed monthly subscription on January 31 at 10:00 UTC, paid by a card that is charged.
+func monthEndSub(t *testing.T, e *apitest.Env, trialDays int) store.Subscription {
+	t.Helper()
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Team", Currency: money.USD, UnitAmount: 2000, Interval: store.Monthly, TrialDays: trialDays}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(time.Date(2026, time.January, 31, 10, 0, 0, 0, time.UTC))
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+// periodStarts returns the period start of each invoice of a subscription, keyed by its day in the form "2006-01-02".
+func periodStarts(e *apitest.Env, sub store.Subscription) map[string]store.Invoice {
+	out := map[string]store.Invoice{}
+	for _, inv := range e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+		if inv.PeriodStart != nil {
+			out[inv.PeriodStart.Format("2006-01-02")] = inv
+		}
+	}
+	return out
+}
+
+func TestRenewalAfterAShortMonthReturnsToTheAnchorDay(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := monthEndSub(t, e, 0)
+	if !sub.CurrentPeriodEnd.Equal(time.Date(2026, 2, 28, 10, 0, 0, 0, time.UTC)) {
+		t.Fatalf("first period ends %v, want Feb 28", sub.CurrentPeriodEnd)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if !got.CurrentPeriodStart.Equal(time.Date(2026, 2, 28, 10, 0, 0, 0, time.UTC)) || !got.CurrentPeriodEnd.Equal(time.Date(2026, 3, 31, 10, 0, 0, 0, time.UTC)) {
+		t.Fatalf("after February = %v to %v, want Feb 28 to Mar 31", got.CurrentPeriodStart, got.CurrentPeriodEnd)
+	}
+	e.Clock.Set(got.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	got, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+	if !got.CurrentPeriodEnd.Equal(time.Date(2026, 4, 30, 10, 0, 0, 0, time.UTC)) {
+		t.Fatalf("after March the period ends %v, want Apr 30", got.CurrentPeriodEnd)
+	}
+}
+
+func TestLateRenewalRenewsEachMissedPeriod(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := monthEndSub(t, e, 0)
+	// The job did not run from Feb 28 until May 3: the periods from Feb 28, Mar 31 and Apr 30 are each renewed in turn.
+	e.Clock.Set(time.Date(2026, 5, 3, 10, 0, 0, 0, time.UTC))
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(time.Date(2026, 4, 30, 10, 0, 0, 0, time.UTC)) ||
+		!got.CurrentPeriodEnd.Equal(time.Date(2026, 5, 31, 10, 0, 0, 0, time.UTC)) {
+		t.Fatalf("subscription = %+v, want the period Apr 30 to May 31", got)
+	}
+	invs := periodStarts(e, sub)
+	for _, day := range []string{"2026-01-31", "2026-02-28", "2026-03-31", "2026-04-30"} {
+		if _, ok := invs[day]; !ok {
+			t.Errorf("no invoice for the period starting %s; invoices: %v", day, invs)
+		}
+	}
+	if len(invs) != 4 {
+		t.Errorf("invoices = %d, want one per period (4)", len(invs))
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 4 {
+		t.Errorf("charges = %d, want 4", len(cs))
+	}
+	if n, _ := e.Subs.RenewDue(ctx); n != 0 {
+		t.Fatalf("renewed again: %d", n)
+	}
+}
+
+func TestLateTrialRenewalStartsAtTheTrialEnd(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := monthEndSub(t, e, 14)
+	trialEnd := sub.TrialEnd.UTC()
+	// The job runs five days after the trial ended: the first paid period still starts when the trial did.
+	e.Clock.Set(trialEnd.AddDate(0, 0, 5))
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if !got.CurrentPeriodStart.Equal(trialEnd) || !got.CurrentPeriodEnd.Equal(time.Date(2026, 3, 14, 10, 0, 0, 0, time.UTC)) {
+		t.Fatalf("after the trial = %v to %v, want %v to Mar 14", got.CurrentPeriodStart, got.CurrentPeriodEnd, trialEnd)
+	}
+}
