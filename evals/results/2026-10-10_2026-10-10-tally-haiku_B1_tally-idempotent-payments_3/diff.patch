diff --git a/result/internal/api/idempotency.go b/result/internal/api/idempotency.go
new file mode 100644
index 0000000..5b09f10
--- /dev/null
+++ b/result/internal/api/idempotency.go
@@ -0,0 +1,99 @@
+package api
+
+import (
+	"bytes"
+	"net/http"
+
+	"example.com/tally/internal/store"
+)
+
+// idempotencyKey returns the request's Idempotency-Key, or "" when it has none. A key that is not 1 to 255 printable ASCII
+// characters, or that is sent more than once, answers 400 and returns false.
+func idempotencyKey(w http.ResponseWriter, r *http.Request) (string, bool) {
+	keys := r.Header.Values("Idempotency-Key")
+	if len(keys) == 0 {
+		return "", true
+	}
+	if len(keys) > 1 || !validIdempotencyKey(keys[0]) {
+		writeError(w, http.StatusBadRequest, "invalid_idempotency_key", "Idempotency-Key is 1 to 255 printable ASCII characters")
+		return "", false
+	}
+	return keys[0], true
+}
+
+func validIdempotencyKey(k string) bool {
+	if len(k) < 1 || len(k) > 255 {
+		return false
+	}
+	for i := 0; i < len(k); i++ {
+		if k[i] < 0x20 || k[i] > 0x7e {
+			return false
+		}
+	}
+	return true
+}
+
+// withIdempotencyKey runs h for a request that carries key, at most once for each key of the organization. The first request
+// with a key is handled and its response is kept, unless it is a server error, which is not kept so that a retry is tried
+// again. A later request with the key gets the kept response back, marked Idempotent-Replayed, when it is for the same
+// invoice with the same payment method (fingerprint); with another invoice or body it answers 422. A request that arrives
+// while the first is still being handled answers 409 at once.
+func (s *Server) withIdempotencyKey(w http.ResponseWriter, r *http.Request, orgID, key, invoiceID, fingerprint string, h func(http.ResponseWriter)) {
+	rec, reserved := s.store.ReserveIdempotencyKey(orgID, key, store.IdempotencyKey{InvoiceID: invoiceID, Fingerprint: fingerprint}, s.clock.Now())
+	if !reserved {
+		switch {
+		case rec.InvoiceID != invoiceID || rec.Fingerprint != fingerprint:
+			writeError(w, http.StatusUnprocessableEntity, "idempotency_key_reused", "this Idempotency-Key was used for another invoice or another request")
+		case !rec.Done:
+			writeError(w, http.StatusConflict, "request_in_progress", "a request with this Idempotency-Key is still being handled")
+		default:
+			if rec.ContentType != "" {
+				w.Header().Set("Content-Type", rec.ContentType)
+			}
+			w.Header().Set("Idempotent-Replayed", "true")
+			w.WriteHeader(rec.Status)
+			_, _ = w.Write(rec.Body)
+		}
+		return
+	}
+	completed := false
+	defer func() {
+		if !completed { // h panicked: there is no response to keep
+			s.store.ReleaseIdempotencyKey(orgID, key)
+		}
+	}()
+	c := &capture{header: http.Header{}}
+	h(c)
+	completed = true
+	if c.status == 0 {
+		c.status = http.StatusOK
+	}
+	s.store.CompleteIdempotencyKey(orgID, key, c.status, c.header.Get("Content-Type"), c.body.Bytes(), s.clock.Now())
+	for k, vs := range c.header {
+		w.Header()[k] = vs
+	}
+	w.WriteHeader(c.status)
+	_, _ = w.Write(c.body.Bytes())
+}
+
+// capture is an http.ResponseWriter that holds the response instead of sending it.
+type capture struct {
+	header http.Header
+	status int
+	body   bytes.Buffer
+}
+
+func (c *capture) Header() http.Header { return c.header }
+
+func (c *capture) WriteHeader(status int) {
+	if c.status == 0 {
+		c.status = status
+	}
+}
+
+func (c *capture) Write(b []byte) (int, error) {
+	if c.status == 0 {
+		c.status = http.StatusOK
+	}
+	return c.body.Write(b)
+}
diff --git a/result/internal/api/idempotency_test.go b/result/internal/api/idempotency_test.go
new file mode 100644
index 0000000..3688c17
--- /dev/null
+++ b/result/internal/api/idempotency_test.go
@@ -0,0 +1,235 @@
+package api_test
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/payments"
+)
+
+var customers atomic.Int64
+
+// invoiceFor creates a customer and an open invoice of 40.00 in org and returns the invoice's ID.
+func invoiceFor(e *apitest.Env, org apitest.Org) string {
+	c := e.CreateCustomer(org, "Jane", fmt.Sprintf("jane%d@example.com", customers.Add(1)))
+	var inv struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", org.Key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Team", "quantity": 1, "unit_amount": 4000}}}, &inv)
+	return inv.ID
+}
+
+// payWithKey pays invoice id with the body {"payment_method": pm} and the Idempotency-Key key ("" for none).
+func payWithKey(e *apitest.Env, org apitest.Org, id, key, pm string) *apitest.Response {
+	h := http.Header{}
+	if key != "" {
+		h.Set("Idempotency-Key", key)
+	}
+	return e.DoWith("POST", "/v1/invoices/"+id+"/pay", org.Key, map[string]string{"payment_method": pm}, h)
+}
+
+// errorCode is the "error" field of an error response.
+func errorCode(t *testing.T, resp *apitest.Response) string {
+	t.Helper()
+	m := resp.Map(t)
+	code, _ := m["error"].(string)
+	return code
+}
+
+// flakyGateway fails its first fail charges with ErrUnavailable, then passes charges on.
+type flakyGateway struct {
+	payments.Gateway
+	fail int
+}
+
+func (f *flakyGateway) Charge(ctx context.Context, req payments.ChargeRequest) (payments.ChargeResult, error) {
+	if f.fail > 0 {
+		f.fail--
+		return payments.ChargeResult{}, payments.ErrUnavailable
+	}
+	return f.Gateway.Charge(ctx, req)
+}
+
+func TestIdempotentPayIsReplayed(t *testing.T) {
+	e := apitest.New(t)
+	id := invoiceFor(e, e.Acme)
+	first := payWithKey(e, e.Acme, id, "pay-1", "pm_card_visa")
+	if first.Code != http.StatusOK || first.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("first: %s", first)
+	}
+	again := payWithKey(e, e.Acme, id, "pay-1", "pm_card_visa")
+	if again.Code != first.Code || !bytes.Equal(again.Body, first.Body) || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("retry = %s (Idempotent-Replayed %q), want the first response %s", again, again.Header.Get("Idempotent-Replayed"), first)
+	}
+	if ct := again.Header.Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("replay Content-Type = %q", ct)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+	if ps := e.Store.Payments(e.Acme.ID, id); len(ps) != 1 {
+		t.Fatalf("%d payments recorded", len(ps))
+	}
+}
+
+func TestKeptErrorsAreReplayedToo(t *testing.T) {
+	e := apitest.New(t)
+	id := invoiceFor(e, e.Acme)
+	declined := payWithKey(e, e.Acme, id, "decline-1", "pm_card_declined")
+	if declined.Code != http.StatusPaymentRequired {
+		t.Fatalf("declined: %s", declined)
+	}
+	again := payWithKey(e, e.Acme, id, "decline-1", "pm_card_declined")
+	if again.Code != http.StatusPaymentRequired || again.Header.Get("Idempotent-Replayed") != "true" || !bytes.Equal(again.Body, declined.Body) {
+		t.Fatalf("retry of a declined payment: %s", again)
+	}
+	if n := len(e.Gateway.Calls()); n != 1 {
+		t.Fatalf("%d gateway calls, want 1", n)
+	}
+
+	missing := payWithKey(e, e.Acme, "inv_nope", "missing-1", "pm_card_visa")
+	if missing.Code != http.StatusNotFound {
+		t.Fatalf("missing invoice: %s", missing)
+	}
+	if again := payWithKey(e, e.Acme, "inv_nope", "missing-1", "pm_card_visa"); again.Code != http.StatusNotFound || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("retry of a 404: %s", again)
+	}
+}
+
+func TestServerErrorsAreNotKept(t *testing.T) {
+	e := apitest.New(t)
+	id := invoiceFor(e, e.Acme)
+	e.Payments.Gateway = &flakyGateway{Gateway: e.Gateway, fail: 1}
+
+	down := payWithKey(e, e.Acme, id, "retry-1", "pm_card_visa")
+	if down.Code != http.StatusServiceUnavailable || errorCode(t, down) != "gateway_unavailable" {
+		t.Fatalf("gateway down: %s", down)
+	}
+	retry := payWithKey(e, e.Acme, id, "retry-1", "pm_card_visa")
+	if retry.Code != http.StatusOK || retry.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("retry after a 503 should pay again: %s", retry)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+	if again := payWithKey(e, e.Acme, id, "retry-1", "pm_card_visa"); again.Code != http.StatusOK || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("request after the payment: %s", again)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges after the replay", n)
+	}
+}
+
+func TestIdempotencyKeyReusedForAnotherRequest(t *testing.T) {
+	e := apitest.New(t)
+	id := invoiceFor(e, e.Acme)
+	other := invoiceFor(e, e.Acme)
+	if resp := payWithKey(e, e.Acme, id, "reuse-1", "pm_card_declined"); resp.Code != http.StatusPaymentRequired {
+		t.Fatalf("first: %s", resp)
+	}
+	for _, c := range []struct{ invoice, pm string }{{other, "pm_card_declined"}, {id, "pm_card_visa"}} {
+		resp := payWithKey(e, e.Acme, c.invoice, "reuse-1", c.pm)
+		if resp.Code != http.StatusUnprocessableEntity || errorCode(t, resp) != "idempotency_key_reused" {
+			t.Fatalf("reuse for invoice %s with %s: %s", c.invoice, c.pm, resp)
+		}
+	}
+	if n := len(e.Gateway.Calls()); n != 1 {
+		t.Fatalf("%d gateway calls", n)
+	}
+}
+
+func TestIdempotencyKeysBelongToAnOrganization(t *testing.T) {
+	e := apitest.New(t)
+	acme, globex := invoiceFor(e, e.Acme), invoiceFor(e, e.Globex)
+	if resp := payWithKey(e, e.Acme, acme, "shared", "pm_card_visa"); resp.Code != http.StatusOK {
+		t.Fatalf("acme: %s", resp)
+	}
+	resp := payWithKey(e, e.Globex, globex, "shared", "pm_card_visa")
+	if resp.Code != http.StatusOK || resp.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("globex with the same key: %s", resp)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("%d charges, want one per organization", n)
+	}
+}
+
+func TestInvalidIdempotencyKeys(t *testing.T) {
+	e := apitest.New(t)
+	id := invoiceFor(e, e.Acme)
+	body := map[string]string{"payment_method": "pm_card_visa"}
+	for _, values := range [][]string{{""}, {"héllo"}, {"a\x01b"}, {"tab\there"}, {strings.Repeat("k", 256)}, {"a", "b"}} {
+		resp := e.DoWith("POST", "/v1/invoices/"+id+"/pay", e.Acme.Key, body, http.Header{"Idempotency-Key": values})
+		if resp.Code != http.StatusBadRequest || errorCode(t, resp) != "invalid_idempotency_key" {
+			t.Fatalf("key %q: %s", values, resp)
+		}
+	}
+	if n := len(e.Gateway.Charges()); n != 0 {
+		t.Fatalf("%d charges for rejected keys", n)
+	}
+	// 1 to 255 printable ASCII characters are fine, the space included.
+	for _, key := range []string{"x", strings.Repeat("k", 255), "a b~!"} {
+		if resp := payWithKey(e, e.Acme, invoiceFor(e, e.Acme), key, "pm_card_visa"); resp.Code != http.StatusOK {
+			t.Fatalf("key %q: %s", key, resp)
+		}
+	}
+}
+
+func TestIdempotencyKeyRequestInProgress(t *testing.T) {
+	e := apitest.New(t)
+	id := invoiceFor(e, e.Acme)
+	started, release := make(chan struct{}), make(chan struct{})
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		close(started)
+		<-release
+	}
+	first := make(chan *apitest.Response, 1)
+	go func() { first <- payWithKey(e, e.Acme, id, "double-click", "pm_card_visa") }()
+	<-started
+
+	if resp := payWithKey(e, e.Acme, id, "double-click", "pm_card_visa"); resp.Code != http.StatusConflict || errorCode(t, resp) != "request_in_progress" {
+		t.Fatalf("same key while in progress: %s", resp)
+	}
+	if resp := payWithKey(e, e.Acme, id, "other-key", "pm_card_visa"); resp.Code != http.StatusConflict || errorCode(t, resp) != "payment_in_progress" {
+		t.Fatalf("another key for the invoice while in progress: %s", resp)
+	}
+	if resp := payWithKey(e, e.Acme, id, "", "pm_card_visa"); resp.Code != http.StatusConflict || errorCode(t, resp) != "payment_in_progress" {
+		t.Fatalf("no key while in progress: %s", resp)
+	}
+	close(release)
+	if resp := <-first; resp.Code != http.StatusOK {
+		t.Fatalf("first request: %s", resp)
+	}
+	if resp := payWithKey(e, e.Acme, id, "double-click", "pm_card_visa"); resp.Code != http.StatusOK || resp.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("retry after the first finished: %s", resp)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestIdempotencyKeyExpiresAfterADay(t *testing.T) {
+	e := apitest.New(t)
+	id := invoiceFor(e, e.Acme)
+	if resp := payWithKey(e, e.Acme, id, "day", "pm_card_declined"); resp.Code != http.StatusPaymentRequired {
+		t.Fatalf("first: %s", resp)
+	}
+	e.Clock.Advance(24*time.Hour - time.Minute)
+	if resp := payWithKey(e, e.Acme, id, "day", "pm_card_declined"); resp.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("within 24 hours: %s", resp)
+	}
+	e.Clock.Advance(time.Minute)
+	if resp := payWithKey(e, e.Acme, id, "day", "pm_card_declined"); resp.Code != http.StatusPaymentRequired || resp.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("after 24 hours the key is new: %s", resp)
+	}
+	if n := len(e.Gateway.Calls()); n != 2 {
+		t.Fatalf("%d gateway calls, want 2", n)
+	}
+}
