diff --git a/result/internal/store/idempotency.go b/result/internal/store/idempotency.go
new file mode 100644
index 0000000..4bfa7bd
--- /dev/null
+++ b/result/internal/store/idempotency.go
@@ -0,0 +1,87 @@
+package store
+
+import "time"
+
+// IdempotencyTTL is how long a kept response is replayed. After it, the key counts as new.
+const IdempotencyTTL = 24 * time.Hour
+
+// idempotencyPruneEvery is how often expired records are removed.
+const idempotencyPruneEvery = time.Hour
+
+// IdempotencyKey is what Tally keeps for a request that carried an Idempotency-Key: the request it was for and, once it
+// is done, the response it got. A record is Done only after its response was kept; until then the request is still being
+// handled. Records belong to an organization.
+type IdempotencyKey struct {
+	OrgID       string    `json:"org_id"`
+	Key         string    `json:"key"`
+	InvoiceID   string    `json:"invoice_id"`
+	Fingerprint string    `json:"fingerprint"` // what the request's body said, for the same-body check
+	Done        bool      `json:"done"`
+	Status      int       `json:"status,omitempty"`
+	ContentType string    `json:"content_type,omitempty"`
+	Body        []byte    `json:"body,omitempty"`
+	At          time.Time `json:"at"` // when the response was kept
+}
+
+// ReserveIdempotencyKey claims key for the request req describes, unless the key is already in use in the organization.
+// When the key is free, or its kept response has expired, it is claimed and reserved is true. Otherwise the record that
+// holds the key is returned with reserved false: its request is still being handled (not Done) or it has a kept response.
+func (s *Store) ReserveIdempotencyKey(orgID, key string, req IdempotencyKey, now time.Time) (rec IdempotencyKey, reserved bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.pruneIdempotencyLocked(now)
+	k := orgKey{orgID, key}
+	if old, ok := s.idem[k]; ok && (!old.Done || now.Sub(old.At) < IdempotencyTTL) {
+		return copyIdempotencyKey(old), false
+	}
+	req.OrgID, req.Key = orgID, key
+	req.Done, req.Status, req.ContentType, req.Body, req.At = false, 0, "", nil, time.Time{}
+	s.idem[k] = req
+	return copyIdempotencyKey(req), true
+}
+
+// CompleteIdempotencyKey keeps the response to a reserved key's request, so that it is replayed until the key expires. A
+// server error (status 500 or more) is not kept: the key is freed, so that a retry is tried again.
+func (s *Store) CompleteIdempotencyKey(orgID, key string, status int, contentType string, body []byte, now time.Time) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := orgKey{orgID, key}
+	rec, ok := s.idem[k]
+	if !ok || rec.Done {
+		return
+	}
+	if status >= 500 {
+		delete(s.idem, k)
+		return
+	}
+	rec.Done, rec.Status, rec.ContentType, rec.Body, rec.At = true, status, contentType, append([]byte(nil), body...), now.UTC()
+	s.idem[k] = rec
+}
+
+// ReleaseIdempotencyKey frees a reserved key whose request produced no response to keep, so that a retry is handled anew.
+func (s *Store) ReleaseIdempotencyKey(orgID, key string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := orgKey{orgID, key}
+	if rec, ok := s.idem[k]; ok && !rec.Done {
+		delete(s.idem, k)
+	}
+}
+
+// pruneIdempotencyLocked removes expired records, at most once an hour. The caller holds the lock.
+func (s *Store) pruneIdempotencyLocked(now time.Time) {
+	if now.Sub(s.idemPruned) < idempotencyPruneEvery {
+		return
+	}
+	s.idemPruned = now
+	for k, rec := range s.idem {
+		if rec.Done && now.Sub(rec.At) >= IdempotencyTTL {
+			delete(s.idem, k)
+		}
+	}
+}
+
+func copyIdempotencyKey(k IdempotencyKey) IdempotencyKey {
+	k.Body = append([]byte(nil), k.Body...)
+	return k
+}
diff --git a/result/internal/store/idempotency_test.go b/result/internal/store/idempotency_test.go
new file mode 100644
index 0000000..3c82478
--- /dev/null
+++ b/result/internal/store/idempotency_test.go
@@ -0,0 +1,116 @@
+package store
+
+import (
+	"bytes"
+	"testing"
+	"time"
+)
+
+func TestIdempotencyKeyLifecycle(t *testing.T) {
+	s := New()
+	req := IdempotencyKey{InvoiceID: "inv_1", Fingerprint: "pm_card_visa"}
+	rec, reserved := s.ReserveIdempotencyKey("org_a", "k1", req, t0)
+	if !reserved || rec.Done {
+		t.Fatalf("first reserve: %+v, %v", rec, reserved)
+	}
+	if rec, reserved := s.ReserveIdempotencyKey("org_a", "k1", req, t0); reserved || rec.Done {
+		t.Fatalf("reserve while pending: %+v, %v", rec, reserved)
+	}
+	if rec, reserved := s.ReserveIdempotencyKey("org_b", "k1", req, t0); !reserved {
+		t.Fatalf("the same key in another organization: %+v", rec)
+	}
+
+	body := []byte(`{"error":"x"}`)
+	s.CompleteIdempotencyKey("org_a", "k1", 402, "application/json", body, t0)
+	body[0] = 'X' // the store kept its own copy
+	rec, reserved = s.ReserveIdempotencyKey("org_a", "k1", req, t0.Add(time.Hour))
+	if reserved || !rec.Done || rec.Status != 402 || rec.ContentType != "application/json" || !bytes.Equal(rec.Body, []byte(`{"error":"x"}`)) {
+		t.Fatalf("after completion: %+v, %v", rec, reserved)
+	}
+	rec.Body[0] = 'Y' // nor does the caller change it
+	if rec, _ := s.ReserveIdempotencyKey("org_a", "k1", req, t0); rec.Body[0] != '{' {
+		t.Fatalf("the kept body was changed: %s", rec.Body)
+	}
+
+	if _, reserved := s.ReserveIdempotencyKey("org_a", "k2", req, t0); !reserved {
+		t.Fatal("k2 reserved")
+	}
+	s.ReleaseIdempotencyKey("org_a", "k2")
+	if _, reserved := s.ReserveIdempotencyKey("org_a", "k2", req, t0); !reserved {
+		t.Fatal("k2 after release")
+	}
+	s.CompleteIdempotencyKey("org_a", "k2", 503, "", nil, t0)
+	if _, reserved := s.ReserveIdempotencyKey("org_a", "k2", req, t0); !reserved {
+		t.Fatal("a key whose response was a server error is not kept")
+	}
+}
+
+func TestIdempotencyKeyExpires(t *testing.T) {
+	s := New()
+	req := IdempotencyKey{InvoiceID: "inv_1"}
+	s.ReserveIdempotencyKey("org_a", "k", req, t0)
+	s.CompleteIdempotencyKey("org_a", "k", 200, "", []byte("{}"), t0)
+	if _, reserved := s.ReserveIdempotencyKey("org_a", "k", req, t0.Add(IdempotencyTTL-time.Second)); reserved {
+		t.Fatal("expired one second early")
+	}
+	if _, reserved := s.ReserveIdempotencyKey("org_a", "k", req, t0.Add(IdempotencyTTL)); !reserved {
+		t.Fatal("not expired after the TTL")
+	}
+}
+
+func TestIdempotencyKeysAreRemovedOnceExpired(t *testing.T) {
+	s := New()
+	req := IdempotencyKey{InvoiceID: "inv_1"}
+	s.ReserveIdempotencyKey("org_a", "old", req, t0)
+	s.CompleteIdempotencyKey("org_a", "old", 200, "", []byte("{}"), t0)
+	later := t0.Add(IdempotencyTTL + time.Hour)
+	s.ReserveIdempotencyKey("org_a", "new", req, later)
+	if _, ok := s.idem[orgKey{"org_a", "old"}]; ok {
+		t.Fatal("the expired key is still held")
+	}
+	if _, ok := s.idem[orgKey{"org_a", "new"}]; !ok {
+		t.Fatal("the new key is not held")
+	}
+}
+
+func TestIdempotencyKeysSurviveExport(t *testing.T) {
+	s := New()
+	req := IdempotencyKey{InvoiceID: "inv_1", Fingerprint: "pm_card_declined"}
+	s.ReserveIdempotencyKey("org_a", "done", req, t0)
+	s.CompleteIdempotencyKey("org_a", "done", 402, "application/json", []byte(`{"error":"payment_declined"}`), t0)
+	s.ReserveIdempotencyKey("org_a", "pending", req, t0)
+
+	loaded, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	rec, reserved := loaded.ReserveIdempotencyKey("org_a", "done", req, t0)
+	if reserved || !rec.Done || rec.Status != 402 || string(rec.Body) != `{"error":"payment_declined"}` {
+		t.Fatalf("kept response after a reload: %+v, %v", rec, reserved)
+	}
+	if _, reserved := loaded.ReserveIdempotencyKey("org_a", "pending", req, t0); !reserved {
+		t.Fatal("a request that was being handled is still held after a reload")
+	}
+}
+
+func TestBeginPayment(t *testing.T) {
+	s := New()
+	end, ok := s.BeginPayment("org_a", "inv_1")
+	if !ok {
+		t.Fatal("first begin refused")
+	}
+	if _, ok := s.BeginPayment("org_a", "inv_1"); ok {
+		t.Fatal("second begin for the same invoice allowed")
+	}
+	if _, ok := s.BeginPayment("org_b", "inv_1"); !ok {
+		t.Fatal("another organization's invoice with the same ID refused")
+	}
+	if _, ok := s.BeginPayment("org_a", "inv_2"); !ok {
+		t.Fatal("another invoice refused")
+	}
+	end()
+	end() // calling it again does nothing
+	if _, ok := s.BeginPayment("org_a", "inv_1"); !ok {
+		t.Fatal("begin after end refused")
+	}
+}
