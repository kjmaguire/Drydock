+// BeginPayment marks an invoice as being charged, so that no other payment of it starts until the returned function is
+// called. It reports false, and marks nothing, when a charge for the invoice is already under way.
+func (s *Store) BeginPayment(orgID, invoiceID string) (func(), bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := orgKey{orgID, invoiceID}
+	if s.paying[k] {
+		return nil, false
+	}
+	s.paying[k] = true
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			s.mu.Lock()
+			defer s.mu.Unlock()
+			delete(s.paying, k)
+		})
+	}, true
+}
