+func TestDowngradeTakesEffectAtRenewal(t *testing.T) {
+	e, c := setup(t)
+	ctx := context.Background()
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	business := e.CreatePlan(e.Acme, "Business", "USD", "50.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: business.ID, Quantity: 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Advance(tenDays)
+	sub, err = e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &team.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sub.PlanID != business.ID || sub.Quantity != 2 || sub.PendingPlanID == nil || *sub.PendingPlanID != team.ID ||
+		sub.PendingQuantity == nil || *sub.PendingQuantity != 2 {
+		t.Fatalf("subscription = %+v", sub)
+	}
+	if n := len(subscriptionInvoices(e, sub)); n != 1 || len(e.Gateway.Charges()) != 1 {
+		t.Fatalf("a downgrade was billed: %d invoices, %d charges", n, len(e.Gateway.Charges()))
+	}
+
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.PlanID != team.ID || got.Quantity != 2 || got.PendingPlanID != nil || got.PendingQuantity != nil || got.Status != store.Active {
+		t.Fatalf("after renewal = %+v", got)
+	}
+	invs := subscriptionInvoices(e, sub)
+	if len(invs) != 2 || len(invs[1].Lines) != 1 || invs[1].Lines[0].UnitAmount != 2000 || invs[1].Lines[0].Quantity != 2 {
+		t.Fatalf("renewal invoice = %+v", invs)
+	}
+}
+
+func TestPendingDowngradeIsReplacedOrCleared(t *testing.T) {
+	e, c := setup(t)
+	ctx := context.Background()
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	business := e.CreatePlan(e.Acme, "Business", "USD", "50.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: business.ID, Quantity: 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Advance(tenDays)
+	update := func(in subscriptions.UpdateInput) store.Subscription {
+		t.Helper()
+		sub, err = e.Subs.Update(ctx, e.Acme.ID, sub.ID, in)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return sub
+	}
+
+	// A smaller quantity is a downgrade: pending, with the current plan.
+	one := 1
+	update(subscriptions.UpdateInput{Quantity: &one})
+	if sub.PendingPlanID == nil || *sub.PendingPlanID != business.ID || sub.PendingQuantity == nil || *sub.PendingQuantity != 1 || sub.Quantity != 2 {
+		t.Fatalf("pending = %+v", sub)
+	}
+	// Back to the current plan and quantity clears it, and bills nothing.
+	two := 2
+	update(subscriptions.UpdateInput{PlanID: &business.ID, Quantity: &two})
+	if sub.PendingPlanID != nil || sub.PendingQuantity != nil || len(subscriptionInvoices(e, sub)) != 1 {
+		t.Fatalf("pending was not cleared: %+v", sub)
+	}
+	// A lower-priced plan is pending again...
+	update(subscriptions.UpdateInput{PlanID: &team.ID})
+	if sub.PendingPlanID == nil || *sub.PendingPlanID != team.ID {
+		t.Fatalf("pending = %+v", sub)
+	}
+	// ...and an upgrade applies at once, clearing it.
+	three := 3
+	update(subscriptions.UpdateInput{Quantity: &three})
+	if sub.PlanID != business.ID || sub.Quantity != 3 || sub.PendingPlanID != nil || sub.PendingQuantity != nil {
+		t.Fatalf("after an upgrade = %+v", sub)
+	}
+	if n := len(subscriptionInvoices(e, sub)); n != 2 {
+		t.Fatalf("invoices = %d, want the first and the upgrade", n)
+	}
+}
