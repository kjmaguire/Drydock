+)
+
+// setup returns a service with a customer of Acme who has a card on file.
+func setup(t *testing.T) (*apitest.Env, store.Customer) {
+	t.Helper()
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	return e, c
+}
+
+// subscriptionInvoices returns the invoices of a subscription, oldest first.
+func subscriptionInvoices(e *apitest.Env, sub store.Subscription) []store.Invoice {
+	return e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+}
+
+// The tests below use a monthly period from apitest.Start (January 15, 2026) to February 15, 2026: 31 days. Ten days in,
+// 21 of the 31 days remain.
+const tenDays = 10 * 24 * time.Hour
+
+func TestUpgradeBillsTheRestOfThePeriod(t *testing.T) {
+	e, c := setup(t)
+	ctx := context.Background()
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	business := e.CreatePlan(e.Acme, "Business", "USD", "50.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: team.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Advance(tenDays)
+	sub, err = e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &business.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sub.PlanID != business.ID || sub.Quantity != 1 || sub.Status != store.Active || sub.PendingPlanID != nil || sub.PendingQuantity != nil {
+		t.Fatalf("subscription = %+v", sub)
+	}
+	if !sub.CurrentPeriodStart.Equal(apitest.Start) || !sub.CurrentPeriodEnd.Equal(apitest.Start.AddDate(0, 1, 0)) {
+		t.Fatalf("the period changed: %v to %v", sub.CurrentPeriodStart, sub.CurrentPeriodEnd)
+	}
+	invs := subscriptionInvoices(e, sub)
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	up := invs[1]
+	// 21/31 of 2000 is 1354.84 (1355); 21/31 of 5000 is 3387.10 (3387).
+	want := []store.Line{{Description: "Unused time on Team", Quantity: 1, UnitAmount: -1355}, {Description: "Remaining time on Business", Quantity: 1, UnitAmount: 3387}}
+	if !slices.Equal(up.Lines, want) || up.Status != store.InvoicePaid {
+		t.Fatalf("upgrade invoice = %+v", up)
+	}
+	if got := billing.Compute(up).Total; got != 2032 {
+		t.Fatalf("upgrade total = %d", got)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[1].Amount != 2032 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
+
+func TestUpgradeAppliesTheDiscountAndTax(t *testing.T) {
