+func TestProratedPlanChangesOverTheAPI(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	business := e.CreatePlan(e.Acme, "Business", "USD", "50.00")
+	eur := e.CreatePlan(e.Acme, "EU", "EUR", "20.00")
+	created := e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": business.ID, "quantity": 1}, nil).Map(t)
+	if _, ok := created["pending_plan_id"]; !ok || created["pending_plan_id"] != nil || created["pending_quantity"] != nil {
+		t.Fatalf("a new subscription has a pending change: %v", created)
+	}
+	path := "/v1/subscriptions/" + created["id"].(string)
+	e.Clock.Advance(10 * 24 * time.Hour)
+
+	// A downgrade is pending: the plan stays, nothing is billed.
+	m := e.MustDo(http.StatusOK, "PATCH", path, e.Acme.Key, map[string]any{"plan_id": team.ID}, nil).Map(t)
+	if m["plan_id"] != business.ID || m["pending_plan_id"] != team.ID || m["pending_quantity"] != float64(1) {
+		t.Fatalf("downgrade = %v", m)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges after a downgrade", n)
+	}
+
+	// A change that is not compatible is refused.
+	if r := e.Do("PATCH", path, e.Acme.Key, map[string]any{"plan_id": eur.ID}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "incompatible_plan" {
+		t.Fatalf("incompatible plan: %s", r)
+	}
+
+	// An upgrade applies at once, clears the pending change and bills the rest of the period.
+	m = e.MustDo(http.StatusOK, "PATCH", path, e.Acme.Key, map[string]any{"quantity": 2}, nil).Map(t)
+	if m["quantity"] != float64(2) || m["pending_plan_id"] != nil || m["pending_quantity"] != nil {
+		t.Fatalf("upgrade = %v", m)
+	}
+	var invs struct {
+		Items []struct {
+			store.Invoice
+			Total int64
+		}
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?customer_id="+c.ID, e.Acme.Key, nil, &invs)
+	// 21/31 of 5000 is 3387.10 (3387); 21/31 of 10000 is 6774.19 (6774).
+	if len(invs.Items) != 2 || invs.Items[1].Total != 3387 || len(invs.Items[1].Lines) != 2 || invs.Items[1].Lines[0].UnitAmount != -3387 {
+		t.Fatalf("invoices = %+v", invs.Items)
+	}
+
+	// A canceled subscription cannot change.
+	e.MustDo(http.StatusOK, "POST", path+"/cancel", e.Acme.Key, nil, nil)
+	if r := e.Do("PATCH", path, e.Acme.Key, map[string]any{"quantity": 1}); r.Code != http.StatusConflict {
+		t.Fatalf("change a canceled subscription: %s", r)
+	}
+}
