+	invs := subscriptionInvoices(e, sub)
+	// Subtotal 2032; 10% off is 203.2 (203); the tax is 20% of 1829, 365.8 (366).
+	if got := billing.Compute(invs[1]); got != (billing.Totals{Subtotal: 2032, Discount: 203, Tax: 366, Total: 2195}) {
+		t.Fatalf("totals = %+v", got)
+	}
+	if cs := e.Gateway.Charges(); cs[len(cs)-1].Amount != 2195 {
+		t.Fatalf("charges = %+v", cs)
