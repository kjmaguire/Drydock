+func TestIncompatiblePlansAreRefused(t *testing.T) {
+	e, c := setup(t)
+	ctx := context.Background()
+	now := e.Clock.Now()
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	eur, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "EU", Currency: money.EUR, UnitAmount: 2000, Interval: store.Monthly}, now)
+	yearly, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Yearly", Currency: money.USD, UnitAmount: 20000, Interval: store.Yearly}, now)
+	metered, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Calls", Currency: money.USD, UnitAmount: 2, Interval: store.Monthly, UsageType: store.Metered}, now)
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: team.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, p := range []store.Plan{eur, yearly, metered} {
+		if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &p.ID}); !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+			t.Fatalf("change to %s: %v", p.Name, err)
+		}
+	}
+	if got, _ := e.Store.Subscription(e.Acme.ID, sub.ID); got.PlanID != team.ID {
+		t.Fatalf("a refused change applied: %+v", got)
+	}
+
+	ms, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: metered.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	two := 2
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, ms.ID, subscriptions.UpdateInput{Quantity: &two}); !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+		t.Fatalf("metered quantity change: %v", err)
+	}
+}
+
+func TestCanceledSubscriptionCannotChange(t *testing.T) {
+	e, c := setup(t)
+	ctx := context.Background()
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: team.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.Subs.Cancel(ctx, e.Acme.ID, sub.ID, false); err != nil {
+		t.Fatal(err)
+	}
+	two := 2
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: &two}); !errors.Is(err, subscriptions.ErrCanceled) {
+		t.Fatalf("update a canceled subscription: %v", err)
+	}
+}
