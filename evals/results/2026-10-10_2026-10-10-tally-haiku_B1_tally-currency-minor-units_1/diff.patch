+func TestPlansInZeroAndThreeDecimalCurrencies(t *testing.T) {
+	e := apitest.New(t)
+	type plan struct {
+		store.Plan
+		Price          string `json:"price"`
+		PriceFormatted string `json:"price_formatted"`
+	}
+	for _, c := range []struct {
+		currency, price, formatted, wantPrice string
+		unit                                  int64
+	}{
+		{"JPY", "1000", "¥1,000", "1000", 1000},
+		{"KWD", "1.250", "KWD 1.250", "1.250", 1250},
+		{"KWD", "7", "KWD 7.000", "7.000", 7000},
+	} {
+		var p plan
+		e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{"name": c.currency, "currency": c.currency, "price": c.price, "interval": "month"}, &p)
+		if p.UnitAmount != c.unit || p.Price != c.wantPrice || p.PriceFormatted != c.formatted {
+			t.Errorf("%s %s: plan = %+v", c.currency, c.price, p)
+		}
+	}
+	for _, bad := range []struct{ currency, price string }{{"JPY", "1000.00"}, {"JPY", "1.5"}, {"KWD", "1.2345"}, {"USD", "1.001"}} {
+		r := e.Do("POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "X", "currency": bad.currency, "price": bad.price, "interval": "month"})
+		if r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_amount" {
+			t.Errorf("%s %s: %s", bad.currency, bad.price, r)
+		}
+	}
+}
