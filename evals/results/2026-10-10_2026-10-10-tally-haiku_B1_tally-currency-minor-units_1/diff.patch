+// A non-negative amount that FormatMajor writes, ParseMajor reads back. ParseMajor reads no signs, so a negative one is refused.
+func TestMajorRoundTrip(t *testing.T) {
+	for _, cur := range []Currency{USD, EUR, GBP, JPY, KWD} {
+		for _, amount := range []int64{0, 1, 99, 1000, 1250, 123456789} {
+			s := FormatMajor(amount, cur)
+			if got, err := ParseMajor(s, cur); err != nil || got != amount {
+				t.Errorf("ParseMajor(%q, %s) = %d, %v; want %d", s, cur, got, err, amount)
+			}
+		}
+		if _, err := ParseMajor(FormatMajor(-5, cur), cur); !errors.Is(err, ErrInvalidAmount) {
+			t.Errorf("ParseMajor of a negative %s amount: %v", cur, err)
+		}
+	}
+}
