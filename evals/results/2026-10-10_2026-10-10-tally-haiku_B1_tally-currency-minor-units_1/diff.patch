+// FormatMajor renders an amount in major units for a person to type or read back with ParseMajor: "12.50", "1000", "1.250",
+// "-0.005". It has the currency's decimals and no thousands separator.
+func FormatMajor(amount int64, c Currency) string {
+	sign, whole, frac := split(amount, c)
+	s := strconv.FormatInt(whole, 10)
+	if frac != "" {
+		s += "." + frac
+	}
+	return sign + s
+}
+
