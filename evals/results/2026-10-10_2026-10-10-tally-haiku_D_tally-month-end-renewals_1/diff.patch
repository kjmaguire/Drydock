+
+// PeriodStart returns the start of period n (n = 0, 1, 2, ...) of a subscription anchored at anchor: n intervals after the
+// anchor, on the anchor's day of the month (or the month's last day when it is shorter) and at the anchor's time of day.
+// Times are UTC. Every period is counted from the anchor, never from the previous period, so a short month does not move
+// the periods after it.
+func PeriodStart(anchor time.Time, iv store.Interval, n int) time.Time {
+	a := anchor.UTC()
+	months := n
+	if iv == store.Yearly {
+		months = 12 * n
+	}
+	first := time.Date(a.Year(), a.Month()+time.Month(months), 1, a.Hour(), a.Minute(), a.Second(), a.Nanosecond(), time.UTC)
+	day := a.Day()
+	if last := time.Date(first.Year(), first.Month()+1, 0, 0, 0, 0, 0, time.UTC).Day(); day > last {
+		day = last
+	}
+	return time.Date(first.Year(), first.Month(), day, a.Hour(), a.Minute(), a.Second(), a.Nanosecond(), time.UTC)
+}
+
+// PeriodIndex returns the smallest n >= 0 for which PeriodStart(anchor, iv, n) is not before t. For a period end t of an
