+// RevenueReport adds up the organization's succeeded payments per day, week or month (group; the empty group is day) from
+// the day from to the day to (YYYY-MM-DD, both included). Days are days in the organization's time zone, so a payment
+// belongs to the day it was made there. Every bucket from the one holding from to the one holding to is in the report, in
+// order, also those without payments.
+func RevenueReport(st *store.Store, orgID, from, to string, group Group) (Report, error) {
+	org, loc, first, last, err := window(st, orgID, from, to)
+	if err != nil {
+		return Report{}, err
+	}
+	if group == "" {
+		group = GroupDay
+	}
+	if group != GroupDay && group != GroupWeek && group != GroupMonth {
+		return Report{}, fmt.Errorf("%w: %q", ErrInvalidGroup, group)
+	}
+	r := Report{TimeZone: org.TimeZone, Group: group, Buckets: []Bucket{}}
+	index := map[string]int{}
+	for b, end := bucketStart(first, group), bucketStart(last, group); !b.After(end); b = nextBucket(b, group) {
+		index[b.Format(time.DateOnly)] = len(r.Buckets)
+		r.Buckets = append(r.Buckets, Bucket{Start: b.Format(time.DateOnly), Amounts: map[money.Currency]int64{}})
+	}
+	for _, d := range succeededPayments(st, orgID, loc, first, last) {
+		b := &r.Buckets[index[bucketStart(d.day, group).Format(time.DateOnly)]]
+		b.Amounts[d.p.Currency] += d.p.Amount
+		b.Payments++
+	}
+	return r, nil
