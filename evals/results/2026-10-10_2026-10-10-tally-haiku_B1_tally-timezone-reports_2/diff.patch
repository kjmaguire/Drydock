+
+// window checks the range and returns the organization's time zone with the first and last day of the range, as UTC
+// dates (calendar days, so they have no time zone of their own).
+func window(st *store.Store, orgID, from, to string) (store.Org, *time.Location, time.Time, time.Time, error) {
+	start, err := time.Parse(time.DateOnly, from)
+	if err != nil {
+		return store.Org{}, nil, time.Time{}, time.Time{}, fmt.Errorf("%w: from %q", ErrInvalidDate, from)
+	}
+	last, err := time.Parse(time.DateOnly, to)
+	if err != nil {
+		return store.Org{}, nil, time.Time{}, time.Time{}, fmt.Errorf("%w: to %q", ErrInvalidDate, to)
+	}
+	if last.Before(start) {
+		return store.Org{}, nil, time.Time{}, time.Time{}, fmt.Errorf("%w: to is before from", ErrInvalidRange)
+	}
+	if last.Sub(start) >= MaxDays*24*time.Hour {
+		return store.Org{}, nil, time.Time{}, time.Time{}, fmt.Errorf("%w: at most %d days", ErrInvalidRange, MaxDays)
+	}
+	org, ok := st.Org(orgID)
+	if !ok {
+		return store.Org{}, nil, time.Time{}, time.Time{}, store.ErrNotFound
+	}
+	loc, err := time.LoadLocation(org.TimeZone)
+	if err != nil {
+		return store.Org{}, nil, time.Time{}, time.Time{}, fmt.Errorf("organization time zone %q: %w", org.TimeZone, err)
+	}
+	return org, loc, start, last, nil
+}
+
+// datedPayment is a succeeded payment and the day it was made on, in the time zone it was dated in.
+type datedPayment struct {
+	day time.Time // a UTC date
+	p   store.Payment
+}
+
+// succeededPayments returns the organization's succeeded payments made on days from first to last (UTC dates), where days
+// are days in loc.
+func succeededPayments(st *store.Store, orgID string, loc *time.Location, first, last time.Time) []datedPayment {
+	var out []datedPayment
+	for _, p := range st.Payments(orgID, "") {
+		if p.Status != store.PaymentSucceeded {
+			continue
+		}
+		local := p.CreatedAt.In(loc)
+		day := time.Date(local.Year(), local.Month(), local.Day(), 0, 0, 0, 0, time.UTC)
+		if day.Before(first) || day.After(last) {
+			continue
+		}
+		out = append(out, datedPayment{day: day, p: p})
+	}
+	return out
+}
+
+// bucketStart is the first day of the group's bucket that holds day d (a UTC date).
+func bucketStart(d time.Time, group Group) time.Time {
+	switch group {
+	case GroupWeek:
+		return d.AddDate(0, 0, -((int(d.Weekday()) + 6) % 7)) // back to Monday
+	case GroupMonth:
+		return time.Date(d.Year(), d.Month(), 1, 0, 0, 0, 0, time.UTC)
+	}
+	return d
+}
+
+// nextBucket is the first day of the bucket after the one starting on b.
+func nextBucket(b time.Time, group Group) time.Time {
+	switch group {
+	case GroupWeek:
+		return b.AddDate(0, 0, 7)
+	case GroupMonth:
+		return b.AddDate(0, 1, 0)
+	}
+	return b.AddDate(0, 0, 1)
+}
