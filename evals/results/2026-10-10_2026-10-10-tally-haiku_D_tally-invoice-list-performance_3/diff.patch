+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+// listedInvoice is an invoice as the list shows it, with its customer.
+type listedInvoice struct {
+	store.Invoice
+	Customer *struct {
+		ID string `json:"id"`
+	} `json:"customer"`
+}
+
+// invoicePage GETs one page of the invoice list and returns its items and next_cursor.
+func invoicePage(t *testing.T, e *apitest.Env, key, path string) ([]listedInvoice, string) {
+	t.Helper()
+	var body struct {
+		Items      []listedInvoice `json:"items"`
+		NextCursor string          `json:"next_cursor"`
+	}
+	e.MustDo(http.StatusOK, "GET", path, key, nil, &body)
+	return body.Items, body.NextCursor
+}
+
+// walkInvoices follows next_cursor from cursor (or from the first page) and returns every invoice ID it reaches.
+func walkInvoices(t *testing.T, e *apitest.Env, key, query string, limit int, cursor string) []string {
+	t.Helper()
+	ids := []string{}
+	for {
+		path := fmt.Sprintf("/v1/invoices?limit=%d%s", limit, query)
+		if cursor != "" {
+			path += "&cursor=" + cursor
+		}
+		items, next := invoicePage(t, e, key, path)
+		for _, inv := range items {
+			ids = append(ids, inv.ID)
+		}
+		if next == "" {
+			return ids
+		}
+		cursor = next
+	}
+}
+
+func TestInvoiceListPaging(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	joe := e.CreateCustomer(e.Acme, "Joe", "joe@example.com")
+	create := func(c store.Customer) {
+		t.Helper()
+		e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{
+			"customer_id": c.ID, "currency": "USD", "lines": []any{map[string]any{"description": "Seat", "quantity": 1, "unit_amount": 500}},
+		}, nil)
+	}
+	for i := 0; i < 25; i++ {
+		// Three invoices share each creation time, so ties are ordered by ID.
+		if i > 0 && i%3 == 0 {
+			e.Clock.Advance(time.Minute)
+		}
+		c := jane
+		if i%2 == 1 {
+			c = joe
+		}
+		create(c)
+	}
+	// Pay one and void another, so the status filters have something to choose from.
+	all, _ := invoicePage(t, e, e.Acme.Key, "/v1/invoices?limit=100")
+	if len(all) != 25 {
+		t.Fatalf("%d invoices, want 25", len(all))
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+all[0].ID+"/pay", e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+all[1].ID+"/void", e.Acme.Key, nil, nil)
+	// An invoice of another organization is never listed.
+	globexCustomer := e.CreateCustomer(e.Globex, "Gus", "gus@example.com")
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Globex.Key, map[string]any{
+		"customer_id": globexCustomer.ID, "currency": "USD", "lines": []any{map[string]any{"description": "Seat", "quantity": 1, "unit_amount": 500}},
+	}, nil)
+
+	all, _ = invoicePage(t, e, e.Acme.Key, "/v1/invoices?limit=100")
+	isJane := func(inv listedInvoice) bool { return inv.Customer != nil && inv.Customer.ID == jane.ID }
+	isJoe := func(inv listedInvoice) bool { return inv.Customer != nil && inv.Customer.ID == joe.ID }
+	queries := []struct {
+		query string
+		match func(listedInvoice) bool
+	}{
+		{"", func(listedInvoice) bool { return true }},
+		{"&customer_id=" + jane.ID, isJane},
+		{"&customer_id=" + joe.ID, isJoe},
+		{"&status=open", func(inv listedInvoice) bool { return inv.Status == store.InvoiceOpen }},
+		{"&status=paid", func(inv listedInvoice) bool { return inv.Status == store.InvoicePaid }},
+		{"&status=void", func(inv listedInvoice) bool { return inv.Status == store.InvoiceVoid }},
+		{"&customer_id=" + joe.ID + "&status=open", func(inv listedInvoice) bool { return isJoe(inv) && inv.Status == store.InvoiceOpen }},
+	}
+	for _, q := range queries {
+		want := []string{}
+		for _, inv := range all {
+			if q.match(inv) {
+				want = append(want, inv.ID)
+			}
+		}
+		for _, limit := range []int{1, 4, 7, 100} {
+			got := walkInvoices(t, e, e.Acme.Key, q.query, limit, "")
+			if fmt.Sprint(got) != fmt.Sprint(want) {
+				t.Errorf("query %q, pages of %d: got %v, want %v", q.query, limit, got, want)
+			}
+		}
+	}
+
+	// Paging keeps working while invoices are created between pages: the rest of the walk sees the new ones at the end.
+	first, next := invoicePage(t, e, e.Acme.Key, "/v1/invoices?limit=5")
+	if next == "" || len(first) != 5 {
+		t.Fatalf("first page = %d invoices, next %q", len(first), next)
+	}
+	e.Clock.Advance(time.Minute)
+	create(jane)
+	create(joe)
+	create(jane)
+	rest := walkInvoices(t, e, e.Acme.Key, "", 5, next)
+	got := []string{}
+	for _, inv := range first {
+		got = append(got, inv.ID)
+	}
+	got = append(got, rest...)
+	full, _ := invoicePage(t, e, e.Acme.Key, "/v1/invoices?limit=100")
+	want := []string{}
+	for _, inv := range full {
+		want = append(want, inv.ID)
+	}
+	if len(want) != 28 || fmt.Sprint(got) != fmt.Sprint(want) {
+		t.Errorf("paging across creates: got %d invoices %v, want %d %v", len(got), got, len(want), want)
+	}
+
+	for _, path := range []string{"/v1/invoices?status=bogus", "/v1/invoices?limit=0", "/v1/invoices?cursor=bad"} {
+		if r := e.Do("GET", path, e.Acme.Key, nil); r.Code != http.StatusBadRequest {
+			t.Errorf("GET %s = %d, want 400", path, r.Code)
+		}
+	}
+}
+
+// BenchmarkListInvoicesLargeOrganization times one page of the invoice list for an organization with 60,000 invoices and
+// 5,000 customers, next to another organization's invoices.
+func BenchmarkListInvoicesLargeOrganization(b *testing.B) {
+	e := apitest.New(b)
+	now := e.Clock.Now()
+	customers := make([]string, 0, 5000)
+	for i := 0; i < 5000; i++ {
+		c, err := e.Store.CreateCustomer(e.Acme.ID, fmt.Sprintf("Customer %d", i), fmt.Sprintf("c%d@acme.example", i), now)
+		if err != nil {
+			b.Fatal(err)
+		}
+		customers = append(customers, c.ID)
+	}
+	for i := 0; i < 60000; i++ {
+		_, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: customers[i%len(customers)], Currency: money.USD,
+			Lines: []store.Line{{Description: "Seat", Quantity: 1, UnitAmount: 500}}}, now.Add(time.Duration(i/3)*time.Second))
+		if err != nil {
+			b.Fatal(err)
+		}
+	}
+	for _, query := range []string{"", "?customer_id=" + customers[7], "?status=void", "?subscription_id=none"} {
+		b.Run(query, func(b *testing.B) {
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				if r := e.Do("GET", "/v1/invoices"+query, e.Acme.Key, nil); r.Code != http.StatusOK {
+					b.Fatalf("GET = %d", r.Code)
+				}
+			}
+		})
+	}
+}
