+package store
+
+import (
+	"fmt"
+	"sort"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+// invoicesInOrder is the reference order, computed from a copy of the whole store: the organization's invoices that pass
+// match, oldest first, ties by ID.
+func invoicesInOrder(s *Store, orgID string, match func(Invoice) bool) []string {
+	var want []Invoice
+	for _, inv := range s.Export().Invoices {
+		if inv.OrgID == orgID && match(inv) {
+			want = append(want, inv)
+		}
+	}
+	sort.Slice(want, func(i, j int) bool {
+		if !want[i].CreatedAt.Equal(want[j].CreatedAt) {
+			return want[i].CreatedAt.Before(want[j].CreatedAt)
+		}
+		return want[i].ID < want[j].ID
+	})
+	ids := []string{}
+	for _, inv := range want {
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
+
+// pagedInvoices follows InvoicePage from the first page to the last, pages of limit invoices.
+func pagedInvoices(t *testing.T, s *Store, orgID string, f InvoiceFilter, limit int) []string {
+	t.Helper()
+	ids := []string{}
+	var after *InvoiceKey
+	for pages := 0; ; pages++ {
+		if pages > 100000 {
+			t.Fatal("paging does not end")
+		}
+		items, more := s.InvoicePage(orgID, f, after, limit)
+		for _, inv := range items {
+			ids = append(ids, inv.ID)
+		}
+		if !more {
+			return ids
+		}
+		if len(items) == 0 {
+			t.Fatal("a page with more to come is empty")
+		}
+		last := items[len(items)-1]
+		after = &InvoiceKey{CreatedAt: last.CreatedAt, ID: last.ID}
+	}
+}
+
+func TestInvoicePageMatchesOrder(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Ben", "ben@example.com", t0)
+	// Creation times repeat and go backwards, so the order is not the order of creation.
+	times := []time.Time{t0.Add(time.Hour), t0, t0.Add(time.Hour), t0.Add(-time.Hour), t0, t0.Add(2 * time.Hour), t0, t0.Add(time.Hour)}
+	for i, at := range times {
+		inv := Invoice{OrgID: a.ID, CustomerID: ca.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}
+		if i%3 == 1 {
+			inv.SubscriptionID = "sub_1"
+		}
+		if _, err := s.CreateInvoice(inv, at); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := s.CreateInvoice(Invoice{OrgID: b.ID, CustomerID: cb.ID, Currency: money.EUR, Lines: []Line{{Description: "y", Quantity: 1, UnitAmount: 1}}}, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	paid := func(inv Invoice) bool { return inv.Status == InvoicePaid }
+	if _, err := s.UpdateInvoice(a.ID, invoicesInOrder(s, a.ID, func(Invoice) bool { return true })[4], func(i *Invoice) error {
+		i.Status = InvoicePaid
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+
+	filters := []struct {
+		name  string
+		f     InvoiceFilter
+		match func(Invoice) bool
+	}{
+		{"none", InvoiceFilter{}, func(Invoice) bool { return true }},
+		{"customer", InvoiceFilter{CustomerID: ca.ID}, func(inv Invoice) bool { return inv.CustomerID == ca.ID }},
+		{"other customer", InvoiceFilter{CustomerID: cb.ID}, func(inv Invoice) bool { return inv.CustomerID == cb.ID }},
+		{"subscription", InvoiceFilter{SubscriptionID: "sub_1"}, func(inv Invoice) bool { return inv.SubscriptionID == "sub_1" }},
+		{"open", InvoiceFilter{Status: InvoiceOpen}, func(inv Invoice) bool { return inv.Status == InvoiceOpen }},
+		{"paid", InvoiceFilter{Status: InvoicePaid}, paid},
+		{"paid and subscription", InvoiceFilter{Status: InvoicePaid, SubscriptionID: "sub_1"}, func(inv Invoice) bool { return paid(inv) && inv.SubscriptionID == "sub_1" }},
+		{"nothing", InvoiceFilter{CustomerID: "cus_none"}, func(Invoice) bool { return false }},
+	}
+	for _, c := range filters {
+		want := invoicesInOrder(s, a.ID, c.match)
+		if got := s.ListInvoices(a.ID, c.f); !sameIDs(got, want) {
+			t.Errorf("%s: ListInvoices = %v, want %v", c.name, idsOf(got), want)
+		}
+		for limit := 1; limit <= len(want)+1; limit++ {
+			if got := pagedInvoices(t, s, a.ID, c.f, limit); !sameStrings(got, want) {
+				t.Errorf("%s, pages of %d: got %v, want %v", c.name, limit, got, want)
+			}
+		}
+	}
+
+	// A position in the order works whether or not an invoice sits at it, and a page after the last invoice is empty.
+	all := invoicesInOrder(s, a.ID, func(Invoice) bool { return true })
+	last, _ := s.InvoiceByID(all[len(all)-1])
+	items, more := s.InvoicePage(a.ID, InvoiceFilter{}, &InvoiceKey{CreatedAt: last.CreatedAt, ID: last.ID}, 10)
+	if len(items) != 0 || more {
+		t.Errorf("a page after the last invoice = %v, %v", idsOf(items), more)
+	}
+	mid, _ := s.InvoiceByID(all[2])
+	items, _ = s.InvoicePage(a.ID, InvoiceFilter{}, &InvoiceKey{CreatedAt: mid.CreatedAt, ID: mid.ID}, 1)
+	if len(items) != 1 || items[0].ID != all[3] {
+		t.Errorf("the page after %s starts with %v, want %s", mid.ID, idsOf(items), all[3])
+	}
+	if got := s.ListInvoices("org_none", InvoiceFilter{}); len(got) != 0 {
+		t.Errorf("an unknown organization has invoices: %v", idsOf(got))
+	}
+}
+
+func TestInvoicePageAfterCreateAndRestore(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	create := func(st *Store, at time.Time) {
+		t.Helper()
+		if _, err := st.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := 0; i < 20; i++ {
+		create(s, t0.Add(time.Duration(i%7)*time.Minute))
+	}
+	// Restored from a snapshot, the order is rebuilt the same way.
+	restored, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	all := func(Invoice) bool { return true }
+	for _, st := range []*Store{s, restored} {
+		if got := pagedInvoices(t, st, a.ID, InvoiceFilter{}, 3); !sameStrings(got, invoicesInOrder(st, a.ID, all)) {
+			t.Fatalf("paging after create or restore = %v", got)
+		}
+	}
+	// Invoices created later, some with earlier times, keep the order.
+	create(restored, t0.Add(-time.Hour))
+	create(restored, t0.Add(3*time.Minute))
+	create(restored, t0.Add(time.Hour))
+	if got := pagedInvoices(t, restored, a.ID, InvoiceFilter{}, 4); !sameStrings(got, invoicesInOrder(restored, a.ID, all)) {
+		t.Fatalf("paging after later creates = %v", got)
+	}
+}
+
+func TestInvoicePageLargeOrganization(t *testing.T) {
+	s := New()
+	big := newOrg(t, s, "Big")
+	other := newOrg(t, s, "Other")
+	var customers []Customer
+	for i := 0; i < 5000; i++ {
+		c, err := s.CreateCustomer(big.ID, fmt.Sprintf("Customer %d", i), fmt.Sprintf("c%d@big.example", i), t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		customers = append(customers, c)
+	}
+	oc, _ := s.CreateCustomer(other.ID, "Other", "o@other.example", t0)
+	for i := 0; i < 60000; i++ {
+		inv := Invoice{OrgID: big.ID, CustomerID: customers[i%len(customers)].ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}
+		if i%4 == 0 {
+			inv.SubscriptionID = "sub_1"
+		}
+		if _, err := s.CreateInvoice(inv, t0.Add(time.Duration(i/3)*time.Second)); err != nil {
+			t.Fatal(err)
+		}
+		if i%10 == 0 {
+			if _, err := s.CreateInvoice(Invoice{OrgID: other.ID, CustomerID: oc.ID, Currency: money.USD, Lines: []Line{{Description: "y", Quantity: 1, UnitAmount: 1}}}, t0.Add(time.Duration(i/3)*time.Second)); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	cust := customers[7].ID
+	for _, c := range []struct {
+		name  string
+		f     InvoiceFilter
+		match func(Invoice) bool
+	}{
+		{"none", InvoiceFilter{}, func(Invoice) bool { return true }},
+		{"customer", InvoiceFilter{CustomerID: cust}, func(inv Invoice) bool { return inv.CustomerID == cust }},
+		{"subscription", InvoiceFilter{SubscriptionID: "sub_1"}, func(inv Invoice) bool { return inv.SubscriptionID == "sub_1" }},
+	} {
+		want := invoicesInOrder(s, big.ID, c.match)
+		if got := pagedInvoices(t, s, big.ID, c.f, 100); !sameStrings(got, want) {
+			t.Errorf("%s: %d invoices, want %d", c.name, len(got), len(want))
+		}
+	}
+}
+
+func sameIDs(items []Invoice, want []string) bool { return sameStrings(idsOf(items), want) }
+
+func idsOf(items []Invoice) []string {
+	ids := []string{}
+	for _, inv := range items {
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
+
+func sameStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
