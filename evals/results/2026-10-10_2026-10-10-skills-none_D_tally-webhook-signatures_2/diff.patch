+		{24 * time.Hour, []string{"whsec_new"}},
+	} {
+		if got := webhooks.SigningSecrets(ep, rotated.Add(c.at)); !slices.Equal(got, c.want) {
+			t.Fatalf("SigningSecrets after %v = %v, want %v", c.at, got, c.want)
+		}
+	}
+	if got := webhooks.SigningSecrets(store.WebhookEndpoint{Secret: "whsec_new"}, rotated); !slices.Equal(got, []string{"whsec_new"}) {
+		t.Fatalf("an endpoint never rotated: %v", got)
+	}
+}
+
+func TestRotateSecret(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/all", Events: []string{"*"}, Secret: "whsec_a", Enabled: true}, e.Clock.Now())
+	// send publishes an event, sends it and returns the request the endpoint received.
+	send := func() apitest.Request {
+		t.Helper()
+		if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+			t.Fatal(err)
+		}
+		if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+			t.Fatalf("RunDue = %d, %v", n, err)
+		}
+		reqs := e.HTTP.Requests()
+		return reqs[len(reqs)-1]
+	}
+
+	first, err := e.Webhooks.RotateSecret(e.Acme.ID, ep.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.Secret == "whsec_a" || !strings.HasPrefix(first.Secret, "whsec_") || len(first.Secret) != len("whsec_")+32 {
+		t.Fatalf("new secret = %q", first.Secret)
+	}
+	rotatedAt := e.Clock.Now()
+	req := send()
+	header := req.Header.Get("Tally-Signature")
+	if want := webhooks.SignatureHeader([]string{first.Secret, "whsec_a"}, rotatedAt, req.Body); header != want {
+		t.Fatalf("header = %q, want %q", header, want)
+	}
+	if err := webhooks.Verify(req.Body, header, []string{"whsec_a"}, 0, rotatedAt); err != nil {
+		t.Fatalf("the previous secret stopped working within 24 hours: %v", err)
+	}
+
+	e.Clock.Set(rotatedAt.Add(webhooks.PreviousSecretTTL - time.Second))
+	if header := send().Header.Get("Tally-Signature"); strings.Count(header, "v1=") != 2 {
+		t.Fatalf("header 23h59m59s after the rotation = %q, want two v1 entries", header)
+	}
+
+	e.Clock.Set(rotatedAt.Add(webhooks.PreviousSecretTTL))
+	req = send()
+	header = req.Header.Get("Tally-Signature")
+	if want := webhooks.SignatureHeader([]string{first.Secret}, e.Clock.Now(), req.Body); header != want {
+		t.Fatalf("header after 24 hours = %q, want only the new secret", header)
+	}
+	if err := webhooks.Verify(req.Body, header, []string{"whsec_a"}, 0, e.Clock.Now()); err == nil {
+		t.Fatal("the previous secret still signed after 24 hours")
+	}
+
+	// A second rotation drops the oldest secret at once.
+	second, err := e.Webhooks.RotateSecret(e.Acme.ID, ep.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req = send()
+	header = req.Header.Get("Tally-Signature")
+	if want := webhooks.SignatureHeader([]string{second.Secret, first.Secret}, e.Clock.Now(), req.Body); header != want {
+		t.Fatalf("header after a second rotation = %q, want %q", header, want)
+	}
+	if err := webhooks.Verify(req.Body, header, []string{"whsec_a"}, 0, e.Clock.Now()); err == nil {
+		t.Fatal("the secret before the first rotation still signed after a second rotation")
+	}
+
+	if _, err := e.Webhooks.RotateSecret(e.Acme.ID, "we_missing"); !errors.Is(err, store.ErrNotFound) {
+		t.Fatalf("rotating a missing endpoint = %v", err)
+	}
+	if _, err := e.Webhooks.RotateSecret(e.Globex.ID, ep.ID); !errors.Is(err, store.ErrNotFound) {
+		t.Fatalf("rotating another organization's endpoint = %v", err)
+	}
+}
+
+// A rotation must survive a restart: the snapshot is the store's state as JSON, so the state is round-tripped through JSON
+// before it is restored.
+func TestRotationSurvivesSnapshot(t *testing.T) {
+	e := apitest.New(t)
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/all", Events: []string{"*"}, Secret: "whsec_a", Enabled: true}, e.Clock.Now())
+	if _, err := e.Webhooks.RotateSecret(e.Acme.ID, ep.ID); err != nil {
+		t.Fatal(err)
+	}
+	rotatedAt := e.Clock.Now()
+
+	b, err := json.Marshal(e.Store.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var st store.State
+	if err := json.Unmarshal(b, &st); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := store.FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, ok := restored.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if !ok {
+		t.Fatal("the endpoint is missing after the restart")
+	}
+	// The API serves the endpoint as JSON, which must not show the previous secret.
+	if b, _ := json.Marshal(got); strings.Contains(string(b), "whsec_a") {
+		t.Fatalf("the endpoint's JSON shows the previous secret: %s", b)
+	}
+	for _, c := range []struct {
+		at   time.Duration
+		want []string
+	}{
+		{time.Hour, []string{got.Secret, "whsec_a"}},
+		{24*time.Hour - time.Second, []string{got.Secret, "whsec_a"}},
+		{24 * time.Hour, []string{got.Secret}},
+	} {
+		if s := webhooks.SigningSecrets(got, rotatedAt.Add(c.at)); !slices.Equal(s, c.want) {
+			t.Fatalf("SigningSecrets after the restart, %v after the rotation = %v, want %v", c.at, s, c.want)
+		}
+	}
+}
