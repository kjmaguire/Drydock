+// RotateSecret gives an endpoint a new secret. The secret it replaces keeps signing deliveries for PreviousSecretTTL; a
+// rotation before then drops that older secret at once.
+func (s *Service) RotateSecret(orgID, id string) (store.WebhookEndpoint, error) {
+	now := s.clock.Now()
+	return s.store.UpdateWebhookEndpoint(orgID, id, func(ep *store.WebhookEndpoint) error {
+		ep.PreviousSecret = ep.Secret
+		ep.Secret = NewSecret()
+		ep.SecretRotatedAt = now
+		return nil
+	})
+}
+
 // Sign returns the signature of a delivery's body: the hex HMAC-SHA256 of the body, keyed with the endpoint's secret.
 func Sign(secret string, body []byte) string {
+	return sign(secret, body)
+}
+
+// PreviousSecretTTL is how long a rotated-out secret keeps signing deliveries.
+const PreviousSecretTTL = 24 * time.Hour
+
+// DefaultTolerance is the timestamp tolerance Verify uses when it is given 0.
+const DefaultTolerance = 5 * time.Minute
+
+// SigningSecrets returns the secrets that sign a delivery sent at now: the current secret first, then the previous one for
+// PreviousSecretTTL after a rotation.
+func SigningSecrets(ep store.WebhookEndpoint, now time.Time) []string {
+	secrets := []string{ep.Secret}
+	if ep.PreviousSecret != "" && now.Before(ep.SecretRotatedAt.Add(PreviousSecretTTL)) {
+		secrets = append(secrets, ep.PreviousSecret)
+	}
+	return secrets
+}
+
+// SignatureHeader returns the Tally-Signature header of a delivery of body at time t: "t=<unix seconds>" followed by one
+// "v1=<signature>" per secret, the current secret first. Each signature is the hex HMAC-SHA256 of "<t>.<body>".
+func SignatureHeader(secrets []string, t time.Time, body []byte) string {
+	ts := strconv.FormatInt(t.Unix(), 10)
+	payload := signedPayload(ts, body)
+	parts := []string{"t=" + ts}
+	for _, secret := range secrets {
+		parts = append(parts, "v1="+sign(secret, payload))
+	}
+	return strings.Join(parts, ",")
+}
+
+// Verify checks a Tally-Signature header against the payload of a delivery. It returns nil when the header's timestamp is
+// within tolerance of now (either way; 0 means DefaultTolerance) and one of its v1 signatures matches the payload signed with
+// one of secrets.
+func Verify(payload []byte, header string, secrets []string, tolerance time.Duration, now time.Time) error {
+	if strings.TrimSpace(header) == "" {
+		return fmt.Errorf("%w: the header is empty", ErrMalformedHeader)
+	}
+	var ts int64
+	var v1s []string
+	hasTS := false
+	for _, pair := range strings.Split(header, ",") {
+		key, value, ok := strings.Cut(pair, "=")
+		if !ok {
+			return fmt.Errorf("%w: %q is not a key=value pair", ErrMalformedHeader, strings.TrimSpace(pair))
+		}
+		key, value = strings.TrimSpace(key), strings.TrimSpace(value)
+		switch key {
+		case "t":
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil {
+				return fmt.Errorf("%w: the timestamp %q is not an integer", ErrMalformedHeader, value)
+			}
+			if !hasTS {
+				ts, hasTS = n, true
+			}
+		case "v1":
+			v1s = append(v1s, value)
+		}
+	}
+	if !hasTS {
+		return fmt.Errorf("%w: the header has no timestamp", ErrNoTimestamp)
+	}
+	if tolerance <= 0 {
+		tolerance = DefaultTolerance
+	}
+	if skew := now.Sub(time.Unix(ts, 0)); skew > tolerance || skew < -tolerance {
+		return fmt.Errorf("%w: the timestamp is %v from now, more than %v", ErrTimestampTolerance, skew, tolerance)
+	}
+	if len(v1s) == 0 {
+		return fmt.Errorf("%w: the header has no v1 signature", ErrNoSignature)
+	}
+	signed := signedPayload(strconv.FormatInt(ts, 10), payload)
+	matched := false
+	for _, v1 := range v1s {
+		for _, secret := range secrets {
+			// No early exit: every pair is compared, so timing does not reveal which one matched.
+			if hmac.Equal([]byte(v1), []byte(sign(secret, signed))) {
+				matched = true
+			}
+		}
+	}
+	if !matched {
+		return fmt.Errorf("%w: no v1 signature matches the payload", ErrSignatureMismatch)
+	}
+	return nil
+}
+
+// Errors of Verify, matched with errors.Is.
+var (
+	ErrMalformedHeader    = errors.New("malformed Tally-Signature header")
+	ErrNoTimestamp        = errors.New("Tally-Signature header has no timestamp")
+	ErrTimestampTolerance = errors.New("Tally-Signature timestamp is outside the tolerance")
+	ErrNoSignature        = errors.New("Tally-Signature header has no v1 signature")
+	ErrSignatureMismatch  = errors.New("Tally-Signature signature mismatch")
+)
+
+// signedPayload is what a signature covers: "<t>.<body>".
+func signedPayload(ts string, body []byte) []byte {
+	return append([]byte(ts+"."), body...)
+}
+
+// sign returns the hex HMAC-SHA256 of data keyed with secret.
+func sign(secret string, data []byte) string {
 	m := hmac.New(sha256.New, []byte(secret))
-	m.Write(body)
+	m.Write(data)
 	return hex.EncodeToString(m.Sum(nil))
 }
 
