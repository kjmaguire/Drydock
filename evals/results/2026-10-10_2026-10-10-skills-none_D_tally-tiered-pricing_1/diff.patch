+// TieredAmount returns what quantity units cost on a tiered plan, in minor units. The tiers must be valid (store checks them).
+//
+// Graduated: each unit is priced at the unit amount of the tier it falls in, and every tier that at least one unit falls in
+// adds its flat amount. Volume: every unit is priced at the unit amount of the one tier the quantity falls in, which adds its
+// flat amount once. A tier's UpTo is inclusive. A quantity of 0 costs 0.
+func TieredAmount(tiers []store.Tier, mode store.TiersMode, quantity int64) int64 {
+	if quantity <= 0 || len(tiers) == 0 {
+		return 0
+	}
+	if mode == store.Volume {
+		t := tiers[len(tiers)-1]
+		for _, c := range tiers {
+			if c.UpTo == nil || quantity <= *c.UpTo {
+				t = c
+				break
+			}
+		}
+		return quantity*t.UnitAmount + t.FlatAmount
+	}
+	var total, from int64 // units before from are priced by the earlier tiers
+	for _, t := range tiers {
+		if from >= quantity {
+			break
+		}
+		upTo := quantity
+		if t.UpTo != nil && *t.UpTo < quantity {
+			upTo = *t.UpTo
+		}
+		total += (upTo-from)*t.UnitAmount + t.FlatAmount
+		from = upTo
+	}
+	return total
+}
