+// checkTiers checks a plan's tiers, if it has any: they need a metered plan and a mode, and they are at least one tier, sorted
+// by UpTo, with only the last tier unlimited.
+func checkTiers(p Plan) error {
+	if p.TiersMode == "" && len(p.Tiers) == 0 {
+		return nil
+	}
+	switch {
+	case p.UsageType != Metered:
+		return fmt.Errorf("%w: only a metered plan has tiers", ErrInvalidTiers)
+	case p.TiersMode != Graduated && p.TiersMode != Volume:
+		return fmt.Errorf("%w: the tiers mode is graduated or volume", ErrInvalidTiers)
+	case len(p.Tiers) == 0:
+		return fmt.Errorf("%w: a plan needs at least one tier", ErrInvalidTiers)
+	}
+	for i, t := range p.Tiers {
+		last := i == len(p.Tiers)-1
+		switch {
+		case t.UnitAmount < 0 || t.FlatAmount < 0:
+			return fmt.Errorf("%w: a tier's amounts cannot be negative", ErrInvalidTiers)
+		case last && t.UpTo != nil:
+			return fmt.Errorf("%w: the last tier has no up_to", ErrInvalidTiers)
+		case !last && (t.UpTo == nil || *t.UpTo <= 0):
+			return fmt.Errorf("%w: a tier's up_to is a positive whole number", ErrInvalidTiers)
+		case i > 0 && !last && *t.UpTo <= *p.Tiers[i-1].UpTo:
+			return fmt.Errorf("%w: the tiers' up_to values strictly ascend", ErrInvalidTiers)
+		}
+	}
 	return nil
 }
 
