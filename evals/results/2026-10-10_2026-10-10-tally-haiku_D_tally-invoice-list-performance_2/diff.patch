+// indexInvoice adds a stored invoice to its organization's index. The caller holds the lock.
+func (s *Store) indexInvoice(inv Invoice) {
+	ids := s.invoiceIDs[inv.OrgID]
+	i := sort.Search(len(ids), func(i int) bool { return invoiceBefore(inv, s.invoices[ids[i]]) })
+	ids = append(ids, "")
+	copy(ids[i+1:], ids[i:])
+	ids[i] = inv.ID
+	s.invoiceIDs[inv.OrgID] = ids
+}
