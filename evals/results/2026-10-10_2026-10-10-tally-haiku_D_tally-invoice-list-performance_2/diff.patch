+package api_test
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+type invoiceListItem struct {
+	ID       string `json:"id"`
+	Customer *struct {
+		ID   string `json:"id"`
+		Name string `json:"name"`
+	} `json:"customer"`
+}
+
+type invoiceListPage struct {
+	Items      []invoiceListItem `json:"items"`
+	NextCursor string            `json:"next_cursor"`
+}
+
+// listAllInvoices follows next_cursor from path with pages of limit, and returns every item's ID.
+func listAllInvoices(t *testing.T, e *apitest.Env, key, path string, limit int) []string {
+	t.Helper()
+	ids := []string{}
+	cursor := ""
+	for {
+		sep := "?"
+		if strings.Contains(path, "?") {
+			sep = "&"
+		}
+		url := fmt.Sprintf("%s%slimit=%d", path, sep, limit)
+		if cursor != "" {
+			url += "&cursor=" + cursor
+		}
+		var pg invoiceListPage
+		e.MustDo(http.StatusOK, "GET", url, key, nil, &pg)
+		for _, it := range pg.Items {
+			ids = append(ids, it.ID)
+		}
+		if pg.NextCursor == "" {
+			return ids
+		}
+		cursor = pg.NextCursor
+	}
+}
+
+func TestInvoiceListPagesAgree(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	joe := e.CreateCustomer(e.Acme, "Joe", "joe@example.com")
+	gone := e.CreateCustomer(e.Acme, "Gone", "gone@example.com")
+	line := []store.Line{{Description: "seat", Quantity: 1, UnitAmount: 500}}
+	for i := 0; i < 25; i++ {
+		cust := []store.Customer{jane, joe, gone}[i%3]
+		sub := ""
+		if i%4 == 0 {
+			sub = "sub_team"
+		}
+		at := apitest.Start.Add(time.Duration(i/2) * time.Second) // two invoices share each time, so ties fall to ID
+		inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: cust.ID, SubscriptionID: sub, Currency: money.USD, Lines: line}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i%5 == 2 {
+			if _, err := e.Store.UpdateInvoice(e.Acme.ID, inv.ID, func(i *store.Invoice) error { i.Status = store.InvoicePaid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	if err := e.Store.DeleteCustomer(e.Acme.ID, gone.ID); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, path := range []string{
+		"/v1/invoices",
+		"/v1/invoices?customer_id=" + jane.ID,
+		"/v1/invoices?customer_id=" + gone.ID,
+		"/v1/invoices?subscription_id=sub_team",
+		"/v1/invoices?status=paid",
+		"/v1/invoices?status=open&customer_id=" + joe.ID,
+	} {
+		all := listAllInvoices(t, e, e.Acme.Key, path, 100)
+		small := listAllInvoices(t, e, e.Acme.Key, path, 2)
+		if fmt.Sprint(small) != fmt.Sprint(all) {
+			t.Errorf("%s: pages of 2 %v, pages of 100 %v", path, small, all)
+		}
+		if path == "/v1/invoices" && len(all) != 25 {
+			t.Errorf("%s lists %d invoices, want 25", path, len(all))
+		}
+	}
+
+	var raw struct {
+		Items []struct {
+			Customer json.RawMessage `json:"customer"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?customer_id="+gone.ID+"&limit=1", e.Acme.Key, nil, &raw)
+	if len(raw.Items) != 1 || string(raw.Items[0].Customer) != "null" {
+		t.Fatalf("invoice of a deleted customer: items %+v, want customer null", raw.Items)
+	}
+
+	// Invoices created between pages are paged like any other, and the cursor still finds its place.
+	var pg invoiceListPage
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=20", e.Acme.Key, nil, &pg)
+	if pg.NextCursor == "" {
+		t.Fatal("no next cursor after 20 of 25 invoices")
+	}
+	e.Clock.Advance(time.Hour)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": jane.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "late", "quantity": 1, "unit_amount": 100}}}, nil)
+	var rest invoiceListPage
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=20&cursor="+pg.NextCursor, e.Acme.Key, nil, &rest)
+	if len(rest.Items) != 6 {
+		t.Errorf("rest after the cursor has %d invoices, want the last 5 and the new one", len(rest.Items))
+	}
+}
+
+func TestInvoiceListErrorsUnchanged(t *testing.T) {
+	e := apitest.New(t)
+	for _, c := range []struct {
+		path string
+		code int
+		want string
+	}{
+		{"/v1/invoices?limit=0", http.StatusBadRequest, "invalid_limit"},
+		{"/v1/invoices?limit=101", http.StatusBadRequest, "invalid_limit"},
+		{"/v1/invoices?cursor=!!", http.StatusBadRequest, "invalid_cursor"},
+		{"/v1/invoices?status=lost", http.StatusBadRequest, "invalid_status"},
+	} {
+		if r := e.Do("GET", c.path, e.Acme.Key, nil); r.Code != c.code || r.Map(t)["error"] != c.want {
+			t.Errorf("GET %s = %s, want %d %s", c.path, r.String(), c.code, c.want)
+		}
+	}
+}
+
+// TestInvoiceListLargeOrganization times the list for an organization with 60,000 invoices and 5,000 customers, with
+// another organization's invoices in the store too. Each request must finish well under the 250 ms the check allows.
+func TestInvoiceListLargeOrganization(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds 80,000 invoices")
+	}
+	e := apitest.New(t)
+	customers := make([]store.Customer, 0, 5000)
+	for i := 0; i < 5000; i++ {
+		c, err := e.Store.CreateCustomer(e.Acme.ID, fmt.Sprintf("Customer %d", i), fmt.Sprintf("c%d@acme.example", i), e.Clock.Now())
+		if err != nil {
+			t.Fatal(err)
+		}
+		customers = append(customers, c)
+	}
+	line := []store.Line{{Description: "seat", Quantity: 1, UnitAmount: 1000}}
+	var ids []string
+	for i := 0; i < 60000; i++ {
+		sub := ""
+		if i%10 == 0 {
+			sub = "sub_team"
+		}
+		inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: customers[i%5000].ID, SubscriptionID: sub, Currency: money.USD, Lines: line}, apitest.Start.Add(time.Duration(i)*time.Second))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i%3 == 0 {
+			if _, err := e.Store.UpdateInvoice(e.Acme.ID, inv.ID, func(i *store.Invoice) error { i.Status = store.InvoicePaid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+		ids = append(ids, inv.ID)
+	}
+	globex := e.Globex
+	for i := 0; i < 20000; i++ {
+		c, err := e.Store.CreateCustomer(globex.ID, fmt.Sprintf("Other %d", i), fmt.Sprintf("o%d@globex.example", i), e.Clock.Now())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := e.Store.CreateInvoice(store.Invoice{OrgID: globex.ID, CustomerID: c.ID, Currency: money.USD, Lines: line}, apitest.Start.Add(time.Duration(i)*time.Second)); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// A cursor that starts 30,000 invoices in, so the position search is exercised too.
+	deep := ids[30000-1]
+	deepCursor := base64.RawURLEncoding.EncodeToString(mustJSON(t, map[string]any{"t": apitest.Start.Add(29999 * time.Second), "id": deep}))
+	for _, path := range []string{
+		"/v1/invoices",
+		"/v1/invoices?cursor=" + deepCursor,
+		"/v1/invoices?customer_id=" + customers[7].ID,
+		"/v1/invoices?customer_id=" + customers[7].ID + "&cursor=" + deepCursor,
+		"/v1/invoices?subscription_id=sub_team",
+		"/v1/invoices?status=void",
+		"/v1/invoices?status=paid&subscription_id=sub_team&cursor=" + deepCursor,
+	} {
+		start := time.Now()
+		r := e.Do("GET", path, e.Acme.Key, nil)
+		took := time.Since(start)
+		if r.Code != http.StatusOK {
+			t.Fatalf("GET %s = %s", path, r.String())
+		}
+		if took > 250*time.Millisecond {
+			t.Errorf("GET %s took %v, want under 250ms", path, took)
+		}
+	}
+}
+
+func mustJSON(t *testing.T, v any) []byte {
+	t.Helper()
+	b, err := json.Marshal(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
