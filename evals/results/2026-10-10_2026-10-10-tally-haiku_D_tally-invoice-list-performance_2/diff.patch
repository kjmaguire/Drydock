+func TestInvoicePagingWhileCreating(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	line := []Line{{Description: "x", Quantity: 1, UnitAmount: 10}}
+	for i := 0; i < 5; i++ {
+		if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.EUR, Lines: line}, t0.Add(time.Duration(i)*time.Minute)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	page, more := s.ListInvoicePage(a.ID, InvoiceFilter{}, nil, 2)
+	if len(page) != 2 || !more {
+		t.Fatalf("first page = %d invoices, more %v", len(page), more)
+	}
+	last := page[1]
+	later, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.EUR, Lines: line}, t0.Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	earlier, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.EUR, Lines: line}, t0.Add(-time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	rest, more := s.ListInvoicePage(a.ID, InvoiceFilter{}, &InvoicePosition{CreatedAt: last.CreatedAt, ID: last.ID}, 100)
+	if more || len(rest) != 4 {
+		t.Fatalf("rest = %d invoices, more %v; want the 3 not yet paged and the new one", len(rest), more)
+	}
+	if rest[3].ID != later.ID {
+		t.Errorf("last invoice = %s, want the one created after the first page %s", rest[3].ID, later.ID)
+	}
+	for _, inv := range rest {
+		if inv.ID == earlier.ID {
+			t.Errorf("an invoice from before the cursor appeared after it")
+		}
+	}
+}
