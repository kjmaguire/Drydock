+
+// InvoicePosition is where a page of invoices starts: after the invoice created at CreatedAt with this ID.
+type InvoicePosition struct {
+	CreatedAt time.Time
+	ID        string
+}
+
+// before reports whether the invoice comes after the position.
+func (p InvoicePosition) before(inv Invoice) bool {
+	if !p.CreatedAt.Equal(inv.CreatedAt) {
+		return p.CreatedAt.Before(inv.CreatedAt)
+	}
+	return p.ID < inv.ID
+}
+
+// invoiceBefore orders invoices oldest first, ties by ID.
+func invoiceBefore(a, b Invoice) bool {
+	if !a.CreatedAt.Equal(b.CreatedAt) {
+		return a.CreatedAt.Before(b.CreatedAt)
+	}
+	return a.ID < b.ID
+}
