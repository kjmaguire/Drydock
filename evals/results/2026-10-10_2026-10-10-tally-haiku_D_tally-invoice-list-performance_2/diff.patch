+package store
+
+import (
+	"encoding/json"
+	"sort"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+// bruteInvoices is the answer to a listing, worked out from every invoice in the store.
+func bruteInvoices(s *Store, orgID string, f InvoiceFilter) []Invoice {
+	out := []Invoice{}
+	for _, inv := range s.Export().Invoices {
+		if inv.OrgID == orgID && (f.CustomerID == "" || inv.CustomerID == f.CustomerID) &&
+			(f.SubscriptionID == "" || inv.SubscriptionID == f.SubscriptionID) && (f.Status == "" || inv.Status == f.Status) {
+			out = append(out, inv)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// pageAll reads every page of size size, following the position of each page's last invoice as a cursor would.
+func pageAll(s *Store, orgID string, f InvoiceFilter, size int) []Invoice {
+	got := []Invoice{}
+	var after *InvoicePosition
+	for {
+		page, more := s.ListInvoicePage(orgID, f, after, size)
+		got = append(got, page...)
+		if !more {
+			return got
+		}
+		last := page[len(page)-1]
+		after = &InvoicePosition{CreatedAt: last.CreatedAt, ID: last.ID}
+	}
+}
+
+func sameJSON(t *testing.T, got, want any) bool {
+	t.Helper()
+	g, err := json.Marshal(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w, err := json.Marshal(want)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(g) == string(w)
+}
+
+func TestListInvoicePageMatchesBruteForce(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	ca2, _ := s.CreateCustomer(a.ID, "Ben", "ben@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Bo", "bo@example.com", t0)
+	line := []Line{{Description: "x", Quantity: 1, UnitAmount: 10}}
+	for i := 0; i < 60; i++ {
+		org, cust := a, ca
+		if i%3 == 1 {
+			cust = ca2
+		}
+		if i%5 == 4 {
+			org, cust = b, cb
+		}
+		sub := ""
+		if i%2 == 0 {
+			sub = "sub_1"
+		}
+		at := t0.Add(time.Duration(i/4) * time.Minute) // four invoices share each time, so ties fall to ID
+		inv, err := s.CreateInvoice(Invoice{OrgID: org.ID, CustomerID: cust.ID, SubscriptionID: sub, Currency: money.EUR, Lines: line}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		switch i % 7 {
+		case 3:
+			if _, err := s.UpdateInvoice(org.ID, inv.ID, func(i *Invoice) error { i.Status = InvoicePaid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		case 5:
+			if _, err := s.UpdateInvoice(org.ID, inv.ID, func(i *Invoice) error { i.Status = InvoiceVoid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	// An invoice created with a clock that went back belongs in the middle of the list, not at its end.
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: ca.ID, Currency: money.EUR, Lines: line}, t0.Add(-time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+
+	filters := []InvoiceFilter{
+		{}, {CustomerID: ca.ID}, {CustomerID: ca2.ID}, {CustomerID: cb.ID}, {SubscriptionID: "sub_1"}, {SubscriptionID: "none"},
+		{Status: InvoiceOpen}, {Status: InvoicePaid}, {Status: InvoiceVoid}, {CustomerID: ca.ID, Status: InvoiceOpen},
+	}
+	restored, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, f := range filters {
+		want := bruteInvoices(s, a.ID, f)
+		if got := s.ListInvoices(a.ID, f); !sameJSON(t, got, want) {
+			t.Errorf("ListInvoices(%+v) = %d invoices, want %d", f, len(got), len(want))
+		}
+		for _, size := range []int{1, 2, 7, 100} {
+			if got := pageAll(s, a.ID, f, size); !sameJSON(t, got, want) {
