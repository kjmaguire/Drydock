+// RenewSubscription moves a subscription on from the period that ended at periodEnd. In one step, under the store's lock, it
+// applies next to the subscription and, when inv is set, creates inv for the period the subscription now bills. It refuses
+// with ErrStalePeriod, and changes nothing, when the subscription is canceled or its current period no longer ends at
+// periodEnd, which means another renewal got there first. The invoice and the new period therefore never exist apart.
+// next must not call the store.
+func (s *Store) RenewSubscription(orgID, id string, periodEnd time.Time, next func(*Subscription) error, inv *Invoice, now time.Time) (Subscription, *Invoice, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	old, ok := s.subs[id]
+	if !ok || old.OrgID != orgID {
+		return Subscription{}, nil, ErrNotFound
+	}
+	if old.Status == Canceled || !old.CurrentPeriodEnd.Equal(periodEnd) {
+		return Subscription{}, nil, ErrStalePeriod
+	}
+	sub := copySub(old)
+	if err := next(&sub); err != nil {
+		return Subscription{}, nil, err
+	}
+	sub.ID, sub.OrgID, sub.CustomerID, sub.CreatedAt = old.ID, old.OrgID, old.CustomerID, old.CreatedAt
+	if sub.Quantity <= 0 {
+		return Subscription{}, nil, invalid("the quantity must be at least 1")
+	}
+	if p, ok := s.plans[sub.PlanID]; !ok || p.OrgID != orgID {
+		return Subscription{}, nil, ErrNotFound
+	}
+	var created *Invoice
+	if inv != nil {
+		in := *inv
+		in.OrgID, in.SubscriptionID = orgID, id
+		c, err := s.addInvoiceLocked(in, now)
+		if err != nil {
+			return Subscription{}, nil, err
+		}
+		created = &c
+	}
+	s.subs[id] = sub
+	return copySub(sub), created, nil
+}
