+func TestRenewDueGoesOnPastAFailingSubscription(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	healthy := createPaidSub(t, e, "pm_card_visa")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	// Its customer belongs to another organization, so its renewal cannot create an invoice.
+	other := e.CreateCustomer(e.Globex, "Bob", "bob@example.com")
+	start := apitest.Start
+	// Its period ends first, so RenewDue reaches it before the healthy subscription.
+	broken, err := e.Store.CreateSubscription(store.Subscription{OrgID: e.Acme.ID, CustomerID: other.ID, PlanID: p.ID, Quantity: 1,
+		Status: store.Active, StartedAt: start, CurrentPeriodStart: start, CurrentPeriodEnd: start.AddDate(0, 0, 1)}, start)
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(healthy.CurrentPeriodEnd)
+	now := e.Clock.Now()
+
+	n, err := e.Subs.RenewDue(ctx)
+	if !errors.Is(err, store.ErrCustomerOrgMismatch) {
+		t.Fatalf("RenewDue error = %v, want the broken subscription's error", err)
+	}
+	if n != 1 {
+		t.Fatalf("RenewDue = %d, want 1", n)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, healthy.ID)
+	if !got.CurrentPeriodStart.Equal(now) || got.Status != store.Active {
+		t.Fatalf("the healthy subscription was not renewed: %+v", got)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: healthy.ID}); len(invs) != 2 || invs[1].Status != store.InvoicePaid {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	if b, _ := e.Store.Subscription(e.Acme.ID, broken.ID); !b.CurrentPeriodStart.Equal(start) || !b.CurrentPeriodEnd.Equal(broken.CurrentPeriodEnd) {
+		t.Fatalf("the failing subscription moved on anyway: %+v", b)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: broken.ID}); len(invs) != 0 {
+		t.Fatalf("the failing subscription was invoiced: %+v", invs)
+	}
+}
