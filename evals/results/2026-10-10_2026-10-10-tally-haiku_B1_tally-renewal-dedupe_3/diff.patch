+func TestRenewDueWhileAnotherRunIsCharging(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := createPaidSub(t, e, "pm_card_visa")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+
+	// Hold the renewal's charge open, and run RenewDue again while it is held.
+	entered, release := make(chan struct{}), make(chan struct{})
+	var held atomic.Bool
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		if held.CompareAndSwap(false, true) {
+			close(entered)
+			<-release
+		}
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, err := e.Subs.RenewDue(ctx)
+		done <- err
+	}()
+	<-entered
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+		t.Fatalf("RenewDue during a charge = %d, %v; want 0, nil", n, err)
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 {
+		t.Fatalf("invoices = %d, want 2", len(invs))
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 {
+		t.Fatalf("charges = %d, want 2", len(cs))
+	}
+}
