+	ctx := context.Background()
+	sub := createPaidSub(t, e, "pm_card_visa")
+	// The first period was charged before the outage; the renewal below is the one the gateway cannot take.
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, sub.CustomerID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_gateway_down"; return nil })
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	renewedAt := e.Clock.Now()
+
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v; want 1, nil", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(renewedAt) || !got.CurrentPeriodEnd.Equal(renewedAt.AddDate(0, 1, 0)) {
+		t.Fatalf("after the outage = %+v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoiceOpen || invs[1].PeriodStart == nil || !invs[1].PeriodStart.Equal(renewedAt) {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	for range 2 {
+		if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+			t.Fatalf("RenewDue again = %d, %v; want 0, nil", n, err)
+		}
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 {
+		t.Fatalf("invoices = %d after later runs, want 2", len(invs))
+	}
+	if calls, charges := e.Gateway.Calls(), e.Gateway.Charges(); len(calls) != 2 || len(charges) != 1 {
+		t.Fatalf("gateway calls = %d, charges = %d; want 2 and 1 (the outage is one attempt, never retried by RenewDue)", len(calls), len(charges))
+	}
+
+	// The open invoice can still be paid by hand once the gateway is back.
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, sub.CustomerID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	if _, _, err := e.Payments.Pay(ctx, e.Acme.ID, invs[1].ID, ""); err != nil {
+		t.Fatal(err)
+	}
+	if n, _ := e.Subs.RenewDue(ctx); n != 0 {
+		t.Fatalf("RenewDue after the manual payment = %d", n)
+	}
+	if paid, _ := e.Store.Invoice(e.Acme.ID, invs[1].ID); paid.Status != store.InvoicePaid {
+		t.Fatalf("invoice = %+v", paid)
+	}
+}
