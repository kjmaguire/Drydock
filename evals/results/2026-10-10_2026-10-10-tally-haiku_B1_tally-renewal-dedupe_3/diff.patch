+func TestDeclinedRenewalIsPastDueAndChargedOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := createPaidSub(t, e, "pm_card_visa")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, sub.CustomerID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_declined"; return nil })
+	e.Clock.Set(sub.CurrentPeriodEnd)
+
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v; want 1, nil", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.PastDue {
+		t.Fatalf("subscription = %+v, want past due", got)
+	}
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+		t.Fatalf("RenewDue again = %d, %v; want 0, nil", n, err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 || invs[1].Status != store.InvoiceOpen {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	if calls := e.Gateway.Calls(); len(calls) != 2 {
+		t.Fatalf("gateway calls = %d, want 2 (the first charge and one declined renewal)", len(calls))
+	}
+}
