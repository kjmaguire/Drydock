+		t.Fatalf("invoices = %d, want 1", len(invs))
+	}
+
+	// A canceled subscription is not renewed.
+	_, _ = s.UpdateSubscription(o.ID, sub.ID, func(x *Subscription) error { x.Status = Canceled; return nil })
+	if _, _, err := s.RenewSubscription(o.ID, sub.ID, next, move, nil, next); !errors.Is(err, ErrStalePeriod) {
+		t.Fatalf("renewing a canceled subscription: %v", err)
+	}
+
+	// A period is invoiced once, whichever way it is asked for.
+	if _, err := s.CreateInvoice(*invoice(), end); !errors.Is(err, ErrConflict) {
