+	end := t0.AddDate(0, 1, 0)
+	next := end.AddDate(0, 1, 0)
+	sub, err := s.CreateSubscription(Subscription{OrgID: o.ID, CustomerID: c.ID, PlanID: p.ID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: end}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	move := func(x *Subscription) error { x.CurrentPeriodStart, x.CurrentPeriodEnd = end, next; return nil }
+	invoice := func() *Invoice {
+		return &Invoice{OrgID: o.ID, CustomerID: c.ID, SubscriptionID: sub.ID, Currency: money.USD, PeriodStart: &end, PeriodEnd: &next}
+	}
+
+	got, created, err := s.RenewSubscription(o.ID, sub.ID, end, move, invoice(), end)
+	if err != nil || created == nil || created.Status != InvoiceOpen || !got.CurrentPeriodEnd.Equal(next) {
+		t.Fatalf("RenewSubscription = %+v, %+v, %v", got, created, err)
+	}
+
+	// Renewing from the period that already ended again changes nothing: the subscription has moved on.
+	if _, created, err := s.RenewSubscription(o.ID, sub.ID, end, move, invoice(), end); !errors.Is(err, ErrStalePeriod) || created != nil {
+		t.Fatalf("a stale renewal = %+v, %v", created, err)
