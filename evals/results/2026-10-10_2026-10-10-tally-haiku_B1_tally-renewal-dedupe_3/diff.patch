+func TestConcurrentRenewDueRenewsAndInvoicesOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := createPaidSub(t, e, "pm_card_visa")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+
+	const runs = 8
+	var wg sync.WaitGroup
+	counts, errs := make([]int, runs), make([]error, runs)
+	for i := range runs {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			counts[i], errs[i] = e.Subs.RenewDue(ctx)
+		}()
+	}
+	wg.Wait()
+	renewed := 0
+	for i := range runs {
+		if errs[i] != nil {
+			t.Fatal(errs[i])
+		}
+		renewed += counts[i]
+	}
+	if renewed != 1 {
+		t.Fatalf("renewed %d times by %d concurrent runs, want 1", renewed, runs)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 {
+		t.Fatalf("invoices = %d, want 2 (the first period and one renewal)", len(invs))
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 {
+		t.Fatalf("charges = %d, want 2 (the first period and one renewal)", len(cs))
+	}
