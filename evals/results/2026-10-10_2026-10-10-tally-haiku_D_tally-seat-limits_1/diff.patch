+// SeatsUsed returns how many seats an organization uses: its members and pending invites whose role takes a seat.
+func (s *Store) SeatsUsed(orgID string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.seatsUsed(orgID)
+}
+
+// seatsUsed is SeatsUsed for a caller that holds the lock.
+func (s *Store) seatsUsed(orgID string) int {
+	n := 0
+	for _, m := range s.members {
+		if m.OrgID == orgID && m.Role.TakesSeat() {
+			n++
+		}
+	}
+	for _, inv := range s.invites {
+		if inv.OrgID == orgID && inv.Role.TakesSeat() && inv.AcceptedAt == nil && inv.RevokedAt == nil {
+			n++
+		}
+	}
+	return n
+}
+
+// checkSeat returns a SeatLimitError when the organization's plan has no seat left. The caller holds the lock.
+func (s *Store) checkSeat(orgID string) error {
+	limit := s.orgs[orgID].Plan.SeatLimit()
+	if limit == UnlimitedSeats {
+		return nil
+	}
+	if used := s.seatsUsed(orgID); used >= limit {
+		return &SeatLimitError{Limit: limit, Used: used}
+	}
+	return nil
+}
