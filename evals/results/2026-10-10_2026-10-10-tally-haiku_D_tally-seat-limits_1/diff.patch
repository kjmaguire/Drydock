+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"net/url"
+	"regexp"
+	"sync"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// seatsOf returns the "seats" object of GET /v1/org.
+func seatsOf(t *testing.T, e *apitest.Env, key string) map[string]any {
+	t.Helper()
+	var org struct {
+		Seats map[string]any `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", key, nil, &org)
+	return org.Seats
+}
+
+// inviteToken returns the token of the invite emailed to address.
+func inviteToken(t *testing.T, e *apitest.Env, address string) string {
+	t.Helper()
+	for _, m := range e.Mail.Messages() {
+		if m.To != address {
+			continue
+		}
+		if g := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(m.Body); g != nil {
+			token, _ := url.QueryUnescape(g[1])
+			return token
+		}
+	}
+	t.Fatalf("no invite emailed to %s", address)
+	return ""
+}
+
+func TestSeatsOfPlans(t *testing.T) {
+	e := apitest.New(t)
+	if seats := seatsOf(t, e, e.Acme.Key); seats["used"] != float64(1) || seats["limit"] != float64(10) {
+		t.Fatalf("team seats = %v", seats)
+	}
+	if seats := seatsOf(t, e, e.Globex.Key); seats["used"] != float64(1) || seats["limit"] != nil {
+		t.Fatalf("business seats = %v, want a null limit", seats)
+	}
+}
+
+func TestSeatLimitOnInvites(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Free", store.OrgFree, "UTC")
+	invite := func(email, role string) *apitest.Response {
+		return e.Do("POST", "/v1/invites", free.Key, map[string]string{"email": email, "role": role})
+	}
+	var first store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "a@free.example", "role": "member"}, &first)
+	if r := invite("b@free.example", "admin"); r.Code != http.StatusCreated {
+		t.Fatalf("second seat: %s", r)
+	}
+	r := invite("c@free.example", "member")
+	if r.Code != http.StatusPaymentRequired {
+		t.Fatalf("full plan: %s", r)
+	}
+	if m := r.Map(t); m["error"] != "seat_limit_reached" || m["limit"] != float64(3) || m["used"] != float64(3) || len(m) != 3 {
+		t.Fatalf("body = %v", m)
+	}
+	if r := invite("v@free.example", "viewer"); r.Code != http.StatusCreated {
+		t.Fatalf("viewers are free: %s", r)
+	}
+	if seats := seatsOf(t, e, free.Key); seats["used"] != float64(3) || seats["limit"] != float64(3) {
+		t.Fatalf("seats = %v", seats)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+first.ID, free.Key, nil, nil)
+	if r := invite("c@free.example", "member"); r.Code != http.StatusCreated {
+		t.Fatalf("revoking frees a seat: %s", r)
+	}
+}
+
+func TestAcceptingAnInviteNeedsNoFreeSeat(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Free", store.OrgFree, "UTC")
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "a@free.example", "role": "member"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "b@free.example", "role": "member"}, nil)
+	// The two invites hold the two seats after the owner's; accepting each turns it into a member with the same seat.
+	for _, addr := range []string{"a@free.example", "b@free.example"} {
+		e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": inviteToken(t, e, addr), "name": "New"}, nil)
+	}
+	if seats := seatsOf(t, e, free.Key); seats["used"] != float64(3) {
+		t.Fatalf("seats after accepting = %v", seats)
+	}
+}
+
+func TestAcceptedInviteCannotBeReusedToRejoin(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Free", store.OrgFree, "UTC")
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "a@free.example", "role": "member"}, nil)
+	token := inviteToken(t, e, "a@free.example")
+	var accepted struct {
+		User store.User `json:"user"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "A"}, &accepted)
+	if seats := seatsOf(t, e, free.Key); seats["used"] != float64(2) {
+		t.Fatalf("seats after accepting = %v", seats)
+	}
+	// Remove A, then fill the plan with two pending invites.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+accepted.User.ID, free.Key, nil, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "b@free.example", "role": "member"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "c@free.example", "role": "member"}, nil)
+	if seats := seatsOf(t, e, free.Key); seats["used"] != float64(3) {
+		t.Fatalf("seats before re-accepting = %v", seats)
+	}
+	// A's old token must not re-create their membership past the limit.
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "A"}); r.Code != http.StatusNotFound {
+		t.Fatalf("re-accepting an accepted invite: %s", r)
+	}
+	if seats := seatsOf(t, e, free.Key); seats["used"] != float64(3) || seats["limit"] != float64(3) {
+		t.Fatalf("seats after re-accepting = %v", seats)
+	}
+}
+
+func TestSeatLimitOnRoleChange(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Free", store.OrgFree, "UTC")
+	member, _ := e.AddMember(free, "m@free.example", store.RoleMember)
+	viewer, _ := e.AddMember(free, "v@free.example", store.RoleViewer)
+	var pending store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "p@free.example", "role": "member"}, &pending)
+
+	r := e.Do("PATCH", "/v1/members/"+viewer.ID, free.Key, map[string]string{"role": "member"})
+	if m := r.Map(t); r.Code != http.StatusPaymentRequired || m["error"] != "seat_limit_reached" || m["used"] != float64(3) {
+		t.Fatalf("viewer to member on a full plan: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+pending.ID, free.Key, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+viewer.ID, free.Key, map[string]string{"role": "member"}, nil)
+	if seats := seatsOf(t, e, free.Key); seats["used"] != float64(3) {
+		t.Fatalf("seats = %v", seats)
+	}
+	// Changing a seat-taking member to a viewer frees their seat, and changing between seat-taking roles needs none.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, free.Key, map[string]string{"role": "viewer"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+viewer.ID, free.Key, map[string]string{"role": "admin"}, nil)
+	if seats := seatsOf(t, e, free.Key); seats["used"] != float64(2) {
+		t.Fatalf("seats = %v", seats)
+	}
+}
+
+func TestPlanChangeMustFitSeats(t *testing.T) {
+	e := apitest.New(t)
+	var members []store.User
+	for _, addr := range []string{"a@acme.example", "b@acme.example", "c@acme.example"} {
+		u, _ := e.AddMember(e.Acme, addr, store.RoleMember)
+		members = append(members, u)
+	}
+	r := e.Do("PATCH", "/v1/org", e.Acme.Key, map[string]string{"plan": "free"})
+	if m := r.Map(t); r.Code != http.StatusConflict || m["error"] != "over_seat_limit" || m["limit"] != float64(3) || m["used"] != float64(4) || len(m) != 3 {
+		t.Fatalf("downgrade over the limit: %s", r)
+	}
+	var org store.Org
+	e.MustDo(http.StatusOK, "GET", "/v1/org", e.Acme.Key, nil, &org)
+	if org.Plan != store.OrgTeam {
+		t.Fatalf("plan after a refused change = %s", org.Plan)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+members[0].ID, e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]string{"plan": "free"}, nil)
+	if seats := seatsOf(t, e, e.Acme.Key); seats["used"] != float64(3) || seats["limit"] != float64(3) {
+		t.Fatalf("seats = %v", seats)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]string{"plan": "business"}, nil)
+	if seats := seatsOf(t, e, e.Acme.Key); seats["limit"] != nil {
+		t.Fatalf("seats = %v, want a null limit", seats)
+	}
+}
+
+func TestConcurrentInvitesTakeTheLastSeatOnce(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Free", store.OrgFree, "UTC")
+	e.AddMember(free, "m@free.example", store.RoleMember) // the owner and this member use two of three seats
+	const n = 5
+	codes := make([]int, n)
+	var wg sync.WaitGroup
+	for i := range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			body := map[string]string{"email": fmt.Sprintf("p%d@free.example", i), "role": "member"}
+			codes[i] = e.Do("POST", "/v1/invites", free.Key, body).Code
+		}()
+	}
+	wg.Wait()
+	created := 0
+	for _, c := range codes {
+		switch c {
+		case http.StatusCreated:
+			created++
+		case http.StatusPaymentRequired:
+		default:
+			t.Fatalf("unexpected status %d in %v", c, codes)
+		}
+	}
+	if created != 1 {
+		t.Fatalf("%d invites created for one seat: %v", created, codes)
+	}
+	if seats := seatsOf(t, e, free.Key); seats["used"] != float64(3) {
+		t.Fatalf("seats = %v", seats)
+	}
+}
