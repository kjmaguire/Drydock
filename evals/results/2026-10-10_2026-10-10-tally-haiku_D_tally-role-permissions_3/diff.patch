diff --git a/result/internal/store/owners_test.go b/result/internal/store/owners_test.go
new file mode 100644
index 0000000..6732556
--- /dev/null
+++ b/result/internal/store/owners_test.go
@@ -0,0 +1,58 @@
+package store
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Two owners demoting each other at the same time: exactly one may succeed, so the organization keeps an owner.
+func TestLastOwnerUnderConcurrentDemotion(t *testing.T) {
+	t0 := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	for i := 0; i < 200; i++ {
+		s := New()
+		o, _ := s.CreateOrg("Acme", OrgTeam, "UTC", 0, t0)
+		a, _ := s.CreateUser("a@acme.example", "A", t0)
+		b, _ := s.CreateUser("b@acme.example", "B", t0)
+		_, _ = s.AddMember(o.ID, a.ID, RoleOwner, t0)
+		_, _ = s.AddMember(o.ID, b.ID, RoleOwner, t0)
+
+		var wg sync.WaitGroup
+		errs := make([]error, 2)
+		for j, u := range []string{a.ID, b.ID} {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				_, errs[j] = s.SetMemberRole(o.ID, u, RoleMember)
+			}()
+		}
+		wg.Wait()
+
+		failed := 0
+		for _, err := range errs {
+			if errors.Is(err, ErrLastOwner) {
+				failed++
+			} else if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+		}
+		if failed != 1 || s.ownerCount(o.ID) != 1 {
+			t.Fatalf("round %d: %d refused, %d owners left; want 1 refused and 1 owner", i, failed, s.ownerCount(o.ID))
+		}
+	}
+}
+
+func TestRemovingTheLastOwnerIsRefused(t *testing.T) {
+	t0 := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	s := New()
+	o, _ := s.CreateOrg("Acme", OrgTeam, "UTC", 0, t0)
+	a, _ := s.CreateUser("a@acme.example", "A", t0)
+	_, _ = s.AddMember(o.ID, a.ID, RoleOwner, t0)
+	if err := s.RemoveMember(o.ID, a.ID); !errors.Is(err, ErrLastOwner) {
+		t.Fatalf("RemoveMember(only owner) = %v, want ErrLastOwner", err)
+	}
+	if _, ok := s.Member(o.ID, a.ID); !ok {
+		t.Fatal("the only owner was removed")
+	}
+}
