@@ -0,0 +1,315 @@
+package api_test
+
+import (
+	"net/http"
+	"slices"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// The roles that may make a call, by the role table in the spec.
+var (
+	everyRole  = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer}
+	notViewer  = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember}
+	billing    = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling}
+	adminsOnly = []store.Role{store.RoleOwner, store.RoleAdmin}
+)
+
+// roleKeys returns an API key for each role in the organization: the owner's, and a new member of each other role.
+func roleKeys(e *apitest.Env) map[store.Role]string {
+	keys := map[store.Role]string{store.RoleOwner: e.Acme.Key}
+	for _, role := range []store.Role{store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		_, keys[role] = e.AddMember(e.Acme, string(role)+"@acme.example", role)
+	}
+	return keys
+}
+
+// The calls of the role table. The paths name objects that do not exist, and the bodies are empty, so a call a role may make
+// fails after the role check (with 404 or 422) and changes nothing.
+var roleMatrix = []struct {
+	method, path string
+	body         any
+	allowed      []store.Role
+}{
+	{"GET", "/v1/customers", nil, everyRole},
+	{"GET", "/v1/customers/export.csv", nil, everyRole},
+	{"GET", "/v1/plans", nil, everyRole},
+	{"GET", "/v1/subscriptions", nil, everyRole},
+	{"GET", "/v1/invoices", nil, everyRole},
+	{"GET", "/v1/payments", nil, everyRole},
+	{"GET", "/v1/org", nil, everyRole},
+	{"GET", "/v1/members", nil, everyRole},
+	{"GET", "/v1/invites", nil, everyRole},
+
+	{"POST", "/v1/customers", map[string]any{}, notViewer},
+	{"PATCH", "/v1/customers/cus_none", map[string]any{}, notViewer},
+	{"DELETE", "/v1/customers/cus_none", nil, notViewer},
+
+	{"POST", "/v1/plans", map[string]any{}, billing},
+	{"PATCH", "/v1/plans/plan_none", map[string]any{}, billing},
+
+	{"POST", "/v1/subscriptions", map[string]any{}, notViewer},
+	{"PATCH", "/v1/subscriptions/sub_none", map[string]any{}, notViewer},
+	{"POST", "/v1/subscriptions/sub_none/cancel", nil, notViewer},
+	{"POST", "/v1/subscriptions/sub_none/usage", map[string]any{}, notViewer},
+
+	{"POST", "/v1/invoices", map[string]any{}, billing},
+	{"POST", "/v1/invoices/inv_none/pay", nil, billing},
+	{"POST", "/v1/invoices/inv_none/void", nil, billing},
+	{"GET", "/v1/reports/revenue", nil, billing},
+
+	{"GET", "/v1/webhook-endpoints", nil, adminsOnly},
+	{"POST", "/v1/webhook-endpoints", map[string]any{}, adminsOnly},
+	{"GET", "/v1/webhook-endpoints/ep_none", nil, adminsOnly},
+	{"PATCH", "/v1/webhook-endpoints/ep_none", map[string]any{}, adminsOnly},
+	{"DELETE", "/v1/webhook-endpoints/ep_none", nil, adminsOnly},
+	{"GET", "/v1/webhook-endpoints/ep_none/deliveries", nil, adminsOnly},
+	{"GET", "/v1/events", nil, adminsOnly},
+	{"GET", "/v1/events/ev_none", nil, adminsOnly},
+
+	{"PATCH", "/v1/org", map[string]any{}, adminsOnly},
+	{"PATCH", "/v1/members/usr_none", map[string]any{}, adminsOnly},
+	{"DELETE", "/v1/members/usr_none", nil, adminsOnly},
+	{"POST", "/v1/invites", map[string]any{}, adminsOnly},
+	{"DELETE", "/v1/invites/inv_none", nil, adminsOnly},
+}
+
+func TestRoleMatrix(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	for _, c := range roleMatrix {
+		for _, role := range everyRole {
+			r := e.Do(c.method, c.path, keys[role], c.body)
+			if slices.Contains(c.allowed, role) {
+				if r.Code == http.StatusForbidden {
+					t.Errorf("%s %s as %s: refused: %s", c.method, c.path, role, r)
+				}
+				continue
+			}
+			if r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+				t.Errorf("%s %s as %s: want 403 forbidden, got %s", c.method, c.path, role, r)
+			}
+		}
+	}
+}
+
+func TestReadsAnswerForAllowedRoles(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	e.CreateCustomer(e.Acme, "Jane Doe", "jane@example.com")
+	for _, path := range []string{"/v1/customers", "/v1/customers/export.csv", "/v1/plans", "/v1/subscriptions", "/v1/invoices", "/v1/payments", "/v1/org", "/v1/members", "/v1/invites", "/v1/api-keys"} {
+		for _, role := range everyRole {
+			if r := e.Do("GET", path, keys[role], nil); r.Code != http.StatusOK {
+				t.Errorf("GET %s as %s: %s", path, role, r)
+			}
+		}
+	}
+	for _, role := range adminsOnly {
+		if r := e.Do("GET", "/v1/webhook-endpoints", keys[role], nil); r.Code != http.StatusOK {
+			t.Errorf("GET /v1/webhook-endpoints as %s: %s", role, r)
+		}
+	}
+}
+
+func TestRefusedWritesChangeNothing(t *testing.T) {
+	e := apitest.New(t)
+	keys := roleKeys(e)
+	if r := e.Do("POST", "/v1/customers", keys[store.RoleViewer], map[string]string{"name": "X", "email": "x@example.com"}); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer creates a customer: %s", r)
+	}
+	if r := e.Do("POST", "/v1/plans", keys[store.RoleMember], map[string]any{"name": "Pro", "currency": "USD", "price": "10.00", "interval": "month"}); r.Code != http.StatusForbidden {
+		t.Fatalf("member creates a plan: %s", r)
+	}
+	if r := e.Do("POST", "/v1/webhook-endpoints", keys[store.RoleBilling], map[string]string{"url": "https://hooks.acme.example/x"}); r.Code != http.StatusForbidden {
+		t.Fatalf("billing creates an endpoint: %s", r)
+	}
+	var customers, plans, endpoints struct{ Items []any }
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", e.Acme.Key, nil, &customers)
+	e.MustDo(http.StatusOK, "GET", "/v1/plans", e.Acme.Key, nil, &plans)
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints", e.Acme.Key, nil, &endpoints)
+	if len(customers.Items) != 0 || len(plans.Items) != 0 || len(endpoints.Items) != 0 {
+		t.Fatalf("refused writes changed data: customers %d, plans %d, endpoints %d", len(customers.Items), len(plans.Items), len(endpoints.Items))
+	}
+}
+
+func TestRefusedCallLeavesLastUsedUnchanged(t *testing.T) {
+	e := apitest.New(t)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	if r := e.Do("GET", "/v1/customers", viewer, nil); r.Code != http.StatusOK {
+		t.Fatalf("viewer read: %s", r)
+	}
+	before, _ := e.Store.APIKeyByToken(viewer)
+	if before.LastUsedAt == nil {
+		t.Fatal("the allowed read did not record the key's last use")
+	}
+	e.Clock.Advance(time.Hour)
+	if r := e.Do("POST", "/v1/customers", viewer, map[string]string{"name": "X", "email": "x@example.com"}); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer write: %s", r)
+	}
+	after, _ := e.Store.APIKeyByToken(viewer)
+	if !after.LastUsedAt.Equal(*before.LastUsedAt) {
+		t.Fatalf("a refused call moved last use from %s to %s", before.LastUsedAt, after.LastUsedAt)
+	}
+}
+
+func TestRoleChangeAppliesToExistingKeys(t *testing.T) {
+	e := apitest.New(t)
+	member, key := e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	body := map[string]string{"name": "Jane Doe", "email": "jane@example.com"}
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, body, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, e.Acme.Key, map[string]string{"role": "viewer"}, nil)
+	if r := e.Do("POST", "/v1/customers", key, map[string]string{"name": "Joe", "email": "joe@example.com"}); r.Code != http.StatusForbidden {
+		t.Fatalf("demoted member's old key creates a customer: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", key, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, e.Acme.Key, map[string]string{"role": "member"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, map[string]string{"name": "Joe", "email": "joe@example.com"}, nil)
+}
+
+func TestMemberChanges(t *testing.T) {
+	e := apitest.New(t)
+	admin, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	member, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	second, _ := e.AddMember(e.Acme, "second@acme.example", store.RoleBilling)
+	patch := func(key, user, role string) *apitest.Response {
+		return e.Do("PATCH", "/v1/members/"+user, key, map[string]string{"role": role})
+	}
+
+	if r := patch(adminKey, second.ID, "member"); r.Code != http.StatusOK {
+		t.Fatalf("admin changes a billing member: %s", r)
+	}
+	for _, c := range []struct{ name, key, user, role string }{
+		{"admin makes a member admin", adminKey, member.ID, "admin"},
+		{"admin makes a member owner", adminKey, member.ID, "owner"},
+		{"admin changes own role", adminKey, admin.ID, "member"},
+		{"admin changes the owner", adminKey, e.Acme.Owner.ID, "member"},
+		{"member changes a member", memberKey, second.ID, "billing"},
+	} {
+		if r := patch(c.key, c.user, c.role); r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+			t.Errorf("%s: %s", c.name, r)
+		}
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+admin.ID, e.Acme.Key, map[string]string{"role": "member"}, nil)
+	var me struct{ Role string }
+	e.MustDo(http.StatusOK, "GET", "/v1/me", adminKey, nil, &me)
+	if me.Role != "member" {
+		t.Fatalf("admin's role after the owner's change = %s", me.Role)
+	}
+}
+
+func TestLastOwner(t *testing.T) {
+	e := apitest.New(t)
+	second, secondKey := e.AddMember(e.Acme, "second@acme.example", store.RoleOwner)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+e.Acme.Owner.ID, secondKey, map[string]string{"role": "member"}, nil)
+
+	if r := e.Do("PATCH", "/v1/members/"+second.ID, secondKey, map[string]string{"role": "member"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the only owner demotes themselves: %s", r)
+	}
+	var me struct{ Role string }
+	e.MustDo(http.StatusOK, "GET", "/v1/me", secondKey, nil, &me)
+	if me.Role != "owner" {
+		t.Fatalf("role after a refused demotion = %s", me.Role)
+	}
+	if r := e.Do("DELETE", "/v1/members/"+second.ID, secondKey, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the only owner leaves: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/members", secondKey, nil, nil)
+}
+
+func TestLeaving(t *testing.T) {
+	e := apitest.New(t)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	_, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	other, _ := e.AddMember(e.Acme, "other@acme.example", store.RoleBilling)
+
+	if r := e.Do("DELETE", "/v1/members/"+other.ID, memberKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("a member removes another member: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/members/usr_none", memberKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("a member removes someone who does not exist: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+viewer.ID, viewerKey, nil, nil)
+	if r := e.Do("GET", "/v1/me", viewerKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a viewer who left: %s", r)
+	}
+}
+
+func TestRemoveAdminsAndOwners(t *testing.T) {
+	e := apitest.New(t)
+	admin, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	member, _ := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	if r := e.Do("DELETE", "/v1/members/"+e.Acme.Owner.ID, adminKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("an admin removes the owner: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/members/"+admin.ID, adminKey, nil); r.Code != http.StatusNoContent {
+		t.Fatalf("an admin leaves: %s", r)
+	}
+	_, adminKey2 := e.AddMember(e.Acme, "admin2@acme.example", store.RoleAdmin)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+member.ID, adminKey2, nil, nil)
+}
+
+func TestInvitesAndAdmins(t *testing.T) {
+	e := apitest.New(t)
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	if r := e.Do("POST", "/v1/invites", adminKey, map[string]string{"email": "new@people.example", "role": "admin"}); r.Code != http.StatusForbidden {
+		t.Fatalf("an admin invites an admin: %s", r)
+	}
+	r := e.Do("POST", "/v1/invites", adminKey, map[string]string{"email": "new@people.example", "role": "owner"})
+	if r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+		t.Fatalf("an admin invites an owner: %s", r)
+	}
+	if n := len(e.Store.Invites(e.Acme.ID)); n != 0 {
+		t.Fatalf("refused invites left %d invites behind, want 0", n)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", adminKey, map[string]string{"email": "new@people.example", "role": "billing"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "boss@people.example", "role": "admin"}, nil)
+}
+
+func TestAPIKeyRules(t *testing.T) {
+	e := apitest.New(t)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	_, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	_, billingKey := e.AddMember(e.Acme, "billing@acme.example", store.RoleBilling)
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+
+	var own store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", viewerKey, map[string]string{"name": "Mine"}, &own)
+
+	var seen struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", viewerKey, nil, &seen)
+	if len(seen.Items) != 2 {
+		t.Fatalf("a viewer sees %d keys, want their own 2", len(seen.Items))
+	}
+	for _, k := range seen.Items {
+		if k.UserID != viewer.ID {
+			t.Fatalf("a viewer sees someone else's key: %+v", k)
+		}
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", adminKey, nil, &seen)
+	if len(seen.Items) != 6 {
+		t.Fatalf("an admin sees %d keys, want all 6", len(seen.Items))
+	}
+
+	ownerKey, _ := e.Store.APIKeyByToken(e.Acme.Key)
+	if r := e.Do("DELETE", "/v1/api-keys/"+ownerKey.ID, memberKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("a member revokes the owner's key: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/api-keys/"+ownerKey.ID, billingKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("billing revokes the owner's key: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", e.Acme.Key, nil, nil)
+
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+own.ID, viewerKey, nil, nil)
+	if r := e.Do("GET", "/v1/org", own.Token, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a revoked key still works: %s", r)
+	}
+
+	memberKeyRec, _ := e.Store.APIKeyByToken(memberKey)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+memberKeyRec.ID, adminKey, nil, nil)
+	if r := e.Do("GET", "/v1/org", memberKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("an admin revoked a member's key, which still works: %s", r)
+	}
+}
