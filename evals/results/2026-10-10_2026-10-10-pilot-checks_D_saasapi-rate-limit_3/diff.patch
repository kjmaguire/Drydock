+package api_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/saasapi/internal/api"
+	"example.com/saasapi/internal/store"
+)
+
+// newRateServer is newServer with a clock the test can move, and a second key on the free account.
+func newRateServer(t *testing.T) (*api.Server, *time.Time) {
+	t.Helper()
+	st := store.New()
+	st.AddAccount(store.Account{ID: "acc_acme", Name: "Acme", Plan: store.PlanFree})
+	st.AddAccount(store.Account{ID: "acc_globex", Name: "Globex", Plan: store.PlanPro})
+	st.AddKey("key-acme", "acc_acme")
+	st.AddKey("key-acme-2", "acc_acme")
+	st.AddKey("key-globex", "acc_globex")
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	return api.New(st, api.Options{Now: func() time.Time { return now }}), &now
+}
+
+// hitN makes n requests with key and returns how many were answered 200.
+func hitN(t *testing.T, h http.Handler, key string, n int) int {
+	t.Helper()
+	ok := 0
+	for i := 0; i < n; i++ {
+		if do(t, h, "GET", "/api/customers", key, "").Code == http.StatusOK {
+			ok++
+		}
+	}
+	return ok
+}
+
+func TestAFreeKeyIsLimitedTo60RequestsPerMinute(t *testing.T) {
+	srv, _ := newRateServer(t)
+	if got := hitN(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("allowed %d of 60", got)
+	}
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if r.Code != http.StatusTooManyRequests {
+		t.Fatalf("61st request: %d", r.Code)
+	}
+	if body := r.Body.String(); body != `{"error":"rate_limited"}`+"\n" {
+		t.Fatalf("body %q", body)
+	}
+	if got := r.Header().Get("Retry-After"); got != "60" {
+		t.Fatalf("Retry-After %q, want 60", got)
+	}
+}
+
+func TestAProKeyIsLimitedTo600RequestsPerMinute(t *testing.T) {
+	srv, _ := newRateServer(t)
+	if got := hitN(t, srv, "key-globex", 600); got != 600 {
+		t.Fatalf("allowed %d of 600", got)
+	}
+	if r := do(t, srv, "GET", "/api/customers", "key-globex", ""); r.Code != http.StatusTooManyRequests {
+		t.Fatalf("601st request: %d", r.Code)
+	}
+}
+
+func TestEachKeyHasItsOwnLimit(t *testing.T) {
+	srv, _ := newRateServer(t)
+	if got := hitN(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("key-acme allowed %d", got)
+	}
+	if got := hitN(t, srv, "key-acme-2", 60); got != 60 {
+		t.Fatalf("second key of the same account allowed %d", got)
+	}
+}
+
+func TestAllowedRequestsLeaveTheWindowAfterAMinute(t *testing.T) {
+	srv, now := newRateServer(t)
+	t0 := *now
+	hitN(t, srv, "key-acme", 60)
+
+	*now = t0.Add(59999 * time.Millisecond)
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if r.Code != http.StatusTooManyRequests || r.Header().Get("Retry-After") != "1" {
+		t.Fatalf("just before the window: %d Retry-After=%q", r.Code, r.Header().Get("Retry-After"))
+	}
+
+	*now = t0.Add(60 * time.Second)
+	if got := hitN(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("at the window edge allowed %d of 60", got)
+	}
+}
+
+func TestRetryAfterIsRoundedUpToWholeSeconds(t *testing.T) {
+	srv, now := newRateServer(t)
+	t0 := *now
+	do(t, srv, "GET", "/api/customers", "key-acme", "")
+	*now = t0.Add(time.Second)
+	hitN(t, srv, "key-acme", 59)
+
+	*now = t0.Add(10400 * time.Millisecond)
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if r.Code != http.StatusTooManyRequests {
+		t.Fatalf("status %d", r.Code)
+	}
+	// The oldest counted request (at t0) leaves at t0+60s, 49.6s from now, so 50.
+	if got := r.Header().Get("Retry-After"); got != "50" {
+		t.Fatalf("Retry-After %q, want 50", got)
+	}
+}
+
+func TestRejectedRequestsAreNotCounted(t *testing.T) {
+	srv, now := newRateServer(t)
+	t0 := *now
+	hitN(t, srv, "key-acme", 60)
+
+	*now = t0.Add(30 * time.Second)
+	if got := hitN(t, srv, "key-acme", 5); got != 0 {
+		t.Fatalf("requests over the limit were allowed: %d", got)
+	}
+
+	// Only the 60 requests from t0 are counted, so all 60 of the next window's are allowed.
+	*now = t0.Add(60 * time.Second)
+	if got := hitN(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("after the window allowed %d of 60", got)
+	}
+}
+
+func TestRequestsWithoutAValidKeyAreUnauthorizedAndNotCounted(t *testing.T) {
+	srv, _ := newRateServer(t)
+	for i := 0; i < 100; i++ {
+		for _, key := range []string{"", "nope"} {
+			if r := do(t, srv, "GET", "/api/customers", key, ""); r.Code != http.StatusUnauthorized {
+				t.Fatalf("key %q: status %d", key, r.Code)
+			}
+		}
+	}
+	if got := hitN(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("valid key allowed %d of 60 after unauthorized requests", got)
+	}
+}
+
+func TestHealthzIsNotLimited(t *testing.T) {
+	srv, _ := newRateServer(t)
+	for i := 0; i < 100; i++ {
+		if r := do(t, srv, "GET", "/healthz", "", ""); r.Code != http.StatusOK {
+			t.Fatalf("healthz request %d: %d", i, r.Code)
+		}
+	}
+}
+
+func TestConcurrentRequestsShareOneLimit(t *testing.T) {
+	srv, _ := newRateServer(t)
+	var (
+		mu      sync.Mutex
+		allowed int
+		wg      sync.WaitGroup
+	)
+	for i := 0; i < 200; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+			if r.Code == http.StatusOK {
+				mu.Lock()
+				allowed++
+				mu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+	if allowed != 60 {
+		t.Fatalf("concurrent requests allowed %d, want 60", allowed)
+	}
+}
+
+func TestRateLimitedBodyIsJSON(t *testing.T) {
+	srv, _ := newRateServer(t)
+	hitN(t, srv, "key-acme", 60)
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	var body map[string]string
+	if err := json.Unmarshal(r.Body.Bytes(), &body); err != nil || body["error"] != "rate_limited" {
+		t.Fatalf("body %s %v", r.Body, err)
+	}
+	if _, err := strconv.Atoi(r.Header().Get("Retry-After")); err != nil {
+		t.Fatalf("Retry-After: %v", err)
+	}
+}
