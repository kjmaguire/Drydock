+++ b/result/internal/api/ratelimit.go
@@ -0,0 +1,49 @@
+package api
+
+import (
+	"sync"
+	"time"
+
+	"example.com/saasapi/internal/store"
+)
+
+// rateWindow is the rolling window that rate limits are counted over.
+const rateWindow = 60 * time.Second
+
+// rateLimit is how many requests per rateWindow each key of an account on this plan may make.
+func rateLimit(p store.Plan) int {
+	if p == store.PlanPro {
+		return 600
+	}
+	return 60
+}
+
+// rateLimiter counts allowed requests per API key in a sliding window.
+type rateLimiter struct {
+	mu   sync.Mutex
+	hits map[string][]time.Time
+}
+
+func newRateLimiter() *rateLimiter {
+	return &rateLimiter{hits: map[string][]time.Time{}}
+}
+
+// allow records a request by key at time now if fewer than limit requests were allowed in (now-rateWindow, now].
+// Otherwise it counts nothing and returns the whole seconds, at least 1, until the oldest counted request leaves the window.
+func (l *rateLimiter) allow(key string, limit int, now time.Time) (allowed bool, retryAfter int) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	cutoff := now.Add(-rateWindow)
+	ts := l.hits[key]
+	for len(ts) > 0 && !ts[0].After(cutoff) {
+		ts = ts[1:]
+	}
+	if len(ts) >= limit {
+		l.hits[key] = ts
+		wait := ts[0].Add(rateWindow).Sub(now)
+		secs := int((wait + time.Second - 1) / time.Second)
+		return false, max(secs, 1)
+	}
+	l.hits[key] = append(ts, now)
+	return true, 0
+}
