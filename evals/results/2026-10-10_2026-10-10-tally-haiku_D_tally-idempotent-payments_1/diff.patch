diff --git a/result/internal/store/idempotency.go b/result/internal/store/idempotency.go
new file mode 100644
index 0000000..33fabab
--- /dev/null
+++ b/result/internal/store/idempotency.go
@@ -0,0 +1,64 @@
+package store
+
+import "time"
+
+// IdempotencyRetention is how long the response to a request with an Idempotency-Key is kept, and replayed, after it
+// finished.
+const IdempotencyRetention = 24 * time.Hour
+
+// IdempotencyRecord is the request that first used an Idempotency-Key in an organization: what it was for (Fingerprint)
+// and, once it has finished, the response it got.
+type IdempotencyRecord struct {
+	OrgID       string    `json:"org_id"`
+	Key         string    `json:"key"`
+	Fingerprint string    `json:"fingerprint"`
+	Done        bool      `json:"done"`
+	Status      int       `json:"status"`
+	Body        []byte    `json:"body"`
+	FinishedAt  time.Time `json:"finished_at"`
+}
+
+type idemKey struct{ org, key string }
+
+// ReserveIdempotencyKey starts a request that uses key in org, for the request with fingerprint. When the key is free (never
+// used, or its response is older than IdempotencyRetention) it is reserved and the new record is returned with true.
+// Otherwise the record holding the key is returned with false: its request has finished, or is still in progress.
+func (s *Store) ReserveIdempotencyKey(orgID, key, fingerprint string, now time.Time) (IdempotencyRecord, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for k, rec := range s.idem {
+		if rec.Done && !now.Before(rec.FinishedAt.Add(IdempotencyRetention)) {
+			delete(s.idem, k)
+		}
+	}
+	k := idemKey{orgID, key}
+	if rec, ok := s.idem[k]; ok {
+		return rec, false
+	}
+	rec := IdempotencyRecord{OrgID: orgID, Key: key, Fingerprint: fingerprint}
+	s.idem[k] = rec
+	return rec, true
+}
+
+// FinishIdempotencyKey keeps the response of the request that reserved key in org, for replay.
+func (s *Store) FinishIdempotencyKey(orgID, key string, status int, body []byte, now time.Time) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := idemKey{orgID, key}
+	rec, ok := s.idem[k]
+	if !ok {
+		return
+	}
+	rec.Done, rec.Status, rec.Body, rec.FinishedAt = true, status, append([]byte(nil), body...), now.UTC()
+	s.idem[k] = rec
+}
+
+// ReleaseIdempotencyKey frees key in org when its request is still in progress and kept no response, so that a retry runs.
+func (s *Store) ReleaseIdempotencyKey(orgID, key string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := idemKey{orgID, key}
+	if rec, ok := s.idem[k]; ok && !rec.Done {
+		delete(s.idem, k)
+	}
+}
diff --git a/result/internal/store/idempotency_test.go b/result/internal/store/idempotency_test.go
new file mode 100644
index 0000000..3c55d36
--- /dev/null
+++ b/result/internal/store/idempotency_test.go
@@ -0,0 +1,56 @@
+package store
+
+import (
+	"testing"
+	"time"
+)
+
+func TestIdempotencyKeyLifecycle(t *testing.T) {
+	st := New()
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	if _, ok := st.ReserveIdempotencyKey("org_a", "k", "fp1", now); !ok {
+		t.Fatal("a new key is not reserved")
+	}
+	if rec, ok := st.ReserveIdempotencyKey("org_a", "k", "fp1", now); ok || rec.Done || rec.Fingerprint != "fp1" {
+		t.Fatalf("a key in progress: reserved=%v %+v", ok, rec)
+	}
+	if _, ok := st.ReserveIdempotencyKey("org_b", "k", "fp2", now); !ok {
+		t.Fatal("the same key in another organization is not free")
+	}
+	st.FinishIdempotencyKey("org_a", "k", 402, []byte(`{"error":"payment_declined"}`), now)
+	rec, ok := st.ReserveIdempotencyKey("org_a", "k", "fp1", now.Add(IdempotencyRetention-time.Second))
+	if ok || !rec.Done || rec.Status != 402 || string(rec.Body) != `{"error":"payment_declined"}` {
+		t.Fatalf("a kept response: reserved=%v %+v", ok, rec)
+	}
+	if _, ok := st.ReserveIdempotencyKey("org_a", "k", "fp1", now.Add(IdempotencyRetention)); !ok {
+		t.Fatal("a key past its retention is not free")
+	}
+}
+
+func TestReleaseIdempotencyKey(t *testing.T) {
+	st := New()
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	st.ReserveIdempotencyKey("org_a", "k", "fp", now)
+	st.ReleaseIdempotencyKey("org_a", "k")
+	if _, ok := st.ReserveIdempotencyKey("org_a", "k", "fp", now); !ok {
+		t.Fatal("a released key is not free")
+	}
+}
+
+func TestIdempotencyKeysAreSavedWhenFinished(t *testing.T) {
+	st := New()
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	st.ReserveIdempotencyKey("org_a", "done", "fp", now)
+	st.FinishIdempotencyKey("org_a", "done", 200, []byte(`{}`), now)
+	st.ReserveIdempotencyKey("org_a", "busy", "fp", now)
+	saved, err := FromState(st.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rec, ok := saved.ReserveIdempotencyKey("org_a", "done", "fp", now); ok || !rec.Done || rec.Status != 200 {
+		t.Fatalf("a finished key after a save: reserved=%v %+v", ok, rec)
+	}
+	if _, ok := saved.ReserveIdempotencyKey("org_a", "busy", "fp", now); !ok {
+		t.Fatal("a key still in progress was saved")
+	}
+}
