+package api_test
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/payments"
+	"example.com/tally/internal/store"
+)
+
+// newInvoice opens a 10.00 invoice for a customer of org and returns its ID.
+func newInvoice(e *apitest.Env, org apitest.Org, customerID string) string {
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", org.Key, map[string]any{"customer_id": customerID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Work", "quantity": 1, "unit_amount": 1000}}}, &inv)
+	return inv.ID
+}
+
+// payWith pays an invoice with a body naming method, and the Idempotency-Key key unless key is "".
+func payWith(e *apitest.Env, org apitest.Org, invoiceID, key, method string) *apitest.Response {
+	h := http.Header{}
+	if key != "" {
+		h.Set("Idempotency-Key", key)
+	}
+	return e.DoWith("POST", "/v1/invoices/"+invoiceID+"/pay", org.Key, map[string]string{"payment_method": method}, h)
+}
+
+// flakyGateway is unreachable while down is set, and otherwise passes charges on.
+type flakyGateway struct {
+	payments.Gateway
+	down bool
+}
+
+func (g *flakyGateway) Charge(ctx context.Context, req payments.ChargeRequest) (payments.ChargeResult, error) {
+	if g.down {
+		return payments.ChargeResult{}, payments.ErrUnavailable
+	}
+	return g.Gateway.Charge(ctx, req)
+}
+
+func TestPayIdempotencyKeyFormat(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	for _, key := range []string{"tab\there", "clé", strings.Repeat("k", 256)} {
+		if r := payWith(e, e.Acme, newInvoice(e, e.Acme, c.ID), key, "pm_card_visa"); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_idempotency_key" {
+			t.Fatalf("key %q: %s", key, r)
+		}
+	}
+	if r := payWith(e, e.Acme, newInvoice(e, e.Acme, c.ID), "", "pm_card_visa"); r.Code != http.StatusOK {
+		t.Fatalf("no key: %s", r)
+	}
+	for _, key := range []string{strings.Repeat("k", 255), "Order 42 ~!"} {
+		if r := payWith(e, e.Acme, newInvoice(e, e.Acme, c.ID), key, "pm_card_visa"); r.Code != http.StatusOK {
+			t.Fatalf("key %q: %s", key, r)
+		}
+	}
+	if n := len(e.Gateway.Charges()); n != 3 {
+		t.Fatalf("%d charges, want 3", n)
+	}
+}
+
+func TestPayReplaysTheFirstResponse(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	inv := newInvoice(e, e.Acme, c.ID)
+	first := payWith(e, e.Acme, inv, "key-1", "pm_card_visa")
+	if first.Code != http.StatusOK || first.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("first: %s", first)
+	}
+	again := payWith(e, e.Acme, inv, "key-1", "pm_card_visa")
+	if again.Code != first.Code || string(again.Body) != string(first.Body) || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("replay: %s, want %s", again, first)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+	if r := payWith(e, e.Acme, inv, "", "pm_card_visa"); r.Code != http.StatusConflict || r.Map(t)["error"] != "already_paid" {
+		t.Fatalf("pay without the key: %s", r)
+	}
+}
+
+func TestPayKeyBelongsToItsOrganization(t *testing.T) {
+	e := apitest.New(t)
+	ca := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	cg := e.CreateCustomer(e.Globex, "Max", "max@globex.example")
+	if r := payWith(e, e.Acme, newInvoice(e, e.Acme, ca.ID), "shared", "pm_card_visa"); r.Code != http.StatusOK {
+		t.Fatalf("acme: %s", r)
+	}
+	r := payWith(e, e.Globex, newInvoice(e, e.Globex, cg.ID), "shared", "pm_card_visa")
+	if r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("globex with the same key: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestPayKeyReusedForAnotherInvoiceOrBody(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	inv1, inv2 := newInvoice(e, e.Acme, c.ID), newInvoice(e, e.Acme, c.ID)
+	if r := payWith(e, e.Acme, inv1, "k", "pm_card_visa"); r.Code != http.StatusOK {
+		t.Fatalf("first: %s", r)
+	}
+	if r := payWith(e, e.Acme, inv2, "k", "pm_card_visa"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("another invoice: %s", r)
+	}
+	if r := payWith(e, e.Acme, inv1, "k", "pm_card_declined"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("another body: %s", r)
+	}
+	if n := len(e.Gateway.Calls()); n != 1 {
+		t.Fatalf("%d gateway calls", n)
+	}
+}
+
+func TestPayWithKeyWhileItIsInProgress(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	inv := newInvoice(e, e.Acme, c.ID)
+	started, release := make(chan struct{}, 1), make(chan struct{})
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		started <- struct{}{}
+		<-release
+	}
+	first := make(chan *apitest.Response, 1)
+	go func() { first <- payWith(e, e.Acme, inv, "k", "pm_card_visa") }()
+	<-started
+
+	if r := payWith(e, e.Acme, inv, "k", "pm_card_visa"); r.Code != http.StatusConflict || r.Map(t)["error"] != "request_in_progress" {
+		t.Fatalf("same key while in progress: %s", r)
+	}
+	if r := payWith(e, e.Acme, inv, "", "pm_card_visa"); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("no key while in progress: %s", r)
+	}
+	if r := payWith(e, e.Acme, inv, "other", "pm_card_visa"); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("another key while in progress: %s", r)
+	}
+	close(release)
+	if r := <-first; r.Code != http.StatusOK {
+		t.Fatalf("first: %s", r)
+	}
+	if r := payWith(e, e.Acme, inv, "k", "pm_card_visa"); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("replay after it finished: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestPayServerErrorIsNotKept(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	inv := newInvoice(e, e.Acme, c.ID)
+	gw := &flakyGateway{Gateway: e.Gateway, down: true}
+	e.Payments.Gateway = gw
+	if r := payWith(e, e.Acme, inv, "k", "pm_card_visa"); r.Code != http.StatusServiceUnavailable || r.Map(t)["error"] != "gateway_unavailable" {
+		t.Fatalf("gateway down: %s", r)
+	}
+	gw.down = false
+	r := payWith(e, e.Acme, inv, "k", "pm_card_visa")
+	if r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("retry: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestPayClientErrorIsKept(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	inv := newInvoice(e, e.Acme, c.ID)
+	first := payWith(e, e.Acme, inv, "k", "pm_card_declined")
+	if first.Code != http.StatusPaymentRequired {
+		t.Fatalf("declined: %s", first)
+	}
+	again := payWith(e, e.Acme, inv, "k", "pm_card_declined")
+	if again.Code != http.StatusPaymentRequired || string(again.Body) != string(first.Body) || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("replay of a decline: %s, want %s", again, first)
+	}
+	if n := len(e.Gateway.Calls()); n != 1 {
+		t.Fatalf("%d gateway calls", n)
+	}
+}
+
+func TestPayKeyExpiresAfterRetention(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	inv1, inv2 := newInvoice(e, e.Acme, c.ID), newInvoice(e, e.Acme, c.ID)
+	if r := payWith(e, e.Acme, inv1, "k", "pm_card_visa"); r.Code != http.StatusOK {
+		t.Fatalf("first: %s", r)
+	}
+	e.Clock.Advance(store.IdempotencyRetention - time.Second)
+	if r := payWith(e, e.Acme, inv1, "k", "pm_card_visa"); r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("replay before the retention ends: %s", r)
+	}
+	e.Clock.Advance(time.Second)
+	if r := payWith(e, e.Acme, inv2, "k", "pm_card_visa"); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("after the retention the key is new: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("%d charges", n)
+	}
+}
