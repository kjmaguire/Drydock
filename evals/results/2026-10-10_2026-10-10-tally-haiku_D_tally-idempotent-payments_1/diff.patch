+	r.Body = io.NopCloser(bytes.NewReader(raw))
+	invoiceID := r.PathValue("id")
+	if !keyed {
+		s.charge(w, r, p, invoiceID)
+		return
+	}
+	fp := requestFingerprint(invoiceID, raw)
+	rec, reserved := s.store.ReserveIdempotencyKey(p.OrgID, key, fp, s.clock.Now())
+	switch {
+	case !reserved && rec.Fingerprint != fp:
+		writeError(w, http.StatusUnprocessableEntity, "idempotency_key_reused", "this Idempotency-Key was used for another invoice or request body")
+		return
+	case !reserved && !rec.Done:
+		writeError(w, http.StatusConflict, "request_in_progress", "a request with this Idempotency-Key is still being handled")
+		return
+	case !reserved:
+		w.Header().Set("Idempotent-Replayed", "true")
+		writeKept(w, rec.Status, rec.Body)
+		return
+	}
+	// The key stays reserved until its response is kept. A server error is not kept: the key is released, so a retry runs.
+	kept := false
+	defer func() {
+		if !kept {
+			s.store.ReleaseIdempotencyKey(p.OrgID, key)
+		}
+	}()
+	c := newCapture()
+	s.charge(c, r, p, invoiceID)
+	if c.status < http.StatusInternalServerError {
+		s.store.FinishIdempotencyKey(p.OrgID, key, c.status, c.body.Bytes(), s.clock.Now())
+		kept = true
+	}
+	writeKept(w, c.status, c.body.Bytes())
+}
