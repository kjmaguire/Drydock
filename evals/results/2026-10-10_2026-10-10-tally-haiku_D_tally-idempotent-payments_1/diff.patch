 func (s *Server) payInvoice(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	key, keyed, ok := idempotencyKey(w, r)
+	if !ok {
+		return
+	}
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 1<<20))
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_json", "the body is not valid JSON: "+err.Error())
+		return
