+package api
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"net/http"
+)
+
+// idempotencyKey returns the request's Idempotency-Key, and whether it sent one. A key that is not 1 to 255 printable ASCII
+// characters answers 400 and returns false.
+func idempotencyKey(w http.ResponseWriter, r *http.Request) (key string, sent, ok bool) {
+	vals := r.Header.Values("Idempotency-Key")
+	if len(vals) == 0 {
+		return "", false, true
+	}
+	if len(vals) > 1 || !printableASCII(vals[0]) {
+		writeError(w, http.StatusBadRequest, "invalid_idempotency_key", "Idempotency-Key is 1 to 255 printable ASCII characters")
+		return "", false, false
+	}
+	return vals[0], true, true
+}
+
+func printableASCII(s string) bool {
+	if len(s) < 1 || len(s) > 255 {
+		return false
+	}
+	for i := range len(s) {
+		if s[i] < ' ' || s[i] > '~' {
+			return false
+		}
+	}
+	return true
+}
+
+// requestFingerprint identifies what a request with an Idempotency-Key is for: the invoice and the exact body.
+func requestFingerprint(invoiceID string, body []byte) string {
+	h := sha256.New()
+	_, _ = fmt.Fprintf(h, "%d:%s\n", len(invoiceID), invoiceID)
+	_, _ = h.Write(body)
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+// capture holds a response until it is known whether it is kept, so that it can be sent again to a replay.
+type capture struct {
+	header http.Header
+	status int
+	wrote  bool
+	body   bytes.Buffer
+}
+
+func newCapture() *capture { return &capture{header: http.Header{}, status: http.StatusOK} }
+
+func (c *capture) Header() http.Header { return c.header }
+
+func (c *capture) WriteHeader(status int) {
+	if !c.wrote {
+		c.status, c.wrote = status, true
+	}
+}
+
+func (c *capture) Write(b []byte) (int, error) {
+	c.wrote = true
+	return c.body.Write(b)
+}
+
+// writeKept answers a kept response: its status and its JSON body, exactly as it was first sent.
+func writeKept(w http.ResponseWriter, status int, body []byte) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_, _ = w.Write(body)
+}
