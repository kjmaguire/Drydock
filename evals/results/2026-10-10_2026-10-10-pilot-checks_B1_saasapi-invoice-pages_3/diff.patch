+
+// parseLimit reads the limit parameter: a whole number from 1 to maxPageLimit, or defaultPageLimit when absent.
+func parseLimit(q url.Values) (int, bool) {
+	if !q.Has("limit") {
+		return defaultPageLimit, true
+	}
+	raw := q.Get("limit")
+	if raw == "" {
+		return 0, false
+	}
+	for _, c := range raw {
+		if c < '0' || c > '9' {
+			return 0, false
+		}
+	}
+	n, err := strconv.Atoi(raw)
+	if err != nil || n < 1 || n > maxPageLimit {
+		return 0, false
+	}
+	return n, true
+}
+
+// cursorData is the content of a cursor before it is encoded.
+type cursorData struct {
+	CreatedAt time.Time `json:"created_at"`
+	ID        string    `json:"id"`
+}
+
+// encodeCursor returns the opaque cursor for a position in the invoice list.
+func encodeCursor(p store.InvoicePosition) string {
+	// Marshaling a time and a string cannot fail.
+	b, _ := json.Marshal(cursorData{CreatedAt: p.CreatedAt, ID: p.ID})
+	return base64.RawURLEncoding.EncodeToString(b)
+}
+
+// decodeCursor reads a cursor from encodeCursor. It reports false for anything else.
+func decodeCursor(s string) (store.InvoicePosition, bool) {
+	b, err := base64.RawURLEncoding.DecodeString(s)
+	if err != nil {
+		return store.InvoicePosition{}, false
+	}
+	var c cursorData
+	if err := json.Unmarshal(b, &c); err != nil || c.ID == "" || c.CreatedAt.IsZero() {
+		return store.InvoicePosition{}, false
 	}
-	writeJSON(w, http.StatusOK, map[string]any{"items": items})
+	return store.InvoicePosition{CreatedAt: c.CreatedAt, ID: c.ID}, true
 }
 
