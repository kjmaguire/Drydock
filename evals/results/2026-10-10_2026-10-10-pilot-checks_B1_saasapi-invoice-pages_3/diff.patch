+func TestInvoicesAreAPageAtATimeWithTheDefaultLimit(t *testing.T) {
+	srv, st := newServer(t)
+	c, _ := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, time.Now())
+	ids := createInvoices(t, srv, "key-acme", c.ID, 25)
+
+	first, next := invoicePage(t, srv, "key-acme", "")
+	if len(first) != 20 || next == "" {
+		t.Fatalf("first page: %d items, next %q", len(first), next)
+	}
+	second, next := invoicePage(t, srv, "key-acme", "cursor="+next)
+	if len(second) != 5 || next != "" {
+		t.Fatalf("last page: %d items, next %q", len(second), next)
+	}
+	if got := append(first, second...); !slices.Equal(got, ids) {
+		t.Fatalf("pages %v, want %v", got, ids)
+	}
+}
