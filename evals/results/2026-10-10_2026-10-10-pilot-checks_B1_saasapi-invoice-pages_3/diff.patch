+// InvoicePosition is a place in an account's invoice list: the invoice created at CreatedAt with this ID.
+type InvoicePosition struct {
+	CreatedAt time.Time
+	ID        string
+}
+
+// InvoicePage returns up to limit of an account's invoices, oldest first (ties by ID), starting with the first
+// invoice after the given position. A nil position starts at the oldest invoice. Invoices created after a position
+// sort after it, so a page read from a position is not shifted by invoices created since.
+func (s *Store) InvoicePage(accountID string, after *InvoicePosition, limit int) []Invoice {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Invoice{}
+	for _, inv := range s.invoices {
+		if inv.AccountID != accountID {
+			continue
+		}
+		if after != nil && !creationBefore(after.CreatedAt, after.ID, inv.CreatedAt, inv.ID) {
+			continue
 		}
-		return out[i].ID < out[j].ID
+		out = append(out, inv)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		return creationBefore(out[i].CreatedAt, out[i].ID, out[j].CreatedAt, out[j].ID)
 	})
+	if len(out) > max(limit, 0) {
+		out = out[:max(limit, 0)]
+	}
 	return out
 }
+
+// creationBefore reports whether the invoice created at (at, id) comes before the one created at (at2, id2).
+func creationBefore(at time.Time, id string, at2 time.Time, id2 string) bool {
+	if !at.Equal(at2) {
+		return at.Before(at2)
+	}
+	return id < id2
+}
