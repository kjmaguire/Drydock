+// createInvoices adds n invoices for a customer through the API and returns their IDs, oldest first.
+func createInvoices(t *testing.T, srv http.Handler, key, customerID string, n int) []string {
+	t.Helper()
+	ids := []string{}
+	body := `{"customer_id":"` + customerID + `","lines":[{"description":"Seats","quantity":1,"unit_cents":100}]}`
+	for i := 0; i < n; i++ {
+		r := do(t, srv, "POST", "/api/invoices", key, body)
+		if r.Code != http.StatusCreated {
+			t.Fatalf("create invoice: %d %s", r.Code, r.Body)
+		}
+		var v struct {
+			ID string `json:"id"`
+		}
+		if err := json.Unmarshal(r.Body.Bytes(), &v); err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, v.ID)
+	}
+	return ids
+}
+
+// invoicePage fetches one page of invoices. It returns the IDs on the page and the next cursor.
+func invoicePage(t *testing.T, srv http.Handler, key, query string) ([]string, string) {
+	t.Helper()
+	r := do(t, srv, "GET", "/api/invoices?"+query, key, "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("list %q: %d %s", query, r.Code, r.Body)
+	}
+	var body struct {
+		Items []struct {
+			ID string `json:"id"`
+		} `json:"items"`
+		NextCursor string `json:"next_cursor"`
+	}
+	if err := json.Unmarshal(r.Body.Bytes(), &body); err != nil {
+		t.Fatal(err)
+	}
+	ids := []string{}
+	for _, it := range body.Items {
+		ids = append(ids, it.ID)
+	}
+	return ids, body.NextCursor
+}
+
+// walkInvoices follows next cursors from the first page until the last one and returns every ID seen.
+func walkInvoices(t *testing.T, srv http.Handler, key, limit string) []string {
+	t.Helper()
+	all := []string{}
+	query := "limit=" + limit
+	for pages := 0; ; pages++ {
+		if pages > 1000 {
+			t.Fatal("paging does not end")
+		}
+		ids, next := invoicePage(t, srv, key, query)
+		all = append(all, ids...)
+		if next == "" {
+			return all
+		}
+		query = "limit=" + limit + "&cursor=" + next
+	}
+}
+
+// errorCode returns the error code of an error response.
+func errorCode(t *testing.T, r *httptest.ResponseRecorder) string {
+	t.Helper()
+	var body map[string]string
+	if err := json.Unmarshal(r.Body.Bytes(), &body); err != nil {
+		t.Fatalf("error body %s: %v", r.Body, err)
+	}
+	return body["error"]
+}
