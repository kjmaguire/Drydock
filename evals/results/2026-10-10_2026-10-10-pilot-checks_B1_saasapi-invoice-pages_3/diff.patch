+func TestPagingDoesNotSkipOrRepeatWhenInvoicesAreCreatedBetweenPages(t *testing.T) {
+	st := store.New()
+	st.AddAccount(store.Account{ID: "acc_acme", Name: "Acme", Plan: store.PlanFree, TaxRateBP: 825})
+	st.AddKey("key-acme", "acc_acme")
+	// Each invoice gets a later time than the one before it.
+	clock := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	srv := api.New(st, api.Options{Now: func() time.Time { clock = clock.Add(time.Second); return clock }})
+	c, _ := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, time.Now())
+
+	seen := []string{}
+	ids := createInvoices(t, srv, "key-acme", c.ID, 5)
+	page, next := invoicePage(t, srv, "key-acme", "limit=2")
+	seen = append(seen, page...)
+
+	// New invoices arrive while the client is partway through.
+	ids = append(ids, createInvoices(t, srv, "key-acme", c.ID, 2)...)
+	page, next = invoicePage(t, srv, "key-acme", "limit=2&cursor="+next)
+	seen = append(seen, page...)
+
+	ids = append(ids, createInvoices(t, srv, "key-acme", c.ID, 1)...)
+	for pages := 0; next != ""; pages++ {
+		if pages > 100 {
+			t.Fatal("paging does not end")
+		}
+		page, next = invoicePage(t, srv, "key-acme", "limit=2&cursor="+next)
+		seen = append(seen, page...)
+	}
+	if !slices.Equal(seen, ids) {
+		t.Fatalf("paged %v, want %v", seen, ids)
+	}
+}
