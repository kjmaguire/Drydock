+func TestAnInvoiceCreatedAtTheSameTimeSortsByID(t *testing.T) {
+	// A fixed clock gives every invoice the same creation time, so the order comes from the ID alone.
+	srv, st := newServer(t)
+	c, _ := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, time.Now())
+	ids := createInvoices(t, srv, "key-acme", c.ID, 12)
+	if got := walkInvoices(t, srv, "key-acme", "5"); !slices.Equal(got, ids) {
+		t.Fatalf("paged %v, want %v", got, ids)
+	}
+}
+
+func TestAPageNeverShowsAnotherAccountsInvoices(t *testing.T) {
+	srv, st := newServer(t)
+	acme, _ := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, time.Now())
+	globex, _ := st.CreateCustomer("acc_globex", "Hank", "hank@globex.test", store.PlanPro, time.Now())
+	acmeIDs := createInvoices(t, srv, "key-acme", acme.ID, 3)
+	globexIDs := createInvoices(t, srv, "key-globex", globex.ID, 3)
+
+	if got := walkInvoices(t, srv, "key-globex", "2"); !slices.Equal(got, globexIDs) {
+		t.Fatalf("globex pages %v, want %v", got, globexIDs)
+	}
+	// A cursor from one account used with another account's key shows only the other account's invoices.
+	_, next := invoicePage(t, srv, "key-acme", "limit=1")
+	got, _ := invoicePage(t, srv, "key-globex", "cursor="+next)
+	for _, id := range got {
+		if slices.Contains(acmeIDs, id) {
+			t.Fatalf("another account's invoice %s is listed: %v", id, got)
+		}
+	}
+}
