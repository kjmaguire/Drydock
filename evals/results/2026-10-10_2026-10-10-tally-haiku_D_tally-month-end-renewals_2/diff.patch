+func TestMissedPeriodsAfterPlanChangeToYearly(t *testing.T) {
+	e := apitest.New(t)
+	sub := switchedToYearly(t, e, time.Date(2026, 2, 15, 10, 0, 0, 0, time.UTC))
+	// The job did not run until Jan 31, 2027: the period from Feb 28 to Jan 31 and the yearly period after it are both renewed.
+	e.Clock.Set(time.Date(2027, 1, 31, 10, 0, 0, 0, time.UTC))
+	if n, err := e.Subs.RenewDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if !got.CurrentPeriodStart.Equal(time.Date(2027, 1, 31, 10, 0, 0, 0, time.UTC)) || !got.CurrentPeriodEnd.Equal(time.Date(2028, 1, 31, 10, 0, 0, 0, time.UTC)) {
+		t.Fatalf("after the missed periods = %+v", got)
+	}
+	requireInvoicedPeriods(t, e, sub.ID, [][2]time.Time{
+		{time.Date(2026, 1, 31, 10, 0, 0, 0, time.UTC), time.Date(2026, 2, 28, 10, 0, 0, 0, time.UTC)},
+		{time.Date(2026, 2, 28, 10, 0, 0, 0, time.UTC), time.Date(2027, 1, 31, 10, 0, 0, 0, time.UTC)},
+		{time.Date(2027, 1, 31, 10, 0, 0, 0, time.UTC), time.Date(2028, 1, 31, 10, 0, 0, 0, time.UTC)},
+	})
+	if cs := e.Gateway.Charges(); len(cs) != 3 {
+		t.Fatalf("charges = %d, want 3", len(cs))
+	}
+}
