+func TestPlanChangeToYearlyKeepsPeriodsContiguous(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := switchedToYearly(t, e, time.Date(2026, 2, 15, 10, 0, 0, 0, time.UTC))
+	// The stored end, Feb 28, is not on the yearly schedule (Jan 31), so the period from it runs to Jan 31, 2027. The job then
+	// runs on Jan 31, 2027 and the yearly schedule resumes.
+	for _, at := range []time.Time{time.Date(2026, 2, 28, 10, 0, 0, 0, time.UTC), time.Date(2027, 1, 31, 10, 0, 0, 0, time.UTC)} {
+		e.Clock.Set(at)
+		if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+			t.Fatalf("RenewDue at %v = %d, %v", at, n, err)
+		}
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(time.Date(2027, 1, 31, 10, 0, 0, 0, time.UTC)) ||
+		!got.CurrentPeriodEnd.Equal(time.Date(2028, 1, 31, 10, 0, 0, 0, time.UTC)) {
+		t.Fatalf("after the switch = %+v", got)
+	}
+	requireInvoicedPeriods(t, e, sub.ID, [][2]time.Time{
+		{time.Date(2026, 1, 31, 10, 0, 0, 0, time.UTC), time.Date(2026, 2, 28, 10, 0, 0, 0, time.UTC)},
+		{time.Date(2026, 2, 28, 10, 0, 0, 0, time.UTC), time.Date(2027, 1, 31, 10, 0, 0, 0, time.UTC)},
+		{time.Date(2027, 1, 31, 10, 0, 0, 0, time.UTC), time.Date(2028, 1, 31, 10, 0, 0, 0, time.UTC)},
+	})
+}
