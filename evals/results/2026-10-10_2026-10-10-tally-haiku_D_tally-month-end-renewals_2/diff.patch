+	sub := billedMonthly(t, e, time.Date(2026, 1, 31, 10, 0, 0, 0, time.UTC))
+	yearly, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Team yearly", Currency: money.USD, UnitAmount: 24000, Interval: store.Yearly}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(at)
+	sub, err = e.Subs.Update(context.Background(), e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &yearly.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
