+
+// Anchor returns the start of a subscription's first paid period: its trial's end for one that started with a trial,
+// otherwise when it started. Billing periods are counted from the anchor.
+func Anchor(startedAt time.Time, trialEnd *time.Time) time.Time {
+	if trialEnd != nil {
+		return *trialEnd
+	}
+	return startedAt
+}
+
+// PeriodStart returns the start of period n (n = 0, 1, 2, ...) of a plan billed at iv, counted from anchor: n months or
+// years after it, on the anchor's day of the month and at its time of day, or on the last day of that month when the
+// month is shorter. Times are UTC. Period n ends where period n+1 starts.
+func PeriodStart(anchor time.Time, iv store.Interval, n int) time.Time {
+	a := anchor.UTC()
+	months := n
 	if iv == store.Yearly {
-		return t.AddDate(1, 0, 0)
+		months = 12 * n
+	}
+	m := int(a.Month()) - 1 + months
+	year, month := a.Year()+m/12, time.Month(m%12+1)
+	day := min(a.Day(), time.Date(year, month+1, 0, 0, 0, 0, 0, time.UTC).Day())
+	return time.Date(year, month, day, a.Hour(), a.Minute(), a.Second(), a.Nanosecond(), time.UTC)
+}
+
+// NextPeriodStart returns the first period start on the anchor's schedule (see PeriodStart) that is after t. Times are UTC.
+func NextPeriodStart(anchor time.Time, iv store.Interval, t time.Time) time.Time {
+	a, u := anchor.UTC(), t.UTC()
+	step := 1
+	if iv == store.Yearly {
+		step = 12
+	}
+	// Starting one step before t's month keeps the search below t, so the loop only moves forward.
+	months := (u.Year()-a.Year())*12 + int(u.Month()-a.Month())
+	n := max(0, months/step-1)
+	for !PeriodStart(a, iv, n).After(u) {
+		n++
 	}
-	return t.AddDate(0, 1, 0)
+	return PeriodStart(a, iv, n)
 }
