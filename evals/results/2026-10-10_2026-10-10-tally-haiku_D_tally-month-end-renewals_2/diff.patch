+func TestPeriodDriftedByAnEarlierRenewalIsBridged(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := billedMonthly(t, e, time.Date(2026, 1, 31, 10, 0, 0, 0, time.UTC))
+	// Renewals made before the fix added whole months with AddDate, so a period from Jan 31 ended on Mar 3.
+	if _, err := e.Store.UpdateSubscription(e.Acme.ID, sub.ID, func(x *store.Subscription) error {
+		x.CurrentPeriodStart, x.CurrentPeriodEnd = time.Date(2026, 1, 31, 10, 0, 0, 0, time.UTC), time.Date(2026, 3, 3, 10, 0, 0, 0, time.UTC)
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	// The period from Mar 3 runs to the schedule's next boundary, Mar 31, with no gap; then the schedule resumes.
+	for _, want := range []struct{ start, end time.Time }{
+		{time.Date(2026, 3, 3, 10, 0, 0, 0, time.UTC), time.Date(2026, 3, 31, 10, 0, 0, 0, time.UTC)},
+		{time.Date(2026, 3, 31, 10, 0, 0, 0, time.UTC), time.Date(2026, 4, 30, 10, 0, 0, 0, time.UTC)},
+	} {
+		e.Clock.Set(want.start)
+		if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+			t.Fatalf("RenewDue = %d, %v", n, err)
+		}
+		got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+		if !got.CurrentPeriodStart.Equal(want.start) || !got.CurrentPeriodEnd.Equal(want.end) {
+			t.Fatalf("period = %v to %v, want %v to %v", got.CurrentPeriodStart, got.CurrentPeriodEnd, want.start, want.end)
+		}
+	}
+}
