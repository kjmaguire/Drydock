+func TestPendingInvites(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	old, _ := s.CreateInvite(a.ID, "old@example.com", RoleMember, "usr_000001", t0)
+	fresh, _ := s.CreateInvite(a.ID, "fresh@example.com", RoleMember, "usr_000001", t0.Add(6*24*time.Hour))
+	accepted, _ := s.CreateInvite(a.ID, "accepted@example.com", RoleMember, "usr_000001", t0.Add(6*24*time.Hour))
+	if _, _, _, err := s.AcceptInvite(accepted.Token, "Acc", t0.Add(6*24*time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	revoked, _ := s.CreateInvite(a.ID, "revoked@example.com", RoleMember, "usr_000001", t0.Add(6*24*time.Hour))
+	if _, err := s.RevokeInvite(a.ID, revoked.ID, t0.Add(6*24*time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	pending := s.PendingInvites(a.ID, t0.Add(InviteLifetime+time.Hour))
+	if len(pending) != 1 || pending[0].ID != fresh.ID {
+		t.Fatalf("pending = %+v, want only %s (%s is expired)", pending, fresh.ID, old.ID)
+	}
+	if got := fresh.ExpiresAt(); !got.Equal(t0.Add(6*24*time.Hour + InviteLifetime)) {
+		t.Fatalf("expires at %v", got)
+	}
+}
