+// migrateV2Invites hashes the tokens that version 2 files kept in plain text, so those invites still work. The next
+// Save writes the file in version 3 form, which has no tokens.
+func migrateV2Invites(b []byte, st *store.State) error {
+	var old struct {
+		State struct {
+			Invites []struct {
+				ID    string `json:"id"`
+				Token string `json:"token"`
+			} `json:"invites"`
+		} `json:"state"`
+	}
+	if err := json.Unmarshal(b, &old); err != nil {
+		return err
+	}
+	tokens := map[string]string{}
+	for _, i := range old.State.Invites {
+		tokens[i.ID] = i.Token
+	}
+	for i := range st.Invites {
+		if t := tokens[st.Invites[i].ID]; t != "" {
+			st.Invites[i].TokenHash = store.InviteTokenHash(t)
+		}
+	}
+	return nil
+}
