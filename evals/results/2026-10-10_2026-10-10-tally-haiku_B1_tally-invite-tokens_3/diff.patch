+// pendingExpiry returns when the pending invite to addr expires, or the zero time when the list has none for addr.
+func pendingExpiry(t *testing.T, e *apitest.Env, addr string) time.Time {
+	t.Helper()
+	var list struct {
+		Items []struct {
+			Email     string    `json:"email"`
+			ExpiresAt time.Time `json:"expires_at"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &list)
+	for _, it := range list.Items {
+		if it.Email == addr {
+			return it.ExpiresAt
+		}
+	}
+	return time.Time{}
+}
+
+func errorCode(t *testing.T, r *apitest.Response) string {
+	t.Helper()
+	code, _ := r.Map(t)["error"].(string)
+	return code
+}
