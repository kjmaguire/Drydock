+	if !ok || stored.Token != "" || stored.TokenHash != InviteTokenHash(inv.Token) {
+		t.Fatalf("stored invite = %+v", stored)
+	}
+	state, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(state), inv.Token) {
+		t.Fatal("the exported state holds a token")
+	}
+	if pending := s.PendingInvites(a.ID, t0); len(pending) != 2 || pending[0].Token != "" {
+		t.Fatalf("pending = %+v", pending)
+	}
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := s2.AcceptInvite(inv.Token, "New", t0); err != nil {
+		t.Fatalf("the invite does not work after FromState: %v", err)
+	}
+}
