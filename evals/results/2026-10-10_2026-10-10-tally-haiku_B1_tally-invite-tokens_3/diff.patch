+	elsewhere, _ := s.CreateInvite(b.ID, "ann@example.com", RoleMember, "usr_000001", t0)
+	second, err := s.CreateInvite(a.ID, "ann@example.com ", RoleViewer, "usr_000001", t0.Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := s.AcceptInvite(first.Token, "Ann", t0.Add(time.Hour)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("the replaced token: %v", err)
