+// inviteToken returns the token in the newest invite email sent to addr.
+func inviteToken(t *testing.T, e *apitest.Env, addr string) string {
+	t.Helper()
+	msgs := e.Mail.Messages()
+	for i := len(msgs) - 1; i >= 0; i-- {
+		if msgs[i].To != addr {
+			continue
+		}
+		m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[i].Body)
+		if m == nil {
+			t.Fatalf("no link in %q", msgs[i].Body)
+		}
+		token, _ := url.QueryUnescape(m[1])
+		return token
+	}
+	t.Fatalf("no invite email to %s", addr)
+	return ""
+}
+
+func TestInviteTokens(t *testing.T) {
+	e := apitest.New(t)
+	_, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+
+	created := e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "New@People.example", "role": "member"})
+	if created.Code != http.StatusCreated {
+		t.Fatalf("invite: %s", created)
+	}
+	token := inviteToken(t, e, "New@People.example")
+	if len(token) != 43 {
+		t.Fatalf("token %q is not 43 characters", token)
+	}
+	if strings.Contains(string(created.Body), token) {
+		t.Fatalf("the invite answer holds the token: %s", created.Body)
+	}
+	if fields := created.Map(t); fields["token"] != nil || fields["token_hash"] != nil || fields["expires_at"] == nil {
+		t.Fatalf("invite = %v", fields)
+	}
+
+	// Viewers may read the list, but it never holds a token.
+	listed := e.Do("GET", "/v1/invites", viewerKey, nil)
+	if listed.Code != http.StatusOK || strings.Contains(string(listed.Body), token) {
+		t.Fatalf("a viewer reads the invites: %s", listed)
+	}
+	if !strings.Contains(string(listed.Body), `"expires_at"`) {
+		t.Fatalf("the list has no expires_at: %s", listed.Body)
+	}
+
+	// An invite to the same address, ignoring case, replaces the first one.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "admin"}, nil)
+	newToken := inviteToken(t, e, "new@people.example")
+	if newToken == token {
+		t.Fatal("the new invite got the old token")
+	}
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "New Person"}); r.Code != http.StatusNotFound || errorCode(t, r) != "invite_not_found" {
+		t.Fatalf("the replaced token: %s", r)
+	}
+	var accepted struct {
+		User   store.User   `json:"user"`
+		APIKey store.APIKey `json:"api_key"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": newToken, "name": "New Person"}, &accepted)
+	if accepted.User.Email != "new@people.example" || accepted.APIKey.Token == "" {
+		t.Fatalf("accepted = %+v", accepted)
+	}
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": newToken, "name": "Again"}); r.Code != http.StatusGone || errorCode(t, r) != "invite_used" {
+		t.Fatalf("a used token: %s", r)
+	}
+
+	// An invite is good for 7 days from when it was created, on the service's clock.
+	createdAt := e.Clock.Now()
+	var late struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "late@people.example", "role": "member"}, &late)
+	lateToken := inviteToken(t, e, "late@people.example")
+	e.Clock.Advance(7 * 24 * time.Hour)
+	if expires := pendingExpiry(t, e, "late@people.example"); !expires.Equal(createdAt.Add(7 * 24 * time.Hour)) {
+		t.Fatalf("expires_at = %v", expires)
+	}
+	e.Clock.Advance(time.Second)
+	if expires := pendingExpiry(t, e, "late@people.example"); !expires.IsZero() {
+		t.Fatalf("an expired invite is still pending, expires %v", expires)
+	}
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": lateToken, "name": "Late"}); r.Code != http.StatusGone || errorCode(t, r) != "invite_expired" {
+		t.Fatalf("an expired token: %s", r)
+	}
+
+	// A revoked invite's token is unknown.
+	var gone struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "gone@people.example", "role": "member"}, &gone)
+	goneToken := inviteToken(t, e, "gone@people.example")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+gone.ID, e.Acme.Key, nil, nil)
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": goneToken, "name": "Gone"}); r.Code != http.StatusNotFound || errorCode(t, r) != "invite_not_found" {
+		t.Fatalf("a revoked token: %s", r)
+	}
+}
