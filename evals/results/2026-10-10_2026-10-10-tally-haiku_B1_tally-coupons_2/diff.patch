+// couponFor returns the coupon of a subscription when it discounts an invoice created at now for the period starting at start.
+// A coupon discounts the invoices created after it was applied: once, only the first of them; repeating, those whose period
+// starts less than its duration in months after the redemption; forever, all of them.
+func (s *Service) couponFor(orgID, subID string, start, now time.Time) (store.Coupon, bool) {
+	sub, ok := s.Store.Subscription(orgID, subID)
+	if !ok || sub.Coupon == "" || sub.CouponRedeemedAt == nil {
+		return store.Coupon{}, false
+	}
+	redeemed := *sub.CouponRedeemedAt
+	c, ok := s.Store.Coupon(orgID, sub.Coupon)
+	if !ok || !now.After(redeemed) {
+		return store.Coupon{}, false
+	}
+	switch c.Duration {
+	case store.DurationForever:
+		return c, true
+	case store.DurationRepeating:
+		if start.Before(redeemed.AddDate(0, c.DurationInMonths, 0)) {
+			return c, true
+		}
+		return store.Coupon{}, false
+	default: // once
+		for _, inv := range s.Store.ListInvoices(orgID, store.InvoiceFilter{SubscriptionID: subID}) {
+			if inv.Coupon == c.Code {
+				return store.Coupon{}, false
+			}
+		}
+		return c, true
+	}
+}
