@@ -0,0 +1,132 @@
+package subscriptions_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/billing"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+	"example.com/tally/internal/subscriptions"
+)
+
+// couponSub starts a subscription to a 20.00 USD monthly plan (no payment method: its invoices stay open) with the given
+// discount percentage, and returns it with the environment.
+func couponSub(t *testing.T, discountPercent int) (*apitest.Env, store.Subscription) {
+	t.Helper()
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1, DiscountPercent: discountPercent})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return e, sub
+}
+
+func addCoupon(t *testing.T, e *apitest.Env, c store.Coupon) {
+	t.Helper()
+	c.OrgID = e.Acme.ID
+	if _, err := e.Store.CreateCoupon(c, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// renewAt moves the clock to at and renews the subscription, which must be due.
+func renewAt(t *testing.T, e *apitest.Env, at time.Time) {
+	t.Helper()
+	e.Clock.Set(at)
+	if n, err := e.Subs.RenewDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("RenewDue at %v = %d, %v", at, n, err)
+	}
+}
+
+// discounts returns each invoice's discount (in creation order) and whether it names a coupon.
+func discounts(e *apitest.Env, sub store.Subscription) (amounts []int64, coupons []string) {
+	for _, inv := range e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+		amounts = append(amounts, billing.Compute(inv).Discount)
+		coupons = append(coupons, inv.Coupon)
+	}
+	return amounts, coupons
+}
+
+func TestForeverCouponDiscountsEveryLaterInvoice(t *testing.T) {
+	e, sub := couponSub(t, 0)
+	addCoupon(t, e, store.Coupon{Code: "FOREVER", PercentOff: 15, Duration: store.DurationForever})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "forever"); err != nil {
+		t.Fatal(err)
+	}
+	renewAt(t, e, sub.CurrentPeriodEnd)
+	renewAt(t, e, sub.CurrentPeriodEnd.AddDate(0, 1, 0))
+	amounts, coupons := discounts(e, sub)
+	// the first invoice was created before the coupon was applied; 15% of 2000 is 300
+	if len(amounts) != 3 || amounts[0] != 0 || amounts[1] != 300 || amounts[2] != 300 {
+		t.Fatalf("discounts = %v", amounts)
+	}
+	if coupons[0] != "" || coupons[1] != "FOREVER" || coupons[2] != "FOREVER" {
+		t.Fatalf("coupons = %q", coupons)
+	}
+}
+
+func TestOnceCouponDiscountsOnlyTheFirstLaterInvoice(t *testing.T) {
+	e, sub := couponSub(t, 0)
+	addCoupon(t, e, store.Coupon{Code: "ONCE", AmountOff: 500, Currency: money.USD, Duration: store.DurationOnce})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "ONCE"); err != nil {
+		t.Fatal(err)
+	}
+	renewAt(t, e, sub.CurrentPeriodEnd)
+	renewAt(t, e, sub.CurrentPeriodEnd.AddDate(0, 1, 0))
+	amounts, coupons := discounts(e, sub)
+	if len(amounts) != 3 || amounts[0] != 0 || amounts[1] != 500 || amounts[2] != 0 {
+		t.Fatalf("discounts = %v", amounts)
+	}
+	if coupons[1] != "ONCE" || coupons[2] != "" {
+		t.Fatalf("coupons = %q", coupons)
+	}
+}
+
+func TestRepeatingCouponStopsAfterItsMonths(t *testing.T) {
+	e, sub := couponSub(t, 0)
+	addCoupon(t, e, store.Coupon{Code: "TWOMONTHS", PercentOff: 50, Duration: store.DurationRepeating, DurationInMonths: 2})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "TWOMONTHS"); err != nil {
+		t.Fatal(err)
+	}
+	// Renewals start one, two and three months after the redemption. The one starting two months after is not less than
+	// two months after, so only the first renewal is discounted.
+	start := e.Clock.Now()
+	renewAt(t, e, start.AddDate(0, 1, 0))
+	renewAt(t, e, start.AddDate(0, 2, 0))
+	renewAt(t, e, start.AddDate(0, 3, 0))
+	amounts, _ := discounts(e, sub)
+	if len(amounts) != 4 || amounts[0] != 0 || amounts[1] != 1000 || amounts[2] != 0 || amounts[3] != 0 {
+		t.Fatalf("discounts = %v", amounts)
+	}
+}
+
+func TestCouponDoesNotDiscountInvoicesCreatedBeforeIt(t *testing.T) {
+	e, sub := couponSub(t, 0)
+	addCoupon(t, e, store.Coupon{Code: "FOREVER", PercentOff: 10, Duration: store.DurationForever})
+	// applied at the same instant the first invoice was created: that invoice is not created after the coupon
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "FOREVER"); err != nil {
+		t.Fatal(err)
+	}
+	if amounts, _ := discounts(e, sub); len(amounts) != 1 || amounts[0] != 0 {
+		t.Fatalf("discounts = %v", amounts)
+	}
+}
+
+func TestCouponReplacesTheSubscriptionsDiscountPercent(t *testing.T) {
+	e, sub := couponSub(t, 10)
+	addCoupon(t, e, store.Coupon{Code: "FIVEOFF", AmountOff: 500, Currency: money.USD, Duration: store.DurationForever})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "FIVEOFF"); err != nil {
+		t.Fatal(err)
+	}
+	renewAt(t, e, sub.CurrentPeriodEnd)
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	last := invs[len(invs)-1]
+	if last.DiscountPercent != 0 || billing.Compute(last).Discount != 500 {
+		t.Fatalf("the invoice = %+v, want only the coupon's 5.00 off", last)
+	}
+}
