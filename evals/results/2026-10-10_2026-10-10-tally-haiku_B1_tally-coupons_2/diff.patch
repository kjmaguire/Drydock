diff --git a/result/internal/store/coupons.go b/result/internal/store/coupons.go
new file mode 100644
index 0000000..8385745
--- /dev/null
+++ b/result/internal/store/coupons.go
@@ -0,0 +1,167 @@
+package store
+
+import (
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+var couponCodeRe = regexp.MustCompile(`^[A-Za-z0-9_-]{3,32}$`)
+
+// ---- coupons
+
+// CreateCoupon adds a coupon to an organization. Its code must be unique in the organization, ignoring case.
+func (s *Store) CreateCoupon(c Coupon, now time.Time) (Coupon, error) {
+	c.Code = strings.TrimSpace(c.Code)
+	if err := checkCoupon(c); err != nil {
+		return Coupon{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[c.OrgID]; !ok {
+		return Coupon{}, ErrNotFound
+	}
+	if _, ok := s.couponsByKey[couponKey(c.OrgID, c.Code)]; ok {
+		return Coupon{}, ErrCouponCodeTaken
+	}
+	c.ID = s.newID("cpn")
+	c.CreatedAt = now.UTC()
+	if c.RedeemBy != nil {
+		t := c.RedeemBy.UTC()
+		c.RedeemBy = &t
+	}
+	s.coupons[c.ID] = copyCoupon(c)
+	s.couponsByKey[couponKey(c.OrgID, c.Code)] = c.ID
+	return copyCoupon(c), nil
+}
+
+func checkCoupon(c Coupon) error {
+	switch {
+	case !couponCodeRe.MatchString(c.Code):
+		return invalid("a coupon code is 3 to 32 letters, digits, dashes or underscores")
+	case (c.PercentOff != 0) == (c.AmountOff != 0):
+		return invalid("a coupon takes exactly one of percent_off and amount_off")
+	case c.PercentOff != 0 && (c.PercentOff < 1 || c.PercentOff > 100):
+		return invalid("percent_off is 1 to 100")
+	case c.AmountOff != 0 && (c.AmountOff < 0 || !c.Currency.Valid()):
+		return invalid("amount_off is a positive amount in a currency Tally bills in")
+	case c.PercentOff != 0 && c.Currency != "":
+		return invalid("a percentage coupon has no currency")
+	}
+	switch c.Duration {
+	case DurationOnce, DurationForever:
+		if c.DurationInMonths != 0 {
+			return invalid("duration_in_months is only for a repeating coupon")
+		}
+	case DurationRepeating:
+		if c.DurationInMonths < 1 || c.DurationInMonths > 36 {
+			return invalid("a repeating coupon lasts 1 to 36 months")
+		}
+	default:
+		return invalid("a coupon's duration is once, repeating or forever")
+	}
+	if c.MaxRedemptions < 0 {
+		return invalid("max_redemptions is at least 1")
+	}
+	return nil
+}
+
+func couponKey(orgID, code string) string { return orgID + "\x00" + strings.ToLower(code) }
+
+// couponByCode finds a coupon by code, ignoring case. The caller holds the lock.
+func (s *Store) couponByCode(orgID, code string) (Coupon, bool) {
+	id, ok := s.couponsByKey[couponKey(orgID, code)]
+	if !ok {
+		return Coupon{}, false
+	}
+	return copyCoupon(s.coupons[id]), true
+}
+
+// Coupon returns one of an organization's coupons, found by code ignoring case.
+func (s *Store) Coupon(orgID, code string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.couponByCode(orgID, code)
+}
+
+// Coupons returns an organization's coupons, oldest first.
+func (s *Store) Coupons(orgID string) []Coupon {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Coupon{}
+	for _, c := range s.coupons {
+		if c.OrgID == orgID {
+			out = append(out, copyCoupon(c))
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// CouponRedemptions counts the subscriptions of an organization that hold a coupon, canceled ones included.
+func (s *Store) CouponRedemptions(orgID, code string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.redemptions(orgID, code)
+}
+
+// redemptions counts the subscriptions holding a coupon. The caller holds the lock.
+func (s *Store) redemptions(orgID, code string) int {
+	n := 0
+	for _, sub := range s.subs {
+		if sub.OrgID == orgID && sub.Coupon == code {
+			n++
+		}
+	}
+	return n
+}
+
+// RedeemCoupon applies the coupon with this code to a subscription at now. It refuses when the coupon is unknown, has
+// passed its redeem-by time, has no redemptions left, is in another currency than the subscription's plan, when the
+// subscription already has a coupon, or when it is canceled. The checks and the change happen under one lock, so
+// concurrent redemptions cannot exceed max_redemptions.
+func (s *Store) RedeemCoupon(orgID, subID, code string, now time.Time) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.couponByCode(orgID, code)
+	if !ok {
+		return Subscription{}, ErrNoCoupon
+	}
+	sub, ok := s.subs[subID]
+	if !ok || sub.OrgID != orgID {
+		return Subscription{}, ErrNotFound
+	}
+	if c.RedeemBy != nil && now.After(*c.RedeemBy) {
+		return Subscription{}, ErrCouponExpired
+	}
+	if c.MaxRedemptions > 0 && s.redemptions(orgID, c.Code) >= c.MaxRedemptions {
+		return Subscription{}, ErrCouponExhausted
+	}
+	if c.Currency != "" && s.plans[sub.PlanID].Currency != c.Currency {
+		return Subscription{}, ErrCurrencyMismatch
+	}
+	if sub.Coupon != "" {
+		return Subscription{}, ErrCouponApplied
+	}
+	if sub.Status == Canceled {
+		return Subscription{}, ErrSubscriptionCanceled
+	}
+	t := now.UTC()
+	sub.Coupon, sub.CouponRedeemedAt = c.Code, &t
+	s.subs[subID] = sub
+	return copySub(sub), nil
+}
+
+func copyCoupon(c Coupon) Coupon {
+	if c.RedeemBy != nil {
+		t := *c.RedeemBy
+		c.RedeemBy = &t
+	}
+	return c
+}
