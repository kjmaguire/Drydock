diff --git a/result/internal/api/coupons.go b/result/internal/api/coupons.go
new file mode 100644
index 0000000..48afb57
--- /dev/null
+++ b/result/internal/api/coupons.go
@@ -0,0 +1,149 @@
+package api
+
+import (
+	"errors"
+	"net/http"
+	"strings"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+// couponView is a coupon as the API shows it: with how many subscriptions hold it.
+type couponView struct {
+	store.Coupon
+	TimesRedeemed int `json:"times_redeemed"`
+}
+
+func (s *Server) viewCoupon(c store.Coupon) couponView {
+	return couponView{Coupon: c, TimesRedeemed: s.store.CouponRedemptions(c.OrgID, c.Code)}
+}
+
+func couponViewKey(v couponView) cursor { return cursor{T: v.CreatedAt, ID: v.ID} }
+
+// listCoupons lists the organization's coupons, oldest first.
+func (s *Server) listCoupons(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	coupons := s.store.Coupons(p.OrgID)
+	views := make([]couponView, 0, len(coupons))
+	for _, c := range coupons {
+		views = append(views, s.viewCoupon(c))
+	}
+	items, next := pageOf(views, couponViewKey, pg)
+	writeJSON(w, http.StatusOK, list{Items: items, NextCursor: next})
+}
+
+// createCoupon takes a percentage ("percent_off") or an amount ("amount_off", in major units as a string, with "currency"),
+// a "duration" (once, repeating or forever), "duration_in_months" for a repeating coupon, and optionally "max_redemptions"
+// and "redeem_by" (RFC 3339).
+func (s *Server) createCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in struct {
+		Code             string               `json:"code"`
+		PercentOff       int                  `json:"percent_off"`
+		AmountOff        *string              `json:"amount_off"`
+		Currency         money.Currency       `json:"currency"`
+		Duration         store.CouponDuration `json:"duration"`
+		DurationInMonths *int                 `json:"duration_in_months"`
+		MaxRedemptions   *int                 `json:"max_redemptions"`
+		RedeemBy         *string              `json:"redeem_by"`
+	}
+	if !decode(w, r, &in) {
+		return
+	}
+	c := store.Coupon{OrgID: p.OrgID, Code: in.Code, PercentOff: in.PercentOff, Currency: in.Currency, Duration: in.Duration}
+	if in.AmountOff != nil {
+		amount, err := money.ParseMajor(*in.AmountOff, in.Currency)
+		if err != nil || amount <= 0 {
+			writeError(w, http.StatusUnprocessableEntity, "invalid", "amount_off is a positive amount in major units, such as \"12.50\", with a currency")
+			return
+		}
+		c.AmountOff = amount
+	}
+	if in.DurationInMonths != nil {
+		if in.Duration != store.DurationRepeating {
+			writeError(w, http.StatusUnprocessableEntity, "invalid", "duration_in_months is only for a repeating coupon")
+			return
+		}
+		c.DurationInMonths = *in.DurationInMonths
+	}
+	if in.MaxRedemptions != nil {
+		if *in.MaxRedemptions < 1 {
+			writeError(w, http.StatusUnprocessableEntity, "invalid", "max_redemptions is at least 1")
+			return
+		}
+		c.MaxRedemptions = *in.MaxRedemptions
+	}
+	if in.RedeemBy != nil {
+		t, err := time.Parse(time.RFC3339, *in.RedeemBy)
+		if err != nil {
+			writeError(w, http.StatusUnprocessableEntity, "invalid", "redeem_by is an RFC 3339 time")
+			return
+		}
+		c.RedeemBy = &t
+	}
+	coupon, err := s.store.CreateCoupon(c, s.clock.Now())
+	if errors.Is(err, store.ErrCouponCodeTaken) {
+		writeError(w, http.StatusConflict, "code_taken", err.Error())
+		return
+	}
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusCreated, s.viewCoupon(coupon))
+}
+
+// getCoupon finds one of the organization's coupons by its code, ignoring case.
+func (s *Server) getCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	c, ok := s.store.Coupon(p.OrgID, r.PathValue("code"))
+	if !ok {
+		writeError(w, http.StatusNotFound, "not_found", "no such coupon")
+		return
+	}
+	writeJSON(w, http.StatusOK, s.viewCoupon(c))
+}
+
+// couponError answers for a refused coupon redemption.
+func (s *Server) couponError(w http.ResponseWriter, err error) {
+	switch {
+	case errors.Is(err, store.ErrNoCoupon):
+		writeError(w, http.StatusNotFound, "not_found", "no such coupon")
+	case errors.Is(err, store.ErrCouponExpired):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_expired", err.Error())
+	case errors.Is(err, store.ErrCouponExhausted):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_exhausted", err.Error())
+	case errors.Is(err, store.ErrCurrencyMismatch):
+		writeError(w, http.StatusUnprocessableEntity, "currency_mismatch", err.Error())
+	case errors.Is(err, store.ErrCouponApplied):
+		writeError(w, http.StatusConflict, "coupon_already_applied", err.Error())
+	case errors.Is(err, store.ErrSubscriptionCanceled):
+		writeError(w, http.StatusConflict, "subscription_canceled", err.Error())
+	default:
+		s.subError(w, err)
+	}
+}
+
+// applyCoupon applies a coupon to a subscription: {"code": "..."}.
+func (s *Server) applyCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in struct {
+		Code string `json:"code"`
+	}
+	if !decode(w, r, &in) {
+		return
+	}
+	if strings.TrimSpace(in.Code) == "" {
+		writeError(w, http.StatusUnprocessableEntity, "invalid", "a coupon code is required")
+		return
+	}
+	sub, err := s.subs.ApplyCoupon(r.Context(), p.OrgID, r.PathValue("id"), in.Code)
+	if err != nil {
+		s.couponError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusOK, sub)
+}
diff --git a/result/internal/api/coupons_test.go b/result/internal/api/coupons_test.go
new file mode 100644
index 0000000..ba69b3c
--- /dev/null
+++ b/result/internal/api/coupons_test.go
@@ -0,0 +1,222 @@
+package api_test
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// apiSub starts a subscription for a new customer with this email, to a 20.00 USD monthly plan through the API.
+func apiSub(t *testing.T, e *apitest.Env, email string) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", email)
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": p.ID}, &sub)
+	return sub
+}
+
+func TestCreateCoupon(t *testing.T) {
+	e := apitest.New(t)
+	r := e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "SPRING15", "percent_off": 15, "duration": "once"})
+	if r.Code != http.StatusCreated {
+		t.Fatalf("percent coupon: %s", r)
+	}
+	m := r.Map(t)
+	if m["code"] != "SPRING15" || m["percent_off"] != float64(15) || m["duration"] != "once" || m["times_redeemed"] != float64(0) ||
+		!strings.HasPrefix(m["id"].(string), "cpn_") {
+		t.Fatalf("coupon = %v", m)
+	}
+	if _, ok := m["amount_off"]; ok {
+		t.Fatalf("a percentage coupon shows an amount: %v", m)
+	}
+
+	r = e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "TENEUR", "amount_off": "10.50", "currency": "EUR",
+		"duration": "repeating", "duration_in_months": 3, "max_redemptions": 2, "redeem_by": "2026-06-30T00:00:00Z"})
+	if r.Code != http.StatusCreated {
+		t.Fatalf("amount coupon: %s", r)
+	}
+	m = r.Map(t)
+	if m["amount_off"] != float64(1050) || m["currency"] != "EUR" || m["duration_in_months"] != float64(3) || m["max_redemptions"] != float64(2) ||
+		m["redeem_by"] != "2026-06-30T00:00:00Z" {
+		t.Fatalf("amount coupon = %v", m)
+	}
+}
+
+func TestCreateCouponRefusals(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "TAKEN1", "percent_off": 5, "duration": "forever"}, nil)
+
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "taken1", "percent_off": 5, "duration": "forever"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "code_taken" {
+		t.Fatalf("a taken code: %s", r)
+	}
+	// the code is only unique within an organization
+	if r := e.Do("POST", "/v1/coupons", e.Globex.Key, map[string]any{"code": "taken1", "percent_off": 5, "duration": "forever"}); r.Code != http.StatusCreated {
+		t.Fatalf("another organization's code: %s", r)
+	}
+	bodies := map[string]map[string]any{
+		"code too short":           {"code": "AB", "percent_off": 5, "duration": "once"},
+		"code with a space":        {"code": "A B C", "percent_off": 5, "duration": "once"},
+		"no discount":              {"code": "NODISC", "duration": "once"},
+		"percent and amount":       {"code": "BOTHOF", "percent_off": 5, "amount_off": "1.00", "currency": "USD", "duration": "once"},
+		"percent over 100":         {"code": "OVER100", "percent_off": 101, "duration": "once"},
+		"amount without currency":  {"code": "NOCUR1", "amount_off": "1.00", "duration": "once"},
+		"amount of zero":           {"code": "ZEROAM", "amount_off": "0", "currency": "USD", "duration": "once"},
+		"amount not a number":      {"code": "BADAMT", "amount_off": "ten", "currency": "USD", "duration": "once"},
+		"amount with a percent":    {"code": "MIXED1", "percent_off": 5, "amount_off": "0", "currency": "USD", "duration": "once"},
+		"unknown duration":         {"code": "WHEN01", "percent_off": 5, "duration": "yearly"},
+		"repeating without months": {"code": "REPEAT", "percent_off": 5, "duration": "repeating"},
+		"months over 36":           {"code": "LONGER", "percent_off": 5, "duration": "repeating", "duration_in_months": 37},
+		"months on once":           {"code": "ONCE00", "percent_off": 5, "duration": "once", "duration_in_months": 2},
+		"max redemptions of zero":  {"code": "MAXZER", "percent_off": 5, "duration": "once", "max_redemptions": 0},
+		"redeem by not a time":     {"code": "LATER1", "percent_off": 5, "duration": "once", "redeem_by": "tomorrow"},
+	}
+	for name, body := range bodies {
+		r := e.Do("POST", "/v1/coupons", e.Acme.Key, body)
+		if r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid" {
+			t.Errorf("%s: %s", name, r)
+		}
+	}
+}
+
+func TestCouponsListAndGet(t *testing.T) {
+	e := apitest.New(t)
+	for _, code := range []string{"FIRST01", "SECOND2", "THIRD03"} {
+		e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": code, "percent_off": 5, "duration": "forever"}, nil)
+		e.Clock.Advance(time.Minute)
+	}
+	type couponPage struct {
+		Items      []struct{ Code string } `json:"items"`
+		NextCursor string                  `json:"next_cursor"`
+	}
+	var first, second couponPage
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons?limit=2", e.Acme.Key, nil, &first)
+	if len(first.Items) != 2 || first.Items[0].Code != "FIRST01" || first.Items[1].Code != "SECOND2" || first.NextCursor == "" {
+		t.Fatalf("first page = %+v", first)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons?limit=2&cursor="+first.NextCursor, e.Acme.Key, nil, &second)
+	if len(second.Items) != 1 || second.Items[0].Code != "THIRD03" || second.NextCursor != "" {
+		t.Fatalf("second page = %+v", second)
+	}
+
+	var c map[string]any
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/second2", e.Acme.Key, nil, &c)
+	if c["code"] != "SECOND2" {
+		t.Fatalf("GET by code, ignoring case: %v", c)
+	}
+	if r := e.Do("GET", "/v1/coupons/NOPE01", e.Acme.Key, nil); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("unknown code: %s", r)
+	}
+	if r := e.Do("GET", "/v1/coupons/FIRST01", e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("another organization's coupon: %s", r)
+	}
+}
+
+func TestApplyCoupon(t *testing.T) {
+	e := apitest.New(t)
+	sub := apiSub(t, e, "jane@example.com")
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "SPRING15", "percent_off": 15, "duration": "forever"}, nil)
+
+	var got store.Subscription
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "spring15"}, &got)
+	if got.Coupon != "SPRING15" || got.CouponRedeemedAt == nil || !got.CouponRedeemedAt.Equal(e.Clock.Now()) {
+		t.Fatalf("subscription = %+v", got)
+	}
+	var shown map[string]any
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions/"+sub.ID, e.Acme.Key, nil, &shown)
+	if shown["coupon"] != "SPRING15" {
+		t.Fatalf("GET subscription: %v", shown)
+	}
+	var coupon map[string]any
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/SPRING15", e.Acme.Key, nil, &coupon)
+	if coupon["times_redeemed"] != float64(1) {
+		t.Fatalf("times_redeemed = %v", coupon["times_redeemed"])
+	}
+
+	if r := e.Do("POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "SPRING15"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "coupon_already_applied" {
+		t.Fatalf("a second coupon: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "  "}); r.Code != http.StatusUnprocessableEntity {
+		t.Fatalf("an empty code: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "NOPE01"}); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("unknown coupon: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions/sub_999999/coupon", e.Acme.Key, map[string]string{"code": "SPRING15"}); r.Code != http.StatusNotFound {
+		t.Fatalf("unknown subscription: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Globex.Key, map[string]string{"code": "SPRING15"}); r.Code != http.StatusNotFound {
+		t.Fatalf("another organization's subscription: %s", r)
+	}
+}
+
+func TestApplyCouponRefusals(t *testing.T) {
+	e := apitest.New(t)
+	apply := func(sub store.Subscription, code string) *apitest.Response {
+		return e.Do("POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": code})
+	}
+	expired := e.Clock.Now().Add(24 * time.Hour).Format(time.RFC3339)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "EXPIRES", "percent_off": 5, "duration": "once", "redeem_by": expired}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "ONEONLY", "percent_off": 5, "duration": "once", "max_redemptions": 1}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "EUROFF", "amount_off": "5.00", "currency": "EUR", "duration": "once"}, nil)
+
+	first := apiSub(t, e, "first@example.com")
+	second := apiSub(t, e, "second@example.com")
+	third := apiSub(t, e, "third@example.com")
+	if r := apply(first, "ONEONLY"); r.Code != http.StatusOK {
+		t.Fatalf("the first redemption: %s", r)
+	}
+	if r := apply(second, "ONEONLY"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_exhausted" {
+		t.Fatalf("exhausted: %s", r)
+	}
+	if r := apply(first, "EXPIRES"); r.Code != http.StatusConflict || r.Map(t)["error"] != "coupon_already_applied" {
+		t.Fatalf("already applied: %s", r)
+	}
+	if r := apply(second, "EUROFF"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "currency_mismatch" {
+		t.Fatalf("currency: %s", r)
+	}
+	if r := apply(third, "EXPIRES"); r.Code != http.StatusOK {
+		t.Fatalf("before redeem-by: %s", r)
+	}
+	e.Clock.Advance(48 * time.Hour)
+	if r := apply(second, "EXPIRES"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_expired" {
+		t.Fatalf("after redeem-by: %s", r)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+second.ID+"/cancel", e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "CANCEL1", "percent_off": 5, "duration": "forever"}, nil)
+	if r := apply(second, "CANCEL1"); r.Code != http.StatusConflict || r.Map(t)["error"] != "subscription_canceled" {
+		t.Fatalf("canceled: %s", r)
+	}
+}
+
+func TestCouponDiscountsTheInvoicesAfterIt(t *testing.T) {
+	e := apitest.New(t)
+	sub := apiSub(t, e, "jane@example.com")
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "SPRING15", "percent_off": 15, "duration": "forever"}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "SPRING15"}, nil)
+
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	var invs struct {
+		Items []map[string]any `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 2 {
+		t.Fatalf("invoices = %v", invs.Items)
+	}
+	first, renewal := invs.Items[0], invs.Items[1]
+	if first["coupon"] != "" || first["discount"] != float64(0) || first["total"] != float64(2000) {
+		t.Fatalf("the first invoice = %v", first)
+	}
+	// 15% of 20.00 is 3.00 off
+	if renewal["coupon"] != "SPRING15" || renewal["discount"] != float64(300) || renewal["total"] != float64(1700) || renewal["discount_percent"] != float64(0) {
+		t.Fatalf("the renewal = %v", renewal)
+	}
+}
