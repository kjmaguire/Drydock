+package store
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+// couponFixture is an organization with a customer, a USD plan and a EUR plan, and a subscription on the USD plan.
+type couponFixture struct {
+	s          *Store
+	org, other Org
+	customer   Customer
+	usd, eur   Plan
+	sub        Subscription
+}
+
+func newCouponFixture(t *testing.T) couponFixture {
+	t.Helper()
+	s := New()
+	f := couponFixture{s: s}
+	f.org = newOrg(t, s, "Acme")
+	f.other = newOrg(t, s, "Globex")
+	c, err := s.CreateCustomer(f.org.ID, "Jane", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.customer = c
+	f.usd = mustPlan(t, s, f.org.ID, money.USD)
+	f.eur = mustPlan(t, s, f.org.ID, money.EUR)
+	f.sub = mustSub(t, s, f.org.ID, c.ID, f.usd.ID)
+	return f
+}
+
+func mustPlan(t *testing.T, s *Store, orgID string, cur money.Currency) Plan {
+	t.Helper()
+	p, err := s.CreatePlan(Plan{OrgID: orgID, Name: "Team " + string(cur), Currency: cur, UnitAmount: 1000, Interval: Monthly}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func mustSub(t *testing.T, s *Store, orgID, customerID, planID string) Subscription {
+	t.Helper()
+	sub, err := s.CreateSubscription(Subscription{OrgID: orgID, CustomerID: customerID, PlanID: planID, Quantity: 1, Status: Active,
+		CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+func TestCreateCouponValidation(t *testing.T) {
+	f := newCouponFixture(t)
+	valid := func() Coupon {
+		return Coupon{OrgID: f.org.ID, Code: "SPRING15", PercentOff: 15, Duration: DurationOnce}
+	}
+	cases := map[string]func(c *Coupon){
+		"code too short":           func(c *Coupon) { c.Code = "AB" },
+		"code too long":            func(c *Coupon) { c.Code = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456" },
+		"code with a space":        func(c *Coupon) { c.Code = "SPRING 15" },
+		"code with a dot":          func(c *Coupon) { c.Code = "SPRING.15" },
+		"no discount":              func(c *Coupon) { c.PercentOff = 0 },
+		"percent and amount":       func(c *Coupon) { c.AmountOff, c.Currency = 100, money.USD },
+		"percent over 100":         func(c *Coupon) { c.PercentOff = 101 },
+		"negative percent":         func(c *Coupon) { c.PercentOff = -5 },
+		"amount without currency":  func(c *Coupon) { c.PercentOff, c.AmountOff = 0, 100 },
+		"currency on a percentage": func(c *Coupon) { c.Currency = money.USD },
+		"unknown duration":         func(c *Coupon) { c.Duration = "yearly" },
+		"repeating without months": func(c *Coupon) { c.Duration = DurationRepeating },
+		"months over 36":           func(c *Coupon) { c.Duration, c.DurationInMonths = DurationRepeating, 37 },
+		"months on once":           func(c *Coupon) { c.DurationInMonths = 3 },
+		"negative max":             func(c *Coupon) { c.MaxRedemptions = -1 },
+	}
+	for name, mutate := range cases {
+		c := valid()
+		mutate(&c)
+		if _, err := f.s.CreateCoupon(c, t0); !errors.Is(err, ErrInvalid) {
+			t.Errorf("%s: err = %v, want ErrInvalid", name, err)
+		}
+	}
+	amount := Coupon{OrgID: f.org.ID, Code: "TENOFF", AmountOff: 1000, Currency: money.EUR, Duration: DurationForever}
+	if _, err := f.s.CreateCoupon(amount, t0); err != nil {
+		t.Fatalf("a valid amount coupon: %v", err)
+	}
+	if _, err := f.s.CreateCoupon(Coupon{OrgID: f.org.ID, Code: "MORE_2-OK", PercentOff: 100, Duration: DurationOnce}, t0); err != nil {
+		t.Fatalf("a valid coupon with dashes and underscores: %v", err)
+	}
+}
+
+func TestCouponCodesAreUniqueIgnoringCase(t *testing.T) {
+	f := newCouponFixture(t)
+	c, err := f.s.CreateCoupon(Coupon{OrgID: f.org.ID, Code: "Spring15", PercentOff: 15, Duration: DurationOnce}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := f.s.CreateCoupon(Coupon{OrgID: f.org.ID, Code: "SPRING15", PercentOff: 5, Duration: DurationOnce}, t0); !errors.Is(err, ErrCouponCodeTaken) {
+		t.Fatalf("a code differing in case: err = %v", err)
+	}
+	if _, err := f.s.CreateCoupon(Coupon{OrgID: f.other.ID, Code: "spring15", PercentOff: 5, Duration: DurationOnce}, t0); err != nil {
+		t.Fatalf("another organization may use the code: %v", err)
+	}
+	got, ok := f.s.Coupon(f.org.ID, "sPrInG15")
+	if !ok || got.ID != c.ID || got.Code != "Spring15" {
+		t.Fatalf("Coupon = %+v, %v", got, ok)
+	}
+	if _, ok := f.s.Coupon(f.other.ID, "Spring15"); !ok {
+		t.Fatal("the other organization's coupon is missing")
+	}
+	if _, ok := f.s.Coupon(f.org.ID, "NOPE1"); ok {
+		t.Fatal("found a coupon that does not exist")
+	}
+}
+
+func TestCouponsAreListedOldestFirst(t *testing.T) {
+	f := newCouponFixture(t)
+	for i, code := range []string{"BBB111", "AAA111", "CCC111"} {
+		if _, err := f.s.CreateCoupon(Coupon{OrgID: f.org.ID, Code: code, PercentOff: 1, Duration: DurationOnce}, t0.Add(time.Duration(i)*time.Hour)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var codes []string
+	for _, c := range f.s.Coupons(f.org.ID) {
+		codes = append(codes, c.Code)
+	}
+	if !reflect.DeepEqual(codes, []string{"BBB111", "AAA111", "CCC111"}) {
+		t.Fatalf("codes = %v", codes)
+	}
+	if got := f.s.Coupons(f.other.ID); len(got) != 0 {
+		t.Fatalf("another organization's coupons: %+v", got)
+	}
+}
+
+func TestRedeemCoupon(t *testing.T) {
+	f := newCouponFixture(t)
+	now := t0.Add(time.Hour)
+	if _, err := f.s.CreateCoupon(Coupon{OrgID: f.org.ID, Code: "SPRING15", PercentOff: 15, Duration: DurationForever}, t0); err != nil {
+		t.Fatal(err)
+	}
+	sub, err := f.s.RedeemCoupon(f.org.ID, f.sub.ID, "spring15", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sub.Coupon != "SPRING15" || sub.CouponRedeemedAt == nil || !sub.CouponRedeemedAt.Equal(now) {
+		t.Fatalf("subscription = %+v", sub)
+	}
+	if got, _ := f.s.Subscription(f.org.ID, f.sub.ID); got.Coupon != "SPRING15" {
+		t.Fatalf("the change was not stored: %+v", got)
+	}
+	if _, err := f.s.RedeemCoupon(f.org.ID, f.sub.ID, "SPRING15", now); !errors.Is(err, ErrCouponApplied) {
+		t.Fatalf("a second coupon: err = %v", err)
+	}
+}
+
+func TestRedeemCouponRefusals(t *testing.T) {
+	f := newCouponFixture(t)
+	redeemBy := t0.Add(24 * time.Hour)
+	mustCoupon := func(c Coupon) {
+		t.Helper()
+		c.OrgID = f.org.ID
+		if _, err := f.s.CreateCoupon(c, t0); err != nil {
+			t.Fatal(err)
+		}
+	}
+	mustCoupon(Coupon{Code: "LATE", PercentOff: 10, Duration: DurationOnce, RedeemBy: &redeemBy})
+	mustCoupon(Coupon{Code: "ONCE", PercentOff: 10, Duration: DurationOnce, MaxRedemptions: 1})
+	mustCoupon(Coupon{Code: "EURAMOUNT", AmountOff: 100, Currency: money.EUR, Duration: DurationOnce})
+
+	// the coupon ONCE takes the only redemption
+	other := mustSub(t, f.s, f.org.ID, f.customer.ID, f.usd.ID)
+	if _, err := f.s.RedeemCoupon(f.org.ID, other.ID, "ONCE", t0); err != nil {
+		t.Fatal(err)
+	}
+
+	cases := []struct {
+		name  string
+		sub   string
+		code  string
+		now   time.Time
+		want  error
+		setup func()
+	}{
+		{"unknown code", f.sub.ID, "NOPE1", t0, ErrNoCoupon, nil},
+		{"unknown subscription", "sub_999999", "LATE", t0, ErrNotFound, nil},
+		{"after redeem-by", f.sub.ID, "LATE", redeemBy.Add(time.Second), ErrCouponExpired, nil},
+		{"exhausted", f.sub.ID, "ONCE", t0, ErrCouponExhausted, nil},
+		{"currency", f.sub.ID, "EURAMOUNT", t0, ErrCurrencyMismatch, nil},
+		{"canceled", f.sub.ID, "LATE", t0, ErrSubscriptionCanceled, func() {
+			_, _ = f.s.UpdateSubscription(f.org.ID, f.sub.ID, func(s *Subscription) error { s.Status = Canceled; return nil })
+		}},
+	}
+	for _, c := range cases {
+		if c.setup != nil {
+			c.setup()
+		}
+		if _, err := f.s.RedeemCoupon(f.org.ID, c.sub, c.code, c.now); !errors.Is(err, c.want) {
+			t.Errorf("%s: err = %v, want %v", c.name, err, c.want)
+		}
+	}
+	if n := f.s.CouponRedemptions(f.org.ID, "ONCE"); n != 1 {
+		t.Fatalf("ONCE is held by %d subscriptions", n)
+	}
+	if got, _ := f.s.Subscription(f.org.ID, f.sub.ID); got.Coupon != "" {
+		t.Fatalf("a refused redemption changed the subscription: %+v", got)
+	}
+}
+
+func TestRedeemCouponOnTheRedeemByTimeStillWorks(t *testing.T) {
+	f := newCouponFixture(t)
+	redeemBy := t0.Add(time.Hour)
+	if _, err := f.s.CreateCoupon(Coupon{OrgID: f.org.ID, Code: "LATEST", PercentOff: 10, Duration: DurationOnce, RedeemBy: &redeemBy}, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := f.s.RedeemCoupon(f.org.ID, f.sub.ID, "LATEST", redeemBy); err != nil {
+		t.Fatalf("at the redeem-by time: %v", err)
+	}
+}
+
+func TestCouponStateRoundTrip(t *testing.T) {
+	f := newCouponFixture(t)
+	redeemBy := t0.Add(48 * time.Hour)
+	if _, err := f.s.CreateCoupon(Coupon{OrgID: f.org.ID, Code: "SAVE20", PercentOff: 20, Duration: DurationRepeating, DurationInMonths: 3,
+		MaxRedemptions: 5, RedeemBy: &redeemBy}, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := f.s.RedeemCoupon(f.org.ID, f.sub.ID, "SAVE20", t0.Add(time.Minute)); err != nil {
+		t.Fatal(err)
+	}
+	st := f.s.Export()
+	back, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(back.Export(), st) {
+		t.Fatal("the coupons did not survive a round trip")
+	}
+	if _, ok := back.Coupon(f.org.ID, "save20"); !ok {
+		t.Fatal("the code index was not rebuilt")
+	}
+	if _, err := back.CreateCoupon(Coupon{OrgID: f.org.ID, Code: "Save20", PercentOff: 1, Duration: DurationOnce}, t0); !errors.Is(err, ErrCouponCodeTaken) {
+		t.Fatalf("a restored code is not taken: %v", err)
+	}
+}
