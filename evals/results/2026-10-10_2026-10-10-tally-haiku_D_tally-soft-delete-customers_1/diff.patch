+// SoftDeleteCustomer marks a customer deleted at now. It is then hidden as if it did not exist, and its email address is free
+// again. Its invoices and payments stay. A customer with a subscription that is not canceled cannot be deleted.
+func (s *Store) SoftDeleteCustomer(orgID, id string, now time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt != nil {
+		return ErrNotFound
+	}
+	for _, sub := range s.subs {
+		if sub.CustomerID == id && sub.Status != Canceled {
+			return ErrHasActiveSubscriptions
+		}
+	}
+	t := now.UTC()
+	c.DeletedAt = &t
+	s.customers[id] = c
+	if s.customersByEmail[normEmail(c.Email)] == id {
+		delete(s.customersByEmail, normEmail(c.Email))
+	}
+	return nil
+}
+
+// RestoreCustomer undoes a deletion made within the last 30 days before now. A customer that is not deleted, or was deleted
+// longer ago, is ErrNotFound. When another of the organization's customers now uses its email address, it is ErrEmailTaken.
+func (s *Store) RestoreCustomer(orgID, id string, now time.Time) (Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt == nil || c.DeletedAt.Before(now.Add(-customerRetention)) {
+		return Customer{}, ErrNotFound
+	}
+	for otherID, other := range s.customers {
+		if otherID != id && other.OrgID == orgID && other.DeletedAt == nil && normEmail(other.Email) == normEmail(c.Email) {
+			return Customer{}, ErrEmailTaken
+		}
+	}
+	c.DeletedAt = nil
+	s.customers[id] = c
+	s.customersByEmail[normEmail(c.Email)] = id
+	return copyCustomer(c), nil
+}
+
+// PurgeDeletedCustomers removes, for good, the customers deleted more than 30 days before now. It returns how many it removed.
+// Their invoices and payments stay, and the invoices show no customer.
+func (s *Store) PurgeDeletedCustomers(now time.Time) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	cutoff := now.Add(-customerRetention)
+	n := 0
+	for id, c := range s.customers {
+		if c.DeletedAt != nil && c.DeletedAt.Before(cutoff) {
+			delete(s.customers, id)
+			n++
+		}
+	}
+	return n
+}
