+func TestSoftDeleteAndRestoreCustomer(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	jane, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	if err := s.SoftDeleteCustomer(b.ID, jane.ID, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("another org's customer: %v", err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, t0.Add(time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.Customer(a.ID, jane.ID); ok {
+		t.Fatal("deleted customer is visible")
+	}
+	if got, ok := s.CustomerWithDeleted(a.ID, jane.ID); !ok || got.DeletedAt == nil || !got.DeletedAt.Equal(t0.Add(time.Hour)) {
+		t.Fatalf("CustomerWithDeleted = %+v, %v", got, ok)
+	}
+	if got := s.Customers(a.ID); len(got) != 0 {
+		t.Fatalf("Customers lists the deleted customer: %+v", got)
+	}
+	if got := s.SearchCustomers(a.ID, "jane"); len(got) != 0 {
+		t.Fatalf("SearchCustomers lists the deleted customer: %+v", got)
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "JANE@example.com"); ok {
+		t.Fatal("deleted customer found by email")
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleting twice: %v", err)
+	}
+	if _, err := s.UpdateCustomer(a.ID, jane.ID, func(c *Customer) error { c.Name = "X"; return nil }); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("updating a deleted customer: %v", err)
+	}
+	// The address is free again; restoring then conflicts until the other customer is deleted.
+	jane2, err := s.CreateCustomer(a.ID, "Jane 2", "jane@example.com", t0)
+	if err != nil {
+		t.Fatalf("the address of a deleted customer is not free: %v", err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, jane.ID, t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("restore with the address in use: %v", err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane2.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := s.RestoreCustomer(a.ID, jane.ID, t0.Add(2*time.Hour))
+	if err != nil || restored.DeletedAt != nil {
+		t.Fatalf("RestoreCustomer = %+v, %v", restored, err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != jane.ID {
+		t.Fatalf("restored customer not found by email: %+v, %v", got, ok)
+	}
+
+	// The state survives a round trip, and a deleted customer's address is not taken on load.
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s2.CustomerWithDeleted(a.ID, jane.ID); !ok || got.DeletedAt == nil {
+		t.Fatalf("deleted customer lost in a round trip: %+v, %v", got, ok)
+	}
+	if _, err := s2.CreateCustomer(a.ID, "Jane 3", "jane@example.com", t0); err != nil {
+		t.Fatalf("a deleted customer's address is taken after a round trip: %v", err)
+	}
+}
