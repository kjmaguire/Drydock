+func TestRestoreWindowAndPurge(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	jane, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	john, _ := s.CreateCustomer(a.ID, "John", "john@example.com", t0)
+	day := func(n int) time.Time { return t0.Add(time.Duration(n) * 24 * time.Hour) }
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, john.ID, day(20)); err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := s.RestoreCustomer(a.ID, jane.ID, day(31)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore after 31 days: %v", err)
+	}
+	if n := s.PurgeDeletedCustomers(day(30)); n != 0 {
+		t.Fatalf("purged %d customers at exactly 30 days", n)
+	}
+	if n := s.PurgeDeletedCustomers(day(31)); n != 1 {
+		t.Fatalf("purged %d customers, want 1", n)
+	}
+	if _, ok := s.CustomerWithDeleted(a.ID, jane.ID); ok {
+		t.Fatal("purged customer still there")
+	}
+	if _, err := s.RestoreCustomer(a.ID, john.ID, day(31)); err != nil {
+		t.Fatalf("restore of a customer deleted 11 days ago: %v", err)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: jane.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, day(31)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for a purged customer: %v", err)
+	}
+}
