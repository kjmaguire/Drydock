+// apiKeyAlphabet is what API key tokens are drawn from.
+const apiKeyAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+
+// apiKeyTouchInterval is how long after a key's recorded last use a new use leaves the record unchanged.
+const apiKeyTouchInterval = time.Minute
+
+// newAPIKeyToken returns "tly_" followed by 40 characters from apiKeyAlphabet, drawn from crypto/rand. Bytes that would
+// make some characters more likely than others are skipped.
+func newAPIKeyToken() string {
+	const n = 40
+	const limit = 256 - 256%len(apiKeyAlphabet) // 248: the largest multiple of 62 that fits in a byte
+	out := make([]byte, 0, n)
+	buf := make([]byte, 2*n)
+	for len(out) < n {
+		if _, err := rand.Read(buf); err != nil {
+			panic(err) // crypto/rand does not fail on supported platforms
+		}
+		for _, b := range buf {
+			if int(b) < limit && len(out) < n {
+				out = append(out, apiKeyAlphabet[int(b)%len(apiKeyAlphabet)])
+			}
+		}
+	}
+	return "tly_" + string(out)
+}
+
+// hashToken is how API keys are stored: the hex SHA-256 of the full token. The token itself is never kept.
+func hashToken(token string) string {
+	sum := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(sum[:])
+}
+
+// lastFour returns the last four characters of a token, or "" when it is shorter than that.
+func lastFour(token string) string {
+	if len(token) < 4 {
+		return ""
+	}
+	return token[len(token)-4:]
+}
