+func TestConcurrentRenewDueInvoicesOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setCard(e, c, "pm_card_visa")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub := createSub(e, c, p)
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	var renewed atomic.Int64
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			n, err := e.Subs.RenewDue(ctx)
+			if err != nil {
+				t.Error(err)
+			}
+			renewed.Add(int64(n))
+		}()
+	}
+	wg.Wait()
+	if renewed.Load() != 1 {
+		t.Fatalf("renewed %d times, want once", renewed.Load())
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 {
+		t.Fatalf("invoices = %d, want the first one and one renewal", len(invs))
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 {
+		t.Fatalf("charges = %d, want the first period and one renewal", len(cs))
+	}
+}
+
+func TestGatewayDownRenewalMovesThePeriod(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setCard(e, jane, "pm_card_visa")
+	bob := e.CreateCustomer(e.Acme, "Bob", "bob@example.com")
+	setCard(e, bob, "pm_card_visa")
+	janeSub := createSub(e, jane, p)
+	bobSub := createSub(e, bob, p)
+	setCard(e, jane, "pm_gateway_down")
+	e.Clock.Set(janeSub.CurrentPeriodEnd)
+	now := e.Clock.Now()
+
+	// The failure does not stop Bob's renewal, and it is returned after both were tried.
+	n, err := e.Subs.RenewDue(ctx)
+	if !errors.Is(err, payments.ErrUnavailable) || n != 2 {
+		t.Fatalf("RenewDue = %d, %v; want both renewed and the gateway error", n, err)
+	}
+	for _, id := range []string{janeSub.ID, bobSub.ID} {
+		got, _ := e.Store.Subscription(e.Acme.ID, id)
+		if got.Status != store.Active || !got.CurrentPeriodStart.Equal(now) || !got.CurrentPeriodEnd.Equal(now.AddDate(0, 1, 0)) {
+			t.Fatalf("subscription %s after the renewal = %+v", id, got)
+		}
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: janeSub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoiceOpen {
+		t.Fatalf("invoices = %+v, want the renewal open", invs)
+	}
+
+	// The gateway is back. Nothing is due, and the open invoice is not charged by a later run.
+	setCard(e, jane, "pm_card_visa")
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+		t.Fatalf("second RenewDue = %d, %v", n, err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: janeSub.ID}); len(invs) != 2 || invs[1].Status != store.InvoiceOpen {
+		t.Fatalf("invoices after the second run = %+v", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 3 {
+		t.Fatalf("charges = %d, want 3 (two first periods and Bob's renewal)", len(cs))
+	}
+	if _, _, err := e.Payments.Pay(ctx, e.Acme.ID, invs[1].ID, ""); err != nil {
+		t.Fatalf("paying the open invoice later: %v", err)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 4 {
+		t.Fatalf("charges = %d, want the open invoice taken once", len(cs))
+	}
+}
