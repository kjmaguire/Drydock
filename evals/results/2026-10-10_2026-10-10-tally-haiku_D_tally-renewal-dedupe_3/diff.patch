+// Renewal moves a subscription from the period that ends at FromEnd to the period [PeriodStart, PeriodEnd). Invoice, when
+// set, is the open invoice of the period that is billed.
+type Renewal struct {
+	FromEnd     time.Time
+	PeriodStart time.Time
+	PeriodEnd   time.Time
+	Invoice     *Invoice
+}
+
+// Renew applies a renewal and stores its invoice in one step, so that a period is renewed and invoiced at most once. It
+// returns ErrStale, and changes nothing, when the subscription is canceled, when its period no longer ends at FromEnd, or
+// when the subscription already has an invoice for the period start of the invoice (the pair identifies a renewal invoice).
+func (s *Store) Renew(orgID, subID string, r Renewal, now time.Time) (Subscription, *Invoice, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	old, ok := s.subs[subID]
+	if !ok || old.OrgID != orgID {
+		return Subscription{}, nil, ErrNotFound
+	}
+	if old.Status == Canceled || !old.CurrentPeriodEnd.Equal(r.FromEnd) {
+		return Subscription{}, nil, ErrStale
+	}
+	var inv *Invoice
+	if r.Invoice != nil {
+		if err := checkInvoice(*r.Invoice); err != nil {
+			return Subscription{}, nil, err
+		}
+		for _, other := range s.invoices {
+			if other.SubscriptionID == subID && other.PeriodStart != nil && r.Invoice.PeriodStart != nil && other.PeriodStart.Equal(*r.Invoice.PeriodStart) {
+				return Subscription{}, nil, ErrStale
+			}
+		}
+		created, err := s.createInvoiceLocked(*r.Invoice, now)
+		if err != nil {
+			return Subscription{}, nil, err
+		}
+		inv = &created
+	}
+	sub := copySub(old)
+	sub.CurrentPeriodStart, sub.CurrentPeriodEnd = r.PeriodStart, r.PeriodEnd
+	s.subs[subID] = sub
+	return copySub(sub), inv, nil
+}
