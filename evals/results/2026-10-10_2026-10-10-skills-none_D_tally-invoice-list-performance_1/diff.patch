+package store
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+// bruteInvoices is the answer ListInvoices must give: every invoice of the organization that matches f, oldest first.
+func bruteInvoices(all []Invoice, orgID string, f InvoiceFilter) []Invoice {
+	out := []Invoice{}
+	for _, inv := range all {
+		if inv.OrgID == orgID && (f.CustomerID == "" || inv.CustomerID == f.CustomerID) &&
+			(f.SubscriptionID == "" || inv.SubscriptionID == f.SubscriptionID) && (f.Status == "" || inv.Status == f.Status) {
+			out = append(out, inv)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// pageThrough follows the cursors of ListInvoicesPage from the first invoice, limit at a time.
+func pageThrough(s *Store, orgID string, f InvoiceFilter, limit int) []Invoice {
+	var got []Invoice
+	var after time.Time
+	var afterID string
+	for {
+		page, more := s.ListInvoicesPage(orgID, f, after, afterID, limit)
+		got = append(got, page...)
+		if !more {
+			return got
+		}
+		last := page[len(page)-1]
+		after, afterID = last.CreatedAt, last.ID
+	}
+}
+
+func checkSameInvoices(t *testing.T, what string, got, want []Invoice) {
+	t.Helper()
+	if len(got) != len(want) || (len(got) > 0 && !reflect.DeepEqual(got, want)) {
+		t.Fatalf("%s: got %d invoices, want %d (or they differ)", what, len(got), len(want))
+	}
+}
+
+func createInvoice(t *testing.T, s *Store, orgID, customerID, subscriptionID string, at time.Time) Invoice {
+	t.Helper()
+	inv, err := s.CreateInvoice(Invoice{OrgID: orgID, CustomerID: customerID, SubscriptionID: subscriptionID, Currency: money.USD,
+		Lines: []Line{{Description: "seat", Quantity: 1, UnitAmount: 100}}}, at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return inv
+}
+
+func TestListInvoicesMatchesBruteForce(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca1, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	ca2, _ := s.CreateCustomer(a.ID, "John", "john@example.com", t0)
+	cb1, _ := s.CreateCustomer(b.ID, "Ann", "ann@example.com", t0)
+	// Three invoices share each creation time, so ties are broken by ID; some are paid or void.
+	for i := 0; i < 60; i++ {
+		org, cust := a, ca1.ID
+		if i%3 == 1 {
+			cust = ca2.ID
+		}
+		if i%4 == 3 {
+			org, cust = b, cb1.ID
+		}
+		inv := createInvoice(t, s, org.ID, cust, fmt.Sprintf("sub_%d", i%5), t0.Add(time.Duration(i/3)*time.Minute))
+		switch i % 7 {
+		case 2:
+			_, _ = s.UpdateInvoice(org.ID, inv.ID, func(x *Invoice) error { x.Status = InvoicePaid; return nil })
+		case 5:
+			_, _ = s.UpdateInvoice(org.ID, inv.ID, func(x *Invoice) error { x.Status = InvoiceVoid; return nil })
+		}
+	}
+	// An invoice created later but dated before all the others sorts first.
+	early := createInvoice(t, s, a.ID, ca1.ID, "", t0.Add(-time.Hour))
+
+	filters := []InvoiceFilter{
+		{},
+		{CustomerID: ca1.ID},
+		{CustomerID: ca2.ID, Status: InvoicePaid},
+		{SubscriptionID: "sub_3"},
+		{Status: InvoiceVoid},
+		{CustomerID: cb1.ID, SubscriptionID: "sub_0"},
+		{CustomerID: "cus_missing"},
+	}
+	all := s.Export().Invoices
+	for _, org := range []Org{a, b} {
+		for _, f := range filters {
+			want := bruteInvoices(all, org.ID, f)
+			checkSameInvoices(t, fmt.Sprintf("ListInvoices(%s, %+v)", org.ID, f), s.ListInvoices(org.ID, f), want)
+			for _, limit := range []int{1, 2, 3, 7, 100} {
+				checkSameInvoices(t, fmt.Sprintf("pages of %d for %s, %+v", limit, org.ID, f), pageThrough(s, org.ID, f, limit), want)
+			}
+		}
+	}
+	if got := s.ListInvoices(a.ID, InvoiceFilter{}); len(got) == 0 || got[0].ID != early.ID {
+		t.Fatalf("the first invoice is not the one dated earliest: %+v", got)
+	}
+}
+
+func TestListInvoicesPagingWhileCreating(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	for i := 0; i < 5; i++ {
+		createInvoice(t, s, a.ID, c.ID, "", t0.Add(time.Duration(i)*time.Minute))
+	}
+	page, more := s.ListInvoicesPage(a.ID, InvoiceFilter{}, time.Time{}, "", 3)
+	if !more || len(page) != 3 {
+		t.Fatalf("first page = %d invoices, more %v", len(page), more)
+	}
+	last := page[2]
+	// New invoices: one later, one dated at the cursor's time (so it sorts after the cursor by ID).
+	createInvoice(t, s, a.ID, c.ID, "", t0.Add(10*time.Minute))
+	createInvoice(t, s, a.ID, c.ID, "", last.CreatedAt)
+	rest, more := s.ListInvoicesPage(a.ID, InvoiceFilter{}, last.CreatedAt, last.ID, 10)
+	if more {
+		t.Fatal("the last page says there is more")
+	}
+	got := append(append([]Invoice{}, page...), rest...)
+	checkSameInvoices(t, "pages across new invoices", got, s.ListInvoices(a.ID, InvoiceFilter{}))
+	if len(got) != 7 {
+		t.Fatalf("got %d invoices across the pages, want 7", len(got))
+	}
+}
+
+func TestInvoiceIndexSurvivesFromState(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Ann", "ann@example.com", t0)
+	for i := 0; i < 12; i++ {
+		createInvoice(t, s, a.ID, ca.ID, "sub_1", t0.Add(time.Duration(i/2)*time.Minute))
+		createInvoice(t, s, b.ID, cb.ID, "", t0.Add(time.Duration(i/2)*time.Minute))
+	}
+	loaded, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	all := loaded.Export().Invoices
+	for _, org := range []Org{a, b} {
+		for _, f := range []InvoiceFilter{{}, {SubscriptionID: "sub_1"}, {CustomerID: ca.ID}} {
+			checkSameInvoices(t, "loaded store", loaded.ListInvoices(org.ID, f), bruteInvoices(all, org.ID, f))
+		}
+	}
+	early := createInvoice(t, loaded, a.ID, ca.ID, "", t0.Add(-time.Minute))
+	if got := loaded.ListInvoices(a.ID, InvoiceFilter{}); got[0].ID != early.ID {
+		t.Fatalf("an invoice created after loading is not first: %+v", got[0])
+	}
+}
