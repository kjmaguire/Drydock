+)
+
+var t0 = time.Date(2026, 2, 1, 12, 0, 0, 0, time.UTC)
+
+// invoicePage is a page of GET /v1/invoices: its items, in order, and the cursor of the next page.
+type invoicePage struct {
+	Items []struct {
+		ID       string `json:"id"`
+		Customer *struct {
+			ID   string `json:"id"`
+			Name string `json:"name"`
+		} `json:"customer"`
+	} `json:"items"`
+	NextCursor string `json:"next_cursor"`
+}
+
+func addInvoice(t testing.TB, e *apitest.Env, org apitest.Org, customerID string, at time.Time) store.Invoice {
+	t.Helper()
+	inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: org.ID, CustomerID: customerID, Currency: money.USD,
+		Lines: []store.Line{{Description: "seat", Quantity: 1, UnitAmount: 100}}}, at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return inv
+}
+
+func TestInvoiceListPaging(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	john := e.CreateCustomer(e.Acme, "John", "john@example.com")
+	other := e.CreateCustomer(e.Globex, "Other", "other@example.com")
+	for i := 0; i < 7; i++ {
+		c := jane
+		if i%2 == 1 {
+			c = john
+		}
+		addInvoice(t, e, e.Acme, c.ID, t0.Add(time.Duration(i/2)*time.Minute))
+	}
+	addInvoice(t, e, e.Globex, other.ID, t0)
+	if err := e.Store.DeleteCustomer(e.Acme.ID, john.ID); err != nil {
+		t.Fatal(err)
+	}
+
+	var all invoicePage
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=100", e.Acme.Key, nil, &all)
+	if len(all.Items) != 7 || all.NextCursor != "" {
+		t.Fatalf("unpaged list = %d items, next %q", len(all.Items), all.NextCursor)
+	}
+	var paged []string
+	var nulls int
+	path := "/v1/invoices?limit=3"
+	for {
+		var p invoicePage
+		e.MustDo(http.StatusOK, "GET", path, e.Acme.Key, nil, &p)
+		for _, it := range p.Items {
+			paged = append(paged, it.ID)
+			if it.Customer == nil {
+				nulls++
+			}
+		}
+		if p.NextCursor == "" {
+			break
+		}
+		path = "/v1/invoices?limit=3&cursor=" + p.NextCursor
+	}
+	if len(paged) != len(all.Items) {
+		t.Fatalf("paged %d invoices, unpaged %d", len(paged), len(all.Items))
+	}
+	for i, it := range all.Items {
+		if paged[i] != it.ID {
+			t.Fatalf("item %d = %s over pages, %s unpaged", i, paged[i], it.ID)
+		}
+	}
+	if nulls != 3 {
+		t.Fatalf("%d invoices of the deleted customer have a null customer, want 3", nulls)
+	}
+	if r := e.Do("GET", "/v1/invoices?cursor=nope", e.Acme.Key, nil); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_cursor" {
+		t.Fatalf("bad cursor: %s", r)
+	}
+}
+
+func TestInvoiceListLargeOrganization(t *testing.T) {
+	if testing.Short() {
+		t.Skip("creates 80,000 invoices")
+	}
+	e := apitest.New(t)
+	customers := make([]string, 5000)
+	for i := range customers {
+		customers[i] = e.CreateCustomer(e.Acme, fmt.Sprintf("Customer %d", i), fmt.Sprintf("c%d@example.com", i)).ID
+	}
+	globex := e.CreateCustomer(e.Globex, "Globex", "globex@example.com")
+	start := t0
+	for i := 0; i < 60000; i++ {
+		addInvoice(t, e, e.Acme, customers[i%len(customers)], start.Add(time.Duration(i)*time.Second))
+		if i%3 == 0 {
+			addInvoice(t, e, e.Globex, globex.ID, start.Add(time.Duration(i)*time.Second))
+		}
+	}
+
+	const budget = 250 * time.Millisecond
+	paths := []string{
+		"/v1/invoices?limit=20",
+		"/v1/invoices?limit=20&customer_id=" + customers[17],
+		"/v1/invoices?limit=20&subscription_id=sub_none",
+		"/v1/invoices?limit=20&status=open",
+		"/v1/invoices?limit=20&status=paid&customer_id=" + customers[17],
+	}
+	for _, path := range paths {
+		begin := time.Now()
+		r := e.Do("GET", path, e.Acme.Key, nil)
+		if d := time.Since(begin); d > budget || r.Code != http.StatusOK {
+			t.Errorf("%s took %v (%s), budget %v", path, d, r, budget)
+		}
+	}
+	// Page through the whole organization. A single slow page can be a garbage collection pause, so the budget applies to
+	// the average page.
+	total, pages, path := 0, 0, "/v1/invoices?limit=100"
+	begin := time.Now()
+	for {
+		var p invoicePage
+		e.MustDo(http.StatusOK, "GET", path, e.Acme.Key, nil, &p)
+		total += len(p.Items)
+		pages++
+		if p.NextCursor == "" {
+			break
+		}
+		path = "/v1/invoices?limit=100&cursor=" + p.NextCursor
+	}
+	if avg := time.Since(begin) / time.Duration(pages); avg > budget {
+		t.Errorf("a page took %v on average, budget %v", avg, budget)
+	}
+	if total != 60000 {
+		t.Fatalf("paged %d invoices, want 60000", total)
+	}
+}
