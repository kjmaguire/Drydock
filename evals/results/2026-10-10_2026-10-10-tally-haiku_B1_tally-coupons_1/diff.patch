diff --git a/result/internal/subscriptions/coupons_test.go b/result/internal/subscriptions/coupons_test.go
new file mode 100644
index 0000000..641b692
--- /dev/null
+++ b/result/internal/subscriptions/coupons_test.go
@@ -0,0 +1,128 @@
+package subscriptions_test
+
+import (
+	"context"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/billing"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+	"example.com/tally/internal/subscriptions"
+)
+
+// couponSub is a subscription to a 100.00 USD monthly plan with a 10 percent subscription discount, charged to a card.
+func couponSub(t *testing.T) (*apitest.Env, store.Subscription) {
+	t.Helper()
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p := e.CreatePlan(e.Acme, "Team", "USD", "100.00")
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1, DiscountPercent: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return e, sub
+}
+
+func newCoupon(t *testing.T, e *apitest.Env, c store.Coupon) {
+	t.Helper()
+	c.OrgID = e.Acme.ID
+	if _, err := e.Store.CreateCoupon(c, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// renew moves the clock to the end of the subscription's period and renews it.
+func renew(t *testing.T, e *apitest.Env, sub store.Subscription) store.Subscription {
+	t.Helper()
+	cur, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	e.Clock.Set(cur.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	cur, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+	return cur
+}
+
+// billingDiscount is the discount the invoice's totals show.
+func billingDiscount(inv store.Invoice) int64 { return billing.Compute(inv).Discount }
+
+func invoicesOf(e *apitest.Env, sub store.Subscription) []store.Invoice {
+	return e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+}
+
+func TestOnceCouponDiscountsOnlyTheFirstInvoiceAfterApplying(t *testing.T) {
+	e, sub := couponSub(t)
+	newCoupon(t, e, store.Coupon{Code: "SAVE50", PercentOff: 50, Duration: store.CouponOnce})
+	applied, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "save50")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if applied.Coupon != "SAVE50" || applied.CouponAppliedAt == nil {
+		t.Fatalf("applied = %+v", applied)
+	}
+
+	sub = renew(t, e, sub)
+	invs := invoicesOf(e, sub)
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	// The first invoice (before the coupon) takes the subscription's 10 percent; the coupon's invoice takes its own 50
+	// percent and not the subscription's 10.
+	if invs[0].Coupon != "" || invs[0].DiscountPercent != 10 || invs[0].Lines[0].UnitAmount != 10000 {
+		t.Fatalf("first invoice = %+v", invs[0])
+	}
+	if got := invs[1]; got.Coupon != "SAVE50" || got.DiscountPercent != 0 || got.CouponPercentOff != 50 {
+		t.Fatalf("coupon invoice = %+v", got)
+	}
+
+	sub = renew(t, e, sub)
+	invs = invoicesOf(e, sub)
+	if len(invs) != 3 || invs[2].Coupon != "" || invs[2].DiscountPercent != 10 {
+		t.Fatalf("after the once coupon, invoices = %+v", invs)
+	}
+}
+
+func TestRepeatingCouponStopsAfterItsMonths(t *testing.T) {
+	e, sub := couponSub(t)
+	months := 2
+	newCoupon(t, e, store.Coupon{Code: "TWOMONTHS", AmountOff: 2500, Currency: money.USD, Duration: store.CouponRepeating, DurationInMonths: months})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "TWOMONTHS"); err != nil {
+		t.Fatal(err)
+	}
+	for range 3 {
+		sub = renew(t, e, sub)
+	}
+	invs := invoicesOf(e, sub)
+	if len(invs) != 4 {
+		t.Fatalf("invoices = %d", len(invs))
+	}
+	// The first invoice came before the coupon. Only the renewal starting one month after the redemption starts less than
+	// two months after it, so only that one is discounted by 25.00; the others take the subscription's 10 percent.
+	for i, want := range []struct {
+		coupon   string
+		discount int64
+	}{{"", 1000}, {"TWOMONTHS", 2500}, {"", 1000}, {"", 1000}} {
+		if invs[i].Coupon != want.coupon || billingDiscount(invs[i]) != want.discount {
+			t.Fatalf("invoice %d = %+v, want coupon %q discount %d", i, invs[i], want.coupon, want.discount)
+		}
+	}
+}
+
+func TestForeverCouponDiscountsEveryInvoice(t *testing.T) {
+	e, sub := couponSub(t)
+	newCoupon(t, e, store.Coupon{Code: "FOREVER", PercentOff: 20, Duration: store.CouponForever})
+	if _, err := e.Subs.ApplyCoupon(context.Background(), e.Acme.ID, sub.ID, "FOREVER"); err != nil {
+		t.Fatal(err)
+	}
+	for range 3 {
+		sub = renew(t, e, sub)
+	}
+	invs := invoicesOf(e, sub)
+	for i, inv := range invs[1:] {
+		if inv.Coupon != "FOREVER" || billingDiscount(inv) != 2000 {
+			t.Fatalf("renewal %d = %+v", i+1, inv)
+		}
+	}
+}
