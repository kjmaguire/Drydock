diff --git a/start/internal/billing/billing.go b/result/internal/billing/billing.go
index be8baaf..ea2b088 100644
--- a/start/internal/billing/billing.go
+++ b/result/internal/billing/billing.go
@@ -16,15 +16,24 @@ type Totals struct {
 	Total    int64 `json:"total"`
 }
 
-// Compute returns an invoice's totals: the sum of its lines, the discount (DiscountPercent of the subtotal), and tax at the
-// invoice's rate on the subtotal after the discount. The discount and the tax are each rounded half away from zero to a
-// whole minor unit.
+// Compute returns an invoice's totals: the sum of its lines, the discount, and tax at the invoice's rate on the subtotal
+// after the discount. The discount is the coupon's, when a coupon discounted the invoice (CouponPercentOff of the subtotal,
+// or CouponAmountOff off it but never more than the subtotal); otherwise DiscountPercent of the subtotal. The discount and
+// the tax are each rounded half away from zero to a whole minor unit.
 func Compute(inv store.Invoice) Totals {
 	var subtotal int64
 	for _, l := range inv.Lines {
 		subtotal += l.Amount()
 	}
-	discount := money.Percent(subtotal, inv.DiscountPercent)
+	var discount int64
+	switch {
+	case inv.Coupon != "" && inv.CouponPercentOff != 0:
+		discount = money.Percent(subtotal, inv.CouponPercentOff)
+	case inv.Coupon != "":
+		discount = max(0, min(inv.CouponAmountOff, subtotal))
+	default:
+		discount = money.Percent(subtotal, inv.DiscountPercent)
+	}
 	taxable := subtotal - discount
 	tax := money.BasisPoints(taxable, inv.TaxRateBP)
 	return Totals{Subtotal: subtotal, Discount: discount, Tax: tax, Total: taxable + tax}
