diff --git a/result/internal/store/coupons.go b/result/internal/store/coupons.go
new file mode 100644
index 0000000..7e97909
--- /dev/null
+++ b/result/internal/store/coupons.go
@@ -0,0 +1,198 @@
+package store
+
+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+// CouponDuration is how long a coupon discounts a subscription's invoices.
+type CouponDuration string
+
+// Coupon durations.
+const (
+	// CouponOnce discounts only the first invoice created after the coupon is applied.
+	CouponOnce CouponDuration = "once"
+	// CouponRepeating discounts the invoices created after the coupon is applied whose period starts less than
+	// DurationInMonths months after the redemption.
+	CouponRepeating CouponDuration = "repeating"
+	// CouponForever discounts every invoice created after the coupon is applied.
+	CouponForever CouponDuration = "forever"
+)
+
+// Coupon is a code that discounts a subscription's invoices. It takes PercentOff percent off the subtotal, or AmountOff
+// (minor units of Currency) off it. Exactly one of the two is set.
+type Coupon struct {
+	ID               string         `json:"id"`
+	OrgID            string         `json:"org_id"`
+	Code             string         `json:"code"`
+	PercentOff       int            `json:"percent_off"`
+	AmountOff        int64          `json:"amount_off"`
+	Currency         money.Currency `json:"currency"`
+	Duration         CouponDuration `json:"duration"`
+	DurationInMonths int            `json:"duration_in_months"`
+	// MaxRedemptions is how many subscriptions may hold the coupon; nil means no limit.
+	MaxRedemptions *int       `json:"max_redemptions,omitempty"`
+	RedeemBy       *time.Time `json:"redeem_by,omitempty"`
+	CreatedAt      time.Time  `json:"created_at"`
+}
+
+// Errors of coupons. The API answers each with its own error code.
+var (
+	// ErrCodeTaken is returned when another coupon of the organization has the code, ignoring case.
+	ErrCodeTaken            = fmt.Errorf("%w: coupon code already in use", ErrConflict)
+	ErrCouponExpired        = errors.New("the coupon's redeem-by time has passed")
+	ErrCouponExhausted      = errors.New("the coupon has no redemptions left")
+	ErrCurrencyMismatch     = errors.New("the coupon's currency is not the subscription's plan currency")
+	ErrCouponApplied        = errors.New("the subscription already has a coupon")
+	ErrSubscriptionCanceled = errors.New("the subscription is canceled")
+)
+
+var couponCodeRe = regexp.MustCompile(`^[A-Za-z0-9_-]{3,32}$`)
+
+type couponKey struct{ org, code string } // code lower-cased
+
+func checkCoupon(c Coupon) error {
+	switch {
+	case !couponCodeRe.MatchString(c.Code):
+		return invalid("a coupon code is 3 to 32 letters, digits, dashes or underscores")
+	case (c.PercentOff != 0) == (c.AmountOff != 0):
+		return invalid("a coupon takes percent_off or amount_off, exactly one")
+	case c.PercentOff != 0 && (c.PercentOff < 1 || c.PercentOff > 100):
+		return invalid("percent_off is 1 to 100")
+	case c.AmountOff < 0:
+		return invalid("amount_off is positive")
+	case c.PercentOff != 0 && c.Currency != "":
+		return invalid("only an amount_off coupon has a currency")
+	case c.AmountOff != 0 && !c.Currency.Valid():
+		return invalid("unknown currency %q", c.Currency)
+	case c.Duration != CouponOnce && c.Duration != CouponRepeating && c.Duration != CouponForever:
+		return invalid("a coupon lasts once, repeating or forever")
+	case c.Duration == CouponRepeating && (c.DurationInMonths < 1 || c.DurationInMonths > 36):
+		return invalid("a repeating coupon lasts 1 to 36 months")
+	case c.Duration != CouponRepeating && c.DurationInMonths != 0:
+		return invalid("only a repeating coupon has duration_in_months")
+	case c.MaxRedemptions != nil && *c.MaxRedemptions < 1:
+		return invalid("max_redemptions is at least 1")
+	}
+	return nil
+}
+
+// CreateCoupon adds a coupon to an organization. Its code is unique in the organization, ignoring case.
+func (s *Store) CreateCoupon(c Coupon, now time.Time) (Coupon, error) {
+	if err := checkCoupon(c); err != nil {
+		return Coupon{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[c.OrgID]; !ok {
+		return Coupon{}, ErrNotFound
+	}
+	k := couponKey{c.OrgID, strings.ToLower(c.Code)}
+	if _, ok := s.couponsByCode[k]; ok {
+		return Coupon{}, ErrCodeTaken
+	}
+	c.ID = s.newID("cpn")
+	c.CreatedAt = now.UTC()
+	s.coupons[c.ID] = copyCoupon(c)
+	s.couponsByCode[k] = c.ID
+	return copyCoupon(c), nil
+}
+
+// Coupon returns one of an organization's coupons by its code, ignoring case.
+func (s *Store) Coupon(orgID, code string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	id, ok := s.couponsByCode[couponKey{orgID, strings.ToLower(code)}]
+	if !ok {
+		return Coupon{}, false
+	}
+	return copyCoupon(s.coupons[id]), true
+}
+
+// Coupons returns an organization's coupons, oldest first.
+func (s *Store) Coupons(orgID string) []Coupon {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Coupon{}
+	for _, c := range s.coupons {
+		if c.OrgID == orgID {
+			out = append(out, copyCoupon(c))
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// CouponRedemptions counts the subscriptions of an organization that hold the coupon with this code.
+func (s *Store) CouponRedemptions(orgID, code string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.countRedemptions(orgID, code)
+}
+
+// countRedemptions counts the subscriptions holding the coupon with this code. The caller holds the lock.
+func (s *Store) countRedemptions(orgID, code string) int {
+	n := 0
+	for _, sub := range s.subs {
+		if sub.OrgID == orgID && sub.Coupon == code {
+			n++
+		}
+	}
+	return n
+}
+
+// ApplyCoupon applies the coupon with this code to a subscription at now, which is the redemption time. It refuses a
+// canceled subscription, one that already has a coupon, a coupon past its redeem-by time, one that its max redemptions
+// have used up, and an amount_off coupon in another currency than the subscription's plan.
+func (s *Store) ApplyCoupon(orgID, subID, code string, now time.Time) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	sub, ok := s.subs[subID]
+	if !ok || sub.OrgID != orgID {
+		return Subscription{}, ErrNotFound
+	}
+	id, ok := s.couponsByCode[couponKey{orgID, strings.ToLower(code)}]
+	if !ok {
+		return Subscription{}, fmt.Errorf("%w: coupon %q", ErrNotFound, code)
+	}
+	c := s.coupons[id]
+	switch {
+	case sub.Status == Canceled:
+		return Subscription{}, ErrSubscriptionCanceled
+	case sub.Coupon != "":
+		return Subscription{}, ErrCouponApplied
+	case c.RedeemBy != nil && now.After(*c.RedeemBy):
+		return Subscription{}, ErrCouponExpired
+	case c.MaxRedemptions != nil && s.countRedemptions(orgID, c.Code) >= *c.MaxRedemptions:
+		return Subscription{}, ErrCouponExhausted
+	case c.Currency != "" && c.Currency != s.plans[sub.PlanID].Currency:
+		return Subscription{}, ErrCurrencyMismatch
+	}
+	t := now.UTC()
+	sub.Coupon, sub.CouponAppliedAt = c.Code, &t
+	s.subs[subID] = sub
+	return copySub(sub), nil
+}
+
+func copyCoupon(c Coupon) Coupon {
+	if c.MaxRedemptions != nil {
+		n := *c.MaxRedemptions
+		c.MaxRedemptions = &n
+	}
+	if c.RedeemBy != nil {
+		t := *c.RedeemBy
+		c.RedeemBy = &t
+	}
+	return c
+}
diff --git a/result/internal/store/coupons_test.go b/result/internal/store/coupons_test.go
new file mode 100644
index 0000000..68fd8c4
--- /dev/null
+++ b/result/internal/store/coupons_test.go
@@ -0,0 +1,204 @@
+package store
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+// couponFixture is an organization with a customer and a USD monthly subscription to a plan that costs 100.00.
+func couponFixture(t *testing.T) (*Store, Org, Subscription) {
+	t.Helper()
+	s := New()
+	a := newOrg(t, s, "A")
+	c, err := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := s.CreatePlan(Plan{OrgID: a.ID, Name: "Pro", Currency: money.USD, UnitAmount: 10000, Interval: Monthly}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: c.ID, PlanID: p.ID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s, a, sub
+}
+
+func TestCreateCouponValidation(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	ten := 10
+	valid := Coupon{OrgID: a.ID, Code: "SAVE_10-x", PercentOff: 10, Duration: CouponForever}
+	if _, err := s.CreateCoupon(valid, t0); err != nil {
+		t.Fatalf("valid coupon: %v", err)
+	}
+	bad := []Coupon{
+		{OrgID: a.ID, Code: "AB", PercentOff: 10, Duration: CouponOnce},                                     // too short
+		{OrgID: a.ID, Code: "THIS_CODE_IS_FAR_TOO_LONG_FOR_A_COUPON", PercentOff: 10, Duration: CouponOnce}, // too long
+		{OrgID: a.ID, Code: "BAD CODE", PercentOff: 10, Duration: CouponOnce},                               // space
+		{OrgID: a.ID, Code: "NONE1", Duration: CouponOnce},                                                  // neither
+		{OrgID: a.ID, Code: "BOTH1", PercentOff: 10, AmountOff: 100, Currency: money.USD, Duration: CouponOnce},
+		{OrgID: a.ID, Code: "PCT101", PercentOff: 101, Duration: CouponOnce},
+		{OrgID: a.ID, Code: "PCTCUR", PercentOff: 10, Currency: money.USD, Duration: CouponOnce},
+		{OrgID: a.ID, Code: "AMTNOC", AmountOff: 100, Duration: CouponOnce},
+		{OrgID: a.ID, Code: "NODUR", PercentOff: 10},
+		{OrgID: a.ID, Code: "REPNOM", PercentOff: 10, Duration: CouponRepeating},
+		{OrgID: a.ID, Code: "REP37", PercentOff: 10, Duration: CouponRepeating, DurationInMonths: 37},
+		{OrgID: a.ID, Code: "ONCEM", PercentOff: 10, Duration: CouponOnce, DurationInMonths: 3},
+		{OrgID: a.ID, Code: "ZEROMAX", PercentOff: 10, Duration: CouponForever, MaxRedemptions: new(int)},
+	}
+	for _, c := range bad {
+		if _, err := s.CreateCoupon(c, t0); !errors.Is(err, ErrInvalid) {
+			t.Errorf("coupon %q: want ErrInvalid, got %v", c.Code, err)
+		}
+	}
+	ok := Coupon{OrgID: a.ID, Code: "MAXTEN", PercentOff: 10, Duration: CouponRepeating, DurationInMonths: 36, MaxRedemptions: &ten}
+	if _, err := s.CreateCoupon(ok, t0); err != nil {
+		t.Fatalf("repeating coupon: %v", err)
+	}
+}
+
+func TestCouponCodesAreUniqueIgnoringCase(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	if _, err := s.CreateCoupon(Coupon{OrgID: a.ID, Code: "Spring", PercentOff: 5, Duration: CouponOnce}, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateCoupon(Coupon{OrgID: a.ID, Code: "SPRING", PercentOff: 6, Duration: CouponOnce}, t0); !errors.Is(err, ErrCodeTaken) || !errors.Is(err, ErrConflict) {
+		t.Fatalf("same code, other case: %v", err)
+	}
+	if _, err := s.CreateCoupon(Coupon{OrgID: b.ID, Code: "spring", PercentOff: 6, Duration: CouponOnce}, t0); err != nil {
+		t.Fatalf("another organization may have the code: %v", err)
+	}
+	c, ok := s.Coupon(a.ID, "sPRING")
+	if !ok || c.Code != "Spring" || c.PercentOff != 5 {
+		t.Fatalf("Coupon = %+v, %v", c, ok)
+	}
+	if c, ok := s.Coupon(b.ID, "Spring"); !ok || c.PercentOff != 6 {
+		t.Fatalf("organization B's coupon = %+v, %v; it must not see A's", c, ok)
+	}
+	if got := s.Coupons(a.ID); len(got) != 1 {
+		t.Fatalf("Coupons = %+v", got)
+	}
+}
+
+func TestApplyCouponRefusals(t *testing.T) {
+	s, a, sub := couponFixture(t)
+	mk := func(c Coupon) {
+		t.Helper()
+		c.OrgID = a.ID
+		if _, err := s.CreateCoupon(c, t0); err != nil {
+			t.Fatal(err)
+		}
+	}
+	one := 1
+	mk(Coupon{Code: "ONEUSE", PercentOff: 10, Duration: CouponForever, MaxRedemptions: &one})
+	mk(Coupon{Code: "EXPIRES", PercentOff: 10, Duration: CouponForever, RedeemBy: ptrTime(t0.Add(time.Hour))})
+	mk(Coupon{Code: "EUROS", AmountOff: 500, Currency: money.EUR, Duration: CouponOnce})
+	mk(Coupon{Code: "PCT", PercentOff: 10, Duration: CouponForever})
+
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "missing", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("unknown coupon: %v", err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, "sub_nope", "PCT", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("unknown subscription: %v", err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "EUROS", t0); !errors.Is(err, ErrCurrencyMismatch) {
+		t.Fatalf("currency: %v", err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "EXPIRES", t0.Add(time.Hour+time.Second)); !errors.Is(err, ErrCouponExpired) {
+		t.Fatalf("expired: %v", err)
+	}
+	// The redeem-by time itself still counts as in time.
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "EXPIRES", t0.Add(time.Hour)); err != nil {
+		t.Fatalf("at the redeem-by time: %v", err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "PCT", t0); !errors.Is(err, ErrCouponApplied) {
+		t.Fatalf("second coupon on one subscription: %v", err)
+	}
+
+	other, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: sub.CustomerID, PlanID: sub.PlanID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, other.ID, "ONEUSE", t0); err != nil {
+		t.Fatalf("first redemption: %v", err)
+	}
+	third, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: sub.CustomerID, PlanID: sub.PlanID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, third.ID, "ONEUSE", t0); !errors.Is(err, ErrCouponExhausted) {
+		t.Fatalf("exhausted: %v", err)
+	}
+	if n := s.CouponRedemptions(a.ID, "ONEUSE"); n != 1 {
+		t.Fatalf("redemptions = %d", n)
+	}
+
+	canceled, err := s.UpdateSubscription(a.ID, sub.ID, func(x *Subscription) error { x.Status = Canceled; x.Coupon = ""; return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, canceled.ID, "PCT", t0); !errors.Is(err, ErrSubscriptionCanceled) {
+		t.Fatalf("canceled subscription: %v", err)
+	}
+}
+
+func TestApplyCouponRecordsTheRedemption(t *testing.T) {
+	s, a, sub := couponFixture(t)
+	if _, err := s.CreateCoupon(Coupon{OrgID: a.ID, Code: "PCT", PercentOff: 10, Duration: CouponForever}, t0); err != nil {
+		t.Fatal(err)
+	}
+	at := t0.Add(48 * time.Hour)
+	got, err := s.ApplyCoupon(a.ID, sub.ID, "pct", at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Coupon != "PCT" || got.CouponAppliedAt == nil || !got.CouponAppliedAt.Equal(at) {
+		t.Fatalf("applied = %+v", got)
+	}
+	stored, _ := s.Subscription(a.ID, sub.ID)
+	if stored.Coupon != "PCT" || !stored.CouponAppliedAt.Equal(at) {
+		t.Fatalf("stored = %+v", stored)
+	}
+	// The returned value does not share the stored time.
+	*got.CouponAppliedAt = t0
+	if again, _ := s.Subscription(a.ID, sub.ID); !again.CouponAppliedAt.Equal(at) {
+		t.Fatal("the stored redemption time was changed through a returned copy")
+	}
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "PCT", at); !errors.Is(err, ErrCouponApplied) {
+		t.Fatalf("applied twice: %v", err)
+	}
+}
+
+func TestCouponsSurviveExportAndFromState(t *testing.T) {
+	s, a, _ := couponFixture(t)
+	one := 3
+	if _, err := s.CreateCoupon(Coupon{OrgID: a.ID, Code: "KEEP", AmountOff: 250, Currency: money.USD, Duration: CouponRepeating,
+		DurationInMonths: 2, MaxRedemptions: &one, RedeemBy: ptrTime(t0.Add(24 * time.Hour))}, t0); err != nil {
+		t.Fatal(err)
+	}
+	back, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(back.Coupons(a.ID), s.Coupons(a.ID)) {
+		t.Fatalf("coupons after FromState = %+v, want %+v", back.Coupons(a.ID), s.Coupons(a.ID))
+	}
+	if _, ok := back.Coupon(a.ID, "keep"); !ok {
+		t.Fatal("the code index was not rebuilt")
+	}
+	if _, err := back.CreateCoupon(Coupon{OrgID: a.ID, Code: "Keep", PercentOff: 1, Duration: CouponOnce}, t0); !errors.Is(err, ErrCodeTaken) {
+		t.Fatalf("code after FromState: %v", err)
+	}
+}
+
+func ptrTime(t time.Time) *time.Time { return &t }
