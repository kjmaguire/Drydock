+// ApplyCoupon applies the coupon with this code to a subscription now. Its invoices created after now are discounted by it
+// (see couponFor). A subscription holds one coupon at a time.
+func (s *Service) ApplyCoupon(ctx context.Context, orgID, id, code string) (store.Subscription, error) {
+	sub, err := s.Store.ApplyCoupon(orgID, id, code, s.Clock.Now())
+	if err != nil {
+		return store.Subscription{}, err
+	}
+	s.publish(ctx, orgID, "subscription.updated", sub)
+	return sub, nil
+}
+
+// couponFor returns the coupon that discounts the invoice of sub now, for the period that starts at start, and whether there
+// is one. The invoice must be created after the coupon was applied, and then: a once coupon discounts only the first invoice
+// it applies to; a repeating coupon discounts the invoices whose period starts less than its months after the redemption; a
+// forever coupon discounts them all.
+func (s *Service) couponFor(sub store.Subscription, start, now time.Time) (store.Coupon, bool) {
+	if sub.Coupon == "" || sub.CouponAppliedAt == nil || !now.After(*sub.CouponAppliedAt) {
+		return store.Coupon{}, false
+	}
+	c, ok := s.Store.Coupon(sub.OrgID, sub.Coupon)
+	if !ok {
+		return store.Coupon{}, false
+	}
+	switch c.Duration {
+	case store.CouponOnce:
+		for _, inv := range s.Store.ListInvoices(sub.OrgID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+			if inv.Coupon == c.Code {
+				return store.Coupon{}, false
+			}
+		}
+	case store.CouponRepeating:
+		if !start.Before(sub.CouponAppliedAt.AddDate(0, c.DurationInMonths, 0)) {
+			return store.Coupon{}, false
+		}
+	}
+	return c, true
+}
