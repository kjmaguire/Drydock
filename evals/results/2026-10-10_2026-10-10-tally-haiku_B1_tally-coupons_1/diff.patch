+func TestComputeCouponReplacesTheInvoicesPercent(t *testing.T) {
+	inv := store.Invoice{
+		Lines:            []store.Line{{Description: "Pro", Quantity: 1, UnitAmount: 10000}},
+		DiscountPercent:  10,
+		Coupon:           "HALF",
+		CouponPercentOff: 50,
+		TaxRateBP:        1000,
+	}
+	// The coupon's 50 percent is the discount, not the 10 percent that is also set: 5000 off, 500 tax on 5000.
+	if got := Compute(inv); got != (Totals{Subtotal: 10000, Discount: 5000, Tax: 500, Total: 5500}) {
+		t.Fatalf("Compute = %+v", got)
+	}
+}
+
+func TestComputeCouponAmountOff(t *testing.T) {
+	inv := store.Invoice{Lines: []store.Line{{Description: "Pro", Quantity: 1, UnitAmount: 10000}}, Coupon: "TWENTYFIVE", CouponAmountOff: 2500}
+	if got := Compute(inv); got != (Totals{Subtotal: 10000, Discount: 2500, Total: 7500}) {
+		t.Fatalf("Compute = %+v", got)
+	}
+	// More than the subtotal takes only the subtotal off.
+	inv = store.Invoice{Lines: []store.Line{{Description: "Pro", Quantity: 1, UnitAmount: 5000}}, Coupon: "BIG", CouponAmountOff: 9000}
+	if got := Compute(inv); got != (Totals{Subtotal: 5000, Discount: 5000, Total: 0}) {
+		t.Fatalf("Compute capped = %+v", got)
+	}
+}
+
+func TestComputeCouponPercentRoundsHalfAwayFromZero(t *testing.T) {
+	inv := store.Invoice{Lines: []store.Line{{Description: "x", Quantity: 1, UnitAmount: 999}}, Coupon: "HALF", CouponPercentOff: 50}
+	// 999 * 50% = 499.5 -> 500.
+	if got := Compute(inv); got.Discount != 500 || got.Total != 499 {
+		t.Fatalf("Compute = %+v", got)
+	}
+}
