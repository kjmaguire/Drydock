+package api_test
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func TestCreateCoupon(t *testing.T) {
+	e := apitest.New(t)
+	var c struct {
+		ID             string `json:"id"`
+		Code           string `json:"code"`
+		AmountOff      int64  `json:"amount_off"`
+		Currency       string `json:"currency"`
+		Duration       string `json:"duration"`
+		TimesRedeemed  int    `json:"times_redeemed"`
+		PercentOff     int    `json:"percent_off"`
+		MaxRedemptions *int   `json:"max_redemptions"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{
+		"code": "WELCOME25", "amount_off": "25.00", "currency": "USD", "duration": "once", "max_redemptions": 10,
+	}, &c)
+	if c.Code != "WELCOME25" || c.AmountOff != 2500 || c.Currency != "USD" || c.Duration != "once" || c.TimesRedeemed != 0 || c.PercentOff != 0 {
+		t.Fatalf("created = %+v", c)
+	}
+	if c.MaxRedemptions == nil || *c.MaxRedemptions != 10 || c.ID == "" {
+		t.Fatalf("created = %+v", c)
+	}
+
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "welcome25", "percent_off": 10, "duration": "forever"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "code_taken" {
+		t.Fatalf("same code, other case: %s", r)
+	}
+	// Another organization may use the code.
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Globex.Key, map[string]any{"code": "WELCOME25", "percent_off": 10, "duration": "forever"}, nil)
+
+	invalid := []map[string]any{
+		{"code": "AB", "percent_off": 10, "duration": "once"},
+		{"code": "NOPE", "duration": "once"},
+		{"code": "BOTH1", "percent_off": 10, "amount_off": "1.00", "currency": "USD", "duration": "once"},
+		{"code": "ZERO1", "percent_off": 0, "duration": "once"},
+		{"code": "PCT101", "percent_off": 101, "duration": "once"},
+		{"code": "AMTBAD", "amount_off": "ten", "currency": "USD", "duration": "once"},
+		{"code": "AMTNOC", "amount_off": "10.00", "duration": "once"},
+		{"code": "AMTNEG", "amount_off": "-1.00", "currency": "USD", "duration": "once"},
+		{"code": "BADDUR", "percent_off": 10, "duration": "sometimes"},
+		{"code": "FOREVM", "percent_off": 10, "duration": "forever", "duration_in_months": 3},
+		{"code": "REPNOM", "percent_off": 10, "duration": "repeating"},
+		{"code": "REP0MO", "percent_off": 10, "duration": "repeating", "duration_in_months": 0},
+		{"code": "REP37M", "percent_off": 10, "duration": "repeating", "duration_in_months": 37},
+		{"code": "MAX0RD", "percent_off": 10, "duration": "forever", "max_redemptions": 0},
+		{"code": "BADDAT", "percent_off": 10, "duration": "forever", "redeem_by": "next tuesday"},
+		{"code": "CURPCT", "percent_off": 10, "currency": "USD", "duration": "forever"},
+	}
+	for _, body := range invalid {
+		r := e.Do("POST", "/v1/coupons", e.Acme.Key, body)
+		if r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid" {
+			t.Errorf("%v: %s", body, r)
+		}
+	}
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, "{not json"); r.Code != http.StatusBadRequest {
+		t.Fatalf("bad json: %s", r)
+	}
+}
+
+func TestListAndGetCoupons(t *testing.T) {
+	e := apitest.New(t)
+	for _, code := range []string{"FIRST", "SECOND", "THIRD"} {
+		e.Clock.Advance(time.Minute)
+		e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": code, "percent_off": 5, "duration": "forever"}, nil)
+	}
+	var page struct {
+		Items []struct {
+			Code string `json:"code"`
+		} `json:"items"`
+		NextCursor string `json:"next_cursor"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons?limit=2", e.Acme.Key, nil, &page)
+	if len(page.Items) != 2 || page.Items[0].Code != "FIRST" || page.Items[1].Code != "SECOND" || page.NextCursor == "" {
+		t.Fatalf("first page = %+v", page)
+	}
+	var last struct {
+		Items []struct {
+			Code string `json:"code"`
+		} `json:"items"`
+		NextCursor string `json:"next_cursor"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons?limit=2&cursor="+page.NextCursor, e.Acme.Key, nil, &last)
+	if len(last.Items) != 1 || last.Items[0].Code != "THIRD" || last.NextCursor != "" {
+		t.Fatalf("second page = %+v", last)
+	}
+
+	var got struct {
+		Code string `json:"code"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/second", e.Acme.Key, nil, &got)
+	if got.Code != "SECOND" {
+		t.Fatalf("get = %+v", got)
+	}
+	if r := e.Do("GET", "/v1/coupons/NOPE", e.Acme.Key, nil); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("unknown: %s", r)
+	}
+	if r := e.Do("GET", "/v1/coupons/FIRST", e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("another organization's coupon: %s", r)
+	}
+}
+
+// couponAPISub creates a customer with this email and a subscription to a 100.00 USD plan through the API.
+func couponAPISub(t *testing.T, e *apitest.Env, email string) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, email, email)
+	p := e.CreatePlan(e.Acme, "Team", "USD", "100.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": p.ID, "quantity": 1}, &sub)
+	return sub
+}
+
+func TestApplyCouponAPI(t *testing.T) {
+	e := apitest.New(t)
+	sub := couponAPISub(t, e, "jane@example.com")
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "PCT20", "percent_off": 20, "duration": "forever"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "EUR5", "amount_off": "5.00", "currency": "EUR", "duration": "once"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "LATE", "percent_off": 5, "duration": "once",
+		"redeem_by": e.Clock.Now().Add(-time.Hour).Format(time.RFC3339)}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "ONCE", "percent_off": 5, "duration": "once", "max_redemptions": 1}, nil)
+
+	var applied struct {
+		ID     string `json:"id"`
+		Coupon string `json:"coupon"`
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "pct20"}, &applied)
+	if applied.ID != sub.ID || applied.Coupon != "PCT20" {
+		t.Fatalf("applied = %+v", applied)
+	}
+	var coupon struct {
+		TimesRedeemed int `json:"times_redeemed"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/PCT20", e.Acme.Key, nil, &coupon)
+	if coupon.TimesRedeemed != 1 {
+		t.Fatalf("times_redeemed = %d", coupon.TimesRedeemed)
+	}
+
+	other := couponAPISub(t, e, "other@example.com")
+	cases := []struct {
+		sub, code, want, errCode string
+		status                   int
+	}{
+		{sub.ID, "PCT20", "", "coupon_already_applied", http.StatusConflict},
+		{other.ID, "EUR5", "", "currency_mismatch", http.StatusUnprocessableEntity},
+		{other.ID, "LATE", "", "coupon_expired", http.StatusUnprocessableEntity},
+		{other.ID, "missing", "", "not_found", http.StatusNotFound},
+		{"sub_000999", "PCT20", "", "not_found", http.StatusNotFound},
+	}
+	for _, c := range cases {
+		r := e.Do("POST", "/v1/subscriptions/"+c.sub+"/coupon", e.Acme.Key, map[string]string{"code": c.code})
+		if r.Code != c.status || r.Map(t)["error"] != c.errCode {
+			t.Errorf("apply %s to %s: %s", c.code, c.sub, r)
+		}
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "BOTH", "percent_off": 5, "duration": "forever"}, nil)
+	if r := e.Do("POST", "/v1/subscriptions/"+other.ID+"/coupon", e.Globex.Key, map[string]string{"code": "BOTH"}); r.Code != http.StatusNotFound {
+		t.Fatalf("another organization's subscription: %s", r)
+	}
+
+	// ONCE has one redemption; a second subscription is refused as exhausted.
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+other.ID+"/coupon", e.Acme.Key, map[string]string{"code": "ONCE"}, nil)
+	third := couponAPISub(t, e, "third@example.com")
+	if r := e.Do("POST", "/v1/subscriptions/"+third.ID+"/coupon", e.Acme.Key, map[string]string{"code": "ONCE"}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_exhausted" {
+		t.Fatalf("exhausted: %s", r)
+	}
+}
+
+func TestApplyCouponToCanceledSubscription(t *testing.T) {
+	e := apitest.New(t)
+	sub := couponAPISub(t, e, "jane@example.com")
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "PCT20", "percent_off": 20, "duration": "forever"}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", e.Acme.Key, nil, nil)
+	if r := e.Do("POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "PCT20"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "subscription_canceled" {
+		t.Fatalf("canceled: %s", r)
+	}
+}
+
+func TestCouponDiscountsShowOnInvoices(t *testing.T) {
+	e := apitest.New(t)
+	sub := couponAPISub(t, e, "jane@example.com")
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "TENOFF", "amount_off": "10.00", "currency": "USD", "duration": "forever"}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "TENOFF"}, nil)
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+
+	var list struct {
+		Items []struct {
+			Coupon   string `json:"coupon"`
+			Discount int64  `json:"discount"`
+			Total    int64  `json:"total"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &list)
+	if len(list.Items) != 2 {
+		t.Fatalf("invoices = %+v", list.Items)
+	}
+	if list.Items[0].Coupon != "" || list.Items[0].Discount != 0 {
+		t.Fatalf("the invoice before the coupon = %+v", list.Items[0])
+	}
+	if list.Items[1].Coupon != "TENOFF" || list.Items[1].Discount != 1000 || list.Items[1].Total != 9000 {
+		t.Fatalf("the coupon's invoice = %+v", list.Items[1])
+	}
+}
