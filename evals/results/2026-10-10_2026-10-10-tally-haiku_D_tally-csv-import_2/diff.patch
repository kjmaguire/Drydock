+// NewCustomer is a customer for CreateCustomers.
+type NewCustomer struct {
+	Name                 string
+	Email                string
+	DefaultPaymentMethod string
+	Metadata             map[string]string
+}
+
+// CreateCustomers adds customers to an organization in one step, in the order given: either all of them are created or,
+// when one has no name, an invalid email address or a payment method that is not "pm_...", or an email address that an
+// existing customer or an earlier one in the list has (ignoring case), none is and the error says why.
+func (s *Store) CreateCustomers(orgID string, ins []NewCustomer, now time.Time) ([]Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return nil, ErrNotFound
+	}
+	seen := make(map[emailKey]bool, len(ins))
+	for _, in := range ins {
+		name, email := strings.TrimSpace(in.Name), strings.TrimSpace(in.Email)
+		if name == "" || !validEmail(email) {
+			return nil, invalid("a customer needs a name and a valid email address")
+		}
+		if in.DefaultPaymentMethod != "" && !strings.HasPrefix(in.DefaultPaymentMethod, "pm_") {
+			return nil, invalid("a payment method looks like pm_...")
+		}
+		key := customerEmailKey(orgID, email)
+		if _, ok := s.customersByEmail[key]; ok || seen[key] {
+			return nil, ErrEmailTaken
+		}
+		seen[key] = true
+	}
+	out := make([]Customer, 0, len(ins))
+	for _, in := range ins {
+		c := copyCustomer(Customer{ID: s.newID("cus"), OrgID: orgID, Name: strings.TrimSpace(in.Name), Email: strings.TrimSpace(in.Email),
+			DefaultPaymentMethod: in.DefaultPaymentMethod, Metadata: in.Metadata, CreatedAt: now.UTC()})
+		s.customers[c.ID] = c
+		s.customersByEmail[customerEmailKey(orgID, c.Email)] = c.ID
+		out = append(out, copyCustomer(c))
+	}
+	return out, nil
+}
