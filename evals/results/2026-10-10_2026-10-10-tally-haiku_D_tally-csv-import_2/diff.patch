@@ -0,0 +1,48 @@
+package api_test
+
+import (
+	"net/http"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func TestImportCustomersEmailOfAnotherOrg(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Globex, "Elsewhere", "shared@example.com")
+
+	// Another organization's customer does not block the email: the import creates Acme's customer.
+	var out struct {
+		Created int              `json:"created"`
+		Items   []store.Customer `json:"items"`
+	}
+	e.MustDo(http.StatusCreated, "POST", importPath, e.Acme.Key, "name,email\nAnn,SHARED@example.com\n", &out)
+	if out.Created != 1 || len(out.Items) != 1 || out.Items[0].OrgID != e.Acme.ID {
+		t.Fatalf("import = %+v", out)
+	}
+
+	// Each organization finds its own customer by email, and the import's duplicate check sees Acme's customer.
+	var list struct {
+		Items []store.Customer `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers?email=shared@example.com", e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 || list.Items[0].ID != out.Items[0].ID {
+		t.Fatalf("Acme's email lookup = %+v", list.Items)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers?email=shared@example.com", e.Globex.Key, nil, &list)
+	if len(list.Items) != 1 || list.Items[0].OrgID != e.Globex.ID {
+		t.Fatalf("Globex's email lookup = %+v", list.Items)
+	}
+	r := e.Do("POST", importPath, e.Acme.Key, "name,email\nBo,shared@example.com\n")
+	if r.Code != http.StatusUnprocessableEntity {
+		t.Fatalf("second import: %s", r)
+	}
+	var bad struct {
+		Rows []badRow `json:"rows"`
+	}
+	r.JSON(t, &bad)
+	if len(bad.Rows) != 1 || bad.Rows[0].Error != "email_taken" {
+		t.Fatalf("second import rows = %+v", bad.Rows)
+	}
+}
diff --git a/result/internal/api/customers_import_test.go b/result/internal/api/customers_import_test.go
new file mode 100644
index 0000000..9eeadeb
--- /dev/null
+++ b/result/internal/api/customers_import_test.go
@@ -0,0 +1,164 @@
+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+const importPath = "/v1/customers/import"
+
+// badRow is one entry of an invalid_rows answer.
+type badRow struct {
+	Row   int    `json:"row"`
+	Error string `json:"error"`
+}
+
+func TestImportCustomers(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Existing", "existing@example.com")
+	body := "\xEF\xBB\xBF Email , NAME ,ignored,Metadata.Plan,default_payment_method\r\n" +
+		"jane@example.com,\"Doe, Jane\",x,gold,pm_1\r\n" +
+		"\r\n" +
+		"bob@example.com,\"Bob \"\"B\"\" Smith\",x,,\r\n" +
+		"carol@example.com,\"Carol\nLine\",x,\"tier, 2\",\r\n"
+	events := len(e.Store.Events(e.Acme.ID, "customer.created"))
+
+	var out struct {
+		Created int              `json:"created"`
+		Items   []store.Customer `json:"items"`
+	}
+	e.MustDo(http.StatusCreated, "POST", importPath, e.Acme.Key, body, &out)
+	if out.Created != 3 || len(out.Items) != 3 {
+		t.Fatalf("import = %+v", out)
+	}
+	jane, bob, carol := out.Items[0], out.Items[1], out.Items[2]
+	if jane.Name != "Doe, Jane" || jane.Email != "jane@example.com" || jane.DefaultPaymentMethod != "pm_1" || jane.Metadata["Plan"] != "gold" {
+		t.Fatalf("jane = %+v", jane)
+	}
+	if bob.Name != `Bob "B" Smith` || bob.DefaultPaymentMethod != "" || len(bob.Metadata) != 0 {
+		t.Fatalf("bob = %+v", bob)
+	}
+	if carol.Name != "Carol\nLine" || carol.Metadata["Plan"] != "tier, 2" {
+		t.Fatalf("carol = %+v", carol)
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 4 {
+		t.Fatalf("customers = %d, want 4", n)
+	}
+	if n := len(e.Store.Events(e.Acme.ID, "customer.created")) - events; n != 3 {
+		t.Fatalf("customer.created events = %d, want 3", n)
+	}
+	if r := e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Bob 2", "email": "BOB@example.com"}); r.Code != http.StatusConflict {
+		t.Fatalf("imported email is not taken: %s", r)
+	}
+}
+
+func TestImportCustomersDryRun(t *testing.T) {
+	e := apitest.New(t)
+	var out map[string]int
+	e.MustDo(http.StatusOK, "POST", importPath+"?dry_run=true", e.Acme.Key, "name,email\nJane,jane@example.com\nBob,bob@example.com\n", &out)
+	if out["created"] != 0 || out["would_create"] != 2 {
+		t.Fatalf("dry run = %v", out)
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 0 {
+		t.Fatalf("dry run created %d customers", n)
+	}
+
+	r := e.MustDo(http.StatusCreated, "POST", importPath, e.Acme.Key, "name,email\n", nil)
+	if !strings.Contains(string(r.Body), `"items":[]`) {
+		t.Fatalf("header-only import = %s", r.Body)
+	}
+}
+
+func TestImportCustomersBadHeader(t *testing.T) {
+	e := apitest.New(t)
+	for _, body := range []string{"", "\n\r\n", "name,phone\nJane,555\n", "email\njane@example.com\n", "Name,Email2\nx,y\n"} {
+		for _, path := range []string{importPath, importPath + "?dry_run=true"} {
+			if r := e.Do("POST", path, e.Acme.Key, body); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_header" {
+				t.Fatalf("header %q: %s", body, r)
+			}
+		}
+	}
+}
+
+func TestImportCustomersInvalidCSV(t *testing.T) {
+	e := apitest.New(t)
+	for _, body := range []string{
+		"name,email\n\"Jane,jane@example.com\n", // unterminated quote
+		"name,email\nJane\n",                    // too few fields
+		"name,email\nJane,jane@example.com,x\n", // too many fields
+		"name,email\nJa\"ne,jane@example.com\n", // quote inside an unquoted field
+	} {
+		if r := e.Do("POST", importPath, e.Acme.Key, body); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_csv" {
+			t.Fatalf("%q: %s", body, r)
+		}
+	}
+}
+
+func TestImportCustomersTooManyRows(t *testing.T) {
+	e := apitest.New(t)
+	var b strings.Builder
+	b.WriteString("name,email\n")
+	for i := range 10000 {
+		fmt.Fprintf(&b, "Customer %d,c%d@example.com\n", i, i)
+	}
+	var out map[string]int
+	e.MustDo(http.StatusOK, "POST", importPath+"?dry_run=true", e.Acme.Key, b.String(), &out)
+	if out["would_create"] != 10000 {
+		t.Fatalf("10,000 rows: %v", out)
+	}
+	more := b.String() + "Extra,extra@example.com\n"
+	for _, path := range []string{importPath, importPath + "?dry_run=true"} {
+		if r := e.Do("POST", path, e.Acme.Key, more); r.Code != http.StatusRequestEntityTooLarge || r.Map(t)["error"] != "too_many_rows" {
+			t.Fatalf("10,001 rows (%s): %s", path, r)
+		}
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 0 {
+		t.Fatalf("too many rows created %d customers", n)
+	}
+}
+
+func TestImportCustomersInvalidRows(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Existing", "existing@example.com")
+	// Records by the line they start on: 2 Ann, 3 no name, 4 bad email, 5 a multi-line record, 7 taken, 8 repeated email,
+	// 9 empty email, 10 blank everything, 11 no name with a repeated email, 12 repeated email with a bad payment method.
+	body := strings.Join([]string{
+		"name,email,default_payment_method",
+		"Ann,ann@example.com,pm_1",
+		",bo@example.com,",
+		"Cy,not-an-email,",
+		"\"Dee",
+		"Multi\",dee@example.com,card_9",
+		"Eve,EXISTING@example.com,",
+		"Fay,ann@EXAMPLE.com,",
+		"Gus,,",
+		",,",
+		"   ,ann@example.com,",
+		"Jo,ann@example.com,bad",
+		"",
+	}, "\n")
+	want := []badRow{
+		{3, "missing_name"}, {4, "invalid_email"}, {5, "invalid_payment_method"}, {7, "email_taken"}, {8, "duplicate_email"},
+		{9, "invalid_email"}, {10, "missing_name"}, {11, "missing_name"}, {12, "invalid_payment_method"},
+	}
+	for _, path := range []string{importPath, importPath + "?dry_run=true"} {
+		var got struct {
+			Error string   `json:"error"`
+			Rows  []badRow `json:"rows"`
+		}
+		r := e.Do("POST", path, e.Acme.Key, body)
+		r.JSON(t, &got)
+		if r.Code != http.StatusUnprocessableEntity || got.Error != "invalid_rows" || !reflect.DeepEqual(got.Rows, want) {
+			t.Fatalf("%s: %s", path, r)
+		}
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 1 {
+		t.Fatalf("invalid file created customers: %d", n)
+	}
+}
