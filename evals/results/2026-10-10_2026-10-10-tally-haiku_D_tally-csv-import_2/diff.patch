diff --git a/result/internal/api/customers_import.go b/result/internal/api/customers_import.go
new file mode 100644
index 0000000..1e0c773
--- /dev/null
+++ b/result/internal/api/customers_import.go
@@ -0,0 +1,218 @@
+package api
+
+import (
+	"bufio"
+	"encoding/csv"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// maxImportRows is the most data records one import takes.
+const maxImportRows = 10000
+
+// metadataPrefix starts the header of a column that fills a metadata key ("metadata.plan").
+const metadataPrefix = "metadata."
+
+// importColumns says where each field of a customer is in the file: -1 when the header has no such column.
+type importColumns struct {
+	name, email, paymentMethod int
+	metadata                   []metadataColumn
+}
+
+type metadataColumn struct {
+	key string
+	col int
+}
+
+// importRow is a data record of an import, with the line it starts on and the first problem with it ("" when it has none).
+type importRow struct {
+	line     int
+	customer store.NewCustomer
+	problem  string
+}
+
+// rowError is one bad record in an invalid_rows answer.
+type rowError struct {
+	Row  int    `json:"row"`
+	Code string `json:"error"`
+}
+
+// importCustomers creates the customers listed in a CSV body: the first record is the header, then one record per customer.
+// Every record is checked before anything is created, so a file with a bad record creates nothing. With ?dry_run=true it is
+// only checked.
+func (s *Server) importCustomers(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	cr := csv.NewReader(skipBOM(r.Body))
+	cr.FieldsPerRecord = -1 // checked below, after blank lines are skipped
+	head, _, err := nextRecord(cr)
+	if errors.Is(err, io.EOF) {
+		importError(w, http.StatusUnprocessableEntity, "invalid_header")
+		return
+	}
+	if err != nil {
+		importError(w, http.StatusBadRequest, "invalid_csv")
+		return
+	}
+	cols, ok := importHeader(head)
+	if !ok {
+		importError(w, http.StatusUnprocessableEntity, "invalid_header")
+		return
+	}
+
+	var rows []importRow
+	seen := map[string]bool{} // lower-case emails of the records so far
+	for {
+		rec, line, err := nextRecord(cr)
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil || len(rec) != len(head) {
+			importError(w, http.StatusBadRequest, "invalid_csv")
+			return
+		}
+		if len(rows) == maxImportRows {
+			importError(w, http.StatusRequestEntityTooLarge, "too_many_rows")
+			return
+		}
+		nc, problem := s.checkImportRecord(p.OrgID, rec, cols, seen)
+		rows = append(rows, importRow{line: line, customer: nc, problem: problem})
+	}
+
+	var bad []rowError
+	for _, row := range rows {
+		if row.problem != "" {
+			bad = append(bad, rowError{Row: row.line, Code: row.problem})
+		}
+	}
+	if len(bad) > 0 {
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]any{"error": "invalid_rows", "rows": bad})
+		return
+	}
+	if r.URL.Query().Get("dry_run") == "true" {
+		writeJSON(w, http.StatusOK, map[string]int{"created": 0, "would_create": len(rows)})
+		return
+	}
+	ins := make([]store.NewCustomer, len(rows))
+	for i, row := range rows {
+		ins[i] = row.customer
+	}
+	cs, err := s.store.CreateCustomers(p.OrgID, ins, s.clock.Now())
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	for _, c := range cs {
+		s.publish(r.Context(), p.OrgID, "customer.created", c)
+	}
+	writeJSON(w, http.StatusCreated, map[string]any{"created": len(cs), "items": cs})
+}
+
+// checkImportRecord checks one record like POST /v1/customers does, and returns the customer it describes with the first
+// problem that applies ("" when there is none). seen holds the lower-case email addresses of the records before it.
+func (s *Server) checkImportRecord(orgID string, rec []string, cols importColumns, seen map[string]bool) (store.NewCustomer, string) {
+	nc := store.NewCustomer{Name: strings.TrimSpace(rec[cols.name]), Email: strings.TrimSpace(rec[cols.email])}
+	if cols.paymentMethod >= 0 {
+		nc.DefaultPaymentMethod = strings.TrimSpace(rec[cols.paymentMethod])
+	}
+	for _, mc := range cols.metadata {
+		if v := strings.TrimSpace(rec[mc.col]); v != "" {
+			if nc.Metadata == nil {
+				nc.Metadata = map[string]string{}
+			}
+			nc.Metadata[mc.key] = v
+		}
+	}
+
+	// An earlier record counts for its email address even when that record has another problem.
+	emailOK := store.ValidEmail(nc.Email)
+	key := strings.ToLower(nc.Email)
+	earlier := emailOK && seen[key]
+	if emailOK {
+		seen[key] = true
+	}
+	switch {
+	case nc.Name == "":
+		return nc, "missing_name"
+	case !emailOK:
+		return nc, "invalid_email"
+	case nc.DefaultPaymentMethod != "" && !strings.HasPrefix(nc.DefaultPaymentMethod, "pm_"):
+		return nc, "invalid_payment_method"
+	}
+	if _, ok := s.store.FindCustomerByEmail(orgID, nc.Email); ok {
+		return nc, "email_taken"
+	}
+	if earlier {
+		return nc, "duplicate_email"
+	}
+	return nc, ""
+}
+
+// importHeader finds the columns of a header: name and email are required, and a column named "metadata.<key>" fills that
+// metadata key. Names match ignoring case and surrounding spaces; the first column with a name is the one used.
+func importHeader(head []string) (importColumns, bool) {
+	cols := importColumns{name: -1, email: -1, paymentMethod: -1}
+	keys := map[string]bool{}
+	for i, h := range head {
+		h = strings.TrimSpace(h)
+		switch strings.ToLower(h) {
+		case "name":
+			cols.name = firstColumn(cols.name, i)
+		case "email":
+			cols.email = firstColumn(cols.email, i)
+		case "default_payment_method":
+			cols.paymentMethod = firstColumn(cols.paymentMethod, i)
+		}
+		if len(h) > len(metadataPrefix) && strings.EqualFold(h[:len(metadataPrefix)], metadataPrefix) {
+			key := strings.TrimSpace(h[len(metadataPrefix):])
+			if key != "" && !keys[key] {
+				keys[key] = true
+				cols.metadata = append(cols.metadata, metadataColumn{key: key, col: i})
+			}
+		}
+	}
+	return cols, cols.name >= 0 && cols.email >= 0
+}
+
+func firstColumn(cur, i int) int {
+	if cur < 0 {
+		return i
+	}
+	return cur
+}
+
+// nextRecord returns the next record that is not blank, and the line it starts on. It returns io.EOF after the last one.
+func nextRecord(cr *csv.Reader) ([]string, int, error) {
+	for {
+		rec, err := cr.Read()
+		if err != nil {
+			return nil, 0, err
+		}
+		if !blankRecord(rec) {
+			line, _ := cr.FieldPos(0)
+			return rec, line, nil
+		}
+	}
+}
+
+// blankRecord says whether a line is blank: one field of spaces. A line of commas is a record with empty fields, not a blank line.
+func blankRecord(rec []string) bool {
+	return len(rec) == 1 && strings.TrimSpace(rec[0]) == ""
+}
+
+// skipBOM returns r without the UTF-8 byte order mark at its start, if it has one.
+func skipBOM(r io.Reader) io.Reader {
+	br := bufio.NewReader(r)
+	if b, err := br.Peek(3); err == nil && string(b) == "\xef\xbb\xbf" {
+		_, _ = br.Discard(3)
+	}
+	return br
+}
+
+// importError answers {"error": code}, the shape the import's errors have.
+func importError(w http.ResponseWriter, status int, code string) {
+	writeJSON(w, status, map[string]string{"error": code})
+}
