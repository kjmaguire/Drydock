diff --git a/result/internal/store/create_customers_test.go b/result/internal/store/create_customers_test.go
new file mode 100644
index 0000000..2cae267
--- /dev/null
+++ b/result/internal/store/create_customers_test.go
@@ -0,0 +1,135 @@
+package store
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestCreateCustomers(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	other := newOrg(t, s, "Other")
+	if _, err := s.CreateCustomer(o.ID, "Existing", "ex@example.com", t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateCustomer(other.ID, "Elsewhere", "far@example.com", t0); err != nil {
+		t.Fatal(err)
+	}
+
+	// Nothing is created when any customer in the batch cannot be.
+	for _, c := range []struct {
+		name string
+		ins  []NewCustomer
+		want error
+	}{
+		{"taken", []NewCustomer{{Name: "A", Email: "new@example.com"}, {Name: "B", Email: "EX@example.com"}}, ErrEmailTaken},
+		{"repeated in the batch", []NewCustomer{{Name: "A", Email: "a@example.com"}, {Name: "B", Email: " A@example.com "}}, ErrEmailTaken},
+		{"no name", []NewCustomer{{Name: " ", Email: "x@example.com"}}, ErrInvalid},
+		{"bad email", []NewCustomer{{Name: "A", Email: "nope"}}, ErrInvalid},
+		{"bad payment method", []NewCustomer{{Name: "A", Email: "a@example.com", DefaultPaymentMethod: "card_1"}}, ErrInvalid},
+	} {
+		if _, err := s.CreateCustomers(o.ID, c.ins, t0); !errors.Is(err, c.want) {
+			t.Fatalf("%s: err = %v, want %v", c.name, err, c.want)
+		}
+		if n := len(s.Customers(o.ID)); n != 1 {
+			t.Fatalf("%s: %d customers, want 1", c.name, n)
+		}
+	}
+	if _, err := s.CreateCustomers("org_missing", []NewCustomer{{Name: "A", Email: "a@example.com"}}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("unknown org: %v", err)
+	}
+
+	// An email address used by another organization is free here.
+	metadata := map[string]string{"plan": "gold"}
+	cs, err := s.CreateCustomers(o.ID, []NewCustomer{
+		{Name: "Jane", Email: " Jane@example.com ", Metadata: metadata},
+		{Name: "Far", Email: "far@example.com"},
+		{Name: "Bo", Email: "bo@example.com", DefaultPaymentMethod: "pm_1"},
+	}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(cs) != 3 || cs[0].Email != "Jane@example.com" || cs[1].Name != "Far" || cs[2].DefaultPaymentMethod != "pm_1" {
+		t.Fatalf("customers = %+v", cs)
+	}
+	if !(cs[0].ID < cs[1].ID && cs[1].ID < cs[2].ID) {
+		t.Fatalf("IDs are not in order: %s %s %s", cs[0].ID, cs[1].ID, cs[2].ID)
+	}
+	metadata["plan"] = "changed" // the stored customer keeps its own copy
+	if got, ok := s.FindCustomerByEmail(o.ID, "JANE@example.com"); !ok || got.Metadata["plan"] != "gold" {
+		t.Fatalf("stored customer = %+v, %v", got, ok)
+	}
+	if n := len(s.Customers(o.ID)); n != 4 {
+		t.Fatalf("customers = %d, want 4", n)
+	}
+}
+
+func TestCustomerEmailsArePerOrg(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, err := s.CreateCustomer(a.ID, "Ann", "shared@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Another organization's customer does not block the address, and it is indexed after Ann's.
+	cb, err := s.CreateCustomer(b.ID, "Bea", "SHARED@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	find := func(orgID string) (string, bool) {
+		c, ok := s.FindCustomerByEmail(orgID, "shared@example.com")
+		return c.ID, ok
+	}
+	if id, ok := find(a.ID); !ok || id != ca.ID {
+		t.Fatalf("A's lookup = %s %v, want %s", id, ok, ca.ID)
+	}
+	if id, ok := find(b.ID); !ok || id != cb.ID {
+		t.Fatalf("B's lookup = %s %v, want %s", id, ok, cb.ID)
+	}
+
+	// A duplicate within A is still caught after B shares the address.
+	if _, err := s.CreateCustomer(a.ID, "Again", "shared@example.com", t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("CreateCustomer in A: %v", err)
+	}
+	if _, err := s.CreateCustomers(a.ID, []NewCustomer{{Name: "Again", Email: "shared@example.com"}}, t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("CreateCustomers in A: %v", err)
+	}
+
+	// Updating or deleting A's customer frees only A's address.
+	if _, err := s.UpdateCustomer(a.ID, ca.ID, func(c *Customer) error {
+		c.Email = "ann@example.com"
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := find(a.ID); ok {
+		t.Fatal("A still finds the address it changed")
+	}
+	if id, ok := find(b.ID); !ok || id != cb.ID {
+		t.Fatalf("B's lookup after A's update = %s %v", id, ok)
+	}
+	if _, err := s.CreateCustomer(a.ID, "Ann again", "shared@example.com", t0); err != nil {
+		t.Fatalf("address freed by A's update: %v", err)
+	}
+	if err := s.DeleteCustomer(b.ID, cb.ID); err != nil {
+		t.Fatal(err)
+	}
+	if id, ok := find(a.ID); !ok || id == ca.ID {
+		t.Fatalf("A's lookup after B's delete = %s %v", id, ok)
+	}
+	if _, ok := find(b.ID); ok {
+		t.Fatal("B finds a deleted customer")
+	}
+
+	// The per-organization index survives a snapshot round trip.
+	st, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := st.CreateCustomer(b.ID, "Bea again", "shared@example.com", t0); err != nil {
+		t.Fatalf("B's address after restore: %v", err)
+	}
+	if _, err := st.CreateCustomer(a.ID, "Ann third", "shared@example.com", t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("A's duplicate after restore: %v", err)
+	}
+}
