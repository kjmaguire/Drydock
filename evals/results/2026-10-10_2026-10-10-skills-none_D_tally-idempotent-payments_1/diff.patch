+func TestPayRefusesASecondPaymentWhileOneIsUnderWay(t *testing.T) {
+	s, gw, _, inv := setup(t, store.Line{Description: "x", Quantity: 1, UnitAmount: 500})
+	entered, release := make(chan struct{}), make(chan struct{})
+	var hold sync.Once
+	gw.OnCharge = func(ChargeRequest) {
+		hold.Do(func() {
+			close(entered)
+			<-release
+		})
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa")
+		done <- err
+	}()
+	<-entered
+
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); !errors.Is(err, ErrPaymentInProgress) {
+		t.Fatalf("second payment: err = %v, want ErrPaymentInProgress", err)
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatalf("first payment: %v", err)
+	}
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); !errors.Is(err, ErrAlreadyPaid) {
+		t.Fatalf("payment after the first: err = %v, want ErrAlreadyPaid", err)
+	}
+	if n := len(gw.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+}
