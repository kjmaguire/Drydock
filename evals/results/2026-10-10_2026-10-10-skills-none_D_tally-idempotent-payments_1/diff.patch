+package api_test
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/payments"
+	"example.com/tally/internal/store"
+)
+
+// payPath is the pay endpoint of an invoice.
+func payPath(invoiceID string) string { return "/v1/invoices/" + invoiceID + "/pay" }
+
+// keyed is a request header with an Idempotency-Key.
+func keyed(key string) http.Header { return http.Header{"Idempotency-Key": {key}} }
+
+// newOpenInvoice creates an open invoice of org for 40.00 in EUR and returns its ID.
+func newOpenInvoice(t *testing.T, e *apitest.Env, org apitest.Org) string {
+	t.Helper()
+	n := len(e.Store.Customers(org.ID))
+	c := e.CreateCustomer(org, "Jane", fmt.Sprintf("jane%d@%s.example", n, strings.ToLower(org.Name)))
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", org.Key, map[string]any{"customer_id": c.ID, "currency": "EUR",
+		"lines": []any{map[string]any{"description": "Seats", "quantity": 1, "unit_amount": 4000}}}, &inv)
+	return inv.ID
+}
+
+// switchGateway is the payment gateway, which can be taken down and brought back.
+type switchGateway struct {
+	inner payments.Gateway
+	down  atomic.Bool
+}
+
+func (g *switchGateway) Charge(ctx context.Context, req payments.ChargeRequest) (payments.ChargeResult, error) {
+	if g.down.Load() {
+		return payments.ChargeResult{}, payments.ErrUnavailable
+	}
+	return g.inner.Charge(ctx, req)
+}
+
+func TestPayIdempotencyKeyValidation(t *testing.T) {
+	e := apitest.New(t)
+	inv := newOpenInvoice(t, e, e.Acme)
+	bad := map[string]http.Header{
+		"empty":         keyed(""),
+		"too long":      keyed(strings.Repeat("k", 256)),
+		"non-ASCII":     keyed("clé"),
+		"control":       keyed("tab\there"),
+		"two values":    {"Idempotency-Key": {"a", "b"}},
+		"DEL character": keyed("a\x7f"),
+	}
+	for name, h := range bad {
+		r := e.DoWith("POST", payPath(inv), e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"}, h)
+		if r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_idempotency_key" {
+			t.Fatalf("%s: %s", name, r)
+		}
+	}
+	if n := len(e.Gateway.Calls()); n != 0 {
+		t.Fatalf("%d charges for rejected keys", n)
+	}
+	for _, key := range []string{strings.Repeat("k", 255), "a b~!"} {
+		if r := e.DoWith("POST", payPath(inv), e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"}, keyed(key)); r.Code == http.StatusBadRequest {
+			t.Fatalf("key %q: %s", key, r)
+		}
+	}
+}
+
+func TestPayReplaysTheFirstResponse(t *testing.T) {
+	e := apitest.New(t)
+	inv := newOpenInvoice(t, e, e.Acme)
+	body := map[string]string{"payment_method": "pm_card_visa"}
+
+	first := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("order-1"))
+	if first.Code != http.StatusOK || first.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("first: %s", first)
+	}
+	again := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("order-1"))
+	if again.Code != http.StatusOK || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("retry: %s", again)
+	}
+	if string(again.Body) != string(first.Body) {
+		t.Fatalf("retry body = %s, want %s", again.Body, first.Body)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+	if r := e.Do("POST", payPath(inv), e.Acme.Key, body); r.Code != http.StatusConflict || r.Map(t)["error"] != "already_paid" {
+		t.Fatalf("pay without key after paying: %s", r)
+	}
+}
+
+func TestPayKeepsDeclinesAndOtherClientErrors(t *testing.T) {
+	e := apitest.New(t)
+	inv := newOpenInvoice(t, e, e.Acme)
+	body := map[string]string{"payment_method": "pm_card_declined"}
+	first := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("declined"))
+	if first.Code != http.StatusPaymentRequired {
+		t.Fatalf("first: %s", first)
+	}
+	again := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("declined"))
+	if again.Code != http.StatusPaymentRequired || again.Header.Get("Idempotent-Replayed") != "true" || string(again.Body) != string(first.Body) {
+		t.Fatalf("retry of a decline: %s", again)
+	}
+	if n := len(e.Gateway.Calls()); n != 1 {
+		t.Fatalf("%d gateway calls, want 1", n)
+	}
+}
+
+func TestPayKeyReusedForAnotherInvoiceOrBody(t *testing.T) {
+	e := apitest.New(t)
+	inv := newOpenInvoice(t, e, e.Acme)
+	other := newOpenInvoice(t, e, e.Acme)
+	e.DoWith("POST", payPath(inv), e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"}, keyed("k1"))
+
+	for name, c := range map[string]struct {
+		invoice string
+		body    map[string]string
+	}{
+		"another invoice": {other, map[string]string{"payment_method": "pm_card_visa"}},
+		"another body":    {inv, map[string]string{"payment_method": "pm_card_declined"}},
+	} {
+		r := e.DoWith("POST", payPath(c.invoice), e.Acme.Key, c.body, keyed("k1"))
+		if r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+			t.Fatalf("%s: %s", name, r)
+		}
+	}
+	if n := len(e.Gateway.Calls()); n != 1 {
+		t.Fatalf("%d gateway calls, want 1", n)
+	}
+}
+
+func TestPayKeysBelongToAnOrganization(t *testing.T) {
+	e := apitest.New(t)
+	acme := newOpenInvoice(t, e, e.Acme)
+	globex := newOpenInvoice(t, e, e.Globex)
+	body := map[string]string{"payment_method": "pm_card_visa"}
+	e.MustDo(http.StatusOK, "POST", payPath(acme), e.Acme.Key, body, nil)
+	r := e.DoWith("POST", payPath(globex), e.Globex.Key, body, keyed("shared"))
+	if r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("other organization with the same key: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("%d charges, want 2", n)
+	}
+}
+
+func TestPayKeyInProgressAnswersAtOnce(t *testing.T) {
+	e := apitest.New(t)
+	inv := newOpenInvoice(t, e, e.Acme)
+	body := map[string]string{"payment_method": "pm_card_visa"}
+
+	entered, release := make(chan struct{}), make(chan struct{})
+	var hold sync.Once
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		hold.Do(func() {
+			close(entered)
+			<-release
+		})
+	}
+	first := make(chan *apitest.Response, 1)
+	go func() { first <- e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("slow")) }()
+	<-entered
+
+	second := make(chan *apitest.Response, 1)
+	go func() { second <- e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("slow")) }()
+	select {
+	case r := <-second:
+		if r.Code != http.StatusConflict || r.Map(t)["error"] != "request_in_progress" {
+			t.Fatalf("same key while in progress: %s", r)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("a request with a key in progress waited instead of answering 409")
+	}
+
+	// Without a key, the invoice is still being charged, so the request gets payment_in_progress.
+	if r := e.Do("POST", payPath(inv), e.Acme.Key, body); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("no key while in progress: %s", r)
+	}
+	// A keyed request refused with payment_in_progress is a kept 409 like any other non-5xx answer, so its retry gets it back.
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("refused")); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("keyed while in progress: %s", r)
+	}
+
+	close(release)
+	if r := <-first; r.Code != http.StatusOK {
+		t.Fatalf("first request: %s", r)
+	}
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("slow")); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("retry after the first finished: %s", r)
+	}
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("refused")); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("retry of the refused request: %s", r)
+	}
+	// A new key is handled afresh, and the invoice is paid, so it is refused as such.
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("fresh")); r.Code != http.StatusConflict || r.Map(t)["error"] != "already_paid" || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("new key after the payment: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+}
+
+func TestPayRetriesAfterServerErrors(t *testing.T) {
+	e := apitest.New(t)
+	inv := newOpenInvoice(t, e, e.Acme)
+	gw := &switchGateway{inner: e.Gateway}
+	gw.down.Store(true)
+	e.Payments.Gateway = gw
+	body := map[string]string{"payment_method": "pm_card_visa"}
+
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("flaky")); r.Code != http.StatusServiceUnavailable || r.Map(t)["error"] != "gateway_unavailable" {
+		t.Fatalf("gateway down: %s", r)
+	}
+	gw.down.Store(false)
+	r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("flaky"))
+	if r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("retry after the gateway came back: %s", r)
+	}
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("flaky")); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("second retry: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+}
+
+func TestPayKeyExpiresAfterADay(t *testing.T) {
+	e := apitest.New(t)
+	inv := newOpenInvoice(t, e, e.Acme)
+	body := map[string]string{"payment_method": "pm_card_visa"}
+	e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("day"))
+
+	e.Clock.Advance(24*time.Hour - time.Minute)
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("day")); r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("23h59m later: %s", r)
+	}
+	e.Clock.Advance(time.Minute)
+	// The key counts as new now, so the request is handled again: the invoice is paid, so it is refused as such.
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("day")); r.Code != http.StatusConflict || r.Map(t)["error"] != "already_paid" || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("24h later: %s", r)
+	}
+}
