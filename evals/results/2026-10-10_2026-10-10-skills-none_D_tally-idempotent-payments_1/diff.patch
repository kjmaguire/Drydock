+package api
+
+import (
+	"bytes"
+	"net/http"
+	"sync"
+	"time"
+
+	"example.com/tally/internal/auth"
+)
+
+// idempotencyTTL is how long a kept response is replayed.
+const idempotencyTTL = 24 * time.Hour
+
+// idempotency keeps the first answer to a request that carried an Idempotency-Key, so that a retry gets the same answer
+// back instead of charging again. Keys belong to an organization.
+type idempotency struct {
+	mu      sync.Mutex
+	entries map[idemKey]*idemEntry
+}
+
+type idemKey struct{ org, key string }
+
+type idemEntry struct {
+	invoiceID     string
+	paymentMethod string
+	done          bool // the response is kept; until then the request is still being handled
+	keptAt        time.Time
+	resp          capturedResponse
+}
+
+// capturedResponse is an answer as it was written, so that it can be written again.
+type capturedResponse struct {
+	status int
+	header http.Header
+	body   []byte
+}
+
+type idemState int
+
+const (
+	idemNew        idemState = iota // the key is new: handle the request
+	idemInProgress                  // a request with the key is still being handled
+	idemReused                      // the key was used for another invoice or body
+	idemReplay                      // the first request's response is kept
+)
+
+func newIdempotency() *idempotency {
+	return &idempotency{entries: map[idemKey]*idemEntry{}}
+}
+
+// begin claims the key for a request to pay invoiceID with paymentMethod, or says what the key already stands for.
+func (i *idempotency) begin(k idemKey, invoiceID, paymentMethod string, now time.Time) (idemState, capturedResponse) {
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	e, ok := i.entries[k]
+	if ok && e.done && !now.Before(e.keptAt.Add(idempotencyTTL)) {
+		ok = false // expired: the key counts as new
+	}
+	if !ok {
+		i.entries[k] = &idemEntry{invoiceID: invoiceID, paymentMethod: paymentMethod}
+		return idemNew, capturedResponse{}
+	}
+	switch {
+	case e.invoiceID != invoiceID || e.paymentMethod != paymentMethod:
+		return idemReused, capturedResponse{}
+	case !e.done:
+		return idemInProgress, capturedResponse{}
+	}
+	return idemReplay, e.resp
+}
+
+// finish ends a request begun with begin. A kept response is replayed from now on; otherwise the key is forgotten, so
+// that a retry is handled again.
+func (i *idempotency) finish(k idemKey, keep bool, resp capturedResponse, now time.Time) {
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	if !keep {
+		delete(i.entries, k)
+		return
+	}
+	e := i.entries[k]
+	e.done, e.keptAt, e.resp = true, now, resp
+}
+
+// abandon forgets the key of a request that ended without a response (a panic), unless its response was kept.
+func (i *idempotency) abandon(k idemKey) {
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	if e, ok := i.entries[k]; ok && !e.done {
+		delete(i.entries, k)
+	}
+}
+
+// idempotencyKey reads the Idempotency-Key header: "" when there is none, or 1 to 255 printable ASCII characters. Otherwise
+// it answers 400 and returns false.
+func idempotencyKey(w http.ResponseWriter, r *http.Request) (string, bool) {
+	vs := r.Header.Values("Idempotency-Key")
+	if len(vs) == 0 {
+		return "", true
+	}
+	key := vs[0]
+	if len(vs) > 1 || len(key) < 1 || len(key) > 255 || !printableASCII(key) {
+		writeError(w, http.StatusBadRequest, "invalid_idempotency_key", "Idempotency-Key is 1 to 255 printable ASCII characters")
+		return "", false
+	}
+	return key, true
+}
+
+func printableASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < 0x20 || s[i] > 0x7e {
+			return false
+		}
+	}
+	return true
+}
+
+// chargeWithKey pays an invoice for a request that carried an Idempotency-Key.
+func (s *Server) chargeWithKey(w http.ResponseWriter, r *http.Request, p auth.Principal, key, invoiceID, paymentMethod string) {
+	k := idemKey{org: p.OrgID, key: key}
+	state, resp := s.idem.begin(k, invoiceID, paymentMethod, s.clock.Now())
+	switch state {
+	case idemReused:
+		writeError(w, http.StatusUnprocessableEntity, "idempotency_key_reused", "this Idempotency-Key was used for another invoice or request body")
+		return
+	case idemInProgress:
+		writeError(w, http.StatusConflict, "request_in_progress", "a request with this Idempotency-Key is still being handled")
+		return
+	case idemReplay:
+		resp.write(w, true)
+		return
+	}
+	finished := false
+	defer func() {
+		if !finished {
+			s.idem.abandon(k)
+		}
+	}()
+	cw := &captureWriter{header: http.Header{}}
+	s.charge(cw, r, p.OrgID, invoiceID, paymentMethod)
+	resp = cw.response()
+	// A 5xx is not kept, so that a retry tries again. Every other response is kept and replayed.
+	keep := resp.status < http.StatusInternalServerError
+	s.idem.finish(k, keep, resp, s.clock.Now())
+	finished = true
+	resp.write(w, false)
+}
+
+// captureWriter records a response so that it can be kept and written again.
+type captureWriter struct {
+	header http.Header
+	status int
+	body   bytes.Buffer
+}
+
+func (c *captureWriter) Header() http.Header { return c.header }
+
+func (c *captureWriter) WriteHeader(status int) {
+	if c.status == 0 {
+		c.status = status
+	}
+}
+
+func (c *captureWriter) Write(b []byte) (int, error) {
+	c.WriteHeader(http.StatusOK)
+	return c.body.Write(b)
+}
+
+func (c *captureWriter) response() capturedResponse {
+	c.WriteHeader(http.StatusOK)
+	return capturedResponse{status: c.status, header: c.header, body: c.body.Bytes()}
+}
+
+// write sends the response. A replayed one is marked with Idempotent-Replayed: true.
+func (c capturedResponse) write(w http.ResponseWriter, replayed bool) {
+	for k, v := range c.header {
+		w.Header()[k] = append([]string(nil), v...)
+	}
+	if replayed {
+		w.Header().Set("Idempotent-Replayed", "true")
+	}
+	w.WriteHeader(c.status)
+	_, _ = w.Write(c.body)
+}
