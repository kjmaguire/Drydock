+// checkTiers checks a tiered plan's mode and tiers. Only a metered plan can be tiered.
+func checkTiers(p Plan) error {
+	switch {
+	case p.UsageType != Metered:
+		return invalidTiers("only a metered plan can have tiers")
+	case p.TiersMode != Graduated && p.TiersMode != Volume:
+		return invalidTiers("tiers_mode is graduated or volume")
+	case len(p.Tiers) == 0:
+		return invalidTiers("a tiered plan needs at least one tier")
+	}
+	for i, t := range p.Tiers {
+		last := i == len(p.Tiers)-1
+		switch {
+		case t.UnitAmount < 0 || t.FlatAmount < 0:
+			return invalidTiers("a tier's amounts cannot be negative")
+		case last && t.UpTo != nil:
+			return invalidTiers("the last tier has no up_to")
+		case !last && t.UpTo == nil:
+			return invalidTiers("only the last tier has no up_to")
+		case !last && *t.UpTo <= 0:
+			return invalidTiers("up_to is a positive whole number")
+		case !last && i > 0 && *t.UpTo <= *p.Tiers[i-1].UpTo:
+			return invalidTiers("tiers are sorted by up_to, strictly ascending")
+		}
+	}
+	return nil
+}
