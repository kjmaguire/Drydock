+func TestTieredAmount(t *testing.T) {
+	// 0-10 units at 100 each; 11-20 at 80 each plus 50 flat; above 20 at 60 each plus 200 flat.
+	upTo := func(n int64) *int64 { return &n }
+	tiers := []store.Tier{
+		{UpTo: upTo(10), UnitAmount: 100},
+		{UpTo: upTo(20), UnitAmount: 80, FlatAmount: 50},
+		{UnitAmount: 60, FlatAmount: 200},
+	}
+	for _, c := range []struct {
+		mode store.TiersMode
+		q    int64
+		want int64
+	}{
+		{store.Graduated, 0, 0},
+		{store.Graduated, 1, 100},
+		{store.Graduated, 10, 1000}, // the flat amount of tier 2 is not charged: no unit falls in it
+		{store.Graduated, 11, 1000 + 80 + 50},
+		{store.Graduated, 20, 1000 + 800 + 50},
+		{store.Graduated, 21, 1000 + 800 + 50 + 60 + 200},
+		{store.Graduated, 25, 1000 + 800 + 50 + 5*60 + 200},
+		{store.Volume, 0, 0},
+		{store.Volume, 1, 100},
+		{store.Volume, 10, 1000}, // up_to is inclusive: 10 is still tier 1
+		{store.Volume, 11, 11*80 + 50},
+		{store.Volume, 20, 20*80 + 50},
+		{store.Volume, 21, 21*60 + 200},
+		{store.Volume, 1000, 1000*60 + 200},
+	} {
+		if got := TieredAmount(tiers, c.mode, c.q); got != c.want {
+			t.Errorf("TieredAmount(%s, %d) = %d, want %d", c.mode, c.q, got, c.want)
+		}
+	}
+}
+
+func TestTieredAmountSingleTier(t *testing.T) {
+	flat := []store.Tier{{UnitAmount: 7, FlatAmount: 100}}
+	if got := TieredAmount(flat, store.Graduated, 3); got != 3*7+100 {
+		t.Errorf("graduated = %d", got)
+	}
+	if got := TieredAmount(flat, store.Volume, 3); got != 3*7+100 {
+		t.Errorf("volume = %d", got)
+	}
+	if got := TieredAmount(nil, store.Graduated, 3); got != 0 {
+		t.Errorf("no tiers = %d", got)
+	}
+}
