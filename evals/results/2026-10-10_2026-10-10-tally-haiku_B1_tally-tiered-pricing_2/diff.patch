+func TestTieredUsageBilledAtRenewal(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	upTo := func(n int64) *int64 { return &n }
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, Interval: store.Monthly, UsageType: store.Metered,
+		TiersMode: store.Graduated, Tiers: []store.Tier{{UpTo: upTo(10), UnitAmount: 100}, {UnitAmount: 50, FlatAmount: 300}}}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	start, end := sub.CurrentPeriodStart, sub.CurrentPeriodEnd
+	for _, u := range []struct {
+		q  int64
+		at time.Time
+	}{{20, start}, {5, start.Add(48 * time.Hour)}} {
+		if _, err := e.Store.AddUsage(e.Acme.ID, sub.ID, u.q, u.at, e.Clock.Now()); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	e.Clock.Set(end)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	// 25 units: the first 10 at 100 each; the other 15 at 50 each plus the tier's flat 300.
+	const want = 10*100 + 15*50 + 300
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 1 || len(invs[0].Lines) != 1 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	l := invs[0].Lines[0]
+	if l.Quantity != 1 || l.UnitAmount != want || !strings.HasPrefix(l.Description, "API calls") || invs[0].Status != store.InvoicePaid {
+		t.Fatalf("line = %+v, status %s", l, invs[0].Status)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 1 || cs[0].Amount != want {
+		t.Fatalf("charges = %+v", cs)
+	}
+
+	// A period with no usage is not invoiced, and the subscription stays active.
+	e.Clock.Set(sub.CurrentPeriodEnd.AddDate(0, 1, 0))
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("a period without usage was invoiced: %+v", invs)
+	}
+	if got, _ := e.Store.Subscription(e.Acme.ID, sub.ID); got.Status != store.Active {
+		t.Fatalf("status = %s", got.Status)
+	}
+}
