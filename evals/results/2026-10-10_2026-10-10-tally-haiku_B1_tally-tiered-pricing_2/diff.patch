+		"negative flat":      {UsageType: Metered, TiersMode: Volume, Tiers: []Tier{{UpTo: upTo(10)}, {FlatAmount: -1}}},
+	}
+	for name, in := range bad {
+		in.OrgID, in.Name, in.Currency, in.Interval = a.ID, "Bad", money.USD, Monthly
+		if _, err := s.CreatePlan(in, t0); !errors.Is(err, ErrInvalidTiers) || !errors.Is(err, ErrInvalid) {
+			t.Errorf("%s: CreatePlan err = %v, want ErrInvalidTiers", name, err)
+		}
+	}
+
+	if up, err := s.UpdatePlan(a.ID, p.ID, func(p *Plan) error { p.Tiers, p.TiersMode = nil, Volume; return nil }); err != nil ||
+		up.TiersMode != Graduated || len(up.Tiers) != 2 {
+		t.Fatalf("UpdatePlan = %+v, %v (the tiers must not change)", up, err)
+	}
+}
+
+func TestTieredPlanSurvivesExportAndFromState(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	upTo := int64(10)
+	p, err := s.CreatePlan(Plan{OrgID: a.ID, Name: "Usage", Currency: money.USD, Interval: Monthly, UsageType: Metered, TiersMode: Volume,
+		Tiers: []Tier{{UpTo: &upTo, UnitAmount: 100, FlatAmount: 5}, {UnitAmount: 50}}}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s2.Plan(a.ID, p.ID); !ok || !reflect.DeepEqual(got, p) {
+		t.Fatalf("after FromState: %+v, want %+v", got, p)
+	}
+}
