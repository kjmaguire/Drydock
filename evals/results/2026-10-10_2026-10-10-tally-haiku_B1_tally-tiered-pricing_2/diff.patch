+// TieredAmount is what quantity units of usage cost on a tiered plan, in minor units. Graduated: each unit is priced at the
+// unit amount of the tier it falls in, and every tier that at least one unit falls in adds its flat amount. Volume: every
+// unit is priced at the unit amount of the one tier the quantity falls in, which adds its flat amount. A tier's UpTo is
+// inclusive, and a quantity of 0 costs 0. An unknown mode costs 0; checkPlan refuses such plans.
+func TieredAmount(tiers []store.Tier, mode store.TiersMode, quantity int64) int64 {
+	if quantity <= 0 {
+		return 0
+	}
+	switch mode {
+	case store.Graduated:
+		var total, from int64 // units before the current tier
+		for _, t := range tiers {
+			if quantity <= from {
+				break
+			}
+			top := quantity
+			if t.UpTo != nil && *t.UpTo < top {
+				top = *t.UpTo
+			}
+			total += (top-from)*t.UnitAmount + t.FlatAmount
+			if t.UpTo == nil {
+				break
+			}
+			from = *t.UpTo
+		}
+		return total
+	case store.Volume:
+		for _, t := range tiers {
+			if t.UpTo == nil || quantity <= *t.UpTo {
+				return quantity*t.UnitAmount + t.FlatAmount
+			}
+		}
+	}
+	return 0
+}
