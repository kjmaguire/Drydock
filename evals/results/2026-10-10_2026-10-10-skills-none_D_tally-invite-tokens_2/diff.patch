+// lastInviteToken returns the token in the link of the newest invite email.
+func lastInviteToken(t *testing.T, e *apitest.Env) string {
+	t.Helper()
+	msgs := e.Mail.Messages()
+	m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[len(msgs)-1].Body)
+	if m == nil {
+		t.Fatalf("no link in the invite email")
+	}
+	token, _ := url.QueryUnescape(m[1])
+	return token
+}
+
+func TestInviteTokens(t *testing.T) {
+	e := apitest.New(t)
+	_, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+
+	var first store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"}, &first)
+	token := lastInviteToken(t, e)
+	if len(token) != 43 {
+		t.Fatalf("token %q is not 43 characters", token)
+	}
+	if r := e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"}); r.Code != http.StatusCreated {
+		t.Fatalf("second invite: %s", r)
+	}
+	newToken := lastInviteToken(t, e)
+
+	// No answer carries a token, and a viewer cannot read one either.
+	for _, key := range []string{e.Acme.Key, viewerKey} {
+		r := e.Do("GET", "/v1/invites", key, nil)
+		if r.Code != http.StatusOK || strings.Contains(string(r.Body), newToken) || strings.Contains(string(r.Body), token) {
+			t.Fatalf("GET /v1/invites leaked a token: %s", r)
+		}
+	}
+	if r := e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "other@people.example", "role": "member"}); strings.Contains(string(r.Body), "token") {
+		t.Fatalf("POST /v1/invites answered a token: %s", r)
+	}
+
+	// Inviting the address again (ignoring case) revokes the first invite.
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "New Person"}); r.Code != http.StatusNotFound {
+		t.Fatalf("a superseded token: %s", r)
+	}
+	var pending struct {
+		Items []struct {
+			Email     string    `json:"email"`
+			ExpiresAt time.Time `json:"expires_at"`
+		}
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &pending)
+	if len(pending.Items) != 2 || pending.Items[0].ExpiresAt.Sub(e.Clock.Now()) != 7*24*time.Hour {
+		t.Fatalf("pending = %+v", pending.Items)
+	}
+
+	var accepted map[string]any
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": newToken, "name": "New Person"}, &accepted)
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": newToken, "name": "New Person"}); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_used" {
+		t.Fatalf("a used token: %s", r)
+	}
+
+	// Revoked: unknown to the service.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "revoked@people.example", "role": "member"}, &first)
+	revokedToken := lastInviteToken(t, e)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+first.ID, e.Acme.Key, nil, nil)
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": revokedToken, "name": "X"}); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("a revoked token: %s", r)
+	}
+
+	// Older than 7 days: expired, and no longer pending.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "late@people.example", "role": "member"}, &first)
+	lateToken := lastInviteToken(t, e)
+	e.Clock.Advance(7*24*time.Hour + time.Second)
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": lateToken, "name": "Late"}); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_expired" {
+		t.Fatalf("an expired token: %s", r)
+	}
+	var left struct{ Items []store.Invite }
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &left)
+	if len(left.Items) != 0 {
+		t.Fatalf("expired invites still pending: %+v", left.Items)
+	}
+}
