+package store
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestInviteTokenFormat(t *testing.T) {
+	tok := NewInviteToken()
+	if len(tok) != 43 {
+		t.Fatalf("token %q has %d characters, want 43", tok, len(tok))
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(tok)
+	if err != nil || len(raw) != 32 {
+		t.Fatalf("token %q is not 32 bytes of unpadded base64url: %v", tok, err)
+	}
+	if NewInviteToken() == tok {
+		t.Fatal("two tokens are equal")
+	}
+}
+
+func TestInviteStoresOnlyTokenHash(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv, err := s.CreateInvite(o.ID, "new@people.example", RoleMember, "usr_1", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if inv.Token == "" {
+		t.Fatal("CreateInvite did not return the token")
+	}
+	sum := sha256.Sum256([]byte(inv.Token))
+	if inv.TokenHash != hex.EncodeToString(sum[:]) {
+		t.Fatalf("TokenHash = %q, want the SHA-256 of the token", inv.TokenHash)
+	}
+	if !inv.ExpiresAt.Equal(t0.Add(7 * 24 * time.Hour)) {
+		t.Fatalf("ExpiresAt = %v, want 7 days after creation", inv.ExpiresAt)
+	}
+	stored, ok := s.Invite(o.ID, inv.ID)
+	if !ok || stored.Token != "" {
+		t.Fatalf("the store kept the token: %+v", stored)
+	}
+	if listed := s.Invites(o.ID); len(listed) != 1 || listed[0].TokenHash != stored.TokenHash {
+		t.Fatalf("listed invites = %+v", listed)
+	}
+	out, err := json.Marshal(inv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(out), inv.Token) {
+		t.Fatalf("the invite's JSON contains its token: %s", out)
+	}
+	snap, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(snap), inv.Token) {
+		t.Fatal("the snapshot contains the token")
+	}
+}
+
+func TestInviteSurvivesSnapshot(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv, err := s.CreateInvite(o.ID, "new@people.example", RoleMember, "usr_1", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	back, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := back.AcceptInvite(inv.Token, "New", t0); err != nil {
+		t.Fatalf("accepting after a snapshot round trip: %v", err)
+	}
+}
+
+func TestReinviteRevokesEarlierInvite(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	first, err := s.CreateInvite(o.ID, "Ann@Example.com", RoleMember, "usr_1", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := s.CreateInvite(o.ID, "ann@example.COM", RoleViewer, "usr_1", t0.Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := s.AcceptInvite(first.Token, "Ann", t0.Add(time.Hour)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("the earlier token: %v, want ErrNotFound", err)
+	}
+	pending := s.PendingInvites(o.ID, t0.Add(time.Hour))
+	if len(pending) != 1 || pending[0].ID != second.ID {
+		t.Fatalf("pending = %+v, want only the new invite", pending)
+	}
+	if _, _, _, err := s.AcceptInvite(second.Token, "Ann", t0.Add(time.Hour)); err != nil {
+		t.Fatalf("the newest token: %v", err)
+	}
+}
+
+func TestAcceptInviteOutcomes(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	mk := func(email string) Invite {
+		t.Helper()
+		inv, err := s.CreateInvite(o.ID, email, RoleMember, "usr_1", t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	accept := func(token string, at time.Time) error {
+		t.Helper()
+		_, _, _, err := s.AcceptInvite(token, "Someone", at)
+		return err
+	}
+
+	if err := accept("", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("empty token: %v", err)
+	}
+	if err := accept("nope", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("unknown token: %v", err)
+	}
+
+	used := mk("used@people.example")
+	if err := accept(used.Token, t0); err != nil {
+		t.Fatalf("first accept: %v", err)
+	}
+	if err := accept(used.Token, t0); !errors.Is(err, ErrInviteUsed) {
+		t.Fatalf("second accept: %v, want ErrInviteUsed", err)
+	}
+
+	revoked := mk("revoked@people.example")
+	if _, err := s.RevokeInvite(o.ID, revoked.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if err := accept(revoked.Token, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("revoked token: %v, want ErrNotFound", err)
+	}
+
+	// Seven days after creation the token still works; a second later it does not.
+	edge := mk("edge@people.example")
+	if err := accept(edge.Token, t0.Add(InviteLifetime)); err != nil {
+		t.Fatalf("token at exactly 7 days: %v", err)
+	}
+	late := mk("late@people.example")
+	if err := accept(late.Token, t0.Add(InviteLifetime+time.Second)); !errors.Is(err, ErrInviteExpired) {
+		t.Fatalf("token after 7 days: %v, want ErrInviteExpired", err)
+	}
+	if _, ok := s.UserByEmail("late@people.example"); ok {
+		t.Fatal("an expired invite created a user")
+	}
+}
+
+func TestPendingInvitesExcludeExpired(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	if _, err := s.CreateInvite(o.ID, "old@people.example", RoleMember, "usr_1", t0); err != nil {
+		t.Fatal(err)
+	}
+	fresh, err := s.CreateInvite(o.ID, "fresh@people.example", RoleMember, "usr_1", t0.Add(InviteLifetime))
+	if err != nil {
+		t.Fatal(err)
+	}
+	later := t0.Add(InviteLifetime + time.Hour)
+	pending := s.PendingInvites(o.ID, later)
+	if len(pending) != 1 || pending[0].ID != fresh.ID {
+		t.Fatalf("pending = %+v, want only the fresh invite", pending)
+	}
+	if got := s.Invites(o.ID); len(got) != 2 {
+		t.Fatalf("Invites lists %d, want both open invites", len(got))
+	}
+}
