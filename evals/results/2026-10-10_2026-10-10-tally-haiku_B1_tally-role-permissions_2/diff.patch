+func TestAPIKeyRules(t *testing.T) {
+	f := newFixture(t)
+	e := f.env
+	// Viewers may create a key for themselves, and see only their own keys.
+	var k store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", f.keys[store.RoleViewer], map[string]string{"name": "laptop"}, &k)
+	var mine struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", f.keys[store.RoleViewer], nil, &mine)
+	if len(mine.Items) != 2 {
+		t.Fatalf("a viewer sees %d keys, want their own 2", len(mine.Items))
+	}
+	for _, it := range mine.Items {
+		if it.UserID != k.UserID {
+			t.Fatalf("a viewer sees someone else's key: %+v", it)
+		}
+	}
+	var all struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, &all)
+	if len(all.Items) != 7 { // the keys of owner, admin, billing, member, viewer and target, plus the viewer's laptop key
+		t.Fatalf("an owner sees %d keys", len(all.Items))
+	}
+	// A member revokes their own key, and not the target's.
+	var memberKeys struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", f.keys[store.RoleMember], nil, &memberKeys)
+	own := memberKeys.Items[0]
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+own.ID, f.keys[store.RoleMember], nil, nil)
+	if r := e.Do("GET", "/v1/org", f.keys[store.RoleMember], nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("revoked own key: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/api-keys/"+f.tKey.ID, f.keys[store.RoleViewer], nil); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer revokes another's key: %s", r)
+	}
+	if r := e.Do("GET", "/v1/org", f.tKey.Token, nil); r.Code != http.StatusOK {
+		t.Fatalf("the target's key after a refused revoke: %s", r)
+	}
+	// Admins revoke anyone's key.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+f.tKey.ID, f.keys[store.RoleAdmin], nil, nil)
+	if r := e.Do("GET", "/v1/org", f.tKey.Token, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("the target's revoked key: %s", r)
+	}
+}
