+func TestLastOwnerIsKept(t *testing.T) {
+	e := apitest.New(t)
+	owner := e.Acme.Key
+	if r := e.Do("PATCH", "/v1/members/"+e.Acme.Owner.ID, owner, map[string]string{"role": "admin"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("sole owner demotes self: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/members/"+e.Acme.Owner.ID, owner, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("sole owner leaves: %s", r)
+	}
+	// Refused changes leave the owner in place.
+	if m, _ := e.Store.Member(e.Acme.ID, e.Acme.Owner.ID); m.Role != store.RoleOwner {
+		t.Fatalf("owner's role = %s", m.Role)
+	}
+	// An admin cannot touch the only owner, and gets the forbidden answer, not last_owner.
+	_, admin := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	if r := e.Do("DELETE", "/v1/members/"+e.Acme.Owner.ID, admin, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("admin removes the sole owner: %s", r)
+	}
+}
