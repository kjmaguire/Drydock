+package api_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"slices"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+var (
+	allRoles  = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer}
+	billRoles = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling}
+	topRoles  = []store.Role{store.RoleOwner, store.RoleAdmin}
+	// writeRoles may change customers and subscriptions: everyone but viewers.
+	writeRoles = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember}
+	ownerOnly  = []store.Role{store.RoleOwner}
+)
+
+// fixture is an Acme with one of everything the role table covers, and a key for each role in it.
+type fixture struct {
+	env    *apitest.Env
+	keys   map[store.Role]string
+	cust   store.Customer
+	spare  store.Customer
+	plan   store.Plan
+	sub    store.Subscription
+	inv    store.Invoice
+	ep     store.WebhookEndpoint
+	invite store.Invite
+	target store.User // a member with role member, for the member-management cases
+	tKey   store.APIKey
+	event  string
+}
+
+func newFixture(t testing.TB) *fixture {
+	t.Helper()
+	e := apitest.New(t)
+	f := &fixture{env: e, keys: map[store.Role]string{store.RoleOwner: e.Acme.Key}}
+	for _, r := range allRoles[1:] {
+		_, key := e.AddMember(e.Acme, string(r)+"@acme.example", r)
+		f.keys[r] = key
+	}
+	owner := e.Acme.Key
+	f.spare = e.CreateCustomer(e.Acme, "Spare", "spare@example.com")
+	f.cust = e.CreateCustomer(e.Acme, "Jane Doe", "jane@example.com")
+	f.plan = e.CreatePlan(e.Acme, "Pro", "USD", "10.00")
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", owner, map[string]any{"customer_id": f.cust.ID, "plan_id": f.plan.ID, "quantity": 1}, &f.sub)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", owner, map[string]any{"customer_id": f.cust.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 500}}}, &f.inv)
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", owner, map[string]any{"url": "https://hooks.acme.example/events", "events": []string{"*"}}, &f.ep)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", owner, map[string]string{"email": "invitee@people.example", "role": "member"}, &f.invite)
+	var events struct{ Items []store.Event }
+	e.MustDo(http.StatusOK, "GET", "/v1/events", owner, nil, &events)
+	f.event = "evt_none"
+	if len(events.Items) > 0 {
+		f.event = events.Items[0].ID
+	}
+	var target string
+	f.target, target = e.AddMember(e.Acme, "target@acme.example", store.RoleMember)
+	f.tKey, _ = e.Store.APIKeyByToken(target)
+	return f
+}
+
+// state is everything the store holds, for checking that a refused request changed nothing. Last-used times are left out:
+// every request that presents a key records it.
+func (f *fixture) state(t testing.TB) string {
+	t.Helper()
+	st := f.env.Store.Export()
+	for i := range st.APIKeys {
+		st.APIKeys[i].LastUsedAt = nil
+	}
+	b, err := json.Marshal(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
+
+// roleCase is one endpoint of the role table: the roles that may call it, and the status an allowed call answers (0: any
+// answer short of a server error or a refusal will do, for calls whose outcome depends on data the fixture does not set up).
+type roleCase struct {
+	name   string
+	method string
+	path   string
+	body   any
+	allow  []store.Role
+	ok     int
+}
+
+// matrix returns every endpoint of the role table, built on f.
+func matrix(f *fixture) []roleCase {
+	cust, plan, sub, inv, ep := "/v1/customers/"+f.cust.ID, "/v1/plans/"+f.plan.ID, "/v1/subscriptions/"+f.sub.ID,
+		"/v1/invoices/"+f.inv.ID, "/v1/webhook-endpoints/"+f.ep.ID
+	return []roleCase{
+		// Reads that every role may make.
+		{"org", "GET", "/v1/org", nil, allRoles, 200},
+		{"members", "GET", "/v1/members", nil, allRoles, 200},
+		{"invites", "GET", "/v1/invites", nil, allRoles, 200},
+		{"customers", "GET", "/v1/customers", nil, allRoles, 200},
+		{"customer", "GET", cust, nil, allRoles, 200},
+		{"customers export", "GET", "/v1/customers/export.csv", nil, allRoles, 200},
+		{"plans", "GET", "/v1/plans", nil, allRoles, 200},
+		{"plan", "GET", plan, nil, allRoles, 200},
+		{"subscriptions", "GET", "/v1/subscriptions", nil, allRoles, 200},
+		{"subscription", "GET", sub, nil, allRoles, 200},
+		{"invoices", "GET", "/v1/invoices", nil, allRoles, 200},
+		{"invoice", "GET", inv, nil, allRoles, 200},
+		{"invoice lines", "GET", inv + "/lines", nil, allRoles, 200},
+		{"payments", "GET", "/v1/payments", nil, allRoles, 200},
+		{"api keys", "GET", "/v1/api-keys", nil, allRoles, 200},
+
+		// Reads for owners, admins and (revenue) billing.
+		{"revenue report", "GET", "/v1/reports/revenue?from=2026-01-01&to=2026-12-31", nil, billRoles, 200},
+		{"webhook endpoints", "GET", "/v1/webhook-endpoints", nil, topRoles, 200},
+		{"webhook endpoint", "GET", ep, nil, topRoles, 200},
+		{"webhook deliveries", "GET", ep + "/deliveries", nil, topRoles, 200},
+		{"events", "GET", "/v1/events", nil, topRoles, 200},
+		{"event", "GET", "/v1/events/" + f.event, nil, topRoles, 200},
+
+		// Customers and subscriptions: everyone but viewers.
+		{"create customer", "POST", "/v1/customers", map[string]string{"name": "New", "email": "new@example.com"}, writeRoles, 201},
+		{"update customer", "PATCH", cust, map[string]string{"name": "Jane Q"}, writeRoles, 200},
+		{"delete customer", "DELETE", "/v1/customers/" + f.spare.ID, nil, writeRoles, 204},
+		{"create subscription", "POST", "/v1/subscriptions", map[string]any{"customer_id": f.spare.ID, "plan_id": f.plan.ID, "quantity": 1}, writeRoles, 201},
+		{"update subscription", "PATCH", sub, map[string]int{"quantity": 2}, writeRoles, 200},
+		{"cancel subscription", "POST", sub + "/cancel", map[string]bool{"at_period_end": true}, writeRoles, 200},
+		{"report usage", "POST", sub + "/usage", map[string]int{"quantity": 1}, writeRoles, 0},
+
+		// Plans and invoices: owners, admins and billing.
+		{"create plan", "POST", "/v1/plans", map[string]string{"name": "Team", "currency": "USD", "price": "20.00", "interval": "month"}, billRoles, 201},
+		{"update plan", "PATCH", plan, map[string]string{"name": "Pro+"}, billRoles, 200},
+		{"create invoice", "POST", "/v1/invoices", map[string]any{"customer_id": f.cust.ID, "currency": "USD",
+			"lines": []map[string]any{{"description": "Extra", "quantity": 1, "unit_amount": 300}}}, billRoles, 201},
+		{"pay invoice", "POST", inv + "/pay", map[string]string{"payment_method": "pm_card"}, billRoles, 0},
+		{"void invoice", "POST", inv + "/void", nil, billRoles, 200},
+
+		// Webhook endpoints and events: owners and admins.
+		{"create webhook endpoint", "POST", "/v1/webhook-endpoints", map[string]any{"url": "https://hooks.acme.example/two", "events": []string{"*"}}, topRoles, 201},
+		{"update webhook endpoint", "PATCH", ep, map[string]bool{"enabled": false}, topRoles, 200},
+		{"delete webhook endpoint", "DELETE", ep, nil, topRoles, 204},
+
+		// The organization, its members and invites.
+		{"update org", "PATCH", "/v1/org", map[string]string{"name": "Acme Two"}, topRoles, 200},
+		{"change a member's role", "PATCH", "/v1/members/" + f.target.ID, map[string]string{"role": "billing"}, topRoles, 200},
+		{"remove a member", "DELETE", "/v1/members/" + f.target.ID, nil, topRoles, 204},
+		{"invite a member", "POST", "/v1/invites", map[string]string{"email": "new@people.example", "role": "member"}, topRoles, 201},
+		{"revoke an invite", "DELETE", "/v1/invites/" + f.invite.ID, nil, topRoles, 204},
+
+		// API keys: anyone creates their own; revoking someone else's is for owners and admins.
+		{"create api key", "POST", "/v1/api-keys", map[string]string{"name": "CI"}, allRoles, 201},
+		{"revoke another member's key", "DELETE", "/v1/api-keys/" + f.tKey.ID, nil, topRoles, 204},
+	}
+}
+
+// TestRoleMatrix calls every endpoint of the role table as each role, in a fresh organization each time. An allowed call
+// must not be refused; a refused one must answer 403 {"error":"forbidden"} and change nothing.
+func TestRoleMatrix(t *testing.T) {
+	for _, role := range allRoles {
+		for i := range matrix(newFixture(t)) {
+			f := newFixture(t)
+			c := matrix(f)[i]
+			allowed := slices.Contains(c.allow, role)
+			before := f.state(t)
+			r := f.env.Do(c.method, c.path, f.keys[role], c.body)
+			switch {
+			case allowed && c.ok != 0 && r.Code != c.ok:
+				t.Errorf("%s as %s: want %d, got %s", c.name, role, c.ok, r)
+			case allowed && (r.Code == http.StatusForbidden || r.Code >= 500):
+				t.Errorf("%s as %s: want a call that is not refused, got %s", c.name, role, r)
+			case !allowed && (r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden"):
+				t.Errorf("%s as %s: want 403 forbidden, got %s", c.name, role, r)
+			case !allowed && f.state(t) != before:
+				t.Errorf("%s as %s: refused, but the store changed", c.name, role)
+			}
+		}
+	}
+}
+
+func TestRoleChangeAppliesToExistingKeys(t *testing.T) {
+	f := newFixture(t)
+	e := f.env
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", f.keys[store.RoleMember], nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+f.target.ID, f.keys[store.RoleOwner], map[string]string{"role": "viewer"}, nil)
+	if r := e.Do("POST", "/v1/customers", f.tKey.Token, map[string]string{"name": "X", "email": "x@example.com"}); r.Code != http.StatusForbidden {
+		t.Fatalf("the demoted member's key still writes: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", f.tKey.Token, nil, nil)
+}
+
+func TestAdminMemberRules(t *testing.T) {
+	f := newFixture(t)
+	e := f.env
+	admin := f.keys[store.RoleAdmin]
+	owner2, _ := e.AddMember(e.Acme, "owner2@acme.example", store.RoleOwner)
+	admin2, _ := e.AddMember(e.Acme, "admin2@acme.example", store.RoleAdmin)
+	member := f.target.ID
+
+	for _, role := range []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember} {
+		if r := e.Do("PATCH", "/v1/members/"+member, admin, map[string]string{"role": string(role)}); role == store.RoleOwner || role == store.RoleAdmin {
+			if r.Code != http.StatusForbidden {
+				t.Fatalf("admin gives %s: %s", role, r)
+			}
+		} else if r.Code != http.StatusOK {
+			t.Fatalf("admin gives %s: %s", role, r)
+		}
+	}
+	// The target is a member again (billing, from the loop above). Admins may not touch owners or admins.
+	for _, target := range []string{owner2.ID, admin2.ID, e.Acme.Owner.ID} {
+		if r := e.Do("PATCH", "/v1/members/"+target, admin, map[string]string{"role": "viewer"}); r.Code != http.StatusForbidden {
+			t.Fatalf("admin changes %s: %s", target, r)
+		}
+		if r := e.Do("DELETE", "/v1/members/"+target, admin, nil); r.Code != http.StatusForbidden {
+			t.Fatalf("admin removes %s: %s", target, r)
+		}
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+member, admin, nil, nil)
+	if m, ok := e.Store.Member(e.Acme.ID, owner2.ID); !ok || m.Role != store.RoleOwner {
+		t.Fatalf("owner2 = %+v, %v", m, ok)
+	}
+}
+
+func TestOwnerMemberRules(t *testing.T) {
+	f := newFixture(t)
+	e := f.env
+	owner := e.Acme.Key
+	owner2, owner2Key := e.AddMember(e.Acme, "owner2@acme.example", store.RoleOwner)
+	admin, _ := e.AddMember(e.Acme, "admin2@acme.example", store.RoleAdmin)
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+f.target.ID, owner, map[string]string{"role": "owner"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+admin.ID, owner, map[string]string{"role": "member"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+owner2.ID, owner, map[string]string{"role": "admin"}, nil)
+	// Nobody changes their own role, even with another owner around.
+	if r := e.Do("PATCH", "/v1/members/"+e.Acme.Owner.ID, owner, map[string]string{"role": "admin"}); r.Code != http.StatusForbidden {
+		t.Fatalf("owner changes own role: %s", r)
+	}
+	if r := e.Do("PATCH", "/v1/members/"+owner2.ID, owner2Key, map[string]string{"role": "owner"}); r.Code != http.StatusForbidden {
+		t.Fatalf("admin-now owner2 changes own role: %s", r)
+	}
+	// Leaving is allowed while another owner remains.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+e.Acme.Owner.ID, owner, nil, nil)
+	if r := e.Do("GET", "/v1/org", owner, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("the left owner's key: %s", r)
+	}
+}
+
+// TestNobodyChangesOwnRoleButAnyoneLeaves: every role may leave, and nobody may change their own role.
+func TestNobodyChangesOwnRoleButAnyoneLeaves(t *testing.T) {
+	for _, role := range []store.Role{store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		f := newFixture(t)
+		e := f.env
+		e.AddMember(e.Acme, "stay@acme.example", store.RoleOwner) // a second owner, so that leaving is allowed
+		var me struct {
+			User store.User `json:"user"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/me", f.keys[role], nil, &me)
+		if r := e.Do("PATCH", "/v1/members/"+me.User.ID, f.keys[role], map[string]string{"role": "owner"}); r.Code != http.StatusForbidden {
+			t.Fatalf("%s changes own role: %s", role, r)
+		}
+		e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+me.User.ID, f.keys[role], nil, nil)
+		if r := e.Do("GET", "/v1/org", f.keys[role], nil); r.Code != http.StatusUnauthorized {
+			t.Fatalf("%s after leaving: %s", role, r)
+		}
+	}
+}
