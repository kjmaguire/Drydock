-// CanWrite reports whether a role may change anything. Viewers only read.
+// CanWrite reports whether a role may change customers and subscriptions. Viewers only read.
 func CanWrite(r store.Role) bool { return r != store.RoleViewer }
 
+// CanBill reports whether a role may change plans and invoices and read the revenue report: owners, admins and billing.
+func CanBill(r store.Role) bool {
+	return r == store.RoleOwner || r == store.RoleAdmin || r == store.RoleBilling
+}
+
 // CanManageTeam reports whether a role may manage the organization's settings, members and invites.
 func CanManageTeam(r store.Role) bool { return r == store.RoleOwner || r == store.RoleAdmin }
+
+// CanManageWebhooks reports whether a role may manage webhook endpoints and read their deliveries and the organization's
+// events: owners and admins.
+func CanManageWebhooks(r store.Role) bool { return CanManageTeam(r) }
+
+// isTopRole reports whether r is one that only an owner may give, change or remove.
+func isTopRole(r store.Role) bool { return r == store.RoleOwner || r == store.RoleAdmin }
+
+// MayGiveRole reports whether p may invite someone with role, or give a member it: only an owner may give the owner or
+// admin role.
+func MayGiveRole(p Principal, role store.Role) bool {
+	return !isTopRole(role) || p.Role == store.RoleOwner
+}
+
+// MayChangeMember reports whether p may give target the role next, or remove target when remove is set. owners is the number
+// of owners the organization has. Nobody changes their own role. Anyone may leave, and the organization's only owner may not
+// (the store refuses that as ErrLastOwner, so this answers true for the only owner's own demotion or removal and lets the
+// store say so). Otherwise owners and admins may change members, and only an owner may change an owner or an admin or give
+// the owner or admin role.
+func MayChangeMember(p Principal, target store.Member, next store.Role, remove bool, owners int) bool {
+	if target.UserID == p.UserID {
+		if remove {
+			return true
+		}
+		return target.Role == store.RoleOwner && owners == 1 && next != store.RoleOwner
+	}
+	if !CanManageTeam(p.Role) {
+		return false
+	}
+	if isTopRole(target.Role) && p.Role != store.RoleOwner {
+		return false
+	}
+	return remove || MayGiveRole(p, next)
+}
diff --git a/result/internal/store/members_test.go b/result/internal/store/members_test.go
new file mode 100644
index 0000000..e0a16a1
--- /dev/null
+++ b/result/internal/store/members_test.go
@@ -0,0 +1,85 @@
+package store
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+// twoOwners returns a store with an organization and two of its owners.
+func twoOwners(t *testing.T) (*Store, Org, User, User) {
+	t.Helper()
+	s := New()
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	o, err := s.CreateOrg("Acme", OrgTeam, "UTC", 0, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, _ := s.CreateUser("a@acme.example", "A", now)
+	b, _ := s.CreateUser("b@acme.example", "B", now)
+	for _, u := range []User{a, b} {
+		if _, err := s.AddMember(o.ID, u.ID, RoleOwner, now); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return s, o, a, b
+}
+
+func TestLastOwnerIsKeptByTheStore(t *testing.T) {
+	s, o, a, b := twoOwners(t)
+	if err := s.RemoveMember(o.ID, a.ID); err != nil {
+		t.Fatalf("remove one of two owners: %v", err)
+	}
+	if err := s.RemoveMember(o.ID, b.ID); !errors.Is(err, ErrLastOwner) {
+		t.Fatalf("remove the only owner: %v", err)
+	}
+	if _, err := s.SetMemberRole(o.ID, b.ID, RoleAdmin); !errors.Is(err, ErrLastOwner) {
+		t.Fatalf("demote the only owner: %v", err)
+	}
+	if m, _ := s.Member(o.ID, b.ID); m.Role != RoleOwner {
+		t.Fatalf("the only owner's role = %s", m.Role)
+	}
+}
+
+// Two owners demoting each other at once must not both succeed: the check and the change happen under one lock.
+func TestConcurrentDemotionsKeepAnOwner(t *testing.T) {
+	for i := 0; i < 50; i++ {
+		s, o, a, b := twoOwners(t)
+		var wg sync.WaitGroup
+		errs := make([]error, 2)
+		for j, u := range []User{a, b} {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				_, errs[j] = s.ChangeMember(o.ID, u.ID, MemberChange{Role: RoleMember}, func(cur Member, owners int) bool { return true })
+			}()
+		}
+		wg.Wait()
+		okCount := 0
+		for _, err := range errs {
+			if err == nil {
+				okCount++
+			} else if !errors.Is(err, ErrLastOwner) {
+				t.Fatalf("unexpected error: %v", err)
+			}
+		}
+		if okCount != 1 {
+			t.Fatalf("run %d: %d demotions succeeded, want exactly 1", i, okCount)
+		}
+	}
+}
+
+func TestChangeMemberCheckRefuses(t *testing.T) {
+	s, o, a, _ := twoOwners(t)
+	_, err := s.ChangeMember(o.ID, a.ID, MemberChange{Role: RoleMember}, func(Member, int) bool { return false })
+	if !errors.Is(err, ErrForbidden) {
+		t.Fatalf("refused change: %v", err)
+	}
+	if m, _ := s.Member(o.ID, a.ID); m.Role != RoleOwner {
+		t.Fatalf("a refused change was made: %s", m.Role)
+	}
+	if _, err := s.ChangeMember(o.ID, "usr_nope", MemberChange{Role: RoleMember}, nil); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("unknown member: %v", err)
+	}
+}
