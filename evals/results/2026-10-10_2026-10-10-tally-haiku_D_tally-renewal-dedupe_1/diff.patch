+// RenewSubscription renews a subscription in one step, so that each period is renewed at most once. It works only while the
+// subscription is not canceled and is still in the period that starts at fromStart: then f sets its next period and, when
+// inv is not nil, the invoice is stored as open in the same step. Otherwise it returns ErrConflict and changes nothing,
+// because another renewal of that period got there first.
+func (s *Store) RenewSubscription(orgID, id string, fromStart time.Time, f func(*Subscription) error, inv *Invoice, now time.Time) (Subscription, *Invoice, error) {
+	if inv != nil {
+		if err := checkInvoice(*inv); err != nil {
+			return Subscription{}, nil, err
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	old, ok := s.subs[id]
+	if !ok || old.OrgID != orgID {
+		return Subscription{}, nil, ErrNotFound
+	}
+	if old.Status == Canceled || !old.CurrentPeriodStart.Equal(fromStart) {
+		return Subscription{}, nil, fmt.Errorf("%w: the subscription's period was already renewed", ErrConflict)
+	}
+	sub := copySub(old)
+	if err := f(&sub); err != nil {
+		return Subscription{}, nil, err
+	}
+	sub.ID, sub.OrgID, sub.CustomerID, sub.CreatedAt = old.ID, old.OrgID, old.CustomerID, old.CreatedAt
+	if err := s.checkSubscription(sub); err != nil {
+		return Subscription{}, nil, err
+	}
+	var created *Invoice
+	if inv != nil {
+		c, err := s.createInvoice(*inv, now)
+		if err != nil {
+			return Subscription{}, nil, err
+		}
+		created = &c
+	}
+	s.subs[id] = sub
+	return copySub(sub), created, nil
+}
+
