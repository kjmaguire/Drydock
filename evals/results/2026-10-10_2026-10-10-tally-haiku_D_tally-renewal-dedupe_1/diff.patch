+func TestGatewayDownRenewsOnceAndKeepsInvoiceOpen(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	sub := subscribeMonthly(t, e, c, "pm_card_visa")
+	setPaymentMethod(e, e.Acme.ID, c, "pm_gateway_down")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	n, err := e.Subs.RenewDue(ctx)
+	if n != 1 || !errors.Is(err, payments.ErrUnavailable) {
+		t.Fatalf("RenewDue = %d, %v; want 1 renewed and ErrUnavailable", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(sub.CurrentPeriodEnd) {
+		t.Fatalf("after the outage = %+v, want the next period and status active", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoiceOpen {
+		t.Fatalf("invoices = %+v, want an open renewal", invs)
+	}
+	calls := len(e.Gateway.Calls())
+
+	// The gateway is back: the next run must neither invoice nor charge the period again.
+	setPaymentMethod(e, e.Acme.ID, c, "pm_card_visa")
+	if n, err := e.Subs.RenewDue(ctx); n != 0 || err != nil {
+		t.Fatalf("RenewDue after recovery = %d, %v", n, err)
+	}
+	if len(e.Gateway.Calls()) != calls {
+		t.Fatalf("the period was charged again")
+	}
+	invs = e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %d, want 2", len(invs))
+	}
+	// The open invoice can be paid later.
+	if _, _, err := e.Payments.Pay(ctx, e.Acme.ID, invs[1].ID, ""); err != nil {
+		t.Fatal(err)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 {
+		t.Fatalf("charges = %d, want 2", len(cs))
+	}
+}
