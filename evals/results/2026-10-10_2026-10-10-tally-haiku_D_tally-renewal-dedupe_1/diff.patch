+func TestRenewalDuringChargeInvoicesOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	sub := subscribeMonthly(t, e, c, "pm_card_visa")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	// While the renewal's charge is in flight, another instance runs RenewDue.
+	var charges, otherN int
+	var otherErr error
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		if charges++; charges == 1 {
+			otherN, otherErr = e.Subs.RenewDue(ctx)
+		}
+	}
+	n, err := e.Subs.RenewDue(ctx)
+	if err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	if otherErr != nil || otherN != 0 {
+		t.Fatalf("the other instance's RenewDue = %d, %v; want 0, nil", otherN, otherErr)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoicePaid {
+		t.Fatalf("invoices = %+v, want the first and one paid renewal", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 {
+		t.Fatalf("charges = %d, want 2 (the first period and one renewal)", len(cs))
+	}
+}
+
+func TestConcurrentRenewDueInvoicesOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	sub := subscribeMonthly(t, e, c, "pm_card_visa")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	var renewed atomic.Int64
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			n, err := e.Subs.RenewDue(ctx)
+			if err != nil {
+				t.Errorf("RenewDue: %v", err)
+			}
+			renewed.Add(int64(n))
+		}()
+	}
+	wg.Wait()
+	if renewed.Load() != 1 {
+		t.Fatalf("renewed %d times, want once", renewed.Load())
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 {
+		t.Fatalf("invoices = %d, want the first and one renewal", len(invs))
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 {
+		t.Fatalf("charges = %d, want 2 (the first period and one renewal)", len(cs))
+	}
+}
