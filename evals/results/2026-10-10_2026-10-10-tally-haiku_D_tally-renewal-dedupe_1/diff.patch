+	up := e.CreateCustomer(e.Acme, "Up", "up@example.com")
+	working := subscribeMonthly(t, e, up, "pm_card_visa")
+	e.Clock.Set(working.CurrentPeriodEnd)
+	n, err := e.Subs.RenewDue(ctx)
+	if n != 2 || !errors.Is(err, payments.ErrUnavailable) {
+		t.Fatalf("RenewDue = %d, %v; want both renewed and the failure returned", n, err)
+	}
+	if !strings.Contains(err.Error(), failing.ID) {
+		t.Fatalf("the error does not name %s: %v", failing.ID, err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: working.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoicePaid {
