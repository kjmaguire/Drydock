@@ -0,0 +1,122 @@
+package store
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+)
+
+var tokenFormat = regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`)
+
+func TestAPIKeyTokenFormat(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleOwner, t0)
+	seen := map[string]bool{}
+	for range 200 {
+		k, err := s.CreateAPIKey(o.ID, u.ID, "k", t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !tokenFormat.MatchString(k.Token) {
+			t.Fatalf("token %q is not tly_ and 40 characters from [A-Za-z0-9]", k.Token)
+		}
+		if seen[k.Token] {
+			t.Fatalf("token %q was issued twice", k.Token)
+		}
+		seen[k.Token] = true
+	}
+}
+
+func TestAPIKeyStoresOnlyHash(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleOwner, t0)
+	k, err := s.CreateAPIKey(o.ID, u.ID, "CI", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256([]byte(k.Token))
+	if k.Hash != hex.EncodeToString(sum[:]) || k.Last4 != k.Token[len(k.Token)-4:] {
+		t.Fatalf("the returned key has hash %q and last4 %q", k.Hash, k.Last4)
+	}
+
+	stored, ok := s.APIKey(o.ID, k.ID)
+	if !ok || stored.Token != "" || stored.Hash != k.Hash || stored.Last4 != k.Last4 {
+		t.Fatalf("the stored key = %+v", stored)
+	}
+	if got, ok := s.APIKeyByToken(k.Token); !ok || got.ID != k.ID {
+		t.Fatalf("APIKeyByToken = %+v %v", got, ok)
+	}
+	if _, ok := s.APIKeyByToken(k.Hash); ok {
+		t.Fatal("the hash works as a token")
+	}
+
+	listed, _ := json.Marshal(s.APIKeys(o.ID))
+	snapshot, _ := json.Marshal(s.Export())
+	for _, b := range [][]byte{listed, snapshot} {
+		if strings.Contains(string(b), k.Token) {
+			t.Fatalf("the plain-text token appears in %s", b)
+		}
+	}
+}
+
+func TestAPIKeyLastUsedIsThrottled(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleOwner, t0)
+	k, _ := s.CreateAPIKey(o.ID, u.ID, "k", t0)
+
+	s.TouchAPIKey(k.ID, t0.Add(time.Second))
+	if got, _ := s.APIKey(o.ID, k.ID); got.LastUsedAt == nil || !got.LastUsedAt.Equal(t0.Add(time.Second)) {
+		t.Fatalf("the first use was not recorded: %v", got.LastUsedAt)
+	}
+	s.TouchAPIKey(k.ID, t0.Add(30*time.Second))
+	if got, _ := s.APIKey(o.ID, k.ID); !got.LastUsedAt.Equal(t0.Add(time.Second)) {
+		t.Fatalf("a use 29 seconds later changed last_used_at to %v", got.LastUsedAt)
+	}
+	s.TouchAPIKey(k.ID, t0.Add(time.Second+time.Minute))
+	if got, _ := s.APIKey(o.ID, k.ID); !got.LastUsedAt.Equal(t0.Add(time.Second + time.Minute)) {
+		t.Fatalf("a use a minute later did not record: %v", got.LastUsedAt)
+	}
+}
+
+func TestLegacyPlainTextKeysStillWork(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleOwner, t0)
+	k, _ := s.CreateAPIKey(o.ID, u.ID, "old", t0)
+
+	// A snapshot from before tokens were hashed holds the token itself.
+	st := s.Export()
+	legacy := "tly_" + strings.Repeat("A", 36) + "wxyz"
+	st.APIKeys = []APIKey{{ID: k.ID, OrgID: o.ID, UserID: u.ID, Name: "old", Token: legacy, CreatedAt: t0}}
+
+	s2, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s2.APIKeyByToken(legacy); !ok || got.ID != k.ID {
+		t.Fatalf("the legacy key does not work: %+v %v", got, ok)
+	}
+	again := s2.Export()
+	if len(again.APIKeys) != 1 || again.APIKeys[0].Token != "" || again.APIKeys[0].Last4 != "wxyz" {
+		t.Fatalf("exported key = %+v", again.APIKeys)
+	}
+	sum := sha256.Sum256([]byte(legacy))
+	if again.APIKeys[0].Hash != hex.EncodeToString(sum[:]) {
+		t.Fatalf("exported hash = %q", again.APIKeys[0].Hash)
+	}
+	b, _ := json.Marshal(again)
+	if strings.Contains(string(b), legacy) {
+		t.Fatal("the next snapshot holds the plain-text token")
+	}
+}
