+// apiKeyPrefix starts every API key token. apiKeyAlphabet is what follows it.
+const (
+	apiKeyPrefix   = "tly_"
+	apiKeyAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+	apiKeyLength   = 40
+	// apiKeyTouchInterval is the least time between two writes of a key's last use.
+	apiKeyTouchInterval = time.Minute
+)
+
+// newAPIKeyToken returns a new API key token: the prefix and 40 random characters from apiKeyAlphabet.
+func newAPIKeyToken() string {
+	out := make([]byte, 0, apiKeyLength)
+	buf := make([]byte, apiKeyLength)
+	for len(out) < apiKeyLength {
+		if _, err := rand.Read(buf); err != nil {
+			panic(err) // crypto/rand does not fail on supported platforms
+		}
+		for _, b := range buf {
+			// 248 is 4 times the alphabet's length, so skipping larger bytes keeps every character equally likely.
+			if b < 248 && len(out) < apiKeyLength {
+				out = append(out, apiKeyAlphabet[int(b)%len(apiKeyAlphabet)])
+			}
+		}
+	}
+	return apiKeyPrefix + string(out)
+}
+
+// hashAPIKeyToken returns the SHA-256 of a token, in hex. The store keeps this instead of the token.
+func hashAPIKeyToken(token string) string {
+	h := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(h[:])
+}
+
+// lastFour returns the last four characters of a token.
+func lastFour(token string) string {
+	if len(token) < 4 {
+		return token
+	}
+	return token[len(token)-4:]
+}
+
 // NewToken returns prefix followed by 32 random hex characters.
