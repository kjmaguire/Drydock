--- /dev/null
+++ b/result/internal/snapshot/apikey_test.go
@@ -0,0 +1,50 @@
+package snapshot
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestLegacyTokensAreHashedOnNextSave(t *testing.T) {
+	// Built at run time so no token-shaped literal sits in the source.
+	token := "tly_" + strings.Repeat("x", 36) + "7Q2k"
+	// A version 2 snapshot written before API keys were hashed.
+	legacy := `{"version":2,"saved_at":"2026-02-01T12:00:00Z","state":{"seq":1,"api_keys":[` +
+		`{"id":"key_000001","org_id":"org_000001","user_id":"usr_000001","name":"old","token":"` + token +
+		`","created_at":"2026-02-01T12:00:00Z"}]}}`
+	dir := t.TempDir()
+	in := filepath.Join(dir, "old.json")
+	if err := os.WriteFile(in, []byte(legacy), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	st, err := Load(in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := st.APIKeyByToken(token); !ok {
+		t.Fatal("a key from a legacy snapshot does not work")
+	}
+
+	out := filepath.Join(dir, "new.json")
+	if err := Save(st, out, time.Date(2026, 2, 2, 12, 0, 0, 0, time.UTC)); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(out)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), token) {
+		t.Fatalf("the next snapshot holds the plain-text token:\n%s", b)
+	}
+	got, err := Load(out)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if k, ok := got.APIKeyByToken(token); !ok || k.Last4 != "7Q2k" || k.Token != "" {
+		t.Fatalf("after a second reload the key = %+v %v", k, ok)
+	}
+}
diff --git a/result/internal/store/apikey_test.go b/result/internal/store/apikey_test.go
