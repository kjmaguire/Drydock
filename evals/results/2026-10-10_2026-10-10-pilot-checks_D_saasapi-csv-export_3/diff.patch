+func TestCustomersCSVNeutralisesFormulas(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	st.CreateCustomer("acc_acme", `=SUM(A1,"x")`, "+1@example.com", store.PlanFree, now)
+	st.CreateCustomer("acc_acme", "-Bob", "@corp.example.com", store.PlanFree, now)
+	st.CreateCustomer("acc_acme", "Eve=Plain", "eve@example.com", store.PlanFree, now)
+
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	records, err := csv.NewReader(r.Body).ReadAll()
+	if err != nil {
+		t.Fatalf("not valid CSV: %v\n%q", err, r.Body)
+	}
+	want := [][]string{
+		{"id", "name", "email", "plan", "created_at"},
+		{"cus_00001", `'=SUM(A1,"x")`, "'+1@example.com", "free", "2026-01-02T03:04:05Z"},
+		{"cus_00002", "'-Bob", "'@corp.example.com", "free", "2026-01-02T03:04:05Z"},
+		{"cus_00003", "Eve=Plain", "eve@example.com", "free", "2026-01-02T03:04:05Z"},
+	}
+	if len(records) != len(want) {
+		t.Fatalf("records %q", records)
+	}
+	for i := range want {
+		for j := range want[i] {
+			if records[i][j] != want[i][j] {
+				t.Fatalf("row %d field %d: %q, want %q", i, j, records[i][j], want[i][j])
+			}
+		}
+	}
