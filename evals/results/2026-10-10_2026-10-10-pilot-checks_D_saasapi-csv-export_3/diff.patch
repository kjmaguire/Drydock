+// exportCustomersCSV writes the account's customers as a CSV download, one row per customer sorted by ID.
+func (s *Server) exportCustomersCSV(w http.ResponseWriter, r *http.Request, acct store.Account) {
+	w.Header().Set("Content-Type", "text/csv; charset=utf-8")
+	w.Header().Set("Content-Disposition", `attachment; filename="customers.csv"`)
+	cw := csv.NewWriter(w)
+	cw.UseCRLF = true
+	_ = cw.Write([]string{"id", "name", "email", "plan", "created_at"})
+	for _, c := range s.store.Customers(acct.ID) {
+		_ = cw.Write([]string{c.ID, csvSafe(c.Name), csvSafe(c.Email), string(c.Plan), c.CreatedAt.UTC().Format(time.RFC3339)})
+	}
+	cw.Flush()
+}
+
+// csvSafe keeps a user-typed field from being run as a formula by a spreadsheet.
+func csvSafe(field string) string {
+	if field != "" && strings.ContainsRune("=+-@", rune(field[0])) {
+		return "'" + field
+	}
+	return field
+}
