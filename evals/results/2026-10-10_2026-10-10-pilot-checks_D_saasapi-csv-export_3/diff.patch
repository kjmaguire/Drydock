+func TestCustomersCSVNeedsAValidKey(t *testing.T) {
+	srv, _ := newServer(t)
+	for _, key := range []string{"", "nope"} {
+		if r := do(t, srv, "GET", "/api/customers.csv", key, ""); r.Code != http.StatusUnauthorized {
+			t.Fatalf("key %q: status %d", key, r.Code)
+		}
+	}
+	r := do(t, srv, "GET", "/api/customers.csv", "key-globex", "")
+	if r.Code != http.StatusOK || r.Body.String() != "id,name,email,plan,created_at\r\n" {
+		t.Fatalf("empty account: %d %q", r.Code, r.Body)
+	}
+}
+
+func TestCustomersCSVExportsOnlyTheCallersCustomers(t *testing.T) {
+	srv, st := newServer(t)
+	cet := time.FixedZone("CET", 3600)
+	jane, _ := st.CreateCustomer("acc_acme", `Doe, "Jane"`, "jane@example.com", store.PlanPro, time.Date(2026, 1, 2, 4, 4, 5, 0, cet))
+	st.CreateCustomer("acc_globex", "Hank", "hank@globex.test", store.PlanFree, time.Now())
+	ann, _ := st.CreateCustomer("acc_acme", "Ann", "ann@example.com", store.PlanFree, time.Date(2026, 2, 1, 0, 0, 0, 0, time.UTC))
+	lines, _ := st.CreateCustomer("acc_acme", "Line1\nLine2", "lines@example.com", store.PlanFree, time.Date(2026, 3, 1, 0, 0, 0, 0, time.UTC))
+
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("status %d %s", r.Code, r.Body)
+	}
+	if ct := r.Header().Get("Content-Type"); ct != "text/csv; charset=utf-8" {
+		t.Fatalf("content type %q", ct)
+	}
+	if cd := r.Header().Get("Content-Disposition"); cd != `attachment; filename="customers.csv"` {
+		t.Fatalf("content disposition %q", cd)
+	}
+	want := "id,name,email,plan,created_at\r\n" +
+		jane.ID + `,"Doe, ""Jane""",jane@example.com,pro,2026-01-02T03:04:05Z` + "\r\n" +
+		ann.ID + ",Ann,ann@example.com,free,2026-02-01T00:00:00Z\r\n" +
+		lines.ID + ",\"Line1\r\nLine2\",lines@example.com,free,2026-03-01T00:00:00Z\r\n"
+	if r.Body.String() != want {
+		t.Fatalf("body:\n%q\nwant:\n%q", r.Body.String(), want)
+	}
+}
