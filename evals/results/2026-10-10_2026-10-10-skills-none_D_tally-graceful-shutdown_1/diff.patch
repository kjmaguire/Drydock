+// Enqueue adds a job to the queue without waiting. It returns ErrQueueFull when the queue has no room
+// and ErrStopped once Shutdown has been called.
 func (r *Runner) Enqueue(j Job) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return ErrStopped
+	}
+	// An idle worker takes a job at once, so a queue of size 0 still accepts a job while a worker waits.
+	if len(r.queue) >= r.queueSize+r.idle {
+		return ErrQueueFull
+	}
+	r.seq++
+	r.queue = append(r.queue, entry{seq: r.seq, job: j})
+	r.cond.Signal()
+	return nil
+}
