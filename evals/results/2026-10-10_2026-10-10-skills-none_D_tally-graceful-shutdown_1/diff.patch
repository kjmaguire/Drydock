+func TestZeroQueueAcceptsJobWhenWorkerIdle(t *testing.T) {
+	r := NewRunner(1, 0, nil)
+	r.Start()
+	release := make(chan struct{})
+	started := make(chan struct{})
+	defer r.Stop()
+	defer close(release)
+
+	// Wait until the worker is waiting for a job.
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		r.mu.Lock()
+		idle := r.idle
+		r.mu.Unlock()
+		if idle == 1 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("worker did not become idle")
+		}
+		time.Sleep(time.Millisecond)
+	}
+
+	if err := r.Enqueue(Job{Name: "block", Run: func(context.Context) error {
+		close(started)
+		<-release
+		return nil
+	}}); err != nil {
+		t.Fatalf("enqueue with idle worker: err = %v, want nil", err)
+	}
+	<-started
+	if err := r.Enqueue(Job{Name: "next", Run: func(context.Context) error { return nil }}); !errors.Is(err, ErrQueueFull) {
+		t.Fatalf("err = %v, want ErrQueueFull", err)
+	}
+}
+
+func TestEnqueueAfterShutdownReturnsErrStopped(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	late := Job{Name: "late", Run: func(context.Context) error {
+		t.Error("late job ran")
+		return nil
+	}}
+	if err := r.Enqueue(late); !errors.Is(err, ErrStopped) {
+		t.Fatalf("err = %v, want ErrStopped", err)
+	}
+	if got := r.Pending(); len(got) != 0 {
+		t.Fatalf("pending = %v, want none", names(got))
+	}
+}
+
+func TestShutdownWaitsForRunningJobs(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started := make(chan struct{})
+	release := make(chan struct{})
+	finished := make(chan struct{})
+	if err := r.Enqueue(Job{Name: "slow", Run: func(context.Context) error {
+		close(started)
+		<-release
+		close(finished)
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	<-started
+
+	errc := make(chan error, 1)
+	go func() { errc <- r.Shutdown(context.Background()) }()
+	select {
+	case <-errc:
+		t.Fatal("Shutdown returned while a job was running")
+	case <-time.After(50 * time.Millisecond):
+	}
+	close(release)
+	if err := <-errc; err != nil {
+		t.Fatalf("Shutdown = %v, want nil", err)
+	}
+	select {
+	case <-finished:
+	default:
+		t.Fatal("Shutdown returned before the running job finished")
+	}
+}
+
+func TestShutdownCancelsRunningJobsWhenContextEnds(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started := make(chan struct{})
