-	case r.queue <- j:
+	case <-done:
 		return nil
-	default:
-		return ErrQueueFull
+	case <-ctx.Done():
 	}
+
+	r.mu.Lock()
+	if len(r.active) == 0 {
+		// Every job finished before ctx ended; the workers are just exiting.
+		r.mu.Unlock()
+		<-done
+		return nil
+	}
+	for _, run := range r.active {
+		run.canceled = true
+		run.cancel()
+	}
+	r.mu.Unlock()
+	<-done
+	return ctx.Err()
 }
 
-// Stop stops the runner.
+// Stop stops the runner like Shutdown, with a 30 second timeout.
 func (r *Runner) Stop() {
-	close(r.queue)
+	ctx, cancel := context.WithTimeout(context.Background(), stopTimeout)
+	defer cancel()
+	_ = r.Shutdown(ctx)
+}
+
+// Pending returns the jobs that still need to run, in the order they were enqueued. Before Shutdown these
+// are the queued jobs that have not started. After Shutdown they are the jobs that were never started,
+// followed by the jobs whose context Shutdown cancelled and that returned an error.
+func (r *Runner) Pending() []Job {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	abandon := slices.Clone(r.abandon)
+	slices.SortFunc(abandon, func(a, b entry) int { return a.seq - b.seq })
+	pending := make([]Job, 0, len(r.queue)+len(abandon))
+	for _, e := range r.queue {
+		pending = append(pending, e.job)
+	}
+	for _, e := range abandon {
+		pending = append(pending, e.job)
+	}
+	return pending
 }
