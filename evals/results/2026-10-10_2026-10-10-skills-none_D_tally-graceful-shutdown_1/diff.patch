+// Shutdown stops the runner. From the moment it is called, Enqueue returns ErrStopped and jobs that have
+// not started are not started. It waits for running jobs to finish. If ctx ends first, it cancels the
+// context of every running job, waits for them to return and returns ctx.Err(). It returns nil when every
+// running job finished before ctx ended. A call after the first returns nil at once, without waiting.
+func (r *Runner) Shutdown(ctx context.Context) error {
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return nil
+	}
+	r.closed = true
+	r.cond.Broadcast()
+	r.mu.Unlock()
+
+	done := make(chan struct{})
+	go func() {
+		r.wg.Wait()
+		close(done)
+	}()
+
