+func TestSecondShutdownReturnsAtOnce(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started := make(chan struct{})
+	release := make(chan struct{})
+	if err := r.Enqueue(Job{Name: "slow", Run: func(context.Context) error {
+		close(started)
+		<-release
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	<-started
+	errc := make(chan error, 1)
+	go func() { errc <- r.Shutdown(context.Background()) }()
+	// Wait until the first call has stopped the runner, so the next call is a second one.
+	deadline := time.Now().Add(5 * time.Second)
+	for !errors.Is(r.Enqueue(Job{Name: "probe", Run: func(context.Context) error { return nil }}), ErrStopped) {
+		if time.Now().After(deadline) {
+			t.Fatal("first Shutdown did not stop the runner")
+		}
+		time.Sleep(time.Millisecond)
+	}
+
+	second := make(chan error, 1)
+	go func() { second <- r.Shutdown(context.Background()) }()
+	select {
+	case err := <-second:
+		if err != nil {
+			t.Fatalf("second Shutdown = %v, want nil", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("second Shutdown blocked")
+	}
+
+	close(release)
+	if err := <-errc; err != nil {
+		t.Fatalf("first Shutdown = %v, want nil", err)
+	}
+	stopped := make(chan struct{})
+	go func() { r.Stop(); close(stopped) }()
+	select {
+	case <-stopped:
+	case <-time.After(5 * time.Second):
+		t.Fatal("Stop after Shutdown blocked")
+	}
+}
