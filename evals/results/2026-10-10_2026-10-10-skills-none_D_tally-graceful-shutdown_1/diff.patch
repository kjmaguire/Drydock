+func TestPanickingJobIsRecovered(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	boomRuns := 0
+	ran := make(chan struct{})
+	if err := r.Enqueue(Job{Name: "boom", Run: func(context.Context) error {
+		boomRuns++
+		panic("boom")
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Enqueue(Job{Name: "after", Run: func(context.Context) error {
+		close(ran)
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-ran:
+	case <-time.After(5 * time.Second):
+		t.Fatal("job after the panic did not run")
+	}
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if boomRuns != 1 {
+		t.Fatalf("panicking job ran %d times, want 1", boomRuns)
+	}
+	if got := r.Pending(); len(got) != 0 {
+		t.Fatalf("pending = %v, want none", names(got))
+	}
+}
