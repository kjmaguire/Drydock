+package api_test
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"net/http"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// globex holds one object of each kind that Globex's API made, so that Acme's key can be pointed at them.
+type globex struct {
+	customer, plan, sub, invoice, endpoint, event, invite, apiKey, member string
+}
+
+func makeGlobexObjects(t *testing.T, e *apitest.Env) globex {
+	t.Helper()
+	g := e.Globex.Key
+	cus := e.CreateCustomer(e.Globex, "Gina", "gina@globex.example")
+	plan := e.CreatePlan(e.Globex, "Business", "USD", "50.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", g, map[string]any{"customer_id": cus.ID, "plan_id": plan.ID}, &sub)
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", g, map[string]any{"customer_id": cus.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Seats", "quantity": 2, "unit_amount": 1000}}}, &inv)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", g, map[string]any{"url": "https://hooks.globex.example/tally", "events": []string{"customer.created"}}, &ep)
+	var invite store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", g, map[string]any{"email": "hire@globex.example", "role": "member"}, &invite)
+	var key store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", g, map[string]any{"name": "CI"}, &key)
+	member, _ := e.AddMember(e.Globex, "viewer@globex.example", store.RoleViewer)
+	events := e.Store.Events(e.Globex.ID, "customer.created")
+	if len(events) == 0 {
+		t.Fatal("no event for the customer Globex created")
+	}
+	return globex{customer: cus.ID, plan: plan.ID, sub: sub.ID, invoice: inv.ID, endpoint: ep.ID, event: events[0].ID,
+		invite: invite.ID, apiKey: key.ID, member: member.ID}
+}
+
+// globexState is what Globex's objects look like, to check that nothing a request did changed them.
+func globexState(e *apitest.Env, f globex) map[string]any {
+	g := e.Globex.ID
+	c, _ := e.Store.Customer(g, f.customer)
+	p, _ := e.Store.Plan(g, f.plan)
+	s, _ := e.Store.Subscription(g, f.sub)
+	i, _ := e.Store.Invoice(g, f.invoice)
+	ep, _ := e.Store.WebhookEndpoint(g, f.endpoint)
+	ev, _ := e.Store.Event(g, f.event)
+	m, _ := e.Store.Member(g, f.member)
+	return map[string]any{"customer": c, "plan": p, "sub": s, "invoice": i, "endpoint": ep, "event": ev, "member": m,
+		"keys": e.Store.APIKeys(g), "invites": e.Store.Invites(g), "payments": e.Store.Payments(g, ""),
+		"endpoint-deliveries": e.Store.Deliveries(g, f.endpoint), "customers": e.Store.Customers(g), "subs": e.Store.Subscriptions(g, store.SubscriptionFilter{})}
+}
+
+// idProbe is one request that names an object by ID, in the path or in the body or query. build returns the request's path
+// and body for the ID it is given.
+type idProbe struct {
+	name, method string
+	build        func(id string) (path string, body any)
+	foreign      string // a Globex object's ID
+}
+
+// TestOtherOrganizationsObjectsAnswerLikeUnknownOnes sends Acme's key at every kind of Globex object, by path and by body.
+// Each answer must be the one an unknown ID gets, byte for byte, and Globex's objects must not change.
+func TestOtherOrganizationsObjectsAnswerLikeUnknownOnes(t *testing.T) {
+	e := apitest.New(t)
+	f := makeGlobexObjects(t, e)
+	acmeCustomer := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	acmePlan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+
+	// The objects are real: Globex's own key reads them.
+	for _, path := range []string{"/v1/customers/" + f.customer, "/v1/plans/" + f.plan, "/v1/subscriptions/" + f.sub,
+		"/v1/invoices/" + f.invoice, "/v1/invoices/" + f.invoice + "/lines", "/v1/webhook-endpoints/" + f.endpoint, "/v1/events/" + f.event} {
+		e.MustDo(http.StatusOK, "GET", path, e.Globex.Key, nil, nil)
+	}
+	before := globexState(e, f)
+
+	path := func(tmpl string) func(string) (string, any) {
+		return func(id string) (string, any) { return strings.ReplaceAll(tmpl, "{id}", id), nil }
+	}
+	withBody := func(tmpl string, body any) func(string) (string, any) {
+		return func(id string) (string, any) { return strings.ReplaceAll(tmpl, "{id}", id), body }
+	}
+	probes := []idProbe{
+		{"get customer", "GET", path("/v1/customers/{id}"), f.customer},
+		{"update customer", "PATCH", withBody("/v1/customers/{id}", map[string]any{"name": "Hacked"}), f.customer},
+		{"delete customer", "DELETE", path("/v1/customers/{id}"), f.customer},
+		{"get plan", "GET", path("/v1/plans/{id}"), f.plan},
+		{"update plan", "PATCH", withBody("/v1/plans/{id}", map[string]any{"name": "Hacked"}), f.plan},
+		{"get subscription", "GET", path("/v1/subscriptions/{id}"), f.sub},
+		{"update subscription", "PATCH", withBody("/v1/subscriptions/{id}", map[string]any{"quantity": 9}), f.sub},
+		{"cancel subscription", "POST", path("/v1/subscriptions/{id}/cancel"), f.sub},
+		{"report usage", "POST", withBody("/v1/subscriptions/{id}/usage", map[string]any{"quantity": 1}), f.sub},
+		{"get invoice", "GET", path("/v1/invoices/{id}"), f.invoice},
+		{"get invoice lines", "GET", path("/v1/invoices/{id}/lines"), f.invoice},
+		{"pay invoice", "POST", path("/v1/invoices/{id}/pay"), f.invoice},
+		{"void invoice", "POST", path("/v1/invoices/{id}/void"), f.invoice},
+		{"get webhook endpoint", "GET", path("/v1/webhook-endpoints/{id}"), f.endpoint},
+		{"update webhook endpoint", "PATCH", withBody("/v1/webhook-endpoints/{id}", map[string]any{"enabled": false}), f.endpoint},
+		{"delete webhook endpoint", "DELETE", path("/v1/webhook-endpoints/{id}"), f.endpoint},
+		{"list webhook endpoint deliveries", "GET", path("/v1/webhook-endpoints/{id}/deliveries"), f.endpoint},
+		{"get event", "GET", path("/v1/events/{id}"), f.event},
+		{"revoke invite", "DELETE", path("/v1/invites/{id}"), f.invite},
+		{"revoke API key", "DELETE", path("/v1/api-keys/{id}"), f.apiKey},
+		{"change member role", "PATCH", withBody("/v1/members/{id}", map[string]any{"role": "admin"}), f.member},
+		{"remove member", "DELETE", path("/v1/members/{id}"), f.member},
+		{"create invoice for customer", "POST", func(id string) (string, any) {
+			return "/v1/invoices", map[string]any{"customer_id": id, "currency": "USD", "lines": []map[string]any{{"description": "Seats", "quantity": 1, "unit_amount": 100}}}
+		}, f.customer},
+		{"create subscription for customer", "POST", func(id string) (string, any) {
+			return "/v1/subscriptions", map[string]any{"customer_id": id, "plan_id": acmePlan.ID}
+		}, f.customer},
+		{"create subscription for plan", "POST", func(id string) (string, any) {
+			return "/v1/subscriptions", map[string]any{"customer_id": acmeCustomer.ID, "plan_id": id}
+		}, f.plan},
+	}
+	// Moving Acme's own subscription to another organization's plan.
+	var ownSub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": acmeCustomer.ID, "plan_id": acmePlan.ID}, &ownSub)
+	probes = append(probes, idProbe{"move own subscription to plan", "PATCH", func(id string) (string, any) {
+		return "/v1/subscriptions/" + ownSub.ID, map[string]any{"plan_id": id}
+	}, f.plan})
+
+	for _, p := range probes {
+		t.Run(p.name, func(t *testing.T) {
+			path, body := p.build(p.foreign)
+			foreign := e.Do(p.method, path, e.Acme.Key, body)
+			path, body = p.build("nothing_has_this_id")
+			unknown := e.Do(p.method, path, e.Acme.Key, body)
+			if unknown.Code != http.StatusNotFound || unknown.Map(t)["error"] != "not_found" {
+				t.Fatalf("an unknown ID: %s", unknown)
+			}
+			if foreign.Code != unknown.Code || string(foreign.Body) != string(unknown.Body) {
+				t.Fatalf("another organization's ID: %s; an unknown ID: %s", foreign, unknown)
+			}
+		})
+	}
+	if after := globexState(e, f); !reflect.DeepEqual(before, after) {
+		t.Fatalf("Globex's objects changed:\nbefore %v\nafter  %v", before, after)
+	}
+}
+
+// TestOtherOrganizationsObjectsFindNothingInQueries: a filter by another organization's ID or email finds nothing, the way
+// a filter by an unknown one does.
+func TestOtherOrganizationsObjectsFindNothingInQueries(t *testing.T) {
+	e := apitest.New(t)
+	f := makeGlobexObjects(t, e)
+	for _, tmpl := range []string{"/v1/invoices?customer_id={id}", "/v1/invoices?subscription_id={id}", "/v1/subscriptions?customer_id={id}",
+		"/v1/payments?invoice_id={id}", "/v1/customers?email={id}"} {
+		foreign := f.customer
+		if strings.Contains(tmpl, "invoice") {
+			foreign = f.invoice
+		}
+		if strings.Contains(tmpl, "subscription") {
+			foreign = f.sub
+		}
+		if strings.Contains(tmpl, "email") {
+			foreign = "gina@globex.example"
+		}
+		got := e.MustDo(http.StatusOK, "GET", strings.ReplaceAll(tmpl, "{id}", foreign), e.Acme.Key, nil, nil)
+		want := e.MustDo(http.StatusOK, "GET", strings.ReplaceAll(tmpl, "{id}", "nothing_has_this_id"), e.Acme.Key, nil, nil)
+		if string(got.Body) != string(want.Body) || string(got.Body) != `{"items":[]}`+"\n" {
+			t.Fatalf("%s: another organization's value %s; an unknown one %s", tmpl, got, want)
+		}
+	}
+}
+
+// TestCustomerEmailsAreOrganizationScoped: two organizations can each have a customer with the same email address, and
+// neither sees or affects the other's.
+func TestCustomerEmailsAreOrganizationScoped(t *testing.T) {
+	e := apitest.New(t)
+	acme := e.CreateCustomer(e.Acme, "Acme Jane", "jane@example.com")
+	globexJane := e.CreateCustomer(e.Globex, "Globex Jane", "JANE@example.com")
+
+	findByEmail := func(org apitest.Org, email string) []string {
+		t.Helper()
+		var out struct {
+			Items []store.Customer `json:"items"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/customers?email="+email, org.Key, nil, &out)
+		ids := []string{}
+		for _, c := range out.Items {
+			ids = append(ids, c.ID)
+		}
+		return ids
+	}
+	if got := findByEmail(e.Acme, "jane@example.com"); !reflect.DeepEqual(got, []string{acme.ID}) {
+		t.Fatalf("Acme finds %v, want its own customer", got)
+	}
+	if got := findByEmail(e.Globex, "jane@example.com"); !reflect.DeepEqual(got, []string{globexJane.ID}) {
+		t.Fatalf("Globex finds %v, want its own customer", got)
+	}
+
+	// Globex deletes its customer: Acme's is still there, and Globex's email is free again.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+globexJane.ID, e.Globex.Key, nil, nil)
+	if got := findByEmail(e.Acme, "jane@example.com"); !reflect.DeepEqual(got, []string{acme.ID}) {
+		t.Fatalf("after Globex's delete, Acme finds %v", got)
+	}
+	globexJane2 := e.CreateCustomer(e.Globex, "Globex Jane", "jane@example.com")
+
+	// Acme moves its customer to another address: Globex's customer keeps its address.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+acme.ID, e.Acme.Key, map[string]any{"email": "acme-jane@example.com"}, nil)
+	if got := findByEmail(e.Acme, "jane@example.com"); len(got) != 0 {
+		t.Fatalf("Acme finds %v at its old address", got)
+	}
+	if got := findByEmail(e.Globex, "jane@example.com"); !reflect.DeepEqual(got, []string{globexJane2.ID}) {
+		t.Fatalf("after Acme's change, Globex finds %v", got)
+	}
+	if got := findByEmail(e.Acme, "acme-jane@example.com"); !reflect.DeepEqual(got, []string{acme.ID}) {
+		t.Fatalf("Acme finds %v at its new address", got)
+	}
+
+	// An address only Globex has is not found by Acme, and an address Acme has is still refused within Acme.
+	e.CreateCustomer(e.Globex, "Only Globex", "only@globex.example")
+	if got := findByEmail(e.Acme, "only@globex.example"); len(got) != 0 {
+		t.Fatalf("Acme finds Globex's customer: %v", got)
+	}
+	if r := e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Dup", "email": "ACME-jane@example.com"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "email_taken" {
+		t.Fatalf("duplicate within Acme: %s", r)
+	}
+}
+
+// TestAPIUsesOnlyOrganizationScopedStoreMethods: the store's methods that find an object by its ID alone are for background
+// jobs and the admin tool. A request handler that calls one can reach another organization's object.
+func TestAPIUsesOnlyOrganizationScopedStoreMethods(t *testing.T) {
+	idOnly := map[string]bool{"CustomerByID": true, "InvoiceByID": true, "EventByID": true, "Delivery": true,
+		"UpdateDelivery": true, "DeleteWebhookEndpoint": true}
+	files, err := filepath.Glob("*.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fset := token.NewFileSet()
+	for _, name := range files {
+		if strings.HasSuffix(name, "_test.go") {
+			continue
+		}
+		f, err := parser.ParseFile(fset, name, nil, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ast.Inspect(f, func(n ast.Node) bool {
+			sel, ok := n.(*ast.SelectorExpr)
+			if !ok || !idOnly[sel.Sel.Name] {
+				return true
+			}
+			if store, ok := sel.X.(*ast.SelectorExpr); ok && store.Sel.Name == "store" {
+				t.Errorf("%s: %s calls the store's %s, which ignores the organization", name, fset.Position(sel.Pos()), sel.Sel.Name)
+			}
+			return true
+		})
+	}
+}
