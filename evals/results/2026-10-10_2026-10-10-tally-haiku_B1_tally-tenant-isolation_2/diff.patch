+// Two organizations can each have a customer with the same email address, and neither affects the other's lookups, updates
+// or deletes. The index of email addresses is per organization, and FromState rebuilds it.
+func TestCustomerEmailsAreIndexedPerOrganization(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, err := s.CreateCustomer(a.ID, "Ann", "same@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cb, err := s.CreateCustomer(b.ID, "Bea", "SAME@example.com", t0)
+	if err != nil {
+		t.Fatalf("the same email in another org: %v", err)
+	}
+	find := func(org Org, email string) string {
+		t.Helper()
+		c, ok := s.FindCustomerByEmail(org.ID, email)
+		if !ok {
+			return ""
+		}
+		return c.ID
+	}
+	if got := find(a, "same@example.com"); got != ca.ID {
+		t.Fatalf("A finds %q, want its own customer", got)
+	}
+	if got := find(b, "same@example.com"); got != cb.ID {
+		t.Fatalf("B finds %q, want its own customer", got)
+	}
+
+	// B moves its customer away and deletes it: A's address is still A's.
+	if _, err := s.UpdateCustomer(b.ID, cb.ID, func(c *Customer) error { c.Email = "bea@example.com"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if got := find(a, "same@example.com"); got != ca.ID {
+		t.Fatalf("after B's update, A finds %q", got)
+	}
+	if err := s.DeleteCustomer(b.ID, cb.ID); err != nil {
+		t.Fatal(err)
+	}
+	if got := find(a, "same@example.com"); got != ca.ID {
+		t.Fatalf("after B's delete, A finds %q", got)
+	}
+	if got := find(b, "same@example.com"); got != "" {
+		t.Fatalf("B finds %q at an address it left", got)
+	}
+
+	// A customer of B cannot be named by A, whatever address it has.
+	if got := find(a, "bea@example.com"); got != "" {
+		t.Fatalf("A finds B's customer %q", got)
+	}
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c, ok := s2.FindCustomerByEmail(a.ID, "same@example.com"); !ok || c.ID != ca.ID {
+		t.Fatalf("after FromState, A finds %+v %v", c, ok)
+	}
+	if _, ok := s2.FindCustomerByEmail(b.ID, "same@example.com"); ok {
+		t.Fatal("after FromState, B finds A's customer")
+	}
+}
