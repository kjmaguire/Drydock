+// TieredAmount returns what quantity units cost on a metered plan priced with tiers, in minor units. Tier UpTo values are
+// inclusive, and a quantity of 0 costs 0.
+//
+// Graduated: each unit is priced at the unit amount of the tier it falls in, and every tier that at least one unit falls
+// in adds its flat amount. Volume: every unit is priced at the unit amount of the one tier the quantity falls in, and that
+// tier adds its flat amount. The tiers are expected to be valid (store.Plan's tiers are checked when the plan is created).
+func TieredAmount(tiers []store.Tier, mode store.TiersMode, quantity int64) int64 {
+	if quantity <= 0 {
+		return 0
+	}
+	var total int64
+	switch mode {
+	case store.Graduated:
+		var prev int64 // the last unit covered by the tiers before this one
+		for _, t := range tiers {
+			if quantity <= prev {
+				break
+			}
+			top := quantity
+			if t.UpTo != nil && *t.UpTo < top {
+				top = *t.UpTo
+			}
+			total += (top-prev)*t.UnitAmount + t.FlatAmount
+			if t.UpTo == nil {
+				break
+			}
+			prev = *t.UpTo
+		}
+	case store.Volume:
+		for _, t := range tiers {
+			if t.UpTo == nil || quantity <= *t.UpTo {
+				return quantity*t.UnitAmount + t.FlatAmount
+			}
+		}
+	}
+	return total
+}
