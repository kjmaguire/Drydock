+func TestTieredAmount(t *testing.T) {
+	// 1-10 units at 100 each, 11-100 at 50 with a flat 500, then 101 and up at 20 with a flat 1000.
+	tiers := []store.Tier{
+		{UpTo: upTo(10), UnitAmount: 100},
+		{UpTo: upTo(100), UnitAmount: 50, FlatAmount: 500},
+		{UnitAmount: 20, FlatAmount: 1000},
+	}
+	graduated := []struct {
+		q    int64
+		want int64
+	}{
+		{0, 0},
+		{1, 100},
+		{10, 1000},                // the first tier's up_to is inclusive: no flat of the second tier
+		{11, 1000 + 50 + 500},     // one unit in the second tier pays its flat
+		{100, 1000 + 90*50 + 500}, // up to the second tier's up_to
+		{101, 1000 + 90*50 + 500 + 20 + 1000},
+		{150, 1000 + 90*50 + 500 + 50*20 + 1000},
+	}
+	for _, c := range graduated {
+		if got := TieredAmount(tiers, store.Graduated, c.q); got != c.want {
+			t.Errorf("graduated %d = %d, want %d", c.q, got, c.want)
+		}
+	}
+	volume := []struct {
+		q    int64
+		want int64
+	}{
+		{0, 0},
+		{1, 100},
+		{10, 1000},           // the first tier, inclusive
+		{11, 11*50 + 500},    // every unit at the second tier's price
+		{100, 100*50 + 500},  // the second tier, inclusive
+		{101, 101*20 + 1000}, // the unbounded tier
+		{1000, 1000*20 + 1000},
+	}
+	for _, c := range volume {
+		if got := TieredAmount(tiers, store.Volume, c.q); got != c.want {
+			t.Errorf("volume %d = %d, want %d", c.q, got, c.want)
+		}
+	}
+}
+
+func TestTieredAmountSingleUnboundedTier(t *testing.T) {
+	tiers := []store.Tier{{UnitAmount: 7, FlatAmount: 300}}
+	if got := TieredAmount(tiers, store.Graduated, 4); got != 4*7+300 {
+		t.Errorf("graduated = %d", got)
+	}
+	if got := TieredAmount(tiers, store.Volume, 4); got != 4*7+300 {
+		t.Errorf("volume = %d", got)
+	}
+	if got := TieredAmount(tiers, store.Volume, 0); got != 0 {
+		t.Errorf("volume of 0 = %d", got)
+	}
+}
