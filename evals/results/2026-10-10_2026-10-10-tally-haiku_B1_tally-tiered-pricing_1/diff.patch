+
+func TestTieredMeteredBillsOneLinePerPeriod(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	upTo := func(n int64) *int64 { return &n }
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, Interval: store.Monthly, UsageType: store.Metered,
+		TiersMode: store.Graduated, Tiers: []store.Tier{{UpTo: upTo(10), UnitAmount: 2}, {UnitAmount: 1, FlatAmount: 300}}}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	start, end := sub.CurrentPeriodStart, sub.CurrentPeriodEnd
+	if _, err := e.Store.AddUsage(e.Acme.ID, sub.ID, 15, start, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(end)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	// 15 units: 10 at 2, 5 at 1, and the second tier's flat 300.
+	want := store.Line{Description: "API calls usage, " + start.Format("Jan 2, 2006") + " to " + end.Format("Jan 2, 2006"), Quantity: 1, UnitAmount: 10*2 + 5*1 + 300}
+	if len(invs) != 1 || len(invs[0].Lines) != 1 || invs[0].Lines[0] != want || invs[0].Status != store.InvoiceOpen {
+		t.Fatalf("invoices = %+v, want one line %+v", invs, want)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 0 {
+		t.Fatalf("charges = %+v (the customer has no payment method)", cs)
+	}
+}
+
+func TestTieredMeteredWithoutUsageHasNoInvoice(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, Interval: store.Monthly, UsageType: store.Metered,
+		TiersMode: store.Volume, Tiers: []store.Tier{{UnitAmount: 2}}}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 0 {
+		t.Fatalf("invoices = %+v, want none", invs)
+	}
+	if got, _ := e.Store.Subscription(e.Acme.ID, sub.ID); got.Status != store.Active || got.CurrentPeriodEnd.Before(e.Clock.Now()) {
