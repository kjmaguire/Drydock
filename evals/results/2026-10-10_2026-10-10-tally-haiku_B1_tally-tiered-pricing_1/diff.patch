+// checkTiers accepts a plan without tiers, or a metered plan whose tiers are at least one, sorted by UpTo with each UpTo
+// above the one before (the first above 0), no negative amounts, and no UpTo only on the last tier.
+func checkTiers(p Plan) error {
+	if !p.Tiered() {
+		if p.TiersMode != "" {
+			return invalidTiers("tiers_mode needs tiers")
+		}
+		return nil
+	}
+	switch {
+	case p.UsageType != Metered:
+		return invalidTiers("only a metered plan has tiers")
+	case !p.TiersMode.Valid():
+		return invalidTiers("tiers_mode is graduated or volume")
+	}
+	var prev int64
+	for i, t := range p.Tiers {
+		last := i == len(p.Tiers)-1
+		switch {
+		case t.UnitAmount < 0 || t.FlatAmount < 0:
+			return invalidTiers("tier %d has a negative amount", i+1)
+		case last && t.UpTo != nil:
+			return invalidTiers("the last tier has no up_to")
+		case !last && t.UpTo == nil:
+			return invalidTiers("only the last tier may have no up_to")
+		case t.UpTo != nil && *t.UpTo <= prev:
+			return invalidTiers("tier %d's up_to must be a positive whole number above the tier before it", i+1)
+		}
+		if t.UpTo != nil {
+			prev = *t.UpTo
+		}
+	}
 	return nil
 }
 
