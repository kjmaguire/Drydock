+		"not strictly":       {UsageType: Metered, TiersMode: Volume, Tiers: []Tier{{UpTo: upTo(10), UnitAmount: 1}, {UpTo: upTo(10), UnitAmount: 1}, {UnitAmount: 1}}},
+		"zero up_to":         {UsageType: Metered, TiersMode: Volume, Tiers: []Tier{{UpTo: upTo(0), UnitAmount: 1}, {UnitAmount: 1}}},
+		"negative up_to":     {UsageType: Metered, TiersMode: Volume, Tiers: []Tier{{UpTo: upTo(-5), UnitAmount: 1}, {UnitAmount: 1}}},
+		"last has up_to":     {UsageType: Metered, TiersMode: Volume, Tiers: []Tier{{UpTo: upTo(10), UnitAmount: 1}}},
+		"middle unbounded":   {UsageType: Metered, TiersMode: Volume, Tiers: []Tier{{UnitAmount: 1}, {UnitAmount: 1}}},
+		"negative amount":    {UsageType: Metered, TiersMode: Volume, Tiers: []Tier{{UpTo: upTo(10), UnitAmount: -1}, {UnitAmount: 1}}},
+		"negative flat":      {UsageType: Metered, TiersMode: Volume, Tiers: []Tier{{UpTo: upTo(10), UnitAmount: 1, FlatAmount: -1}, {UnitAmount: 1}}},
+	}
+	for name, p := range bad {
+		p.OrgID, p.Name, p.Currency, p.Interval = a.ID, "Bad", money.USD, Monthly
+		if _, err := s.CreatePlan(p, t0); !errors.Is(err, ErrInvalidTiers) {
+			t.Errorf("%s: CreatePlan err = %v, want ErrInvalidTiers", name, err)
+		}
+	}
+
+	up, err := s.UpdatePlan(a.ID, p.ID, func(p *Plan) error {
+		p.TiersMode, p.Tiers, p.Name = Volume, []Tier{{UnitAmount: 1}}, "Renamed"
+		return nil
+	})
+	if err != nil || up.Name != "Renamed" || up.TiersMode != Graduated || len(up.Tiers) != 3 {
+		t.Fatalf("UpdatePlan = %+v, %v (the tiers must not change)", up, err)
+	}
+}
