+// parseTiers reads the tiers of a plan. Any tier that cannot be read is an ErrInvalidTiers; the store checks the rest.
+func parseTiers(in []tierIn, c money.Currency) ([]store.Tier, error) {
+	if len(in) == 0 {
+		return nil, fmt.Errorf("%w: a plan with tiers needs at least one", store.ErrInvalidTiers)
+	}
+	out := make([]store.Tier, 0, len(in))
+	for i, t := range in {
+		n := i + 1
+		upTo, err := parseUpTo(t.UpTo)
+		if err != nil {
+			return nil, fmt.Errorf("%w: tier %d: up_to is a whole number or null", store.ErrInvalidTiers, n)
+		}
+		unit, err := money.ParseMajor(t.UnitAmount, c)
+		if err != nil {
+			return nil, fmt.Errorf("%w: tier %d: unit_amount: %v", store.ErrInvalidTiers, n, err)
+		}
+		var flat int64
+		if t.FlatAmount != "" {
+			if flat, err = money.ParseMajor(t.FlatAmount, c); err != nil {
+				return nil, fmt.Errorf("%w: tier %d: flat_amount: %v", store.ErrInvalidTiers, n, err)
+			}
+		}
+		out = append(out, store.Tier{UpTo: upTo, UnitAmount: unit, FlatAmount: flat})
+	}
+	return out, nil
+}
+
+// parseUpTo reads a tier's up_to: a whole number, or nothing or null for no limit.
+func parseUpTo(raw json.RawMessage) (*int64, error) {
+	if len(raw) == 0 || string(raw) == "null" {
+		return nil, nil
+	}
+	var n int64
+	if err := json.Unmarshal(raw, &n); err != nil {
+		return nil, err
+	}
+	return &n, nil
+}
