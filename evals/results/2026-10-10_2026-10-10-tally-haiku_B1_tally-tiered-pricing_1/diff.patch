+// TiersMode says how a metered plan's tiers price usage.
+type TiersMode string
+
+// Tier modes.
+const (
+	// Graduated prices each unit at the tier it falls in: the first tier's units at its unit amount, the next tier's at its
+	// own, and so on.
+	Graduated TiersMode = "graduated"
+	// Volume prices every unit at the one tier the total usage falls in.
+	Volume TiersMode = "volume"
+)
+
+// Valid reports whether m is a known tier mode.
+func (m TiersMode) Valid() bool { return m == Graduated || m == Volume }
+
+// Tier is one band of a metered plan's pricing. UpTo is the last quantity the tier covers, inclusive; nil means no limit,
+// which only the last tier may have. Amounts are in minor units.
+type Tier struct {
+	UpTo       *int64 `json:"up_to"`
+	UnitAmount int64  `json:"unit_amount"`
+	FlatAmount int64  `json:"flat_amount"`
+}
+
