+// TestCustomerEmailsArePerOrganization: two organizations can each have a customer with the same email address, and neither
+// sees, blocks or changes the other's.
+func TestCustomerEmailsArePerOrganization(t *testing.T) {
+	e := apitest.New(t)
+	acmeJane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	globexJane := e.CreateCustomer(e.Globex, "Jane G", "JANE@example.com")
+
+	find := func(org apitest.Org, email string) []store.Customer {
+		t.Helper()
+		var out struct{ Items []store.Customer }
+		e.MustDo(http.StatusOK, "GET", "/v1/customers?email="+url.QueryEscape(email), org.Key, nil, &out)
+		return out.Items
+	}
+	if got := find(e.Acme, "jane@example.com"); len(got) != 1 || got[0].ID != acmeJane.ID {
+		t.Fatalf("Acme's lookup = %+v, want its own customer %s", got, acmeJane.ID)
+	}
+	if got := find(e.Globex, "jane@example.com"); len(got) != 1 || got[0].ID != globexJane.ID {
+		t.Fatalf("Globex's lookup = %+v, want its own customer %s", got, globexJane.ID)
+	}
+
+	// Acme's duplicate check ignores Globex's customer; its own still counts.
+	if r := e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane 2", "email": "Jane@Example.com"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "email_taken" {
+		t.Fatalf("Acme's duplicate: %s", r)
+	}
+
+	// An address only Globex has is not found by Acme.
+	gus := e.CreateCustomer(e.Globex, "Gus", "gus@example.com")
+	if got := find(e.Acme, "gus@example.com"); len(got) != 0 {
+		t.Fatalf("Acme found Globex's customer: %+v", got)
+	}
+
+	// Acme may move its customer to an address Globex uses.
+	var moved store.Customer
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+acmeJane.ID, e.Acme.Key, map[string]string{"email": "gus@example.com"}, &moved)
+	if got := find(e.Acme, "gus@example.com"); len(got) != 1 || got[0].ID != acmeJane.ID {
+		t.Fatalf("Acme's lookup after its rename = %+v", got)
+	}
+	if got := find(e.Globex, "gus@example.com"); len(got) != 1 || got[0].ID != gus.ID {
+		t.Fatalf("Globex's lookup after Acme's rename = %+v", got)
+	}
+
+	// Deleting Globex's customer leaves Acme's lookups alone.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+globexJane.ID, e.Globex.Key, nil, nil)
+	if got := find(e.Acme, "jane@example.com"); len(got) != 0 {
+		t.Fatalf("Acme found a deleted customer: %+v", got)
+	}
+	if got := find(e.Acme, "gus@example.com"); len(got) != 1 || got[0].ID != acmeJane.ID {
+		t.Fatalf("Acme's lookup after Globex's delete = %+v", got)
+	}
+
+	// Within Acme, a rename onto its own other customer's address is still refused.
+	acmeBob := e.CreateCustomer(e.Acme, "Bob", "bob@example.com")
+	if r := e.Do("PATCH", "/v1/customers/"+acmeBob.ID, e.Acme.Key, map[string]string{"email": "gus@example.com"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "email_taken" {
+		t.Fatalf("Acme's rename onto its own address: %s", r)
+	}
+}
