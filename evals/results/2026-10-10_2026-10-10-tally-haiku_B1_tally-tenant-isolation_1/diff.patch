+// TestCrossOrgFiltersFindNothing looks up Globex's values with Acme's key: every list is empty, as it is for values that
+// match nothing.
+func TestCrossOrgFiltersFindNothing(t *testing.T) {
+	e := apitest.New(t)
+	gCus := e.CreateCustomer(e.Globex, "Gina", "gina@globex.example")
+	gSub := newSubscription(e, e.Globex, gCus.ID, e.CreatePlan(e.Globex, "Business", "USD", "50.00").ID)
+	gInv := newInvoice(e, e.Globex, gCus.ID)
+
+	var own struct{ Items []store.Customer }
+	e.MustDo(http.StatusOK, "GET", "/v1/customers?email="+url.QueryEscape("gina@globex.example"), e.Globex.Key, nil, &own)
+	if len(own.Items) != 1 {
+		t.Fatalf("the owner's email lookup = %+v", own)
+	}
+
+	for _, path := range []string{
+		"/v1/customers?email=" + url.QueryEscape("gina@globex.example"),
+		"/v1/customers?q=Gina",
+		"/v1/invoices?customer_id=" + gCus.ID,
+		"/v1/invoices?subscription_id=" + gSub.ID,
+		"/v1/subscriptions?customer_id=" + gCus.ID,
+		"/v1/payments?invoice_id=" + gInv.ID,
+		"/v1/events?type=customer.created",
+	} {
+		var out struct{ Items []any }
+		e.MustDo(http.StatusOK, "GET", path, e.Acme.Key, nil, &out)
+		if len(out.Items) != 0 {
+			t.Fatalf("GET %s with Acme's key found %d items", path, len(out.Items))
+		}
+	}
+}
