--- /dev/null
+++ b/result/internal/store/tenant_test.go
@@ -0,0 +1,103 @@
+package store
+
+import (
+	"errors"
+	"testing"
+
+	"example.com/tally/internal/money"
+)
+
+// TestCustomerEmailsArePerOrganization: the same address can be a customer's in two organizations, and each organization's
+// lookups, duplicate checks and deletes see only its own. The index must also come back right from a snapshot.
+func TestCustomerEmailsArePerOrganization(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, err := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cb, err := s.CreateCustomer(b.ID, "Jane B", "JANE@example.com", t0)
+	if err != nil {
+		t.Fatalf("the same address in another organization: %v", err)
+	}
+	check := func(s *Store) {
+		t.Helper()
+		if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+			t.Fatalf("A's lookup = %+v %v, want %s", got, ok, ca.ID)
+		}
+		if got, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); !ok || got.ID != cb.ID {
+			t.Fatalf("B's lookup = %+v %v, want %s", got, ok, cb.ID)
+		}
+	}
+	check(s)
+	if _, err := s.CreateCustomer(a.ID, "Jane 2", "Jane@Example.com", t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("A's duplicate: %v", err)
+	}
+	check(fromStateOf(t, s))
+
+	if err := s.DeleteCustomer(b.ID, cb.ID); err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+		t.Fatalf("A's lookup after B's delete = %+v %v", got, ok)
+	}
+}
+
+// fromStateOf returns a store rebuilt from s's snapshot.
+func fromStateOf(t *testing.T, s *Store) *Store {
+	t.Helper()
+	rebuilt, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return rebuilt
+}
+
+// TestCrossOrgReferencesAreNotFound: an object may not name another organization's customer. The answer is ErrNotFound,
+// the same as for a customer that does not exist, and nothing is stored.
+func TestCrossOrgReferencesAreNotFound(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	pb, err := s.CreatePlan(Plan{OrgID: b.ID, Name: "Team", Currency: money.EUR, UnitAmount: 100, Interval: Monthly}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	_, err = s.CreateSubscription(Subscription{OrgID: b.ID, CustomerID: ca.ID, PlanID: pb.ID, Quantity: 1, Status: Active}, t0)
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for another organization's customer: %v", err)
+	}
+	_, err = s.CreateInvoice(Invoice{OrgID: b.ID, CustomerID: ca.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for another organization's customer: %v", err)
+	}
+	if got := s.Subscriptions(b.ID, SubscriptionFilter{}); len(got) != 0 {
+		t.Fatalf("subscriptions = %+v", got)
+	}
+	if got := s.ListInvoices(b.ID, InvoiceFilter{}); len(got) != 0 {
+		t.Fatalf("invoices = %+v", got)
+	}
+}
+
+// TestDeleteOrgWebhookEndpoint: an endpoint is deleted only by its own organization.
+func TestDeleteOrgWebhookEndpoint(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ep, err := s.CreateWebhookEndpoint(WebhookEndpoint{OrgID: a.ID, URL: "https://hooks.a.example/", Events: []string{"*"}, Enabled: true}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.DeleteOrgWebhookEndpoint(b.ID, ep.ID); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("another organization's delete: %v", err)
+	}
+	if _, ok := s.WebhookEndpoint(a.ID, ep.ID); !ok {
+		t.Fatal("another organization deleted the endpoint")
+	}
+	if err := s.DeleteOrgWebhookEndpoint(a.ID, ep.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.WebhookEndpoint(a.ID, ep.ID); ok {
+		t.Fatal("the endpoint was not deleted")
+	}
+}
