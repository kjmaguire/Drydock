@@ -0,0 +1,294 @@
+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"net/url"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// unknownID is an ID no object has.
+const unknownID = "zzz_does_not_exist"
+
+// notFoundLike fails the test unless got is exactly the answer for an ID that does not exist: 404 {"error":"not_found"} with
+// the same body as want, the answer for unknownID.
+func notFoundLike(t *testing.T, name string, got, want *apitest.Response) {
+	t.Helper()
+	if got.Code != http.StatusNotFound || got.Map(t)["error"] != "not_found" {
+		t.Errorf("%s: another organization's ID answered %s, want 404 not_found", name, got)
+	}
+	if got.Code != want.Code || string(got.Body) != string(want.Body) {
+		t.Errorf("%s: another organization's ID answers %s, but an unknown ID answers %s", name, got, want)
+	}
+}
+
+func newInvoice(e *apitest.Env, org apitest.Org, customerID string) store.Invoice {
+	e.T.Helper()
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", org.Key, map[string]any{"customer_id": customerID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Consulting", "quantity": 2, "unit_amount": 5000}}}, &inv)
+	return inv
+}
+
+func newSubscription(e *apitest.Env, org apitest.Org, customerID, planID string) store.Subscription {
+	e.T.Helper()
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", org.Key, map[string]any{"customer_id": customerID, "plan_id": planID}, &sub)
+	return sub
+}
+
+// TestCrossOrgInvoiceLines is the reported bug: an invoice of another organization must not show its lines.
+func TestCrossOrgInvoiceLines(t *testing.T) {
+	e := apitest.New(t)
+	gCus := e.CreateCustomer(e.Globex, "Gina", "gina@globex.example")
+	gInv := newInvoice(e, e.Globex, gCus.ID)
+
+	notFoundLike(t, "GET invoice lines",
+		e.Do("GET", "/v1/invoices/"+gInv.ID+"/lines", e.Acme.Key, nil),
+		e.Do("GET", "/v1/invoices/"+unknownID+"/lines", e.Acme.Key, nil))
+
+	var lines struct {
+		Items []struct {
+			Description string `json:"description"`
+			Amount      int64  `json:"amount"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+gInv.ID+"/lines", e.Globex.Key, nil, &lines)
+	if len(lines.Items) != 1 || lines.Items[0].Description != "Consulting" || lines.Items[0].Amount != 10000 {
+		t.Fatalf("the owner's invoice lines = %+v", lines)
+	}
+}
+
+// TestCrossOrgIDsAreNotFound sends Acme's key at each of Globex's objects, by path and by an ID named in the body. Each
+// answer must be the answer for an ID that does not exist, and Globex's objects must not change.
+func TestCrossOrgIDsAreNotFound(t *testing.T) {
+	e := apitest.New(t)
+	acmeCus := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	acmePlan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	acmeSub := newSubscription(e, e.Acme, acmeCus.ID, acmePlan.ID)
+
+	gCus := e.CreateCustomer(e.Globex, "Gina", "gina@globex.example")
+	gPlan := e.CreatePlan(e.Globex, "Business", "USD", "50.00")
+	gSub := newSubscription(e, e.Globex, gCus.ID, gPlan.ID)
+	gInv := newInvoice(e, e.Globex, gCus.ID)
+	var gEP store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Globex.Key,
+		map[string]any{"url": "https://hooks.globex.example/tally", "events": []string{"*"}}, &gEP)
+	var gEvents struct{ Items []store.Event }
+	e.MustDo(http.StatusOK, "GET", "/v1/events?type=customer.created", e.Globex.Key, nil, &gEvents)
+	if len(gEvents.Items) == 0 {
+		t.Fatal("Globex has no event to probe")
+	}
+	gEvent := gEvents.Items[0]
+	var gInvite store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Globex.Key, map[string]string{"email": "new@globex.example", "role": "member"}, &gInvite)
+	gKey, ok := e.Store.APIKeyByToken(e.Globex.Key)
+	if !ok {
+		t.Fatal("no Globex key")
+	}
+
+	// Each probe names one ID in its path. The ID is Globex's, or unknownID for the reference answer.
+	paths := []struct {
+		method, path string // path has one %s for the ID
+		body         any
+		id           string
+	}{
+		{"GET", "/v1/customers/%s", nil, gCus.ID},
+		{"PATCH", "/v1/customers/%s", map[string]string{"name": "Hacked"}, gCus.ID},
+		{"DELETE", "/v1/customers/%s", nil, gCus.ID},
+		{"GET", "/v1/plans/%s", nil, gPlan.ID},
+		{"PATCH", "/v1/plans/%s", map[string]string{"name": "Hacked"}, gPlan.ID},
+		{"GET", "/v1/subscriptions/%s", nil, gSub.ID},
+		{"PATCH", "/v1/subscriptions/%s", map[string]int{"quantity": 9}, gSub.ID},
+		{"POST", "/v1/subscriptions/%s/cancel", nil, gSub.ID},
+		{"POST", "/v1/subscriptions/%s/usage", map[string]int{"quantity": 1}, gSub.ID},
+		{"GET", "/v1/invoices/%s", nil, gInv.ID},
+		{"GET", "/v1/invoices/%s/lines", nil, gInv.ID},
+		{"POST", "/v1/invoices/%s/pay", nil, gInv.ID},
+		{"POST", "/v1/invoices/%s/void", nil, gInv.ID},
+		{"GET", "/v1/webhook-endpoints/%s", nil, gEP.ID},
+		{"PATCH", "/v1/webhook-endpoints/%s", map[string]bool{"enabled": false}, gEP.ID},
+		{"GET", "/v1/webhook-endpoints/%s/deliveries", nil, gEP.ID},
+		{"DELETE", "/v1/webhook-endpoints/%s", nil, gEP.ID},
+		{"GET", "/v1/events/%s", nil, gEvent.ID},
+		{"DELETE", "/v1/api-keys/%s", nil, gKey.ID},
+		{"DELETE", "/v1/invites/%s", nil, gInvite.ID},
+		{"PATCH", "/v1/members/%s", map[string]string{"role": "viewer"}, e.Globex.Owner.ID},
+		{"DELETE", "/v1/members/%s", nil, e.Globex.Owner.ID},
+	}
+	for _, p := range paths {
+		got := e.Do(p.method, fmt.Sprintf(p.path, p.id), e.Acme.Key, p.body)
+		want := e.Do(p.method, fmt.Sprintf(p.path, unknownID), e.Acme.Key, p.body)
+		notFoundLike(t, p.method+" "+p.path, got, want)
+	}
+
+	// IDs named in a body: the customer, plan or subscription must be Acme's own or the answer is the unknown-ID answer.
+	bodies := []struct {
+		name, method, path string
+		body               func(id string) any
+		id                 string
+	}{
+		{"create invoice for a customer", "POST", "/v1/invoices", func(id string) any {
+			return map[string]any{"customer_id": id, "currency": "USD", "lines": []map[string]any{{"description": "x", "quantity": 1, "unit_amount": 100}}}
+		}, gCus.ID},
+		{"create subscription for a customer", "POST", "/v1/subscriptions", func(id string) any {
+			return map[string]any{"customer_id": id, "plan_id": acmePlan.ID}
+		}, gCus.ID},
+		{"create subscription on a plan", "POST", "/v1/subscriptions", func(id string) any {
+			return map[string]any{"customer_id": acmeCus.ID, "plan_id": id}
+		}, gPlan.ID},
+		{"change subscription to a plan", "PATCH", "/v1/subscriptions/" + acmeSub.ID, func(id string) any {
+			return map[string]any{"plan_id": id}
+		}, gPlan.ID},
+	}
+	for _, b := range bodies {
+		got := e.Do(b.method, b.path, e.Acme.Key, b.body(b.id))
+		want := e.Do(b.method, b.path, e.Acme.Key, b.body(unknownID))
+		notFoundLike(t, b.name, got, want)
+	}
+
+	// Nothing changed: Acme created nothing, and Globex's objects are as they were.
+	var acmeInvs struct{ Items []store.Invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices", e.Acme.Key, nil, &acmeInvs)
+	if len(acmeInvs.Items) != 1 {
+		t.Fatalf("Acme's invoices = %+v; a request for Globex's customer created one", acmeInvs)
+	}
+	var acmeSubList struct{ Items []store.Subscription }
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions", e.Acme.Key, nil, &acmeSubList)
+	if len(acmeSubList.Items) != 1 || acmeSubList.Items[0].ID != acmeSub.ID || acmeSubList.Items[0].PlanID != acmePlan.ID {
+		t.Fatalf("Acme's subscriptions = %+v", acmeSubList)
+	}
+
+	var c store.Customer
+	e.MustDo(http.StatusOK, "GET", "/v1/customers/"+gCus.ID, e.Globex.Key, nil, &c)
+	if c.Name != "Gina" {
+		t.Fatalf("Globex's customer changed: %+v", c)
+	}
+	var p store.Plan
+	e.MustDo(http.StatusOK, "GET", "/v1/plans/"+gPlan.ID, e.Globex.Key, nil, &p)
+	if p.Name != "Business" || !p.Active {
+		t.Fatalf("Globex's plan changed: %+v", p)
+	}
+	var s store.Subscription
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions/"+gSub.ID, e.Globex.Key, nil, &s)
+	if s.Quantity != 1 || s.Status != store.Active || s.CanceledAt != nil {
+		t.Fatalf("Globex's subscription changed: %+v", s)
+	}
+	var inv store.Invoice
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+gInv.ID, e.Globex.Key, nil, &inv)
+	if inv.Status != store.InvoiceOpen {
+		t.Fatalf("Globex's invoice changed: %+v", inv)
+	}
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+gEP.ID, e.Globex.Key, nil, &ep)
+	if !ep.Enabled {
+		t.Fatalf("Globex's endpoint changed: %+v", ep)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", e.Globex.Key, nil, nil) // Globex's key still works
+	var invites struct{ Items []store.Invite }
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Globex.Key, nil, &invites)
+	if len(invites.Items) != 1 || invites.Items[0].ID != gInvite.ID {
+		t.Fatalf("Globex's invites changed: %+v", invites)
+	}
+	var members struct {
+		Items []struct {
+			UserID string     `json:"user_id"`
+			Role   store.Role `json:"role"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/members", e.Globex.Key, nil, &members)
+	if len(members.Items) != 1 || members.Items[0].UserID != e.Globex.Owner.ID || members.Items[0].Role != store.RoleOwner {
+		t.Fatalf("Globex's members changed: %+v", members)
+	}
+}
