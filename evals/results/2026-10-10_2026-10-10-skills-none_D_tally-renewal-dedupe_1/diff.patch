+func TestConcurrentRenewalsInvoiceOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	total := 0
+	for range 20 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			n, err := e.Subs.RenewDue(ctx)
+			if err != nil {
+				t.Error(err)
+			}
+			mu.Lock()
+			total += n
+			mu.Unlock()
+		}()
+	}
+	wg.Wait()
+	if total != 1 {
+		t.Fatalf("renewed %d times, want once", total)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoicePaid || !invs[1].PeriodStart.Equal(sub.CurrentPeriodEnd) {
+		t.Fatalf("invoices = %+v, want the first and one paid renewal", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 {
+		t.Fatalf("charges = %d, want 2 (the first period and one renewal)", len(cs))
+	}
+}
+
+func TestGatewayDownStillRenews(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_gateway_down"; return nil })
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); n != 1 || !errors.Is(err, payments.ErrUnavailable) {
+		t.Fatalf("RenewDue = %d, %v; want 1 and ErrUnavailable", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(sub.CurrentPeriodEnd) || !got.CurrentPeriodEnd.Equal(sub.CurrentPeriodEnd.AddDate(0, 1, 0)) {
+		t.Fatalf("after the outage = %+v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoiceOpen {
+		t.Fatalf("invoices = %+v, want the renewal open", invs)
+	}
+	if n, err := e.Subs.RenewDue(ctx); n != 0 || err != nil {
+		t.Fatalf("second RenewDue = %d, %v; want nothing to do", n, err)
+	}
+	if calls := e.Gateway.Calls(); len(calls) != 2 {
+		t.Fatalf("gateway calls = %d, want 2 (the first period and one attempt)", len(calls))
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 {
+		t.Fatalf("invoices = %d after the second run, want 2", len(invs))
+	}
+}
