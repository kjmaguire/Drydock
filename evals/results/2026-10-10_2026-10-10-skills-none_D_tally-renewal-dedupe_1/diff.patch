+// RenewSubscription moves a subscription to the period [start, end) and, in the same step, stores inv, the invoice of a
+// period (nil stores none). It is a compare-and-set: unless the subscription is not canceled and its current period still
+// ends at observedEnd and has ended by now, it changes nothing and reports false. So of several renewals of the same period,
+// only the first one gets true and creates the invoice.
+func (s *Store) RenewSubscription(orgID, id string, observedEnd, start, end time.Time, inv *Invoice, now time.Time) (Subscription, *Invoice, bool, error) {
+	if inv != nil {
+		if err := checkInvoice(*inv); err != nil {
+			return Subscription{}, nil, false, err
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	old, ok := s.subs[id]
+	if !ok || old.OrgID != orgID {
+		return Subscription{}, nil, false, ErrNotFound
+	}
+	if old.Status == Canceled || !old.CurrentPeriodEnd.Equal(observedEnd) || old.CurrentPeriodEnd.After(now) {
+		return copySub(old), nil, false, nil
+	}
+	var created *Invoice
+	if inv != nil {
+		c, err := s.createInvoice(*inv, now)
+		if err != nil {
+			return Subscription{}, nil, false, err
+		}
+		created = &c
+	}
+	sub := copySub(old)
+	sub.CurrentPeriodStart, sub.CurrentPeriodEnd = start, end
+	s.subs[id] = sub
+	return copySub(sub), created, true, nil
+}
