+func TestOneFailureDoesNotStopTheOthers(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var subs []store.Subscription
+	for _, email := range []string{"jane@example.com", "joe@example.com"} {
+		c := e.CreateCustomer(e.Acme, "Customer", email)
+		_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+		sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+		if err != nil {
+			t.Fatal(err)
+		}
+		subs = append(subs, sub)
+	}
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, subs[0].CustomerID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_gateway_down"; return nil })
+	e.Clock.Set(subs[0].CurrentPeriodEnd)
+	n, err := e.Subs.RenewDue(ctx)
+	if n != 2 || !errors.Is(err, payments.ErrUnavailable) {
+		t.Fatalf("RenewDue = %d, %v; want both periods moved and ErrUnavailable", n, err)
+	}
+	for _, sub := range subs {
+		got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+		if !got.CurrentPeriodStart.Equal(sub.CurrentPeriodEnd) {
+			t.Fatalf("subscription %s did not move on: %+v", sub.ID, got)
+		}
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: subs[1].ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoicePaid {
+		t.Fatalf("the healthy subscription's renewal = %+v, want paid", invs)
+	}
