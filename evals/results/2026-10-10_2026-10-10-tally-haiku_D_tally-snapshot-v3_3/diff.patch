+func TestUpgradeVersion1(t *testing.T) {
+	original, err := os.ReadFile(filepath.Join("testdata", "v1.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	path := filepath.Join(dir, "tally.json")
+	if err := os.WriteFile(path, original, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := Upgrade(path); err != nil {
+		t.Fatal(err)
+	}
+	backup, err := os.ReadFile(filepath.Join(dir, "tally.json.v1.bak"))
+	if err != nil || !bytes.Equal(backup, original) {
+		t.Fatalf("backup differs from the original: %v", err)
+	}
+	var head struct {
+		Version int `json:"version"`
+	}
+	upgraded, _ := os.ReadFile(path)
+	if err := json.Unmarshal(upgraded, &head); err != nil || head.Version != Version {
+		t.Fatalf("upgraded version = %d: %v", head.Version, err)
+	}
+	st, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if inv, ok := st.Invoice("org_000001", "in_000007"); !ok || inv.Number != "INV-000001" {
+		t.Fatalf("invoice after upgrade = %+v", inv)
+	}
+	// Upgrading again changes nothing and makes no second backup.
+	if err := Upgrade(path); err != nil {
+		t.Fatal(err)
+	}
+	if again, _ := os.ReadFile(path); !bytes.Equal(again, upgraded) {
+		t.Fatal("upgrading a version 3 file changed it")
+	}
+	if entries, _ := os.ReadDir(dir); len(entries) != 2 {
+		t.Fatalf("the folder holds %d entries, want the snapshot and its backup", len(entries))
+	}
+}
