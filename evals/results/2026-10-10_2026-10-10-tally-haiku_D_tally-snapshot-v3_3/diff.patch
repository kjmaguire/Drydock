+func TestInvoiceNumbers(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Bob", "bob@example.com", t0)
+	line := []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}
+	create := func(st *Store, org Org, c Customer) Invoice {
+		t.Helper()
+		inv, err := st.CreateInvoice(Invoice{OrgID: org.ID, CustomerID: c.ID, Currency: money.EUR, Lines: line}, t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	a1, a2, b1 := create(s, a, ca), create(s, a, ca), create(s, b, cb)
+	if a1.Number != "INV-000001" || a2.Number != "INV-000002" || b1.Number != "INV-000001" {
+		t.Fatalf("numbers = %q, %q, %q; want each organization counting from INV-000001", a1.Number, a2.Number, b1.Number)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: ca.ID, Currency: "XXX", Lines: line}, t0); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("err = %v", err)
+	}
+	a3 := create(s, a, ca)
+	if a3.Number != "INV-000003" {
+		t.Fatalf("a failed creation used a number: next is %q", a3.Number)
+	}
+	up, err := s.UpdateInvoice(a.ID, a1.ID, func(i *Invoice) error { i.Status = InvoicePaid; return nil })
+	if err != nil || up.Number != "INV-000001" {
+		t.Fatalf("UpdateInvoice changed the number to %q: %v", up.Number, err)
+	}
+	// A restored store continues after the highest number, even when the saved next number is behind it.
+	st := s.Export()
+	st.NextInvoiceNumbers[a.ID] = 1
+	r, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := r.Invoice(a.ID, a3.ID); got.Number != "INV-000003" {
+		t.Fatalf("restored number = %q", got.Number)
+	}
+	ca2, _ := r.Customer(a.ID, ca.ID)
+	if next := create(r, a, ca2); next.Number != "INV-000004" {
+		t.Fatalf("the restored store's next number = %q, want INV-000004", next.Number)
+	}
+}
