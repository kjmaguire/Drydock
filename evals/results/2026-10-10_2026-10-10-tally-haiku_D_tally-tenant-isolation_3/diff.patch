+package store
+
+import (
+	"errors"
+	"testing"
+
+	"example.com/tally/internal/money"
+)
+
+func TestCustomerEmailsAreUniquePerOrganization(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, err := s.CreateCustomer(a.ID, "Jane A", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cb, err := s.CreateCustomer(b.ID, "Jane B", "JANE@example.com", t0)
+	if err != nil {
+		t.Fatalf("the same address in another org: %v", err)
+	}
+	find := func(org Org) string {
+		t.Helper()
+		c, ok := s.FindCustomerByEmail(org.ID, "jane@example.com")
+		if !ok {
+			return ""
+		}
+		return c.ID
+	}
+	if got := find(a); got != ca.ID {
+		t.Fatalf("A finds %q, want %q", got, ca.ID)
+	}
+	if got := find(b); got != cb.ID {
+		t.Fatalf("B finds %q, want %q", got, cb.ID)
+	}
+
+	// Deleting B's customer leaves A's address findable.
+	if err := s.DeleteCustomer(b.ID, cb.ID); err != nil {
+		t.Fatal(err)
+	}
+	if got := find(a); got != ca.ID {
+		t.Fatalf("after B deleted its customer, A finds %q, want %q", got, ca.ID)
+	}
+
+	// Changing B's address away does not touch A's.
+	cb2, err := s.CreateCustomer(b.ID, "Jane B", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.UpdateCustomer(b.ID, cb2.ID, func(c *Customer) error { c.Email = "other@example.com"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if got := find(a); got != ca.ID {
+		t.Fatalf("after B changed its address, A finds %q, want %q", got, ca.ID)
+	}
+	if got := find(b); got != "" {
+		t.Fatalf("B still finds %q under the address it gave up", got)
+	}
+	if _, err := s.CreateCustomer(a.ID, "Jane 2", "jane@example.com", t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("a second customer with the address in A: %v", err)
+	}
+
+	// The index is rebuilt from a snapshot with the same answers.
+	restored, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c, ok := restored.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || c.ID != ca.ID {
+		t.Fatalf("restored: A finds %+v %v", c, ok)
+	}
+	if _, ok := restored.FindCustomerByEmail(b.ID, "jane@example.com"); ok {
+		t.Fatal("restored: B finds a customer under an address it does not use")
+	}
+}
