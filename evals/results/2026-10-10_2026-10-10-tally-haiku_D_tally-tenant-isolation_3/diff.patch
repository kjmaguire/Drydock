+	if err != nil {
+		t.Fatal(err)
+	}
+	pb, err := s.CreatePlan(Plan{OrgID: b.ID, Name: "Pro", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: b.ID, CustomerID: ca.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for another org's customer: %v", err)
+	}
+	if _, err := s.CreateSubscription(Subscription{OrgID: b.ID, CustomerID: ca.ID, PlanID: pb.ID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for another org's customer: %v", err)
+	}
+	if got := s.ListInvoices(b.ID, InvoiceFilter{}); len(got) != 0 {
+		t.Fatalf("B has invoices %+v", got)
+	}
+	if got := s.Subscriptions(b.ID, SubscriptionFilter{}); len(got) != 0 {
+		t.Fatalf("B has subscriptions %+v", got)
+	}
+}
