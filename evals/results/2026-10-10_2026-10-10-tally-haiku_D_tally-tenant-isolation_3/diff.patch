+package api_test
+
+import (
+	"bytes"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// unknownID is an ID that no object has.
+const unknownID = "unknown_000000"
+
+// snapshot is everything the store holds, except when each API key was last used: every request records that.
+func snapshot(e *apitest.Env) store.State {
+	st := e.Store.Export()
+	for i := range st.APIKeys {
+		st.APIKeys[i].LastUsedAt = nil
+	}
+	return st
+}
+
+// probe is a request by Globex's key that names one of Acme's objects by ID.
+type probe struct {
+	name   string
+	method string
+	path   string              // "{id}" stands for the ID under test
+	id     string              // the ID under test: an object of Acme
+	body   func(id string) any // nil: no body
+}
+
+// TestAnotherOrganizationsIDsAnswerLikeUnknownIDs checks that a request naming another organization's object, in the path
+// or the body, is answered as it would be for an ID that does not exist, and changes nothing.
+func TestAnotherOrganizationsIDsAnswerLikeUnknownIDs(t *testing.T) {
+	e := apitest.New(t)
+	acmeCustomer := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	acmePlan := e.CreatePlan(e.Acme, "Pro", "USD", "12.50")
+	var acmeMetered store.Plan
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "Usage", "currency": "USD", "price": "0.10", "interval": "month", "usage_type": "metered"}, &acmeMetered)
+	var acmeSub, acmeMeteredSub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": acmeCustomer.ID, "plan_id": acmePlan.ID}, &acmeSub)
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": acmeCustomer.ID, "plan_id": acmeMetered.ID}, &acmeMeteredSub)
+	var acmeInvoice struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": acmeCustomer.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Consulting", "quantity": 2, "unit_amount": 1500}, {"description": "Travel", "quantity": 1, "unit_amount": 4250}}}, &acmeInvoice)
+	var acmeEndpoint store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &acmeEndpoint)
+	acmeEvent := e.Store.Events(e.Acme.ID, "")[0]
+	var acmeInvite store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]any{"email": "new@acme.example", "role": "member"}, &acmeInvite)
+	var acmeKey store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]any{"name": "CI"}, &acmeKey)
+
+	// Globex's own objects, for the requests that name Acme's objects in the body.
+	globexCustomer := e.CreateCustomer(e.Globex, "Gus", "gus@globex.example")
+	globexPlan := e.CreatePlan(e.Globex, "Business", "USD", "99.00")
+	var globexSub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Globex.Key, map[string]any{"customer_id": globexCustomer.ID, "plan_id": globexPlan.ID}, &globexSub)
+
+	probes := []probe{
+		{name: "get customer", method: "GET", path: "/v1/customers/{id}", id: acmeCustomer.ID},
+		{name: "update customer", method: "PATCH", path: "/v1/customers/{id}", id: acmeCustomer.ID, body: func(string) any { return map[string]any{"name": "Hacked"} }},
+		{name: "delete customer", method: "DELETE", path: "/v1/customers/{id}", id: acmeCustomer.ID},
+		{name: "get plan", method: "GET", path: "/v1/plans/{id}", id: acmePlan.ID},
+		{name: "update plan", method: "PATCH", path: "/v1/plans/{id}", id: acmePlan.ID, body: func(string) any { return map[string]any{"active": false} }},
+		{name: "get subscription", method: "GET", path: "/v1/subscriptions/{id}", id: acmeSub.ID},
+		{name: "update subscription", method: "PATCH", path: "/v1/subscriptions/{id}", id: acmeSub.ID, body: func(string) any { return map[string]any{"quantity": 9} }},
+		{name: "cancel subscription", method: "POST", path: "/v1/subscriptions/{id}/cancel", id: acmeSub.ID},
+		{name: "report usage", method: "POST", path: "/v1/subscriptions/{id}/usage", id: acmeMeteredSub.ID, body: func(string) any { return map[string]any{"quantity": 3} }},
+		{name: "get invoice", method: "GET", path: "/v1/invoices/{id}", id: acmeInvoice.ID},
+		{name: "get invoice lines", method: "GET", path: "/v1/invoices/{id}/lines", id: acmeInvoice.ID},
+		{name: "pay invoice", method: "POST", path: "/v1/invoices/{id}/pay", id: acmeInvoice.ID, body: func(string) any { return map[string]any{"payment_method": "pm_card_visa"} }},
+		{name: "void invoice", method: "POST", path: "/v1/invoices/{id}/void", id: acmeInvoice.ID},
+		{name: "get webhook endpoint", method: "GET", path: "/v1/webhook-endpoints/{id}", id: acmeEndpoint.ID},
+		{name: "update webhook endpoint", method: "PATCH", path: "/v1/webhook-endpoints/{id}", id: acmeEndpoint.ID, body: func(string) any { return map[string]any{"enabled": false} }},
+		{name: "delete webhook endpoint", method: "DELETE", path: "/v1/webhook-endpoints/{id}", id: acmeEndpoint.ID},
+		{name: "list webhook deliveries", method: "GET", path: "/v1/webhook-endpoints/{id}/deliveries", id: acmeEndpoint.ID},
+		{name: "get event", method: "GET", path: "/v1/events/{id}", id: acmeEvent.ID},
+		{name: "update member", method: "PATCH", path: "/v1/members/{id}", id: e.Acme.Owner.ID, body: func(string) any { return map[string]any{"role": "viewer"} }},
+		{name: "remove member", method: "DELETE", path: "/v1/members/{id}", id: e.Acme.Owner.ID},
+		{name: "revoke invite", method: "DELETE", path: "/v1/invites/{id}", id: acmeInvite.ID},
+		{name: "revoke API key", method: "DELETE", path: "/v1/api-keys/{id}", id: acmeKey.ID},
+		{name: "invoice for another organization's customer", method: "POST", path: "/v1/invoices", id: acmeCustomer.ID,
+			body: func(id string) any {
+				return map[string]any{"customer_id": id, "currency": "USD", "lines": []map[string]any{{"description": "Hacked", "quantity": 1, "unit_amount": 100}}}
+			}},
+		{name: "subscription for another organization's customer", method: "POST", path: "/v1/subscriptions", id: acmeCustomer.ID,
+			body: func(id string) any { return map[string]any{"customer_id": id, "plan_id": globexPlan.ID} }},
+		{name: "subscription on another organization's plan", method: "POST", path: "/v1/subscriptions", id: acmePlan.ID,
+			body: func(id string) any { return map[string]any{"customer_id": globexCustomer.ID, "plan_id": id} }},
+		{name: "move subscription to another organization's plan", method: "PATCH", path: "/v1/subscriptions/" + globexSub.ID, id: acmePlan.ID,
+			body: func(id string) any { return map[string]any{"plan_id": id} }},
+	}
+
+	run := func(p probe, id string) *apitest.Response {
+		path := strings.ReplaceAll(p.path, "{id}", id)
+		var body any
+		if p.body != nil {
+			body = p.body(id)
+		}
+		return e.Do(p.method, path, e.Globex.Key, body)
+	}
+	for _, p := range probes {
+		t.Run(p.name, func(t *testing.T) {
+			before := snapshot(e)
+			got := run(p, p.id)
+			if got.Code != http.StatusNotFound || got.Map(t)["error"] != "not_found" {
+				t.Fatalf("another organization's ID: want 404 not_found, got %s", got)
+			}
+			if !reflect.DeepEqual(before, snapshot(e)) {
+				t.Fatal("the request changed the store")
+			}
+			want := run(p, unknownID)
+			if got.Code != want.Code || !bytes.Equal(got.Body, want.Body) {
+				t.Fatalf("another organization's ID answers %s, an unknown ID answers %s", got, want)
+			}
+		})
+	}
+
+	// Acme's objects are as they were.
+	e.MustDo(http.StatusOK, "GET", "/v1/customers/"+acmeCustomer.ID, e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+acmeInvoice.ID, e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+acmeEndpoint.ID, e.Acme.Key, nil, nil)
+}
+
+// TestListsAndLookupsStayInTheOrganization checks that a list filtered by an ID, or looked up by value, only finds the
+// caller's organization's objects.
+func TestListsAndLookupsStayInTheOrganization(t *testing.T) {
+	e := apitest.New(t)
+	acmeCustomer := e.CreateCustomer(e.Acme, "Jane", "jane@acme.example")
+	plan := e.CreatePlan(e.Acme, "Pro", "USD", "12.50")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": acmeCustomer.ID, "plan_id": plan.ID}, &sub)
+	var inv struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": acmeCustomer.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Consulting", "quantity": 1, "unit_amount": 1500}}}, &inv)
+
+	for _, path := range []string{
+		"/v1/invoices?customer_id=" + acmeCustomer.ID,
+		"/v1/invoices?subscription_id=" + sub.ID,
+		"/v1/subscriptions?customer_id=" + acmeCustomer.ID,
+		"/v1/payments?invoice_id=" + inv.ID,
+		"/v1/customers?email=jane@acme.example",
+	} {
+		r := e.MustDo(http.StatusOK, "GET", path, e.Globex.Key, nil, nil)
+		if items, _ := r.Map(t)["items"].([]any); len(items) != 0 {
+			t.Fatalf("GET %s found another organization's objects: %s", path, r)
+		}
+	}
+}
+
+// TestSameEmailAddressInTwoOrganizations checks that two organizations can each have a customer with the same email
+// address, and that neither sees, changes or loses the other's.
+func TestSameEmailAddressInTwoOrganizations(t *testing.T) {
+	e := apitest.New(t)
+	acme := e.CreateCustomer(e.Acme, "Jane Acme", "jane@example.com")
+	globex := e.CreateCustomer(e.Globex, "Jane Globex", "Jane@Example.com")
+
+	byEmail := func(org apitest.Org) []string {
+		t.Helper()
+		var page struct {
+			Items []store.Customer `json:"items"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/customers?email=jane@example.com", org.Key, nil, &page)
+		ids := []string{}
+		for _, c := range page.Items {
+			ids = append(ids, c.ID)
+		}
+		return ids
+	}
+	if got := byEmail(e.Acme); len(got) != 1 || got[0] != acme.ID {
+		t.Fatalf("Acme finds %v, want its own customer %s", got, acme.ID)
+	}
+	if got := byEmail(e.Globex); len(got) != 1 || got[0] != globex.ID {
+		t.Fatalf("Globex finds %v, want its own customer %s", got, globex.ID)
+	}
+
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+globex.ID, e.Globex.Key, nil, nil)
+	if got := byEmail(e.Acme); len(got) != 1 || got[0] != acme.ID {
+		t.Fatalf("after Globex deleted its customer, Acme finds %v, want %s", got, acme.ID)
+	}
+	if r := e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane 2", "email": "jane@example.com"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "email_taken" {
+		t.Fatalf("a second Acme customer with the address: %s", r)
+	}
+}
