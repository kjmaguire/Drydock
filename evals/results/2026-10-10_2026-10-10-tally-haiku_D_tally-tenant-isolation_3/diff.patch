+	ep, err := s.CreateWebhookEndpoint(WebhookEndpoint{OrgID: a.ID, URL: "https://hooks.a.example/tally", Events: []string{"*"}, Enabled: true}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.DeleteOrgWebhookEndpoint(b.ID, ep.ID); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleted through another org: %v", err)
+	}
+	if _, ok := s.WebhookEndpoint(a.ID, ep.ID); !ok {
+		t.Fatal("another org's delete removed the endpoint")
+	}
+	if err := s.DeleteOrgWebhookEndpoint(a.ID, ep.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.WebhookEndpoint(a.ID, ep.ID); ok {
+		t.Fatal("deleted endpoint still there")
+	}
+}
