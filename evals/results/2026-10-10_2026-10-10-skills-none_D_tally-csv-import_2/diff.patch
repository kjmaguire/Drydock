+func TestCustomerImport(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane Doe", "jane@example.com")
+	const path = "/v1/customers/import"
+	count := func() int { return len(e.Store.Customers(e.Acme.ID)) }
+
+	for _, body := range []string{"", "\r\n\n", "Name,Notes\nJo,x\n", "email\nx@example.com\n"} {
+		if r := e.Do("POST", path, e.Acme.Key, body); r.Code != http.StatusUnprocessableEntity || string(r.Body) != "{\"error\":\"invalid_header\"}\n" {
+			t.Fatalf("header %q: %s", body, r)
+		}
+	}
+	for _, body := range []string{"name,email\nJo,\"jo@example.com\n", "name,email\nJo,jo@example.com,extra\n", "name,email\nJo,a\"b\n"} {
+		if r := e.Do("POST", path, e.Acme.Key, body); r.Code != http.StatusBadRequest || string(r.Body) != "{\"error\":\"invalid_csv\"}\n" {
+			t.Fatalf("csv %q: %s", body, r)
+		}
+	}
+
+	// Header matching ignores case and spaces, columns come in any order, unknown columns are ignored, quoted fields
+	// hold commas, quotes and line breaks, the body has CRLF line ends, a BOM and blank lines.
+	body := "\xEF\xBB\xBF" + strings.Join([]string{
+		" Email , Notes ,NAME,Metadata.CRM,metadata.tier,Default_Payment_Method",
+		`a@example.com,x,"Smith, Jane",7,gold,pm_1`,
+		"",
+		`b@example.com,x,"Quote ""Q"" Lee",8,,`,
+		`c@example.com,x,"Multi`,
+		`Line",9,,pm_2`,
+		"",
+	}, "\r\n")
+	var got struct {
+		Created int              `json:"created"`
+		Items   []store.Customer `json:"items"`
+	}
+	e.MustDo(http.StatusCreated, "POST", path, e.Acme.Key, body, &got)
+	type want struct {
+		name, email, pm string
+		meta            map[string]string
+	}
+	if got.Created != 3 || len(got.Items) != 3 {
+		t.Fatalf("import = %+v", got)
+	}
+	for i, w := range []want{
+		{"Smith, Jane", "a@example.com", "pm_1", map[string]string{"CRM": "7", "tier": "gold"}},
+		{`Quote "Q" Lee`, "b@example.com", "", map[string]string{"CRM": "8"}},
+		{"Multi\nLine", "c@example.com", "pm_2", map[string]string{"CRM": "9"}},
+	} {
+		c := got.Items[i]
+		if c.Name != w.name || c.Email != w.email || c.DefaultPaymentMethod != w.pm || !maps.Equal(c.Metadata, w.meta) {
+			t.Fatalf("item %d = %+v, want %+v", i, c, w)
+		}
+	}
+	e.MustDo(http.StatusCreated, "POST", path, e.Acme.Key, "name,email\nLF One,lf1@example.com\n", &got)
+	if got.Created != 1 || count() != 5 {
+		t.Fatalf("LF import = %+v, customers %d", got, count())
+	}
+	if r := e.MustDo(http.StatusCreated, "POST", path, e.Acme.Key, "name,email\n", nil); !strings.Contains(string(r.Body), `"items":[]`) {
+		t.Fatalf("empty import: %s", r)
+	}
+	var evs struct{ Items []store.Event }
+	e.MustDo(http.StatusOK, "GET", "/v1/events?type=customer.created", e.Acme.Key, nil, &evs)
+	if len(evs.Items) != 5 {
+		t.Fatalf("customer.created events = %d, want one per customer (5)", len(evs.Items))
+	}
+
+	// Every bad record is listed with its line (the header is line 1; the blank line 4 counts), one code each. Nothing
+	// is created, so the good record on line 2 can still be imported afterwards.
+	bad := strings.Join([]string{
+		"name,email,default_payment_method",
+		"Jim,jim@example.com,",
+		",nobody@example.com,",
+		"",
+		"Bob,not-an-email,",
+		`"Ann`,
+		`Lee",ann@example.com,pm_1`,
+		"Carl,carl@example.com,card_1",
+		"Dee,JANE@example.com,",
+		"Eve,ann@example.com,",
+		",bad,",
+	}, "\n")
+	type rowErr struct {
+		Row   int    `json:"row"`
+		Error string `json:"error"`
+	}
+	var refused struct {
+		Error string   `json:"error"`
+		Rows  []rowErr `json:"rows"`
+	}
+	r := e.Do("POST", path, e.Acme.Key, bad)
+	r.JSON(t, &refused)
+	wantRows := []rowErr{{3, "missing_name"}, {5, "invalid_email"}, {8, "invalid_payment_method"}, {9, "email_taken"}, {10, "duplicate_email"}, {11, "missing_name"}}
+	if r.Code != http.StatusUnprocessableEntity || refused.Error != "invalid_rows" || !slices.Equal(refused.Rows, wantRows) {
+		t.Fatalf("bad rows: %s", r)
+	}
+	if count() != 5 {
+		t.Fatalf("a refused import created customers: %d", count())
+	}
+	e.MustDo(http.StatusCreated, "POST", path, e.Acme.Key, "name,email\nJim,jim@example.com\n", &got)
+
+	// A dry run checks the same way and creates nothing or nothing more.
+	var dry map[string]int
+	ok := "name,email\nDry One,dry1@example.com\nDry Two,dry2@example.com\n"
+	e.MustDo(http.StatusOK, "POST", path+"?dry_run=true", e.Acme.Key, ok, &dry)
+	if dry["created"] != 0 || dry["would_create"] != 2 || count() != 6 {
+		t.Fatalf("dry run = %v, customers %d", dry, count())
+	}
+	if r := e.Do("POST", path+"?dry_run=true", e.Acme.Key, bad); r.Code != http.StatusUnprocessableEntity || !strings.Contains(string(r.Body), `"invalid_rows"`) {
+		t.Fatalf("dry run of bad rows: %s", r)
+	}
+
+	// Emails are unique per organization: another organization may use Jane's email.
+	e.MustDo(http.StatusCreated, "POST", path, e.Globex.Key, "name,email\nJane G,JANE@example.com\n", nil)
+
+	records := func(n int) string {
+		var b strings.Builder
+		b.WriteString("name,email\n")
+		for i := range n {
+			fmt.Fprintf(&b, "Cust %d,cust%d@example.com\n", i, i)
+		}
+		return b.String()
+	}
+	if r := e.Do("POST", path, e.Acme.Key, records(10001)); r.Code != http.StatusRequestEntityTooLarge || string(r.Body) != "{\"error\":\"too_many_rows\"}\n" {
+		t.Fatalf("10001 rows: %s", r)
+	}
+	e.MustDo(http.StatusOK, "POST", path+"?dry_run=true", e.Acme.Key, records(10000), &dry)
+	if dry["would_create"] != 10000 || count() != 6 {
+		t.Fatalf("10000 rows dry run = %v, customers %d", dry, count())
+	}
+}
