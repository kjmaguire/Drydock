+// maxImportRows is the most data records one import may have.
+const maxImportRows = 10000
+
+var utf8BOM = []byte("\xEF\xBB\xBF")
+
+// importColumns are the columns of an import's header: the index of each column, -1 when absent, and the index of the
+// column of each metadata key.
+type importColumns struct {
+	name, email, paymentMethod int
+	metadata                   map[string]int
+}
+
+// importRowError is one refused record of an import.
+type importRowError struct {
+	Row   int    `json:"row"`
+	Error string `json:"error"`
+}
+
+// importCustomers creates the customers in a CSV body, all or none. The first record is a header with "name" and "email"
+// columns; it may also have "default_payment_method" and "metadata.<key>" columns. With ?dry_run=true the records are
+// only checked.
+func (s *Server) importCustomers(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	br := bufio.NewReader(r.Body)
+	if b, _ := br.Peek(len(utf8BOM)); bytes.Equal(b, utf8BOM) {
+		_, _ = br.Discard(len(utf8BOM))
+	}
+	cr := csv.NewReader(br)
+	head, err := cr.Read()
+	if errors.Is(err, io.EOF) {
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]string{"error": "invalid_header"})
+		return
+	}
+	if err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid_csv"})
+		return
+	}
+	cols := parseImportHeader(head)
+	if cols.name < 0 || cols.email < 0 {
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]string{"error": "invalid_header"})
+		return
+	}
+	var in []store.CustomerImport
+	var lines []int
+	for {
+		rec, err := cr.Read()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid_csv"})
+			return
+		}
+		if len(in) == maxImportRows {
+			writeJSON(w, http.StatusRequestEntityTooLarge, map[string]string{"error": "too_many_rows"})
+			return
+		}
+		line, _ := cr.FieldPos(0)
+		in = append(in, cols.customer(rec))
+		lines = append(lines, line)
+	}
+	dryRun := r.URL.Query().Get("dry_run") == "true"
+	cs, refused, err := s.store.ImportCustomers(p.OrgID, in, s.clock.Now(), dryRun)
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	if len(refused) > 0 {
+		rows := make([]importRowError, 0, len(refused))
+		for _, e := range refused {
+			rows = append(rows, importRowError{Row: lines[e.Index], Error: e.Code})
+		}
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]any{"error": "invalid_rows", "rows": rows})
+		return
+	}
+	if dryRun {
+		writeJSON(w, http.StatusOK, map[string]int{"created": 0, "would_create": len(in)})
+		return
+	}
+	for _, c := range cs {
+		s.publish(r.Context(), p.OrgID, "customer.created", c)
+	}
+	writeJSON(w, http.StatusCreated, map[string]any{"created": len(cs), "items": cs})
+}
+
+// parseImportHeader finds the columns of an import's header. Names match ignoring case and surrounding spaces.
+func parseImportHeader(head []string) importColumns {
+	const metaPrefix = "metadata."
+	cols := importColumns{name: -1, email: -1, paymentMethod: -1, metadata: map[string]int{}}
+	for i, h := range head {
+		h = strings.TrimSpace(h)
+		switch {
+		case strings.EqualFold(h, "name"):
+			cols.name = i
+		case strings.EqualFold(h, "email"):
+			cols.email = i
+		case strings.EqualFold(h, "default_payment_method"):
+			cols.paymentMethod = i
+		case len(h) > len(metaPrefix) && strings.EqualFold(h[:len(metaPrefix)], metaPrefix):
+			if key := strings.TrimSpace(h[len(metaPrefix):]); key != "" {
+				cols.metadata[key] = i
+			}
+		}
+	}
+	return cols
+}
+
+// customer reads a record of an import with these columns. An empty metadata cell sets no metadata.
+func (cols importColumns) customer(rec []string) store.CustomerImport {
+	c := store.CustomerImport{Name: rec[cols.name], Email: rec[cols.email]}
+	if cols.paymentMethod >= 0 {
+		c.DefaultPaymentMethod = rec[cols.paymentMethod]
+	}
+	for key, i := range cols.metadata {
+		if rec[i] == "" {
+			continue
+		}
+		if c.Metadata == nil {
+			c.Metadata = map[string]string{}
+		}
+		c.Metadata[key] = rec[i]
+	}
+	return c
+}
