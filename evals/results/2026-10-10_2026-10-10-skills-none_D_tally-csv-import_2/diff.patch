+// CustomerImport is one customer to create by ImportCustomers.
+type CustomerImport struct {
+	Name, Email, DefaultPaymentMethod string
+	Metadata                          map[string]string
+}
+
+// ImportError says why the customer at Index in the import cannot be created: one of "missing_name", "invalid_email",
+// "invalid_payment_method", "email_taken" or "duplicate_email".
+type ImportError struct {
+	Index int
+	Code  string
+}
+
+// ImportCustomers creates the customers in order, all or none. Each one is checked as CreateCustomer and UpdateCustomer
+// check it, and its email must not belong to one of the organization's customers or to one before it, ignoring case.
+// When any is refused, nothing is created and the refusals come back in order, with the first problem each has. With
+// dryRun, the customers are only checked.
+func (s *Store) ImportCustomers(orgID string, in []CustomerImport, now time.Time, dryRun bool) ([]Customer, []ImportError, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return nil, nil, ErrNotFound
+	}
+	existing := map[string]bool{}
+	for _, c := range s.customers {
+		if c.OrgID == orgID {
+			existing[normEmail(c.Email)] = true
+		}
+	}
+	earlier := map[string]bool{}
+	var refused []ImportError
+	for i, c := range in {
+		name, email := strings.TrimSpace(c.Name), strings.TrimSpace(c.Email)
+		key := normEmail(email)
+		code := ""
+		switch {
+		case name == "":
+			code = "missing_name"
+		case !validEmail(email):
+			code = "invalid_email"
+		case c.DefaultPaymentMethod != "" && !strings.HasPrefix(c.DefaultPaymentMethod, "pm_"):
+			code = "invalid_payment_method"
+		case existing[key]:
+			code = "email_taken"
+		case earlier[key]:
+			code = "duplicate_email"
+		}
+		if code != "" {
+			refused = append(refused, ImportError{Index: i, Code: code})
+		}
+		earlier[key] = true
+	}
+	if len(refused) > 0 || dryRun {
+		return nil, refused, nil
+	}
+	out := make([]Customer, 0, len(in))
+	for _, c := range in {
+		k := Customer{ID: s.newID("cus"), OrgID: orgID, Name: strings.TrimSpace(c.Name), Email: strings.TrimSpace(c.Email),
+			DefaultPaymentMethod: c.DefaultPaymentMethod, CreatedAt: now.UTC()}
+		if len(c.Metadata) > 0 {
+			k.Metadata = maps.Clone(c.Metadata)
+		}
+		s.customers[k.ID] = k
+		s.customersByEmail[normEmail(k.Email)] = k.ID
+		out = append(out, copyCustomer(k))
+	}
+	return out, nil, nil
+}
