+func TestCustomersCSVExportsOnlyTheAccountsCustomers(t *testing.T) {
+	srv, st := newServer(t)
+	plus2 := time.FixedZone("UTC+2", 2*60*60)
+	st.CreateCustomer("acc_acme", `Doe, Jane "JD"`, "jane@example.com", store.PlanPro, time.Date(2026, 3, 4, 5, 6, 7, 0, plus2))
+	st.CreateCustomer("acc_acme", "=1+1", "a@b.test", store.PlanFree, time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC))
+	st.CreateCustomer("acc_acme", "+44 Ops", "ops@b.test", store.PlanFree, time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC))
+	st.CreateCustomer("acc_acme", "Line\nBreak", "@b.test", store.PlanFree, time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC))
+	st.CreateCustomer("acc_globex", "Hank", "hank@globex.test", store.PlanFree, time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC))
+
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("export: %d %s", r.Code, r.Body)
+	}
+	if ct := r.Header().Get("Content-Type"); ct != "text/csv; charset=utf-8" {
+		t.Fatalf("Content-Type: %q", ct)
+	}
+	if cd := r.Header().Get("Content-Disposition"); cd != `attachment; filename="customers.csv"` {
+		t.Fatalf("Content-Disposition: %q", cd)
+	}
+	want := "id,name,email,plan,created_at\r\n" +
+		"cus_00001,\"Doe, Jane \"\"JD\"\"\",jane@example.com,pro,2026-03-04T03:06:07Z\r\n" +
+		"cus_00002,'=1+1,a@b.test,free,2026-01-02T03:04:05Z\r\n" +
+		"cus_00003,'+44 Ops,ops@b.test,free,2026-01-02T03:04:05Z\r\n" +
+		"cus_00004,\"Line\r\nBreak\",'@b.test,free,2026-01-02T03:04:05Z\r\n"
+	if got := r.Body.String(); got != want {
+		t.Fatalf("body mismatch\n got: %q\nwant: %q", got, want)
+	}
+}
