+const (
+	defaultPageLimit = 20
+	maxPageLimit     = 100
+)
+
 func (s *Server) listInvoices(w http.ResponseWriter, r *http.Request, acct store.Account) {
+	q := r.URL.Query()
+	limit := defaultPageLimit
+	if q.Has("limit") {
+		n, ok := parseLimit(q.Get("limit"))
+		if !ok {
+			writeError(w, http.StatusBadRequest, "invalid_limit")
+			return
+		}
+		limit = n
+	}
+	var after *store.InvoicePosition
+	if q.Has("cursor") {
+		pos, ok := decodeCursor(q.Get("cursor"))
+		if !ok {
+			writeError(w, http.StatusBadRequest, "invalid_cursor")
+			return
+		}
+		after = &pos
+	}
+	page, more := s.store.InvoicePage(acct.ID, after, limit)
 	items := []invoiceView{}
-	for _, inv := range s.store.Invoices(acct.ID) {
+	for _, inv := range page {
 		items = append(items, view(inv))
 	}
-	writeJSON(w, http.StatusOK, map[string]any{"items": items})
+	next := ""
+	if more {
+		last := page[len(page)-1]
+		next = encodeCursor(store.InvoicePosition{CreatedAt: last.CreatedAt, ID: last.ID})
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"items": items, "next_cursor": next})
+}
+
+// parseLimit reads a page size: a whole number from 1 to maxPageLimit.
+func parseLimit(s string) (int, bool) {
+	if s == "" || strings.Trim(s, "0123456789") != "" {
+		return 0, false
+	}
+	n, err := strconv.Atoi(s)
+	if err != nil || n < 1 || n > maxPageLimit {
+		return 0, false
+	}
+	return n, true
+}
+
+// encodeCursor makes an opaque cursor from the position of the last invoice on a page.
+func encodeCursor(p store.InvoicePosition) string {
+	return base64.RawURLEncoding.EncodeToString([]byte(p.CreatedAt.UTC().Format(time.RFC3339Nano) + "|" + p.ID))
+}
+
+// decodeCursor reads a cursor made by encodeCursor.
+func decodeCursor(c string) (store.InvoicePosition, bool) {
+	raw, err := base64.RawURLEncoding.DecodeString(c)
+	if err != nil {
+		return store.InvoicePosition{}, false
+	}
+	ts, id, ok := strings.Cut(string(raw), "|")
+	if !ok || id == "" {
+		return store.InvoicePosition{}, false
+	}
+	t, err := time.Parse(time.RFC3339Nano, ts)
+	if err != nil {
+		return store.InvoicePosition{}, false
+	}
+	return store.InvoicePosition{CreatedAt: t, ID: id}, true
 }
 
