+// invoicePage is the body of GET /api/invoices.
+type invoicePage struct {
+	Items []struct {
+		ID string `json:"id"`
+	} `json:"items"`
+	NextCursor string `json:"next_cursor"`
+}
+
+func (p invoicePage) ids() []string {
+	var ids []string
+	for _, it := range p.Items {
+		ids = append(ids, it.ID)
+	}
+	return ids
+}
+
+func listPage(t *testing.T, h http.Handler, key string, params url.Values) invoicePage {
+	t.Helper()
+	path := "/api/invoices"
+	if len(params) > 0 {
+		path += "?" + params.Encode()
+	}
+	r := do(t, h, "GET", path, key, "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("list %s: %d %s", path, r.Code, r.Body)
+	}
+	var p invoicePage
+	if err := json.Unmarshal(r.Body.Bytes(), &p); err != nil {
+		t.Fatalf("list %s: %v", path, err)
+	}
+	return p
+}
+
+// walkInvoices follows next_cursor from the first page until it is empty, and returns every invoice ID seen.
+func walkInvoices(t *testing.T, h http.Handler, key string, limit string) []string {
+	t.Helper()
+	var ids []string
+	cursor := ""
+	for i := 0; i < 1000; i++ {
+		params := url.Values{"limit": {limit}}
+		if cursor != "" {
+			params.Set("cursor", cursor)
+		}
+		p := listPage(t, h, key, params)
+		ids = append(ids, p.ids()...)
+		if p.NextCursor == "" {
+			return ids
+		}
+		cursor = p.NextCursor
+	}
+	t.Fatal("paging did not end")
+	return nil
+}
+
+// seedInvoices gives accountID a customer and n invoices, the i-th created at start+i*step.
+func seedInvoices(t *testing.T, st *store.Store, accountID string, n int, start time.Time, step time.Duration) (customerID string, ids []string) {
+	t.Helper()
+	c, err := st.CreateCustomer(accountID, "Jane", "jane@example.com", store.PlanPro, start)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < n; i++ {
+		inv, err := st.CreateInvoice(store.Invoice{AccountID: accountID, CustomerID: c.ID, Lines: []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 100}}}, start.Add(time.Duration(i)*step))
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, inv.ID)
+	}
+	return c.ID, ids
+}
+
+func TestInvoicesDefaultToPagesOf20InCreationOrder(t *testing.T) {
+	srv, st := newServer(t)
+	start := time.Date(2025, 12, 1, 0, 0, 0, 0, time.UTC)
+	_, want := seedInvoices(t, st, "acc_acme", 45, start, time.Minute)
+	seedInvoices(t, st, "acc_globex", 3, start, time.Minute)
+
+	first := listPage(t, srv, "key-acme", nil)
+	if !slices.Equal(first.ids(), want[:20]) || first.NextCursor == "" {
+		t.Fatalf("first page %v next %q", first.ids(), first.NextCursor)
+	}
+	if got := walkInvoices(t, srv, "key-acme", "7"); !slices.Equal(got, want) {
+		t.Fatalf("walking by 7 gave %v, want %v", got, want)
+	}
+}
+
+func TestTheLastPageHasNoNextCursor(t *testing.T) {
+	srv, st := newServer(t)
+	seedInvoices(t, st, "acc_acme", 4, time.Date(2025, 12, 1, 0, 0, 0, 0, time.UTC), time.Minute)
+
+	p := listPage(t, srv, "key-acme", url.Values{"limit": {"2"}})
+	if len(p.Items) != 2 || p.NextCursor == "" {
+		t.Fatalf("page 1: %+v", p)
+	}
+	p = listPage(t, srv, "key-acme", url.Values{"limit": {"2"}, "cursor": {p.NextCursor}})
+	if len(p.Items) != 2 || p.NextCursor != "" {
+		t.Fatalf("last page: %+v", p)
+	}
+	// A page that exactly fills the limit with nothing after it has no cursor either.
+	p = listPage(t, srv, "key-acme", url.Values{"limit": {"4"}})
+	if len(p.Items) != 4 || p.NextCursor != "" {
+		t.Fatalf("full page: %+v", p)
+	}
+}
