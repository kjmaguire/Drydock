+// InvoicePosition is a place in an account's invoice list. The invoices after it are those created after
+// CreatedAt, and those created at the same time with a greater ID.
+type InvoicePosition struct {
+	CreatedAt time.Time
+	ID        string
+}
+
+// InvoicePage returns up to limit of an account's invoices after the position, or from the first one when after
+// is nil, oldest first (ties by ID). It also reports whether more invoices follow. limit must be at least 1.
+func (s *Store) InvoicePage(accountID string, after *InvoicePosition, limit int) ([]Invoice, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Invoice{}
+	for _, inv := range s.invoices {
+		if inv.AccountID != accountID {
+			continue
+		}
+		if after != nil && !invoiceAfter(inv, *after) {
+			continue
+		}
+		out = append(out, inv)
+	}
+	sort.Slice(out, func(i, j int) bool { return invoiceBefore(out[i], out[j]) })
+	more := len(out) > limit
+	if more {
+		out = out[:limit]
+	}
+	return out, more
+}
+
+// invoiceBefore orders invoices oldest first, ties by ID. It is a total order, since IDs are unique.
+func invoiceBefore(a, b Invoice) bool {
+	if !a.CreatedAt.Equal(b.CreatedAt) {
+		return a.CreatedAt.Before(b.CreatedAt)
+	}
+	return a.ID < b.ID
+}
+
+// invoiceAfter reports whether inv comes after the position in the order of invoiceBefore.
+func invoiceAfter(inv Invoice, p InvoicePosition) bool {
+	if !inv.CreatedAt.Equal(p.CreatedAt) {
+		return p.CreatedAt.Before(inv.CreatedAt)
+	}
+	return inv.ID > p.ID
+}
