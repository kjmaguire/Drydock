+func TestInvoicesWithTheSameTimeAreOrderedByID(t *testing.T) {
+	srv, st := newServer(t)
+	_, want := seedInvoices(t, st, "acc_acme", 5, time.Date(2025, 12, 1, 0, 0, 0, 0, time.UTC), 0)
+	if got := walkInvoices(t, srv, "key-acme", "2"); !slices.Equal(got, want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+}
+
+func TestInvoicesCreatedBetweenPagesNeitherSkipNorRepeat(t *testing.T) {
+	srv, st := newServer(t)
+	start := time.Date(2025, 12, 1, 0, 0, 0, 0, time.UTC)
+	cust, want := seedInvoices(t, st, "acc_acme", 5, start, time.Hour)
+
+	p := listPage(t, srv, "key-acme", url.Values{"limit": {"2"}})
+	// Created through the API at the server's clock, so after everything already listed.
+	r := do(t, srv, "POST", "/api/invoices", "key-acme", `{"customer_id":"`+cust+`","lines":[{"description":"Seats","quantity":1,"unit_cents":100}]}`)
+	if r.Code != http.StatusCreated {
+		t.Fatalf("create: %d %s", r.Code, r.Body)
+	}
+	var posted struct {
+		ID string `json:"id"`
+	}
+	if err := json.Unmarshal(r.Body.Bytes(), &posted); err != nil {
+		t.Fatal(err)
+	}
+	// Dated before the cursor, as if the clock had gone back: it is behind the paging position, so it is not listed.
+	if _, err := st.CreateInvoice(store.Invoice{AccountID: "acc_acme", CustomerID: cust, Lines: []store.LineItem{{Quantity: 1, UnitCents: 100}}}, start.Add(-time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+
+	var got []string
+	got = append(got, p.ids()...)
+	got = append(got, walkFrom(t, srv, "key-acme", "2", p.NextCursor)...)
+	if !slices.Equal(got, append(want, posted.ID)) {
+		t.Fatalf("got %v, want %v", got, append(want, posted.ID))
+	}
+}
+
+// walkFrom follows next_cursor from cursor until it is empty, and returns every invoice ID seen after it.
+func walkFrom(t *testing.T, h http.Handler, key, limit, cursor string) []string {
+	t.Helper()
+	var ids []string
+	for i := 0; i < 1000 && cursor != ""; i++ {
+		p := listPage(t, h, key, url.Values{"limit": {limit}, "cursor": {cursor}})
+		ids = append(ids, p.ids()...)
+		cursor = p.NextCursor
+	}
+	return ids
+}
