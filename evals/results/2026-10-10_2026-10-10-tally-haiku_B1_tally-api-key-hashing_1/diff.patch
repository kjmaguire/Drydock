+// apiKeyAlphabet is what API key tokens are made of: letters and digits.
+const apiKeyAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+
+// apiKeyTouchInterval is how long after a key's last recorded use a new use goes unrecorded.
+const apiKeyTouchInterval = time.Minute
+
+// newAPIKeyToken returns a new API key token: "tly_" and 40 random characters from apiKeyAlphabet.
+func newAPIKeyToken() string {
+	const n = 40
+	// 248 is the largest multiple of 62 that fits in a byte; bytes from 248 up are skipped so every character is equally likely.
+	out := make([]byte, 0, n)
+	buf := make([]byte, 64)
+	for len(out) < n {
+		if _, err := rand.Read(buf); err != nil {
+			panic(err) // crypto/rand does not fail on supported platforms
+		}
+		for _, b := range buf {
+			if b >= 248 {
+				continue
+			}
+			out = append(out, apiKeyAlphabet[int(b)%len(apiKeyAlphabet)])
+			if len(out) == n {
+				break
+			}
+		}
+	}
+	return "tly_" + string(out)
+}
+
+// hashToken is the hex SHA-256 of a token, which is what the store keeps of it.
+func hashToken(token string) string {
+	sum := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(sum[:])
+}
+
+// tokenLast4 returns the token's last four characters.
+func tokenLast4(token string) string {
+	if len(token) < 4 {
+		return token
+	}
+	return token[len(token)-4:]
+}
+
+// publicAPIKey is k as the store hands it out: without the token or its hash.
+func publicAPIKey(k APIKey) APIKey {
+	k.Token = ""
+	k.TokenHash = ""
+	return k
+}
