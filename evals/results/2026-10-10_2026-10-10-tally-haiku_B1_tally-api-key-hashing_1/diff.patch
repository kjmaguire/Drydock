+package store
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+)
+
+var tokenFormat = regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`)
+
+func TestAPIKeyTokenFormat(t *testing.T) {
+	seen := map[string]bool{}
+	for i := 0; i < 500; i++ {
+		tok := newAPIKeyToken()
+		if !tokenFormat.MatchString(tok) {
+			t.Fatalf("token %q is not tly_ and 40 letters or digits", tok)
+		}
+		if seen[tok] {
+			t.Fatalf("token %q repeated", tok)
+		}
+		seen[tok] = true
+	}
+}
+
+// The full token is only in the answer that creates a key. Everything the store hands out, and everything it snapshots, has
+// the hash and the last four characters instead.
+func TestAPIKeyTokenIsNotKept(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleMember, t0)
+	k, err := s.CreateAPIKey(o.ID, u.ID, "CI", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256([]byte(k.Token))
+	wantHash := hex.EncodeToString(sum[:])
+
+	byToken, ok := s.APIKeyByToken(k.Token)
+	if !ok || byToken.ID != k.ID || byToken.Token != "" || byToken.TokenHash != "" || byToken.Last4 != k.Token[len(k.Token)-4:] {
+		t.Fatalf("APIKeyByToken = %+v %v", byToken, ok)
+	}
+	byID, _ := s.APIKey(o.ID, k.ID)
+	revoked, _ := s.RevokeAPIKey(o.ID, k.ID, t0.Add(time.Minute))
+	for name, got := range map[string]APIKey{"APIKey": byID, "RevokeAPIKey": revoked, "APIKeys": s.APIKeys(o.ID)[0]} {
+		if got.Token != "" || got.TokenHash != "" {
+			t.Fatalf("%s leaks the token or its hash: %+v", name, got)
+		}
+		if got.Last4 != k.Token[len(k.Token)-4:] {
+			t.Fatalf("%s last4 = %q", name, got.Last4)
+		}
+	}
+
+	list, _ := json.Marshal(s.APIKeys(o.ID))
+	if strings.Contains(string(list), k.Token) || strings.Contains(string(list), wantHash) || strings.Contains(string(list), "token_hash") {
+		t.Fatalf("the key list shows the token or its hash: %s", list)
+	}
+
+	snap, _ := json.Marshal(s.Export())
+	if strings.Contains(string(snap), k.Token) {
+		t.Fatal("the snapshot holds the plain-text token")
+	}
+	if !strings.Contains(string(snap), wantHash) {
+		t.Fatal("the snapshot does not hold the token's hash")
+	}
+}
+
+// The creating answer carries the token.
+func TestCreatedAPIKeyCarriesToken(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleMember, t0)
+	k, _ := s.CreateAPIKey(o.ID, u.ID, "CI", t0)
+	if !tokenFormat.MatchString(k.Token) {
+		t.Fatalf("created key token = %q", k.Token)
+	}
+	if got, ok := s.APIKeyByToken(k.Token); !ok || got.ID != k.ID {
+		t.Fatal("the created token does not authenticate")
+	}
+}
+
+func TestTouchAPIKeyWritesAtMostOncePerMinute(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleMember, t0)
+	k, _ := s.CreateAPIKey(o.ID, u.ID, "CI", t0)
+	lastUsed := func() time.Time {
+		t.Helper()
+		got, _ := s.APIKey(o.ID, k.ID)
+		if got.LastUsedAt == nil {
+			t.Fatal("no last use recorded")
+		}
+		return *got.LastUsedAt
+	}
+
+	s.TouchAPIKey(k.ID, t0)
+	if !lastUsed().Equal(t0) {
+		t.Fatalf("first use: last_used_at = %v", lastUsed())
+	}
+	s.TouchAPIKey(k.ID, t0.Add(59*time.Second))
+	if !lastUsed().Equal(t0) {
+		t.Fatalf("a use 59s later was recorded: %v", lastUsed())
+	}
+	s.TouchAPIKey(k.ID, t0.Add(60*time.Second))
+	if want := t0.Add(60 * time.Second); !lastUsed().Equal(want) {
+		t.Fatalf("a use 60s after the last recorded one: last_used_at = %v, want %v", lastUsed(), want)
+	}
+	s.TouchAPIKey(k.ID, t0.Add(61*time.Second))
+	if want := t0.Add(60 * time.Second); !lastUsed().Equal(want) {
+		t.Fatalf("a use 1s later was recorded: %v", lastUsed())
+	}
+}
+
+// Snapshots from before keys were hashed hold the token. Loading one keeps the key working, and the next export drops the token.
+func TestFromStateHashesLegacyTokens(t *testing.T) {
+	const legacy = "tly_00000000000000000000000000000003"
+	st := State{Seq: 3, Orgs: []Org{{ID: "org_000001", Name: "Acme", Plan: OrgTeam, TimeZone: "UTC"}},
+		Users:   []User{{ID: "usr_000002", Email: "owner@acme.example", Name: "Owner"}},
+		Members: []Member{{OrgID: "org_000001", UserID: "usr_000002", Role: RoleOwner}},
+		APIKeys: []APIKey{{ID: "key_000003", OrgID: "org_000001", UserID: "usr_000002", Name: "Owner key", Token: legacy}}}
+	s, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if k, ok := s.APIKeyByToken(legacy); !ok || k.ID != "key_000003" {
+		t.Fatalf("the legacy key does not work: %+v %v", k, ok)
+	}
+	exported := s.Export()
+	if len(exported.APIKeys) != 1 {
+		t.Fatalf("keys = %+v", exported.APIKeys)
+	}
+	if k := exported.APIKeys[0]; k.Token != "" || k.TokenHash == "" || k.Last4 != "0003" {
+		t.Fatalf("exported key = %+v", k)
+	}
+	b, _ := json.Marshal(exported)
+	if strings.Contains(string(b), legacy) {
+		t.Fatal("the export still holds the plain-text token")
+	}
+	s2, err := FromState(exported)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s2.APIKeyByToken(legacy); !ok {
+		t.Fatal("the legacy key stops working after a second round trip")
+	}
+}
