+package snapshot
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/store"
+)
+
+// A snapshot never holds a plain-text API key token, and the keys still work after a reload.
+func TestSaveWritesNoPlainTokens(t *testing.T) {
+	now := time.Date(2026, 2, 1, 12, 0, 0, 0, time.UTC)
+	st := store.New()
+	o, _ := st.CreateOrg("A", store.OrgTeam, "UTC", 0, now)
+	u, _ := st.CreateUser("ann@example.com", "Ann", now)
+	_, _ = st.AddMember(o.ID, u.ID, store.RoleOwner, now)
+	k, _ := st.CreateAPIKey(o.ID, u.ID, "k", now)
+
+	path := filepath.Join(t.TempDir(), "tally.json")
+	if err := Save(st, path, now); err != nil {
+		t.Fatal(err)
+	}
+	assertNoToken(t, path, k.Token)
+	got, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if found, ok := got.APIKeyByToken(k.Token); !ok || found.ID != k.ID {
+		t.Fatal("the key does not work after a reload")
+	}
+}
+
+// A version 1 snapshot holds plain-text tokens. Loading it keeps the keys working, and the next save drops the tokens.
+func TestLoadVersion1ThenSaveDropsTokens(t *testing.T) {
+	const token = "tly_00000000000000000000000000000003"
+	st, err := Load(filepath.Join("testdata", "v1.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "tally.json")
+	if err := Save(st, path, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	assertNoToken(t, path, token)
+	again, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := again.APIKeyByToken(token); !ok {
+		t.Fatal("the version 1 key does not work after it was re-saved")
+	}
+}
+
+// A version 2 snapshot written before keys were hashed holds the token in state.api_keys[].token.
+func TestLoadVersion2WithPlainTokens(t *testing.T) {
+	const token = "tly_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN"
+	dir := t.TempDir()
+	path := filepath.Join(dir, "tally.json")
+	legacy := `{
+  "version": 2,
+  "saved_at": "2026-02-01T12:00:00Z",
+  "state": {
+    "seq": 3,
+    "orgs": [{"id": "org_000001", "name": "Acme", "plan": "team", "time_zone": "UTC", "tax_rate_bp": 0, "created_at": "2026-02-01T12:00:00Z"}],
+    "users": [{"id": "usr_000002", "email": "owner@acme.example", "name": "Owner", "created_at": "2026-02-01T12:00:00Z"}],
+    "members": [{"org_id": "org_000001", "user_id": "usr_000002", "role": "owner", "created_at": "2026-02-01T12:00:00Z"}],
+    "api_keys": [{"id": "key_000003", "org_id": "org_000001", "user_id": "usr_000002", "name": "Owner key", "token": "` + token + `", "created_at": "2026-02-01T12:00:00Z"}]
+  }
+}`
+	if err := os.WriteFile(path, []byte(legacy), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	st, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if k, ok := st.APIKeyByToken(token); !ok || k.ID != "key_000003" {
+		t.Fatal("the legacy key does not work")
+	}
+	if err := Save(st, path, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	assertNoToken(t, path, token)
+}
+
+func assertNoToken(t *testing.T, path, token string) {
+	t.Helper()
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), token) {
+		t.Fatalf("%s holds a plain-text API key token", path)
+	}
+}
