+++ b/result/internal/api/apikey_test.go
@@ -0,0 +1,114 @@
+package api_test
+
+import (
+	"net/http"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+)
+
+// The token is in the answer that creates a key and nowhere else: not in the list, and not after the key is used.
+func TestAPIKeyTokenShownOnlyOnCreate(t *testing.T) {
+	e := apitest.New(t)
+	var created map[string]any
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "CI"}, &created)
+	token, _ := created["token"].(string)
+	if !regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`).MatchString(token) {
+		t.Fatalf("created token = %q", token)
+	}
+	if created["last4"] != token[len(token)-4:] {
+		t.Fatalf("created last4 = %v", created["last4"])
+	}
+
+	e.MustDo(http.StatusOK, "GET", "/v1/org", token, nil, nil)
+	r := e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, nil)
+	if strings.Contains(string(r.Body), token) || strings.Contains(string(r.Body), "token_hash") {
+		t.Fatalf("the key list shows the token or its hash: %s", r.Body)
+	}
+	var list struct {
+		Items []map[string]any `json:"items"`
+	}
+	r.JSON(t, &list)
+	for _, k := range list.Items {
+		if _, ok := k["token"]; ok {
+			t.Fatalf("a listed key has a token field: %v", k)
+		}
+		if _, ok := k["token_hash"]; ok {
+			t.Fatalf("a listed key has a token_hash field: %v", k)
+		}
+		for _, field := range []string{"id", "name", "user_id", "created_at", "last4"} {
+			if _, ok := k[field]; !ok {
+				t.Fatalf("a listed key has no %s: %v", field, k)
+			}
+		}
+	}
+	if len(list.Items) != 2 {
+		t.Fatalf("keys = %v", list.Items)
+	}
+	if got := list.Items[1]; got["id"] != created["id"] || got["last4"] != token[len(token)-4:] {
+		t.Fatalf("listed key = %v", got)
+	}
+}
+
+// Accepting an invite answers the new member's first key, with its token.
+func TestAcceptInviteAnswersTokenOnce(t *testing.T) {
+	e := apitest.New(t)
+	var inv struct {
+		Token string `json:"token"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"}, &inv)
+	var accepted struct {
+		APIKey map[string]any `json:"api_key"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": inv.Token, "name": "New"}, &accepted)
+	token, _ := accepted.APIKey["token"].(string)
+	if !strings.HasPrefix(token, "tly_") || len(token) != len("tly_")+40 {
+		t.Fatalf("accepted token = %q", token)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", token, nil, nil)
+	r := e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, nil)
+	if strings.Contains(string(r.Body), token) {
+		t.Fatalf("the key list shows the token: %s", r.Body)
+	}
+}
+
+// A use less than a minute after the recorded one leaves last_used_at unchanged.
+func TestAPIKeyLastUsedAtThrottled(t *testing.T) {
+	e := apitest.New(t)
+	ownerKey, ok := e.Store.APIKeyByToken(e.Acme.Key)
+	if !ok {
+		t.Fatal("the owner's key is not found")
+	}
+	// lastUsed lists the keys (which is a use of the owner's key too) and returns the owner's last_used_at.
+	lastUsed := func() any {
+		t.Helper()
+		var list struct {
+			Items []map[string]any `json:"items"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, &list)
+		for _, k := range list.Items {
+			if k["id"] == ownerKey.ID {
+				return k["last_used_at"]
+			}
+		}
+		t.Fatal("owner's key not listed")
+		return nil
+	}
+	first := lastUsed()
+	if first == nil {
+		t.Fatal("the first use was not recorded")
+	}
+	e.Clock.Advance(30 * time.Second)
+	e.MustDo(http.StatusOK, "GET", "/v1/org", e.Acme.Key, nil, nil)
+	if got := lastUsed(); got != first {
+		t.Fatalf("a use 30s later changed last_used_at: %v -> %v", first, got)
+	}
+	e.Clock.Advance(30 * time.Second)
+	e.MustDo(http.StatusOK, "GET", "/v1/org", e.Acme.Key, nil, nil)
+	if got := lastUsed(); got == first {
+		t.Fatal("a use 60s after the recorded one was not recorded")
+	}
+}
