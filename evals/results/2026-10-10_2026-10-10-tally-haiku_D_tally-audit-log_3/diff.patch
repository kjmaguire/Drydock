@@ -109,11 +109,21 @@ func encodeCursor(c cursor) string {
 
 // pageOf returns one page of items, which are sorted by key (creation time, then ID), and the cursor of the next page.
 func pageOf[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	return pageFrom(items, key, p, func(k cursor) bool { return p.after.less(k) })
+}
+
+// pageOfNewest is pageOf for items sorted newest first.
+func pageOfNewest[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	return pageFrom(items, key, p, func(k cursor) bool { return k.less(*p.after) })
+}
+
+// pageFrom cuts a page out of items, starting at the first item whose key starts a page (see startsPage).
+func pageFrom[T any](items []T, key func(T) cursor, p page, startsPage func(cursor) bool) ([]T, string) {
 	start := 0
 	if p.after != nil {
 		start = len(items)
 		for i, it := range items {
-			if p.after.less(key(it)) {
+			if startsPage(key(it)) {
 				start = i
 				break
 			}
