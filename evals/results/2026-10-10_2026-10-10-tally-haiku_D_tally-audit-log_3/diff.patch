+package api
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"slices"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// change is one field's value before and after an update, as JSON.
+type change struct {
+	From json.RawMessage `json:"from"`
+	To   json.RawMessage `json:"to"`
+}
+
+// changeSet maps JSON field names to their changes.
+type changeSet map[string]change
+
+// audit records a change in the audit log. Call it only when the change is made and the request is about to be answered 2xx.
+// changes is nil unless the entry is for an update.
+func (s *Server) audit(r *http.Request, p auth.Principal, action string, target store.AuditTarget, changes changeSet) {
+	e := store.AuditEvent{OrgID: p.OrgID, Action: action, Actor: store.AuditActor{Type: "api_key", ID: p.KeyID, UserID: p.UserID},
+		Target: target, RequestID: RequestID(r.Context()), At: s.clock.Now()}
+	if changes != nil {
+		e.Changes, _ = json.Marshal(changes)
+	}
+	s.store.RecordAudit(e)
+}
+
+// diff returns the fields whose JSON values differ between before and after, by JSON field name. The fields named in skip
+// are left out, so that secrets never reach the log.
+func diff(before, after any, skip ...string) changeSet {
+	from, to := jsonFields(before), jsonFields(after)
+	names := map[string]bool{}
+	for k := range from {
+		names[k] = true
+	}
+	for k := range to {
+		names[k] = true
+	}
+	cs := changeSet{}
+	for k := range names {
+		if slices.Contains(skip, k) {
+			continue
+		}
+		f, t := valueOrNull(from[k]), valueOrNull(to[k])
+		if !bytes.Equal(f, t) {
+			cs[k] = change{From: f, To: t}
+		}
+	}
+	return cs
+}
+
+// jsonFields returns the JSON object v encodes to, with each field's encoded value.
+func jsonFields(v any) map[string]json.RawMessage {
+	raw, _ := json.Marshal(v)
+	var m map[string]json.RawMessage
+	_ = json.Unmarshal(raw, &m)
+	return m
+}
+
+// valueOrNull is a field's encoded value, or null when the field is omitted (for example an empty optional field).
+func valueOrNull(v json.RawMessage) json.RawMessage {
+	if v == nil {
+		return json.RawMessage("null")
+	}
+	return v
+}
+
+func auditKey(e store.AuditEvent) cursor { return cursor{T: e.At, ID: e.ID} }
+
+// listAuditEvents lists the organization's audit log, newest first, optionally only the entries with ?action=, ?target_id=
+// or ?actor_id= (a user ID or an API key ID). Only owners and admins may read it.
+func (s *Server) listAuditEvents(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	if !auth.CanReadAudit(p.Role) {
+		writeJSON(w, http.StatusForbidden, map[string]string{"error": "forbidden"})
+		return
+	}
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	q := r.URL.Query()
+	evs := s.store.AuditEvents(p.OrgID, store.AuditFilter{Action: q.Get("action"), TargetID: q.Get("target_id"), ActorID: q.Get("actor_id")})
+	items, next := pageOfNewest(evs, auditKey, pg)
+	writeJSON(w, http.StatusOK, list{Items: items, NextCursor: next})
+}
