+package api_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// allActions are the kinds of change the audit log records.
+var allActions = []string{
+	"customer.created", "customer.updated", "customer.deleted", "plan.created", "plan.updated", "subscription.created",
+	"subscription.updated", "subscription.canceled", "invoice.created", "invoice.paid", "invoice.voided", "api_key.created",
+	"api_key.revoked", "member.role_changed", "member.removed", "invite.created", "invite.revoked", "webhook_endpoint.created",
+	"webhook_endpoint.updated", "webhook_endpoint.deleted", "org.updated",
+}
+
+// auditLog returns the audit entries the API lists to the Acme owner for a query string, newest first. It asks for 100 at
+// a time, so that a test sees the whole log.
+func auditLog(t *testing.T, e *apitest.Env, query string) []store.AuditEvent {
+	t.Helper()
+	path := "/v1/audit-events" + query + "&limit=100"
+	if query == "" {
+		path = "/v1/audit-events?limit=100"
+	}
+	var page struct {
+		Items []store.AuditEvent `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", path, e.Acme.Key, nil, &page)
+	return page.Items
+}
+
+// changed is one field's old and new value in an audit entry.
+type changed struct {
+	From any `json:"from"`
+	To   any `json:"to"`
+}
+
+func changesOf(t *testing.T, ev store.AuditEvent) map[string]changed {
+	t.Helper()
+	var cs map[string]changed
+	if ev.Changes != nil {
+		if err := json.Unmarshal(ev.Changes, &cs); err != nil {
+			t.Fatalf("changes of %s: %v", ev.Action, err)
+		}
+	}
+	return cs
+}
+
+// keyIDOf returns the ID of the API key with this token.
+func keyIDOf(t *testing.T, e *apitest.Env, token string) string {
+	t.Helper()
+	k, ok := e.Store.APIKeyByToken(token)
+	if !ok {
+		t.Fatal("no such key")
+	}
+	return k.ID
+}
+
+func TestAuditRecordsSuccessfulRequests(t *testing.T) {
+	e := apitest.New(t)
+	before := len(auditLog(t, e, ""))
+
+	r := e.DoWith("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane", "email": "jane@example.com"}, http.Header{"X-Request-Id": {"req-create"}})
+	if r.Code != http.StatusCreated {
+		t.Fatalf("create: %s", r)
+	}
+	var c store.Customer
+	r.JSON(t, &c)
+
+	// Failed requests record nothing.
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	for _, f := range []func() *apitest.Response{
+		func() *apitest.Response {
+			return e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane 2", "email": "jane@example.com"})
+		},
+		func() *apitest.Response {
+			return e.Do("PATCH", "/v1/customers/cus_nope", e.Acme.Key, map[string]string{"name": "X"})
+		},
+		func() *apitest.Response { return e.Do("DELETE", "/v1/customers/"+c.ID, "", nil) },
+		func() *apitest.Response { return e.Do("DELETE", "/v1/customers/"+c.ID, viewer, nil) },
+	} {
+		if r := f(); r.Code < 400 {
+			t.Fatalf("a request that should fail succeeded: %s", r)
+		}
+	}
+	if n := len(auditLog(t, e, "")); n != before+1 {
+		t.Fatalf("failed requests changed the log: %d entries, want %d", n, before+1)
+	}
+
+	r = e.DoWith("PATCH", "/v1/customers/"+c.ID, e.Acme.Key, map[string]string{"name": "Jane Q", "email": "jane@example.com"}, http.Header{"X-Request-Id": {"req-update"}})
+	if r.Code != http.StatusOK {
+		t.Fatalf("update: %s", r)
+	}
+	r = e.DoWith("DELETE", "/v1/customers/"+c.ID, e.Acme.Key, nil, http.Header{"X-Request-Id": {"req-delete"}})
+	if r.Code != http.StatusNoContent {
+		t.Fatalf("delete: %s", r)
+	}
+	// Reading the log is not a change.
+	log := auditLog(t, e, "")
+	if len(log) != before+3 {
+		t.Fatalf("%d entries, want %d", len(log), before+3)
+	}
+	deleted, updated, created := log[0], log[1], log[2]
+	if deleted.Action != "customer.deleted" || updated.Action != "customer.updated" || created.Action != "customer.created" {
+		t.Fatalf("actions, newest first = %s, %s, %s", deleted.Action, updated.Action, created.Action)
+	}
+	keyID := keyIDOf(t, e, e.Acme.Key)
+	for _, ev := range []store.AuditEvent{created, updated, deleted} {
+		if ev.Actor != (store.AuditActor{Type: "api_key", ID: keyID, UserID: e.Acme.Owner.ID}) {
+			t.Fatalf("%s actor = %+v", ev.Action, ev.Actor)
+		}
+		if ev.Target != (store.AuditTarget{Type: "customer", ID: c.ID}) {
+			t.Fatalf("%s target = %+v", ev.Action, ev.Target)
+		}
+		if !ev.At.Equal(e.Clock.Now()) {
+			t.Fatalf("%s at = %s", ev.Action, ev.At)
+		}
+	}
+	if created.RequestID != "req-create" || updated.RequestID != "req-update" || deleted.RequestID != "req-delete" {
+		t.Fatalf("request ids = %q, %q, %q", created.RequestID, updated.RequestID, deleted.RequestID)
+	}
+}
+
+func TestAuditEntryShape(t *testing.T) {
+	e := apitest.New(t)
+	var c store.Customer
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane", "email": "jane@example.com"}, &c)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, e.Acme.Key, map[string]string{"name": "Jane Q"}, nil)
+
+	var page struct {
+		Items []map[string]any `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events?action=customer.updated", e.Acme.Key, nil, &page)
+	if len(page.Items) != 1 {
+		t.Fatalf("items = %+v", page.Items)
+	}
+	ev := page.Items[0]
+	if ev["action"] != "customer.updated" || !strings.HasPrefix(ev["id"].(string), "aud_") {
+		t.Fatalf("entry = %+v", ev)
+	}
+	for _, k := range []string{"id", "action", "actor", "target", "request_id", "at", "changes"} {
+		if _, ok := ev[k]; !ok {
+			t.Fatalf("entry has no %q: %+v", k, ev)
+		}
+	}
+	if len(ev) != 7 {
+		t.Fatalf("entry has extra fields: %+v", ev)
+	}
+	if at, ok := ev["at"].(string); !ok || !strings.HasSuffix(at, "Z") {
+		t.Fatalf("at = %v, want RFC 3339 UTC", ev["at"])
+	}
+
+	// A created entry has no changes.
+	var created struct {
+		Items []map[string]any `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events?action=customer.created", e.Acme.Key, nil, &created)
+	if len(created.Items) != 1 {
+		t.Fatalf("created entries = %+v", created.Items)
+	}
+	if _, ok := created.Items[0]["changes"]; ok {
+		t.Fatalf("a created entry has changes: %+v", created.Items[0])
+	}
+}
+
+func TestAuditUpdatesListOnlyChangedFields(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+
+	// The name is sent unchanged, so only the time zone and tax rate appear.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]any{"name": "Acme", "tax_rate_bp": 2000, "time_zone": "Asia/Tokyo"}, nil)
+	// Nothing changes, but the request succeeded, so it is still recorded, with no changes.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]any{"tax_rate_bp": 2000}, nil)
+
+	log := auditLog(t, e, "?action=org.updated")
+	if len(log) != 2 {
+		t.Fatalf("org entries = %+v", log)
+	}
+	if cs := changesOf(t, log[1]); len(cs) != 2 || cs["tax_rate_bp"].From != float64(0) || cs["tax_rate_bp"].To != float64(2000) ||
+		cs["time_zone"].From != "America/New_York" || cs["time_zone"].To != "Asia/Tokyo" {
+		t.Fatalf("org changes = %+v", cs)
+	}
+	if cs := changesOf(t, log[0]); len(cs) != 0 {
+		t.Fatalf("unchanged org has changes = %+v", cs)
+	}
+	if log[1].Target != (store.AuditTarget{Type: "org", ID: e.Acme.ID}) {
+		t.Fatalf("org target = %+v", log[1].Target)
+	}
+
+	e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	u, _ := e.Store.UserByEmail("m@acme.example")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+u.ID, key, map[string]string{"role": "billing"}, nil)
+	log = auditLog(t, e, "?action=member.role_changed")
+	if len(log) != 1 {
+		t.Fatalf("role entries = %+v", log)
+	}
+	if cs := changesOf(t, log[0]); len(cs) != 1 || cs["role"].From != "member" || cs["role"].To != "billing" {
+		t.Fatalf("role changes = %+v", cs)
+	}
+	if log[0].Target != (store.AuditTarget{Type: "member", ID: u.ID}) {
+		t.Fatalf("member target = %+v", log[0].Target)
+	}
+
+	var c store.Customer
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, map[string]string{"name": "Jane", "email": "jane@example.com"}, &c)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, key, map[string]any{"name": "Jane Q", "metadata": map[string]string{"crm": "7"}}, nil)
+	cs := changesOf(t, auditLog(t, e, "?action=customer.updated")[0])
+	if len(cs) != 2 || cs["name"].From != "Jane" || cs["name"].To != "Jane Q" || cs["metadata"].From != nil {
+		t.Fatalf("customer changes = %+v", cs)
+	}
+	if _, ok := cs["email"]; ok {
+		t.Fatalf("the unchanged email is in the changes: %+v", cs)
+	}
+}
+
+func TestAuditNeverHoldsSecrets(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", key, map[string]any{"url": "https://hooks.acme.example/a", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, key, map[string]any{"url": "https://hooks.acme.example/b"}, nil)
+
+	var k store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", key, map[string]string{"name": "CI"}, &k)
+
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "new@people.example", "role": "member"}, nil)
+	m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(e.Mail.Messages()[0].Body)
+	if m == nil {
+		t.Fatal("no invite link in the email")
+	}
+	inviteToken, _ := url.QueryUnescape(m[1])
+
+	r := e.Do("GET", "/v1/audit-events", key, nil)
+	if r.Code != http.StatusOK {
+		t.Fatalf("list: %s", r)
+	}
+	for _, secret := range []string{ep.Secret, k.Token, inviteToken} {
+		if secret == "" || strings.Contains(string(r.Body), secret) {
+			t.Fatalf("the log holds a secret, or the test has none: %q", secret)
+		}
+	}
+	if cs := changesOf(t, auditLog(t, e, "?action=webhook_endpoint.updated")[0]); len(cs) != 1 || cs["url"].To != "https://hooks.acme.example/b" {
+		t.Fatalf("endpoint changes = %+v", cs)
+	}
+}
+
+func TestAuditCoversEveryKind(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+
+	var inv store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "new@people.example", "role": "member"}, &inv)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+inv.ID, key, nil, nil)
+	e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	u, _ := e.Store.UserByEmail("m@acme.example")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+u.ID, key, map[string]string{"role": "billing"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+u.ID, key, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]any{"time_zone": "Asia/Tokyo"}, nil)
+
+	var k store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", key, map[string]string{"name": "CI"}, &k)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+k.ID, key, nil, nil)
+
+	var c, gone store.Customer
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, map[string]string{"name": "Jane", "email": "jane@example.com"}, &c)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, key, map[string]string{"name": "Jane Q"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, map[string]string{"name": "John", "email": "john@example.com"}, &gone)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+gone.ID, key, nil, nil)
+
+	var p store.Plan
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", key, map[string]string{"name": "Team", "currency": "USD", "price": "20.00", "interval": "month"}, &p)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/plans/"+p.ID, key, map[string]string{"name": "Team Plus"}, nil)
+
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", key, map[string]any{"customer_id": c.ID, "plan_id": p.ID, "quantity": 2}, &sub)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, key, map[string]int{"quantity": 3}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", key, map[string]bool{"at_period_end": true}, nil)
+
+	var paid, voided store.Invoice
+	for _, dst := range []*store.Invoice{&paid, &voided} {
+		e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD",
+			"lines": []map[string]any{{"description": "Consulting", "quantity": 1, "unit_amount": 1000}}}, dst)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+paid.ID+"/pay", key, map[string]string{"payment_method": "pm_card_visa"}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+voided.ID+"/void", key, nil, nil)
+
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, key, map[string]bool{"enabled": false}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+ep.ID, key, nil, nil)
+
+	// The subscription's first invoice is not a request of its own, so only the two manual invoices are recorded.
+	log := auditLog(t, e, "")
+	seen := map[string]int{}
+	for _, ev := range log {
+		seen[ev.Action]++
+	}
+	for _, a := range allActions {
+		if seen[a] == 0 {
+			t.Errorf("no entry for %s", a)
+		}
+	}
+	if seen["invoice.created"] != 2 || seen["customer.created"] != 2 {
+		t.Fatalf("counts = %v", seen)
+	}
+	if len(log) != 23 {
+		t.Fatalf("%d entries, want 23 (one per request above): %v", len(log), seen)
+	}
+}
