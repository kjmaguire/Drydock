diff --git a/result/internal/store/audit.go b/result/internal/store/audit.go
new file mode 100644
index 0000000..2a7d904
--- /dev/null
+++ b/result/internal/store/audit.go
@@ -0,0 +1,69 @@
+package store
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+)
+
+// AuditEvent is one entry in an organization's audit log: a change that a successful request made. Changes is set for
+// updates only, as a JSON object from field name to {"from", "to"}.
+type AuditEvent struct {
+	ID        string          `json:"id"`
+	OrgID     string          `json:"-"`
+	Action    string          `json:"action"`
+	Actor     AuditActor      `json:"actor"`
+	Target    AuditTarget     `json:"target"`
+	RequestID string          `json:"request_id"`
+	At        time.Time       `json:"at"`
+	Changes   json.RawMessage `json:"changes,omitempty"`
+}
+
+// AuditActor is who made a change: the API key that made the request, and the member the key acts for.
+type AuditActor struct {
+	Type   string `json:"type"`
+	ID     string `json:"id"`
+	UserID string `json:"user_id"`
+}
+
+// AuditTarget is the object a change was made to.
+type AuditTarget struct {
+	Type string `json:"type"`
+	ID   string `json:"id"`
+}
+
+// AuditFilter selects audit entries. An empty field matches everything. ActorID is a user ID or an API key ID.
+type AuditFilter struct {
+	Action   string
+	TargetID string
+	ActorID  string
+}
+
+// RecordAudit appends an entry to the audit log, giving it an ID. Entries are never changed or removed.
+func (s *Store) RecordAudit(e AuditEvent) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.auditSeq++
+	e.ID = fmt.Sprintf("aud_%06d", s.auditSeq)
+	e.At = e.At.UTC()
+	s.audit = append(s.audit, e)
+}
+
+// AuditEvents returns an organization's audit entries that match f, newest first.
+func (s *Store) AuditEvents(orgID string, f AuditFilter) []AuditEvent {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []AuditEvent{}
+	for i := len(s.audit) - 1; i >= 0; i-- {
+		e := s.audit[i]
+		switch {
+		case e.OrgID != orgID:
+		case f.Action != "" && e.Action != f.Action:
+		case f.TargetID != "" && e.Target.ID != f.TargetID:
+		case f.ActorID != "" && e.Actor.ID != f.ActorID && e.Actor.UserID != f.ActorID:
+		default:
+			out = append(out, e)
+		}
+	}
+	return out
+}
