+func TestAuditOmitsDeclinedPayment(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	var c store.Customer
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, map[string]string{"name": "Jane", "email": "jane@example.com"}, &c)
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Consulting", "quantity": 1, "unit_amount": 1000}}}, &inv)
+
+	if r := e.Do("POST", "/v1/invoices/"+inv.ID+"/pay", key, map[string]string{"payment_method": "pm_card_declined"}); r.Code != http.StatusPaymentRequired {
+		t.Fatalf("declined: %s", r)
+	}
+	if n := len(auditLog(t, e, "?action=invoice.paid")); n != 0 {
+		t.Fatalf("a declined payment recorded %d invoice.paid entries", n)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+inv.ID+"/pay", key, map[string]string{"payment_method": "pm_card_visa"}, nil)
+	if log := auditLog(t, e, "?action=invoice.paid"); len(log) != 1 || log[0].Target.ID != inv.ID {
+		t.Fatalf("paid entries = %+v", log)
+	}
+}
+
+func TestAuditFilters(t *testing.T) {
+	e := apitest.New(t)
+	keyID := keyIDOf(t, e, e.Acme.Key)
+	var c, other store.Customer
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane", "email": "jane@example.com"}, &c)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, e.Acme.Key, map[string]string{"name": "Jane Q"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "John", "email": "john@example.com"}, &other)
+
+	if n := len(auditLog(t, e, "?action=customer.updated")); n != 1 {
+		t.Fatalf("by action: %d", n)
+	}
+	if log := auditLog(t, e, "?target_id="+c.ID); len(log) != 2 || log[0].Action != "customer.updated" || log[1].Action != "customer.created" {
+		t.Fatalf("by target: %+v", log)
+	}
+	if n := len(auditLog(t, e, "?actor_id="+keyID)); n != 3 {
+		t.Fatalf("by key ID: %d", n)
+	}
+	if n := len(auditLog(t, e, "?actor_id="+e.Acme.Owner.ID)); n != 3 {
+		t.Fatalf("by user ID: %d", n)
+	}
+	if n := len(auditLog(t, e, "?actor_id=usr_nobody")); n != 0 {
+		t.Fatalf("by unknown actor: %d", n)
+	}
+	r := e.Do("GET", "/v1/audit-events?actor_id=usr_nobody", e.Acme.Key, nil)
+	if !strings.Contains(string(r.Body), `"items":[]`) {
+		t.Fatalf("an empty result is not a list: %s", r)
+	}
+
+	// Another organization's owner sees none of Acme's entries.
+	if n := len(auditLog(t, e, "")); n != 3 {
+		t.Fatalf("Acme entries = %d", n)
+	}
+	var globex struct {
+		Items []store.AuditEvent `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events", e.Globex.Key, nil, &globex)
+	if len(globex.Items) != 0 {
+		t.Fatalf("another organization sees %d entries", len(globex.Items))
+	}
+}
+
+func TestAuditPaging(t *testing.T) {
+	e := apitest.New(t)
+	var ids []string
+	for _, name := range []string{"Ann", "Bob", "Cy", "Dee", "Eve"} {
+		var c store.Customer
+		e.MustDo(http.StatusCreated, "POST", "/v1/customers", e.Acme.Key, map[string]string{"name": name, "email": strings.ToLower(name) + "@example.com"}, &c)
+		ids = append(ids, c.ID)
+		e.Clock.Advance(time.Minute)
+	}
+
+	// Walk the pages two entries at a time: each entry once, newest first.
+	var got []store.AuditEvent
+	q := "/v1/audit-events?limit=2"
+	for pages := 0; ; pages++ {
+		if pages > 10 {
+			t.Fatal("the paging does not end")
+		}
+		var page struct {
+			Items      []store.AuditEvent `json:"items"`
+			NextCursor string             `json:"next_cursor"`
+		}
+		e.MustDo(http.StatusOK, "GET", q, e.Acme.Key, nil, &page)
+		if len(page.Items) > 2 {
+			t.Fatalf("a page has %d items", len(page.Items))
+		}
+		got = append(got, page.Items...)
+		if page.NextCursor == "" {
+			break
+		}
+		q = "/v1/audit-events?limit=2&cursor=" + url.QueryEscape(page.NextCursor)
+	}
+	if len(got) != len(ids) {
+		t.Fatalf("paging returned %d entries, want %d", len(got), len(ids))
+	}
+	for i, ev := range got {
+		if ev.Action != "customer.created" || ev.Target.ID != ids[len(ids)-1-i] {
+			t.Fatalf("entry %d = %s of %s, want the customer created %d-th from the last", i, ev.Action, ev.Target.ID, i)
+		}
+	}
+}
+
+func TestAuditReadableByOwnersAndAdminsOnly(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events", e.Acme.Key, nil, nil)
+	_, admin := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events", admin, nil, nil)
+
+	for _, role := range []store.Role{store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		_, key := e.AddMember(e.Acme, string(role)+"@acme.example", role)
+		r := e.Do("GET", "/v1/audit-events", key, nil)
+		if r.Code != http.StatusForbidden || strings.TrimSpace(string(r.Body)) != `{"error":"forbidden"}` {
+			t.Fatalf("%s reads the log: %s", role, r)
+		}
+	}
+	if r := e.Do("GET", "/v1/audit-events", "", nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("no key: %s", r)
+	}
+	if r := e.Do("GET", "/v1/audit-events?limit=0", e.Acme.Key, nil); r.Code != http.StatusBadRequest {
+		t.Fatalf("bad limit: %s", r)
+	}
+}
