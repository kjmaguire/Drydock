+// addInvoices creates n invoices for Acme; the i-th is made at at(i).
+func addInvoices(t *testing.T, st *store.Store, n int, at func(i int) time.Time) {
+	t.Helper()
+	c, err := st.CreateCustomer("acc_acme", "Jane", "jane@example.com", store.PlanPro, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < n; i++ {
+		inv := store.Invoice{AccountID: "acc_acme", CustomerID: c.ID, Lines: []store.LineItem{{Description: "Seat", Quantity: 1, UnitCents: 100}}}
+		if _, err := st.CreateInvoice(inv, at(i)); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+type invoicePage struct {
+	Items []struct {
+		ID string `json:"id"`
+	} `json:"items"`
+	NextCursor string `json:"next_cursor"`
+}
+
+// listPage requests one page of Acme's invoices with the given query string.
+func listPage(t *testing.T, h http.Handler, query string) invoicePage {
+	t.Helper()
+	r := do(t, h, "GET", "/api/invoices"+query, "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("list %q: %d %s", query, r.Code, r.Body)
+	}
+	var p invoicePage
+	if err := json.Unmarshal(r.Body.Bytes(), &p); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// walkInvoices follows next_cursor from the first page of the given size and returns every invoice ID in order.
+// between runs after each page that has a next page.
+func walkInvoices(t *testing.T, h http.Handler, limit int, between func(page int)) []string {
+	t.Helper()
+	var ids []string
+	cursor := ""
+	for page := 1; ; page++ {
+		if page > 1000 {
+			t.Fatal("pagination never ends")
+		}
+		query := "?limit=" + strconv.Itoa(limit)
+		if cursor != "" {
+			query += "&cursor=" + cursor
+		}
+		p := listPage(t, h, query)
+		for _, it := range p.Items {
+			ids = append(ids, it.ID)
+		}
+		if p.NextCursor == "" {
+			return ids
+		}
+		if len(p.Items) != limit {
+			t.Fatalf("page %d has %d items with a next cursor, want %d", page, len(p.Items), limit)
+		}
+		cursor = p.NextCursor
+		if between != nil {
+			between(page)
+		}
+	}
+}
+
+// invoiceIDs returns Acme's invoice IDs in the store's own order, the reference for paging.
+func invoiceIDs(st *store.Store) []string {
+	var ids []string
+	for _, inv := range st.Invoices("acc_acme") {
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
