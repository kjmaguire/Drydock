+// InvoiceCursor is a position in an account's invoices: the invoice the previous page ended on.
+type InvoiceCursor struct {
+	CreatedAt time.Time
+	ID        string
+}
+
+// InvoicePage returns up to limit of an account's invoices that come after cur in the order of Invoices.
+// A nil cur starts at the first invoice. Invoices created later sort after every position already
+// returned, so paging through them neither skips nor repeats an invoice.
+func (s *Store) InvoicePage(accountID string, cur *InvoiceCursor, limit int) []Invoice {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Invoice{}
+	for _, inv := range s.invoices {
+		if inv.AccountID != accountID {
+			continue
 		}
-		return out[i].ID < out[j].ID
-	})
+		if cur != nil && !invoiceLess(Invoice{CreatedAt: cur.CreatedAt, ID: cur.ID}, inv) {
+			continue
+		}
+		out = append(out, inv)
+	}
+	sort.Slice(out, func(i, j int) bool { return invoiceLess(out[i], out[j]) })
+	if len(out) > limit {
+		out = out[:limit]
+	}
 	return out
 }
+
+// invoiceLess is the order of an account's invoice list: oldest first, ties by ID.
+func invoiceLess(a, b Invoice) bool {
+	if !a.CreatedAt.Equal(b.CreatedAt) {
+		return a.CreatedAt.Before(b.CreatedAt)
+	}
+	return a.ID < b.ID
+}
