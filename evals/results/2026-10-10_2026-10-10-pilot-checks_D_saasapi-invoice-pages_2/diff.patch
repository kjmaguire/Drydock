+const (
+	defaultPageSize = 20
+	maxPageSize     = 100
+)
+
+// invoiceCursor is what an opaque invoice cursor holds: the position of the last invoice on a page.
+type invoiceCursor struct {
+	CreatedAt time.Time `json:"t"`
+	ID        string    `json:"id"`
+}
+
+func encodeCursor(inv store.Invoice) string {
+	b, _ := json.Marshal(invoiceCursor{CreatedAt: inv.CreatedAt, ID: inv.ID})
+	return base64.RawURLEncoding.EncodeToString(b)
+}
+
+func decodeCursor(s string) (*store.InvoiceCursor, error) {
+	b, err := base64.RawURLEncoding.DecodeString(s)
+	if err != nil {
+		return nil, err
+	}
+	var c invoiceCursor
+	if err := json.Unmarshal(b, &c); err != nil {
+		return nil, err
+	}
+	if c.CreatedAt.IsZero() || c.ID == "" {
+		return nil, errors.New("cursor has no position")
+	}
+	return &store.InvoiceCursor{CreatedAt: c.CreatedAt, ID: c.ID}, nil
+}
+
 func (s *Server) listInvoices(w http.ResponseWriter, r *http.Request, acct store.Account) {
+	q := r.URL.Query()
+	limit := defaultPageSize
+	if q.Has("limit") {
+		n, err := strconv.Atoi(q.Get("limit"))
+		if err != nil || n < 1 || n > maxPageSize {
+			writeError(w, http.StatusBadRequest, "invalid_limit")
+			return
+		}
+		limit = n
+	}
+	var cur *store.InvoiceCursor
+	if c := q.Get("cursor"); c != "" {
+		var err error
+		if cur, err = decodeCursor(c); err != nil {
+			writeError(w, http.StatusBadRequest, "invalid_cursor")
+			return
+		}
+	}
+	// One invoice past the page size shows whether there is a next page.
+	page := s.store.InvoicePage(acct.ID, cur, limit+1)
+	next := ""
+	if len(page) > limit {
+		page = page[:limit]
+		next = encodeCursor(page[limit-1])
+	}
 	items := []invoiceView{}
-	for _, inv := range s.store.Invoices(acct.ID) {
+	for _, inv := range page {
 		items = append(items, view(inv))
 	}
-	writeJSON(w, http.StatusOK, map[string]any{"items": items})
+	writeJSON(w, http.StatusOK, map[string]any{"items": items, "next_cursor": next})
 }
 
