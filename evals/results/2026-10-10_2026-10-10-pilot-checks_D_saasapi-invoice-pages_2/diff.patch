+func TestInvoicesArePagedOldestFirst(t *testing.T) {
+	srv, st := newServer(t)
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	addInvoices(t, st, 25, func(i int) time.Time { return base.Add(time.Duration(i) * time.Minute) })
+
+	first := listPage(t, srv, "")
+	if len(first.Items) != 20 || first.NextCursor == "" {
+		t.Fatalf("default page: %d items, next %q; want 20 items and a next cursor", len(first.Items), first.NextCursor)
+	}
+	last := listPage(t, srv, "?limit=20&cursor="+first.NextCursor)
+	if len(last.Items) != 5 || last.NextCursor != "" {
+		t.Fatalf("last page: %d items, next %q; want 5 items and no next cursor", len(last.Items), last.NextCursor)
+	}
+
+	want := strings.Join(invoiceIDs(st), ",")
+	for _, limit := range []int{1, 7, 25, 100} {
+		if got := strings.Join(walkInvoices(t, srv, limit, nil), ","); got != want {
+			t.Fatalf("limit %d: got %s, want %s", limit, got, want)
+		}
+	}
+}
+
+func TestInvoicesAtTheSameTimeArePagedByID(t *testing.T) {
+	srv, st := newServer(t)
+	at := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	addInvoices(t, st, 12, func(int) time.Time { return at })
+
+	got := walkInvoices(t, srv, 5, nil)
+	if len(got) != 12 {
+		t.Fatalf("got %d invoices, want 12: %v", len(got), got)
+	}
+	for i := 1; i < len(got); i++ {
+		if got[i-1] >= got[i] {
+			t.Fatalf("not in ID order: %v", got)
+		}
+	}
+}
