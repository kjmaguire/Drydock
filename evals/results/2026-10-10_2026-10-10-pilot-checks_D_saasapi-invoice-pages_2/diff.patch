+}
+
+func TestAnUnreadableCursorIsInvalid(t *testing.T) {
+	srv, _ := newServer(t)
+	noID := base64.RawURLEncoding.EncodeToString([]byte(`{"t":"2026-01-01T00:00:00Z"}`))
+	notJSON := base64.RawURLEncoding.EncodeToString([]byte("not json"))
+	for _, raw := range []string{"!!!", notJSON, noID, "e30"} { // "e30" is {}: no position either
+		r := do(t, srv, "GET", "/api/invoices?cursor="+raw, "key-acme", "")
+		if r.Code != http.StatusBadRequest || !strings.Contains(r.Body.String(), `"invalid_cursor"`) {
+			t.Fatalf("cursor %q: %d %s", raw, r.Code, r.Body)
+		}
+	}
+}
+
+func TestPagingNeitherSkipsNorRepeatsWhenInvoicesAreCreated(t *testing.T) {
+	srv, st := newServer(t)
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	addInvoices(t, st, 5, func(int) time.Time { return base })
+
+	got := walkInvoices(t, srv, 2, func(page int) {
+		switch page {
+		case 1:
+			// Same timestamp as the rest: sorts by ID, after the cursor.
+			addInvoices(t, st, 2, func(int) time.Time { return base })
+		case 2:
+			// Clock behind the newest invoice: must still sort last, not before the cursor.
+			addInvoices(t, st, 1, func(int) time.Time { return base.Add(-time.Hour) })
+		}
+	})
+	want := strings.Join(invoiceIDs(st), ",")
+	if len(got) != 8 || strings.Join(got, ",") != want {
+		t.Fatalf("got %v, want %s", got, want)
+	}
+}
