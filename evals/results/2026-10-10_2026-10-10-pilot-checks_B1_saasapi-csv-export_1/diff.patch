+func TestCustomersCSVPrefixesFormulaLikeFieldsWithAQuote(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	cases := []struct{ name, email, wantName, wantEmail string }{
+		{"=HYPERLINK(\"http://x.test\",\"click\")", "=1@x.test", "'=HYPERLINK(\"http://x.test\",\"click\")", "'=1@x.test"},
+		{"+1+1", "+plus@x.test", "'+1+1", "'+plus@x.test"},
+		{"-2", "-minus@x.test", "'-2", "'-minus@x.test"},
+		{"@SUM(A1)", "@at@x.test", "'@SUM(A1)", "'@at@x.test"},
+		{"Ann = Bob", "a=b@x.test", "Ann = Bob", "a=b@x.test"},
+		{"O'Brien", "obrien@x.test", "O'Brien", "obrien@x.test"},
+	}
+	for _, c := range cases {
+		if _, err := st.CreateCustomer("acc_acme", c.name, c.email, store.PlanFree, now); err != nil {
+			t.Fatal(err)
+		}
+	}
+	rows := parseCSV(t, do(t, srv, "GET", "/api/customers.csv", "key-acme", "").Body.String())
+	if len(rows) != len(cases)+1 {
+		t.Fatalf("rows %d", len(rows))
+	}
+	for i, c := range cases {
+		if rows[i+1][1] != c.wantName || rows[i+1][2] != c.wantEmail {
+			t.Fatalf("case %d: got name %q email %q, want %q %q", i, rows[i+1][1], rows[i+1][2], c.wantName, c.wantEmail)
+		}
+	}
+}
+
+// parseCSV reads a CSV body with the standard library's RFC 4180 reader, and fails the test on bad CSV.
+func parseCSV(t *testing.T, body string) [][]string {
+	t.Helper()
+	r := csv.NewReader(strings.NewReader(body))
+	r.FieldsPerRecord = 5
+	rows, err := r.ReadAll()
+	if err != nil {
+		t.Fatalf("parse %q: %v", body, err)
+	}
+	return rows
+}
