+func TestCustomersCSVQuotesFieldsWithCommasQuotesAndLineBreaks(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	if _, err := st.CreateCustomer("acc_acme", "Doe, \"Jane\"\nLtd", "jane@example.com", store.PlanFree, now); err != nil {
+		t.Fatal(err)
+	}
+	body := do(t, srv, "GET", "/api/customers.csv", "key-acme", "").Body.String()
+	if !strings.Contains(body, "cus_00001,\"Doe, \"\"Jane\"\"\r\nLtd\",jane@example.com,free,") {
+		t.Fatalf("not RFC 4180 quoted: %q", body)
+	}
+	rows := parseCSV(t, body)
+	if rows[1][1] != "Doe, \"Jane\"\nLtd" {
+		t.Fatalf("name round trip: %q", rows[1][1])
+	}
+}
