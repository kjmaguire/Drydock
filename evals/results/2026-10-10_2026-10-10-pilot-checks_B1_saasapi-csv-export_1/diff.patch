+func TestCustomersCSVHasHeadersAndOneRowPerCustomerInUTC(t *testing.T) {
+	srv, st := newServer(t)
+	cest := time.FixedZone("CEST", 2*60*60)
+	if _, err := st.CreateCustomer("acc_acme", "Jane Doe", "jane@example.com", store.PlanPro, time.Date(2026, 1, 2, 12, 0, 0, 0, cest)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := st.CreateCustomer("acc_acme", "Bob", "bob@example.com", store.PlanFree, time.Date(2026, 3, 4, 5, 6, 7, 0, time.UTC)); err != nil {
+		t.Fatal(err)
+	}
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("status %d %s", r.Code, r.Body)
+	}
+	if got := r.Header().Get("Content-Type"); got != "text/csv; charset=utf-8" {
+		t.Fatalf("Content-Type %q", got)
+	}
+	if got := r.Header().Get("Content-Disposition"); got != `attachment; filename="customers.csv"` {
+		t.Fatalf("Content-Disposition %q", got)
+	}
+	want := "id,name,email,plan,created_at\r\n" +
+		"cus_00001,Jane Doe,jane@example.com,pro,2026-01-02T10:00:00Z\r\n" +
+		"cus_00002,Bob,bob@example.com,free,2026-03-04T05:06:07Z\r\n"
+	if r.Body.String() != want {
+		t.Fatalf("body:\n%q\nwant:\n%q", r.Body.String(), want)
+	}
+}
