+func TestCustomersCSVOnlyHasTheCallersCustomersSortedByID(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	if _, err := st.CreateCustomer("acc_globex", "Hank", "hank@globex.test", store.PlanFree, now); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"Ann", "Ben", "Cy"} {
+		if _, err := st.CreateCustomer("acc_acme", name, name+"@acme.test", store.PlanFree, now); err != nil {
+			t.Fatal(err)
+		}
+	}
+	rows := parseCSV(t, do(t, srv, "GET", "/api/customers.csv", "key-acme", "").Body.String())
+	if len(rows) != 4 {
+		t.Fatalf("rows %v", rows)
+	}
+	for i, name := range []string{"Ann", "Ben", "Cy"} {
+		if rows[i+1][1] != name {
+			t.Fatalf("row %d: %v", i+1, rows[i+1])
+		}
+	}
+	if strings.Contains(do(t, srv, "GET", "/api/customers.csv", "key-acme", "").Body.String(), "Hank") {
+		t.Fatal("another account's customer is exported")
+	}
+}
