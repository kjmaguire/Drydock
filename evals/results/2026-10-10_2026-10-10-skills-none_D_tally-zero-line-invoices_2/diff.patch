+func TestFreePlanIsInvoicedWithALine(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Free", Currency: money.USD, UnitAmount: 0, Interval: store.Monthly}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 3})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %+v, want the first and the renewal", invs)
+	}
+	for _, inv := range invs {
+		if inv.Status != store.InvoicePaid || len(inv.Lines) != 1 || inv.Lines[0].Quantity != 3 || inv.Lines[0].UnitAmount != 0 || !strings.HasPrefix(inv.Lines[0].Description, "Free, ") {
+			t.Fatalf("invoice = %+v", inv)
+		}
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 0 {
+		t.Fatalf("charges = %+v, want none for a free plan", cs)
+	}
+}
