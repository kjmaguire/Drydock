+// An invoice the store holds without lines (a free plan's invoice before it had a line, say) must still be answered.
+func TestInvoiceWithoutLinesIsAnswered(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: money.USD}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var list struct{ Items []struct{ ID, Description string } }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?customer_id="+c.ID, e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 || list.Items[0].ID != inv.ID || list.Items[0].Description != "" {
+		t.Fatalf("list = %+v", list)
+	}
+	var got struct{ ID, Description string }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &got)
+	if got.ID != inv.ID || got.Description != "" {
+		t.Fatalf("get = %+v", got)
+	}
+}
