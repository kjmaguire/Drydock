+func TestPlanChangeNeedsSeats(t *testing.T) {
+	s := New()
+	o, err := s.CreateOrg("Globex", OrgBusiness, "UTC", 0, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range 4 {
+		u, _ := s.CreateUser(fmt.Sprintf("u%d@globex.example", i), "U", t0)
+		if _, err := s.AddMember(o.ID, u.ID, RoleMember, t0); err != nil {
+			t.Fatal(err)
+		}
+	}
+	wantSeats(t, s, o.ID, SeatCount{Used: 4, Unlimited: true})
+
+	setPlan := func(p OrgPlan) error {
+		_, err := s.UpdateOrg(o.ID, func(o *Org) error { o.Plan = p; return nil })
+		return err
+	}
+	var sl *SeatLimitError
+	if err := setPlan(OrgFree); !errors.As(err, &sl) || sl.Limit != 3 || sl.Used != 4 {
+		t.Fatalf("business to free with 4 seats: %v", err)
+	}
+	if got, _ := s.Org(o.ID); got.Plan != OrgBusiness {
+		t.Fatalf("a refused plan change changed the plan to %s", got.Plan)
+	}
+	if err := setPlan(OrgTeam); err != nil {
+		t.Fatalf("business to team with 4 seats: %v", err)
+	}
+	wantSeats(t, s, o.ID, SeatCount{Used: 4, Limit: 10})
+	if err := setPlan(OrgBusiness); err != nil {
+		t.Fatal(err)
+	}
+	wantSeats(t, s, o.ID, SeatCount{Used: 4, Unlimited: true})
+}
