+// Several invites sent at once into the last free seat: exactly one succeeds.
+func TestSeatLimitUnderConcurrentInvites(t *testing.T) {
+	e := apitest.New(t)
+	org := e.NewOrg("Initech", store.OrgFree, "UTC")
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", org.Key, map[string]string{"email": "first@example.com", "role": "member"}, nil)
+
+	const senders = 8
+	codes := make(chan int, senders)
+	var wg sync.WaitGroup
+	for i := range senders {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			codes <- e.Do("POST", "/v1/invites", org.Key, map[string]string{"email": fmt.Sprintf("p%d@example.com", i), "role": "member"}).Code
+		}()
+	}
+	wg.Wait()
+	close(codes)
+	created, refused := 0, 0
+	for c := range codes {
+		switch c {
+		case http.StatusCreated:
+			created++
+		case http.StatusPaymentRequired:
+			refused++
+		default:
+			t.Fatalf("invite answered %d", c)
+		}
+	}
+	if created != 1 || refused != senders-1 {
+		t.Fatalf("%d created and %d refused; want 1 and %d", created, refused, senders-1)
+	}
+}
+
+func TestPlanDowngradeNeedsSeats(t *testing.T) {
+	e := apitest.New(t)
+	org := e.NewOrg("Hooli", store.OrgTeam, "UTC")
+	var third store.User
+	for i := range 3 {
+		u, _ := e.AddMember(org, fmt.Sprintf("m%d@hooli.example", i), store.RoleMember)
+		if i == 2 {
+			third = u
+		}
+	}
+	if used, limit := seatsOf(t, e, org.Key); used != 4 || *limit != 10 {
+		t.Fatalf("seats = %d of %d", used, *limit)
+	}
+
+	r := e.Do("PATCH", "/v1/org", org.Key, map[string]string{"plan": "free"})
+	if r.Code != http.StatusConflict {
+		t.Fatalf("downgrade with 4 seats in use: %s", r)
+	}
+	if body := r.Map(t); body["error"] != "over_seat_limit" || body["limit"] != float64(3) || body["used"] != float64(4) {
+		t.Fatalf("409 body = %v", body)
+	}
+	if used, limit := seatsOf(t, e, org.Key); used != 4 || *limit != 10 {
+		t.Fatalf("a refused downgrade changed the seats to %d of %d", used, *limit)
+	}
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+third.ID, org.Key, map[string]string{"role": "viewer"}, nil)
+	var o struct {
+		Plan string `json:"plan"`
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", org.Key, map[string]string{"plan": "free"}, &o)
+	if o.Plan != "free" {
+		t.Fatalf("plan = %s", o.Plan)
+	}
+	if used, limit := seatsOf(t, e, org.Key); used != 3 || *limit != 3 {
+		t.Fatalf("seats = %d of %d", used, *limit)
+	}
+}
