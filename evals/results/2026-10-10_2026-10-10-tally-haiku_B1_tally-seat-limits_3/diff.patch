+// seatsOf reads the "seats" of GET /v1/org.
+func seatsOf(t *testing.T, e *apitest.Env, key string) (used int, limit *int) {
+	t.Helper()
+	var o struct {
+		Seats struct {
+			Used  int  `json:"used"`
+			Limit *int `json:"limit"`
+		} `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", key, nil, &o)
+	return o.Seats.Used, o.Seats.Limit
+}
+
+// inviteToken is the token in the link of the last invitation emailed to address.
+func inviteToken(t *testing.T, e *apitest.Env, address string) string {
+	t.Helper()
+	msgs := e.Mail.Messages()
+	for i := len(msgs) - 1; i >= 0; i-- {
+		if m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[i].Body); msgs[i].To == address && m != nil {
+			token, _ := url.QueryUnescape(m[1])
+			return token
+		}
+	}
+	t.Fatalf("no invitation to %s", address)
+	return ""
+}
+
+func TestSeatLimits(t *testing.T) {
+	e := apitest.New(t)
+	org := e.NewOrg("Initech", store.OrgFree, "UTC")
+	if used, limit := seatsOf(t, e, org.Key); used != 1 || limit == nil || *limit != 3 {
+		t.Fatalf("seats = %d of %v", used, limit)
+	}
+
+	var ann, bob, viewer store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", org.Key, map[string]string{"email": "ann@example.com", "role": "member"}, &ann)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", org.Key, map[string]string{"email": "bob@example.com", "role": "admin"}, &bob)
+	r := e.Do("POST", "/v1/invites", org.Key, map[string]string{"email": "cy@example.com", "role": "billing"})
+	if r.Code != http.StatusPaymentRequired {
+		t.Fatalf("invite past the limit: %s", r)
+	}
+	body := r.Map(t)
+	if body["error"] != "seat_limit_reached" || body["limit"] != float64(3) || body["used"] != float64(3) {
+		t.Fatalf("402 body = %v", body)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", org.Key, map[string]string{"email": "vi@example.com", "role": "viewer"}, &viewer)
+	if used, _ := seatsOf(t, e, org.Key); used != 3 {
+		t.Fatalf("used = %d after the viewer invite", used)
+	}
+
+	// Accepting an invite holds no new seat: the seat was taken when the invite was sent. A viewer costs nothing.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": inviteToken(t, e, "ann@example.com"), "name": "Ann"}, nil)
+	var accepted struct {
+		Member struct {
+			UserID string `json:"user_id"`
+		} `json:"member"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": inviteToken(t, e, "vi@example.com"), "name": "Vi"}, &accepted)
+	viewerID := accepted.Member.UserID
+	if used, _ := seatsOf(t, e, org.Key); used != 3 {
+		t.Fatalf("used = %d after accepting", used)
+	}
+
+	// Owner, Ann and Bob's pending invite fill the plan, so the viewer may not become a seated role.
+	r = e.Do("PATCH", "/v1/members/"+viewerID, org.Key, map[string]string{"role": "member"})
+	if r.Code != http.StatusPaymentRequired || r.Map(t)["error"] != "seat_limit_reached" {
+		t.Fatalf("viewer to member with no free seat: %s", r)
+	}
+
+	// Revoking Bob's pending invite frees his seat for the viewer.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+bob.ID, org.Key, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+viewerID, org.Key, map[string]string{"role": "member"}, nil)
+	if used, _ := seatsOf(t, e, org.Key); used != 3 {
+		t.Fatalf("used = %d after the viewer took a seat", used)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+viewerID, org.Key, map[string]string{"role": "viewer"}, nil)
+	if used, _ := seatsOf(t, e, org.Key); used != 2 {
+		t.Fatalf("used = %d after the member became a viewer", used)
+	}
