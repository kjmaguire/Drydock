+// SeatLimitError is returned when a change needs a seat the organization's plan does not have, or when a plan change would
+// leave more seats in use than the new plan allows. Limit is the plan's limit and Used the seats in use.
+type SeatLimitError struct{ Limit, Used int }
+
+func (e *SeatLimitError) Error() string {
+	return fmt.Sprintf("the plan allows %d seats and %d are in use", e.Limit, e.Used)
+}
+
+// SeatCount is how many of an organization's seats are in use, and what its plan allows. Unlimited is set when the plan
+// allows any number of seats; Limit is then meaningless.
+type SeatCount struct {
+	Used      int
+	Limit     int
+	Unlimited bool
+}
+
+// HasFree reports whether one more seat can be taken.
+func (c SeatCount) HasFree() bool { return c.Unlimited || c.Used < c.Limit }
+
+// Fits reports whether the seats in use are within the plan's limit.
+func (c SeatCount) Fits() bool { return c.Unlimited || c.Used <= c.Limit }
