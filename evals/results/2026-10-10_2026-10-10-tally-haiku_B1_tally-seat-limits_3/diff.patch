+// Seats returns how many of an organization's seats are in use, and what its plan allows.
+func (s *Store) Seats(orgID string) (SeatCount, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	o, ok := s.orgs[orgID]
+	if !ok {
+		return SeatCount{}, false
+	}
