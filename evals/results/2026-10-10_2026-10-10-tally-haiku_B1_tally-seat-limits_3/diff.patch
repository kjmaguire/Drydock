+// Concurrent invites into the last free seat: exactly one may take it.
+func TestSeatLimitUnderConcurrency(t *testing.T) {
+	s, o, owner := seatTest(t)
+	if _, err := s.CreateInvite(o.ID, "first@example.com", RoleMember, owner.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+
+	const senders = 8
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	taken, refused := 0, 0
+	start := make(chan struct{})
+	for i := range senders {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			_, err := s.CreateInvite(o.ID, fmt.Sprintf("p%d@example.com", i), RoleAdmin, owner.ID, t0)
+			mu.Lock()
+			defer mu.Unlock()
+			var sl *SeatLimitError
+			switch {
+			case err == nil:
+				taken++
+			case errors.As(err, &sl):
+				refused++
+			default:
+				t.Errorf("invite: %v", err)
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	if taken != 1 || refused != senders-1 {
+		t.Fatalf("%d invites took the last seat and %d were refused; want 1 and %d", taken, refused, senders-1)
+	}
+	wantSeats(t, s, o.ID, SeatCount{Used: 3, Limit: 3})
+}
