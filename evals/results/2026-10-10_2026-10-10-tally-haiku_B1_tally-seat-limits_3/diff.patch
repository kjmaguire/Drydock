+
+// seatsLocked counts the seats in use by an organization: its members who are not viewers, and its pending invites
+// (neither accepted nor revoked) who are not viewers. Viewers are free. The caller holds the lock.
+func (s *Store) seatsLocked(o Org) SeatCount {
+	used := 0
+	for _, m := range s.members {
+		if m.OrgID == o.ID && m.Role != RoleViewer {
+			used++
+		}
+	}
+	for _, inv := range s.invites {
+		if inv.OrgID == o.ID && inv.AcceptedAt == nil && inv.RevokedAt == nil && inv.Role != RoleViewer {
+			used++
+		}
+	}
+	limit, limited := o.Plan.SeatLimit()
+	return SeatCount{Used: used, Limit: limit, Unlimited: !limited}
+}
