+		t.Fatal(err)
+	}
+	if _, err := s.SetMemberRole(o.ID, carl.ID, RoleViewer); err != nil {
+		t.Fatal(err)
+	}
+	wantSeats(t, s, o.ID, SeatCount{Used: 2, Limit: 3})
+	if _, err := s.CreateInvite(o.ID, "bob@example.com", RoleMember, owner.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+
+	var sl *SeatLimitError
+	if _, err := s.SetMemberRole(o.ID, carl.ID, RoleMember); !errors.As(err, &sl) || sl.Limit != 3 || sl.Used != 3 {
+		t.Fatalf("viewer to member with no free seat: %v", err)
+	}
+	if m, _ := s.Member(o.ID, carl.ID); m.Role != RoleViewer {
+		t.Fatalf("a refused change changed the role to %s", m.Role)
+	}
+}
