+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// changeActions are the actions whose entries carry "changes", even when no field changed.
+var changeActions = map[string]bool{
+	"customer.updated":         true,
+	"plan.updated":             true,
+	"subscription.updated":     true,
+	"member.role_changed":      true,
+	"webhook_endpoint.updated": true,
+	"org.updated":              true,
+}
+
+// audit records a change made by a request that succeeded. Call it before the response is written, so that a client that
+// reads the log after its answer finds the entry. changes is nil unless the action is in changeActions.
+func (s *Server) audit(r *http.Request, p auth.Principal, action, targetType, targetID string, changes map[string]store.AuditChange) {
+	s.store.AddAudit(store.AuditEntry{
+		OrgID:     p.OrgID,
+		Action:    action,
+		Actor:     store.AuditActor{Type: "api_key", ID: p.KeyID, UserID: p.UserID},
+		Target:    store.AuditTarget{Type: targetType, ID: targetID},
+		RequestID: RequestID(r.Context()),
+		At:        s.clock.Now(),
+		Changes:   changes,
+	})
+}
+
+// jsonObject returns v as its JSON object, without the secrets: API key tokens, endpoint signing secrets and invite
+// tokens never enter the audit log.
+func jsonObject(v any) map[string]any {
+	b, _ := json.Marshal(v)
+	var m map[string]any
+	_ = json.Unmarshal(b, &m)
+	delete(m, "secret")
+	delete(m, "token")
+	return m
+}
+
+// changesOf returns the fields whose value differs between before and after, by their JSON names.
+func changesOf(before, after map[string]any) map[string]store.AuditChange {
+	out := map[string]store.AuditChange{}
+	for k, b := range before {
+		if a := after[k]; !reflect.DeepEqual(a, b) {
+			out[k] = store.AuditChange{From: b, To: a}
+		}
+	}
+	for k, a := range after {
+		if _, ok := before[k]; !ok {
+			out[k] = store.AuditChange{To: a}
+		}
+	}
+	return out
+}
+
+// auditView is an audit entry as the API shows it.
+type auditView struct {
+	ID        string            `json:"id"`
+	Action    string            `json:"action"`
+	Actor     store.AuditActor  `json:"actor"`
+	Target    store.AuditTarget `json:"target"`
+	RequestID string            `json:"request_id"`
+	At        time.Time         `json:"at"`
+
+	// Changes is a pointer so that an empty object is still shown; omitempty drops it only when it is nil.
+	Changes *map[string]store.AuditChange `json:"changes,omitempty"`
+}
+
+func newAuditView(e store.AuditEntry) auditView {
+	v := auditView{ID: e.ID, Action: e.Action, Actor: e.Actor, Target: e.Target, RequestID: e.RequestID, At: e.At}
+	if changeActions[e.Action] {
+		c := e.Changes
+		if c == nil {
+			c = map[string]store.AuditChange{}
+		}
+		v.Changes = &c
+	}
+	return v
+}
+
+func auditKey(v auditView) cursor { return cursor{T: v.At, ID: v.ID} }
+
+// listAuditEvents lists the organization's audit entries, newest first, optionally only those of ?action=, ?target_id= or
+// ?actor_id= (an API key ID or a user ID). Only owners and admins may read them.
+func (s *Server) listAuditEvents(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	if !auth.CanManageTeam(p.Role) {
+		writeJSON(w, http.StatusForbidden, map[string]string{"error": "forbidden"})
+		return
+	}
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	q := r.URL.Query()
+	es := s.store.AuditEvents(p.OrgID, store.AuditFilter{Action: q.Get("action"), TargetID: q.Get("target_id"), ActorID: q.Get("actor_id")})
+	views := make([]auditView, 0, len(es))
+	for _, e := range es {
+		views = append(views, newAuditView(e))
+	}
+	items, next := pageNewestFirst(views, auditKey, pg)
+	writeJSON(w, http.StatusOK, list{Items: items, NextCursor: next})
+}
+
+// pageNewestFirst is pageOf for items sorted newest first: a page starts after the item with the cursor's key.
+func pageNewestFirst[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	start := 0
+	if p.after != nil {
+		start = len(items)
+		for i, it := range items {
+			if key(it).less(*p.after) {
+				start = i
+				break
+			}
+		}
+	}
+	end := min(start+p.limit, len(items))
+	out := items[start:end]
+	next := ""
+	if end < len(items) && len(out) > 0 {
+		next = encodeCursor(key(out[len(out)-1]))
+	}
+	return out, next
+}
