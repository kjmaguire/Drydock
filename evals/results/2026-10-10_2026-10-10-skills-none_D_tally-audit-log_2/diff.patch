+func TestAuditEventsAccess(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane Doe", "jane@acme.example")
+	_, admin := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	for _, role := range []store.Role{store.RoleViewer, store.RoleMember, store.RoleBilling} {
+		_, key := e.AddMember(e.Acme, string(role)+"@acme.example", role)
+		r := e.Do("GET", "/v1/audit-events", key, nil)
+		if r.Code != http.StatusForbidden || strings.TrimSpace(string(r.Body)) != `{"error":"forbidden"}` {
+			t.Fatalf("%s reads the log: %s", role, r)
+		}
+	}
+	if r := e.Do("GET", "/v1/audit-events", admin, nil); r.Code != http.StatusOK {
+		t.Fatalf("admin: %s", r)
+	}
+	if got := auditItems(t, e, e.Acme.Key, ""); len(got) != 1 {
+		t.Fatalf("owner sees %d entries", len(got))
+	}
+	if got := auditItems(t, e, e.Globex.Key, ""); len(got) != 0 {
+		t.Fatalf("another organization sees %d entries", len(got))
+	}
+	if r := e.Do("GET", "/v1/audit-events?limit=0", e.Acme.Key, nil); r.Code != http.StatusBadRequest {
+		t.Fatalf("bad limit: %s", r)
+	}
+}
+
+func TestFailedRequestsRecordNothing(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane Doe", "jane@acme.example")
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+
+	refuse(t, e, e.Acme.Key, http.StatusConflict, "POST", "/v1/customers", map[string]string{"name": "Jane 2", "email": "jane@acme.example"})
+	refuse(t, e, e.Acme.Key, http.StatusBadRequest, "POST", "/v1/customers", "{not json")
+	refuse(t, e, e.Acme.Key, http.StatusNotFound, "PATCH", "/v1/customers/cus_nope", map[string]string{"name": "X"})
+	refuse(t, e, e.Acme.Key, http.StatusNotFound, "DELETE", "/v1/customers/cus_nope", nil)
+	refuse(t, e, e.Acme.Key, http.StatusUnprocessableEntity, "PATCH", "/v1/customers/"+jane.ID, map[string]string{"email": "nope"})
+	refuse(t, e, viewer, http.StatusForbidden, "POST", "/v1/customers", map[string]string{"name": "Viewer", "email": "v@acme.example"})
+	refuse(t, e, e.Acme.Key, http.StatusNotFound, "PATCH", "/v1/webhook-endpoints/whe_nope", map[string]bool{"enabled": false})
+}
