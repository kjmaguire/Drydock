diff --git a/result/internal/store/audit.go b/result/internal/store/audit.go
new file mode 100644
index 0000000..4668f86
--- /dev/null
+++ b/result/internal/store/audit.go
@@ -0,0 +1,83 @@
+package store
+
+import (
+	"fmt"
+	"sort"
+	"time"
+)
+
+// AuditEntry records that a successful request changed something in an organization. Entries are only ever added.
+type AuditEntry struct {
+	ID        string                 `json:"id"`
+	OrgID     string                 `json:"org_id"`
+	Action    string                 `json:"action"` // for example "customer.updated"
+	Actor     AuditActor             `json:"actor"`
+	Target    AuditTarget            `json:"target"`
+	RequestID string                 `json:"request_id"`
+	At        time.Time              `json:"at"`
+	Changes   map[string]AuditChange `json:"changes"` // nil for actions that have no changes
+}
+
+// AuditActor is who made the change: the API key that made the request, and the member the key acts for.
+type AuditActor struct {
+	Type   string `json:"type"` // always "api_key"
+	ID     string `json:"id"`
+	UserID string `json:"user_id"`
+}
+
+// AuditTarget is the object that was changed.
+type AuditTarget struct {
+	Type string `json:"type"`
+	ID   string `json:"id"`
+}
+
+// AuditChange is one field's value before and after a change.
+type AuditChange struct {
+	From any `json:"from"`
+	To   any `json:"to"`
+}
+
+// AuditFilter narrows AuditEvents. An empty field matches everything.
+type AuditFilter struct {
+	Action   string
+	TargetID string
+	ActorID  string // an API key ID or a user ID
+}
+
+// AddAudit appends an entry to the audit log. Its ID is set here.
+func (s *Store) AddAudit(e AuditEntry) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e.ID = fmt.Sprintf("aud_%06d", len(s.audit)+1)
+	e.At = e.At.UTC()
+	s.audit = append(s.audit, e)
+}
+
+// AuditEvents returns an organization's audit entries that match f, newest first.
+func (s *Store) AuditEvents(orgID string, f AuditFilter) []AuditEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []AuditEntry{}
+	for _, e := range s.audit {
+		if e.OrgID != orgID {
+			continue
+		}
+		if f.Action != "" && e.Action != f.Action {
+			continue
+		}
+		if f.TargetID != "" && e.Target.ID != f.TargetID {
+			continue
+		}
+		if f.ActorID != "" && e.Actor.ID != f.ActorID && e.Actor.UserID != f.ActorID {
+			continue
+		}
+		out = append(out, e)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].At.Equal(out[j].At) {
+			return out[i].At.After(out[j].At)
+		}
+		return out[i].ID > out[j].ID
+	})
+	return out
+}
diff --git a/result/internal/store/audit_test.go b/result/internal/store/audit_test.go
new file mode 100644
index 0000000..41d13c1
--- /dev/null
+++ b/result/internal/store/audit_test.go
@@ -0,0 +1,41 @@
+package store
+
+import (
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestAuditEventsNewestFirstAndSurviveReload(t *testing.T) {
+	now := time.Date(2026, 3, 1, 9, 0, 0, 0, time.UTC)
+	st := New()
+	o, _ := st.CreateOrg("A", OrgTeam, "UTC", 0, now)
+	other, _ := st.CreateOrg("B", OrgTeam, "UTC", 0, now)
+	st.AddAudit(AuditEntry{OrgID: o.ID, Action: "customer.created", Actor: AuditActor{Type: "api_key", ID: "key_1", UserID: "usr_1"}, Target: AuditTarget{Type: "customer", ID: "cus_1"}, At: now})
+	st.AddAudit(AuditEntry{OrgID: o.ID, Action: "customer.updated", Actor: AuditActor{Type: "api_key", ID: "key_1", UserID: "usr_1"}, Target: AuditTarget{Type: "customer", ID: "cus_1"}, At: now.Add(time.Minute),
+		Changes: map[string]AuditChange{"name": {From: "A", To: "B"}}})
+	st.AddAudit(AuditEntry{OrgID: other.ID, Action: "customer.created", Target: AuditTarget{Type: "customer", ID: "cus_2"}, At: now.Add(2 * time.Minute)})
+
+	got := st.AuditEvents(o.ID, AuditFilter{})
+	if len(got) != 2 || got[0].Action != "customer.updated" || got[1].ID != "aud_000001" {
+		t.Fatalf("entries = %+v", got)
+	}
+	if n := len(st.AuditEvents(o.ID, AuditFilter{ActorID: "usr_1", TargetID: "cus_1"})); n != 2 {
+		t.Fatalf("filtered by actor user: %d entries", n)
+	}
+	if n := len(st.AuditEvents(o.ID, AuditFilter{Action: "customer.deleted"})); n != 0 {
+		t.Fatalf("filtered by action: %d entries", n)
+	}
+
+	reloaded, err := FromState(st.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(reloaded.AuditEvents(o.ID, AuditFilter{}), got) {
+		t.Fatal("the audit log changed across a reload")
+	}
+	st.AddAudit(AuditEntry{OrgID: o.ID, Action: "org.updated", At: now})
+	if id := st.AuditEvents(o.ID, AuditFilter{Action: "org.updated"})[0].ID; id != "aud_000004" {
+		t.Fatalf("entry after the last one has ID %s", id)
+	}
+}
