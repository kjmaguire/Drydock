+package api_test
+
+import (
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// auditItems returns the items of GET /v1/audit-events with the query, answered to the key.
+func auditItems(t *testing.T, e *apitest.Env, key, query string) []map[string]any {
+	t.Helper()
+	var body struct {
+		Items []map[string]any `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events"+query, key, nil, &body)
+	return body.Items
+}
+
+func auditCount(e *apitest.Env) int { return len(e.Store.AuditEvents(e.Acme.ID, store.AuditFilter{})) }
+
+// field returns the string at path in m, or "" when there is none.
+func field(m map[string]any, path ...string) string {
+	for _, k := range path[:len(path)-1] {
+		m, _ = m[k].(map[string]any)
+	}
+	s, _ := m[path[len(path)-1]].(string)
+	return s
+}
+
+// changesIn returns an entry's changes, by field name.
+func changesIn(m map[string]any) map[string]map[string]any {
+	out := map[string]map[string]any{}
+	c, _ := m["changes"].(map[string]any)
+	for k, v := range c {
+		out[k], _ = v.(map[string]any)
+	}
+	return out
+}
+
+func idOf(t *testing.T, r *apitest.Response) string {
+	t.Helper()
+	id, _ := r.Map(t)["id"].(string)
+	if id == "" {
+		t.Fatalf("no id in %s", r)
+	}
+	return id
+}
+
+// checkEntry checks what every entry of an Acme request must say: who acted, how, when, and whether it has changes.
+func checkEntry(t *testing.T, e *apitest.Env, entry map[string]any, action, targetType, requestID string) {
+	t.Helper()
+	k, _ := e.Store.APIKeyByToken(e.Acme.Key)
+	if field(entry, "action") != action || field(entry, "target", "type") != targetType || field(entry, "request_id") != requestID {
+		t.Fatalf("entry = %v; want action %s on %s, request %s", entry, action, targetType, requestID)
+	}
+	if field(entry, "actor", "type") != "api_key" || field(entry, "actor", "id") != k.ID || field(entry, "actor", "user_id") != e.Acme.Owner.ID {
+		t.Fatalf("actor = %v", entry["actor"])
+	}
+	if at, err := time.Parse(time.RFC3339Nano, field(entry, "at")); err != nil || !at.Equal(e.Clock.Now()) {
+		t.Fatalf("at = %v (%v); the clock says %v", entry["at"], err, e.Clock.Now())
+	}
+	_, hasChanges := entry["changes"]
+	wantChanges := strings.HasSuffix(action, ".updated") || action == "member.role_changed"
+	if hasChanges != wantChanges {
+		t.Fatalf("%s: changes present = %v", action, hasChanges)
+	}
+}
+
+// send makes one request as Acme's owner. It must answer want, and add exactly one entry for action on a target of
+// targetType, which it returns.
+func send(t *testing.T, e *apitest.Env, want int, method, path string, body any, action, targetType string) (*apitest.Response, map[string]any) {
+	t.Helper()
+	before := auditCount(e)
+	e.Clock.Advance(time.Minute)
+	requestID := "req-" + action
+	r := e.DoWith(method, path, e.Acme.Key, body, http.Header{"X-Request-Id": {requestID}})
+	if r.Code != want {
+		t.Fatalf("%s %s: want %d, got %s", method, path, want, r)
+	}
+	if n := auditCount(e) - before; n != 1 {
+		t.Fatalf("%s %s added %d entries, want 1", method, path, n)
+	}
+	entry := auditItems(t, e, e.Acme.Key, "?limit=1")[0]
+	checkEntry(t, e, entry, action, targetType, requestID)
+	return r, entry
+}
+
+// refuse makes one request that must fail and record nothing.
+func refuse(t *testing.T, e *apitest.Env, key string, want int, method, path string, body any) {
+	t.Helper()
+	before := auditCount(e)
+	if r := e.Do(method, path, key, body); r.Code != want {
+		t.Fatalf("%s %s: want %d, got %s", method, path, want, r)
+	}
+	if n := auditCount(e) - before; n != 0 {
+		t.Fatalf("%s %s failed but added %d entries", method, path, n)
+	}
+}
+
+func TestAuditLogRecordsEachSuccessfulChange(t *testing.T) {
+	e := apitest.New(t)
+	var secrets []string // must never appear in the log
+
+	_, jane := send(t, e, http.StatusCreated, "POST", "/v1/customers", map[string]string{"name": "Jane Doe", "email": "jane@acme.example"}, "customer.created", "customer")
+	janeID := field(jane, "target", "id")
+	_, upd := send(t, e, http.StatusOK, "PATCH", "/v1/customers/"+janeID, map[string]any{"name": "Jane Q. Doe", "metadata": map[string]string{"crm": "7"}}, "customer.updated", "customer")
+	if ch := changesIn(upd); len(ch) != 2 || ch["name"]["from"] != "Jane Doe" || ch["name"]["to"] != "Jane Q. Doe" || ch["metadata"]["from"] != nil {
+		t.Fatalf("changes = %v", upd["changes"])
+	}
+	_, noop := send(t, e, http.StatusOK, "PATCH", "/v1/customers/"+janeID, map[string]string{"name": "Jane Q. Doe"}, "customer.updated", "customer")
+	if ch := changesIn(noop); len(ch) != 0 {
+		t.Fatalf("a no-op update has changes %v", noop["changes"])
+	}
+	_, john := send(t, e, http.StatusCreated, "POST", "/v1/customers", map[string]string{"name": "John Roe", "email": "john@acme.example"}, "customer.created", "customer")
+	send(t, e, http.StatusNoContent, "DELETE", "/v1/customers/"+field(john, "target", "id"), nil, "customer.deleted", "customer")
+
+	r, _ := send(t, e, http.StatusCreated, "POST", "/v1/plans", map[string]string{"name": "Pro", "currency": "USD", "price": "10.00", "interval": "month", "usage_type": "licensed"}, "plan.created", "plan")
+	planID := idOf(t, r)
+
+	r, sub := send(t, e, http.StatusCreated, "POST", "/v1/subscriptions", map[string]any{"customer_id": janeID, "plan_id": planID, "quantity": 2}, "subscription.created", "subscription")
+	subID := field(sub, "target", "id")
+	_, sub = send(t, e, http.StatusOK, "PATCH", "/v1/subscriptions/"+subID, map[string]int{"quantity": 3}, "subscription.updated", "subscription")
+	if ch := changesIn(sub); len(ch) != 1 || ch["quantity"]["from"] != float64(2) || ch["quantity"]["to"] != float64(3) {
+		t.Fatalf("subscription changes = %v", sub["changes"])
+	}
+	_, plan := send(t, e, http.StatusOK, "PATCH", "/v1/plans/"+planID, map[string]any{"name": "Pro Plus", "active": false}, "plan.updated", "plan")
+	if ch := changesIn(plan); len(ch) != 2 || ch["name"]["to"] != "Pro Plus" || ch["active"]["from"] != true || ch["active"]["to"] != false {
+		t.Fatalf("plan changes = %v", plan["changes"])
+	}
+	send(t, e, http.StatusOK, "POST", "/v1/subscriptions/"+subID+"/cancel", nil, "subscription.canceled", "subscription")
+
+	r, _ = send(t, e, http.StatusCreated, "POST", "/v1/invoices", map[string]any{"customer_id": janeID, "currency": "USD", "lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 1000}}}, "invoice.created", "invoice")
+	inv1 := idOf(t, r)
+	send(t, e, http.StatusOK, "POST", "/v1/invoices/"+inv1+"/pay", map[string]string{"payment_method": "pm_card_visa"}, "invoice.paid", "invoice")
+	r, _ = send(t, e, http.StatusCreated, "POST", "/v1/invoices", map[string]any{"customer_id": janeID, "currency": "USD", "lines": []map[string]any{{"description": "Extra", "quantity": 1, "unit_amount": 500}}}, "invoice.created", "invoice")
+	inv2 := idOf(t, r)
+	refuse(t, e, e.Acme.Key, http.StatusPaymentRequired, "POST", "/v1/invoices/"+inv2+"/pay", map[string]string{"payment_method": "pm_card_declined"})
+	send(t, e, http.StatusOK, "POST", "/v1/invoices/"+inv2+"/void", nil, "invoice.voided", "invoice")
+	refuse(t, e, e.Acme.Key, http.StatusConflict, "POST", "/v1/invoices/"+inv2+"/pay", map[string]string{"payment_method": "pm_card_visa"})
+
+	r, _ = send(t, e, http.StatusCreated, "POST", "/v1/api-keys", map[string]string{"name": "ci"}, "api_key.created", "api_key")
+	ciKey := idOf(t, r)
+	secrets = append(secrets, r.Map(t)["token"].(string))
+	send(t, e, http.StatusNoContent, "DELETE", "/v1/api-keys/"+ciKey, nil, "api_key.revoked", "api_key")
+
+	r, _ = send(t, e, http.StatusCreated, "POST", "/v1/invites", map[string]string{"email": "ann@acme.example", "role": "member"}, "invite.created", "invite")
+	inviteID := idOf(t, r)
+	secrets = append(secrets, r.Map(t)["token"].(string))
+	send(t, e, http.StatusNoContent, "DELETE", "/v1/invites/"+inviteID, nil, "invite.revoked", "invite")
+
+	bob, bobKey := e.AddMember(e.Acme, "bob@acme.example", store.RoleMember)
+	secrets = append(secrets, bobKey)
+	_, role := send(t, e, http.StatusOK, "PATCH", "/v1/members/"+bob.ID, map[string]string{"role": "admin"}, "member.role_changed", "member")
+	if field(role, "target", "id") != bob.ID {
+		t.Fatalf("role change target = %v", role["target"])
+	}
+	if ch := changesIn(role); len(ch) != 1 || ch["role"]["from"] != "member" || ch["role"]["to"] != "admin" {
+		t.Fatalf("role changes = %v", role["changes"])
+	}
+	carl, _ := e.AddMember(e.Acme, "carl@acme.example", store.RoleMember)
+	send(t, e, http.StatusNoContent, "DELETE", "/v1/members/"+carl.ID, nil, "member.removed", "member")
+
+	_, org := send(t, e, http.StatusOK, "PATCH", "/v1/org", map[string]string{"name": "Acme Inc"}, "org.updated", "org")
+	if field(org, "target", "id") != e.Acme.ID || changesIn(org)["name"]["to"] != "Acme Inc" {
+		t.Fatalf("org entry = %v", org)
+	}
+
+	r, _ = send(t, e, http.StatusCreated, "POST", "/v1/webhook-endpoints", map[string]any{"url": "https://hooks.acme.example/hook", "events": []string{"*"}}, "webhook_endpoint.created", "webhook_endpoint")
+	epID := idOf(t, r)
+	secrets = append(secrets, r.Map(t)["secret"].(string))
+	_, ep := send(t, e, http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+epID, map[string]bool{"enabled": false}, "webhook_endpoint.updated", "webhook_endpoint")
+	if ch := changesIn(ep); len(ch) != 1 || ch["enabled"]["from"] != true || ch["enabled"]["to"] != false {
+		t.Fatalf("endpoint changes = %v", ep["changes"])
+	}
+	send(t, e, http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+epID, nil, "webhook_endpoint.deleted", "webhook_endpoint")
+
+	// Every kind in the task is recorded, and nothing else is.
+	want := []string{"customer.created", "customer.updated", "customer.deleted", "plan.created", "plan.updated",
+		"subscription.created", "subscription.updated", "subscription.canceled", "invoice.created", "invoice.paid", "invoice.voided",
+		"api_key.created", "api_key.revoked", "member.role_changed", "member.removed", "invite.created", "invite.revoked",
+		"webhook_endpoint.created", "webhook_endpoint.updated", "webhook_endpoint.deleted", "org.updated"}
+	items := auditItems(t, e, e.Acme.Key, "?limit=100")
+	seen := map[string]bool{}
+	for _, it := range items {
+		seen[field(it, "action")] = true
+	}
+	for _, a := range want {
+		if !seen[a] {
+			t.Errorf("no entry for %s", a)
+		}
+	}
+	if len(seen) != len(want) || len(items) != auditCount(e) {
+		t.Fatalf("%d actions and %d entries; want the %d kinds, one entry per request", len(seen), len(items), len(want))
+	}
+	// Newest first: the last request made is the first entry, and times never increase down the list.
+	if field(items[0], "action") != "webhook_endpoint.deleted" {
+		t.Fatalf("first entry is %s", field(items[0], "action"))
+	}
+	for i := 1; i < len(items); i++ {
+		if field(items[i], "at") > field(items[i-1], "at") {
+			t.Fatalf("entry %d is newer than the one before it", i)
+		}
+	}
+
+	// No secret appears anywhere in what the log says.
+	body := string(e.Do("GET", "/v1/audit-events?limit=100", e.Acme.Key, nil).Body)
+	secrets = append(secrets, e.Acme.Key)
+	for _, s := range secrets {
+		if s == "" || strings.Contains(body, s) {
+			t.Fatalf("the log shows a secret (or the secret is missing from the test): %q", s)
+		}
+	}
+	if strings.Contains(body, `"token"`) || strings.Contains(body, `"secret"`) {
+		t.Fatal("the log has a token or secret field")
+	}
+}
+
+func TestAuditEventsFiltersAndPaging(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane Doe", "jane@acme.example")
+	john := e.CreateCustomer(e.Acme, "John Roe", "john@acme.example")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+jane.ID, e.Acme.Key, map[string]string{"name": "Jane Q"}, nil)
+
+	if got := auditItems(t, e, e.Acme.Key, "?action=customer.created"); len(got) != 2 {
+		t.Fatalf("by action: %d entries", len(got))
+	}
+	if got := auditItems(t, e, e.Acme.Key, "?target_id="+jane.ID); len(got) != 2 || field(got[0], "action") != "customer.updated" {
+		t.Fatalf("by target: %v", got)
+	}
+	if got := auditItems(t, e, e.Acme.Key, "?target_id="+john.ID+"&action=customer.updated"); len(got) != 0 {
+		t.Fatalf("by target and action: %v", got)
+	}
+	k, _ := e.Store.APIKeyByToken(e.Acme.Key)
+	for _, actor := range []string{k.ID, e.Acme.Owner.ID} {
+		if got := auditItems(t, e, e.Acme.Key, "?actor_id="+actor); len(got) != 3 {
+			t.Fatalf("by actor %s: %d entries", actor, len(got))
+		}
+	}
+	if got := auditItems(t, e, e.Acme.Key, "?actor_id=key_nope"); len(got) != 0 {
+		t.Fatalf("unknown actor: %v", got)
+	}
+
+	// Walk the log two at a time: the pages add up to the whole log, in the same order, with no repeats.
+	all := auditItems(t, e, e.Acme.Key, "")
+	var walked []string
+	query := "?limit=2"
+	for {
+		var page struct {
+			Items      []map[string]any `json:"items"`
+			NextCursor string           `json:"next_cursor"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/audit-events"+query, e.Acme.Key, nil, &page)
+		for _, it := range page.Items {
+			walked = append(walked, field(it, "id"))
+		}
+		if page.NextCursor == "" {
+			break
+		}
+		query = "?limit=2&cursor=" + url.QueryEscape(page.NextCursor)
+	}
+	if len(walked) != len(all) {
+		t.Fatalf("paged %d entries, the log has %d", len(walked), len(all))
+	}
+	for i, it := range all {
+		if walked[i] != field(it, "id") {
+			t.Fatalf("page order differs at %d", i)
+		}
+	}
+}
