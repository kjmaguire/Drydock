+func TestDeliveryRefusesNonPublicAddress(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	now := e.Clock.Now()
+	ep, err := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/all", Events: []string{"*"}, Secret: "whsec_a", Enabled: true}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The name resolved to a public address when the URL was saved; it now points into the organization's network.
+	e.DNS.Set("hooks.acme.example", "10.0.0.7")
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v", n, err)
+	}
+	if reqs := e.HTTP.Requests(); len(reqs) != 0 {
+		t.Fatalf("a request was sent to a non-public address: %+v", reqs)
+	}
+	ds := e.Store.Deliveries(e.Acme.ID, ep.ID)
+	if len(ds) != 1 || ds[0].Status != store.DeliveryFailed || ds[0].Attempts != 1 || !strings.Contains(ds[0].Error, "not public") {
+		t.Fatalf("deliveries = %+v", ds)
+	}
+	got, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if got.URL != ep.URL || !got.Enabled {
+		t.Fatalf("endpoint changed: %+v", got)
+	}
+
+	// Back to a public address: the same endpoint is delivered to again.
+	e.DNS.Set("hooks.acme.example", "93.184.216.34")
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_2"})
+	if n, _ := e.Webhooks.RunDue(ctx); n != 1 || len(e.HTTP.Requests()) != 1 {
+		t.Fatalf("RunDue = %d, requests = %d", n, len(e.HTTP.Requests()))
+	}
+}
