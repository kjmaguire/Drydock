+// checkEndpointAddr returns an error unless the endpoint's host currently resolves only to public addresses.
+func (s *Service) checkEndpointAddr(ctx context.Context, raw string) error {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return fmt.Errorf("the endpoint's URL is invalid: %v", err)
+	}
+	addrs, err := s.hostAddrs(ctx, u.Hostname())
+	if err != nil {
+		return fmt.Errorf("the endpoint's host does not resolve: %v", err)
+	}
+	for _, a := range addrs {
+		if !isPublic(a) {
+			return fmt.Errorf("the endpoint's address is not public: %q resolves to %s", u.Hostname(), a.WithZone(""))
+		}
+	}
+	return nil
+}
