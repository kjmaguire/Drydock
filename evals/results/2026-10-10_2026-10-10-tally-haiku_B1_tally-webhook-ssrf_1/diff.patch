+	netip.MustParsePrefix("::/128"),             // unspecified
+	netip.MustParsePrefix("::1/128"),            // loopback
+	netip.MustParsePrefix("fc00::/7"),           // unique local (private)
+	netip.MustParsePrefix("fe80::/10"),          // link-local
+	netip.MustParsePrefix("ff00::/8"),           // multicast
+}
+
+// isPublic reports whether ip is a public address. An IPv4 address written as IPv6 is judged as the IPv4 address it holds.
+func isPublic(ip netip.Addr) bool {
+	ip = ip.WithZone("").Unmap()
+	if !ip.IsValid() {
+		return false
+	}
+	for _, p := range notPublic {
+		if p.Contains(ip) {
+			return false
+		}
+	}
+	return true
+}
+
+// hostAddrs returns the addresses host stands for: host itself when it is an IP address, otherwise every address the
+// Resolver finds for it.
+func (s *Service) hostAddrs(ctx context.Context, host string) ([]netip.Addr, error) {
+	if ip, err := netip.ParseAddr(host); err == nil {
+		return []netip.Addr{ip}, nil
+	}
+	addrs, err := s.resolver.LookupIPAddr(ctx, host)
+	if err != nil || len(addrs) == 0 {
+		return nil, fmt.Errorf("the host %q does not resolve", host)
+	}
+	out := make([]netip.Addr, 0, len(addrs))
+	for _, a := range addrs {
+		ip, ok := netip.AddrFromSlice(a.IP)
+		if !ok {
+			return nil, fmt.Errorf("the host %q resolves to an invalid address", host)
+		}
+		out = append(out, ip)
+	}
+	return out, nil
+}
