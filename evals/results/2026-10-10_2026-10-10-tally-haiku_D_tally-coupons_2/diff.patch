diff --git a/result/internal/store/coupons.go b/result/internal/store/coupons.go
new file mode 100644
index 0000000..16704c3
--- /dev/null
+++ b/result/internal/store/coupons.go
@@ -0,0 +1,167 @@
+package store
+
+import (
+	"sort"
+	"strings"
+	"time"
+)
+
+// couponKey finds a coupon by its organization and its code, ignoring case.
+type couponKey struct{ org, code string }
+
+func normCode(code string) string { return strings.ToLower(code) }
+
+func copyCoupon(c Coupon) Coupon {
+	if c.RedeemBy != nil {
+		t := *c.RedeemBy
+		c.RedeemBy = &t
+	}
+	return c
+}
+
+// validCode reports whether code is 3 to 32 letters, digits, dashes or underscores.
+func validCode(code string) bool {
+	if len(code) < 3 || len(code) > 32 {
+		return false
+	}
+	for _, r := range code {
+		if !(r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-' || r == '_') {
+			return false
+		}
+	}
+	return true
+}
+
+func checkCoupon(c Coupon) error {
+	if !validCode(c.Code) {
+		return invalid("a coupon code is 3 to 32 letters, digits, dashes or underscores")
+	}
+	percent, amount := c.PercentOff != 0, c.AmountOff != 0
+	switch {
+	case percent == amount:
+		return invalid("a coupon takes a percentage off or an amount off, not both")
+	case percent && (c.PercentOff < 1 || c.PercentOff > 100):
+		return invalid("a percentage off is 1 to 100")
+	case amount && c.AmountOff < 0:
+		return invalid("an amount off cannot be negative")
+	case amount && !c.Currency.Valid():
+		return invalid("unknown currency %q", c.Currency)
+	}
+	switch c.Duration {
+	case CouponOnce, CouponForever:
+		if c.DurationInMonths != 0 {
+			return invalid("only a repeating coupon has a duration in months")
+		}
+	case CouponRepeating:
+		if c.DurationInMonths < 1 || c.DurationInMonths > 36 {
+			return invalid("a repeating coupon lasts 1 to 36 months")
+		}
+	default:
+		return invalid("a coupon's duration is once, repeating or forever")
+	}
+	if c.MaxRedemptions < 0 {
+		return invalid("max redemptions is at least 1")
+	}
+	return nil
+}
+
+// CreateCoupon adds a coupon. Its code is unique in its organization, ignoring case.
+func (s *Store) CreateCoupon(c Coupon, now time.Time) (Coupon, error) {
+	if err := checkCoupon(c); err != nil {
+		return Coupon{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[c.OrgID]; !ok {
+		return Coupon{}, ErrNotFound
+	}
+	if _, ok := s.couponsByCode[couponKey{c.OrgID, normCode(c.Code)}]; ok {
+		return Coupon{}, ErrCodeTaken
+	}
+	c.ID = s.newID("cou")
+	c.CreatedAt = now.UTC()
+	s.coupons[c.ID] = copyCoupon(c)
+	s.couponsByCode[couponKey{c.OrgID, normCode(c.Code)}] = c.ID
+	return copyCoupon(c), nil
+}
+
+// CouponByCode finds one of an organization's coupons by its code, ignoring case.
+func (s *Store) CouponByCode(orgID, code string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	id, ok := s.couponsByCode[couponKey{orgID, normCode(code)}]
+	if !ok {
+		return Coupon{}, false
+	}
+	return copyCoupon(s.coupons[id]), true
+}
+
+// Coupons returns an organization's coupons, oldest first.
+func (s *Store) Coupons(orgID string) []Coupon {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Coupon{}
+	for _, c := range s.coupons {
+		if c.OrgID == orgID {
+			out = append(out, copyCoupon(c))
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// CouponRedemptions counts the subscriptions that hold a coupon.
+func (s *Store) CouponRedemptions(orgID, code string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.couponRedemptionsLocked(orgID, code)
+}
+
+func (s *Store) couponRedemptionsLocked(orgID, code string) int {
+	n := 0
+	for _, sub := range s.subs {
+		if sub.OrgID == orgID && sub.Coupon != "" && normCode(sub.Coupon) == normCode(code) {
+			n++
+		}
+	}
+	return n
+}
+
+// RedeemCoupon applies one of the organization's coupons to a subscription at now. The subscription must not be canceled
+// or already hold a coupon, the coupon must not be past its redeem-by time, have no redemptions left, or (for an amount)
+// be in the plan's currency. The checks and the change happen under one lock, so a limit is never exceeded.
+func (s *Store) RedeemCoupon(orgID, subID, code string, now time.Time) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	sub, ok := s.subs[subID]
+	if !ok || sub.OrgID != orgID {
+		return Subscription{}, ErrNotFound
+	}
+	id, ok := s.couponsByCode[couponKey{orgID, normCode(code)}]
+	if !ok {
+		return Subscription{}, ErrNotFound
+	}
+	c := s.coupons[id]
+	switch {
+	case sub.Status == Canceled:
+		return Subscription{}, ErrSubscriptionCanceled
+	case sub.Coupon != "":
+		return Subscription{}, ErrCouponAlreadyApplied
+	case c.RedeemBy != nil && now.After(*c.RedeemBy):
+		return Subscription{}, ErrCouponExpired
+	case c.MaxRedemptions > 0 && s.couponRedemptionsLocked(orgID, c.Code) >= c.MaxRedemptions:
+		return Subscription{}, ErrCouponExhausted
+	case c.AmountOff != 0 && s.plans[sub.PlanID].Currency != c.Currency:
+		return Subscription{}, ErrCurrencyMismatch
+	}
+	sub.Coupon = c.Code
+	t := now.UTC()
+	sub.CouponRedeemedAt = &t
+	s.subs[subID] = sub
+	return copySub(sub), nil
+}
