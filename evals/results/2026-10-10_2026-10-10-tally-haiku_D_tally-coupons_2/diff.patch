+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+// couponView is a coupon as the API shows it: with how many subscriptions hold it.
+type couponView struct {
+	store.Coupon
+	TimesRedeemed int `json:"times_redeemed"`
+}
+
+func (s *Server) viewCoupon(c store.Coupon) couponView {
+	return couponView{Coupon: c, TimesRedeemed: s.store.CouponRedemptions(c.OrgID, c.Code)}
+}
+
+func couponViewKey(v couponView) cursor { return cursor{T: v.CreatedAt, ID: v.ID} }
+
+// listCoupons lists the organization's coupons, oldest first.
+func (s *Server) listCoupons(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	cs := s.store.Coupons(p.OrgID)
+	views := make([]couponView, 0, len(cs))
+	for _, c := range cs {
+		views = append(views, s.viewCoupon(c))
+	}
+	items, next := pageOf(views, couponViewKey, pg)
+	writeJSON(w, http.StatusOK, list{Items: items, NextCursor: next})
+}
+
+// createCoupon adds a coupon. Exactly one of percent_off (1 to 100) and amount_off (a string of major units, in currency)
+// is set. duration_in_months is required for a repeating coupon and refused otherwise.
+func (s *Server) createCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in struct {
+		Code             string               `json:"code"`
+		PercentOff       *int                 `json:"percent_off"`
+		AmountOff        *string              `json:"amount_off"`
+		Currency         money.Currency       `json:"currency"`
+		Duration         store.CouponDuration `json:"duration"`
+		DurationInMonths *int                 `json:"duration_in_months"`
+		MaxRedemptions   *int                 `json:"max_redemptions"`
+		RedeemBy         *string              `json:"redeem_by"`
+	}
+	if err := decodeBody(r, &in); err != nil {
+		// A field of the wrong JSON type is an invalid coupon; only malformed JSON is a bad request.
+		var typeErr *json.UnmarshalTypeError
+		if errors.As(err, &typeErr) {
+			writeError(w, http.StatusUnprocessableEntity, "invalid", "the "+typeErr.Field+" field has the wrong type")
+			return
+		}
+		writeError(w, http.StatusBadRequest, "invalid_json", "the body is not valid JSON: "+err.Error())
+		return
+	}
+	c := store.Coupon{OrgID: p.OrgID, Code: in.Code, Duration: in.Duration}
+	switch {
+	case in.PercentOff != nil && in.AmountOff != nil:
+		writeError(w, http.StatusUnprocessableEntity, "invalid", "a coupon takes percent_off or amount_off, not both")
+		return
+	case in.PercentOff != nil:
+		c.PercentOff = *in.PercentOff
+	case in.AmountOff != nil:
+		amount, err := money.ParseMajor(*in.AmountOff, in.Currency)
+		if err != nil {
+			writeError(w, http.StatusUnprocessableEntity, "invalid", "amount_off is an amount in the currency, such as \"12.50\"")
+			return
+		}
+		c.AmountOff, c.Currency = amount, in.Currency
+	default:
+		writeError(w, http.StatusUnprocessableEntity, "invalid", "a coupon takes percent_off or amount_off")
+		return
+	}
+	if in.DurationInMonths != nil {
+		if in.Duration != store.CouponRepeating {
+			writeError(w, http.StatusUnprocessableEntity, "invalid", "only a repeating coupon has duration_in_months")
+			return
+		}
+		c.DurationInMonths = *in.DurationInMonths
+	}
+	if in.MaxRedemptions != nil {
+		if *in.MaxRedemptions < 1 {
+			writeError(w, http.StatusUnprocessableEntity, "invalid", "max_redemptions is at least 1")
+			return
+		}
+		c.MaxRedemptions = *in.MaxRedemptions
+	}
+	if in.RedeemBy != nil {
+		t, err := time.Parse(time.RFC3339, *in.RedeemBy)
+		if err != nil {
+			writeError(w, http.StatusUnprocessableEntity, "invalid", "redeem_by is an RFC 3339 time")
+			return
+		}
+		c.RedeemBy = &t
+	}
+	created, err := s.store.CreateCoupon(c, s.clock.Now())
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusCreated, s.viewCoupon(created))
+}
+
+// getCoupon finds one of the organization's coupons by its code, ignoring case.
+func (s *Server) getCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	c, ok := s.store.CouponByCode(p.OrgID, r.PathValue("code"))
+	if !ok {
+		writeError(w, http.StatusNotFound, "not_found", "no such coupon")
+		return
+	}
+	writeJSON(w, http.StatusOK, s.viewCoupon(c))
+}
+
+// applyCoupon applies a coupon to a subscription: {"code": "..."}.
+func (s *Server) applyCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in struct {
+		Code string `json:"code"`
+	}
+	if !decode(w, r, &in) {
+		return
+	}
+	if in.Code == "" {
+		writeError(w, http.StatusUnprocessableEntity, "invalid", "send the coupon's code")
+		return
+	}
+	sub, err := s.subs.ApplyCoupon(r.Context(), p.OrgID, r.PathValue("id"), in.Code)
+	switch {
+	case errors.Is(err, store.ErrCouponAlreadyApplied):
+		writeError(w, http.StatusConflict, "coupon_already_applied", err.Error())
+	case errors.Is(err, store.ErrCouponExpired):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_expired", err.Error())
+	case errors.Is(err, store.ErrCouponExhausted):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_exhausted", err.Error())
+	case errors.Is(err, store.ErrCurrencyMismatch):
+		writeError(w, http.StatusUnprocessableEntity, "currency_mismatch", err.Error())
+	case err != nil:
+		s.subError(w, err)
+	default:
+		writeJSON(w, http.StatusOK, sub)
+	}
+}
