+// couponFor returns the coupon that discounts the invoice of the period starting at start, if the subscription's coupon
+// applies to it. A once coupon applies to the first invoice created after it was applied, a repeating coupon to the
+// periods starting less than its duration after it was applied, and a forever coupon to every invoice created after it
+// was applied. Invoices are only created after the coupon is applied, so they need no check on creation time.
+func (s *Service) couponFor(sub store.Subscription, start time.Time) (store.Coupon, bool) {
+	cur, ok := s.Store.Subscription(sub.OrgID, sub.ID)
+	if !ok || cur.Coupon == "" || cur.CouponRedeemedAt == nil {
+		return store.Coupon{}, false
+	}
+	c, ok := s.Store.CouponByCode(sub.OrgID, cur.Coupon)
+	if !ok {
+		return store.Coupon{}, false
+	}
+	switch c.Duration {
+	case store.CouponOnce:
+		// Only an invoice made after the coupon was applied carries its code, so one that exists is the first.
+		for _, inv := range s.Store.ListInvoices(sub.OrgID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+			if inv.Coupon == c.Code {
+				return store.Coupon{}, false
+			}
+		}
+	case store.CouponRepeating:
+		if !start.Before(cur.CouponRedeemedAt.AddDate(0, c.DurationInMonths, 0)) {
+			return store.Coupon{}, false
+		}
+	}
+	return c, true
+}
