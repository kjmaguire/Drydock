+package api_test
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/billing"
+	"example.com/tally/internal/store"
+)
+
+type couponJSON struct {
+	store.Coupon
+	TimesRedeemed int `json:"times_redeemed"`
+}
+
+type invoiceJSON struct {
+	store.Invoice
+	billing.Totals
+}
+
+func createCoupon(t *testing.T, e *apitest.Env, body map[string]any) couponJSON {
+	t.Helper()
+	var c couponJSON
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, body, &c)
+	return c
+}
+
+func subscribe(t *testing.T, e *apitest.Env, plan store.Plan, email string, extra map[string]any) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", email)
+	body := map[string]any{"customer_id": c.ID, "plan_id": plan.ID}
+	for k, v := range extra {
+		body[k] = v
+	}
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, body, &sub)
+	return sub
+}
+
+func applyCoupon(e *apitest.Env, subID, code string) *apitest.Response {
+	return e.Do("POST", "/v1/subscriptions/"+subID+"/coupon", e.Acme.Key, map[string]string{"code": code})
+}
+
+// renewAt moves the clock to the end of the subscription's period and renews every subscription due then.
+func renewAt(t *testing.T, e *apitest.Env, sub store.Subscription) store.Subscription {
+	t.Helper()
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(context.Background()); err != nil {
+		t.Fatalf("RenewDue: %v", err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	return got
+}
+
+// invoicesOf returns the subscription's invoices, oldest first.
+func invoicesOf(t *testing.T, e *apitest.Env, subID string) []invoiceJSON {
+	t.Helper()
+	var page struct {
+		Items []invoiceJSON `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+subID, e.Acme.Key, nil, &page)
+	return page.Items
+}
+
+func TestCouponCreation(t *testing.T) {
+	e := apitest.New(t)
+	c := createCoupon(t, e, map[string]any{"code": "Off-12_50", "amount_off": "12.50", "currency": "USD", "duration": "once"})
+	if c.AmountOff != 1250 || c.Currency != "USD" || c.PercentOff != 0 || c.Duration != store.CouponOnce || c.TimesRedeemed != 0 {
+		t.Fatalf("coupon = %+v", c)
+	}
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "off-12_50", "percent_off": 5, "duration": "once"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "code_taken" {
+		t.Fatalf("duplicate code: %s", r)
+	}
+	if r := e.Do("POST", "/v1/coupons", e.Globex.Key, map[string]any{"code": "Off-12_50", "percent_off": 5, "duration": "once"}); r.Code != http.StatusCreated {
+		t.Fatalf("the same code in another organization: %s", r)
+	}
+
+	bad := []map[string]any{
+		{"code": "ABC", "percent_off": 10, "amount_off": "1.00", "currency": "USD", "duration": "once"},
+		{"code": "ABC", "duration": "once"},
+		{"code": "ABC", "percent_off": 0, "duration": "once"},
+		{"code": "ABC", "percent_off": 101, "duration": "once"},
+		{"code": "AB", "percent_off": 10, "duration": "once"},
+		{"code": "has space", "percent_off": 10, "duration": "once"},
+		{"code": "ABC", "percent_off": 10, "duration": "weekly"},
+		{"code": "ABC", "percent_off": 10, "duration": "repeating"},
+		{"code": "ABC", "percent_off": 10, "duration": "repeating", "duration_in_months": 37},
+		{"code": "ABC", "percent_off": 10, "duration": "forever", "duration_in_months": 3},
+		{"code": "ABC", "percent_off": 10, "duration": "once", "max_redemptions": 0},
+		{"code": "ABC", "percent_off": 10, "duration": "once", "redeem_by": "tomorrow"},
+		{"code": "ABC", "amount_off": "abc", "currency": "USD", "duration": "once"},
+		{"code": "ABC", "amount_off": "0", "currency": "USD", "duration": "once"},
+		{"code": "ABC", "amount_off": "1.00", "currency": "XXX", "duration": "once"},
+		{"code": "ABC", "percent_off": "10", "duration": "once"},
+		{"code": "ABC", "percent_off": 10.5, "duration": "once"},
+		{"code": "ABC", "amount_off": 12.5, "currency": "USD", "duration": "once"},
+		{"code": "ABC", "percent_off": 10, "duration": "once", "max_redemptions": "5"},
+	}
+	for _, body := range bad {
+		if r := e.Do("POST", "/v1/coupons", e.Acme.Key, body); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid" {
+			t.Fatalf("%v: %s", body, r)
+		}
+	}
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, "{not json"); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_json" {
+		t.Fatalf("malformed JSON: %s", r)
+	}
+}
+
+func TestCouponLookup(t *testing.T) {
+	e := apitest.New(t)
+	createCoupon(t, e, map[string]any{"code": "SPRING", "percent_off": 10, "duration": "forever"})
+	e.Clock.Advance(time.Minute)
+	createCoupon(t, e, map[string]any{"code": "SUMMER", "percent_off": 20, "duration": "repeating", "duration_in_months": 3})
+
+	var page struct {
+		Items []couponJSON `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons", e.Acme.Key, nil, &page)
+	if len(page.Items) != 2 || page.Items[0].Code != "SPRING" || page.Items[1].Code != "SUMMER" || page.Items[1].DurationInMonths != 3 {
+		t.Fatalf("list = %+v", page.Items)
+	}
+	var got couponJSON
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/spring", e.Acme.Key, nil, &got)
+	if got.Code != "SPRING" || got.PercentOff != 10 {
+		t.Fatalf("get = %+v", got)
+	}
+	if r := e.Do("GET", "/v1/coupons/SPRING", e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("another organization's coupon: %s", r)
+	}
+	if r := e.Do("GET", "/v1/coupons/NOPE", e.Acme.Key, nil); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("unknown coupon: %s", r)
+	}
+}
+
+func TestApplyCouponRefusals(t *testing.T) {
+	e := apitest.New(t)
+	plan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	createCoupon(t, e, map[string]any{"code": "FIRST", "percent_off": 10, "duration": "forever", "max_redemptions": 1})
+	createCoupon(t, e, map[string]any{"code": "OLD", "percent_off": 10, "duration": "once", "redeem_by": e.Clock.Now().Add(-time.Hour).Format(time.RFC3339)})
+	createCoupon(t, e, map[string]any{"code": "EURO", "amount_off": "5.00", "currency": "EUR", "duration": "once"})
+	createCoupon(t, e, map[string]any{"code": "TWICE", "percent_off": 10, "duration": "once"})
+
+	first := subscribe(t, e, plan, "a@example.com", nil)
+	second := subscribe(t, e, plan, "b@example.com", nil)
+	canceled := subscribe(t, e, plan, "c@example.com", nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+canceled.ID+"/cancel", e.Acme.Key, nil, nil)
+
+	cases := []struct {
+		sub, code string
+		status    int
+		errCode   string
+	}{
+		{first.ID, "NOPE", http.StatusNotFound, "not_found"},
+		{first.ID, "OLD", http.StatusUnprocessableEntity, "coupon_expired"},
+		{first.ID, "EURO", http.StatusUnprocessableEntity, "currency_mismatch"},
+		{canceled.ID, "TWICE", http.StatusConflict, "subscription_canceled"},
+	}
+	for _, c := range cases {
+		if r := applyCoupon(e, c.sub, c.code); r.Code != c.status || r.Map(t)["error"] != c.errCode {
+			t.Fatalf("apply %s: %s", c.code, r)
+		}
+	}
+
+	var got store.Subscription
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+first.ID+"/coupon", e.Acme.Key, map[string]string{"code": "first"}, &got)
+	if got.Coupon != "FIRST" || got.CouponRedeemedAt == nil {
+		t.Fatalf("applied = %+v", got)
+	}
+	if r := applyCoupon(e, second.ID, "FIRST"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_exhausted" {
+		t.Fatalf("second redemption: %s", r)
+	}
+	if r := applyCoupon(e, first.ID, "TWICE"); r.Code != http.StatusConflict || r.Map(t)["error"] != "coupon_already_applied" {
+		t.Fatalf("second coupon: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions/sub_missing/coupon", e.Acme.Key, map[string]string{"code": "TWICE"}); r.Code != http.StatusNotFound {
+		t.Fatalf("unknown subscription: %s", r)
+	}
+	var c couponJSON
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/first", e.Acme.Key, nil, &c)
+	if c.TimesRedeemed != 1 {
+		t.Fatalf("times_redeemed = %d", c.TimesRedeemed)
+	}
+}
+
+func TestOnceCouponDiscountsOnlyTheNextInvoice(t *testing.T) {
+	e := apitest.New(t)
+	plan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	createCoupon(t, e, map[string]any{"code": "WELCOME25", "percent_off": 25, "duration": "once"})
+	sub := subscribe(t, e, plan, "jane@example.com", nil)
+	if r := applyCoupon(e, sub.ID, "welcome25"); r.Code != http.StatusOK {
+		t.Fatalf("apply: %s", r)
+	}
+	sub = renewAt(t, e, sub)
+	renewAt(t, e, sub)
+
+	invs := invoicesOf(t, e, sub.ID)
+	if len(invs) != 3 {
+		t.Fatalf("invoices = %d", len(invs))
+	}
+	if invs[0].Coupon != "" || invs[0].Discount != 0 {
+		t.Fatalf("invoice before the coupon = %+v", invs[0])
+	}
+	if invs[1].Coupon != "WELCOME25" || invs[1].Subtotal != 2000 || invs[1].Discount != 500 {
+		t.Fatalf("first invoice with the coupon = %+v", invs[1])
+	}
+	if invs[2].Coupon != "" || invs[2].Discount != 0 {
+		t.Fatalf("second invoice with the coupon = %+v", invs[2])
+	}
+}
+
+func TestRepeatingCouponStopsAfterItsMonths(t *testing.T) {
+	e := apitest.New(t)
+	plan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	createCoupon(t, e, map[string]any{"code": "TWOMONTHS", "percent_off": 10, "duration": "repeating", "duration_in_months": 2})
+	sub := subscribe(t, e, plan, "jane@example.com", nil)
+	applyCoupon(e, sub.ID, "TWOMONTHS")
+	for range 3 {
+		sub = renewAt(t, e, sub)
+	}
+
+	invs := invoicesOf(t, e, sub.ID)
+	if len(invs) != 4 {
+		t.Fatalf("invoices = %d", len(invs))
+	}
+	// The first invoice was made before the coupon was applied. The renewals' periods start one, two and three months
+	// after the redemption, and only the first of them starts less than two months after it.
+	for i, want := range []int64{0, 200, 0, 0} {
+		if invs[i].Discount != want {
+			t.Errorf("invoice %d discount = %d, want %d (%+v)", i, invs[i].Discount, want, invs[i])
+		}
+	}
+}
+
+func TestForeverAndAmountCoupons(t *testing.T) {
+	e := apitest.New(t)
+	plan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	createCoupon(t, e, map[string]any{"code": "FOREVER10", "percent_off": 10, "duration": "forever"})
+	createCoupon(t, e, map[string]any{"code": "FIVE", "amount_off": "5.00", "currency": "USD", "duration": "forever"})
+	createCoupon(t, e, map[string]any{"code": "BIG", "amount_off": "50.00", "currency": "USD", "duration": "once"})
+
+	forever := subscribe(t, e, plan, "a@example.com", nil)
+	applyCoupon(e, forever.ID, "FOREVER10")
+	five := subscribe(t, e, plan, "b@example.com", nil)
+	applyCoupon(e, five.ID, "FIVE")
+	big := subscribe(t, e, plan, "c@example.com", nil)
+	applyCoupon(e, big.ID, "BIG")
+
+	// The three subscriptions share their periods, so each renewal renews all of them.
+	forever = renewAt(t, e, forever)
+	renewAt(t, e, forever)
+
+	if invs := invoicesOf(t, e, forever.ID); len(invs) != 3 || invs[1].Discount != 200 || invs[2].Discount != 200 {
+		t.Fatalf("forever invoices = %+v", invs)
+	}
+	if invs := invoicesOf(t, e, five.ID); len(invs) != 3 || invs[1].Discount != 500 || invs[1].CouponAmountOff != 500 || invs[2].Discount != 500 {
+		t.Fatalf("amount invoices = %+v", invs)
+	}
+	// Never more than the subtotal: 50.00 off a 20.00 invoice, once.
+	if invs := invoicesOf(t, e, big.ID); len(invs) != 3 || invs[1].Discount != 2000 || invs[1].Subtotal != 2000 || invs[2].Discount != 0 {
+		t.Fatalf("capped invoices = %+v", invs)
+	}
+}
+
+func TestCouponReplacesTheSubscriptionDiscount(t *testing.T) {
+	e := apitest.New(t)
+	plan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	createCoupon(t, e, map[string]any{"code": "TENOFF", "percent_off": 10, "duration": "once"})
+	sub := subscribe(t, e, plan, "jane@example.com", map[string]any{"discount_percent": 50})
+	applyCoupon(e, sub.ID, "TENOFF")
+	sub = renewAt(t, e, sub)
+	renewAt(t, e, sub)
+
+	invs := invoicesOf(t, e, sub.ID)
+	if len(invs) != 3 || invs[0].Discount != 1000 {
