+	_, _ = e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusInternalServerError, nil }
+	for _, typ := range []string{"customer.created", "customer.updated"} {
+		if err := e.Webhooks.Publish(ctx, e.Acme.ID, typ, map[string]string{"id": "cus_1"}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	settle(t, e, ep)
+	for _, d := range e.Store.Deliveries(e.Acme.ID, ep.ID) {
+		if d.Status != store.DeliveryFailed || d.Attempts != 7 {
+			t.Fatalf("delivery = %+v", d)
+		}
+	}
+	// Both deliveries failed for good at the same time: one email per owner, not one per delivery.
+	subject := "Webhook endpoint failing: https://hooks.acme.example/tally"
+	to := map[string]int{}
+	for _, m := range e.Mail.Messages() {
+		if m.Subject != subject {
+			t.Fatalf("subject = %q", m.Subject)
+		}
+		to[m.To]++
+	}
+	if len(to) != 2 || to["owner@acme.example"] != 1 || to["second@acme.example"] != 1 {
+		t.Fatalf("emails went to %v, want each owner once", to)
+	}
+
+	// A day later another delivery fails for good: the owners are emailed again.
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.deleted", map[string]string{"id": "cus_1"}); err != nil {
+		t.Fatal(err)
+	}
+	settle(t, e, ep)
+	if n := len(e.Mail.Messages()); n != 4 {
+		t.Fatalf("%d emails, want 4", n)
 	}
