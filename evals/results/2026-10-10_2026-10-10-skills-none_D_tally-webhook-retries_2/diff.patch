+// settle runs the due deliveries and moves the clock to the next planned attempt, until nothing is pending.
+func settle(t *testing.T, e *apitest.Env, ep store.WebhookEndpoint) {
+	t.Helper()
+	for i := 0; i < 100; i++ {
+		if _, err := e.Webhooks.RunDue(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+		var next *time.Time
+		for _, d := range e.Store.Deliveries(ep.OrgID, ep.ID) {
+			if d.Status == store.DeliveryPending && d.NextAttemptAt != nil && (next == nil || d.NextAttemptAt.Before(*next)) {
+				next = d.NextAttemptAt
+			}
+		}
+		if next == nil {
+			return
+		}
+		e.Clock.Set(*next)
+	}
+	t.Fatal("deliveries still pending after 100 rounds")
+}
