+func TestRetrySchedule(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep := createEndpoint(t, e, "https://hooks.acme.example/tally")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusInternalServerError, nil }
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+		t.Fatal(err)
+	}
+	// The waits after the 1st to the 6th failed attempt.
+	waits := []time.Duration{time.Minute, 5 * time.Minute, 30 * time.Minute, 2 * time.Hour, 8 * time.Hour, 24 * time.Hour}
+	for i := 1; i <= 7; i++ {
+		if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+			t.Fatalf("attempt %d: RunDue = %d, %v", i, n, err)
+		}
+		d := onlyDelivery(t, e, ep)
+		if d.Attempts != i || d.ResponseStatus != http.StatusInternalServerError || d.Error == "" || d.LastAttemptAt == nil || !d.LastAttemptAt.Equal(e.Clock.Now()) {
+			t.Fatalf("after attempt %d: %+v", i, d)
+		}
+		if i == 7 {
+			if d.Status != store.DeliveryFailed || d.NextAttemptAt != nil {
+				t.Fatalf("after the 7th failure: %+v, want failed with no next attempt", d)
+			}
+			break
+		}
+		if d.Status != store.DeliveryPending || d.NextAttemptAt == nil || !d.NextAttemptAt.Equal(e.Clock.Now().Add(waits[i-1])) {
+			t.Fatalf("after attempt %d: %+v, want the next attempt %s later", i, d, waits[i-1])
+		}
+		e.Clock.Advance(waits[i-1] - time.Second)
+		if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+			t.Fatalf("attempt %d: %d sent before it was due", i+1, n)
+		}
+		e.Clock.Advance(time.Second)
+	}
+	if got := len(e.HTTP.Requests()); got != 7 {
+		t.Fatalf("%d requests, want 7", got)
+	}
+	e.Clock.Advance(48 * time.Hour)
+	if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+		t.Fatalf("a delivery that failed for good was sent again: %d", n)
+	}
+
+	var out struct{ Items []map[string]any }
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+ep.ID+"/deliveries", e.Acme.Key, nil, &out)
+	got := out.Items[0]
+	if v, ok := got["next_attempt_at"]; !ok || v != nil || got["attempts"] != float64(7) || got["status"] != "failed" || got["response_status"] != float64(500) {
+		t.Fatalf("delivery JSON = %v", got)
+	}
+}
