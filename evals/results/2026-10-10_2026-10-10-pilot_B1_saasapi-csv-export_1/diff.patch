+func TestCustomersCSVHasTheCallersCustomersInIDOrder(t *testing.T) {
+	srv, st := newServer(t)
+	utc := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	// Stored with a +02:00 clock: the export must show the same instant in UTC.
+	plus2 := time.Date(2026, 1, 2, 3, 4, 5, 0, time.FixedZone("UTC+2", 2*60*60))
+	c1, _ := st.CreateCustomer("acc_acme", "Jane Doe", "jane@example.com", store.PlanPro, plus2)
+	if _, err := st.CreateCustomer("acc_globex", "Hank", "hank@globex.test", store.PlanFree, utc); err != nil {
+		t.Fatal(err)
+	}
+	c3, _ := st.CreateCustomer("acc_acme", "Bob", "bob@example.com", store.PlanFree, utc)
+
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("status %d: %s", r.Code, r.Body)
+	}
+	want := "id,name,email,plan,created_at\r\n" +
+		c1.ID + ",Jane Doe,jane@example.com,pro,2026-01-02T01:04:05Z\r\n" +
+		c3.ID + ",Bob,bob@example.com,free,2026-01-02T03:04:05Z\r\n"
+	if got := r.Body.String(); got != want {
+		t.Fatalf("body:\n%q\nwant:\n%q", got, want)
+	}
+	if got := r.Header().Get("Content-Type"); got != "text/csv; charset=utf-8" {
+		t.Fatalf("Content-Type %q", got)
+	}
+	if got := r.Header().Get("Content-Disposition"); got != `attachment; filename="customers.csv"` {
+		t.Fatalf("Content-Disposition %q", got)
+	}
+}
