+func TestCustomersCSVNeutralisesSpreadsheetFormulas(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	for i, name := range []string{"=HYPERLINK(\"http://x.test\")", "+1 555", "-2+3", "@SUM(A1)", "Ann"} {
+		if _, err := st.CreateCustomer("acc_acme", name, "a"+string(rune('a'+i))+"@example.com", store.PlanFree, now); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := st.CreateCustomer("acc_acme", "Eve", "=evil@example.com", store.PlanFree, now); err != nil {
+		t.Fatal(err)
+	}
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	recs, err := csv.NewReader(strings.NewReader(r.Body.String())).ReadAll()
+	if err != nil {
+		t.Fatalf("not valid CSV: %v", err)
+	}
+	wantNames := []string{"'=HYPERLINK(\"http://x.test\")", "'+1 555", "'-2+3", "'@SUM(A1)", "Ann", "Eve"}
+	for i, want := range wantNames {
+		if got := recs[i+1][1]; got != want {
+			t.Fatalf("row %d name %q, want %q", i+1, got, want)
+		}
+	}
+	if got := recs[6][2]; got != "'=evil@example.com" {
+		t.Fatalf("email %q, want a quote in front", got)
+	}
+}
