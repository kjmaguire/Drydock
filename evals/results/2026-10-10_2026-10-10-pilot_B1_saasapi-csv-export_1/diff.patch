+func TestCustomersCSVQuotesFieldsAsRFC4180(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	name := "Doe, \"Jane\"\nJr"
+	if _, err := st.CreateCustomer("acc_acme", name, "jane@example.com", store.PlanFree, now); err != nil {
+		t.Fatal(err)
+	}
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if !strings.Contains(r.Body.String(), "\"Doe, \"\"Jane\"\"\r\nJr\"") {
+		t.Fatalf("name is not quoted with doubled quotes: %q", r.Body)
+	}
+	recs, err := csv.NewReader(strings.NewReader(r.Body.String())).ReadAll()
+	if err != nil {
+		t.Fatalf("not valid CSV: %v", err)
+	}
+	if len(recs) != 2 || recs[1][1] != name {
+		t.Fatalf("records %q", recs)
+	}
+}
