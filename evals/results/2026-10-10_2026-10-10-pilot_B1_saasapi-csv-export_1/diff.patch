+// customersCSVHeader is the first row of the customers export.
+var customersCSVHeader = []string{"id", "name", "email", "plan", "created_at"}
+
+func (s *Server) exportCustomers(w http.ResponseWriter, r *http.Request, acct store.Account) {
+	body, err := customersCSV(s.store.Customers(acct.ID))
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "internal")
+		return
+	}
+	w.Header().Set("Content-Type", "text/csv; charset=utf-8")
+	w.Header().Set("Content-Disposition", `attachment; filename="customers.csv"`)
+	_, _ = w.Write(body)
+}
+
+// customersCSV renders customers as RFC 4180 CSV with CRLF line ends. Customers are written in the order given.
+func customersCSV(customers []store.Customer) ([]byte, error) {
+	var buf bytes.Buffer
+	cw := csv.NewWriter(&buf)
+	cw.UseCRLF = true
+	if err := cw.Write(customersCSVHeader); err != nil {
+		return nil, err
+	}
+	for _, c := range customers {
+		row := []string{c.ID, c.Name, c.Email, string(c.Plan), c.CreatedAt.UTC().Format(time.RFC3339)}
+		for i, f := range row {
+			row[i] = safeCell(f)
+		}
+		if err := cw.Write(row); err != nil {
+			return nil, err
+		}
+	}
+	cw.Flush()
+	if err := cw.Error(); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// safeCell stops spreadsheet formula injection: a field that starts with = + - or @ gets a leading single quote.
+func safeCell(f string) string {
+	if f != "" && strings.IndexByte("=+-@", f[0]) >= 0 {
+		return "'" + f
+	}
+	return f
+}
