diff --git a/result/internal/api/customers_import.go b/result/internal/api/customers_import.go
new file mode 100644
index 0000000..19fedec
--- /dev/null
+++ b/result/internal/api/customers_import.go
@@ -0,0 +1,183 @@
+package api
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/csv"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// maxImportRows is how many data records one import may bring.
+const maxImportRows = 10000
+
+// importRow is one record of an import, with the line of the file where it starts.
+type importRow struct {
+	line int
+	rec  store.CustomerRecord
+}
+
+// importColumns says which columns of an import's header hold what.
+type importColumns struct {
+	name, email, paymentMethod int // -1 when absent
+	metadata                   []metadataColumn
+}
+
+type metadataColumn struct {
+	index int
+	key   string
+}
+
+// importColumnsOf reads the header: names match ignoring case and surrounding spaces, and the first column of each name
+// wins. It reports false unless there are name and email columns.
+func importColumnsOf(header []string) (importColumns, bool) {
+	cols := importColumns{name: -1, email: -1, paymentMethod: -1}
+	seenKey := map[string]bool{}
+	for i, h := range header {
+		h = strings.TrimSpace(h)
+		switch strings.ToLower(h) {
+		case "name":
+			if cols.name < 0 {
+				cols.name = i
+			}
+		case "email":
+			if cols.email < 0 {
+				cols.email = i
+			}
+		case "default_payment_method":
+			if cols.paymentMethod < 0 {
+				cols.paymentMethod = i
+			}
+		default:
+			const prefix = "metadata."
+			if len(h) <= len(prefix) || !strings.EqualFold(h[:len(prefix)], prefix) {
+				continue
+			}
+			key := strings.TrimSpace(h[len(prefix):])
+			if key != "" && !seenKey[key] {
+				seenKey[key] = true
+				cols.metadata = append(cols.metadata, metadataColumn{index: i, key: key})
+			}
+		}
+	}
+	return cols, cols.name >= 0 && cols.email >= 0
+}
+
+// record reads one data record. Values are trimmed; an empty metadata value leaves the key unset.
+func (c importColumns) record(f []string) store.CustomerRecord {
+	rec := store.CustomerRecord{Name: strings.TrimSpace(f[c.name]), Email: strings.TrimSpace(f[c.email])}
+	if c.paymentMethod >= 0 {
+		rec.DefaultPaymentMethod = strings.TrimSpace(f[c.paymentMethod])
+	}
+	for _, m := range c.metadata {
+		if v := strings.TrimSpace(f[m.index]); v != "" {
+			if rec.Metadata == nil {
+				rec.Metadata = map[string]string{}
+			}
+			rec.Metadata[m.key] = v
+		}
+	}
+	return rec
+}
+
+// nextRecord reads the next CSV record that is not a blank line, or io.EOF at the end. It returns the record's line too.
+func nextRecord(cr *csv.Reader) ([]string, int, error) {
+	for {
+		rec, err := cr.Read()
+		if err != nil {
+			return nil, 0, err
+		}
+		if len(rec) == 1 && strings.TrimSpace(rec[0]) == "" {
+			continue
+		}
+		line, _ := cr.FieldPos(0)
+		return rec, line, nil
+	}
+}
+
+// importCustomers creates the customers of a CSV body: see the API documentation for the format. With ?dry_run=true it only
+// checks the file.
+func (s *Server) importCustomers(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	in := bufio.NewReader(r.Body)
+	if b, _ := in.Peek(3); bytes.Equal(b, []byte("\xef\xbb\xbf")) {
+		_, _ = in.Discard(3)
+	}
+	cr := csv.NewReader(in)
+	cr.FieldsPerRecord = -1 // checked below, so that a blank line with spaces is skipped rather than rejected
+	header, _, err := nextRecord(cr)
+	if errors.Is(err, io.EOF) {
+		writeError(w, http.StatusUnprocessableEntity, "invalid_header", "the first record must be a header with name and email columns")
+		return
+	}
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_csv", "the body is not valid CSV: "+err.Error())
+		return
+	}
+	cols, ok := importColumnsOf(header)
+	if !ok {
+		writeError(w, http.StatusUnprocessableEntity, "invalid_header", "the header must have name and email columns")
+		return
+	}
+	var rows []importRow
+	for {
+		rec, line, err := nextRecord(cr)
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil || len(rec) != len(header) {
+			msg := "a record has a different number of fields than the header"
+			if err != nil {
+				msg = err.Error()
+			}
+			writeError(w, http.StatusBadRequest, "invalid_csv", "the body is not valid CSV: "+msg)
+			return
+		}
+		if len(rows) == maxImportRows {
+			writeError(w, http.StatusRequestEntityTooLarge, "too_many_rows", "an import takes at most 10000 records")
+			return
+		}
+		rows = append(rows, importRow{line: line, rec: cols.record(rec)})
+	}
+
+	recs := make([]store.CustomerRecord, len(rows))
+	for i, row := range rows {
+		recs[i] = row.rec
+	}
+	dryRun := r.URL.Query().Get("dry_run") == "true"
+	created, problems, err := s.store.ImportCustomers(p.OrgID, recs, s.clock.Now(), dryRun)
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	if len(problems) > 0 {
+		type rowError struct {
+			Row   int    `json:"row"`
+			Error string `json:"error"`
+		}
+		out := make([]rowError, len(problems))
+		for i, pr := range problems {
+			out[i] = rowError{Row: rows[pr.Index].line, Error: pr.Code}
+		}
+		writeJSON(w, http.StatusUnprocessableEntity, struct {
+			Error string     `json:"error"`
+			Rows  []rowError `json:"rows"`
+		}{"invalid_rows", out})
+		return
+	}
+	if dryRun {
+		writeJSON(w, http.StatusOK, map[string]int{"created": 0, "would_create": len(rows)})
+		return
+	}
+	for _, c := range created {
+		s.publish(r.Context(), p.OrgID, "customer.created", c)
+	}
+	writeJSON(w, http.StatusCreated, struct {
+		Created int              `json:"created"`
+		Items   []store.Customer `json:"items"`
+	}{len(created), created})
+}
