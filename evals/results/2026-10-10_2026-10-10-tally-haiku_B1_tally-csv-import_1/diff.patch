+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+const importPath = "/v1/customers/import"
+
+type importResponse struct {
+	Created int              `json:"created"`
+	Items   []store.Customer `json:"items"`
+}
+
+// rowErrors decodes an invalid_rows answer.
+func rowErrors(t *testing.T, r *apitest.Response) []string {
+	t.Helper()
+	var body struct {
+		Error string `json:"error"`
+		Rows  []struct {
+			Row   int    `json:"row"`
+			Error string `json:"error"`
+		} `json:"rows"`
+	}
+	r.JSON(t, &body)
+	if body.Error != "invalid_rows" {
+		t.Fatalf("error = %q, want invalid_rows: %s", body.Error, r)
+	}
+	out := []string{}
+	for _, row := range body.Rows {
+		out = append(out, fmt.Sprintf("%d:%s", row.Row, row.Error))
+	}
+	return out
+}
+
+func expectError(t *testing.T, r *apitest.Response, status int, code string) {
+	t.Helper()
+	if r.Code != status || r.Map(t)["error"] != code {
+		t.Fatalf("want %d %s, got %s", status, code, r)
+	}
+}
+
+func customerCount(e *apitest.Env, org apitest.Org) int {
+	return len(e.Store.Customers(org.ID))
+}
+
+func TestImportCustomers(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Existing", "existing@example.com")
+	body := "\xef\xbb\xbf" + // byte order mark
+		"Ignored , Email ,  NAME,metadata.Plan , metadata.crm,default_payment_method\r\n" +
+		"x,jane@example.com,\"Doe, Jane \"\"JD\"\"\",gold,7,pm_card_1\r\n" +
+		"\r\n" +
+		"  \n" +
+		"y,\"ann@example.com\",\"Ann\nLee\",,,\n" +
+		"z,JOHN@example.com,John Roe,silver,,\n"
+	var got importResponse
+	e.MustDo(http.StatusCreated, "POST", importPath, e.Acme.Key, body, &got)
+	if got.Created != 3 || len(got.Items) != 3 {
+		t.Fatalf("answer = %+v", got)
+	}
+	jane, ann, john := got.Items[0], got.Items[1], got.Items[2]
+	if jane.Name != `Doe, Jane "JD"` || jane.Email != "jane@example.com" || jane.DefaultPaymentMethod != "pm_card_1" {
+		t.Fatalf("jane = %+v", jane)
+	}
+	if jane.Metadata["Plan"] != "gold" || jane.Metadata["crm"] != "7" || len(jane.Metadata) != 2 {
+		t.Fatalf("jane's metadata = %v", jane.Metadata)
+	}
+	if ann.Name != "Ann\nLee" || ann.Metadata != nil || ann.DefaultPaymentMethod != "" {
+		t.Fatalf("ann = %+v", ann)
+	}
+	if john.Email != "JOHN@example.com" || john.Metadata["Plan"] != "silver" {
+		t.Fatalf("john = %+v", john)
+	}
+	if !(jane.CreatedAt.Equal(ann.CreatedAt) && ann.CreatedAt.Equal(john.CreatedAt)) || jane.ID >= ann.ID || ann.ID >= john.ID {
+		t.Fatalf("ids or times out of file order: %s %s %s", jane.ID, ann.ID, john.ID)
+	}
+	if customerCount(e, e.Acme) != 4 {
+		t.Fatalf("org has %d customers", customerCount(e, e.Acme))
+	}
+
+	var events struct {
+		Items []store.Event `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/events", e.Acme.Key, nil, &events)
+	created := 0
+	for _, ev := range events.Items {
+		if ev.Type == "customer.created" {
+			created++
+		}
+	}
+	if created != 4 { // the existing customer, then the three imported ones
+		t.Fatalf("customer.created events: %d", created)
+	}
+}
+
+func TestImportOtherOrganizationsEmailIsNotTaken(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Globex, "Elsewhere", "shared@example.com")
+	var got importResponse
+	e.MustDo(http.StatusCreated, "POST", importPath, e.Acme.Key, "name,email\nShared,shared@example.com\n", &got)
+	if got.Created != 1 {
+		t.Fatalf("answer = %+v", got)
+	}
+}
+
+func TestImportHeaderOnlyAndBlankIsEmpty(t *testing.T) {
+	e := apitest.New(t)
+	var got importResponse
+	r := e.MustDo(http.StatusCreated, "POST", importPath, e.Acme.Key, "name,email\n\n", &got)
+	if !strings.Contains(string(r.Body), `"items":[]`) || got.Created != 0 {
+		t.Fatalf("answer = %s", r)
+	}
+}
+
+func TestImportInvalidHeader(t *testing.T) {
+	e := apitest.New(t)
+	for _, body := range []string{
+		"",
+		"\n\n  \n",
+		"\xef\xbb\xbf",
+		"name,phone\nJane,555\n",
+		"email\njane@example.com\n",
+		"name,Email2\nJane,jane@example.com\n",
+		"metadata.name,email\nJane,jane@example.com\n",
+	} {
+		expectError(t, e.Do("POST", importPath, e.Acme.Key, body), http.StatusUnprocessableEntity, "invalid_header")
+	}
+	if customerCount(e, e.Acme) != 0 {
+		t.Fatal("a refused import created customers")
+	}
+}
+
+func TestImportInvalidCSV(t *testing.T) {
+	e := apitest.New(t)
+	for _, body := range []string{
+		"name,email\nJane,\"jane@example.com\n",     // unterminated quote
+		"name,email\nJa\"ne,jane@example.com\n",     // quote inside an unquoted field
+		"name,email\nJane,jane@example.com,extra\n", // more fields than the header
+		"name,email\nJane\n",                        // fewer fields than the header
+	} {
+		expectError(t, e.Do("POST", importPath, e.Acme.Key, body), http.StatusBadRequest, "invalid_csv")
+	}
+	if customerCount(e, e.Acme) != 0 {
+		t.Fatal("a refused import created customers")
+	}
+}
+
+func TestImportTooManyRows(t *testing.T) {
+	e := apitest.New(t)
+	build := func(n int) string {
+		var b strings.Builder
+		b.WriteString("name,email\n")
+		for i := 0; i < n; i++ {
+			fmt.Fprintf(&b, "Customer %d,c%d@example.com\n", i, i)
+		}
+		return b.String()
+	}
+	expectError(t, e.Do("POST", importPath, e.Acme.Key, build(10001)), http.StatusRequestEntityTooLarge, "too_many_rows")
+	if customerCount(e, e.Acme) != 0 {
+		t.Fatal("a refused import created customers")
+	}
+	var got importResponse
+	e.MustDo(http.StatusCreated, "POST", importPath, e.Acme.Key, build(10000), &got)
+	if got.Created != 10000 {
+		t.Fatalf("created %d", got.Created)
+	}
+}
+
+func TestImportInvalidRowsReportsEveryBadRecord(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Taken", "taken@example.com")
+	body := "name,email,default_payment_method\n" +
+		"Fine,fine@example.com,\n" + // line 2
+		",nameless@example.com,\n" + // line 3: missing_name
+		"Bad,not-an-email,\n" + // line 4: invalid_email
+		"Card,card@example.com,card_123\n" + // line 5: invalid_payment_method
+		"Dup,TAKEN@example.com,\n" + // line 6: email_taken
+		"Twice,Fine@example.com,\n" + // line 7: duplicate_email
+		",\"multi@example.com\",\n" + // line 8: missing_name
+		"\"Two\nlines\",two@example.com,\n" + // lines 9-10: fine
+		"Ok,ok@example.com,pm_ok\n" + // line 11: fine
+		"  ,spaces@example.com,\n" // line 12: missing_name
+	want := []string{"3:missing_name", "4:invalid_email", "5:invalid_payment_method", "6:email_taken", "7:duplicate_email", "8:missing_name", "12:missing_name"}
+	if got := rowErrors(t, e.Do("POST", importPath, e.Acme.Key, body)); strings.Join(got, " ") != strings.Join(want, " ") {
+		t.Fatalf("rows = %v, want %v", got, want)
+	}
+	if customerCount(e, e.Acme) != 1 {
+		t.Fatal("an import with bad rows created customers")
+	}
+}
+
+func TestImportRowNumberCountsMultiLineRecords(t *testing.T) {
+	e := apitest.New(t)
+	body := "name,email\n" +
+		"\"Jane\nDoe\",jane@example.com\n" + // lines 2-3
+		"\n" + // line 4, blank
+		"\"Bad\nRow\",not-an-email\n" // starts on line 5
+	if got := rowErrors(t, e.Do("POST", importPath, e.Acme.Key, body)); strings.Join(got, " ") != "5:invalid_email" {
+		t.Fatalf("rows = %v", got)
+	}
+}
+
+func TestImportDryRun(t *testing.T) {
+	e := apitest.New(t)
+	var got struct {
+		Created     int `json:"created"`
+		WouldCreate int `json:"would_create"`
+	}
+	e.MustDo(http.StatusOK, "POST", importPath+"?dry_run=true", e.Acme.Key, "name,email\nJane,jane@example.com\nJohn,john@example.com\n", &got)
+	if got.Created != 0 || got.WouldCreate != 2 {
+		t.Fatalf("dry run = %+v", got)
+	}
+	expectError(t, e.Do("POST", importPath+"?dry_run=true", e.Acme.Key, "name,email\nJane,jane@example.com\nJane,JANE@example.com\n"), http.StatusUnprocessableEntity, "invalid_rows")
+	expectError(t, e.Do("POST", importPath+"?dry_run=true", e.Acme.Key, "name\nJane\n"), http.StatusUnprocessableEntity, "invalid_header")
+	if customerCount(e, e.Acme) != 0 {
+		t.Fatal("a dry run created customers")
+	}
+}
+
+func TestImportNeedsWriteAccess(t *testing.T) {
+	e := apitest.New(t)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	expectError(t, e.Do("POST", importPath, viewer, "name,email\nJane,jane@example.com\n"), http.StatusForbidden, "forbidden")
+	if r := e.Do("POST", importPath, "", "name,email\n"); r.Code != http.StatusUnauthorized {
+		t.Fatalf("no key: %s", r)
+	}
+}
