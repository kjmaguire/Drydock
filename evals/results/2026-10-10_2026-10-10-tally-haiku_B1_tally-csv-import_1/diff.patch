+func TestImportCustomersIsAllOrNothing(t *testing.T) {
+	s := New()
+	acme := newOrg(t, s, "Acme")
+	globex := newOrg(t, s, "Globex")
+	if _, err := s.CreateCustomer(globex.ID, "Elsewhere", "shared@example.com", t0); err != nil {
+		t.Fatal(err)
+	}
+	good := CustomerRecord{Name: "Jane", Email: "jane@example.com", Metadata: map[string]string{"crm": "7"}}
+
+	_, problems, err := s.ImportCustomers(acme.ID, []CustomerRecord{good, {Name: "John", Email: "john@example.com", DefaultPaymentMethod: "card_1"}}, t0, false)
+	if err != nil || !reflect.DeepEqual(problems, []RecordProblem{{Index: 1, Code: "invalid_payment_method"}}) {
+		t.Fatalf("problems %v, err %v", problems, err)
+	}
+	if n := len(s.Customers(acme.ID)); n != 0 {
+		t.Fatalf("a refused import created %d customers", n)
+	}
+
+	if _, _, err := s.ImportCustomers("org_missing", []CustomerRecord{good}, t0, false); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("unknown org: %v", err)
+	}
+
+	created, problems, err := s.ImportCustomers(acme.ID, []CustomerRecord{good}, t0, true)
+	if err != nil || created != nil || problems != nil || len(s.Customers(acme.ID)) != 0 {
