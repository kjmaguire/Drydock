+// CustomerRecord is one customer to import.
+type CustomerRecord struct {
+	Name                 string
+	Email                string
+	DefaultPaymentMethod string
+	Metadata             map[string]string
+}
+
+// RecordProblem says why the record at Index of an import cannot be imported: one of "missing_name", "invalid_email",
+// "invalid_payment_method", "email_taken" or "duplicate_email".
+type RecordProblem struct {
+	Index int
+	Code  string
+}
+
+// ImportCustomers creates a customer for each record, in order, all or nothing. The records are checked as a whole first:
+// when any is not fine, nothing is created and the problems are returned, one per bad record, in order. With dryRun it only
+// checks. The check and the creation happen under one lock, so no other change can come between them.
+func (s *Store) ImportCustomers(orgID string, recs []CustomerRecord, now time.Time, dryRun bool) ([]Customer, []RecordProblem, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return nil, nil, ErrNotFound
+	}
+	var problems []RecordProblem
+	seen := map[string]bool{}
+	for i, rec := range recs {
+		name, email := strings.TrimSpace(rec.Name), normEmail(rec.Email)
+		code := ""
+		switch {
+		case name == "":
+			code = "missing_name"
+		case !validEmail(email):
+			code = "invalid_email"
+		case rec.DefaultPaymentMethod != "" && !strings.HasPrefix(rec.DefaultPaymentMethod, "pm_"):
+			code = "invalid_payment_method"
+		case s.hasCustomerEmail(orgID, email):
+			code = "email_taken"
+		case seen[email]:
+			code = "duplicate_email"
+		}
+		seen[email] = true
+		if code != "" {
+			problems = append(problems, RecordProblem{Index: i, Code: code})
+		}
+	}
+	if len(problems) > 0 || dryRun {
+		return nil, problems, nil
+	}
+	created := []Customer{}
+	for _, rec := range recs {
+		c := Customer{
+			ID: s.newID("cus"), OrgID: orgID, Name: strings.TrimSpace(rec.Name), Email: strings.TrimSpace(rec.Email),
+			DefaultPaymentMethod: rec.DefaultPaymentMethod, Metadata: rec.Metadata, CreatedAt: now.UTC(),
+		}
+		s.customers[c.ID] = c
+		s.customersByEmail[normEmail(c.Email)] = c.ID
+		created = append(created, copyCustomer(c))
+	}
+	return created, nil, nil
+}
+
+// hasCustomerEmail reports whether the organization has a customer with this (normalized) email address. The caller holds
+// the lock.
+func (s *Store) hasCustomerEmail(orgID, email string) bool {
+	id, ok := s.customersByEmail[email]
+	return ok && s.customers[id].OrgID == orgID
+}
+
 func copyCustomer(c Customer) Customer {
 	if c.Metadata != nil {
 		m := make(map[string]string, len(c.Metadata))
