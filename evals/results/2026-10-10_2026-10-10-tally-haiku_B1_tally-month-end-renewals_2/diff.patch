diff --git a/start/internal/billing/billing.go b/result/internal/billing/billing.go
index be8baaf..b05203d 100644
--- a/start/internal/billing/billing.go
+++ b/result/internal/billing/billing.go
@@ -30,10 +30,61 @@ func Compute(inv store.Invoice) Totals {
 	return Totals{Subtotal: subtotal, Discount: discount, Tax: tax, Total: taxable + tax}
 }
 
-// AddInterval returns t moved forward by one billing interval: a month or a year.
+// Anchor returns the time a subscription's billing periods are counted from: the end of its trial for one that started with
+// a trial, and its start otherwise. It is in UTC.
+func Anchor(sub store.Subscription) time.Time {
+	if sub.TrialEnd != nil {
+		return sub.TrialEnd.UTC()
+	}
+	return sub.StartedAt.UTC()
+}
+
+// AddInterval returns t moved forward by one billing interval: a month or a year. It keeps t's day of the month where it can
+// and otherwise uses the month's last day, so January 31 plus a month is February 28 (or 29). Times are UTC.
 func AddInterval(t time.Time, iv store.Interval) time.Time {
+	return addMonths(t, intervalMonths(iv))
+}
+
+// PeriodStart returns when period n of a subscription counted from anchor starts (n = 0, 1, 2, ...): n intervals after the
+// anchor, computed from the anchor itself so that a short month does not move later periods. Period n ends where period n+1
+// starts.
+func PeriodStart(anchor time.Time, iv store.Interval, n int) time.Time {
+	return addMonths(anchor, n*intervalMonths(iv))
+}
+
+// NextPeriodEnd returns the first period boundary after t, where t is at or after anchor. A subscription whose period ends at
+// t is renewed for the period from t to NextPeriodEnd.
+func NextPeriodEnd(anchor time.Time, iv store.Interval, t time.Time) time.Time {
+	// A boundary always falls in the month n intervals after the anchor's month, so the first one after t is at or after
+	// the boundary one interval before t's month. Start there and step forward.
+	n := monthsBetween(anchor, t)/intervalMonths(iv) - 1
+	for {
+		n++
+		if end := PeriodStart(anchor, iv, n); end.After(t) {
+			return end
+		}
+	}
+}
+
+func intervalMonths(iv store.Interval) int {
 	if iv == store.Yearly {
-		return t.AddDate(1, 0, 0)
+		return 12
 	}
-	return t.AddDate(0, 1, 0)
+	return 1
+}
+
+// addMonths returns t moved by months calendar months, keeping t's time of day (in UTC). If the target month is shorter than
+// t's day, the result is the month's last day.
+func addMonths(t time.Time, months int) time.Time {
+	t = t.UTC()
+	first := time.Date(t.Year(), t.Month()+time.Month(months), 1, t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), time.UTC)
+	last := time.Date(first.Year(), first.Month()+1, 0, 0, 0, 0, 0, time.UTC).Day()
+	day := min(t.Day(), last)
+	return time.Date(first.Year(), first.Month(), day, t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), time.UTC)
+}
+
+// monthsBetween returns the number of whole calendar months from a's month to t's month, in UTC.
+func monthsBetween(a, t time.Time) int {
+	a, t = a.UTC(), t.UTC()
+	return (t.Year()-a.Year())*12 + int(t.Month()) - int(a.Month())
 }
