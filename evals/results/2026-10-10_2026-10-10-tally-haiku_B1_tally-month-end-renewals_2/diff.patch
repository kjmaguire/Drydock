+	}
+	e.Clock.Set(got.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	got, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+	if !got.CurrentPeriodEnd.Equal(utc(2027, time.March, 31, 9)) {
