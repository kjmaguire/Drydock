+		t.Fatal(err)
+	}
+	e.Clock.Set(utc(2027, time.April, 2, 12))
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Canceled || got.CanceledAt == nil || !got.CanceledAt.Equal(utc(2027, time.February, 28, 9)) {
+		t.Fatalf("after the periods = %+v, want canceled at the end of the first", got)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("invoices = %d, want only the first", len(invs))
+	}
+}
+
+func TestTrialEndSetsTheAnchorDay(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
