+// subscribeWithCard starts a monthly licensed subscription for a customer whose card is accepted, at the fake clock's time.
+func subscribeWithCard(t *testing.T, e *apitest.Env, trialDays int) store.Subscription {
+	t.Helper()
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Team", Currency: money.USD, UnitAmount: 2000, Interval: store.Monthly, TrialDays: trialDays}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+func utc(year int, month time.Month, day, hour int) time.Time {
+	return time.Date(year, month, day, hour, 0, 0, 0, time.UTC)
+}
+
+func TestRenewalAnchorDoesNotDrift(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	e.Clock.Set(utc(2027, time.January, 31, 9))
+	sub := subscribeWithCard(t, e, 0)
+	if !sub.CurrentPeriodEnd.Equal(utc(2027, time.February, 28, 9)) {
+		t.Fatalf("first period ends %v, want Feb 28", sub.CurrentPeriodEnd)
+	}
+	// Each renewal runs right when its period ends. The periods end on the anchor's day, or the month's last day when shorter.
+	for _, want := range []time.Time{utc(2027, time.March, 31, 9), utc(2027, time.April, 30, 9), utc(2027, time.May, 31, 9)} {
+		e.Clock.Set(sub.CurrentPeriodEnd)
+		if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+			t.Fatalf("RenewDue = %d, %v", n, err)
+		}
+		sub, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+		if !sub.CurrentPeriodEnd.Equal(want) {
+			t.Fatalf("period ends %v, want %v", sub.CurrentPeriodEnd, want)
+		}
+	}
+}
+
+func TestRenewDueCatchesUpMissedPeriods(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	e.Clock.Set(utc(2027, time.January, 31, 9))
+	sub := subscribeWithCard(t, e, 0)
+	// The job did not run for two months. The periods that ended Feb 28 and Mar 31 are both renewed, in order; the period that
+	// runs to Apr 30 has not ended yet.
+	e.Clock.Set(utc(2027, time.April, 2, 12))
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(utc(2027, time.March, 31, 9)) || !got.CurrentPeriodEnd.Equal(utc(2027, time.April, 30, 9)) {
+		t.Fatalf("after catching up = %+v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	periods := map[string]bool{}
+	for _, inv := range invs {
+		if inv.PeriodStart == nil || inv.PeriodEnd == nil || inv.Status != store.InvoicePaid {
+			t.Fatalf("invoice %+v: want a paid invoice with a period", inv)
+		}
+		periods[inv.PeriodStart.Format(time.RFC3339)+" "+inv.PeriodEnd.Format(time.RFC3339)] = true
+	}
+	for _, want := range []string{
+		utc(2027, time.January, 31, 9).Format(time.RFC3339) + " " + utc(2027, time.February, 28, 9).Format(time.RFC3339),
+		utc(2027, time.February, 28, 9).Format(time.RFC3339) + " " + utc(2027, time.March, 31, 9).Format(time.RFC3339),
+		utc(2027, time.March, 31, 9).Format(time.RFC3339) + " " + utc(2027, time.April, 30, 9).Format(time.RFC3339),
+	} {
+		if !periods[want] {
+			t.Errorf("no invoice for the period %s; have %v", want, periods)
+		}
+	}
+	if len(invs) != 3 {
+		t.Fatalf("invoices = %d, want one per period (3)", len(invs))
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 3 {
+		t.Fatalf("charges = %d, want 3", len(cs))
+	}
+}
+
+func TestCancelAtPeriodEndWhenBehind(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	e.Clock.Set(utc(2027, time.January, 31, 9))
+	sub := subscribeWithCard(t, e, 0)
