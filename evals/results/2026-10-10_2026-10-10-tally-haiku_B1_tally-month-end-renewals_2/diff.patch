+	}
+}
+
+func TestPeriodsAreInUTC(t *testing.T) {
+	// Feb 1 08:30 in Tokyo is Jan 31 23:30 UTC, so the anchor's day is Jan 31 and period 1 is Feb 28 at 23:30 UTC.
+	tokyo := time.FixedZone("JST", 9*60*60)
+	anchor := time.Date(2026, 2, 1, 8, 30, 0, 0, tokyo)
