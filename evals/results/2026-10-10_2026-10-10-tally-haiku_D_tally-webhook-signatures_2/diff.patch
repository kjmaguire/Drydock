+		{"empty pair", fmt.Sprintf("t=%d,,v1=%s", ts, sig("whsec_a", ts)), []string{"whsec_a"}, 0, now, webhooks.ErrMalformedHeader},
+		{"timestamp not an integer", fmt.Sprintf("t=%d.5,v1=%s", ts, sig("whsec_a", ts)), []string{"whsec_a"}, 0, now, webhooks.ErrMalformedHeader},
+		{"empty timestamp", "t=,v1=abc", []string{"whsec_a"}, 0, now, webhooks.ErrMalformedHeader},
