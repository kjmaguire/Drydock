+// webhookSecretOverlap is how long an endpoint's previous secret keeps signing deliveries after a rotation.
+const webhookSecretOverlap = 24 * time.Hour
+
+// RotateWebhookSecret makes newSecret the endpoint's secret. The old secret keeps signing deliveries for 24 hours; a rotation
+// within those hours replaces it at once.
+func (s *Store) RotateWebhookSecret(orgID, id, newSecret string, now time.Time) (WebhookEndpoint, error) {
+	return s.UpdateWebhookEndpoint(orgID, id, func(ep *WebhookEndpoint) error {
+		ep.PreviousSecret = ep.Secret
+		ep.PreviousSecretExpiresAt = now.Add(webhookSecretOverlap).UTC()
+		ep.Secret = newSecret
+		return nil
+	})
+}
