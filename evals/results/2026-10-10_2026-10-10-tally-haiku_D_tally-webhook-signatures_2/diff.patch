+
+// SignatureHeader returns the Tally-Signature header of a delivery sent at t: "t=<unix seconds>,v1=<signature>" with one v1
+// entry per secret, in the order given (the current secret first). Each signature is Sign's over "<t>.<body>".
+func SignatureHeader(secrets []string, t time.Time, body []byte) string {
+	ts := strconv.FormatInt(t.Unix(), 10)
+	var b strings.Builder
+	b.WriteString("t=" + ts)
+	msg := signedPayload(ts, body)
+	for _, secret := range secrets {
+		b.WriteString(",v1=" + hmacHex(secret, msg))
+	}
+	return b.String()
+}
