+		{"no secrets", fmt.Sprintf("t=%d,v1=%s", ts, sig("whsec_a", ts)), nil, 0, now, webhooks.ErrSignatureMismatch},
+		{"empty secret does not count", fmt.Sprintf("t=%d,v1=%s", ts, sig("", ts)), []string{""}, 0, now, webhooks.ErrSignatureMismatch},
