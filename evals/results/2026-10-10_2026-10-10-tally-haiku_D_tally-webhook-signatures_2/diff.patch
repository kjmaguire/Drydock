+// TestRotatedSecretSigning checks which secrets sign deliveries across rotations: the current secret and, for 24 hours after a
+// rotation, the previous one; a rotation within those hours drops the older one at once.
+func TestRotatedSecretSigning(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/all", Events: []string{"*"}, Secret: "whsec_0", Enabled: true}, e.Clock.Now())
+	rotate := func(secret string) {
+		t.Helper()
+		if _, err := e.Store.RotateWebhookSecret(e.Acme.ID, ep.ID, secret, e.Clock.Now()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// send publishes an event, delivers it and returns the header and body of the delivery.
+	send := func() (string, []byte) {
+		t.Helper()
+		if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+			t.Fatal(err)
+		}
+		if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+			t.Fatalf("RunDue = %d, %v", n, err)
+		}
+		reqs := e.HTTP.Requests()
+		last := reqs[len(reqs)-1]
+		return last.Header.Get("Tally-Signature"), last.Body
+	}
+	// expect checks the header's v1 entries are signed by exactly the secrets given, in order.
+	expect := func(header string, body []byte, secrets ...string) {
+		t.Helper()
+		if n := strings.Count(header, ",v1="); n != len(secrets) {
+			t.Fatalf("header %q has %d v1 entries, want %d", header, n, len(secrets))
+		}
+		for _, s := range secrets {
+			if err := webhooks.Verify(body, header, []string{s}, 0, e.Clock.Now()); err != nil {
+				t.Fatalf("header %q with %s: %v", header, s, err)
+			}
+		}
+	}
+
+	// Before any rotation only the original secret signs.
+	h, body := send()
+	expect(h, body, "whsec_0")
+
+	rotate("whsec_1")
+	h, body = send()
+	expect(h, body, "whsec_1", "whsec_0")
+
+	e.Clock.Advance(24*time.Hour - time.Second)
+	h, body = send()
+	expect(h, body, "whsec_1", "whsec_0")
+
+	e.Clock.Advance(time.Second)
+	h, body = send()
+	expect(h, body, "whsec_1")
+	if err := webhooks.Verify(body, h, []string{"whsec_0"}, 0, e.Clock.Now()); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Fatalf("expired secret still signs: %v", err)
+	}
+
+	// A rotation a day later keeps the previous secret for another 24 hours.
+	rotate("whsec_2")
+	h, body = send()
+	expect(h, body, "whsec_2", "whsec_1")
+
+	// Rotating again within the 24 hours drops whsec_1 at once.
+	e.Clock.Advance(time.Hour)
+	rotate("whsec_3")
+	h, body = send()
+	expect(h, body, "whsec_3", "whsec_2")
+	if err := webhooks.Verify(body, h, []string{"whsec_1"}, 0, e.Clock.Now()); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Fatalf("dropped secret still signs: %v", err)
+	}
+}
