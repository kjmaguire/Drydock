+// TestRotatedSecretSurvivesRestart checks that a previous secret still signs deliveries after the server restarts from a
+// snapshot, within the 24 hours after the rotation.
+func TestRotatedSecretSurvivesRestart(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/all", Events: []string{"*"}, Secret: "whsec_0", Enabled: true}, e.Clock.Now())
+	if _, err := e.Store.RotateWebhookSecret(e.Acme.ID, ep.ID, "whsec_1", e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+
+	path := filepath.Join(t.TempDir(), "tally.json")
+	if err := snapshot.Save(e.Store, path, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	st, err := snapshot.Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Advance(time.Hour)
+	svc := webhooks.New(webhooks.Options{Store: st, Clock: e.Clock, Doer: e.HTTP, Resolver: e.DNS})
+	if err := svc.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := svc.RunDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v", n, err)
+	}
+	reqs := e.HTTP.Requests()
+	h, body := reqs[len(reqs)-1].Header.Get("Tally-Signature"), reqs[len(reqs)-1].Body
+	if n := strings.Count(h, ",v1="); n != 2 {
+		t.Fatalf("header %q has %d v1 entries after a restart, want 2", h, n)
+	}
+	for _, s := range []string{"whsec_1", "whsec_0"} {
+		if err := webhooks.Verify(body, h, []string{s}, 0, e.Clock.Now()); err != nil {
+			t.Fatalf("header %q with %s after a restart: %v", h, s, err)
+		}
+	}
