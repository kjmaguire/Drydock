+// Verify checks a Tally-Signature header against a delivery's payload. It returns nil when the header's timestamp is within
+// tolerance of now (either way; 0 means 5 minutes) and one of its v1 signatures is the signature of the payload under one
+// of the secrets. Empty secrets are ignored. The errors can be matched with errors.Is.
+func Verify(payload []byte, header string, secrets []string, tolerance time.Duration, now time.Time) error {
+	if strings.TrimSpace(header) == "" {
+		return fmt.Errorf("%w: the header is empty", ErrMalformedHeader)
+	}
+	var (
+		timestamp string
+		ts        int64
+		hasT      bool
+		sigs      []string
+	)
+	for _, pair := range strings.Split(header, ",") {
+		key, value, ok := strings.Cut(pair, "=")
+		if !ok {
+			return fmt.Errorf("%w: %q is not key=value", ErrMalformedHeader, strings.TrimSpace(pair))
+		}
+		key, value = strings.TrimSpace(key), strings.TrimSpace(value)
+		switch key {
+		case "t":
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil {
+				return fmt.Errorf("%w: the timestamp %q is not an integer", ErrMalformedHeader, value)
+			}
+			if !hasT {
+				timestamp, ts, hasT = value, n, true
+			}
+		case "v1":
+			sigs = append(sigs, value)
+		}
+	}
+	if !hasT {
+		return ErrNoTimestamp
+	}
+	if tolerance == 0 {
+		tolerance = defaultTolerance
+	}
+	t := time.Unix(ts, 0)
+	if now.Before(t.Add(-tolerance)) || now.After(t.Add(tolerance)) {
+		return fmt.Errorf("%w: the timestamp %s is not within %s of now", ErrTimestampTolerance, timestamp, tolerance)
+	}
+	if len(sigs) == 0 {
+		return ErrNoSignature
+	}
+	msg := signedPayload(timestamp, payload)
+	for _, sig := range sigs {
+		for _, secret := range secrets {
+			if secret != "" && hmac.Equal([]byte(sig), []byte(hmacHex(secret, msg))) {
+				return nil
+			}
+		}
+	}
+	return ErrSignatureMismatch
+}
