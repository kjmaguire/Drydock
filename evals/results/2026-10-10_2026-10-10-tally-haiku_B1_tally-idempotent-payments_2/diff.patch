+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/payments"
+	"example.com/tally/internal/store"
+)
+
+var customerSeq atomic.Int64
+
+// openInvoice creates an open USD invoice of amount cents for org, and returns its ID.
+func openInvoice(t *testing.T, e *apitest.Env, org apitest.Org, amount int64) string {
+	t.Helper()
+	c := e.CreateCustomer(org, "Jane", fmt.Sprintf("jane%d@%s.example", customerSeq.Add(1), strings.ToLower(org.Name)))
+	var inv struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", org.Key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Seats", "quantity": 1, "unit_amount": amount}}}, &inv)
+	return inv.ID
+}
+
+// payWithKey pays invoice with payment method pm, sending the Idempotency-Key header when key is not "".
+func payWithKey(e *apitest.Env, org apitest.Org, invoice, key, pm string) *apitest.Response {
+	var h http.Header
+	if key != "" {
+		h = http.Header{"Idempotency-Key": {key}}
+	}
+	return e.DoWith("POST", "/v1/invoices/"+invoice+"/pay", org.Key, map[string]string{"payment_method": pm}, h)
+}
+
+func TestPayWithKeyIsChargedOnce(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(t, e, e.Acme, 4000)
+	first := payWithKey(e, e.Acme, inv, "pay-1", "pm_card_visa")
+	if first.Code != http.StatusOK || first.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("first answer: %s", first)
+	}
+	again := payWithKey(e, e.Acme, inv, "pay-1", "pm_card_visa")
+	if again.Code != first.Code || string(again.Body) != string(first.Body) || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("replay = %s (Idempotent-Replayed %q), first = %s", again, again.Header.Get("Idempotent-Replayed"), first)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+	if n := len(e.Store.Payments(e.Acme.ID, inv)); n != 1 {
+		t.Fatalf("%d payments recorded, want 1", n)
+	}
+}
+
+func TestIdempotencyKeyMustBePrintableASCII(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(t, e, e.Acme, 4000)
+	pay := func(values ...string) *apitest.Response {
+		return e.DoWith("POST", "/v1/invoices/"+inv+"/pay", e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"},
+			http.Header{"Idempotency-Key": values})
+	}
+	for _, key := range []string{"", "\t", "é", "a\x7fb", strings.Repeat("k", 256)} {
+		if r := pay(key); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_idempotency_key" {
+			t.Fatalf("key %q: %s", key, r)
+		}
+	}
+	if r := pay("a", "b"); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_idempotency_key" {
+		t.Fatalf("two keys: %s", r)
+	}
+	if n := len(e.Gateway.Calls()); n != 0 {
+		t.Fatalf("%d charge requests for refused keys", n)
+	}
+	for _, key := range []string{strings.Repeat("k", 255), "order 42 (retry)"} {
+		r := payWithKey(e, e.Acme, openInvoice(t, e, e.Acme, 1000), key, "pm_card_visa")
+		if r.Code != http.StatusOK {
+			t.Fatalf("key %q: %s", key, r)
+		}
+	}
+}
+
+func TestIdempotencyKeyCannotBeReusedForAnotherRequest(t *testing.T) {
+	e := apitest.New(t)
+	a := openInvoice(t, e, e.Acme, 4000)
+	b := openInvoice(t, e, e.Acme, 4000)
+	if r := payWithKey(e, e.Acme, a, "k", "pm_card_visa"); r.Code != http.StatusOK {
+		t.Fatalf("first pay: %s", r)
+	}
+	if r := payWithKey(e, e.Acme, b, "k", "pm_card_visa"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("same key, other invoice: %s", r)
+	}
+	// Checked before the invoice's state: the invoice is paid, so only the key can make this 422 rather than 409.
+	if r := payWithKey(e, e.Acme, a, "k", "pm_card_mastercard"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("same key, other body: %s", r)
+	}
+	if r := payWithKey(e, e.Acme, a, "k", "pm_card_visa"); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("same key, same request: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+}
+
+func TestIdempotencyKeysBelongToAnOrganization(t *testing.T) {
+	e := apitest.New(t)
+	a := openInvoice(t, e, e.Acme, 4000)
+	g := openInvoice(t, e, e.Globex, 4000)
+	if r := payWithKey(e, e.Acme, a, "same", "pm_card_visa"); r.Code != http.StatusOK {
+		t.Fatalf("acme: %s", r)
+	}
+	if r := payWithKey(e, e.Globex, g, "same", "pm_card_visa"); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("globex with the same key: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("%d charges, want 2", n)
+	}
+}
+
+func TestPayWhileAKeyedPayIsUnderWay(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(t, e, e.Acme, 4000)
+	charging, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	t.Cleanup(unblock)
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		close(charging)
+		<-release
+	}
+	first := make(chan *apitest.Response, 1)
+	go func() { first <- payWithKey(e, e.Acme, inv, "slow", "pm_card_visa") }()
+	<-charging
+
+	if r := payWithKey(e, e.Acme, inv, "slow", "pm_card_visa"); r.Code != http.StatusConflict || r.Map(t)["error"] != "request_in_progress" {
+		t.Fatalf("same key while in progress: %s", r)
+	}
+	if r := payWithKey(e, e.Acme, inv, "slow", "pm_card_mastercard"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("same key, other body, while in progress: %s", r)
+	}
+	if r := payWithKey(e, e.Acme, inv, "", "pm_card_visa"); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("no key while in progress: %s", r)
+	}
+	unblock()
+	if r := <-first; r.Code != http.StatusOK {
+		t.Fatalf("first pay: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+}
+
+func TestConcurrentRetriesWithOneKeyChargeOnce(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(t, e, e.Acme, 4000)
+	const n = 10
+	codes := make(chan int, n)
+	var wg sync.WaitGroup
+	for range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			codes <- payWithKey(e, e.Acme, inv, "double-click", "pm_card_visa").Code
+		}()
+	}
+	wg.Wait()
+	close(codes)
+	answered := 0
+	for code := range codes {
+		switch code {
+		case http.StatusOK:
+			answered++
+		case http.StatusConflict:
+		default:
+			t.Errorf("a concurrent retry got %d", code)
+		}
+	}
+	if answered == 0 {
+		t.Fatal("no request was answered")
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+}
+
+func TestAnswersOf500OrMoreAreNotKept(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(t, e, e.Acme, 4000)
+	for range 2 {
+		r := payWithKey(e, e.Acme, inv, "flaky", "pm_gateway_down")
+		if r.Code != http.StatusServiceUnavailable || r.Map(t)["error"] != "gateway_unavailable" || r.Header.Get("Idempotent-Replayed") != "" {
+			t.Fatalf("gateway down: %s", r)
+		}
+	}
+	if n := len(e.Gateway.Calls()); n != 2 {
+		t.Fatalf("%d charge requests, want 2: a retry must try again", n)
+	}
+	// Nothing was kept under the key, so the key can be used for a different request now.
+	if r := payWithKey(e, e.Acme, inv, "flaky", "pm_card_visa"); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("retry after the gateway came back: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+}
+
+func TestDeclinesAreKeptAndReplayed(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(t, e, e.Acme, 4000)
+	first := payWithKey(e, e.Acme, inv, "declined", "pm_card_declined")
+	if first.Code != http.StatusPaymentRequired {
+		t.Fatalf("first: %s", first)
+	}
+	calls := len(e.Gateway.Calls())
+	again := payWithKey(e, e.Acme, inv, "declined", "pm_card_declined")
+	if again.Code != http.StatusPaymentRequired || again.Header.Get("Idempotent-Replayed") != "true" || string(again.Body) != string(first.Body) {
+		t.Fatalf("replay = %s, first = %s", again, first)
+	}
+	if n := len(e.Gateway.Calls()); n != calls {
+		t.Fatalf("a replayed decline reached the gateway (%d -> %d calls)", calls, n)
+	}
+	if n := len(e.Store.Payments(e.Acme.ID, inv)); n != 1 {
+		t.Fatalf("%d payments recorded, want 1", n)
+	}
+}
+
+func TestKeptAnswerIsReplayedFor24Hours(t *testing.T) {
+	e := apitest.New(t)
+	a := openInvoice(t, e, e.Acme, 4000)
+	b := openInvoice(t, e, e.Acme, 4000)
+	if r := payWithKey(e, e.Acme, a, "old", "pm_card_visa"); r.Code != http.StatusOK {
+		t.Fatalf("first pay: %s", r)
+	}
+	e.Clock.Advance(store.IdempotencyTTL - time.Second)
+	if r := payWithKey(e, e.Acme, a, "old", "pm_card_visa"); r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("just before 24 hours: %s", r)
+	}
+	e.Clock.Advance(time.Second)
+	if r := payWithKey(e, e.Acme, b, "old", "pm_card_visa"); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("after 24 hours the key is new: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("%d charges, want 2", n)
+	}
+}
