+
+func TestIdempotencyKeys(t *testing.T) {
+	s := New()
+	if rec, ok := s.ReserveIdempotencyKey("org_a", "k", "fp1", t0); !ok || rec.Done {
+		t.Fatalf("first reserve = %+v %v", rec, ok)
+	}
+	if held, ok := s.ReserveIdempotencyKey("org_a", "k", "fp1", t0); ok || held.Done {
+		t.Fatalf("a key in progress was reserved again: %+v %v", held, ok)
+	}
+	if _, ok := s.ReserveIdempotencyKey("org_b", "k", "fp2", t0); !ok {
+		t.Fatal("another organization's key is taken")
+	}
+	s.KeepIdempotencyResponse("org_a", "k", 402, []byte(`{"error":"payment_declined"}`), t0)
+	held, ok := s.ReserveIdempotencyKey("org_a", "k", "fp1", t0.Add(time.Hour))
+	if ok || !held.Done || held.Status != 402 || string(held.Body) != `{"error":"payment_declined"}` {
+		t.Fatalf("kept answer = %+v %v", held, ok)
+	}
+	if _, ok := s.ReserveIdempotencyKey("org_a", "k", "fp1", t0.Add(IdempotencyTTL-time.Second)); ok {
+		t.Fatal("a kept answer was replaced before it expired")
+	}
+	if _, ok := s.ReserveIdempotencyKey("org_a", "k", "fp3", t0.Add(IdempotencyTTL)); !ok {
+		t.Fatal("an expired key is still taken")
+	}
+
+	s.ReserveIdempotencyKey("org_a", "gone", "fp", t0)
+	s.ReleaseIdempotencyKey("org_a", "gone")
+	if _, ok := s.ReserveIdempotencyKey("org_a", "gone", "fp", t0); !ok {
+		t.Fatal("a released key is still taken")
+	}
+	s.ReserveIdempotencyKey("org_a", "kept", "fp", t0)
+	s.KeepIdempotencyResponse("org_a", "kept", 200, []byte(`{}`), t0)
+	s.ReleaseIdempotencyKey("org_a", "kept")
+	if _, ok := s.ReserveIdempotencyKey("org_a", "kept", "fp", t0); ok {
+		t.Fatal("releasing a kept answer dropped it")
+	}
+}
+
+func TestIdempotencyKeysSurviveExport(t *testing.T) {
+	s := New()
