+func TestPayRefusesAPayThatIsAlreadyUnderWay(t *testing.T) {
+	s, gw, _, inv := setup(t, store.Line{Description: "x", Quantity: 1, UnitAmount: 500})
+	var nestedErr error
+	gw.OnCharge = func(ChargeRequest) {
+		// Called while the first charge is under way, in the same goroutine: it must be refused, not wait.
+		_, _, nestedErr = s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa")
+	}
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); err != nil {
+		t.Fatal(err)
+	}
+	if !errors.Is(nestedErr, ErrPaymentInProgress) {
+		t.Fatalf("a pay under way: %v", nestedErr)
+	}
+	if n := len(gw.Charges()); n != 1 {
+		t.Fatalf("%d charges, want 1", n)
+	}
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); !errors.Is(err, ErrAlreadyPaid) {
+		t.Fatalf("pay after the charge: %v", err)
+	}
+}
diff --git a/result/internal/store/idempotency.go b/result/internal/store/idempotency.go
new file mode 100644
index 0000000..c7f29c5
--- /dev/null
+++ b/result/internal/store/idempotency.go
@@ -0,0 +1,82 @@
+package store
+
+import (
+	"sort"
+	"time"
+)
+
+// IdempotencyTTL is how long a kept response is replayed for its key.
+const IdempotencyTTL = 24 * time.Hour
+
+// IdempotencyRecord is what an Idempotency-Key left in an organization: the request it came with (a fingerprint of it) and,
+// once the request is answered, the answer to replay.
+type IdempotencyRecord struct {
+	OrgID       string    `json:"org_id"`
+	Key         string    `json:"key"`
+	Fingerprint string    `json:"fingerprint"`
+	CreatedAt   time.Time `json:"created_at"`
+	// Done is set when the answer is kept; until then the request is still being handled.
+	Done      bool      `json:"done"`
+	Status    int       `json:"status,omitempty"`
+	Body      []byte    `json:"body,omitempty"`
+	ExpiresAt time.Time `json:"expires_at"`
+}
+
+type idemKey struct{ org, key string }
+
+// ReserveIdempotencyKey claims key for a request in org with the given fingerprint, and returns (record, true). When the
+// key is already held by a request still being handled, or by a kept answer that has not expired, it returns that record
+// and false, and claims nothing.
+func (s *Store) ReserveIdempotencyKey(orgID, key, fingerprint string, now time.Time) (IdempotencyRecord, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := idemKey{orgID, key}
+	if rec, ok := s.idem[k]; ok && (!rec.Done || now.Before(rec.ExpiresAt)) {
+		return rec, false
+	}
+	rec := IdempotencyRecord{OrgID: orgID, Key: key, Fingerprint: fingerprint, CreatedAt: now.UTC()}
+	s.idem[k] = rec
+	return rec, true
+}
+
+// KeepIdempotencyResponse keeps the answer to the request that holds key in org, to be replayed until IdempotencyTTL after
+// now.
+func (s *Store) KeepIdempotencyResponse(orgID, key string, status int, body []byte, now time.Time) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := idemKey{orgID, key}
+	rec, ok := s.idem[k]
+	if !ok || rec.Done {
+		return
+	}
+	rec.Done, rec.Status, rec.Body, rec.ExpiresAt = true, status, append([]byte(nil), body...), now.Add(IdempotencyTTL).UTC()
+	s.idem[k] = rec
+}
+
+// ReleaseIdempotencyKey gives up the claim on key in org, for a request that was not answered with anything to keep. A kept
+// answer is not released.
+func (s *Store) ReleaseIdempotencyKey(orgID, key string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := idemKey{orgID, key}
+	if rec, ok := s.idem[k]; ok && !rec.Done {
+		delete(s.idem, k)
+	}
+}
+
+// keptIdempotencyRecords returns the kept answers, sorted by organization and key. The caller holds the lock.
+func (s *Store) keptIdempotencyRecords() []IdempotencyRecord {
+	var out []IdempotencyRecord
+	for _, rec := range s.idem {
+		if rec.Done {
+			out = append(out, rec)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].OrgID != out[j].OrgID {
+			return out[i].OrgID < out[j].OrgID
+		}
+		return out[i].Key < out[j].Key
+	})
+	return out
+}
