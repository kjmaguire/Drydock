+// chargeOnce charges an invoice for a request that carries an Idempotency-Key. The first request with a key does the work,
+// and its answer is kept for store.IdempotencyTTL: a later request with the same key, invoice and payment method gets that
+// answer again, marked Idempotent-Replayed, and nothing is charged. The same key with another invoice or payment method is
+// refused, and a request with the key that arrives while the first is still being handled is refused at once. An answer of
+// 500 or more is not kept, so a retry with the key runs the payment again.
+func (s *Server) chargeOnce(w http.ResponseWriter, r *http.Request, p auth.Principal, key, invoiceID, paymentMethod string) {
+	fp := paymentFingerprint(invoiceID, paymentMethod)
+	held, reserved := s.store.ReserveIdempotencyKey(p.OrgID, key, fp, s.clock.Now())
+	if !reserved {
+		switch {
+		case held.Fingerprint != fp:
+			writeError(w, http.StatusUnprocessableEntity, "idempotency_key_reused", "this Idempotency-Key was used for another invoice or payment method")
+		case !held.Done:
+			writeError(w, http.StatusConflict, "request_in_progress", "a request with this Idempotency-Key is still being handled")
