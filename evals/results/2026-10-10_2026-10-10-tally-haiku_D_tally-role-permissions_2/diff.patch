-// CanWrite reports whether a role may change anything. Viewers only read.
+// CanRead reports whether a role may read. Every member may.
+func CanRead(r store.Role) bool { return r.Valid() }
+
+// CanWrite reports whether a role may create, update or delete customers and subscriptions. Only viewers may not.
 func CanWrite(r store.Role) bool { return r != store.RoleViewer }
 
+// CanBill reports whether a role may change plans and invoices and read the revenue report.
+func CanBill(r store.Role) bool {
+	return r == store.RoleOwner || r == store.RoleAdmin || r == store.RoleBilling
+}
+
 // CanManageTeam reports whether a role may manage the organization's settings, members and invites.
 func CanManageTeam(r store.Role) bool { return r == store.RoleOwner || r == store.RoleAdmin }
+
+// CanManageWebhooks reports whether a role may manage webhook endpoints and read events.
+func CanManageWebhooks(r store.Role) bool { return CanManageTeam(r) }
+
+// CanGrant reports whether an actor may give a member the role r. Only an owner gives the owner or admin role.
+func CanGrant(actor, r store.Role) bool { return actor == store.RoleOwner || !ownerOrAdmin(r) }
+
+// CanChangeRole reports whether an actor may change another member's role from one role to another. The caller refuses
+// changes to the actor's own role.
+func CanChangeRole(actor, from, to store.Role) bool {
+	return CanManageTeam(actor) && CanGrant(actor, to) && (actor == store.RoleOwner || !ownerOrAdmin(from))
+}
+
+// CanRemoveMember reports whether an actor may remove another member with role from. Anyone may leave; the caller allows
+// that.
+func CanRemoveMember(actor, from store.Role) bool {
+	return CanManageTeam(actor) && (actor == store.RoleOwner || !ownerOrAdmin(from))
+}
+
+func ownerOrAdmin(r store.Role) bool { return r == store.RoleOwner || r == store.RoleAdmin }
