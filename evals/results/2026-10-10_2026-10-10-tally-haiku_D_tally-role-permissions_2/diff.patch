+package api_test
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// Role lists for the matrix, in the order of the role table.
+const (
+	everyone = "owner admin billing member viewer"
+	writers  = "owner admin billing member"
+	billers  = "owner admin billing"
+	admins   = "owner admin"
+)
+
+// TestRoleMatrix checks each endpoint against the role table. A role the table allows gets past the role check; any other
+// role is refused with 403 forbidden.
+func TestRoleMatrix(t *testing.T) {
+	e := apitest.New(t)
+	keys := map[string]string{"owner": e.Acme.Key}
+	for _, role := range []store.Role{store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		_, keys[string(role)] = e.AddMember(e.Acme, string(role)+"@acme.example", role)
+	}
+	customer := map[string]string{"name": "Jane", "email": "jane@example.com"}
+	rows := []struct {
+		method, path string
+		body         any
+		roles        string
+	}{
+		{"GET", "/v1/me", nil, everyone},
+		{"GET", "/v1/org", nil, everyone},
+		{"PATCH", "/v1/org", map[string]any{"name": "Acme 2"}, admins},
+		{"GET", "/v1/members", nil, everyone},
+		{"PATCH", "/v1/members/usr_none", map[string]string{"role": "member"}, admins},
+		{"DELETE", "/v1/members/usr_none", nil, admins},
+		{"GET", "/v1/invites", nil, everyone},
+		{"POST", "/v1/invites", map[string]string{"email": "x@example.com", "role": "member"}, admins},
+		{"DELETE", "/v1/invites/inv_none", nil, admins},
+		{"GET", "/v1/api-keys", nil, everyone},
+		{"POST", "/v1/api-keys", map[string]string{"name": "CI"}, everyone},
+		{"DELETE", "/v1/api-keys/key_none", nil, everyone},
+
+		{"GET", "/v1/customers", nil, everyone},
+		{"GET", "/v1/customers/export.csv", nil, everyone},
+		{"GET", "/v1/customers/cus_none", nil, everyone},
+		{"POST", "/v1/customers", customer, writers},
+		{"PATCH", "/v1/customers/cus_none", map[string]string{"name": "X"}, writers},
+		{"DELETE", "/v1/customers/cus_none", nil, writers},
+
+		{"GET", "/v1/plans", nil, everyone},
+		{"GET", "/v1/plans/plan_none", nil, everyone},
+		{"POST", "/v1/plans", map[string]string{"name": "Pro"}, billers},
+		{"PATCH", "/v1/plans/plan_none", map[string]string{"name": "Pro"}, billers},
+
+		{"GET", "/v1/subscriptions", nil, everyone},
+		{"GET", "/v1/subscriptions/sub_none", nil, everyone},
+		{"POST", "/v1/subscriptions", map[string]string{"customer_id": "cus_none"}, writers},
+		{"PATCH", "/v1/subscriptions/sub_none", map[string]string{"quantity": "2"}, writers},
+		{"POST", "/v1/subscriptions/sub_none/cancel", nil, writers},
+		{"POST", "/v1/subscriptions/sub_none/usage", map[string]int{"quantity": 1}, writers},
+
+		{"GET", "/v1/invoices", nil, everyone},
+		{"GET", "/v1/invoices/inv_none", nil, everyone},
+		{"GET", "/v1/invoices/inv_none/lines", nil, everyone},
+		{"POST", "/v1/invoices", map[string]string{"subscription_id": "sub_none"}, billers},
+		{"POST", "/v1/invoices/inv_none/pay", nil, billers},
+		{"POST", "/v1/invoices/inv_none/void", nil, billers},
+		{"GET", "/v1/payments", nil, everyone},
+		{"GET", "/v1/reports/revenue", nil, billers},
+
+		{"GET", "/v1/webhook-endpoints", nil, admins},
+		{"POST", "/v1/webhook-endpoints", map[string]string{"url": "https://hooks.acme.example/a"}, admins},
+		{"GET", "/v1/webhook-endpoints/whe_none", nil, admins},
+		{"PATCH", "/v1/webhook-endpoints/whe_none", map[string]string{"url": "https://hooks.acme.example/b"}, admins},
+		{"DELETE", "/v1/webhook-endpoints/whe_none", nil, admins},
+		{"GET", "/v1/webhook-endpoints/whe_none/deliveries", nil, admins},
+		{"GET", "/v1/events", nil, admins},
+		{"GET", "/v1/events/evt_none", nil, admins},
+	}
+	for _, row := range rows {
+		allowed := strings.Fields(row.roles)
+		for _, role := range []string{"owner", "admin", "billing", "member", "viewer"} {
+			r := e.Do(row.method, row.path, keys[role], row.body)
+			if contains(allowed, role) {
+				if r.Code == http.StatusForbidden || r.Code >= http.StatusInternalServerError {
+					t.Errorf("%s %s as %s: %s", row.method, row.path, role, r)
+				}
+				continue
+			}
+			if r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+				t.Errorf("%s %s as %s: want 403 forbidden, got %s", row.method, row.path, role, r)
+			}
+		}
+	}
+}
+
+func contains(xs []string, x string) bool {
+	for _, s := range xs {
+		if s == x {
+			return true
+		}
+	}
+	return false
+}
+
+// expectForbidden asserts a refused request: 403 with error "forbidden".
+func expectForbidden(t *testing.T, r *apitest.Response) {
+	t.Helper()
+	if r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+		t.Fatalf("want 403 forbidden: %s", r)
+	}
+}
+
+func TestRoleChangesRules(t *testing.T) {
+	e := apitest.New(t)
+	admin, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	member, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	to := func(r store.Role) map[string]string { return map[string]string{"role": string(r)} }
+
+	// Nobody changes their own role.
+	expectForbidden(t, e.Do("PATCH", "/v1/members/"+admin.ID, adminKey, to(store.RoleMember)))
+	if r := e.Do("PATCH", "/v1/members/"+e.Acme.Owner.ID, e.Acme.Key, to(store.RoleAdmin)); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the only owner demotes themselves: %s", r)
+	}
+
+	// Only an owner gives the owner or admin role, or changes an owner's or an admin's role.
+	expectForbidden(t, e.Do("PATCH", "/v1/members/"+member.ID, adminKey, to(store.RoleAdmin)))
+	expectForbidden(t, e.Do("PATCH", "/v1/members/"+member.ID, adminKey, to(store.RoleOwner)))
+	expectForbidden(t, e.Do("PATCH", "/v1/members/"+e.Acme.Owner.ID, adminKey, to(store.RoleBilling)))
+	expectForbidden(t, e.Do("PATCH", "/v1/members/"+member.ID, memberKey, to(store.RoleViewer)))
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, adminKey, to(store.RoleBilling), nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, e.Acme.Key, to(store.RoleAdmin), nil)
+	expectForbidden(t, e.Do("PATCH", "/v1/members/"+member.ID, adminKey, to(store.RoleViewer)))
+
+	// Anyone may leave. Removing someone else takes owner or admin, and an owner or admin only by an owner.
+	expectForbidden(t, e.Do("DELETE", "/v1/members/"+e.Acme.Owner.ID, adminKey, nil))
+	expectForbidden(t, e.Do("DELETE", "/v1/members/"+member.ID, viewerKey, nil))
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+viewer.ID, adminKey, nil, nil)
+	if r := e.Do("GET", "/v1/me", viewerKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a removed member's key: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+admin.ID, adminKey, nil, nil)
+	if r := e.Do("GET", "/v1/me", adminKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a member who left: %s", r)
+	}
+}
+
+func TestLastOwnerIsKept(t *testing.T) {
+	e := apitest.New(t)
+	if r := e.Do("DELETE", "/v1/members/"+e.Acme.Owner.ID, e.Acme.Key, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the only owner leaves: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", e.Acme.Key, nil, nil)
+
+	owner2, owner2Key := e.AddMember(e.Acme, "owner2@acme.example", store.RoleOwner)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+e.Acme.Owner.ID, owner2Key, nil, nil)
+	if r := e.Do("GET", "/v1/org", e.Acme.Key, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a removed owner's key: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/members/"+owner2.ID, owner2Key, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the last owner leaves: %s", r)
+	}
+	if m, ok := e.Store.Member(e.Acme.ID, owner2.ID); !ok || m.Role != store.RoleOwner {
+		t.Fatalf("the last owner's membership changed: %+v", m)
+	}
+}
+
+func TestOwnerChangesOwnRoleWhenNotLast(t *testing.T) {
+	e := apitest.New(t)
+	owner2, owner2Key := e.AddMember(e.Acme, "owner2@acme.example", store.RoleOwner)
+	expectForbidden(t, e.Do("PATCH", "/v1/members/"+owner2.ID, owner2Key, map[string]string{"role": "admin"}))
+	if m, ok := e.Store.Member(e.Acme.ID, owner2.ID); !ok || m.Role != store.RoleOwner {
+		t.Fatalf("an owner changed their own role: %+v", m)
+	}
+	expectForbidden(t, e.Do("PATCH", "/v1/members/"+e.Acme.Owner.ID, e.Acme.Key, map[string]string{"role": "admin"}))
+	expectForbidden(t, e.Do("PATCH", "/v1/members/"+owner2.ID, owner2Key, map[string]string{"role": "owner"}))
+	if m, ok := e.Store.Member(e.Acme.ID, e.Acme.Owner.ID); !ok || m.Role != store.RoleOwner {
+		t.Fatalf("an owner changed their own role: %+v", m)
+	}
+}
+
+// A refused request changes nothing, so the key it was sent with is not marked as used.
+func TestRefusedRequestDoesNotTouchKey(t *testing.T) {
+	e := apitest.New(t)
+	_, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	expectForbidden(t, e.Do("POST", "/v1/customers", viewerKey, map[string]string{"name": "Jane", "email": "jane@example.com"}))
+	if k, ok := e.Store.APIKeyByToken(viewerKey); !ok || k.LastUsedAt != nil {
+		t.Fatalf("a refused request marked the key used: %+v", k)
+	}
+}
+
+func TestInviteRoles(t *testing.T) {
+	e := apitest.New(t)
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	expectForbidden(t, e.Do("POST", "/v1/invites", adminKey, map[string]string{"email": "a@people.example", "role": "admin"}))
+	expectForbidden(t, e.Do("POST", "/v1/invites", adminKey, map[string]string{"email": "o@people.example", "role": "owner"}))
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", adminKey, map[string]string{"email": "m@people.example", "role": "billing"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "a@people.example", "role": "admin"}, nil)
+}
+
+func TestAPIKeyRules(t *testing.T) {
+	e := apitest.New(t)
+	_, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	var laptop store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", viewerKey, map[string]string{"name": "laptop"}, &laptop)
+	if laptop.UserID != viewer.ID {
+		t.Fatalf("a viewer's key = %+v", laptop)
+	}
+
+	var own struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", viewerKey, nil, &own)
+	if len(own.Items) != 2 {
+		t.Fatalf("a viewer sees %d keys, want their own 2", len(own.Items))
+	}
+	for _, k := range own.Items {
+		if k.UserID != viewer.ID {
+			t.Fatalf("a viewer sees another member's key: %+v", k)
+		}
+	}
+	var all struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, &all)
+	if len(all.Items) != 4 {
+		t.Fatalf("an owner sees %d keys, want all 4", len(all.Items))
+	}
+
+	ownerKey, _ := e.Store.APIKeyByToken(e.Acme.Key)
+	expectForbidden(t, e.Do("DELETE", "/v1/api-keys/"+ownerKey.ID, memberKey, nil))
+	expectForbidden(t, e.Do("DELETE", "/v1/api-keys/"+laptop.ID, memberKey, nil))
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+laptop.ID, viewerKey, nil, nil)
+	if r := e.Do("GET", "/v1/org", laptop.Token, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a revoked key: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/api-keys/key_none", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("an unknown key: %s", r)
+	}
+
+	// An admin revokes anyone's key.
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	memberK, _ := e.Store.APIKeyByToken(memberKey)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+memberK.ID, adminKey, nil, nil)
+	if r := e.Do("GET", "/v1/org", memberKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a member's revoked key: %s", r)
+	}
+}
+
+// TestRoleChangeAppliesToKeys checks that a role change applies to the member's existing keys at once, and that a refused
+// write changes nothing.
+func TestRoleChangeAppliesToKeys(t *testing.T) {
+	e := apitest.New(t)
+	member, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	customer := map[string]string{"name": "Jane", "email": "jane@example.com"}
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", memberKey, customer, nil)
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, e.Acme.Key, map[string]string{"role": "viewer"}, nil)
+	expectForbidden(t, e.Do("POST", "/v1/customers", memberKey, map[string]string{"name": "John", "email": "john@example.com"}))
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", memberKey, nil, nil)
+
+	expectForbidden(t, e.Do("PATCH", "/v1/org", memberKey, map[string]any{"name": "Hacked"}))
+	if o, _ := e.Store.Org(e.Acme.ID); o.Name != "Acme" {
+		t.Fatalf("a refused change applied: org name %q", o.Name)
+	}
+}
