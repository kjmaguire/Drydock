-	case r.queue <- j:
+	case <-r.done:
 		return nil
 	default:
-		return ErrQueueFull
+	}
+	select {
+	case <-r.done:
+		return nil
+	case <-ctx.Done():
+	}
+	r.cancelRunning()
+	<-r.done
+	return ctx.Err()
+}
+
+// cancelRunning cancels the context of every running job.
+func (r *Runner) cancelRunning() {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for _, run := range r.running {
+		run.canceled = true
+		run.cancel()
 	}
