+// waitClosed waits until Shutdown has closed the runner.
+func waitClosed(t *testing.T, r *Runner) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		r.mu.Lock()
+		closed := r.closed
+		r.mu.Unlock()
+		if closed {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("runner did not close")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// names returns the names of jobs, in order.
+func names(jobs []Job) []string {
+	out := []string{}
+	for _, j := range jobs {
+		out = append(out, j.Name)
+	}
+	return out
+}
+
+func noop(context.Context) error { return nil }
+
+func TestPendingListsQueuedJobsInOrder(t *testing.T) {
+	r := NewRunner(1, 10, nil) // not started
+	for _, name := range []string{"a", "b", "c"} {
+		if err := r.Enqueue(Job{Name: name, Run: noop}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := names(r.Pending()); !slices.Equal(got, []string{"a", "b", "c"}) {
+		t.Fatalf("pending = %v, want [a b c]", got)
+	}
+}
+
+func TestEnqueueAfterShutdown(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Enqueue(Job{Name: "late", Run: noop}); !errors.Is(err, ErrStopped) {
+		t.Fatalf("err = %v, want ErrStopped", err)
+	}
+	if got := names(r.Pending()); len(got) != 0 {
+		t.Fatalf("pending = %v, want none", got)
+	}
+}
+
+func TestShutdownDoesNotStartQueuedJobs(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started := make(chan struct{})
+	release := make(chan struct{})
+	ran := make(chan string, 10)
+	if err := r.Enqueue(Job{Name: "first", Run: func(context.Context) error {
+		close(started)
+		<-release
+		ran <- "first"
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	<-started
+	if err := r.Enqueue(Job{Name: "second", Run: func(context.Context) error {
+		ran <- "second"
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	res := make(chan error, 1)
+	go func() { res <- r.Shutdown(context.Background()) }()
+	waitClosed(t, r)
+	close(release)
+	if err := <-res; err != nil {
+		t.Fatalf("Shutdown = %v, want nil", err)
+	}
+	close(ran)
+	var got []string
+	for name := range ran {
+		got = append(got, name)
+	}
+	if !slices.Equal(got, []string{"first"}) {
+		t.Fatalf("ran = %v, want [first]", got)
+	}
+	if pending := names(r.Pending()); !slices.Equal(pending, []string{"second"}) {
+		t.Fatalf("pending = %v, want [second]", pending)
+	}
+}
+
+func TestShutdownWaitsForRunningJobs(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started := make(chan struct{})
+	release := make(chan struct{})
+	finished := make(chan struct{})
+	if err := r.Enqueue(Job{Name: "slow", Run: func(context.Context) error {
+		close(started)
+		<-release
+		close(finished)
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	<-started
+	res := make(chan error, 1)
+	go func() { res <- r.Shutdown(context.Background()) }()
+	waitClosed(t, r)
+	close(release)
+	if err := <-res; err != nil {
+		t.Fatalf("Shutdown = %v, want nil", err)
+	}
