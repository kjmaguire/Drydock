+	case <-finished:
+	default:
+		t.Fatal("Shutdown returned before the running job finished")
+	}
+	if pending := r.Pending(); len(pending) != 0 {
+		t.Fatalf("pending = %v, want none", names(pending))
+	}
+}
+
+func TestShutdownCancelsRunningJobsWhenContextEnds(t *testing.T) {
+	r := NewRunner(2, 10, nil)
+	r.Start()
+	var startedWG sync.WaitGroup
+	startedWG.Add(2)
+	if err := r.Enqueue(Job{Name: "fails", Run: func(ctx context.Context) error {
+		startedWG.Done()
+		<-ctx.Done()
+		return ctx.Err()
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Enqueue(Job{Name: "finishes", Run: func(ctx context.Context) error {
+		startedWG.Done()
+		<-ctx.Done()
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	startedWG.Wait()
+	if err := r.Enqueue(Job{Name: "queued", Run: func(context.Context) error {
+		t.Error("queued job was started")
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if err := r.Shutdown(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Shutdown = %v, want DeadlineExceeded", err)
+	}
+	// The job that finished after its cancel is done; the one that returned an error is not.
+	if got := names(r.Pending()); !slices.Equal(got, []string{"queued", "fails"}) {
+		t.Fatalf("pending = %v, want [queued fails]", got)
+	}
+}
