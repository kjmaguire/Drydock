 func (r *Runner) Enqueue(j Job) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return ErrStopped
+	}
+	if len(r.queue) >= r.queueSize {
+		return ErrQueueFull
+	}
+	r.queue = append(r.queue, entry{seq: r.seq, job: j})
+	r.seq++
+	r.cond.Signal()
+	return nil
