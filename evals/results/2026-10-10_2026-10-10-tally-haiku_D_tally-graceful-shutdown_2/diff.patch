-// Stop stops the runner.
+// Stop shuts the runner down like Shutdown, waiting at most 30 seconds for the running jobs.
 func (r *Runner) Stop() {
-	close(r.queue)
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	_ = r.Shutdown(ctx)
+}
+
+// Pending returns the jobs that still need to run, in the order they were enqueued. Before Shutdown these are
+// the queued jobs. After Shutdown they are the jobs that were never started, followed by the jobs that
+// Shutdown canceled and that returned an error.
+func (r *Runner) Pending() []Job {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	interrupted := append([]entry(nil), r.interrupted...)
+	sort.Slice(interrupted, func(i, j int) bool { return interrupted[i].seq < interrupted[j].seq })
+	jobs := make([]Job, 0, len(r.queue)+len(interrupted))
+	for _, e := range r.queue {
+		jobs = append(jobs, e.job)
+	}
+	for _, e := range interrupted {
+		jobs = append(jobs, e.job)
+	}
+	return jobs
 }
