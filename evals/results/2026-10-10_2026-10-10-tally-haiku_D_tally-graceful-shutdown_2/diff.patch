+func TestPanickingJobIsRecovered(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	ran := make(chan struct{})
+	if err := r.Enqueue(Job{Name: "boom", Run: func(context.Context) error { panic("boom") }}); err != nil {
