+// not started are not started. Shutdown waits for the running jobs to finish. If ctx ends first, it cancels
+// their contexts, waits for them to return, and returns ctx.Err(). A second call returns nil at once.
+func (r *Runner) Shutdown(ctx context.Context) error {
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return nil
+	}
+	r.closed = true
+	if r.live == 0 {
+		close(r.done)
+	}
+	r.cond.Broadcast()
+	r.mu.Unlock()
