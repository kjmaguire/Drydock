+func TestLoadVersion2NumbersInvoicesInCreationOrder(t *testing.T) {
+	st, first, second := sampleStore(t)
+	path := filepath.Join(t.TempDir(), "tally.json")
+	writeVersion2(t, st, path)
+
+	got, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	numbers := invoiceNumbers(t, got, first.OrgID)
+	if numbers[second.ID] != "INV-000001" || numbers[first.ID] != "INV-000002" {
+		t.Fatalf("numbers = %v; the invoice created first (by created_at) should be INV-000001", numbers)
+	}
+	next, err := got.CreateInvoice(store.Invoice{OrgID: first.OrgID, CustomerID: first.CustomerID, Currency: money.EUR, Lines: first.Lines}, time.Now())
+	if err != nil || next.Number != "INV-000003" {
+		t.Fatalf("the next invoice = %+v, %v", next, err)
+	}
+}
