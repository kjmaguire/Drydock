diff --git a/result/internal/store/invoice_numbers_test.go b/result/internal/store/invoice_numbers_test.go
new file mode 100644
index 0000000..5acda3f
--- /dev/null
+++ b/result/internal/store/invoice_numbers_test.go
@@ -0,0 +1,60 @@
+package store
+
+import (
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+func TestInvoiceNumbersArePerOrganizationAndNeverReused(t *testing.T) {
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	s := New()
+	a, _ := s.CreateOrg("A", OrgTeam, "UTC", 0, now)
+	b, _ := s.CreateOrg("B", OrgTeam, "UTC", 0, now)
+	ca, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", now)
+	cb, _ := s.CreateCustomer(b.ID, "Bob", "bob@example.com", now)
+	newInvoice := func(org Org, c Customer) Invoice {
+		return Invoice{OrgID: org.ID, CustomerID: c.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}
+	}
+	expect := func(inv Invoice, err error, number string) {
+		t.Helper()
+		if err != nil || inv.Number != number {
+			t.Fatalf("invoice %s: number = %q, want %q (%v)", inv.ID, inv.Number, number, err)
+		}
+	}
+
+	i1, err := s.CreateInvoice(newInvoice(a, ca), now)
+	expect(i1, err, "INV-000001")
+	i2, err := s.CreateInvoice(newInvoice(b, cb), now)
+	expect(i2, err, "INV-000001")
+	i3, err := s.CreateInvoice(newInvoice(a, ca), now)
+	expect(i3, err, "INV-000002")
+
+	// An update keeps the number.
+	u, err := s.UpdateInvoice(a.ID, i1.ID, func(inv *Invoice) error {
+		inv.Number = "INV-999999"
+		inv.Status = InvoicePaid
+		return nil
+	})
+	expect(u, err, "INV-000001")
+
+	// A store rebuilt from a state without the counters goes on after the highest number it holds.
+	st := s.Export()
+	st.InvoiceNext = nil
+	r, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	i4, err := r.CreateInvoice(newInvoice(a, ca), now)
+	expect(i4, err, "INV-000003")
+}
+
+func TestFormatInvoiceNumber(t *testing.T) {
+	if got := FormatInvoiceNumber(1); got != "INV-000001" {
+		t.Fatalf("FormatInvoiceNumber(1) = %q", got)
+	}
+	if got := FormatInvoiceNumber(1234567); got != "INV-1234567" {
+		t.Fatalf("FormatInvoiceNumber(1234567) = %q", got)
+	}
+}
