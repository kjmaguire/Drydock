+func TestUpgradeVersion1(t *testing.T) {
+	orig, err := os.ReadFile(filepath.Join("testdata", "v1.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "tally.json")
+	if err := os.WriteFile(path, orig, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := Upgrade(path); err != nil {
+		t.Fatal(err)
+	}
+	if bak, err := os.ReadFile(path + ".v1.bak"); err != nil || !bytes.Equal(bak, orig) {
+		t.Fatalf("the backup differs from the original: %v", err)
+	}
+	if v := fileVersion(t, path); v != 3 {
+		t.Fatalf("version = %d, want 3", v)
+	}
+	got, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const org = "org_000001"
+	count := len(got.ListInvoices(org, store.InvoiceFilter{}))
+	if inv, ok := got.Invoice(org, "in_000007"); !ok || inv.Number == "" {
+		t.Fatalf("invoice in_000007 = %+v", inv)
+	}
+	next, err := got.CreateInvoice(store.Invoice{OrgID: org, CustomerID: "cus_000004", Currency: money.USD, Lines: []store.Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, time.Now())
+	if err != nil || next.Number != store.FormatInvoiceNumber(count+1) {
+		t.Fatalf("the next invoice = %+v, %v; want %s after %d invoices", next, err, store.FormatInvoiceNumber(count+1), count)
+	}
+
+	// Upgrading a version 3 file again changes nothing.
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := Upgrade(path); err != nil {
+		t.Fatal(err)
+	}
+	if again, _ := os.ReadFile(path); !bytes.Equal(again, after) {
+		t.Fatal("upgrading a version 3 file changed it")
+	}
+}
