+// writeVersion2 writes st as a version 2 snapshot at path: the version 3 file without invoice numbers or next numbers.
+func writeVersion2(t *testing.T, st *store.Store, path string) []byte {
+	t.Helper()
+	if err := Save(st, path, time.Date(2026, 3, 1, 0, 0, 0, 0, time.UTC)); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var f map[string]any
+	if err := json.Unmarshal(b, &f); err != nil {
+		t.Fatal(err)
+	}
+	f["version"] = 2
+	state := f["state"].(map[string]any)
+	delete(state, "invoice_next")
+	for _, inv := range state["invoices"].([]any) {
+		delete(inv.(map[string]any), "number")
+	}
+	b, err = json.MarshalIndent(f, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, b, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
