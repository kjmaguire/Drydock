+// sampleStore returns a store with two organizations and invoices in both; the first organization's invoices are created
+// later than the second's, and the second one's ID is higher, so created_at and ID order differ.
+func sampleStore(t *testing.T) (*store.Store, store.Invoice, store.Invoice) {
+	t.Helper()
+	now := time.Date(2026, 2, 1, 12, 0, 0, 0, time.UTC)
+	st := store.New()
+	o, _ := st.CreateOrg("A", store.OrgTeam, "Europe/Berlin", 1900, now)
+	c, _ := st.CreateCustomer(o.ID, "Jane", "jane@example.com", now)
+	line := []store.Line{{Description: "x", Quantity: 2, UnitAmount: 150}}
+	first, err := st.CreateInvoice(store.Invoice{OrgID: o.ID, CustomerID: c.ID, Currency: money.EUR, Lines: line}, now.Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := st.CreateInvoice(store.Invoice{OrgID: o.ID, CustomerID: c.ID, Currency: money.EUR, Lines: line}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return st, first, second
+}
