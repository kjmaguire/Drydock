+
+func TestUpgradeRefusesNewerVersions(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "future.json")
+	future := []byte(`{"version": 4, "state": {}}`)
+	if err := os.WriteFile(path, future, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := Upgrade(path); !errors.Is(err, ErrUnsupportedVersion) {
+		t.Fatalf("err = %v", err)
+	}
+	if after, _ := os.ReadFile(path); !bytes.Equal(after, future) {
+		t.Fatal("a newer file was changed")
+	}
+	if entries, _ := os.ReadDir(dir); len(entries) != 1 {
+		t.Fatalf("the folder holds %v; a refused upgrade writes nothing", entries)
+	}
+}
