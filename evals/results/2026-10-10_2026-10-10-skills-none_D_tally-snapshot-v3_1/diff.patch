+func TestSaveLeavesNoTemporaryFile(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "tally.json")
+	st := store.New()
+	for range 2 {
+		if err := Save(st, path, time.Now()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 1 || entries[0].Name() != "tally.json" {
+		t.Fatalf("the folder holds %v after saving; want only tally.json", entries)
+	}
+	if err := Save(st, filepath.Join(dir, "missing", "tally.json"), time.Now()); err == nil {
+		t.Fatal("saving into a missing folder succeeded")
+	}
+	if entries, _ := os.ReadDir(dir); len(entries) != 1 {
+		t.Fatalf("a failed save left %v behind", entries)
+	}
+}
