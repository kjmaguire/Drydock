+func TestSaveWritesVersion3WithNumbers(t *testing.T) {
+	now := time.Date(2026, 2, 1, 12, 0, 0, 0, time.UTC)
+	st := store.New()
+	a, _ := st.CreateOrg("A", store.OrgTeam, "UTC", 0, now)
+	b, _ := st.CreateOrg("B", store.OrgTeam, "UTC", 0, now)
+	ca, _ := st.CreateCustomer(a.ID, "Ann", "ann@example.com", now)
+	cb, _ := st.CreateCustomer(b.ID, "Bob", "bob@example.com", now)
+	line := []store.Line{{Description: "x", Quantity: 1, UnitAmount: 100}}
+	for range 2 {
+		if _, err := st.CreateInvoice(store.Invoice{OrgID: a.ID, CustomerID: ca.ID, Currency: money.EUR, Lines: line}, now); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := st.CreateInvoice(store.Invoice{OrgID: b.ID, CustomerID: cb.ID, Currency: money.EUR, Lines: line}, now); err != nil {
+		t.Fatal(err)
+	}
+
+	path := filepath.Join(t.TempDir(), "tally.json")
+	if err := Save(st, path, now); err != nil {
+		t.Fatal(err)
+	}
+	if v := fileVersion(t, path); v != 3 {
+		t.Fatalf("version = %d, want 3", v)
+	}
+	got, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := invoiceNumbers(t, got, a.ID); len(n) != 2 || !reflect.DeepEqual(sortedValues(n), []string{"INV-000001", "INV-000002"}) {
+		t.Fatalf("numbers of A = %v", n)
+	}
+	if n := invoiceNumbers(t, got, b.ID); !reflect.DeepEqual(sortedValues(n), []string{"INV-000001"}) {
+		t.Fatalf("numbers of B = %v", n)
+	}
+	inv, err := got.CreateInvoice(store.Invoice{OrgID: a.ID, CustomerID: ca.ID, Currency: money.EUR, Lines: line}, now)
+	if err != nil || inv.Number != "INV-000003" {
+		t.Fatalf("the next invoice of A = %+v, %v", inv, err)
+	}
+}
+
+func sortedValues(m map[string]string) []string {
+	out := []string{}
+	for _, v := range m {
+		out = append(out, v)
+	}
+	sort.Strings(out)
+	return out
+}
