+
+// Group is how a revenue report puts days together.
+type Group string
+
+// Groups.
+const (
+	GroupDay   Group = "day"
+	GroupWeek  Group = "week"
+	GroupMonth Group = "month"
+)
+
+// ErrInvalidGroup is returned for a group that is not day, week or month.
+var ErrInvalidGroup = errors.New("invalid group")
+
+// Bucket is what an organization took in one day, week or month, in each currency that had payments.
+type Bucket struct {
+	Start    string                   `json:"start"` // YYYY-MM-DD, the first day of the bucket
+	Amounts  map[money.Currency]int64 `json:"amounts"`
+	Payments int                      `json:"payments"`
+}
+
+// Report is a revenue report in the organization's time zone.
+type Report struct {
+	TimeZone string   `json:"time_zone"`
+	Group    Group    `json:"group"`
+	Buckets  []Bucket `json:"buckets"`
+}
+
+// RevenueReport adds up the organization's succeeded payments per bucket. from and to are days in the organization's
+// time zone (YYYY-MM-DD, both included), and a payment belongs to the day, in that time zone, when it was made. group is
+// day (the default), week (starting on Monday) or month. The buckets run in order from the one holding from to the one
+// holding to, including those without payments; each is named by its first day, which may be before from.
+func RevenueReport(st *store.Store, orgID, from, to, group string) (Report, error) {
+	start, last, err := parseDays(from, to)
+	if err != nil {
+		return Report{}, err
+	}
+	g := Group(group)
+	if g == "" {
+		g = GroupDay
+	}
+	if g != GroupDay && g != GroupWeek && g != GroupMonth {
+		return Report{}, fmt.Errorf("%w: %q", ErrInvalidGroup, group)
+	}
+	org, ok := st.Org(orgID)
+	if !ok {
+		return Report{}, store.ErrNotFound
+	}
+	loc, err := time.LoadLocation(org.TimeZone)
+	if err != nil {
+		return Report{}, fmt.Errorf("time zone %q: %w", org.TimeZone, err)
+	}
+	// The days from to last in the organization's time zone, as the instants [startAt, endAt).
+	startAt := time.Date(start.Year(), start.Month(), start.Day(), 0, 0, 0, 0, loc)
+	endAt := time.Date(last.Year(), last.Month(), last.Day()+1, 0, 0, 0, 0, loc)
+
+	// Bucket days are civil dates, so they are handled in UTC, which has no daylight saving time.
+	buckets := []Bucket{}
+	index := map[string]int{}
+	for b, end := bucketStart(start, g), bucketStart(last, g); !b.After(end); b = nextBucket(b, g) {
+		index[b.Format(time.DateOnly)] = len(buckets)
+		buckets = append(buckets, Bucket{Start: b.Format(time.DateOnly), Amounts: map[money.Currency]int64{}})
+	}
+	for _, p := range st.Payments(orgID, "") {
+		if p.Status != store.PaymentSucceeded || p.CreatedAt.Before(startAt) || !p.CreatedAt.Before(endAt) {
+			continue
+		}
+		y, m, d := p.CreatedAt.In(loc).Date()
+		i, ok := index[bucketStart(time.Date(y, m, d, 0, 0, 0, 0, time.UTC), g).Format(time.DateOnly)]
+		if !ok {
+			continue
+		}
+		buckets[i].Amounts[p.Currency] += p.Amount
+		buckets[i].Payments++
+	}
+	return Report{TimeZone: org.TimeZone, Group: g, Buckets: buckets}, nil
+}
+
+// parseDays reads from and to, both included, and checks that they form a range the report covers.
+func parseDays(from, to string) (time.Time, time.Time, error) {
+	start, err := time.Parse(time.DateOnly, from)
+	if err != nil {
+		return time.Time{}, time.Time{}, fmt.Errorf("%w: from %q", ErrInvalidDate, from)
+	}
+	last, err := time.Parse(time.DateOnly, to)
+	if err != nil {
+		return time.Time{}, time.Time{}, fmt.Errorf("%w: to %q", ErrInvalidDate, to)
+	}
+	if last.Before(start) {
+		return time.Time{}, time.Time{}, fmt.Errorf("%w: to is before from", ErrInvalidRange)
+	}
+	if last.Sub(start) >= MaxDays*24*time.Hour {
+		return time.Time{}, time.Time{}, fmt.Errorf("%w: at most %d days", ErrInvalidRange, MaxDays)
+	}
+	return start, last, nil
+}
+
+// bucketStart returns the first day of the bucket of group g that holds day.
+func bucketStart(day time.Time, g Group) time.Time {
+	switch g {
+	case GroupWeek:
+		return day.AddDate(0, 0, -((int(day.Weekday()) + 6) % 7))
+	case GroupMonth:
+		return time.Date(day.Year(), day.Month(), 1, 0, 0, 0, 0, time.UTC)
+	}
+	return day
+}
+
+// nextBucket returns the first day of the bucket after the one starting on b.
+func nextBucket(b time.Time, g Group) time.Time {
+	switch g {
+	case GroupWeek:
+		return b.AddDate(0, 0, 7)
+	case GroupMonth:
+		return b.AddDate(0, 1, 0)
+	}
+	return b.AddDate(0, 0, 1)
+}
