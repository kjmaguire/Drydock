+func TestRevenueReportErrors(t *testing.T) {
+	st := store.New()
+	o, err := st.CreateOrg("A", store.OrgTeam, "Europe/Berlin", 0, time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct {
+		from, to, group string
+		want            error
+	}{
+		{"2026-03-01", "2026/03/05", "", ErrInvalidDate},
+		{"", "2026-03-05", "day", ErrInvalidDate},
+		{"2026-03-05", "2026-03-01", "week", ErrInvalidRange},
+		{"2026-01-01", "2027-01-02", "month", ErrInvalidRange},
+		{"2026-03-01", "2026-03-05", "year", ErrInvalidGroup},
+		{"2026-03-01", "2026-03-05", "Day", ErrInvalidGroup},
+	} {
+		if _, err := RevenueReport(st, o.ID, c.from, c.to, c.group); !errors.Is(err, c.want) {
+			t.Errorf("RevenueReport(%s, %s, %q) = %v, want %v", c.from, c.to, c.group, err, c.want)
+		}
+	}
+	// 366 days, both included, is the longest range.
+	got, err := RevenueReport(st, o.ID, "2026-01-01", "2027-01-01", "")
+	if err != nil || len(got.Buckets) != 366 || got.TimeZone != "Europe/Berlin" {
+		t.Fatalf("a full year: %d buckets, %v", len(got.Buckets), err)
+	}
+	if _, err := RevenueReport(st, "org_x", "2026-01-01", "2026-01-02", ""); !errors.Is(err, store.ErrNotFound) {
+		t.Fatalf("unknown org: %v", err)
+	}
