+// inviteToken returns the token in the link of the newest email the outbox holds.
+func inviteToken(t *testing.T, e *apitest.Env) string {
+	t.Helper()
+	msgs := e.Mail.Messages()
+	m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[len(msgs)-1].Body)
+	if m == nil {
+		t.Fatalf("no link in %q", msgs[len(msgs)-1].Body)
+	}
+	token, _ := url.QueryUnescape(m[1])
+	return token
+}
+
+func acceptWith(e *apitest.Env, token string) *apitest.Response {
+	return e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "New Person"})
+}
+
+func TestInviteTokens(t *testing.T) {
+	e := apitest.New(t)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+
+	var inv store.Invite
+	created := e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "first@people.example", "role": "member"})
+	if created.Code != http.StatusCreated {
+		t.Fatalf("invite: %s", created)
+	}
+	if err := json.Unmarshal(created.Body, &inv); err != nil {
+		t.Fatal(err)
+	}
+	token := inviteToken(t, e)
+	if raw, err := base64.RawURLEncoding.DecodeString(token); err != nil || len(raw) != 32 || len(token) != 43 {
+		t.Fatalf("token %q is not 32 random bytes in unpadded base64url", token)
+	}
+
+	// No answer and no snapshot holds the token, but the list shows the pending invite with its expiry.
+	var pending struct{ Items []store.Invite }
+	list := e.MustDo(http.StatusOK, "GET", "/v1/invites", viewer, nil, &pending)
+	if strings.Contains(string(created.Body), token) || strings.Contains(string(list.Body), token) {
+		t.Fatalf("an answer holds the token: %s / %s", created, list)
+	}
+	if len(pending.Items) != 1 || !pending.Items[0].ExpiresAt.Equal(inv.CreatedAt.Add(7*24*time.Hour)) {
+		t.Fatalf("pending = %+v", pending.Items)
+	}
+	snapshot, err := json.Marshal(e.Store.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(snapshot), token) {
+		t.Fatal("the snapshot holds the token")
+	}
+
+	// Inviting the same address again, in another case, revokes the old invite: only the newest token works.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "First@People.example", "role": "viewer"}, nil)
+	newest := inviteToken(t, e)
+	if r := acceptWith(e, token); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("a replaced token: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", viewer, nil, &pending)
+	if len(pending.Items) != 1 || pending.Items[0].Email != "First@People.example" {
+		t.Fatalf("pending after the re-invite = %+v", pending.Items)
+	}
+
+	// Accepting once works; the same token then answers invite_used.
+	if r := acceptWith(e, newest); r.Code != http.StatusCreated {
+		t.Fatalf("accept: %s", r)
+	}
+	if r := acceptWith(e, newest); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_used" {
+		t.Fatalf("accept twice: %s", r)
+	}
+
+	// A revoked token is not found.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "gone@people.example", "role": "member"}, &inv)
+	gone := inviteToken(t, e)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+inv.ID, e.Acme.Key, nil, nil)
+	if r := acceptWith(e, gone); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("a revoked token: %s", r)
+	}
+
+	// An invite is good for 7 days on the service's clock, and no longer.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "late@people.example", "role": "member"}, nil)
+	late := inviteToken(t, e)
+	e.Clock.Advance(7 * 24 * time.Hour)
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", viewer, nil, &pending)
+	if len(pending.Items) != 1 {
+		t.Fatalf("pending after 7 days = %+v", pending.Items)
+	}
+	e.Clock.Advance(time.Second)
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", viewer, nil, &pending)
+	if len(pending.Items) != 0 {
+		t.Fatalf("pending after 7 days and a second = %+v", pending.Items)
+	}
+	if r := acceptWith(e, late); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_expired" {
+		t.Fatalf("an expired token: %s", r)
+	}
+}
