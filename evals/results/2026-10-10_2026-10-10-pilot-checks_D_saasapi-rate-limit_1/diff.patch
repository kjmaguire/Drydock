+package api_test
+
+import (
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/saasapi/internal/api"
+	"example.com/saasapi/internal/store"
+)
+
+// clock is a server clock the test moves by hand.
+type clock struct{ t time.Time }
+
+func (c *clock) now() time.Time { return c.t }
+
+func newRateServer(t *testing.T) (*api.Server, *clock) {
+	t.Helper()
+	st := store.New()
+	st.AddAccount(store.Account{ID: "acc_acme", Name: "Acme", Plan: store.PlanFree})
+	st.AddAccount(store.Account{ID: "acc_globex", Name: "Globex", Plan: store.PlanPro})
+	st.AddKey("key-acme", "acc_acme")
+	st.AddKey("key-acme-2", "acc_acme")
+	st.AddKey("key-globex", "acc_globex")
+	c := &clock{t: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)}
+	return api.New(st, api.Options{Now: c.now}), c
+}
+
+// requireAllowed sends n requests with key and fails unless each one is answered 200.
+func requireAllowed(t *testing.T, srv http.Handler, key string, n int) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		if r := do(t, srv, "GET", "/api/customers", key, ""); r.Code != http.StatusOK {
+			t.Fatalf("request %d with %s: status %d, want 200", i+1, key, r.Code)
+		}
+	}
+}
+
+func requireRateLimited(t *testing.T, srv http.Handler, key, retryAfter string) {
+	t.Helper()
+	r := do(t, srv, "GET", "/api/customers", key, "")
+	if r.Code != http.StatusTooManyRequests {
+		t.Fatalf("status %d, want 429", r.Code)
+	}
+	if strings.TrimSpace(r.Body.String()) != `{"error":"rate_limited"}` {
+		t.Fatalf("body %s", r.Body)
+	}
+	if got := r.Header().Get("Retry-After"); got != retryAfter {
+		t.Fatalf("Retry-After %q, want %q", got, retryAfter)
+	}
+}
+
+func TestAFreeKeyIsLimitedTo60RequestsAMinute(t *testing.T) {
+	srv, _ := newRateServer(t)
+	requireAllowed(t, srv, "key-acme", 60)
+	requireRateLimited(t, srv, "key-acme", "60")
+}
+
+func TestAProKeyIsLimitedTo600RequestsAMinute(t *testing.T) {
+	srv, _ := newRateServer(t)
+	requireAllowed(t, srv, "key-globex", 600)
+	requireRateLimited(t, srv, "key-globex", "60")
+}
+
+func TestTheWindowSlides(t *testing.T) {
+	srv, c := newRateServer(t)
+	requireAllowed(t, srv, "key-acme", 60)
+	c.t = c.t.Add(30 * time.Second)
+	requireRateLimited(t, srv, "key-acme", "30")
+	// The requests of t0 leave the window (t0, t0+60s] exactly 60s after they were made.
+	c.t = c.t.Add(30 * time.Second)
+	requireAllowed(t, srv, "key-acme", 60)
+}
+
+func TestRetryAfterIsRoundedUpToWholeSeconds(t *testing.T) {
+	srv, c := newRateServer(t)
+	requireAllowed(t, srv, "key-acme", 60)
+	c.t = c.t.Add(1500 * time.Millisecond)
+	requireRateLimited(t, srv, "key-acme", "59")
+}
+
+func TestRetryAfterIsAtLeastOneSecond(t *testing.T) {
+	srv, c := newRateServer(t)
+	requireAllowed(t, srv, "key-acme", 60)
+	c.t = c.t.Add(59*time.Second + 500*time.Millisecond)
+	requireRateLimited(t, srv, "key-acme", "1")
+}
+
+func TestRejectedRequestsDoNotCount(t *testing.T) {
+	srv, c := newRateServer(t)
+	requireAllowed(t, srv, "key-acme", 60)
+	c.t = c.t.Add(time.Second)
+	for i := 0; i < 5; i++ {
+		requireRateLimited(t, srv, "key-acme", "59")
+	}
+	// If the rejected requests had been counted, they would still be in the window at t0+60s.
+	c.t = c.t.Add(59 * time.Second)
+	requireAllowed(t, srv, "key-acme", 60)
+}
+
+func TestEachKeyHasItsOwnLimit(t *testing.T) {
+	srv, _ := newRateServer(t)
+	requireAllowed(t, srv, "key-acme", 60)
+	requireRateLimited(t, srv, "key-acme", "60")
+	requireAllowed(t, srv, "key-acme-2", 60)
+}
+
+func TestUnauthorizedRequestsAndHealthzAreNotLimitedOrCounted(t *testing.T) {
+	srv, _ := newRateServer(t)
+	for i := 0; i < 100; i++ {
+		if r := do(t, srv, "GET", "/api/customers", "nope", ""); r.Code != http.StatusUnauthorized {
+			t.Fatalf("unknown key: status %d, want 401", r.Code)
+		}
+		if r := do(t, srv, "GET", "/healthz", "", ""); r.Code != http.StatusOK {
+			t.Fatalf("healthz: status %d", r.Code)
+		}
+	}
+	requireAllowed(t, srv, "key-acme", 60)
+}
+
+func TestConcurrentRequestsShareTheLimit(t *testing.T) {
+	srv, _ := newRateServer(t)
+	const n = 100
+	codes := make([]int, n)
+	var wg sync.WaitGroup
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			codes[i] = do(t, srv, "GET", "/api/customers", "key-acme", "").Code
+		}(i)
+	}
+	wg.Wait()
+	allowed := 0
+	for _, code := range codes {
+		if code == http.StatusOK {
+			allowed++
+		}
+	}
+	if allowed != 60 {
+		t.Fatalf("%d of %d concurrent requests allowed, want 60", allowed, n)
+	}
+}
