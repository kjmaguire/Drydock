+package api
+
+import (
+	"sync"
+	"time"
+
+	"example.com/saasapi/internal/store"
+)
+
+// rateWindow is the rolling window over which a key's requests are counted.
+const rateWindow = 60 * time.Second
+
+// rateLimit is how many requests per window a key may make, by its account's plan.
+func rateLimit(p store.Plan) int {
+	if p == store.PlanPro {
+		return 600
+	}
+	return 60
+}
+
+// limiter is a sliding-window log per API key: it keeps the times of the requests it allowed.
+type limiter struct {
+	mu   sync.Mutex
+	hits map[string][]time.Time
+}
+
+func newLimiter() *limiter {
+	return &limiter{hits: map[string][]time.Time{}}
+}
+
+// allow records a request by key at t and reports whether it is within limit.
+// When it is not, retryAfter is the whole number of seconds (at least 1) until the oldest counted request leaves the window.
+func (l *limiter) allow(key string, limit int, t time.Time) (ok bool, retryAfter int) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	// Keep only requests in (t-rateWindow, t].
+	kept := l.hits[key][:0]
+	for _, at := range l.hits[key] {
+		if at.After(t.Add(-rateWindow)) {
+			kept = append(kept, at)
+		}
+	}
+	l.hits[key] = kept
+
+	if len(kept) < limit {
+		l.hits[key] = append(kept, t)
+		return true, 0
+	}
+
+	oldest := kept[0]
+	for _, at := range kept[1:] {
+		if at.Before(oldest) {
+			oldest = at
+		}
+	}
+	wait := oldest.Add(rateWindow).Sub(t)
+	secs := int((wait + time.Second - 1) / time.Second)
+	if secs < 1 {
+		secs = 1
+	}
+	return false, secs
+}
