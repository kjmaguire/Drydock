+// TestRoundTrip checks that what FormatMajor writes, ParseMajor reads back.
+func TestRoundTrip(t *testing.T) {
+	for _, cur := range []Currency{USD, JPY, KWD} {
+		for _, amount := range []int64{0, 1, 99, 1000, 123456} {
+			s := FormatMajor(amount, cur)
+			got, err := ParseMajor(s, cur)
+			if err != nil || got != amount {
+				t.Errorf("ParseMajor(FormatMajor(%d, %s) = %q) = %d, %v", amount, cur, s, got, err)
+			}
+		}
+	}
+}
