+func TestPlansInZeroAndThreeDecimalCurrencies(t *testing.T) {
+	e := apitest.New(t)
+	var p struct {
+		store.Plan
+		Price          string `json:"price"`
+		PriceFormatted string `json:"price_formatted"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "Tokyo", "currency": "JPY", "price": "1000", "interval": "month"}, &p)
+	if p.UnitAmount != 1000 || p.Price != "1000" || p.PriceFormatted != "¥1,000" {
+		t.Fatalf("JPY plan = %+v", p)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "Kuwait", "currency": "KWD", "price": "1.250", "interval": "month"}, &p)
+	if p.UnitAmount != 1250 || p.Price != "1.250" || p.PriceFormatted != "KWD 1.250" {
+		t.Fatalf("KWD plan = %+v", p)
+	}
+	for _, bad := range []map[string]any{
+		{"name": "X", "currency": "JPY", "price": "1000.50", "interval": "month"},
+		{"name": "X", "currency": "KWD", "price": "1.2345", "interval": "month"},
+	} {
+		if r := e.Do("POST", "/v1/plans", e.Acme.Key, bad); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_amount" {
+			t.Fatalf("%v: %s", bad, r)
+		}
+	}
+}
