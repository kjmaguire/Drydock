+// restoreWindow is how long after its deletion a customer can be restored, and before PurgeDeletedCustomers removes it.
+const restoreWindow = 30 * 24 * time.Hour
+
+// SoftDeleteCustomer deletes a customer at now. It is hidden from the API, its email address is free again, and it can be
+// restored for 30 days (RestoreCustomer). A customer with a subscription that is not canceled cannot be deleted.
+func (s *Store) SoftDeleteCustomer(orgID, id string, now time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt != nil {
+		return ErrNotFound
+	}
+	for _, sub := range s.subs {
+		if sub.CustomerID == id && sub.Status != Canceled {
+			return ErrActiveSubscriptions
+		}
 	}
+	t := now.UTC()
+	c.DeletedAt = &t
+	s.customers[id] = c
+	s.unindexEmail(c, id)
 	return nil
 }
 
+// RestoreCustomer undoes SoftDeleteCustomer, if the customer was deleted less than 30 days before now. Another customer of
+// the organization may not be using its email address by then.
+func (s *Store) RestoreCustomer(orgID, id string, now time.Time) (Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt == nil || c.DeletedAt.Before(now.Add(-restoreWindow)) {
+		return Customer{}, ErrNotFound
+	}
+	key := normEmail(c.Email)
+	if other, ok := s.customersByEmail[key]; ok && s.customers[other].OrgID == orgID {
+		return Customer{}, ErrEmailTaken
+	}
+	c.DeletedAt = nil
+	s.customers[id] = c
+	s.customersByEmail[key] = id
+	return copyCustomer(c), nil
+}
+
+// PurgeDeletedCustomers removes the customers deleted more than 30 days before now and returns how many it removed. Their
+// invoices and payments stay, but their invoices no longer name a customer.
+func (s *Store) PurgeDeletedCustomers(now time.Time) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	cutoff := now.Add(-restoreWindow)
+	n := 0
+	for id, c := range s.customers {
+		if c.DeletedAt != nil && c.DeletedAt.Before(cutoff) {
+			delete(s.customers, id)
+			s.unindexEmail(c, id)
+			n++
+		}
+	}
+	return n
+}
+
+// unindexEmail frees a customer's email address, if the address is still indexed to this customer. The caller holds the lock.
+func (s *Store) unindexEmail(c Customer, id string) {
+	if key := normEmail(c.Email); s.customersByEmail[key] == id {
+		delete(s.customersByEmail, key)
+	}
+}
