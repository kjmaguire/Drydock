+func TestSoftDeleteCustomer(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	plan, _ := s.CreatePlan(Plan{OrgID: a.ID, Name: "Pro", Currency: money.USD, UnitAmount: 100, Interval: Monthly}, t0)
+	sub, _ := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: c.ID, PlanID: plan.ID, Quantity: 1, Status: Active}, t0)
+	inv, _ := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+
+	later := t0.Add(time.Hour)
+	if err := s.SoftDeleteCustomer(b.ID, c.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleted through another org: %v", err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, c.ID, later); !errors.Is(err, ErrActiveSubscriptions) {
+		t.Fatalf("deleted with an active subscription: %v", err)
+	}
+	if _, err := s.UpdateSubscription(a.ID, sub.ID, func(sub *Subscription) error { sub.Status = Canceled; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, c.ID, later); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.Customer(a.ID, c.ID); ok {
+		t.Fatal("deleted customer still visible")
+	}
+	if got := s.Customers(a.ID); len(got) != 0 {
+		t.Fatalf("Customers = %+v", got)
+	}
+	if got := s.SearchCustomers(a.ID, "jane"); len(got) != 0 {
+		t.Fatalf("SearchCustomers = %+v", got)
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); ok {
+		t.Fatal("deleted customer found by email")
+	}
+	if got, ok := s.CustomerWithDeleted(a.ID, c.ID); !ok || got.DeletedAt == nil || !got.DeletedAt.Equal(later) {
+		t.Fatalf("CustomerWithDeleted = %+v, %v", got, ok)
+	}
+	if got := s.CustomersWithDeleted(a.ID); len(got) != 1 || got[0].ID != c.ID {
+		t.Fatalf("CustomersWithDeleted = %+v", got)
+	}
+	if _, ok := s.Invoice(a.ID, inv.ID); !ok {
+		t.Fatal("the invoice of a deleted customer is gone")
+	}
+	if err := s.SoftDeleteCustomer(a.ID, c.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleted twice: %v", err)
+	}
+	if _, err := s.UpdateCustomer(a.ID, c.ID, func(c *Customer) error { c.Name = "Janet"; return nil }); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("update of a deleted customer: %v", err)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for a deleted customer: %v", err)
+	}
+	if _, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: c.ID, PlanID: plan.ID, Quantity: 1, Status: Active}, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for a deleted customer: %v", err)
+	}
+	if _, err := s.CreateCustomer(a.ID, "Jane Again", "JANE@example.com", later); err != nil {
+		t.Fatalf("email of a deleted customer is still taken: %v", err)
+	}
+}
