+func TestRestoreAndPurgeCustomers(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	day := func(n int) time.Time { return t0.Add(time.Duration(n) * 24 * time.Hour) }
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	if err := s.SoftDeleteCustomer(a.ID, c.ID, day(0)); err != nil {
+		t.Fatal(err)
+	}
+	taker, err := s.CreateCustomer(a.ID, "Jane 2", "jane@example.com", day(1))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, c.ID, day(1)); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("restore with the email in use: %v", err)
+	}
+	if err := s.DeleteCustomer(a.ID, taker.ID); err != nil {
+		t.Fatal(err)
+	}
+	got, err := s.RestoreCustomer(a.ID, c.ID, day(30))
+	if err != nil || got.DeletedAt != nil {
+		t.Fatalf("restore on day 30 = %+v, %v", got, err)
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok {
+		t.Fatal("restored customer's email is not indexed")
+	}
+	if _, err := s.RestoreCustomer(a.ID, c.ID, day(31)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore of a customer that is not deleted: %v", err)
+	}
+
+	if err := s.SoftDeleteCustomer(a.ID, c.ID, day(40)); err != nil {
+		t.Fatal(err)
+	}
+	other, _ := s.CreateCustomer(a.ID, "John", "john@example.com", day(40))
+	if err := s.SoftDeleteCustomer(a.ID, other.ID, day(60)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, c.ID, day(71)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore after 30 days: %v", err)
+	}
+	if n := s.PurgeDeletedCustomers(day(70)); n != 0 {
+		t.Fatalf("purged %d on day 70, when nothing is older than 30 days", n)
+	}
+	if n := s.PurgeDeletedCustomers(day(71)); n != 1 {
+		t.Fatalf("purged %d, want 1", n)
+	}
+	if _, ok := s.CustomerByID(c.ID); ok {
+		t.Fatal("purged customer still there")
+	}
+	if _, ok := s.CustomerByID(other.ID); !ok {
+		t.Fatal("a recently deleted customer was purged")
+	}
+	if n := s.PurgeDeletedCustomers(day(71)); n != 0 {
+		t.Fatalf("second purge removed %d", n)
+	}
+}
