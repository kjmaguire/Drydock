+func TestFromStateNumbersInvoices(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	line := []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}
+	_, _ = s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: line}, t0)
+	st := s.Export()
+	if st.NextInvoiceNumbers[a.ID] != 2 {
+		t.Fatalf("next invoice number = %d", st.NextInvoiceNumbers[a.ID])
+	}
+
+	// A stored next number that is behind the invoices is moved past them, so no number is handed out twice.
+	st.NextInvoiceNumbers[a.ID] = 1
+	st.Invoices[0].Number = "INV-000005"
+	s2, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if inv, _ := s2.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: line}, t0); inv.Number != "INV-000006" {
+		t.Fatalf("next number = %q", inv.Number)
+	}
+
+	// Numbers that are malformed or repeated within an organization are refused.
+	for _, num := range []string{"INV-0", "inv-000002", "INV-00000x", "INV-000000", "INV-+00002"} {
+		st := s.Export()
+		st.Invoices[0].Number = num
+		if _, err := FromState(st); !errors.Is(err, ErrInvalid) {
+			t.Fatalf("number %q was accepted: %v", num, err)
+		}
+	}
+	st = s.Export()
+	dup := st.Invoices[0]
+	dup.ID = "in_999999"
+	st.Invoices = append(st.Invoices, dup)
+	if _, err := FromState(st); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("a repeated number was accepted: %v", err)
+	}
+	st = s.Export()
+	st.NextInvoiceNumbers[a.ID] = 0
+	if _, err := FromState(st); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("next number 0 was accepted: %v", err)
+	}
+
+	// Invoices without numbers, as in a version 1 or 2 snapshot, are numbered in creation order.
+	st = s.Export()
+	st.NextInvoiceNumbers = nil
+	st.Invoices[0].Number = ""
+	later, _ := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD, Lines: line}, t0.Add(time.Hour))
+	st.Invoices = append(st.Invoices, copyInvoice(later))
+	st.Invoices[len(st.Invoices)-1].Number = ""
+	st.Invoices[len(st.Invoices)-1].CreatedAt = t0.Add(-time.Hour)
+	s3, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	early, _ := s3.Invoice(a.ID, later.ID)
+	if early.Number != "INV-000001" {
+		t.Fatalf("earlier invoice = %q", early.Number)
+	}
+	if inv := s3.ListInvoices(a.ID, InvoiceFilter{}); inv[0].Number != "INV-000001" || inv[1].Number != "INV-000002" {
+		t.Fatalf("numbers = %q, %q", inv[0].Number, inv[1].Number)
+	}
+}
