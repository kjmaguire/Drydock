+// writeFileAtomic replaces path with data. It writes a temporary file beside path, flushes it to disk and renames it over
+// path, so that path is always either the old file or the whole new one. The temporary file is removed on failure.
+func writeFileAtomic(path string, data []byte) (err error) {
+	f, err := os.CreateTemp(filepath.Dir(path), filepath.Base(path)+".tmp-*")
+	if err != nil {
+		return err
+	}
+	defer func() {
+		if err != nil {
+			_ = f.Close()
+			_ = os.Remove(f.Name())
+		}
+	}()
+	if _, err := f.Write(data); err != nil {
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(f.Name(), path); err != nil {
+		return err
+	}
+	// Make the rename itself durable. Not every platform can sync a directory, so the error is ignored.
+	if d, err := os.Open(filepath.Dir(path)); err == nil {
+		_ = d.Sync()
+		_ = d.Close()
+	}
+	return nil
+}
+
+// writeBackup writes the original bytes of an upgraded snapshot to path. A backup that already holds the same bytes, from an
+// upgrade that was interrupted, is kept; a different one is not overwritten.
+func writeBackup(path string, b []byte) error {
+	old, err := os.ReadFile(path)
+	switch {
+	case err == nil && bytes.Equal(old, b):
+		return nil
+	case err == nil:
+		return fmt.Errorf("backup %s already exists and differs from the snapshot; move it aside and retry", path)
+	case !errors.Is(err, fs.ErrNotExist):
+		return err
 	}
-	return store.FromState(st)
+	return writeFileAtomic(path, b)
