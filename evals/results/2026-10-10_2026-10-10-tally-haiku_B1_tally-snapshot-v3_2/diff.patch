+func TestInvoiceNumbers(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Joe", "joe@example.com", t0)
+	line := []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}
+	mk := func(org, cus string) Invoice {
+		inv, err := s.CreateInvoice(Invoice{OrgID: org, CustomerID: cus, Currency: money.USD, Lines: line, Number: "INV-999999"}, t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	first := mk(a.ID, ca.ID)
+	second := mk(a.ID, ca.ID)
+	other := mk(b.ID, cb.ID)
+	if first.Number != "INV-000001" || second.Number != "INV-000002" || other.Number != "INV-000001" {
+		t.Fatalf("numbers = %q, %q, %q", first.Number, second.Number, other.Number)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: cb.ID, Currency: money.USD, Lines: line}, t0); !errors.Is(err, ErrCustomerOrgMismatch) {
+		t.Fatalf("err = %v", err)
+	}
+	third := mk(a.ID, ca.ID)
+	if third.Number != "INV-000003" {
+		t.Fatalf("a refused invoice used a number: %q", third.Number)
+	}
+	updated, err := s.UpdateInvoice(a.ID, first.ID, func(i *Invoice) error { i.Number = "INV-000042"; i.Status = InvoicePaid; return nil })
+	if err != nil || updated.Number != "INV-000001" {
+		t.Fatalf("UpdateInvoice changed the number: %+v, %v", updated, err)
+	}
+	if got := mk(a.ID, ca.ID); got.Number != "INV-000004" {
+		t.Fatalf("number after an update = %q", got.Number)
+	}
+}
