+// numberInvoices checks the invoice numbers of a loaded state. A number is never handed out twice, so the next number of an
+// organization is always after its highest. Invoices without a number (from a version 1 or 2 snapshot) get the next numbers
+// of their organizations, in creation order.
+func (s *Store) numberInvoices() error {
+	type orgNumber struct {
+		org string
+		n   int
+	}
+	taken := map[orgNumber]bool{}
+	var unnumbered []Invoice
+	for _, inv := range s.invoices {
+		if inv.Number == "" {
+			unnumbered = append(unnumbered, inv)
+			continue
+		}
+		n, ok := parseInvoiceNumber(inv.Number)
+		k := orgNumber{inv.OrgID, n}
+		if !ok || taken[k] {
+			return invalid("invoice %q has the number %q, which is malformed or repeated", inv.ID, inv.Number)
+		}
+		taken[k] = true
+		if n >= s.invoiceNext[inv.OrgID] {
+			s.invoiceNext[inv.OrgID] = n + 1
+		}
+	}
