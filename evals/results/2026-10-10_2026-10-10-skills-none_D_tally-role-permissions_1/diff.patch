+package api_test
+
+import (
+	"net/http"
+	"slices"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+var (
+	everyRole = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer}
+	notViewer = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember}
+	billing   = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling}
+	admins    = []store.Role{store.RoleOwner, store.RoleAdmin}
+)
+
+// TestRoleMatrix sends every endpoint as each role. A role that may not make the request is answered 403 forbidden. A role
+// that may make it is not refused by the role check; the IDs and empty bodies here make it fail for other reasons, so the
+// request changes nothing.
+func TestRoleMatrix(t *testing.T) {
+	e := apitest.New(t)
+	keys := map[store.Role]string{store.RoleOwner: e.Acme.Key}
+	for _, role := range everyRole[1:] {
+		_, keys[role] = e.AddMember(e.Acme, string(role)+"@acme.example", role)
+	}
+	rows := []struct {
+		method, path string
+		allowed      []store.Role
+	}{
+		{"GET", "/v1/me", everyRole},
+		{"GET", "/v1/org", everyRole},
+		{"PATCH", "/v1/org", admins},
+		{"GET", "/v1/members", everyRole},
+		{"GET", "/v1/invites", everyRole},
+		{"POST", "/v1/invites", admins},
+		{"DELETE", "/v1/invites/inv_nope", admins},
+		{"GET", "/v1/api-keys", everyRole},
+
+		{"GET", "/v1/customers", everyRole},
+		{"GET", "/v1/customers/export.csv", everyRole},
+		{"GET", "/v1/customers/cus_nope", everyRole},
+		{"POST", "/v1/customers", notViewer},
+		{"PATCH", "/v1/customers/cus_nope", notViewer},
+		{"DELETE", "/v1/customers/cus_nope", notViewer},
+
+		{"GET", "/v1/plans", everyRole},
+		{"GET", "/v1/plans/plan_nope", everyRole},
+		{"POST", "/v1/plans", billing},
+		{"PATCH", "/v1/plans/plan_nope", billing},
+
+		{"GET", "/v1/subscriptions", everyRole},
+		{"GET", "/v1/subscriptions/sub_nope", everyRole},
+		{"POST", "/v1/subscriptions", notViewer},
+		{"PATCH", "/v1/subscriptions/sub_nope", notViewer},
+		{"POST", "/v1/subscriptions/sub_nope/cancel", notViewer},
+		{"POST", "/v1/subscriptions/sub_nope/usage", notViewer},
+
+		{"GET", "/v1/invoices", everyRole},
+		{"GET", "/v1/invoices/inv_nope", everyRole},
+		{"GET", "/v1/invoices/inv_nope/lines", everyRole},
+		{"GET", "/v1/payments", everyRole},
+		{"POST", "/v1/invoices", billing},
+		{"POST", "/v1/invoices/inv_nope/pay", billing},
+		{"POST", "/v1/invoices/inv_nope/void", billing},
+
+		{"GET", "/v1/reports/revenue", billing},
+
+		{"GET", "/v1/webhook-endpoints", admins},
+		{"POST", "/v1/webhook-endpoints", admins},
+		{"GET", "/v1/webhook-endpoints/whe_nope", admins},
+		{"PATCH", "/v1/webhook-endpoints/whe_nope", admins},
+		{"DELETE", "/v1/webhook-endpoints/whe_nope", admins},
+		{"GET", "/v1/webhook-endpoints/whe_nope/deliveries", admins},
+		{"GET", "/v1/events", admins},
+		{"GET", "/v1/events/evt_nope", admins},
+	}
+	for _, row := range rows {
+		for _, role := range everyRole {
+			r := e.Do(row.method, row.path, keys[role], nil)
+			want := slices.Contains(row.allowed, role)
+			refused := r.Code == http.StatusForbidden
+			if refused == want {
+				t.Errorf("%s %s as %s: %s (allowed: %v)", row.method, row.path, role, r, want)
+			}
+			if refused && r.Map(t)["error"] != "forbidden" {
+				t.Errorf("%s %s as %s: refused without error forbidden: %s", row.method, row.path, role, r)
+			}
+		}
+	}
+}
+
+// TestRefusedRequestChangesNothing checks that a 403 leaves the data as it was.
+func TestRefusedRequestChangesNothing(t *testing.T) {
+	e := apitest.New(t)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	body := map[string]string{"name": "Ann", "email": "ann@example.com"}
+	if r := e.Do("POST", "/v1/customers", viewer, body); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer creates a customer: %s", r)
+	}
+	var customers struct{ Items []store.Customer }
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", e.Acme.Key, nil, &customers)
+	if len(customers.Items) != 0 {
+		t.Fatalf("customers after a refused create = %+v", customers.Items)
+	}
+}
+
+// TestRoleChangeAppliesToExistingKeys checks that the role is read on every request: a key keeps working, with the role it
+// has now.
+func TestRoleChangeAppliesToExistingKeys(t *testing.T) {
+	e := apitest.New(t)
+	user, key := e.AddMember(e.Acme, "pat@acme.example", store.RoleMember)
+	body := map[string]string{"name": "Ann", "email": "ann@example.com"}
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, body, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+user.ID, e.Acme.Key, map[string]string{"role": "viewer"}, nil)
+	if r := e.Do("POST", "/v1/customers", key, body); r.Code != http.StatusForbidden {
+		t.Fatalf("demoted to viewer, the key still writes: %s", r)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+user.ID, e.Acme.Key, map[string]string{"role": "member"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, map[string]string{"name": "Bo", "email": "bo@example.com"}, nil)
+}
+
+// TestRoleChangeRules checks who may change whose role, and who may remove whom.
+func TestRoleChangeRules(t *testing.T) {
+	e := apitest.New(t)
+	admin, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	billingUser, billingKey := e.AddMember(e.Acme, "billing@acme.example", store.RoleBilling)
+	member, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	owner := e.Acme.Owner
+	patch := func(key, userID, role string) *apitest.Response {
+		return e.Do("PATCH", "/v1/members/"+userID, key, map[string]string{"role": role})
+	}
+	expect := func(what string, r *apitest.Response, code int) {
+		t.Helper()
+		if r.Code != code {
+			t.Fatalf("%s: %s, want %d", what, r, code)
+		}
+	}
+
+	// Only an owner gives or takes the owner and admin roles.
+	expect("admin makes a member admin", patch(adminKey, member.ID, "admin"), http.StatusForbidden)
+	expect("admin makes a member owner", patch(adminKey, member.ID, "owner"), http.StatusForbidden)
+	expect("admin demotes the owner", patch(adminKey, owner.ID, "member"), http.StatusForbidden)
+	expect("a member changes a viewer", patch(memberKey, viewer.ID, "member"), http.StatusForbidden)
+	expect("billing changes a member", patch(billingKey, member.ID, "viewer"), http.StatusForbidden)
+
+	// Nobody changes their own role, even to the role they have. The only owner demoting themselves is a last-owner conflict.
+	expect("admin changes own role", patch(adminKey, admin.ID, "member"), http.StatusForbidden)
+	expect("sole owner changes own role", patch(e.Acme.Key, owner.ID, "admin"), http.StatusConflict)
+
+	// Admins change the other roles.
+	expect("admin changes billing to member", patch(adminKey, billingUser.ID, "member"), http.StatusOK)
+	expect("owner makes a member admin", patch(e.Acme.Key, member.ID, "admin"), http.StatusOK)
+	expect("admin demotes an admin", patch(adminKey, member.ID, "viewer"), http.StatusForbidden)
+	expect("owner demotes an admin", patch(e.Acme.Key, member.ID, "viewer"), http.StatusOK)
+	expect("unknown member", patch(e.Acme.Key, "usr_nope", "member"), http.StatusNotFound)
+
+	// Removing members: anyone may leave; others need an owner or admin, and an owner or admin only an owner may remove.
+	del := func(key, userID string) *apitest.Response { return e.Do("DELETE", "/v1/members/"+userID, key, nil) }
+	expect("a member removes a viewer", del(memberKey, viewer.ID), http.StatusForbidden)
+	expect("admin removes the owner", del(adminKey, owner.ID), http.StatusForbidden)
+	expect("admin removes a member", del(adminKey, member.ID), http.StatusNoContent)
+	expect("owner removes an admin", del(e.Acme.Key, admin.ID), http.StatusNoContent)
+	if r := e.Do("GET", "/v1/me", adminKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a removed admin's key: %s", r)
+	}
+	expect("a member leaves", del(billingKey, billingUser.ID), http.StatusNoContent)
+	expect("a viewer leaves", del(viewerKey, viewer.ID), http.StatusNoContent)
+}
+
+// TestLastOwnerStaysOwner checks that an organization always keeps an owner.
+func TestLastOwnerStaysOwner(t *testing.T) {
+	e := apitest.New(t)
+	second, secondKey := e.AddMember(e.Acme, "second@acme.example", store.RoleMember)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+second.ID, e.Acme.Key, map[string]string{"role": "owner"}, nil)
+
+	// With another owner present, an owner changing their own role is refused as a self-change.
+	if r := e.Do("PATCH", "/v1/members/"+e.Acme.Owner.ID, e.Acme.Key, map[string]string{"role": "admin"}); r.Code != http.StatusForbidden {
+		t.Fatalf("an owner with a second owner changes own role: %s", r)
+	}
+
+	// The first owner may leave while another owner remains.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+e.Acme.Owner.ID, e.Acme.Key, nil, nil)
+
+	// The only owner may not leave.
+	if r := e.Do("DELETE", "/v1/members/"+second.ID, secondKey, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the only owner leaves: %s", r)
+	}
+	// The only owner may not demote themselves either: a last-owner conflict.
+	if r := e.Do("PATCH", "/v1/members/"+second.ID, secondKey, map[string]string{"role": "admin"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the only owner changes own role: %s", r)
+	}
+	var me struct{ Role string }
+	e.MustDo(http.StatusOK, "GET", "/v1/me", secondKey, nil, &me)
+	if me.Role != "owner" {
+		t.Fatalf("role = %s", me.Role)
+	}
+}
+
+// TestInviteRoles checks that only an owner invites owners and admins.
+func TestInviteRoles(t *testing.T) {
+	e := apitest.New(t)
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	invite := func(key, email, role string) *apitest.Response {
+		return e.Do("POST", "/v1/invites", key, map[string]string{"email": email, "role": role})
+	}
+	if r := invite(adminKey, "a@people.example", "admin"); r.Code != http.StatusForbidden {
+		t.Fatalf("admin invites an admin: %s", r)
+	}
+	if r := invite(adminKey, "b@people.example", "owner"); r.Code != http.StatusForbidden {
+		t.Fatalf("admin invites an owner: %s", r)
+	}
+	if r := invite(e.Acme.Key, "c@people.example", "admin"); r.Code != http.StatusCreated {
+		t.Fatalf("owner invites an admin: %s", r)
+	}
+	if r := invite(adminKey, "d@people.example", "member"); r.Code != http.StatusCreated {
+		t.Fatalf("admin invites a member: %s", r)
+	}
+}
+
+// TestAPIKeyRules checks who sees and revokes which API keys.
+func TestAPIKeyRules(t *testing.T) {
+	e := apitest.New(t)
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	_, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+
+	// Every role makes a key for itself, and a viewer sees only its own keys.
+	var own store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", viewerKey, map[string]string{"name": "laptop"}, &own)
+	var viewerKeys struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", viewerKey, nil, &viewerKeys)
+	if len(viewerKeys.Items) != 2 {
+		t.Fatalf("a viewer's keys = %+v", viewerKeys.Items)
+	}
+	for _, k := range viewerKeys.Items {
+		if k.UserID != viewer.ID {
+			t.Fatalf("a viewer sees another member's key: %+v", k)
+		}
+	}
+
+	// Owners and admins see every key of the organization.
+	var all struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", adminKey, nil, &all)
+	if len(all.Items) != 5 {
+		t.Fatalf("an admin's keys = %+v", all.Items)
+	}
+
+	// Anyone revokes their own key; others' keys only owners and admins revoke.
+	if r := e.Do("DELETE", "/v1/api-keys/"+own.ID, memberKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("a member revokes a viewer's key: %s", r)
+	}
+	ownerKey, _ := e.Store.APIKeyByToken(e.Acme.Key)
+	if r := e.Do("DELETE", "/v1/api-keys/"+ownerKey.ID, memberKey, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("a member revokes the owner's key: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+own.ID, viewerKey, nil, nil)
+	if r := e.Do("GET", "/v1/me", own.Token, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a revoked key: %s", r)
+	}
+	memberOwn, _ := e.Store.APIKeyByToken(memberKey)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+memberOwn.ID, adminKey, nil, nil)
+	if r := e.Do("GET", "/v1/me", memberKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a key an admin revoked: %s", r)
+	}
+}
