 // CanManageTeam reports whether a role may manage the organization's settings, members and invites.
 func CanManageTeam(r store.Role) bool { return r == store.RoleOwner || r == store.RoleAdmin }
+
+// Permission is something an endpoint lets a member do. Each endpoint requires one.
+type Permission int
+
+// Permissions, from the least to the most restricted.
+const (
+	Read                Permission = iota // every role: read the organization's data, and act for oneself
+	ManageCustomers                       // every role but viewer
+	ManageSubscriptions                   // every role but viewer
+	ManagePlans                           // owner, admin, billing
+	ManageInvoices                        // owner, admin, billing
+	ViewRevenue                           // owner, admin, billing
+	ManageWebhooks                        // owner, admin
+	ManageOrg                             // owner, admin
+	ManageTeam                            // owner, admin
+)
+
+// Can reports whether a role has a permission.
+func Can(r store.Role, p Permission) bool {
+	switch p {
+	case Read:
+		return true
+	case ManageCustomers, ManageSubscriptions:
+		return CanWrite(r)
+	case ManagePlans, ManageInvoices, ViewRevenue:
+		return r == store.RoleOwner || r == store.RoleAdmin || r == store.RoleBilling
+	case ManageWebhooks, ManageOrg, ManageTeam:
+		return CanManageTeam(r)
+	}
+	return false
+}
