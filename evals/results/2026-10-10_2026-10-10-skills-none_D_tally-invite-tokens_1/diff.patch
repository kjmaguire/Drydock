+package api_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// inviteToken sends an invite as the owner and returns the token from the email, failing the test if the answer or
+// the email holds the token anywhere else.
+func inviteToken(t *testing.T, e *apitest.Env, email, role string) string {
+	t.Helper()
+	r := e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": email, "role": role}, nil)
+	msgs := e.Mail.Messages()
+	m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[len(msgs)-1].Body)
+	if m == nil {
+		t.Fatalf("no link in %q", msgs[len(msgs)-1].Body)
+	}
+	token, _ := url.QueryUnescape(m[1])
+	if strings.Contains(string(r.Body), token) {
+		t.Fatalf("the invite answer holds the token: %s", r.Body)
+	}
+	return token
+}
+
+func TestInviteTokenSecrecy(t *testing.T) {
+	e := apitest.New(t)
+	_, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	token := inviteToken(t, e, "new@people.example", "member")
+
+	// Even a viewer, who may read invites, does not see the token; the listing shows when each invite expires.
+	r := e.MustDo(http.StatusOK, "GET", "/v1/invites", viewerKey, nil, nil)
+	if strings.Contains(string(r.Body), token) {
+		t.Fatalf("the invite list holds the token: %s", r.Body)
+	}
+	var list struct {
+		Items []map[string]any `json:"items"`
+	}
+	r.JSON(t, &list)
+	if len(list.Items) != 1 || list.Items[0]["expires_at"] == nil {
+		t.Fatalf("pending invites = %s", r.Body)
+	}
+
+	b, err := json.Marshal(e.Store.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), token) {
+		t.Fatal("the snapshot holds the token")
+	}
+}
+
+func TestInviteAccept(t *testing.T) {
+	e := apitest.New(t)
+	token := inviteToken(t, e, "new@people.example", "member")
+	accept := func(token string) *apitest.Response {
+		return e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "New Person"})
+	}
+
+	if r := accept("invite_nope"); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("unknown token: %s", r)
+	}
+	if r := accept(token); r.Code != http.StatusCreated {
+		t.Fatalf("accept: %s", r)
+	}
+	if r := accept(token); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_used" {
+		t.Fatalf("a used token: %s", r)
+	}
+	var list struct{ Items []store.Invite }
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &list)
+	if len(list.Items) != 0 {
+		t.Fatalf("an accepted invite is listed: %+v", list.Items)
+	}
+}
+
+func TestInviteExpired(t *testing.T) {
+	e := apitest.New(t)
+	token := inviteToken(t, e, "late@people.example", "member")
+	e.Clock.Advance(7*24*time.Hour + time.Second)
+
+	r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "Late Person"})
+	if r.Code != http.StatusGone || r.Map(t)["error"] != "invite_expired" {
+		t.Fatalf("an expired token: %s", r)
+	}
+	if r := e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, nil); strings.Contains(string(r.Body), "late@people.example") {
+		t.Fatalf("an expired invite is listed: %s", r.Body)
+	}
+}
+
+func TestInviteReissued(t *testing.T) {
+	e := apitest.New(t)
+	old := inviteToken(t, e, "new@people.example", "member")
+	fresh := inviteToken(t, e, "NEW@people.example", "viewer")
+
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": old, "name": "New Person"}); r.Code != http.StatusNotFound {
+		t.Fatalf("the replaced token: %s", r)
+	}
+	var accepted struct {
+		Member struct {
+			Role string `json:"role"`
+		} `json:"member"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": fresh, "name": "New Person"}, &accepted)
+	if accepted.Member.Role != "viewer" {
+		t.Fatalf("accepted as %+v", accepted)
+	}
+}
+
+func TestInviteListSkipsRevoked(t *testing.T) {
+	e := apitest.New(t)
+	inviteToken(t, e, "x@people.example", "member")
+	var inv store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "y@people.example", "role": "member"}, &inv)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+inv.ID, e.Acme.Key, nil, nil)
+	var list struct{ Items []store.Invite }
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 || list.Items[0].Email != "x@people.example" {
+		t.Fatalf("pending invites = %+v", list.Items)
+	}
+}
