diff --git a/result/internal/store/invite_test.go b/result/internal/store/invite_test.go
new file mode 100644
index 0000000..403679f
--- /dev/null
+++ b/result/internal/store/invite_test.go
@@ -0,0 +1,126 @@
+package store
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestInviteTokens(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv, err := s.CreateInvite(o.ID, "New@People.example", RoleMember, "usr_1", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(inv.Token)
+	if err != nil || len(inv.Token) != 43 || len(raw) != 32 {
+		t.Fatalf("token %q is not 32 random bytes in unpadded base64url", inv.Token)
+	}
+	sum := sha256.Sum256([]byte(inv.Token))
+	if inv.TokenHash != hex.EncodeToString(sum[:]) {
+		t.Fatalf("token hash = %q", inv.TokenHash)
+	}
+	if !inv.ExpiresAt.Equal(t0.Add(InviteLifetime)) {
+		t.Fatalf("expires at %v", inv.ExpiresAt)
+	}
+
+	// The token is returned once, by CreateInvite; the store and its snapshot keep only the hash.
+	if got, _ := s.Invite(o.ID, inv.ID); got.Token != "" {
+		t.Fatal("the stored invite holds its token")
+	}
+	for _, pending := range s.Invites(o.ID) {
+		if pending.Token != "" {
+			t.Fatal("the listed invite holds its token")
+		}
+	}
+	b, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), inv.Token) {
+		t.Fatal("the snapshot holds the token")
+	}
+}
+
+func TestAcceptInvite(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	first, err := s.CreateInvite(o.ID, "new@people.example", RoleMember, "usr_1", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Inviting the same address again (ignoring case) revokes the first invite: only the newest token works.
+	second, err := s.CreateInvite(o.ID, "NEW@people.example", RoleViewer, "usr_1", t0.Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := s.AcceptInvite(first.Token, "New Person", t0.Add(time.Hour)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("the replaced token: %v", err)
+	}
+	if pending := s.PendingInvites(o.ID, t0.Add(time.Hour)); len(pending) != 1 || pending[0].ID != second.ID {
+		t.Fatalf("pending = %+v", pending)
+	}
+
+	// A snapshot keeps the hash, so the token still works after a restore.
+	restored, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := restored.AcceptInvite("invite_wrong", "X", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("a wrong token: %v", err)
+	}
+	u, m, k, err := restored.AcceptInvite(second.Token, "New Person", t0.Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if u.Email != "NEW@people.example" || m.Role != RoleViewer || k.Token == "" {
+		t.Fatalf("accepted as %+v, %+v", u, m)
+	}
+	if _, _, _, err := restored.AcceptInvite(second.Token, "New Person", t0.Add(time.Hour)); !errors.Is(err, ErrInviteUsed) {
+		t.Fatalf("a used token: %v", err)
+	}
+	if pending := restored.PendingInvites(o.ID, t0.Add(time.Hour)); len(pending) != 0 {
+		t.Fatalf("an accepted invite is pending: %+v", pending)
+	}
+}
+
+func TestInviteExpiry(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv, err := s.CreateInvite(o.ID, "late@people.example", RoleMember, "usr_1", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Seven days after creation the invite still works; a second later it has expired.
+	if pending := s.PendingInvites(o.ID, t0.Add(InviteLifetime)); len(pending) != 1 {
+		t.Fatalf("at seven days: pending = %+v", pending)
+	}
+	if pending := s.PendingInvites(o.ID, t0.Add(InviteLifetime+time.Second)); len(pending) != 0 {
+		t.Fatalf("after seven days: pending = %+v", pending)
+	}
+	if _, _, _, err := s.AcceptInvite(inv.Token, "Late", t0.Add(InviteLifetime+time.Second)); !errors.Is(err, ErrInviteExpired) {
+		t.Fatalf("an expired token: %v", err)
+	}
+}
+
+func TestRevokedInviteToken(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv, err := s.CreateInvite(o.ID, "gone@people.example", RoleMember, "usr_1", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RevokeInvite(o.ID, inv.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := s.AcceptInvite(inv.Token, "Gone", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("a revoked token: %v", err)
+	}
+}
