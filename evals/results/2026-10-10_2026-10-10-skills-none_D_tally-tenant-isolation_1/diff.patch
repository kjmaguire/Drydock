+// Only the organization that owns an endpoint can delete it.
+func TestDeleteOrgWebhookEndpoint(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ep, err := s.CreateWebhookEndpoint(WebhookEndpoint{OrgID: b.ID, URL: "https://hooks.b.example/", Events: []string{"*"}, Enabled: true}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.DeleteOrgWebhookEndpoint(a.ID, ep.ID); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("another org deleted the endpoint: %v", err)
+	}
+	if _, ok := s.WebhookEndpoint(b.ID, ep.ID); !ok {
+		t.Fatal("the endpoint is gone after another org's delete")
+	}
+	if err := s.DeleteOrgWebhookEndpoint(b.ID, ep.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.WebhookEndpoint(b.ID, ep.ID); ok {
+		t.Fatal("the owner's delete did not remove the endpoint")
+	}
+}
