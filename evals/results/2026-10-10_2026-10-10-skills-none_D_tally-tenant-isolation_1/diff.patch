+package api_test
+
+import (
+	"net/http"
+	"net/url"
+	"slices"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// TestAnotherOrgsIDsAnswerLikeUnknownOnes sends every request that names an object by ID, with the ID of a Globex object and
+// with an ID that does not exist, as Acme. Each must answer the same as the other, and Globex's objects must be unchanged.
+func TestAnotherOrgsIDsAnswerLikeUnknownOnes(t *testing.T) {
+	e := apitest.New(t)
+	ac := e.CreateCustomer(e.Acme, "Ann", "ann@acme.example")
+	ap := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+
+	gc := e.CreateCustomer(e.Globex, "Gus", "gus@globex.example")
+	gp := e.CreatePlan(e.Globex, "Business", "EUR", "30.00")
+	var gs store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Globex.Key, map[string]any{"customer_id": gc.ID, "plan_id": gp.ID}, &gs)
+	var gi struct{ ID string `json:"id"` }
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Globex.Key, map[string]any{"customer_id": gc.ID, "currency": "EUR",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 1000}}}, &gi)
+	var ge store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Globex.Key, map[string]any{"url": "https://hooks.globex.example/tally", "events": []string{"*"}}, &ge)
+	var gInvite store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Globex.Key, map[string]string{"email": "new@globex.example", "role": "member"}, &gInvite)
+	var gKey store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Globex.Key, map[string]string{"name": "ci"}, &gKey)
+	gEvents := e.Store.Events(e.Globex.ID, "")
+	if len(gEvents) == 0 {
+		t.Fatal("Globex has no events")
+	}
+
+	const unknown = "nope_000001"
+	fixed := func(v any) func(string) any { return func(string) any { return v } }
+	probes := []struct {
+		name    string
+		method  string
+		path    string // {id} is replaced by the ID
+		foreign string // the Globex object's ID
+		body    func(id string) any
+		status  int // the answer for an unknown ID
+	}{
+		{"get customer", "GET", "/v1/customers/{id}", gc.ID, nil, http.StatusNotFound},
+		{"update customer", "PATCH", "/v1/customers/{id}", gc.ID, fixed(map[string]string{"name": "X"}), http.StatusNotFound},
+		{"delete customer", "DELETE", "/v1/customers/{id}", gc.ID, nil, http.StatusNotFound},
+		{"get plan", "GET", "/v1/plans/{id}", gp.ID, nil, http.StatusNotFound},
+		{"update plan", "PATCH", "/v1/plans/{id}", gp.ID, fixed(map[string]string{"name": "X"}), http.StatusNotFound},
+		{"get subscription", "GET", "/v1/subscriptions/{id}", gs.ID, nil, http.StatusNotFound},
+		{"update subscription", "PATCH", "/v1/subscriptions/{id}", gs.ID, fixed(map[string]int{"quantity": 5}), http.StatusNotFound},
+		{"cancel subscription", "POST", "/v1/subscriptions/{id}/cancel", gs.ID, nil, http.StatusNotFound},
+		{"report usage", "POST", "/v1/subscriptions/{id}/usage", gs.ID, fixed(map[string]int{"quantity": 1}), http.StatusNotFound},
+		{"get invoice", "GET", "/v1/invoices/{id}", gi.ID, nil, http.StatusNotFound},
+		{"get invoice lines", "GET", "/v1/invoices/{id}/lines", gi.ID, nil, http.StatusNotFound},
+		{"pay invoice", "POST", "/v1/invoices/{id}/pay", gi.ID, nil, http.StatusNotFound},
+		{"void invoice", "POST", "/v1/invoices/{id}/void", gi.ID, nil, http.StatusNotFound},
+		{"get webhook endpoint", "GET", "/v1/webhook-endpoints/{id}", ge.ID, nil, http.StatusNotFound},
+		{"update webhook endpoint", "PATCH", "/v1/webhook-endpoints/{id}", ge.ID, fixed(map[string]bool{"enabled": false}), http.StatusNotFound},
+		{"delete webhook endpoint", "DELETE", "/v1/webhook-endpoints/{id}", ge.ID, nil, http.StatusNotFound},
+		{"list webhook deliveries", "GET", "/v1/webhook-endpoints/{id}/deliveries", ge.ID, nil, http.StatusNotFound},
+		{"get event", "GET", "/v1/events/{id}", gEvents[0].ID, nil, http.StatusNotFound},
+		{"update member", "PATCH", "/v1/members/{id}", e.Globex.Owner.ID, fixed(map[string]string{"role": "viewer"}), http.StatusNotFound},
+		{"remove member", "DELETE", "/v1/members/{id}", e.Globex.Owner.ID, nil, http.StatusNotFound},
+		{"revoke invite", "DELETE", "/v1/invites/{id}", gInvite.ID, nil, http.StatusNotFound},
+		{"revoke api key", "DELETE", "/v1/api-keys/{id}", gKey.ID, nil, http.StatusNotFound},
+		// IDs named in a body: the answer is the one for an unknown customer or plan.
+		{"invoice for customer", "POST", "/v1/invoices", gc.ID, func(id string) any {
+			return map[string]any{"customer_id": id, "currency": "USD", "lines": []map[string]any{{"description": "x", "quantity": 1, "unit_amount": 100}}}
+		}, http.StatusNotFound},
+		{"subscription for customer", "POST", "/v1/subscriptions", gc.ID, func(id string) any {
+			return map[string]any{"customer_id": id, "plan_id": ap.ID}
+		}, http.StatusNotFound},
+		{"subscription for plan", "POST", "/v1/subscriptions", gp.ID, func(id string) any {
+			return map[string]any{"customer_id": ac.ID, "plan_id": id}
+		}, http.StatusNotFound},
+		// IDs named in a query: the list is empty either way.
+		{"invoices of customer", "GET", "/v1/invoices?customer_id={id}", gc.ID, nil, http.StatusOK},
+		{"subscriptions of customer", "GET", "/v1/subscriptions?customer_id={id}", gc.ID, nil, http.StatusOK},
+		{"payments of invoice", "GET", "/v1/payments?invoice_id={id}", gi.ID, nil, http.StatusOK},
+	}
+	for _, p := range probes {
+		t.Run(p.name, func(t *testing.T) {
+			body := p.body
+			if body == nil {
+				body = func(string) any { return nil }
+			}
+			unknownAnswer := e.Do(p.method, strings.ReplaceAll(p.path, "{id}", unknown), e.Acme.Key, body(unknown))
+			if unknownAnswer.Code != p.status {
+				t.Fatalf("an unknown ID answered %s, want %d", unknownAnswer, p.status)
+			}
+			foreignAnswer := e.Do(p.method, strings.ReplaceAll(p.path, "{id}", p.foreign), e.Acme.Key, body(p.foreign))
+			if foreignAnswer.Code != unknownAnswer.Code || string(foreignAnswer.Body) != string(unknownAnswer.Body) {
+				t.Fatalf("another org's ID answered %s, an unknown ID answered %s", foreignAnswer, unknownAnswer)
+			}
+		})
+	}
+
+	// Globex's objects are still there and unchanged.
+	e.MustDo(http.StatusOK, "GET", "/v1/customers/"+gc.ID, e.Globex.Key, nil, nil)
+	e.MustDo(http.StatusOK, "GET", "/v1/plans/"+gp.ID, e.Globex.Key, nil, nil)
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions/"+gs.ID, e.Globex.Key, nil, nil)
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+gi.ID, e.Globex.Key, nil, nil)
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+ge.ID, e.Globex.Key, nil, nil)
+	if _, ok := e.Store.Member(e.Globex.ID, e.Globex.Owner.ID); !ok {
+		t.Fatal("Globex's owner was removed")
+	}
+	if got, ok := e.Store.Invite(e.Globex.ID, gInvite.ID); !ok || got.RevokedAt != nil {
+		t.Fatal("Globex's invite was revoked")
+	}
+	if got, ok := e.Store.APIKey(e.Globex.ID, gKey.ID); !ok || got.RevokedAt != nil {
+		t.Fatal("Globex's API key was revoked")
+	}
+}
+
+// TestCustomerEmailLookupIsPerOrganization: two organizations can each have a customer with the same email address, and a
+// lookup by email finds only the caller's own.
+func TestCustomerEmailLookupIsPerOrganization(t *testing.T) {
+	e := apitest.New(t)
+	gc := e.CreateCustomer(e.Globex, "Gus", "shared@example.com")
+	byEmail := func(key, email string) []string {
+		t.Helper()
+		var page struct {
+			Items []store.Customer `json:"items"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/customers?email="+url.QueryEscape(email), key, nil, &page)
+		ids := []string{}
+		for _, c := range page.Items {
+			ids = append(ids, c.ID)
+		}
+		return ids
+	}
+	if got := byEmail(e.Acme.Key, "shared@example.com"); len(got) != 0 {
+		t.Fatalf("Acme finds Globex's customer: %v", got)
+	}
+
+	ac := e.CreateCustomer(e.Acme, "Ann", "shared@example.com")
+	if got := byEmail(e.Acme.Key, "SHARED@example.com"); !slices.Equal(got, []string{ac.ID}) {
+		t.Fatalf("Acme finds %v, want its own customer %s", got, ac.ID)
+	}
+	if got := byEmail(e.Globex.Key, "shared@example.com"); !slices.Equal(got, []string{gc.ID}) {
+		t.Fatalf("Globex finds %v, want its own customer %s", got, gc.ID)
+	}
+
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+ac.ID, e.Acme.Key, nil, nil)
+	if got := byEmail(e.Acme.Key, "shared@example.com"); len(got) != 0 {
+		t.Fatalf("Acme finds %v after deleting its customer", got)
+	}
+	if got := byEmail(e.Globex.Key, "shared@example.com"); !slices.Equal(got, []string{gc.ID}) {
+		t.Fatalf("Globex finds %v after Acme's delete", got)
+	}
+
+	var ann store.Customer
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Ann", "email": "shared@example.com"}, &ann)
+	if r := e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Ann 2", "email": "SHARED@example.com"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "email_taken" {
+		t.Fatalf("duplicate in Acme: %s", r)
+	}
+	other := e.CreateCustomer(e.Acme, "Ann", "ann@acme.example")
+	if r := e.Do("PATCH", "/v1/customers/"+other.ID, e.Acme.Key, map[string]string{"email": "shared@example.com"}); r.Code != http.StatusConflict {
+		t.Fatalf("renaming to Acme's own address: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+ann.ID, e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+other.ID, e.Acme.Key, map[string]string{"email": "shared@example.com"}, nil)
+	if got := byEmail(e.Acme.Key, "shared@example.com"); !slices.Equal(got, []string{other.ID}) {
+		t.Fatalf("Acme finds %v after renaming its customer", got)
+	}
+	if got := byEmail(e.Globex.Key, "shared@example.com"); !slices.Equal(got, []string{gc.ID}) {
+		t.Fatalf("Globex finds %v after Acme's rename", got)
+	}
+}
