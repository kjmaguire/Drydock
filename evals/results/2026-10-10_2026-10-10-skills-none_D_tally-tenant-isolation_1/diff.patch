+package store
+
+import (
+	"errors"
+	"testing"
+
+	"example.com/tally/internal/money"
+)
+
+// Customer emails are unique within an organization only: each organization can have its own customer with the same
+// address, and each finds only its own.
+func TestCustomerEmailsArePerOrganization(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	bc, err := s.CreateCustomer(b.ID, "Bea", "shared@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ac, err := s.CreateCustomer(a.ID, "Ann", "shared@example.com", t0)
+	if err != nil {
+		t.Fatalf("the same email in another org was refused: %v", err)
+	}
+	if _, err := s.CreateCustomer(b.ID, "Bo", "only-b@example.com", t0); err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "SHARED@example.com"); !ok || got.ID != ac.ID {
+		t.Fatalf("org A finds %+v, %v", got, ok)
+	}
+	if got, ok := s.FindCustomerByEmail(b.ID, "shared@example.com"); !ok || got.ID != bc.ID {
+		t.Fatalf("org B finds %+v, %v", got, ok)
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "only-b@example.com"); ok {
+		t.Fatal("org A finds another org's customer by email")
+	}
+	if _, err := s.CreateCustomer(a.ID, "Ann 2", "shared@example.com", t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("duplicate email in one org: %v", err)
+	}
+	if err := s.DeleteCustomer(a.ID, ac.ID); err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s.FindCustomerByEmail(b.ID, "shared@example.com"); !ok || got.ID != bc.ID {
+		t.Fatalf("deleting org A's customer changed org B's lookup: %+v, %v", got, ok)
+	}
+
+	// The index is rebuilt from a snapshot with the same per-organization keys.
+	ac, _ = s.CreateCustomer(a.ID, "Ann", "shared@example.com", t0)
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s2.FindCustomerByEmail(a.ID, "shared@example.com"); !ok || got.ID != ac.ID {
+		t.Fatalf("after FromState, org A finds %+v, %v", got, ok)
+	}
+	if got, ok := s2.FindCustomerByEmail(b.ID, "shared@example.com"); !ok || got.ID != bc.ID {
+		t.Fatalf("after FromState, org B finds %+v, %v", got, ok)
+	}
+}
+
+// Changing a customer's email moves its index entry within its organization only.
+func TestUpdateCustomerEmailIsPerOrganization(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	bc, _ := s.CreateCustomer(b.ID, "Bea", "shared@example.com", t0)
+	ac, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	if _, err := s.UpdateCustomer(a.ID, ac.ID, func(c *Customer) error { c.Email = "shared@example.com"; return nil }); err != nil {
+		t.Fatalf("moving to an email another org uses: %v", err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "ann@example.com"); ok {
+		t.Fatalf("the old address still finds %+v", got)
