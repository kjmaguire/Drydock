+// A subscription or an invoice names a customer of its own organization only; another organization's customer is
+// ErrNotFound, the same as a customer that does not exist.
+func TestCustomerOfAnotherOrgIsNotFound(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	bc, _ := s.CreateCustomer(b.ID, "Bea", "bea@example.com", t0)
+	p, err := s.CreatePlan(Plan{OrgID: a.ID, Name: "Pro", Currency: money.USD, UnitAmount: 100, Interval: Monthly}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub := Subscription{OrgID: a.ID, CustomerID: bc.ID, PlanID: p.ID, Quantity: 1, Status: Active}
+	if _, err := s.CreateSubscription(sub, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for another org's customer: %v", err)
+	}
+	if got := s.Subscriptions(a.ID, SubscriptionFilter{}); len(got) != 0 {
+		t.Fatalf("a subscription was stored: %+v", got)
+	}
+	inv := Invoice{OrgID: a.ID, CustomerID: bc.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}
+	if _, err := s.CreateInvoice(inv, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for another org's customer: %v", err)
+	}
+	if got := s.ListInvoices(a.ID, InvoiceFilter{}); len(got) != 0 {
+		t.Fatalf("an invoice was stored: %+v", got)
+	}
+}
