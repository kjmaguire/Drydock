+// waitDone fails the test unless ch is closed within a few seconds.
+func waitDone(t *testing.T, ch <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("%s did not happen", what)
+	}
+}
+
+// waitClosed waits until Shutdown has been called on r.
+func waitClosed(t *testing.T, r *Runner) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		r.mu.Lock()
+		closed := r.closed
+		r.mu.Unlock()
+		if closed {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("Shutdown was not called")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// shutdownResult runs Shutdown in a goroutine and returns the channel its result arrives on.
+func shutdownResult(r *Runner, ctx context.Context) <-chan error {
+	ch := make(chan error, 1)
+	go func() { ch <- r.Shutdown(ctx) }()
+	return ch
+}
+
+func names(jobs []Job) []string {
+	out := make([]string, len(jobs))
+	for i, j := range jobs {
+		out[i] = j.Name
+	}
+	return out
+}
