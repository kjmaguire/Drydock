+// Pending returns the jobs that still need to run, in enqueue order. Before Shutdown these are the queued jobs.
+// After Shutdown they are the jobs that were never started, followed by the jobs whose context Shutdown
+// cancelled and that returned an error.
+func (r *Runner) Pending() []Job {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	sort.Slice(r.interrupted, func(i, j int) bool { return r.interrupted[i].seq < r.interrupted[j].seq })
+	out := make([]Job, 0, len(r.queue)+len(r.interrupted))
+	for _, t := range r.queue {
