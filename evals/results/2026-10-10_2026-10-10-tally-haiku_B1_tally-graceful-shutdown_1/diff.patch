+	}
+	// Jobs never started come first, then the cancelled job that returned an error.
+	if got, want := names(r.Pending()), []string{"second", "third", "first"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("Pending = %v, want %v", got, want)
+	}
