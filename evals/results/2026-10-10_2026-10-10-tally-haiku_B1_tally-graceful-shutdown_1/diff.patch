+func TestShutdownCancelsRunningJobsAfterTimeout(t *testing.T) {
+	r := NewRunner(2, 10, nil)
+	r.Start()
+	started := make(chan struct{}, 2)
+	var sawCancel atomic.Int32
+	job := func(name string) Job {
+		return Job{Name: name, Run: func(ctx context.Context) error {
+			started <- struct{}{}
+			<-ctx.Done()
+			sawCancel.Add(1)
+			return nil // returning nil after cancellation counts as finished, not pending
+		}}
+	}
+	for _, name := range []string{"a", "b"} {
+		if err := r.Enqueue(job(name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	waitDone(t, started, "first job start")
+	waitDone(t, started, "second job start")
+
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if err := r.Shutdown(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Shutdown = %v, want DeadlineExceeded", err)
+	}
+	if n := sawCancel.Load(); n != 2 {
+		t.Fatalf("%d jobs saw their context cancelled, want 2", n)
+	}
+	if got := r.Pending(); len(got) != 0 {
