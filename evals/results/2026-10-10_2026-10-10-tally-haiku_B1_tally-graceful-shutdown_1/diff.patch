+func TestShutdownLeavesNoGoroutines(t *testing.T) {
+	before := runtime.NumGoroutine()
+	r := NewRunner(3, 10, nil)
+	r.Start()
+	for i := 0; i < 3; i++ {
+		if err := r.Enqueue(Job{Name: "n", Run: func(context.Context) error { return nil }}); err != nil {
+			t.Fatal(err)
