+// checkTiers checks a plan's tiers: only a metered plan has them, with a known mode, at least one tier, sorted by up_to, and
+// with no up_to on the last tier only.
+func checkTiers(p Plan) error {
+	if p.Tiers == nil {
+		if p.TiersMode != "" {
+			return invalidTiers("tiers_mode needs tiers")
+		}
+		return nil
+	}
+	switch {
+	case p.UsageType != Metered:
+		return invalidTiers("only a metered plan has tiers")
+	case p.TiersMode != Graduated && p.TiersMode != Volume:
+		return invalidTiers("tiers_mode is graduated or volume")
+	case len(p.Tiers) == 0:
+		return invalidTiers("a plan has at least one tier")
+	}
+	var prev int64
+	for i, t := range p.Tiers {
+		last := i == len(p.Tiers)-1
+		switch {
+		case t.UnitAmount < 0 || t.FlatAmount < 0:
+			return invalidTiers("a tier's amounts cannot be negative")
+		case last && t.UpTo != nil:
+			return invalidTiers("the last tier has no up_to")
+		case !last && (t.UpTo == nil || *t.UpTo <= prev):
+			return invalidTiers("a tier's up_to is a positive whole number above the one before")
+		}
+		if t.UpTo != nil {
+			prev = *t.UpTo
+		}
+	}
 	return nil
 }
 
