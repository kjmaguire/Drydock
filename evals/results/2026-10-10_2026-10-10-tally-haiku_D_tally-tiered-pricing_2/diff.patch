+func TestTieredUsageIsOneLine(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	up := func(n int64) *int64 { return &n }
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, Interval: store.Monthly, UsageType: store.Metered,
+		TiersMode: store.Graduated, Tiers: []store.Tier{{UpTo: up(100), UnitAmount: 10}, {UnitAmount: 5, FlatAmount: 300}}}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	start, end := sub.CurrentPeriodStart, sub.CurrentPeriodEnd
+	if _, err := e.Store.AddUsage(e.Acme.ID, sub.ID, 150, start, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(end)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	// Graduated: 100 units at 10 plus 50 units at 5, and the second tier's flat 300.
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 1 || len(invs[0].Lines) != 1 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	if l := invs[0].Lines[0]; l.Quantity != 1 || l.UnitAmount != 1550 || !strings.HasPrefix(l.Description, "API calls") {
+		t.Fatalf("line = %+v", l)
+	}
+
+	// The next period has no usage, so renewing it adds no invoice.
+	next, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	e.Clock.Set(next.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("invoices = %d after an unused period, want 1", len(invs))
+	}
+}
