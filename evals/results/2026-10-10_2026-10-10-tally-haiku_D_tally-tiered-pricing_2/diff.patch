+// parseTiers reads tiers typed in major units into minor units. Without tiers in the request it returns nil; with an empty
+// list it returns an empty list, which the store refuses.
+func parseTiers(in []tierIn, c money.Currency) ([]store.Tier, error) {
+	if in == nil {
+		return nil, nil
+	}
+	out := make([]store.Tier, 0, len(in))
+	for _, t := range in {
+		upTo, err := parseUpTo(t.UpTo)
+		if err != nil {
+			return nil, err
+		}
+		unit, err := money.ParseMajor(t.UnitAmount, c)
+		if err != nil {
+			return nil, err
+		}
+		var flat int64
+		if t.FlatAmount != "" {
+			if flat, err = money.ParseMajor(t.FlatAmount, c); err != nil {
+				return nil, err
+			}
+		}
+		out = append(out, store.Tier{UpTo: upTo, UnitAmount: unit, FlatAmount: flat})
+	}
+	return out, nil
+}
+
+// parseUpTo reads a tier's up_to: null (or left out) is no limit; anything else must be a positive whole number.
+func parseUpTo(raw json.RawMessage) (*int64, error) {
+	if len(raw) == 0 || string(raw) == "null" {
+		return nil, nil
+	}
+	n, err := strconv.ParseInt(string(raw), 10, 64)
+	if err != nil || n < 1 {
+		return nil, errors.New("up_to is a positive whole number, or null for no limit")
+	}
+	return &n, nil
+}
