+// TieredAmount is the charge, in minor units, for quantity units of usage on tiers. Graduated: each unit is priced at the unit
+// amount of the tier it falls in, and every tier that at least one unit falls in adds its flat amount. Volume: every unit is
+// priced at the unit amount of the one tier the quantity falls in, which adds its flat amount. A tier's up_to is inclusive,
+// and a quantity of 0 costs 0.
+func TieredAmount(tiers []store.Tier, mode store.TiersMode, quantity int64) int64 {
+	if quantity <= 0 {
+		return 0
+	}
+	if mode == store.Volume {
+		for _, t := range tiers {
+			if t.UpTo == nil || quantity <= *t.UpTo {
+				return quantity*t.UnitAmount + t.FlatAmount
+			}
+		}
+		return 0
+	}
+	var total, from int64 // the units up to from are priced by the tiers before
+	for _, t := range tiers {
+		to := quantity
+		if t.UpTo != nil && *t.UpTo < to {
+			to = *t.UpTo
+		}
+		if to <= from {
+			break
+		}
+		total += (to-from)*t.UnitAmount + t.FlatAmount
+		from = to
+	}
+	return total
+}
