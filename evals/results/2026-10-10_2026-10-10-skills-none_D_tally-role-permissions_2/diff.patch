+package api_test
+
+import (
+	"net/http"
+	"slices"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// Role groups, as the roles table names them.
+var (
+	allRoles  = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer}
+	everyone  = allRoles
+	notViewer = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember}
+	billers   = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling}
+	managers  = []store.Role{store.RoleOwner, store.RoleAdmin}
+)
+
+// wantForbidden checks that r is refused as 403 {"error":"forbidden"}.
+func wantForbidden(t *testing.T, r *apitest.Response) {
+	t.Helper()
+	if r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+		t.Fatalf("want 403 forbidden, got %s", r)
+	}
+}
+
+// keyID is the ID of the API key a token is.
+func keyID(e *apitest.Env, token string) string {
+	e.T.Helper()
+	var me struct {
+		APIKeyID string `json:"api_key_id"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", token, nil, &me)
+	return me.APIKeyID
+}
+
+// roleFixture is an organization with objects to call the endpoints on: target is a viewer member, spareKey an API key of
+// the owner's.
+type roleFixture struct {
+	customer, plan, subscription, invoice, endpoint, target, spareKey string
+}
+
+func newRoleFixture(e *apitest.Env) roleFixture {
+	e.T.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": p.ID, "quantity": 2}, &sub)
+	var invs struct{ Items []store.Invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?customer_id="+c.ID, e.Acme.Key, nil, &invs)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	target, _ := e.AddMember(e.Acme, "target@acme.example", store.RoleViewer)
+	var spare store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "Spare"}, &spare)
+	return roleFixture{
+		customer: c.ID, plan: p.ID, subscription: sub.ID, invoice: invs.Items[0].ID, endpoint: ep.ID,
+		target: target.ID, spareKey: spare.ID,
+	}
+}
+
+// roleCall is one request of the roles table and the roles that may make it.
+type roleCall struct {
+	method, path string
+	body         any
+	allow        []store.Role
+}
+
+func roleCalls(x roleFixture) []roleCall {
+	return []roleCall{
+		// Reads.
+		{"GET", "/v1/org", nil, everyone},
+		{"GET", "/v1/members", nil, everyone},
+		{"GET", "/v1/invites", nil, everyone},
+		{"GET", "/v1/customers", nil, everyone},
+		{"GET", "/v1/customers/" + x.customer, nil, everyone},
+		{"GET", "/v1/customers/export.csv", nil, everyone},
+		{"GET", "/v1/plans", nil, everyone},
+		{"GET", "/v1/plans/" + x.plan, nil, everyone},
+		{"GET", "/v1/subscriptions", nil, everyone},
+		{"GET", "/v1/subscriptions/" + x.subscription, nil, everyone},
+		{"GET", "/v1/invoices", nil, everyone},
+		{"GET", "/v1/invoices/" + x.invoice, nil, everyone},
+		{"GET", "/v1/invoices/" + x.invoice + "/lines", nil, everyone},
+		{"GET", "/v1/payments", nil, everyone},
+		{"GET", "/v1/reports/revenue", nil, billers},
+		{"GET", "/v1/webhook-endpoints", nil, managers},
+		{"GET", "/v1/webhook-endpoints/" + x.endpoint, nil, managers},
+		{"GET", "/v1/webhook-endpoints/" + x.endpoint + "/deliveries", nil, managers},
+		{"GET", "/v1/events", nil, managers},
+		{"GET", "/v1/events/evt_missing", nil, managers},
+
+		// Customers, subscriptions and usage: not viewers.
+		{"POST", "/v1/customers", map[string]string{"name": "New", "email": "new@example.com"}, notViewer},
+		{"PATCH", "/v1/customers/" + x.customer, map[string]string{"name": "Renamed"}, notViewer},
+		{"DELETE", "/v1/customers/" + x.customer, nil, notViewer},
+		{"POST", "/v1/subscriptions", map[string]any{"customer_id": x.customer, "plan_id": x.plan, "quantity": 1}, notViewer},
+		{"PATCH", "/v1/subscriptions/" + x.subscription, map[string]any{"quantity": 3}, notViewer},
+		{"POST", "/v1/subscriptions/" + x.subscription + "/usage", map[string]any{"quantity": 1}, notViewer},
+		{"POST", "/v1/subscriptions/" + x.subscription + "/cancel", nil, notViewer},
+
+		// Plans, invoices and the revenue report: owners, admins and billing.
+		{"POST", "/v1/plans", map[string]string{"name": "Pro", "currency": "USD", "price": "5.00", "interval": "month"}, billers},
+		{"PATCH", "/v1/plans/" + x.plan, map[string]string{"name": "Team 2"}, billers},
+		{"POST", "/v1/invoices", map[string]string{"customer_id": x.customer}, billers},
+		{"POST", "/v1/invoices/" + x.invoice + "/pay", nil, billers},
+		{"POST", "/v1/invoices/" + x.invoice + "/void", nil, billers},
+
+		// Webhooks: owners and admins only.
+		{"POST", "/v1/webhook-endpoints", map[string]any{"url": "https://hooks.acme.example/two", "events": []string{"*"}}, managers},
+		{"PATCH", "/v1/webhook-endpoints/" + x.endpoint, map[string]any{"enabled": false}, managers},
+		{"DELETE", "/v1/webhook-endpoints/" + x.endpoint, nil, managers},
+
+		// The organization, invites and members: owners and admins only.
+		{"PATCH", "/v1/org", map[string]string{"name": "Acme 2"}, managers},
+		{"POST", "/v1/invites", map[string]string{"email": "new@people.example", "role": "member"}, managers},
+		{"DELETE", "/v1/invites/inv_missing", nil, managers},
+		{"PATCH", "/v1/members/" + x.target, map[string]string{"role": "member"}, managers},
+		{"DELETE", "/v1/members/" + x.target, nil, managers},
+
+		// API keys: anyone may create one; revoking someone else's key is for owners and admins.
+		{"POST", "/v1/api-keys", map[string]string{"name": "Another"}, everyone},
+		{"DELETE", "/v1/api-keys/" + x.spareKey, nil, managers},
+	}
+}
+
+// TestRoleTable makes every request of the roles table as each role. A role that may not make a request gets 403
+// forbidden; a role that may gets an answer other than that.
+func TestRoleTable(t *testing.T) {
+	for _, role := range allRoles {
+		t.Run(string(role), func(t *testing.T) {
+			e := apitest.New(t)
+			x := newRoleFixture(e)
+			key := e.Acme.Key
+			if role != store.RoleOwner {
+				_, key = e.AddMember(e.Acme, string(role)+"@acme.example", role)
+			}
+			for _, c := range roleCalls(x) {
+				r := e.Do(c.method, c.path, key, c.body)
+				if slices.Contains(c.allow, role) {
+					if r.Code == http.StatusForbidden {
+						t.Errorf("%s %s: %s may, but got %s", c.method, c.path, role, r)
+					}
+					continue
+				}
+				if r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+					t.Errorf("%s %s: %s may not, but got %s", c.method, c.path, role, r)
+				}
+			}
+		})
+	}
+}
+
+// TestRoleChangeAppliesToExistingKey checks that a member's key follows the member's role at once.
+func TestRoleChangeAppliesToExistingKey(t *testing.T) {
+	e := apitest.New(t)
+	member, key := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", key, map[string]string{"name": "Jane", "email": "jane@example.com"}, nil)
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, e.Acme.Key, map[string]string{"role": "viewer"}, nil)
+	wantForbidden(t, e.Do("POST", "/v1/customers", key, map[string]string{"name": "Ann", "email": "ann@example.com"}))
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", key, nil, nil)
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, e.Acme.Key, map[string]string{"role": "billing"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/plans", key, map[string]string{"name": "Pro", "currency": "USD", "price": "5.00", "interval": "month"}, nil)
+}
+
+// TestMemberRules checks who may change or remove whom, and that anyone may leave.
+func TestMemberRules(t *testing.T) {
+	e := apitest.New(t)
+	admin, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	admin2, _ := e.AddMember(e.Acme, "admin2@acme.example", store.RoleAdmin)
+	member, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	owner := e.Acme.Owner.ID
+
+	// Nobody changes their own role, whatever it is; the only owner demoting themselves is last_owner.
+	if r := e.Do("PATCH", "/v1/members/"+owner, e.Acme.Key, map[string]string{"role": "admin"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the only owner demotes themselves: %s", r)
+	}
+	wantForbidden(t, e.Do("PATCH", "/v1/members/"+admin.ID, adminKey, map[string]string{"role": "member"}))
+	wantForbidden(t, e.Do("PATCH", "/v1/members/"+viewer.ID, viewerKey, map[string]string{"role": "member"}))
+
+	// An admin may not give the owner or admin role, or change or remove an owner or an admin.
+	wantForbidden(t, e.Do("PATCH", "/v1/members/"+member.ID, adminKey, map[string]string{"role": "admin"}))
+	wantForbidden(t, e.Do("PATCH", "/v1/members/"+member.ID, adminKey, map[string]string{"role": "owner"}))
+	wantForbidden(t, e.Do("PATCH", "/v1/members/"+owner, adminKey, map[string]string{"role": "member"}))
+	wantForbidden(t, e.Do("PATCH", "/v1/members/"+admin2.ID, adminKey, map[string]string{"role": "member"}))
+	wantForbidden(t, e.Do("DELETE", "/v1/members/"+admin2.ID, adminKey, nil))
+	wantForbidden(t, e.Do("DELETE", "/v1/members/"+owner, adminKey, nil))
+
+	// ...but may change and remove the others.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, adminKey, map[string]string{"role": "billing"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+viewer.ID, adminKey, nil, nil)
+
+	// Members other than owners and admins manage no one.
+	wantForbidden(t, e.Do("DELETE", "/v1/members/"+admin.ID, memberKey, nil))
+	wantForbidden(t, e.Do("PATCH", "/v1/members/"+admin.ID, memberKey, map[string]string{"role": "member"}))
+
+	// Anyone may leave, and then their key stops working.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+member.ID, memberKey, nil, nil)
+	if r := e.Do("GET", "/v1/me", memberKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a member who left: %s", r)
+	}
+}
+
+// TestLastOwner checks that an organization keeps an owner: the only one cannot leave or be demoted.
+func TestLastOwner(t *testing.T) {
+	e := apitest.New(t)
+	owner2, owner2Key := e.AddMember(e.Acme, "owner2@acme.example", store.RoleOwner)
+
+	// An owner with a co-owner present may not change their own role.
+	wantForbidden(t, e.Do("PATCH", "/v1/members/"+e.Acme.Owner.ID, e.Acme.Key, map[string]string{"role": "member"}))
+
+	// With two owners, one may demote the other and then is the only one.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+e.Acme.Owner.ID, owner2Key, map[string]string{"role": "admin"}, nil)
+	var r struct {
+		Error string `json:"error"`
+	}
+	resp := e.Do("DELETE", "/v1/members/"+owner2.ID, owner2Key, nil)
+	resp.JSON(t, &r)
+	if resp.Code != http.StatusConflict || r.Error != "last_owner" {
+		t.Fatalf("the only owner leaves: %s", resp)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", owner2Key, nil, nil)
+
+	// The only owner may not demote themselves either.
+	resp = e.Do("PATCH", "/v1/members/"+owner2.ID, owner2Key, map[string]string{"role": "member"})
+	resp.JSON(t, &r)
+	if resp.Code != http.StatusConflict || r.Error != "last_owner" {
+		t.Fatalf("the only owner demotes themselves: %s", resp)
+	}
+}
+
+// TestAPIKeyRules checks who may list and revoke which API keys.
+func TestAPIKeyRules(t *testing.T) {
+	e := apitest.New(t)
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	_, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	viewer, viewerKey := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	ownerKey := e.Acme.Key
+
+	var own store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", viewerKey, map[string]string{"name": "CI"}, &own)
+
+	// Owners and admins list every key; anyone else lists their own.
+	var all struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", ownerKey, nil, &all)
+	if len(all.Items) != 5 {
+		t.Fatalf("the owner lists %d keys, want 5", len(all.Items))
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", adminKey, nil, &all)
+	if len(all.Items) != 5 {
+		t.Fatalf("the admin lists %d keys, want 5", len(all.Items))
+	}
+	var mine struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", viewerKey, nil, &mine)
+	if len(mine.Items) != 2 {
+		t.Fatalf("the viewer lists %d keys, want 2", len(mine.Items))
+	}
+	for _, k := range mine.Items {
+		if k.UserID != viewer.ID {
+			t.Fatalf("the viewer sees a key of %s", k.UserID)
+		}
+	}
+
+	// Anyone may revoke their own keys; others' keys only owners and admins may.
+	wantForbidden(t, e.Do("DELETE", "/v1/api-keys/"+keyID(e, ownerKey), viewerKey, nil))
+	wantForbidden(t, e.Do("DELETE", "/v1/api-keys/"+keyID(e, adminKey), memberKey, nil))
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+own.ID, viewerKey, nil, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+keyID(e, memberKey), adminKey, nil, nil)
+	if r := e.Do("GET", "/v1/me", memberKey, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a revoked key: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/api-keys/key_missing", ownerKey, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("revoke a missing key: %s", r)
+	}
+}
+
+// TestInviteRoles checks which roles an invite may give: only owners give the owner or admin role.
+func TestInviteRoles(t *testing.T) {
+	e := apitest.New(t)
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+
+	wantForbidden(t, e.Do("POST", "/v1/invites", adminKey, map[string]string{"email": "a@people.example", "role": "admin"}))
+	wantForbidden(t, e.Do("POST", "/v1/invites", adminKey, map[string]string{"email": "o@people.example", "role": "owner"}))
+	var pending struct{ Items []store.Invite }
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", adminKey, nil, &pending)
+	if len(pending.Items) != 0 {
+		t.Fatalf("a refused invite left %d pending", len(pending.Items))
+	}
+
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", adminKey, map[string]string{"email": "m@people.example", "role": "member"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "a@people.example", "role": "admin"}, nil)
+	if r := e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "o@people.example", "role": "owner"}); r.Code != http.StatusUnprocessableEntity {
+		t.Fatalf("an invite as owner: %s", r)
+	}
+}
