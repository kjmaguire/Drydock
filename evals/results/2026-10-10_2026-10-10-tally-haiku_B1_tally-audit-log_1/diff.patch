+// pageNewestFirst is pageOf for items sorted newest first: a page holds the items older than its cursor.
+func pageNewestFirst[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	start := 0
+	if p.after != nil {
+		start = len(items)
+		for i, it := range items {
+			if key(it).less(*p.after) {
+				start = i
+				break
+			}
+		}
+	}
+	return cutPage(items, key, p, start)
+}
+
+// cutPage returns the page of items that starts at start, and the cursor of the page after it.
+func cutPage[T any](items []T, key func(T) cursor, p page, start int) ([]T, string) {
 	end := min(start+p.limit, len(items))
 	out := items[start:end]
