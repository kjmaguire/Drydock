diff --git a/result/internal/store/audit.go b/result/internal/store/audit.go
new file mode 100644
index 0000000..d0970da
--- /dev/null
+++ b/result/internal/store/audit.go
@@ -0,0 +1,97 @@
+package store
+
+import (
+	"sort"
+	"time"
+)
+
+// AuditEvent is an entry of the audit log: a successful request that changed an organization's objects. Entries are never
+// changed or deleted, and they never hold secrets (API key tokens, webhook signing secrets, invite tokens).
+type AuditEvent struct {
+	ID        string      `json:"id"`
+	OrgID     string      `json:"org_id"`
+	Action    string      `json:"action"` // for example "customer.created"
+	Actor     AuditActor  `json:"actor"`
+	Target    AuditTarget `json:"target"`
+	RequestID string      `json:"request_id"`
+	At        time.Time   `json:"at"`
+	// Changes is set on updates: the fields whose value changed, by JSON field name. It is an empty object when nothing did.
+	Changes *map[string]AuditChange `json:"changes,omitempty"`
+}
+
+// AuditActor is who made the change: the API key that made the request, and the member the key acts for.
+type AuditActor struct {
+	Type   string `json:"type"` // "api_key"
+	ID     string `json:"id"`
+	UserID string `json:"user_id"`
+}
+
+// AuditTarget is the object that was changed.
+type AuditTarget struct {
+	Type string `json:"type"`
+	ID   string `json:"id"`
+}
+
+// AuditChange is one field's old and new value.
+type AuditChange struct {
+	From any `json:"from"`
+	To   any `json:"to"`
+}
+
+// AuditFilter narrows an organization's audit log. Empty fields match everything. ActorID is a user ID or an API key ID.
+type AuditFilter struct {
+	Action   string
+	TargetID string
+	ActorID  string
+}
+
+// AddAuditEvent records an entry at now. Its ID is new.
+func (s *Store) AddAuditEvent(e AuditEvent, now time.Time) AuditEvent {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e.ID = s.newID("aud")
+	e.At = now.UTC()
+	e = copyAuditEvent(e)
+	s.audit = append(s.audit, e)
+	return copyAuditEvent(e)
+}
+
+// AuditEvents returns an organization's audit entries that match f, newest first.
+func (s *Store) AuditEvents(orgID string, f AuditFilter) []AuditEvent {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []AuditEvent{}
+	for _, e := range s.audit {
+		if e.OrgID != orgID {
+			continue
+		}
+		if f.Action != "" && e.Action != f.Action {
+			continue
+		}
+		if f.TargetID != "" && e.Target.ID != f.TargetID {
+			continue
+		}
+		if f.ActorID != "" && e.Actor.ID != f.ActorID && e.Actor.UserID != f.ActorID {
+			continue
+		}
+		out = append(out, copyAuditEvent(e))
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].At.Equal(out[j].At) {
+			return out[i].At.After(out[j].At)
+		}
+		return out[i].ID > out[j].ID
+	})
+	return out
+}
+
+func copyAuditEvent(e AuditEvent) AuditEvent {
+	if e.Changes != nil {
+		m := make(map[string]AuditChange, len(*e.Changes))
+		for k, v := range *e.Changes {
+			m[k] = v
+		}
+		e.Changes = &m
+	}
+	return e
+}
diff --git a/result/internal/store/audit_test.go b/result/internal/store/audit_test.go
new file mode 100644
index 0000000..2fefa56
--- /dev/null
+++ b/result/internal/store/audit_test.go
@@ -0,0 +1,45 @@
+package store
+
+import (
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestAuditLogSurvivesExport(t *testing.T) {
+	now := time.Date(2026, 3, 1, 9, 0, 0, 0, time.UTC)
+	st := New()
+	o, _ := st.CreateOrg("A", OrgTeam, "UTC", 0, now)
+	changes := map[string]AuditChange{"name": {From: "A", To: "B"}}
+	st.AddAuditEvent(AuditEvent{OrgID: o.ID, Action: "org.updated", Target: AuditTarget{Type: "org", ID: o.ID}, Changes: &changes}, now)
+	st.AddAuditEvent(AuditEvent{OrgID: o.ID, Action: "org.updated", Target: AuditTarget{Type: "org", ID: o.ID}}, now.Add(time.Minute))
+
+	loaded, err := FromState(st.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(loaded.AuditEvents(o.ID, AuditFilter{}), st.AuditEvents(o.ID, AuditFilter{})) {
+		t.Fatal("the audit log changed in a round trip")
+	}
+	if got := loaded.AuditEvents(o.ID, AuditFilter{}); len(got) != 2 || got[0].Changes != nil || got[1].Changes == nil {
+		t.Fatalf("audit log = %+v", got)
+	}
+	// IDs keep counting from the saved sequence, so new entries never reuse one.
+	e := loaded.AddAuditEvent(AuditEvent{OrgID: o.ID, Action: "org.updated"}, now)
+	if seen := st.AuditEvents(o.ID, AuditFilter{}); e.ID == seen[0].ID || e.ID == seen[1].ID {
+		t.Fatalf("ID %s was reused", e.ID)
+	}
+}
+
+func TestAuditEventsAreCopies(t *testing.T) {
+	now := time.Date(2026, 3, 1, 9, 0, 0, 0, time.UTC)
+	st := New()
+	changes := map[string]AuditChange{"name": {From: "A", To: "B"}}
+	e := st.AddAuditEvent(AuditEvent{OrgID: "org_1", Action: "org.updated", Changes: &changes}, now)
+	changes["name"] = AuditChange{From: "X", To: "Y"}
+	(*e.Changes)["extra"] = AuditChange{}
+	got := st.AuditEvents("org_1", AuditFilter{})
+	if (*got[0].Changes)["name"].To != "B" || len(*got[0].Changes) != 1 {
+		t.Fatalf("stored entry changed: %+v", got[0].Changes)
+	}
+}
