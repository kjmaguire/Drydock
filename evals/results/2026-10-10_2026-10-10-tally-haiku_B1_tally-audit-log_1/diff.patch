+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// auditEntry is an entry of GET /v1/audit-events.
+type auditEntry struct {
+	ID        string                        `json:"id"`
+	Action    string                        `json:"action"`
+	Actor     store.AuditActor              `json:"actor"`
+	Target    store.AuditTarget             `json:"target"`
+	RequestID string                        `json:"request_id"`
+	At        string                        `json:"at"`
+	Changes   *map[string]store.AuditChange `json:"changes"`
+}
+
+// auditLog reads one page of the audit log with the key, newest first.
+func auditLog(t *testing.T, e *apitest.Env, key, query string) ([]auditEntry, string) {
+	t.Helper()
+	var out struct {
+		Items      []auditEntry `json:"items"`
+		NextCursor string       `json:"next_cursor"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events"+query, key, nil, &out)
+	return out.Items, out.NextCursor
+}
+
+// allAudit reads the whole audit log of the key's organization, oldest first.
+func allAudit(t *testing.T, e *apitest.Env, key string) []auditEntry {
+	t.Helper()
+	items, _ := auditLog(t, e, key, "?limit=100")
+	for i, j := 0, len(items)-1; i < j; i, j = i+1, j-1 {
+		items[i], items[j] = items[j], items[i]
+	}
+	return items
+}
+
+func actions(es []auditEntry) []string {
+	out := []string{}
+	for _, e := range es {
+		out = append(out, e.Action)
+	}
+	return out
+}
+
+func TestAuditLogRecordsChanges(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	tokenKey, _ := e.Store.APIKeyByToken(key)
+	var want []string
+
+	// Creating a customer is recorded; the request ID and the actor come from the request.
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	want = append(want, "customer.created")
+	// A PATCH records only the fields whose value changed.
+	r := e.DoWith("PATCH", "/v1/customers/"+c.ID, key, map[string]string{"name": "Jane Doe", "email": "jane@example.com"}, http.Header{"X-Request-Id": {"req-42"}})
+	if r.Code != http.StatusOK {
+		t.Fatalf("patch: %s", r)
+	}
+	want = append(want, "customer.updated")
+	// A PATCH that changes nothing still records an entry, with no changes.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, key, map[string]string{"name": "Jane Doe"}, nil)
+	want = append(want, "customer.updated")
+
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	want = append(want, "plan.created")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", key, map[string]any{"customer_id": c.ID, "plan_id": p.ID, "quantity": 2}, &sub)
+	want = append(want, "subscription.created")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, key, map[string]any{"quantity": 3}, nil)
+	want = append(want, "subscription.updated")
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", key, map[string]any{"at_period_end": true}, nil)
+	want = append(want, "subscription.canceled")
+	// Deactivating the plan comes after the subscription, which needs an active plan.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/plans/"+p.ID, key, map[string]any{"name": "Team Plus", "active": false}, nil)
+	want = append(want, "plan.updated")
+
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 1000}}}, &inv)
+	want = append(want, "invoice.created")
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+inv.ID+"/pay", key, map[string]string{"payment_method": "pm_ok"}, nil)
+	want = append(want, "invoice.paid")
+	var voided store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Extra", "quantity": 1, "unit_amount": 500}}}, &voided)
+	want = append(want, "invoice.created")
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+voided.ID+"/void", key, nil, nil)
+	want = append(want, "invoice.voided")
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]any{"name": "Acme Inc", "tax_rate_bp": 825}, nil)
+	want = append(want, "org.updated")
+
+	viewer, _ := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+viewer.ID, key, map[string]string{"role": "member"}, nil)
+	want = append(want, "member.role_changed")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+viewer.ID, key, nil, nil)
+	want = append(want, "member.removed")
+
+	var invite store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "new@acme.example", "role": "member"}, &invite)
+	want = append(want, "invite.created")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+invite.ID, key, nil, nil)
+	want = append(want, "invite.revoked")
+
+	var apiKey store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", key, map[string]string{"name": "CI"}, &apiKey)
+	want = append(want, "api_key.created")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+apiKey.ID, key, nil, nil)
+	want = append(want, "api_key.revoked")
+
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", key, map[string]any{"url": "https://hooks.acme.example/a", "events": []string{"*"}}, &ep)
+	want = append(want, "webhook_endpoint.created")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, key, map[string]any{"url": "https://hooks.acme.example/b"}, nil)
+	want = append(want, "webhook_endpoint.updated")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+ep.ID, key, nil, nil)
+	want = append(want, "webhook_endpoint.deleted")
+
+	got := allAudit(t, e, key)
+	if strings.Join(actions(got), " ") != strings.Join(want, " ") {
+		t.Fatalf("actions\n got %v\nwant %v", actions(got), want)
+	}
+
+	// Who and what, for the first customer update.
+	upd := got[1]
+	if upd.Actor.Type != "api_key" || upd.Actor.ID != tokenKey.ID || upd.Actor.UserID != e.Acme.Owner.ID {
+		t.Fatalf("actor = %+v", upd.Actor)
+	}
+	if upd.Target != (store.AuditTarget{Type: "customer", ID: c.ID}) || upd.RequestID != "req-42" || upd.At != "2026-01-15T10:00:00Z" {
+		t.Fatalf("entry = %+v", upd)
+	}
+	if upd.Changes == nil || len(*upd.Changes) != 1 || (*upd.Changes)["name"] != (store.AuditChange{From: "Jane", To: "Jane Doe"}) {
+		t.Fatalf("changes = %+v", upd.Changes)
+	}
+	if noop := got[2]; noop.Changes == nil || len(*noop.Changes) != 0 {
+		t.Fatalf("a PATCH without changes should have empty changes: %+v", noop)
+	}
+	if created := got[0]; created.Changes != nil {
+		t.Fatalf("a creation has no changes: %+v", created)
+	}
+
+	// Plan, subscription, organization and member changes name exactly the fields that changed.
+	byAction := func(a string) auditEntry {
+		for _, ent := range got {
+			if ent.Action == a {
+				return ent
+			}
+		}
+		t.Fatalf("no %s entry", a)
+		return auditEntry{}
+	}
+	if ch := byAction("plan.updated").Changes; ch == nil || len(*ch) != 2 || (*ch)["active"].To != false || (*ch)["name"].To != "Team Plus" {
+		t.Fatalf("plan changes = %+v", ch)
+	}
+	if ch := byAction("subscription.updated").Changes; ch == nil || len(*ch) != 1 || (*ch)["quantity"].From != float64(2) || (*ch)["quantity"].To != float64(3) {
+		t.Fatalf("subscription changes = %+v", ch)
+	}
+	if ch := byAction("org.updated").Changes; ch == nil || len(*ch) != 2 || (*ch)["tax_rate_bp"].To != float64(825) {
+		t.Fatalf("org changes = %+v", ch)
+	}
+	if ch := byAction("member.role_changed").Changes; ch == nil || len(*ch) != 1 || (*ch)["role"] != (store.AuditChange{From: "viewer", To: "member"}) {
+		t.Fatalf("role changes = %+v", ch)
+	}
+	if e := byAction("member.role_changed"); e.Target != (store.AuditTarget{Type: "member", ID: viewer.ID}) {
+		t.Fatalf("role change target = %+v", e.Target)
+	}
+	if e := byAction("api_key.created"); e.Target != (store.AuditTarget{Type: "api_key", ID: apiKey.ID}) {
+		t.Fatalf("api key target = %+v", e.Target)
+	}
+	if e := byAction("webhook_endpoint.updated"); e.Changes == nil || len(*e.Changes) != 1 || (*e.Changes)["url"].To != "https://hooks.acme.example/b" {
+		t.Fatalf("endpoint changes = %+v", e.Changes)
+	}
+}
+
+func TestAuditLogRecordsNothingForFailures(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": jane.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 1000}}}, &inv)
+	var globexEP store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Globex.Key, map[string]any{"url": "https://hooks.globex.example/", "events": []string{"*"}}, &globexEP)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	before := len(allAudit(t, e, key))
+
+	failing := []struct {
+		name, method, path, key string
+		body                    any
+		code                    int
+	}{
+		{"duplicate email", "POST", "/v1/customers", key, map[string]string{"name": "X", "email": "JANE@example.com"}, http.StatusConflict},
+		{"invalid customer", "POST", "/v1/customers", key, map[string]string{"name": "", "email": "x@example.com"}, http.StatusUnprocessableEntity},
+		{"missing customer", "PATCH", "/v1/customers/cus_missing", key, map[string]string{"name": "X"}, http.StatusNotFound},
+		{"viewer write", "PATCH", "/v1/customers/" + jane.ID, viewer, map[string]string{"name": "X"}, http.StatusForbidden},
+		{"declined charge", "POST", "/v1/invoices/" + inv.ID + "/pay", key, map[string]string{"payment_method": "pm_card_declined"}, http.StatusPaymentRequired},
+		{"missing subscription", "POST", "/v1/subscriptions/sub_missing/cancel", key, nil, http.StatusNotFound},
+		{"invalid invoice", "POST", "/v1/invoices", key, map[string]any{"customer_id": jane.ID, "currency": "USD", "lines": []any{}}, http.StatusUnprocessableEntity},
+		{"invalid role", "PATCH", "/v1/members/" + e.Acme.Owner.ID, key, map[string]string{"role": "boss"}, http.StatusUnprocessableEntity},
+		{"other org's member", "PATCH", "/v1/members/" + e.Globex.Owner.ID, key, map[string]string{"role": "viewer"}, http.StatusNotFound},
+		{"other org's endpoint", "DELETE", "/v1/webhook-endpoints/" + globexEP.ID, key, nil, http.StatusNotFound},
+		{"unknown plan", "PATCH", "/v1/plans/plan_missing", key, map[string]string{"name": "X"}, http.StatusNotFound},
+	}
+	for _, f := range failing {
+		if r := e.Do(f.method, f.path, f.key, f.body); r.Code != f.code {
+			t.Fatalf("%s: want %d, got %s", f.name, f.code, r)
+		}
+	}
+	if after := len(allAudit(t, e, key)); after != before {
+		t.Fatalf("failed requests recorded %d entries", after-before)
+	}
+	if _, ok := e.Store.WebhookEndpoint(e.Globex.ID, globexEP.ID); !ok {
+		t.Fatal("another organization's endpoint was deleted")
+	}
+}
+
+func TestAuditLogNeverHoldsSecrets(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	var created store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", key, map[string]string{"name": "CI"}, &created)
+	var invite store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "new@acme.example", "role": "member"}, &invite)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", key, map[string]any{"url": "https://hooks.acme.example/a", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, key, map[string]any{"url": "https://hooks.acme.example/b", "enabled": false}, nil)
+
+	inviteToken := mustInviteToken(t, e, invite.ID)
+	r := e.Do("GET", "/v1/audit-events", key, nil)
+	body := string(r.Body)
+	for _, secret := range []string{created.Token, inviteToken, ep.Secret, "tly_", "invite_", "whsec_"} {
+		if secret != "" && strings.Contains(body, secret) {
+			t.Fatalf("the audit log holds a secret %q: %s", secret, body)
+		}
+	}
+	if !strings.Contains(body, `"api_key.created"`) || !strings.Contains(body, `"webhook_endpoint.updated"`) {
+		t.Fatalf("the audit log is missing entries: %s", body)
+	}
+	for _, ent := range allAudit(t, e, key) {
+		if ent.Changes != nil {
+			if _, ok := (*ent.Changes)["secret"]; ok {
+				t.Fatalf("a change names the secret: %+v", ent)
+			}
+		}
+	}
+}
+
+// mustInviteToken returns an invite's token, which only the store knows.
+func mustInviteToken(t *testing.T, e *apitest.Env, id string) string {
+	t.Helper()
+	inv, ok := e.Store.Invite(e.Acme.ID, id)
+	if !ok {
+		t.Fatalf("no invite %s", id)
+	}
+	return inv.Token
+}
+
+func TestAuditLogReadableByOwnersAndAdmins(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, admin := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	for _, role := range []store.Role{store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		_, k := e.AddMember(e.Acme, fmt.Sprintf("%s@acme.example", role), role)
+		if r := e.Do("GET", "/v1/audit-events", k, nil); r.Code != http.StatusForbidden || strings.TrimSpace(string(r.Body)) != `{"error":"forbidden"}` {
+			t.Fatalf("%s: %s", role, r)
+		}
+	}
+	if items, _ := auditLog(t, e, admin, ""); len(items) != 1 {
+		t.Fatalf("admin sees %d entries", len(items))
+	}
+	if items, _ := auditLog(t, e, e.Acme.Key, ""); len(items) != 1 {
+		t.Fatalf("owner sees %d entries", len(items))
+	}
+	if r := e.Do("GET", "/v1/audit-events", "", nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("no key: %s", r)
+	}
+}
+
+func TestAuditLogFiltersPagesAndTenancy(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	var ids []string
+	for i := range 5 {
+		c := e.CreateCustomer(e.Acme, fmt.Sprintf("Customer %d", i), fmt.Sprintf("c%d@example.com", i))
+		ids = append(ids, c.ID)
+	}
+	e.CreateCustomer(e.Globex, "Globex customer", "gx@example.com")
+	apiKey, _ := e.Store.APIKeyByToken(key)
+
+	// Pages are newest first and follow the cursor to the end, each entry once.
+	var seen []string
+	query := "?limit=2"
+	for pages := 0; ; pages++ {
+		items, next := auditLog(t, e, key, query)
+		if pages > 10 {
+			t.Fatal("paging does not end")
+		}
+		for _, it := range items {
+			seen = append(seen, it.Target.ID)
+		}
+		if next == "" {
+			break
+		}
+		query = "?limit=2&cursor=" + next
+	}
+	if len(seen) != 5 {
+		t.Fatalf("paged through %d entries, want 5: %v", len(seen), seen)
+	}
+	for i := range seen {
+		if want := ids[len(ids)-1-i]; seen[i] != want {
+			t.Fatalf("page order: got %v, want newest first %v", seen, ids)
+		}
+	}
+
+	if items, _ := auditLog(t, e, key, "?action=customer.created&limit=100"); len(items) != 5 {
+		t.Fatalf("action filter: %d entries", len(items))
+	}
+	if items, _ := auditLog(t, e, key, "?action=plan.created"); len(items) != 0 {
+		t.Fatalf("action filter with no match: %d entries", len(items))
+	}
+	if items, _ := auditLog(t, e, key, "?target_id="+ids[2]); len(items) != 1 || items[0].Target.ID != ids[2] {
+		t.Fatalf("target filter: %+v", items)
+	}
+	for _, actor := range []string{e.Acme.Owner.ID, apiKey.ID} {
+		if items, _ := auditLog(t, e, key, "?actor_id="+actor); len(items) != 5 {
+			t.Fatalf("actor filter %s: %d entries", actor, len(items))
+		}
+	}
+	if items, _ := auditLog(t, e, key, "?actor_id="+e.Globex.Owner.ID); len(items) != 0 {
+		t.Fatalf("another organization's actor matched: %+v", items)
+	}
+
+	// Globex sees only its own entries.
+	items, _ := auditLog(t, e, e.Globex.Key, "")
+	if len(items) != 1 || items[0].Target.ID == ids[0] || items[0].Action != "customer.created" {
+		t.Fatalf("globex's log = %+v", items)
+	}
+	if r := e.Do("GET", "/v1/audit-events?limit=0", key, nil); r.Code != http.StatusBadRequest {
+		t.Fatalf("bad limit: %s", r)
+	}
+}
