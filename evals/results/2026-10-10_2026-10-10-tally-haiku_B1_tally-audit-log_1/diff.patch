+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"slices"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// auditView is an entry of the audit log as the API shows it.
+type auditView struct {
+	ID        string                        `json:"id"`
+	Action    string                        `json:"action"`
+	Actor     store.AuditActor              `json:"actor"`
+	Target    store.AuditTarget             `json:"target"`
+	RequestID string                        `json:"request_id"`
+	At        time.Time                     `json:"at"`
+	Changes   *map[string]store.AuditChange `json:"changes,omitempty"`
+}
+
+func viewAudit(e store.AuditEvent) auditView {
+	return auditView{ID: e.ID, Action: e.Action, Actor: e.Actor, Target: e.Target, RequestID: e.RequestID, At: e.At, Changes: e.Changes}
+}
+
+func auditKey(e store.AuditEvent) cursor { return cursor{T: e.At, ID: e.ID} }
+
+// audit records that the request changed an object. Handlers call it only once the change has succeeded, before they answer,
+// so a request that fails records nothing. changes is nil for actions without changes, and the entry of an update has one
+// (possibly empty) even when no field changed.
+func (s *Server) audit(r *http.Request, p auth.Principal, action, targetType, targetID string, changes map[string]store.AuditChange) {
+	e := store.AuditEvent{
+		OrgID:     p.OrgID,
+		Action:    action,
+		Actor:     store.AuditActor{Type: "api_key", ID: p.KeyID, UserID: p.UserID},
+		Target:    store.AuditTarget{Type: targetType, ID: targetID},
+		RequestID: RequestID(r.Context()),
+	}
+	if changes != nil {
+		e.Changes = &changes
+	}
+	s.store.AddAuditEvent(e, s.clock.Now())
+}
+
+// fieldsOf is an object as its JSON fields, by JSON field name. The objects it is given always marshal, so errors are ignored.
+func fieldsOf(v any) map[string]any {
+	var m map[string]any
+	b, _ := json.Marshal(v)
+	_ = json.Unmarshal(b, &m)
+	return m
+}
+
+// changedFields returns the fields whose value differs between before and after, except the skipped ones. A field that is
+// absent (omitted when empty) counts as null.
+func changedFields(before, after map[string]any, skip ...string) map[string]store.AuditChange {
+	names := map[string]bool{}
+	for k := range before {
+		names[k] = true
+	}
+	for k := range after {
+		names[k] = true
+	}
+	out := map[string]store.AuditChange{}
+	for k := range names {
+		if slices.Contains(skip, k) {
+			continue
+		}
+		if from, to := before[k], after[k]; !reflect.DeepEqual(from, to) {
+			out[k] = store.AuditChange{From: from, To: to}
+		}
+	}
+	return out
+}
+
+// listAuditEvents answers the organization's audit log, newest first. ?action=, ?target_id= and ?actor_id= (a user ID or an
+// API key ID) narrow it. Only owners and admins may read it.
+func (s *Server) listAuditEvents(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	if !auth.CanManageTeam(p.Role) {
+		writeJSON(w, http.StatusForbidden, map[string]string{"error": "forbidden"})
+		return
+	}
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	q := r.URL.Query()
+	evs := s.store.AuditEvents(p.OrgID, store.AuditFilter{Action: q.Get("action"), TargetID: q.Get("target_id"), ActorID: q.Get("actor_id")})
+	items, next := pageNewestFirst(evs, auditKey, pg)
+	views := make([]auditView, 0, len(items))
+	for _, e := range items {
+		views = append(views, viewAudit(e))
+	}
+	writeJSON(w, http.StatusOK, list{Items: views, NextCursor: next})
+}
