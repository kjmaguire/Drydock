+	var first, second store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "a@free.example", "role": "member"}, &first)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "b@free.example", "role": "admin"}, &second)
+	if used, _ := seats(free.Key); used != 3 {
+		t.Fatalf("used with two pending invites = %d", used)
+	}
+	r := invite("c@free.example", "member")
