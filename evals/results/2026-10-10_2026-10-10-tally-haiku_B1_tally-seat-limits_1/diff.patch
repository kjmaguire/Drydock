+func TestSeatLimitUnderConcurrency(t *testing.T) {
+	e := apitest.New(t)
+	org := e.NewOrg("Race", store.OrgFree, "UTC")
+	e.AddMember(org, "m@race.example", store.RoleMember) // two seats in use: one left
+
+	const n = 8
+	codes := make([]int, n)
+	var wg sync.WaitGroup
+	for i := range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			body := map[string]string{"email": fmt.Sprintf("p%d@race.example", i), "role": "member"}
+			codes[i] = e.Do("POST", "/v1/invites", org.Key, body).Code
+		}()
+	}
+	wg.Wait()
+
+	created := 0
+	for _, c := range codes {
+		switch c {
+		case http.StatusCreated:
+			created++
+		case http.StatusPaymentRequired:
+		default:
+			t.Fatalf("unexpected status %d in %v", c, codes)
+		}
+	}
+	if created != 1 {
+		t.Fatalf("%d of %d concurrent invites succeeded, want 1: %v", created, n, codes)
+	}
+	var o struct {
+		Seats struct {
+			Used int `json:"used"`
+		} `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", org.Key, nil, &o)
+	if o.Seats.Used != 3 {
+		t.Fatalf("used = %d", o.Seats.Used)
+	}
+}
+
+func TestPlanChangeSeats(t *testing.T) {
+	e := apitest.New(t)
+	for i := range 3 {
+		e.AddMember(e.Acme, fmt.Sprintf("m%d@acme.example", i), store.RoleMember)
+	}
+	// Four seats in use on the team plan; the free plan allows three.
+	r := e.Do("PATCH", "/v1/org", e.Acme.Key, map[string]any{"name": "Renamed", "plan": "free"})
+	if r.Code != http.StatusConflict {
+		t.Fatalf("downgrade over the limit: %s", r)
+	}
+	if m := r.Map(t); m["error"] != "over_seat_limit" || m["limit"] != float64(3) || m["used"] != float64(4) {
+		t.Fatalf("409 body = %v", m)
+	}
+	var o struct {
+		Name string `json:"name"`
+		Plan string `json:"plan"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", e.Acme.Key, nil, &o)
+	if o.Plan != "team" || o.Name != "Acme" {
+		t.Fatalf("a refused change was stored: %+v", o)
+	}
+
+	var members struct {
+		Items []struct {
+			UserID string `json:"user_id"`
+			Role   string `json:"role"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/members", e.Acme.Key, nil, &members)
+	var pick string
+	for _, m := range members.Items {
+		if m.Role == "member" {
+			pick = m.UserID
+			break
+		}
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+pick, e.Acme.Key, nil, nil)
+	var down struct {
+		Plan  string `json:"plan"`
+		Seats struct {
+			Used  int  `json:"used"`
+			Limit *int `json:"limit"`
+		} `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"plan": "free"}, &down)
+	if down.Plan != "free" || down.Seats.Used != 3 || down.Seats.Limit == nil || *down.Seats.Limit != 3 {
+		t.Fatalf("downgraded org = %+v", down)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"plan": "business"}, &down)
+	if down.Seats.Limit != nil {
+		t.Fatalf("business seats limit = %v, want null", *down.Seats.Limit)
+	}
+}
