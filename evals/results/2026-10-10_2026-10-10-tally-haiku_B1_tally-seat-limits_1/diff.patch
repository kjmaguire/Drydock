+// seatError answers 402 when a change needs a seat the plan does not have, and 409 when a plan change would leave fewer
+// seats than the organization uses. Both say the limit and the seats in use.
+func seatError(w http.ResponseWriter, se *store.SeatError) {
+	body := map[string]any{"limit": se.Limit, "used": se.Used}
+	if errors.Is(se, store.ErrOverSeatLimit) {
+		body["error"] = "over_seat_limit"
+		body["message"] = fmt.Sprintf("the plan allows %d seats and the organization uses %d; remove members or invites first", se.Limit, se.Used)
+		writeJSON(w, http.StatusConflict, body)
+		return
+	}
+	body["error"] = "seat_limit_reached"
+	body["message"] = fmt.Sprintf("the plan allows %d seats and all %d are in use; viewers are free", se.Limit, se.Used)
+	writeJSON(w, http.StatusPaymentRequired, body)
+}
