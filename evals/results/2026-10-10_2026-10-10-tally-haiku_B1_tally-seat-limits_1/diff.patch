+		t.Fatalf("invite past the limit: %s", r)
+	}
+	if m := r.Map(t); m["error"] != "seat_limit_reached" || m["limit"] != float64(3) || m["used"] != float64(3) {
+		t.Fatalf("402 body = %v", m)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "v@free.example", "role": "viewer"}, nil)
+
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+second.ID, free.Key, nil, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "c@free.example", "role": "member"}, nil)
