+// mustToken returns the token of an organization's pending invite to email.
+func mustToken(t *testing.T, s *Store, orgID, email string) string {
+	t.Helper()
+	for _, inv := range s.Invites(orgID) {
+		if inv.Email == email {
+			return inv.Token
+		}
+	}
+	t.Fatalf("no pending invite to %s", email)
+	return ""
+}
+
+func TestPlanChangeWithinSeats(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme") // team: 10 seats
+	owner, _ := s.CreateUser("owner@acme.example", "Owner", t0)
+	if _, err := s.AddMember(o.ID, owner.ID, RoleOwner, t0); err != nil {
+		t.Fatal(err)
+	}
+	var members []Member
+	for i := range 3 {
+		u, _ := s.CreateUser(fmt.Sprintf("m%d@acme.example", i), "M", t0)
+		m, err := s.AddMember(o.ID, u.ID, RoleMember, t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		members = append(members, m)
+	}
+	// Four seats in use: the free plan allows three.
+	setPlan := func(name string, plan OrgPlan) error {
+		_, err := s.UpdateOrg(o.ID, func(x *Org) error { x.Name, x.Plan = name, plan; return nil })
+		return err
+	}
+	err := setPlan("Acme Renamed", OrgFree)
+	var se *SeatError
+	if !errors.Is(err, ErrOverSeatLimit) || !errors.As(err, &se) || se.Limit != 3 || se.Used != 4 {
+		t.Fatalf("downgrade over the limit: %v", err)
+	}
+	if got, _ := s.Org(o.ID); got.Plan != OrgTeam || got.Name != "Acme" {
+		t.Fatalf("a refused change was stored: %+v", got)
+	}
+	if err := s.RemoveMember(o.ID, members[0].UserID); err != nil {
+		t.Fatal(err)
+	}
+	if err := setPlan("Acme", OrgFree); err != nil {
+		t.Fatalf("downgrade within the limit: %v", err)
+	}
+	if got, _ := s.Org(o.ID); got.Plan != OrgFree {
+		t.Fatalf("plan = %s", got.Plan)
+	}
+}
