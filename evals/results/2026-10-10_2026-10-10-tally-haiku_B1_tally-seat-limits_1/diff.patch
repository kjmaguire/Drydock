+// seatsUsed counts an organization's seats. Viewers are free; an invite holds its seat until it is accepted or revoked.
+// The caller holds the lock.
+func (s *Store) seatsUsed(orgID string) int {
+	n := 0
+	for k, m := range s.members {
+		if k.org == orgID && m.Role != RoleViewer {
+			n++
+		}
+	}
+	for _, inv := range s.invites {
+		if inv.OrgID == orgID && inv.Role != RoleViewer && inv.AcceptedAt == nil && inv.RevokedAt == nil {
+			n++
+		}
+	}
+	return n
+}
+
+// checkSeat returns a SeatError (ErrNoSeat) when the organization has no seat left for one more. The caller holds the lock.
+func (s *Store) checkSeat(orgID string) error {
+	limit, limited := s.orgs[orgID].Plan.SeatLimit()
+	if !limited {
+		return nil
+	}
+	if used := s.seatsUsed(orgID); used >= limit {
+		return &SeatError{Kind: ErrNoSeat, Limit: limit, Used: used}
+	}
+	return nil
+}
