+// reports false when the plan has no limit.
+func (p OrgPlan) SeatLimit() (int, bool) {
+	switch p {
+	case OrgFree:
+		return 3, true
+	case OrgTeam:
+		return 10, true
+	default:
+		return 0, false
+	}
