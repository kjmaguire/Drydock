+func (s *Server) exportCustomers(w http.ResponseWriter, r *http.Request, acct store.Account) {
+	var buf bytes.Buffer
+	if err := writeCustomersCSV(&buf, s.store.Customers(acct.ID)); err != nil {
+		writeError(w, http.StatusInternalServerError, "internal")
+		return
+	}
+	w.Header().Set("Content-Type", "text/csv; charset=utf-8")
+	w.Header().Set("Content-Disposition", `attachment; filename="customers.csv"`)
+	_, _ = w.Write(buf.Bytes())
+}
+
+// writeCustomersCSV writes a header row and one RFC 4180 row per customer, with CRLF line ends.
+func writeCustomersCSV(out io.Writer, customers []store.Customer) error {
+	cw := csv.NewWriter(out)
+	cw.UseCRLF = true
+	if err := cw.Write([]string{"id", "name", "email", "plan", "created_at"}); err != nil {
+		return err
+	}
+	for _, c := range customers {
+		row := []string{c.ID, c.Name, c.Email, string(c.Plan), c.CreatedAt.UTC().Format(time.RFC3339)}
+		for i, field := range row {
+			row[i] = neutralizeFormula(field)
+		}
+		if err := cw.Write(row); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
+
+// neutralizeFormula prefixes a field that a spreadsheet would read as a formula with a single quote.
+func neutralizeFormula(field string) string {
+	if field != "" && strings.IndexByte("=+-@", field[0]) >= 0 {
+		return "'" + field
+	}
+	return field
+}
