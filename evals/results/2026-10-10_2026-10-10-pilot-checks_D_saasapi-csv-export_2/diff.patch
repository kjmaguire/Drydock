+func TestTheCustomersCSVHasOnlyTheCallersCustomersInRFC4180(t *testing.T) {
+	srv, st := newServer(t)
+	at := time.Date(2026, 1, 2, 4, 5, 6, 0, time.FixedZone("UTC+1", 3600))
+	mustCustomer(t, st, "acc_acme", "Doe, \"Jane\"\nJr", "jane@example.com", store.PlanPro, at)
+	mustCustomer(t, st, "acc_globex", "Hank", "hank@globex.test", store.PlanFree, at)
+	mustCustomer(t, st, "acc_acme", "=HYPERLINK(\"http://x\")", "@evil@example.com", store.PlanFree, at)
+	mustCustomer(t, st, "acc_acme", "-2+3", "+plus@example.com", store.PlanFree, at)
+
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("export: %d %s", r.Code, r.Body)
+	}
+	if ct := r.Header().Get("Content-Type"); ct != "text/csv; charset=utf-8" {
+		t.Fatalf("content type %q", ct)
+	}
+	if cd := r.Header().Get("Content-Disposition"); cd != `attachment; filename="customers.csv"` {
+		t.Fatalf("content disposition %q", cd)
+	}
+	want := "id,name,email,plan,created_at\r\n" +
+		"cus_00001,\"Doe, \"\"Jane\"\"\r\nJr\",jane@example.com,pro,2026-01-02T03:05:06Z\r\n" +
+		"cus_00003,\"'=HYPERLINK(\"\"http://x\"\")\",'@evil@example.com,free,2026-01-02T03:05:06Z\r\n" +
+		"cus_00004,'-2+3,'+plus@example.com,free,2026-01-02T03:05:06Z\r\n"
+	if got := r.Body.String(); got != want {
+		t.Fatalf("body:\n%q\nwant:\n%q", got, want)
+	}
+	rows, err := csv.NewReader(strings.NewReader(r.Body.String())).ReadAll()
+	if err != nil {
+		t.Fatalf("not parseable CSV: %v", err)
+	}
+	if rows[1][1] != "Doe, \"Jane\"\nJr" {
+		t.Fatalf("name did not round-trip: %q", rows[1][1])
+	}
+}
