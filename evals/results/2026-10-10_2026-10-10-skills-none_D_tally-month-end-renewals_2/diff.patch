+
+// AddInterval returns t moved forward by one billing interval: a month or a year. See addIntervals for the day it lands on.
 func AddInterval(t time.Time, iv store.Interval) time.Time {
+	return addIntervals(t, iv, 1)
+}
+
+// PeriodEnd returns where the period that starts at start ends: the first boundary after start on the schedule that anchor
+// sets. Pass the previous period's end as start to walk the periods in order; the boundaries stay on the anchor's day, so
+// a short month does not move the schedule. Times are UTC.
+func PeriodEnd(anchor time.Time, iv store.Interval, start time.Time) time.Time {
+	a, s := anchor.UTC(), start.UTC()
+	n := (s.Year()-a.Year())*12 + int(s.Month()-a.Month())
+	if iv == store.Yearly {
+		n /= 12
+	}
+	end := addIntervals(a, iv, n)
+	for !end.After(s) {
+		n++
+		end = addIntervals(a, iv, n)
+	}
+	return end
+}
+
+// addIntervals returns the anchor moved n billing intervals forward, in UTC. The result keeps the anchor's time of day and
+// its day of the month, or the last day of the month when that month is shorter (a February 29 yearly anchor gives February
+// 28 in common years). Go's AddDate would instead roll February 31 over into March.
+func addIntervals(anchor time.Time, iv store.Interval, n int) time.Time {
+	a := anchor.UTC()
+	months := n
 	if iv == store.Yearly {
-		return t.AddDate(1, 0, 0)
+		months = 12 * n
 	}
-	return t.AddDate(0, 1, 0)
+	first := time.Date(a.Year(), a.Month()+time.Month(months), 1, 0, 0, 0, 0, time.UTC)
+	last := time.Date(first.Year(), first.Month()+1, 0, 0, 0, 0, 0, time.UTC).Day()
+	day := min(a.Day(), last)
+	return time.Date(first.Year(), first.Month(), day, a.Hour(), a.Minute(), a.Second(), a.Nanosecond(), time.UTC)
 }
