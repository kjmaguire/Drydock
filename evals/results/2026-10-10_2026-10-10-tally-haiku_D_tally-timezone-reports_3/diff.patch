+// RevenueReport adds up the organization's succeeded payments per bucket and currency, from the day from to the day to
+// (YYYY-MM-DD, both included), in the organization's time zone. group is "day" (the default), "week" (starting on Monday)
+// or "month". Every bucket from the one holding from to the one holding to is in the report, in order, also those without
+// payments. A bucket is named by its first day, which can be before from, and only counts payments from from to to.
+func RevenueReport(st *store.Store, orgID, from, to, group string) (Report, error) {
+	first, last, loc, err := span(st, orgID, from, to)
+	if err != nil {
+		return Report{}, err
+	}
+	switch group {
+	case "", "day":
+		group = "day"
+	case "week", "month":
+	default:
+		return Report{}, fmt.Errorf("%w: %q", ErrInvalidGroup, group)
+	}
+	o, _ := st.Org(orgID)
+	rep := Report{TimeZone: o.TimeZone, Group: group, Buckets: []Bucket{}}
+	pos := map[string]int{}
+	for b := bucketOf(first, group); !b.After(last); b = nextBucket(b, group) {
+		pos[b.Format(time.DateOnly)] = len(rep.Buckets)
+		rep.Buckets = append(rep.Buckets, Bucket{Start: b.Format(time.DateOnly), Amounts: map[money.Currency]int64{}})
+	}
+	for _, p := range succeeded(st, orgID, first, last, loc) {
+		b := &rep.Buckets[pos[bucketOf(p.day, group).Format(time.DateOnly)]]
+		b.Amounts[p.cur] += p.amount
+		b.Payments++
+	}
+	return rep, nil
+}
+
+// span parses from and to, both included, as days of the organization's time zone and returns them as UTC midnights of
+// their calendar dates, together with the time zone.
+func span(st *store.Store, orgID, from, to string) (first, last time.Time, loc *time.Location, err error) {
+	first, err = time.Parse(time.DateOnly, from)
+	if err != nil {
+		return first, last, nil, fmt.Errorf("%w: from %q", ErrInvalidDate, from)
+	}
+	last, err = time.Parse(time.DateOnly, to)
+	if err != nil {
+		return first, last, nil, fmt.Errorf("%w: to %q", ErrInvalidDate, to)
+	}
+	if last.Before(first) {
+		return first, last, nil, fmt.Errorf("%w: to is before from", ErrInvalidRange)
+	}
+	if last.Sub(first) >= MaxDays*24*time.Hour {
+		return first, last, nil, fmt.Errorf("%w: at most %d days", ErrInvalidRange, MaxDays)
+	}
+	o, ok := st.Org(orgID)
+	if !ok {
+		return first, last, nil, store.ErrNotFound
+	}
+	loc, err = time.LoadLocation(o.TimeZone)
+	if err != nil {
+		return first, last, nil, fmt.Errorf("time zone %q: %w", o.TimeZone, err)
+	}
+	return first, last, loc, nil
+}
+
+// dayPayment is a succeeded payment and the day, in the organization's time zone, it belongs to.
+type dayPayment struct {
+	day    time.Time // UTC midnight of the calendar date
+	cur    money.Currency
+	amount int64
+}
+
+// succeeded lists the organization's succeeded payments made on the days first to last (both included).
+func succeeded(st *store.Store, orgID string, first, last time.Time, loc *time.Location) []dayPayment {
+	var out []dayPayment
+	for _, p := range st.Payments(orgID, "") {
+		if p.Status != store.PaymentSucceeded {
+			continue
+		}
+		y, m, d := p.CreatedAt.In(loc).Date()
+		day := time.Date(y, m, d, 0, 0, 0, 0, time.UTC)
+		if day.Before(first) || day.After(last) {
+			continue
+		}
+		out = append(out, dayPayment{day: day, cur: p.Currency, amount: p.Amount})
+	}
+	return out
+}
+
+// bucketOf returns the first day of the day, week (starting on Monday) or month the day belongs to.
+func bucketOf(day time.Time, group string) time.Time {
+	switch group {
+	case "week":
+		return day.AddDate(0, 0, -((int(day.Weekday()) + 6) % 7))
+	case "month":
+		return time.Date(day.Year(), day.Month(), 1, 0, 0, 0, 0, time.UTC)
+	}
+	return day
+}
+
+// nextBucket returns the first day of the bucket after the one starting on start.
+func nextBucket(start time.Time, group string) time.Time {
+	switch group {
+	case "week":
+		return start.AddDate(0, 0, 7)
+	case "month":
+		return start.AddDate(0, 1, 0)
+	}
+	return start.AddDate(0, 0, 1)
+}
