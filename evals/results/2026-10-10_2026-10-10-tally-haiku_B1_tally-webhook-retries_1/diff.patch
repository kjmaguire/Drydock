diff --git a/result/internal/webhooks/retry_test.go b/result/internal/webhooks/retry_test.go
new file mode 100644
index 0000000..fb9e145
--- /dev/null
+++ b/result/internal/webhooks/retry_test.go
@@ -0,0 +1,258 @@
+package webhooks_test
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// waits are the times between a delivery's attempts, after the first, second, ... failed attempt.
+var waits = []time.Duration{time.Minute, 5 * time.Minute, 30 * time.Minute, 2 * time.Hour, 8 * time.Hour, 24 * time.Hour}
+
+func endpoint(t testing.TB, e *apitest.Env, org apitest.Org, url string, events ...string) store.WebhookEndpoint {
+	t.Helper()
+	ep, err := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: org.ID, URL: url, Events: events, Secret: "whsec_t", Enabled: true}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ep
+}
+
+func publish(t testing.TB, e *apitest.Env, typ string) {
+	t.Helper()
+	if err := e.Webhooks.Publish(context.Background(), e.Acme.ID, typ, map[string]string{"id": "cus_1"}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func runDue(t testing.TB, e *apitest.Env) int {
+	t.Helper()
+	n, err := e.Webhooks.RunDue(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+// onlyDelivery returns the one delivery an endpoint has.
+func onlyDelivery(t testing.TB, e *apitest.Env, ep store.WebhookEndpoint) store.Delivery {
+	t.Helper()
+	ds := e.Store.Deliveries(e.Acme.ID, ep.ID)
+	if len(ds) != 1 {
+		t.Fatalf("deliveries to %s = %+v, want 1", ep.URL, ds)
+	}
+	return ds[0]
+}
+
+// drain runs RunDue every minute of simulated time for two days. Every retry falls on a whole minute, so every attempt is
+// made on time.
+func drain(e *apitest.Env) {
+	for i := 0; i < 2*24*60; i++ {
+		_, _ = e.Webhooks.RunDue(context.Background())
+		e.Clock.Advance(time.Minute)
+	}
+}
+
+// failureEmails counts the emails about an endpoint's failing.
+func failureEmails(e *apitest.Env, url string) int {
+	n := 0
+	for _, m := range e.Mail.Messages() {
+		if m.Subject == "Webhook endpoint failing: "+url {
+			n++
+		}
+	}
+	return n
+}
+
+func TestRetriesThenFailsForGood(t *testing.T) {
+	e := apitest.New(t)
+	e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	ep := endpoint(t, e, e.Acme, "https://hooks.acme.example/all", "*")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusInternalServerError, nil }
+	publish(t, e, "customer.created")
+
+	for attempt := 1; attempt <= 7; attempt++ {
+		if attempt > 1 {
+			// Not due a second early, due on time.
+			e.Clock.Advance(waits[attempt-2] - time.Second)
+			if n := runDue(t, e); n != 0 {
+				t.Fatalf("attempt %d ran early: RunDue = %d", attempt, n)
+			}
+			e.Clock.Advance(time.Second)
+		}
+		if n := runDue(t, e); n != 1 {
+			t.Fatalf("attempt %d: RunDue = %d, want 1", attempt, n)
+		}
+		now := e.Clock.Now()
+		d := onlyDelivery(t, e, ep)
+		if d.Attempts != attempt || d.LastAttemptAt == nil || !d.LastAttemptAt.Equal(now) || d.ResponseStatus != 500 || d.Error == "" {
+			t.Fatalf("after attempt %d: %+v", attempt, d)
+		}
+		if attempt < 7 {
+			if d.Status != store.DeliveryPending || d.NextAttemptAt == nil || !d.NextAttemptAt.Equal(now.Add(waits[attempt-1])) {
+				t.Fatalf("after attempt %d: %+v, want pending with the next attempt in %v", attempt, d, waits[attempt-1])
+			}
+			if n := failureEmails(e, ep.URL); n != 0 {
+				t.Fatalf("emailed after attempt %d", attempt)
+			}
+			continue
+		}
+		if d.Status != store.DeliveryFailed || d.NextAttemptAt != nil {
+			t.Fatalf("after the 7th attempt: %+v, want failed for good", d)
+		}
+	}
+
+	e.Clock.Advance(30 * 24 * time.Hour)
+	if n := runDue(t, e); n != 0 {
+		t.Fatalf("a delivery that failed for good was attempted again: %d", n)
+	}
+	if n := len(e.HTTP.Requests()); n != 7 {
+		t.Fatalf("requests = %d, want 7", n)
+	}
+	msgs := e.Mail.Messages()
+	if len(msgs) != 1 || msgs[0].To != "owner@acme.example" || msgs[0].Subject != "Webhook endpoint failing: "+ep.URL {
+		t.Fatalf("messages = %+v, want one to the owner only", msgs)
+	}
+	if ep2, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID); !ep2.Enabled || ep2.FailureEmailAt == nil {
+		t.Fatalf("endpoint = %+v, want enabled and marked as emailed", ep2)
+	}
+}
+
+func TestSucceedsOnRetry(t *testing.T) {
+	e := apitest.New(t)
+	ep := endpoint(t, e, e.Acme, "https://hooks.acme.example/all", "*")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusServiceUnavailable, nil }
+	publish(t, e, "customer.created")
+	runDue(t, e)
+
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusOK, nil }
+	e.Clock.Advance(time.Minute)
+	if n := runDue(t, e); n != 1 {
+		t.Fatalf("RunDue = %d, want 1", n)
+	}
+	d := onlyDelivery(t, e, ep)
+	if d.Status != store.DeliverySucceeded || d.Attempts != 2 || d.NextAttemptAt != nil || d.Error != "" || d.ResponseStatus != http.StatusOK {
+		t.Fatalf("delivery = %+v", d)
+	}
+	if n := runDue(t, e); n != 0 {
+		t.Fatalf("a delivered event was sent again: %d", n)
+	}
+
+	// The API shows next_attempt_at as null once no attempt is planned.
+	var list struct{ Items []map[string]any }
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+ep.ID+"/deliveries", e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 {
+		t.Fatalf("deliveries = %+v", list.Items)
+	}
+	if v, ok := list.Items[0]["next_attempt_at"]; !ok || v != nil {
+		t.Fatalf("next_attempt_at = %v (present %v), want null", v, ok)
+	}
+	if list.Items[0]["attempts"] != float64(2) || list.Items[0]["status"] != "succeeded" {
+		t.Fatalf("delivery JSON = %+v", list.Items[0])
+	}
+}
+
+func TestFailedAttemptsWithoutAnAnswer(t *testing.T) {
+	e := apitest.New(t)
+	ep := endpoint(t, e, e.Acme, "https://hooks.acme.example/all", "*")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return 0, errors.New("connection reset by peer") }
+	publish(t, e, "customer.created")
+	runDue(t, e)
+	d := onlyDelivery(t, e, ep)
+	if d.Status != store.DeliveryPending || d.ResponseStatus != 0 || d.Error == "" {
+		t.Fatalf("after a request that got no answer: %+v", d)
+	}
+
+	// A redirect is not followed, so it fails.
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusFound, nil }
+	e.Clock.Advance(time.Minute)
+	runDue(t, e)
+	d = onlyDelivery(t, e, ep)
+	if d.Status != store.DeliveryPending || d.Attempts != 2 || d.ResponseStatus != http.StatusFound || d.Error != "the endpoint answered 302" {
+		t.Fatalf("after a 302: %+v", d)
+	}
+}
+
+func TestGoneDisablesEndpoint(t *testing.T) {
+	e := apitest.New(t)
+	ep := endpoint(t, e, e.Acme, "https://hooks.acme.example/all", "*")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusGone, nil }
+	publish(t, e, "customer.created")
+	publish(t, e, "customer.updated")
+
+	// The first delivery is refused with 410 Gone and disables the endpoint, so the second is not sent.
+	if n := runDue(t, e); n != 2 {
+		t.Fatalf("RunDue = %d, want 2", n)
+	}
+	if n := len(e.HTTP.Requests()); n != 1 {
+		t.Fatalf("requests = %d, want 1", n)
+	}
+	got, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if got.Enabled || got.DisabledReason != "gone" {
+		t.Fatalf("endpoint = %+v, want disabled for gone", got)
+	}
+	for _, d := range e.Store.Deliveries(e.Acme.ID, ep.ID) {
+		if d.Status != store.DeliveryFailed || d.NextAttemptAt != nil {
+			t.Fatalf("delivery = %+v, want failed for good", d)
+		}
+	}
+	if ds := e.Store.Deliveries(e.Acme.ID, ep.ID); ds[0].Attempts != 1 || ds[0].ResponseStatus != http.StatusGone {
+		t.Fatalf("first delivery = %+v", ds[0])
+	}
+	e.Clock.Advance(48 * time.Hour)
+	if n := runDue(t, e); n != 0 {
+		t.Fatalf("RunDue = %d after the endpoint was disabled", n)
+	}
+	if n := len(e.Mail.Messages()); n != 0 {
+		t.Fatalf("410 emailed the owners: %+v", e.Mail.Messages())
+	}
+}
+
+func TestFailureEmailAtMostOncePerDay(t *testing.T) {
+	e := apitest.New(t)
+	all := endpoint(t, e, e.Acme, "https://hooks.acme.example/all", "*")
+	paid := endpoint(t, e, e.Acme, "https://hooks.acme.example/paid", "customer.created")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusBadGateway, nil }
+
+	// Two events fail for good at the same time for each endpoint: each endpoint gets one email.
+	publish(t, e, "customer.created")
+	publish(t, e, "customer.created")
+	drain(e)
+	if n := failureEmails(e, all.URL); n != 1 {
+		t.Fatalf("emails about %s = %d, want 1", all.URL, n)
+	}
+	if n := failureEmails(e, paid.URL); n != 1 {
+		t.Fatalf("emails about %s = %d, want 1", paid.URL, n)
+	}
+
+	// A failure after the day is over is emailed again.
+	publish(t, e, "customer.created")
+	drain(e)
+	if n := failureEmails(e, all.URL); n != 2 {
+		t.Fatalf("emails about %s = %d, want 2", all.URL, n)
+	}
+}
+
+func TestRunDueSendsEachDeliveryOnce(t *testing.T) {
+	e := apitest.New(t)
+	endpoint(t, e, e.Acme, "https://hooks.acme.example/all", "*")
+	publish(t, e, "customer.created")
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, _ = e.Webhooks.RunDue(context.Background())
+		}()
+	}
+	wg.Wait()
+	if n := len(e.HTTP.Requests()); n != 1 {
+		t.Fatalf("requests = %d, want 1", n)
+	}
+}
