-func (s *Service) deliver(ctx context.Context, d store.Delivery) {
+// deliver makes one attempt at a delivery and records its outcome. It returns an error only when the owners could not be
+// emailed.
+func (s *Service) deliver(ctx context.Context, d store.Delivery) error {
 	status, errText := 0, ""
 	ep, ok := s.store.WebhookEndpoint(d.OrgID, d.EndpointID)
 	e, eok := s.store.EventByID(d.EventID)
+	// hopeless is set when another attempt cannot help: the endpoint or the event is gone.
+	hopeless := false
 	switch {
 	case !ok || !ep.Enabled:
-		errText = "the endpoint is disabled or was deleted"
+		errText, hopeless = "the endpoint is disabled or was deleted", true
 	case !eok:
-		errText = "the event no longer exists"
+		errText, hopeless = "the event no longer exists", true
 	default:
 		status, errText = s.send(ctx, ep, e)
 	}
+	gone := status == http.StatusGone
 	now := s.clock.Now()
+	exhausted := false
 	_, _ = s.store.UpdateDelivery(d.ID, func(d *store.Delivery) error {
 		d.Attempts++
 		d.LastAttemptAt = &now
