+// RunDue attempts every delivery that is due at the clock's time and returns how many attempts it made. An answer with a
+// 2xx status marks a delivery succeeded. Any other failure leaves it pending for another attempt after retryDelays; after
+// the 7th failed attempt it has failed for good, and the owners are emailed. A 410 Gone fails it for good at once and
+// disables its endpoint.
 func (s *Service) RunDue(ctx context.Context) (int, error) {
+	s.runMu.Lock()
+	defer s.runMu.Unlock()
