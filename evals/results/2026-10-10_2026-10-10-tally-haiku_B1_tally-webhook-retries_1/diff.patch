-		} else {
+		case hopeless || gone:
+			d.Status = store.DeliveryFailed
+		case d.Attempts >= maxAttempts:
 			d.Status = store.DeliveryFailed
+			exhausted = true
+		default:
+			d.Status = store.DeliveryPending
+			next := now.Add(retryDelays[d.Attempts-1])
+			d.NextAttemptAt = &next
+		}
+		return nil
+	})
+	if gone {
+		_, _ = s.store.UpdateWebhookEndpoint(d.OrgID, d.EndpointID, func(ep *store.WebhookEndpoint) error {
+			ep.Enabled, ep.DisabledReason = false, "gone"
+			return nil
+		})
+	}
+	if exhausted {
+		return s.notifyOwners(ctx, d.OrgID, ep, errText)
+	}
+	return nil
+}
+
+// notifyOwners emails every owner of the organization that the endpoint keeps failing. It sends nothing when the owners were
+// already emailed about the endpoint within failureEmailInterval.
+func (s *Service) notifyOwners(ctx context.Context, orgID string, ep store.WebhookEndpoint, lastErr string) error {
+	if !s.claimFailureEmail(orgID, ep.ID, s.clock.Now()) {
+		return nil
+	}
+	var errs []error
+	for _, m := range s.store.Members(orgID) {
+		if m.Role != store.RoleOwner {
+			continue
+		}
+		u, ok := s.store.User(m.UserID)
+		if !ok {
+			continue
+		}
+		errs = append(errs, s.mail.Send(ctx, mail.Message{
+			To:      u.Email,
+			Subject: "Webhook endpoint failing: " + ep.URL,
+			Body: fmt.Sprintf("Tally could not deliver an event to %s after %d attempts. The last attempt failed: %s\n\n"+
+				"The endpoint is still enabled, so later events are still sent to it. Check that it answers with a 2xx status.\n",
+				ep.URL, maxAttempts, lastErr),
+		}))
+	}
+	return errors.Join(errs...)
+}
+
+// claimFailureEmail records that the owners are being emailed about an endpoint, and reports whether they may be: not when
+// they were emailed about it less than failureEmailInterval ago.
+func (s *Service) claimFailureEmail(orgID, endpointID string, now time.Time) bool {
+	claimed := false
+	_, err := s.store.UpdateWebhookEndpoint(orgID, endpointID, func(ep *store.WebhookEndpoint) error {
+		if ep.FailureEmailAt != nil && now.Sub(*ep.FailureEmailAt) < failureEmailInterval {
+			return nil
 		}
+		at := now
+		ep.FailureEmailAt = &at
+		claimed = true
 		return nil
 	})
+	return err == nil && claimed
 }
 
