+package api
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"strings"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// auditSecrets are the fields that never enter the audit log: API key tokens, webhook secrets and invite tokens.
+var auditSecrets = map[string]bool{"token": true, "secret": true}
+
+// audit records a successful request of an audited kind, made by the member p acts for. action is "<type>.<verb>", and
+// its first part is the target's type. id is the target's ID. changes comes from auditChanges for updates and is nil
+// otherwise.
+func (s *Server) audit(r *http.Request, p auth.Principal, action, id string, changes map[string]store.AuditChange) {
+	typ, _, _ := strings.Cut(action, ".")
+	s.store.RecordAudit(store.AuditEntry{
+		OrgID:     p.OrgID,
+		Action:    action,
+		Actor:     store.AuditActor{Type: "api_key", ID: p.KeyID, UserID: p.UserID},
+		Target:    store.AuditTarget{Type: typ, ID: id},
+		RequestID: RequestID(r.Context()),
+		At:        s.clock.Now(),
+		Changes:   changes,
+	})
+}
+
+// auditChanges returns the fields whose JSON value differs between before and after, which are values of one type, each
+// with its old and new value. A field that omitempty drops at its zero value is read as that zero value, so a cleared
+// field is recorded too. It is empty when nothing changed.
+func auditChanges(before, after any) map[string]store.AuditChange {
+	oldFields, newFields := jsonFields(before), jsonFields(after)
+	zeros := jsonZeros(after)
+	names := map[string]bool{}
+	for name := range oldFields {
+		names[name] = true
+	}
+	for name := range newFields {
+		names[name] = true
+	}
+	changes := map[string]store.AuditChange{}
+	for name := range names {
+		from, to := fieldOrZero(oldFields, zeros, name), fieldOrZero(newFields, zeros, name)
+		if !auditSecrets[name] && !bytes.Equal(from, to) {
+			changes[name] = store.AuditChange{From: from, To: to}
+		}
+	}
+	return changes
+}
+
+// jsonFields returns the fields of a struct value by JSON name. Every type passed here marshals, so errors are ignored.
+func jsonFields(v any) map[string]json.RawMessage {
+	b, _ := json.Marshal(v)
+	var fields map[string]json.RawMessage
+	_ = json.Unmarshal(b, &fields)
+	return fields
+}
+
+// jsonZeros returns the JSON of each exported field's zero value by JSON name, for the type of the struct v.
+func jsonZeros(v any) map[string]json.RawMessage {
+	t := reflect.TypeOf(v)
+	if t.Kind() == reflect.Pointer {
+		t = t.Elem()
+	}
+	zeros := map[string]json.RawMessage{}
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		name, _, _ := strings.Cut(f.Tag.Get("json"), ",")
+		if !f.IsExported() || name == "" || name == "-" {
+			continue
+		}
+		b, _ := json.Marshal(reflect.Zero(f.Type).Interface())
+		zeros[name] = b
+	}
+	return zeros
+}
+
+// fieldOrZero returns the JSON value of a field, or the field's zero value when the field is omitted.
+func fieldOrZero(fields, zeros map[string]json.RawMessage, name string) json.RawMessage {
+	if v, ok := fields[name]; ok {
+		return v
+	}
+	return zeros[name]
+}
+
+// auditView is an audit entry as the API shows it. Only updates have changes.
+type auditView struct {
+	ID        string                         `json:"id"`
+	Action    string                         `json:"action"`
+	Actor     store.AuditActor               `json:"actor"`
+	Target    store.AuditTarget              `json:"target"`
+	RequestID string                         `json:"request_id"`
+	At        time.Time                      `json:"at"`
+	Changes   *map[string]store.AuditChange `json:"changes,omitempty"`
+}
+
+func viewAudit(e store.AuditEntry) auditView {
+	v := auditView{ID: e.ID, Action: e.Action, Actor: e.Actor, Target: e.Target, RequestID: e.RequestID, At: e.At}
+	if e.Changes != nil {
+		v.Changes = &e.Changes
+	}
+	return v
+}
+
+func auditKey(e store.AuditEntry) cursor { return cursor{T: e.At, ID: e.ID} }
+
+// listAuditEvents lists the organization's audit entries, newest first, optionally only those with ?action=, ?target_id=
+// or ?actor_id= (a user ID or an API key ID). Only owners and admins may read the log.
+func (s *Server) listAuditEvents(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	if !auth.CanManageTeam(p.Role) {
+		writeJSON(w, http.StatusForbidden, map[string]string{"error": "forbidden"})
+		return
+	}
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	q := r.URL.Query()
+	entries := s.store.AuditEntries(p.OrgID, store.AuditFilter{Action: q.Get("action"), TargetID: q.Get("target_id"), ActorID: q.Get("actor_id")})
+	items, next := pageNewestFirst(entries, auditKey, pg)
+	views := make([]auditView, 0, len(items))
+	for _, e := range items {
+		views = append(views, viewAudit(e))
+	}
+	writeJSON(w, http.StatusOK, list{Items: views, NextCursor: next})
+}
