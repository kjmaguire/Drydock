 }
 
-// pageOf returns one page of items, which are sorted by key (creation time, then ID), and the cursor of the next page.
+// pageOf returns one page of items, which are sorted oldest first by key (creation time, then ID), and the cursor of the
+// next page.
 func pageOf[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	return pageSorted(items, key, p, func(k, c cursor) bool { return c.less(k) })
+}
+
+// pageNewestFirst is pageOf for items sorted newest first.
+func pageNewestFirst[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	return pageSorted(items, key, p, func(k, c cursor) bool { return k.less(c) })
+}
+
+// pageSorted returns one page of items, starting after the cursor, and the cursor of the next page. follows reports
+// whether an item with key k comes after the cursor c in the order of the items.
+func pageSorted[T any](items []T, key func(T) cursor, p page, follows func(k, c cursor) bool) ([]T, string) {
 	start := 0
 	if p.after != nil {
 		start = len(items)
 		for i, it := range items {
-			if p.after.less(key(it)) {
+			if follows(key(it), *p.after) {
 				start = i
 				break
 			}
