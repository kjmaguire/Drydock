diff --git a/result/internal/store/audit.go b/result/internal/store/audit.go
new file mode 100644
index 0000000..e0f87a9
--- /dev/null
+++ b/result/internal/store/audit.go
@@ -0,0 +1,79 @@
+package store
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+)
+
+// AuditEntry records a successful change made through the API: who made it (Actor), what it was made to (Target), the
+// request that made it and, for updates, the fields that changed. Entries are never changed or deleted.
+type AuditEntry struct {
+	ID        string                 `json:"id"`
+	OrgID     string                 `json:"org_id"`
+	Action    string                 `json:"action"`
+	Actor     AuditActor             `json:"actor"`
+	Target    AuditTarget            `json:"target"`
+	RequestID string                 `json:"request_id"`
+	At        time.Time              `json:"at"`
+	Changes   map[string]AuditChange `json:"changes"` // each changed field of an update, with its old and new values; nil otherwise
+}
+
+// AuditActor is an API key and the member it acts for.
+type AuditActor struct {
+	Type   string `json:"type"` // "api_key"
+	ID     string `json:"id"`
+	UserID string `json:"user_id"`
+}
+
+// AuditTarget is the object a change was made to.
+type AuditTarget struct {
+	Type string `json:"type"`
+	ID   string `json:"id"`
+}
+
+// AuditChange is one field's JSON value before and after an update.
+type AuditChange struct {
+	From json.RawMessage `json:"from"`
+	To   json.RawMessage `json:"to"`
+}
+
+// AuditFilter selects audit entries. An empty field matches every entry.
+type AuditFilter struct {
+	Action   string
+	TargetID string
+	ActorID  string // a user ID or an API key ID
+}
+
+// RecordAudit appends an entry to the audit log and gives it its ID.
+func (s *Store) RecordAudit(e AuditEntry) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e.ID = fmt.Sprintf("aud_%06d", len(s.audit)+1)
+	e.At = e.At.UTC()
+	s.audit = append(s.audit, e)
+}
+
+// AuditEntries returns an organization's audit entries that match f, newest first.
+func (s *Store) AuditEntries(orgID string, f AuditFilter) []AuditEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []AuditEntry{}
+	for i := len(s.audit) - 1; i >= 0; i-- {
+		e := s.audit[i]
+		if e.OrgID != orgID {
+			continue
+		}
+		if f.Action != "" && e.Action != f.Action {
+			continue
+		}
+		if f.TargetID != "" && e.Target.ID != f.TargetID {
+			continue
+		}
+		if f.ActorID != "" && e.Actor.ID != f.ActorID && e.Actor.UserID != f.ActorID {
+			continue
+		}
+		out = append(out, e)
+	}
+	return out
+}
diff --git a/result/internal/store/audit_test.go b/result/internal/store/audit_test.go
new file mode 100644
index 0000000..2c35144
--- /dev/null
+++ b/result/internal/store/audit_test.go
@@ -0,0 +1,59 @@
+package store
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestAuditLogSurvivesASnapshot(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	actor := AuditActor{Type: "api_key", ID: "key_000001", UserID: "usr_000001"}
+	s.RecordAudit(AuditEntry{OrgID: o.ID, Action: "customer.created", Actor: actor, Target: AuditTarget{Type: "customer", ID: "cus_000002"}, RequestID: "req_1", At: t0})
+	s.RecordAudit(AuditEntry{OrgID: o.ID, Action: "customer.updated", Actor: actor, Target: AuditTarget{Type: "customer", ID: "cus_000002"}, RequestID: "req_2", At: t0,
+		Changes: map[string]AuditChange{"name": {From: json.RawMessage(`"Jane"`), To: json.RawMessage(`"Janet"`)}}})
+	s.RecordAudit(AuditEntry{OrgID: o.ID, Action: "customer.updated", Actor: actor, Target: AuditTarget{Type: "customer", ID: "cus_000002"}, RequestID: "req_3", At: t0,
+		Changes: map[string]AuditChange{}})
+
+	b, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var st State
+	if err := json.Unmarshal(b, &st); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f := AuditFilter{}
+	if got, want := loaded.AuditEntries(o.ID, f), s.AuditEntries(o.ID, f); !reflect.DeepEqual(got, want) {
+		t.Fatalf("loaded entries = %+v\nwant %+v", got, want)
+	}
+	loaded.RecordAudit(AuditEntry{OrgID: o.ID, Action: "customer.deleted", Actor: actor, Target: AuditTarget{Type: "customer", ID: "cus_000002"}, At: t0})
+	if newest := loaded.AuditEntries(o.ID, f)[0]; newest.ID != "aud_000004" {
+		t.Fatalf("the next entry after a load has ID %s, want aud_000004", newest.ID)
+	}
+}
+
+func TestAuditEntriesFilterByOrganizationAndField(t *testing.T) {
+	s := New()
+	acme, globex := newOrg(t, s, "Acme"), newOrg(t, s, "Globex")
+	s.RecordAudit(AuditEntry{OrgID: acme.ID, Action: "plan.created", Actor: AuditActor{Type: "api_key", ID: "key_1", UserID: "usr_1"}, Target: AuditTarget{Type: "plan", ID: "pln_1"}, At: t0})
+	s.RecordAudit(AuditEntry{OrgID: globex.ID, Action: "plan.created", Actor: AuditActor{Type: "api_key", ID: "key_2", UserID: "usr_2"}, Target: AuditTarget{Type: "plan", ID: "pln_2"}, At: t0})
+
+	if got := s.AuditEntries(acme.ID, AuditFilter{}); len(got) != 1 || got[0].Target.ID != "pln_1" {
+		t.Fatalf("Acme's entries = %+v", got)
+	}
+	if got := s.AuditEntries(acme.ID, AuditFilter{ActorID: "usr_2"}); len(got) != 0 {
+		t.Fatalf("a user of another organization matched: %+v", got)
+	}
+	if got := s.AuditEntries(globex.ID, AuditFilter{ActorID: "key_2", Action: "plan.created", TargetID: "pln_2"}); len(got) != 1 {
+		t.Fatalf("all filters together = %+v", got)
+	}
+	if got := s.AuditEntries(globex.ID, AuditFilter{Action: "plan.updated"}); len(got) != 0 {
+		t.Fatalf("action filter = %+v", got)
+	}
+}
