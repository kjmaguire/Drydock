+func TestAuditRecordsNothingForFailedRequests(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	inv := map[string]any{"customer_id": c.ID, "currency": "USD", "lines": []map[string]any{{"description": "Consulting", "quantity": 1, "unit_amount": 1000}}}
+	var open store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, inv, &open)
+	_, viewer := e.AddMember(e.Acme, "v@acme.example", store.RoleViewer)
+	_, member := e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	before := len(auditLog(e, e.Acme.Key, ""))
+
+	for _, f := range []struct {
+		method, path, key string
+		body              any
+		code              int
+	}{
+		{"POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "", "email": "bad"}, http.StatusUnprocessableEntity},
+		{"PATCH", "/v1/customers/cus_999999", e.Acme.Key, map[string]string{"name": "Nobody"}, http.StatusNotFound},
+		{"POST", "/v1/customers", viewer, map[string]string{"name": "Viewer", "email": "viewer@example.com"}, http.StatusForbidden},
+		{"PATCH", "/v1/org", member, map[string]any{"name": "Hacked"}, http.StatusForbidden},
+		{"POST", "/v1/invoices/" + open.ID + "/pay", e.Acme.Key, map[string]string{"payment_method": "pm_card_declined"}, http.StatusPaymentRequired},
+		{"POST", "/v1/invoices/" + open.ID + "/pay", e.Acme.Key, map[string]string{"payment_method": "pm_gateway_down"}, http.StatusServiceUnavailable},
+		{"DELETE", "/v1/customers/" + c.ID, e.Globex.Key, nil, http.StatusNotFound},
+	} {
+		if r := e.Do(f.method, f.path, f.key, f.body); r.Code != f.code {
+			t.Fatalf("%s %s: want %d, got %s", f.method, f.path, f.code, r)
+		}
+	}
+	if n := len(auditLog(e, e.Acme.Key, "")); n != before {
+		t.Fatalf("failed requests recorded %d entries", n-before)
+	}
+	if n := len(auditLog(e, e.Globex.Key, "")); n != 0 {
+		t.Fatalf("another organization sees %d entries", n)
+	}
+}
