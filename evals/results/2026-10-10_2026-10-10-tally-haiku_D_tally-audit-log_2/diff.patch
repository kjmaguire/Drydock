+package api_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"regexp"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// auditItem is an audit entry as the API answers it.
+type auditItem struct {
+	ID        string            `json:"id"`
+	Action    string            `json:"action"`
+	Actor     store.AuditActor  `json:"actor"`
+	Target    store.AuditTarget `json:"target"`
+	RequestID string            `json:"request_id"`
+	At        time.Time         `json:"at"`
+	Changes   json.RawMessage   `json:"changes"`
+}
+
+// auditPage is one page of the audit log, newest first.
+type auditPage struct {
+	Items      []auditItem `json:"items"`
+	NextCursor string      `json:"next_cursor"`
+}
+
+// auditLog returns the entries that key reads for query (for example "?action=customer.created"), newest first.
+func auditLog(e *apitest.Env, key, query string) []auditItem {
+	e.T.Helper()
+	var page auditPage
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events"+query, key, nil, &page)
+	return page.Items
+}
+
+// changesOf returns the entry's changes, or nil when it has none (the field is absent).
+func changesOf(t *testing.T, it auditItem) map[string]store.AuditChange {
+	t.Helper()
+	if it.Changes == nil {
+		return nil
+	}
+	var c map[string]store.AuditChange
+	if err := json.Unmarshal(it.Changes, &c); err != nil {
+		t.Fatalf("changes of %s: %v", it.ID, err)
+	}
+	return c
+}
+
+func requestID(id string) http.Header { return http.Header{"X-Request-Id": {id}} }
+
+func TestAuditRecordsSuccessfulChanges(t *testing.T) {
+	e := apitest.New(t)
+	var me struct {
+		User     store.User `json:"user"`
+		APIKeyID string     `json:"api_key_id"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", e.Acme.Key, nil, &me)
+	actor := store.AuditActor{Type: "api_key", ID: me.APIKeyID, UserID: me.User.ID}
+
+	var c store.Customer
+	r := e.DoWith("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane", "email": "jane@example.com"}, requestID("req-create"))
+	if r.Code != http.StatusCreated {
+		t.Fatalf("create: %s", r)
+	}
+	r.JSON(t, &c)
+	e.Clock.Advance(time.Hour)
+	created := auditLog(e, e.Acme.Key, "")
+	if len(created) != 1 {
+		t.Fatalf("entries after create = %+v", created)
+	}
+	if it := created[0]; it.Action != "customer.created" || it.Actor != actor || it.Target != (store.AuditTarget{Type: "customer", ID: c.ID}) ||
+		it.RequestID != "req-create" || !it.At.Equal(apitest.Start) || it.Changes != nil {
+		t.Fatalf("created entry = %+v", it)
+	}
+
+	r = e.DoWith("PATCH", "/v1/customers/"+c.ID, e.Acme.Key, map[string]string{"name": "Janet"}, requestID("req-rename"))
+	if r.Code != http.StatusOK {
+		t.Fatalf("rename: %s", r)
+	}
+	updated := auditLog(e, e.Acme.Key, "?action=customer.updated")
+	if len(updated) != 1 {
+		t.Fatalf("updated entries = %+v", updated)
+	}
+	it := updated[0]
+	if it.RequestID != "req-rename" || !it.At.Equal(apitest.Start.Add(time.Hour)) || it.Target.ID != c.ID {
+		t.Fatalf("updated entry = %+v", it)
+	}
+	ch := changesOf(t, it)
+	if len(ch) != 1 || string(ch["name"].From) != `"Jane"` || string(ch["name"].To) != `"Janet"` {
+		t.Fatalf("changes = %+v; want only name from Jane to Janet", ch)
+	}
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, e.Acme.Key, map[string]string{"name": "Janet"}, nil)
+	same := auditLog(e, e.Acme.Key, "?action=customer.updated&target_id="+c.ID)
+	if len(same) != 2 || same[0].Changes == nil || len(changesOf(t, same[0])) != 0 {
+		t.Fatalf("an update that changes nothing should record empty changes: %+v", same)
+	}
+
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+c.ID, e.Acme.Key, nil, nil)
+	deleted := auditLog(e, e.Acme.Key, "?action=customer.deleted")
+	if len(deleted) != 1 || deleted[0].Target.ID != c.ID || deleted[0].Changes != nil {
+		t.Fatalf("deleted entries = %+v", deleted)
+	}
+}
+
+func TestAuditCoversEveryKind(t *testing.T) {
+	e := apitest.New(t)
+	var page auditPage
+	var sub store.Subscription
+	var key store.APIKey
+	var inv store.Invite
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"tax_rate_bp": 2000}, nil)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, e.Acme.Key, map[string]string{"name": "Jane Doe"}, nil)
+	gone := e.CreateCustomer(e.Acme, "Gone", "gone@example.com")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+gone.ID, e.Acme.Key, nil, nil)
+
+	plan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/plans/"+plan.ID, e.Acme.Key, map[string]string{"name": "Team Plus"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": plan.ID, "quantity": 2}, &sub)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"quantity": 5}, nil)
+
+	var paid, voided store.Invoice
+	manual := map[string]any{"customer_id": c.ID, "currency": "USD", "lines": []map[string]any{{"description": "Consulting", "quantity": 1, "unit_amount": 1000}}}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, manual, &paid)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, manual, &voided)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+paid.ID+"/pay", e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+voided.ID+"/void", e.Acme.Key, nil, nil)
+
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "CI"}, &key)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+key.ID, e.Acme.Key, nil, nil)
+
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"}, &inv)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+inv.ID, e.Acme.Key, nil, nil)
+	m, _ := e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+m.ID, e.Acme.Key, map[string]string{"role": "billing"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+m.ID, e.Acme.Key, nil, nil)
+
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, map[string]any{"enabled": false}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, nil, nil)
+
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", e.Acme.Key, map[string]bool{"at_period_end": true}, nil)
+
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events?limit=100", e.Acme.Key, nil, &page)
+	var got []string
+	for i := len(page.Items) - 1; i >= 0; i-- {
+		got = append(got, page.Items[i].Action)
+	}
+	want := []string{
+		"org.updated",
+		"customer.created", "customer.updated", "customer.created", "customer.deleted",
+		"plan.created", "plan.updated", "subscription.created", "subscription.updated",
+		"invoice.created", "invoice.created", "invoice.paid", "invoice.voided",
+		"api_key.created", "api_key.revoked",
+		"invite.created", "invite.revoked", "member.role_changed", "member.removed",
+		"webhook_endpoint.created", "webhook_endpoint.updated", "webhook_endpoint.deleted",
+		"subscription.canceled",
+	}
+	if !slices.Equal(got, want) {
+		t.Fatalf("actions = %v\nwant    %v", got, want)
+	}
+}
+
+func TestAuditChangesNameTheFieldsThatChanged(t *testing.T) {
+	e := apitest.New(t)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", e.Acme.Key, map[string]any{"tax_rate_bp": 2000, "time_zone": "Asia/Tokyo"}, nil)
+	org := auditLog(e, e.Acme.Key, "?action=org.updated")
+	if len(org) != 1 || org[0].Target != (store.AuditTarget{Type: "org", ID: e.Acme.ID}) {
+		t.Fatalf("org entries = %+v", org)
+	}
+	ch := changesOf(t, org[0])
+	if len(ch) != 2 || string(ch["tax_rate_bp"].From) != "0" || string(ch["tax_rate_bp"].To) != "2000" ||
+		string(ch["time_zone"].From) != `"America/New_York"` || string(ch["time_zone"].To) != `"Asia/Tokyo"` {
+		t.Fatalf("org changes = %+v", ch)
+	}
+
+	_, member := e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	var me struct {
+		User store.User `json:"user"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", member, nil, &me)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+me.User.ID, e.Acme.Key, map[string]string{"role": "admin"}, nil)
+	roles := auditLog(e, e.Acme.Key, "?action=member.role_changed")
+	if len(roles) != 1 || roles[0].Target != (store.AuditTarget{Type: "member", ID: me.User.ID}) {
+		t.Fatalf("role entries = %+v", roles)
+	}
+	ch = changesOf(t, roles[0])
+	if len(ch) != 1 || string(ch["role"].From) != `"member"` || string(ch["role"].To) != `"admin"` {
+		t.Fatalf("role changes = %+v", ch)
+	}
+}
