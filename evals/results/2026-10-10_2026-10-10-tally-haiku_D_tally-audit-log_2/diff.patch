+func TestAuditRecordsNoSecrets(t *testing.T) {
+	e := apitest.New(t)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, map[string]any{"events": []string{"customer.created"}}, nil)
+	var key store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "CI"}, &key)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+key.ID, e.Acme.Key, nil, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"}, nil)
+	token := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(e.Mail.Messages()[0].Body)
+	if token == nil {
+		t.Fatal("no invite token in the email")
+	}
+
+	r := e.Do("GET", "/v1/audit-events", e.Acme.Key, nil)
+	if r.Code != http.StatusOK {
+		t.Fatalf("list: %s", r)
+	}
+	body := string(r.Body)
+	if !strings.Contains(body, `"webhook_endpoint.updated"`) {
+		t.Fatalf("the endpoint update is not in the log: %s", body)
+	}
+	for _, secret := range []string{ep.Secret, key.Token, token[1], "whsec_", "tly_", "invite_"} {
+		if strings.Contains(body, secret) {
+			t.Fatalf("the audit log holds a secret (%s): %s", secret, body)
+		}
+	}
+}
+
+func TestAuditFiltersAndPages(t *testing.T) {
+	e := apitest.New(t)
+	var me struct {
+		User     store.User `json:"user"`
+		APIKeyID string     `json:"api_key_id"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", e.Acme.Key, nil, &me)
+	a := e.CreateCustomer(e.Acme, "A", "a@example.com")
+	b := e.CreateCustomer(e.Acme, "B", "b@example.com")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+a.ID, e.Acme.Key, map[string]string{"name": "A2"}, nil)
+	m, memberKey := e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+b.ID, memberKey, map[string]string{"name": "B2"}, nil)
+
+	if n := len(auditLog(e, e.Acme.Key, "?action=customer.created")); n != 2 {
+		t.Fatalf("action filter: %d entries", n)
+	}
+	onA := auditLog(e, e.Acme.Key, "?target_id="+a.ID)
+	if len(onA) != 2 || onA[0].Action != "customer.updated" || onA[1].Action != "customer.created" {
+		t.Fatalf("target filter = %+v", onA)
+	}
+	if n := len(auditLog(e, e.Acme.Key, "?actor_id="+me.User.ID)); n != 3 {
+		t.Fatalf("actor filter by user: %d entries, want the owner's 3", n)
+	}
+	if n := len(auditLog(e, e.Acme.Key, "?actor_id="+me.APIKeyID)); n != 3 {
+		t.Fatalf("actor filter by key: %d entries, want the owner's 3", n)
+	}
+	byMember := auditLog(e, e.Acme.Key, "?actor_id="+m.ID)
+	if len(byMember) != 1 || byMember[0].Action != "customer.updated" || byMember[0].Target.ID != b.ID {
+		t.Fatalf("actor filter for the member = %+v", byMember)
+	}
+
+	var seen []string
+	cursor := ""
+	for {
+		q := "?limit=2"
+		if cursor != "" {
+			q += "&cursor=" + cursor
+		}
+		var page auditPage
+		e.MustDo(http.StatusOK, "GET", "/v1/audit-events"+q, e.Acme.Key, nil, &page)
+		for _, it := range page.Items {
+			seen = append(seen, it.ID)
+		}
+		if page.NextCursor == "" {
+			break
+		}
+		cursor = page.NextCursor
+	}
+	all := auditLog(e, e.Acme.Key, "")
+	if len(seen) != len(all) || len(all) != 4 {
+		t.Fatalf("paged %d entries, the whole log has %d", len(seen), len(all))
+	}
+	for i, it := range all {
+		if seen[i] != it.ID {
+			t.Fatalf("page %d = %s, want %s", i, seen[i], it.ID)
+		}
+	}
+	e.MustDo(http.StatusBadRequest, "GET", "/v1/audit-events?limit=0", e.Acme.Key, nil, nil)
+}
+
+func TestAuditIsForOwnersAndAdmins(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, admin := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events", admin, nil, nil)
+	for _, role := range []store.Role{store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		_, key := e.AddMember(e.Acme, string(role)+"@acme.example", role)
+		r := e.Do("GET", "/v1/audit-events", key, nil)
+		if r.Code != http.StatusForbidden || string(r.Body) != "{\"error\":\"forbidden\"}\n" {
+			t.Fatalf("%s reads the log: %s", role, r)
+		}
+	}
+	if r := e.Do("GET", "/v1/audit-events", "", nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("no key: %s", r)
+	}
+}
+
+func TestDeleteEndpointOfAnotherOrganization(t *testing.T) {
+	e := apitest.New(t)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	if r := e.Do("DELETE", "/v1/webhook-endpoints/"+ep.ID, e.Globex.Key, nil); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("delete another org's endpoint: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, nil, nil)
+	if n := len(auditLog(e, e.Globex.Key, "")); n != 0 {
+		t.Fatalf("another organization's log has %d entries", n)
+	}
+}
