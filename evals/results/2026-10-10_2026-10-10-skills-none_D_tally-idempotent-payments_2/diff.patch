 // payInvoice charges an invoice: {"payment_method": "pm_..."}, or the customer's default payment method when it is absent.
+//
+// With an Idempotency-Key header, a retry of the same request gets the first request's response again and is not charged
+// again. Responses with a status of 500 or more are not kept, so their retry pays again.
 func (s *Server) payInvoice(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	key, ok := idempotencyKey(w, r)
+	if !ok {
+		return
+	}
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 1<<20))
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_json", "the body could not be read: "+err.Error())
+		return
+	}
+	r.Body = io.NopCloser(bytes.NewReader(raw))
+	if key == "" {
+		s.charge(w, r, p)
+		return
+	}
+	id := r.PathValue("id")
+	resp, res := s.store.BeginIdempotent(p.OrgID, key, fingerprint(id, raw), s.clock.Now())
+	switch res {
+	case store.IdempotencyReused:
+		writeError(w, http.StatusUnprocessableEntity, "idempotency_key_reused", "this Idempotency-Key was used for another invoice or another body")
+		return
+	case store.IdempotencyInProgress:
+		writeError(w, http.StatusConflict, "request_in_progress", "a request with this Idempotency-Key is still being handled")
+		return
+	case store.IdempotencyReplay:
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Idempotent-Replayed", "true")
+		w.WriteHeader(resp.Status)
+		_, _ = w.Write(resp.Body)
+		return
+	}
+	rec := &capture{ResponseWriter: w}
+	keep := false
+	defer func() {
+		if !keep { // a panic, or a server error: the key is free for the retry
+			s.store.AbandonIdempotent(p.OrgID, key)
+		}
+	}()
+	s.charge(rec, r, p)
+	if rec.status < http.StatusInternalServerError {
+		s.store.FinishIdempotent(p.OrgID, key, rec.status, rec.body.Bytes(), s.clock.Now())
+		keep = true
+	}
