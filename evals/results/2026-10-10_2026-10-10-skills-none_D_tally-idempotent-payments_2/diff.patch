+// idempotencyKey reads the Idempotency-Key header: "" when there is none, or 400 when it is not 1 to 255 printable ASCII
+// characters. It returns false when it has answered.
+func idempotencyKey(w http.ResponseWriter, r *http.Request) (string, bool) {
+	vs := r.Header.Values("Idempotency-Key")
+	if len(vs) == 0 {
+		return "", true
+	}
+	k := vs[0]
+	if len(vs) > 1 || len(k) < 1 || len(k) > 255 || strings.ContainsFunc(k, func(c rune) bool { return c < 0x20 || c > 0x7e }) {
+		writeError(w, http.StatusBadRequest, "invalid_idempotency_key", "Idempotency-Key is 1 to 255 printable ASCII characters")
+		return "", false
+	}
+	return k, true
+}
+
+// fingerprint identifies a request for its idempotency key: the invoice and the body.
+func fingerprint(invoiceID string, body []byte) string {
+	sum := sha256.Sum256(body)
+	return invoiceID + " " + hex.EncodeToString(sum[:])
+}
+
+// capture records the status and body of a response as it is written.
+type capture struct {
+	http.ResponseWriter
+	status int
+	body   bytes.Buffer
+}
+
+func (c *capture) WriteHeader(status int) {
+	c.status = status
+	c.ResponseWriter.WriteHeader(status)
+}
+
+func (c *capture) Write(b []byte) (int, error) {
+	if c.status == 0 {
+		c.status = http.StatusOK
+	}
+	c.body.Write(b)
+	return c.ResponseWriter.Write(b)
+}
