+++ b/result/internal/store/idempotency.go
@@ -0,0 +1,83 @@
+package store
+
+import "time"
+
+// IdempotencyTTL is how long a kept response is replayed, counted from when it was kept.
+const IdempotencyTTL = 24 * time.Hour
+
+// IdempotencyResult is the answer to BeginIdempotent.
+type IdempotencyResult int
+
+const (
+	// IdempotencyBegun means the key is reserved for the caller, who must end the reservation with FinishIdempotent or
+	// AbandonIdempotent.
+	IdempotencyBegun IdempotencyResult = iota
+	// IdempotencyReplay means a response was kept for this key and this request; it is the answer to give again.
+	IdempotencyReplay
+	// IdempotencyInProgress means another request with this key is still being handled.
+	IdempotencyInProgress
+	// IdempotencyReused means the key was used for another request: another invoice or another body.
+	IdempotencyReused
+)
+
+// KeptResponse is a response kept for an idempotency key.
+type KeptResponse struct {
+	Status int
+	Body   []byte
+}
+
+type idemKey struct{ org, key string }
+
+// idemRecord is what a request that carried an idempotency key leaves behind.
+type idemRecord struct {
+	fingerprint string
+	done        bool
+	resp        KeptResponse
+	doneAt      time.Time
+}
+
+// BeginIdempotent looks up an organization's idempotency key for a request with the fingerprint fp. A key that was never
+// used, or whose kept response is older than IdempotencyTTL, is reserved for the caller. Otherwise the result says how the
+// request relates to the earlier one; the kept response is returned with IdempotencyReplay.
+func (s *Store) BeginIdempotent(orgID, key, fp string, now time.Time) (KeptResponse, IdempotencyResult) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := idemKey{orgID, key}
+	rec, ok := s.idem[k]
+	if ok && rec.done && !now.Before(rec.doneAt.Add(IdempotencyTTL)) {
+		ok = false
+	}
+	if !ok {
+		s.idem[k] = idemRecord{fingerprint: fp}
+		return KeptResponse{}, IdempotencyBegun
+	}
+	switch {
+	case rec.fingerprint != fp:
+		return KeptResponse{}, IdempotencyReused
+	case !rec.done:
+		return KeptResponse{}, IdempotencyInProgress
+	}
+	return rec.resp, IdempotencyReplay
+}
+
+// FinishIdempotent keeps the response to a request whose key BeginIdempotent reserved.
+func (s *Store) FinishIdempotent(orgID, key string, status int, body []byte, now time.Time) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := idemKey{orgID, key}
+	rec := s.idem[k]
+	rec.done = true
+	rec.resp = KeptResponse{Status: status, Body: append([]byte(nil), body...)}
+	rec.doneAt = now.UTC()
+	s.idem[k] = rec
+}
+
+// AbandonIdempotent releases a reservation whose request was not kept (a server error, or a panic), so a retry runs again.
+func (s *Store) AbandonIdempotent(orgID, key string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	k := idemKey{orgID, key}
+	if rec, ok := s.idem[k]; ok && !rec.done {
+		delete(s.idem, k)
+	}
+}
