+// invoiceFor creates an open invoice of 10.00 for a new customer of org and returns its ID.
+func invoiceFor(e *apitest.Env, org apitest.Org, name string) string {
+	e.T.Helper()
+	c := e.CreateCustomer(org, name, strings.ReplaceAll(strings.ToLower(name), " ", "")+"@example.com")
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", org.Key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Work", "quantity": 1, "unit_amount": 1000}}}, &inv)
+	return inv.ID
+}
+
+func payPath(invoiceID string) string { return "/v1/invoices/" + invoiceID + "/pay" }
+
+func keyed(key string) http.Header { return http.Header{"Idempotency-Key": {key}} }
+
+func TestIdempotencyKeyReplaysTheResponse(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(e, e.Acme, "Jane")
+	body := map[string]string{"payment_method": "pm_card_visa"}
+	first := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("pay-1"))
+	if first.Code != http.StatusOK || first.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("first: %s", first)
+	}
+	again := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("pay-1"))
+	if again.Code != http.StatusOK || again.Header.Get("Idempotent-Replayed") != "true" || string(again.Body) != string(first.Body) {
+		t.Fatalf("retry: %s (replayed %q), want %s", again, again.Header.Get("Idempotent-Replayed"), first)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestIdempotencyKeyReuseIsRefused(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(e, e.Acme, "Jane")
+	other := invoiceFor(e, e.Acme, "John")
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, map[string]string{"payment_method": "pm_card_declined"}, keyed("pay-2")); r.Code != http.StatusPaymentRequired {
+		t.Fatalf("first: %s", r)
+	}
+	for _, c := range []struct {
+		invoice string
+		body    map[string]string
+	}{
+		{other, map[string]string{"payment_method": "pm_card_declined"}},
+		{inv, map[string]string{"payment_method": "pm_card_visa"}},
+	} {
+		r := e.DoWith("POST", payPath(c.invoice), e.Acme.Key, c.body, keyed("pay-2"))
+		if r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+			t.Fatalf("reuse with %v: %s", c.body, r)
+		}
+	}
+}
+
+func TestIdempotencyKeysBelongToAnOrganization(t *testing.T) {
+	e := apitest.New(t)
+	acme := invoiceFor(e, e.Acme, "Jane")
+	globex := invoiceFor(e, e.Globex, "Ann")
+	body := map[string]string{"payment_method": "pm_card_visa"}
+	e.MustDo(http.StatusOK, "POST", payPath(acme), e.Acme.Key, body, nil)
+	r := e.DoWith("POST", payPath(globex), e.Globex.Key, body, keyed("pay-3"))
+	if r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("another organization's key: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestIdempotencyKeyFormat(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(e, e.Acme, "Jane")
+	body := map[string]string{"payment_method": "pm_card_visa"}
+	for _, key := range []string{"", strings.Repeat("a", 256), "naïve", "tab\there", "del\x7f"} {
+		r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed(key))
+		if r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_idempotency_key" {
+			t.Fatalf("key %q: %s", key, r)
+		}
+	}
+	if n := len(e.Gateway.Charges()); n != 0 {
+		t.Fatalf("%d charges for refused keys", n)
+	}
+	r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed(strings.Repeat("a", 255)))
+	if r.Code != http.StatusOK {
+		t.Fatalf("255 characters: %s", r)
+	}
+}
+
+func TestDeclinedResponseIsKept(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(e, e.Acme, "Jane")
+	body := map[string]string{"payment_method": "pm_card_declined"}
+	first := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("pay-4"))
+	again := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("pay-4"))
+	if again.Code != http.StatusPaymentRequired || again.Header.Get("Idempotent-Replayed") != "true" || string(again.Body) != string(first.Body) {
+		t.Fatalf("retry: %s, first %s", again, first)
+	}
+	if n := len(e.Gateway.Calls()); n != 1 {
+		t.Fatalf("%d gateway calls", n)
+	}
+}
+
+func TestServerErrorIsNotKept(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(e, e.Acme, "Jane")
+	body := map[string]string{"payment_method": "pm_gateway_down"}
+	for i := 0; i < 2; i++ {
+		r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("pay-5"))
+		if r.Code != http.StatusServiceUnavailable || r.Map(t)["error"] != "gateway_unavailable" || r.Header.Get("Idempotent-Replayed") != "" {
+			t.Fatalf("attempt %d: %s", i+1, r)
+		}
+	}
+	if n := len(e.Gateway.Calls()); n != 2 {
+		t.Fatalf("%d gateway calls, want the retry to try again", n)
+	}
+	// Nothing was kept, so the key is free again: even another body is paid for, and the invoice is paid once.
+	r := e.DoWith("POST", payPath(inv), e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"}, keyed("pay-5"))
+	if r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("a different body with the key after a server error: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestIdempotencyKeyExpiresAfterADay(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(e, e.Acme, "Jane")
+	body := map[string]string{"payment_method": "pm_card_declined"}
+	e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("pay-6"))
+	e.Clock.Advance(24*time.Hour - time.Second)
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("pay-6")); r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("23h59m59s later: %s", r)
+	}
+	e.Clock.Advance(time.Second)
+	r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("pay-6"))
+	if r.Code != http.StatusPaymentRequired || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("a day later: %s", r)
+	}
+	if n := len(e.Gateway.Calls()); n != 2 {
+		t.Fatalf("%d gateway calls, want the key to count as new", n)
+	}
+}
+
+func TestPaymentInProgressRefusesOtherPayments(t *testing.T) {
+	e := apitest.New(t)
+	inv := invoiceFor(e, e.Acme, "Jane")
+	body := map[string]string{"payment_method": "pm_card_visa"}
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		once.Do(func() {
+			close(entered)
+			<-release
+		})
+	}
+	first := make(chan *apitest.Response)
+	go func() { first <- e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("slow")) }()
+	<-entered
+
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("slow")); r.Code != http.StatusConflict || r.Map(t)["error"] != "request_in_progress" {
+		t.Fatalf("same key while in progress: %s", r)
+	}
+	if r := e.Do("POST", payPath(inv), e.Acme.Key, body); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("no key while in progress: %s", r)
+	}
+	if r := e.DoWith("POST", payPath(inv), e.Acme.Key, body, keyed("other")); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("another key while in progress: %s", r)
+	}
+	close(release)
+	if r := <-first; r.Code != http.StatusOK {
+		t.Fatalf("first: %s", r)
+	}
+	if r := e.Do("POST", payPath(inv), e.Acme.Key, body); r.Code != http.StatusConflict || r.Map(t)["error"] != "already_paid" {
+		t.Fatalf("after the charge: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
