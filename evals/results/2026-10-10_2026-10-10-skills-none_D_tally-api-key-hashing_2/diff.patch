+package api_test
+
+import (
+	"net/http"
+	"regexp"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+)
+
+func TestAPIKeyTokenShownOnlyWhenCreated(t *testing.T) {
+	e := apitest.New(t)
+	tokenFormat := regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`)
+
+	var created map[string]any
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "ci"}, &created)
+	token, _ := created["token"].(string)
+	if !tokenFormat.MatchString(token) {
+		t.Fatalf("created key token = %q", token)
+	}
+	if created["last4"] != token[len(token)-4:] || created["name"] != "ci" {
+		t.Fatalf("created key = %v", created)
+	}
+	if _, ok := created["token_hash"]; ok {
+		t.Fatalf("created key shows its hash: %v", created)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", token, nil, nil)
+
+	r := e.Do("GET", "/v1/api-keys", e.Acme.Key, nil)
+	if r.Code != http.StatusOK {
+		t.Fatalf("list: %s", r)
+	}
+	body := string(r.Body)
+	if strings.Contains(body, token) || strings.Contains(body, e.Acme.Key) || strings.Contains(body, "token") {
+		t.Fatalf("list shows a token or a hash: %s", body)
+	}
+	if !strings.Contains(body, `"last4":"`+token[len(token)-4:]+`"`) {
+		t.Fatalf("list lacks the last four characters: %s", body)
+	}
+
+	id, _ := created["id"].(string)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+id, e.Acme.Key, nil, nil)
+	if r := e.Do("GET", "/v1/me", token, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a revoked key: %s", r)
+	}
+}
+
+func TestInvitedMemberGetsTokenOnce(t *testing.T) {
+	e := apitest.New(t)
+	var inv struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"}, &inv)
+	msgs := e.Mail.Messages()
+	if len(msgs) == 0 {
+		t.Fatal("no invite email")
+	}
+	m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[0].Body)
+	if m == nil {
+		t.Fatalf("no token in the invite email: %q", msgs[0].Body)
+	}
+	token := strings.TrimSpace(m[1])
+
+	var accepted struct {
+		APIKey map[string]any `json:"api_key"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "New Person"}, &accepted)
+	key, _ := accepted.APIKey["token"].(string)
+	if !regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`).MatchString(key) {
+		t.Fatalf("accepted key token = %q", key)
+	}
+	if _, ok := accepted.APIKey["token_hash"]; ok {
+		t.Fatalf("accepted key shows its hash: %v", accepted.APIKey)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", key, nil, nil)
+}
