+package store
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+)
+
+var tokenFormat = regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`)
+
+func TestNewAPIKeyToken(t *testing.T) {
+	seen := map[string]bool{}
+	for i := 0; i < 1000; i++ {
+		tok := newAPIKeyToken()
+		if !tokenFormat.MatchString(tok) {
+			t.Fatalf("token %q is not tly_ plus 40 characters from [A-Za-z0-9]", tok)
+		}
+		if seen[tok] {
+			t.Fatalf("token %q was generated twice", tok)
+		}
+		seen[tok] = true
+	}
+}
+
+func TestAPIKeyStoresOnlyHash(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleOwner, t0)
+	k, err := s.CreateAPIKey(o.ID, u.ID, "laptop", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256([]byte(k.Token))
+	if k.TokenHash != hex.EncodeToString(sum[:]) || k.Last4 != k.Token[len(k.Token)-4:] {
+		t.Fatalf("the returned key = %+v", k)
+	}
+
+	stored, ok := s.APIKey(o.ID, k.ID)
+	if !ok || stored.Token != "" || stored.TokenHash != k.TokenHash || stored.Last4 != k.Last4 {
+		t.Fatalf("the stored key = %+v", stored)
+	}
+	if got, ok := s.APIKeyByToken(k.Token); !ok || got.ID != k.ID {
+		t.Fatalf("APIKeyByToken = %+v %v", got, ok)
+	}
+	if _, ok := s.APIKeyByToken(k.TokenHash); ok {
+		t.Fatal("the stored hash works as a token")
+	}
+
+	b, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), k.Token) {
+		t.Fatal("the export holds the plain-text token")
+	}
+}
+
+func TestLegacyPlainTokenSnapshot(t *testing.T) {
+	const legacy = "tly_00000000000000000000000000000003"
+	s, err := FromState(State{APIKeys: []APIKey{{ID: "key_000001", OrgID: "org_000001", UserID: "usr_000001", Name: "old", Token: legacy, CreatedAt: t0}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s.APIKeyByToken(legacy); !ok || got.ID != "key_000001" {
+		t.Fatal("a key from a plain-text snapshot does not work")
+	}
+	st := s.Export()
+	if len(st.APIKeys) != 1 || st.APIKeys[0].Token != "" || st.APIKeys[0].Last4 != "0003" {
+		t.Fatalf("the exported key = %+v", st.APIKeys)
+	}
+	if want := hashAPIKeyToken(legacy); st.APIKeys[0].TokenHash != want {
+		t.Fatalf("the hash = %q, want %q", st.APIKeys[0].TokenHash, want)
+	}
+	b, _ := json.Marshal(st)
+	if strings.Contains(string(b), legacy) {
+		t.Fatal("the next snapshot holds the plain-text token")
+	}
+}
+
+func TestTouchAPIKeyOncePerMinute(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleOwner, t0)
+	k, _ := s.CreateAPIKey(o.ID, u.ID, "k", t0)
+	lastUsed := func() time.Time {
+		got, _ := s.APIKey(o.ID, k.ID)
+		if got.LastUsedAt == nil {
+			t.Fatal("last_used_at is not set")
+		}
+		return *got.LastUsedAt
+	}
+
+	s.TouchAPIKey(k.ID, t0)
+	if !lastUsed().Equal(t0) {
+		t.Fatalf("first use: last_used_at = %v", lastUsed())
+	}
+	s.TouchAPIKey(k.ID, t0.Add(59*time.Second))
+	if !lastUsed().Equal(t0) {
+		t.Fatalf("a use 59 seconds later changed last_used_at to %v", lastUsed())
+	}
+	s.TouchAPIKey(k.ID, t0.Add(60*time.Second))
+	if !lastUsed().Equal(t0.Add(60 * time.Second)) {
+		t.Fatalf("a use 60 seconds later: last_used_at = %v", lastUsed())
+	}
+}
