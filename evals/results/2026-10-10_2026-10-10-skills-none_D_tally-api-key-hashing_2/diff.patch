+const (
+	apiKeyPrefix   = "tly_"
+	apiKeyChars    = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+	apiKeyBodyLen  = 40
+	apiKeyLast4Len = 4
+)
+
+// newAPIKeyToken returns "tly_" followed by 40 random characters from [A-Za-z0-9].
+func newAPIKeyToken() string {
+	out := make([]byte, 0, apiKeyBodyLen)
+	buf := make([]byte, 64)
+	for len(out) < apiKeyBodyLen {
+		if _, err := rand.Read(buf); err != nil {
+			panic(err) // crypto/rand does not fail on supported platforms
+		}
+		for _, b := range buf {
+			// 248 is the largest multiple of 62 below 256: larger bytes are skipped so every character is equally likely.
+			if int(b) < 248 && len(out) < apiKeyBodyLen {
+				out = append(out, apiKeyChars[int(b)%len(apiKeyChars)])
+			}
+		}
+	}
+	return apiKeyPrefix + string(out)
+}
+
+// hashAPIKeyToken returns the hex SHA-256 of a token. Keys are stored and looked up by this hash, never by the token.
+func hashAPIKeyToken(token string) string {
+	sum := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(sum[:])
+}
+
+// lastFour returns the last four characters of a token.
+func lastFour(token string) string {
+	if len(token) < apiKeyLast4Len {
+		return token
+	}
+	return token[len(token)-apiKeyLast4Len:]
+}
