+// Verify checks a Tally-Signature header against the body it came with. It returns nil when the header's timestamp is
+// within tolerance of now (either way; zero means DefaultTolerance) and one of its v1 signatures is the signature of
+// payload under one of secrets. Empty secrets are ignored.
+func Verify(payload []byte, header string, secrets []string, tolerance time.Duration, now time.Time) error {
+	if strings.TrimSpace(header) == "" {
+		return fmt.Errorf("%w: the header is empty", ErrMalformedHeader)
+	}
+	var (
+		ts   int64
+		hasT bool
+		v1s  []string
+	)
+	for _, pair := range strings.Split(header, ",") {
+		key, value, ok := strings.Cut(pair, "=")
+		if !ok {
+			return fmt.Errorf("%w: %q is not key=value", ErrMalformedHeader, strings.TrimSpace(pair))
+		}
+		key, value = strings.TrimSpace(key), strings.TrimSpace(value)
+		switch key {
+		case "t":
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil {
+				return fmt.Errorf("%w: the timestamp %q is not an integer", ErrMalformedHeader, value)
+			}
+			if !hasT {
+				ts, hasT = n, true
+			}
+		case "v1":
+			v1s = append(v1s, value)
+		}
+	}
+	if !hasT {
+		return ErrNoTimestamp
+	}
+	if tolerance <= 0 {
+		tolerance = DefaultTolerance
+	}
+	sent := time.Unix(ts, 0)
+	if sent.Before(now.Add(-tolerance)) || sent.After(now.Add(tolerance)) {
+		return fmt.Errorf("%w: the timestamp is %d and now is %d", ErrTimestampTolerance, ts, now.Unix())
+	}
+	if len(v1s) == 0 {
+		return ErrNoSignature
+	}
+	for _, secret := range secrets {
+		if secret == "" {
+			continue
+		}
+		want := []byte(signAt(secret, ts, payload))
+		for _, got := range v1s {
+			if hmac.Equal([]byte(got), want) {
+				return nil
+			}
+		}
+	}
+	return ErrSignatureMismatch
+}
