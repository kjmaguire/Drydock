+func TestRotationSurvivesSnapshot(t *testing.T) {
+	e, ep := rotationEnv(t)
+	first := ep.Secret
+	e.MustDo(http.StatusOK, "POST", "/v1/webhook-endpoints/"+ep.ID+"/rotate-secret", e.Acme.Key, nil, nil)
+
+	raw, err := json.Marshal(e.Store.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var st store.State
+	if err := json.Unmarshal(raw, &st); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := store.FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, ok := restored.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if !ok || got.PreviousSecret != first || got.SecretRotatedAt == nil || !got.SecretRotatedAt.Equal(e.Clock.Now()) {
+		t.Fatalf("restored endpoint = %+v", got)
+	}
+}
