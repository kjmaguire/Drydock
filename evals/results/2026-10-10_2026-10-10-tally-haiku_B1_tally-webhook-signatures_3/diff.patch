+		t.Fatal(err)
+	}
+	e.Clock.Advance(7 * time.Minute) // the attempt is later than the event
+	if _, err := e.Webhooks.RunDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	reqs := e.HTTP.Requests()
+	want := fmt.Sprintf("t=%d,", e.Clock.Now().Unix())
+	if got := reqs[0].Header.Get("Tally-Signature"); !strings.HasPrefix(got, want) {
+		t.Fatalf("signature %q, want it to start with %q", got, want)
+	}
+}
+
+func TestSecretRotation(t *testing.T) {
+	e, ep := rotationEnv(t)
+	first := ep.Secret
+
+	// Before any rotation: one v1 entry, which the receiver checks with the endpoint's secret.
+	body, header := deliverOne(t, e)
+	if strings.Count(header, ",v1=") != 1 {
+		t.Fatalf("before rotation: %q", header)
+	}
+	if err := webhooks.Verify(body, header, []string{first}, 0, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+
+	// Rotate: the answer is the endpoint with a new secret, and it does not show the previous one.
+	var rotated store.WebhookEndpoint
+	r := e.MustDo(http.StatusOK, "POST", "/v1/webhook-endpoints/"+ep.ID+"/rotate-secret", e.Acme.Key, nil, &rotated)
+	second := rotated.Secret
+	if second == first || !strings.HasPrefix(second, "whsec_") || len(second) != len("whsec_")+32 {
+		t.Fatalf("rotated secret = %q", second)
+	}
+	if _, err := hex.DecodeString(strings.TrimPrefix(second, "whsec_")); err != nil {
+		t.Fatalf("rotated secret is not hex: %v", err)
+	}
+	if rotated.ID != ep.ID || rotated.URL != ep.URL || rotated.SecretRotatedAt == nil || rotated.PreviousSecret != "" {
+		t.Fatalf("rotated endpoint = %+v", rotated)
+	}
+	if _, ok := r.Map(t)["previous_secret"]; ok {
+		t.Fatalf("the API showed the previous secret: %s", r)
+	}
+	if got := e.Do("GET", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, nil); strings.Contains(got.String(), first) {
+		t.Fatalf("the API showed the previous secret: %s", got)
+	}
+
+	// For 24 hours both secrets sign, the new one first.
+	rotatedAt := e.Clock.Now()
+	e.Clock.Set(rotatedAt.Add(webhooks.SecretGracePeriod - time.Second))
+	body, header = deliverOne(t, e)
+	ts := e.Clock.Now().Unix()
+	want := fmt.Sprintf("t=%d,v1=%s,v1=%s", ts, sigOf(second, ts, body), sigOf(first, ts, body))
+	if header != want {
+		t.Fatalf("during the grace period:\n%s\nwant\n%s", header, want)
+	}
+	if err := webhooks.Verify(body, header, []string{second}, 0, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if err := webhooks.Verify(body, header, []string{first}, 0, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+
+	// After 24 hours only the new secret signs.
+	e.Clock.Set(rotatedAt.Add(webhooks.SecretGracePeriod))
+	body, header = deliverOne(t, e)
+	ts = e.Clock.Now().Unix()
+	if want := fmt.Sprintf("t=%d,v1=%s", ts, sigOf(second, ts, body)); header != want {
+		t.Fatalf("after the grace period: %s, want %s", header, want)
+	}
+	if err := webhooks.Verify(body, header, []string{first}, 0, e.Clock.Now()); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Fatalf("old secret after the grace period: %v", err)
+	}
+}
+
+func TestRotateTwiceWithinGracePeriod(t *testing.T) {
+	e, ep := rotationEnv(t)
+	first := ep.Secret
+	var r1, r2 store.WebhookEndpoint
+	e.MustDo(http.StatusOK, "POST", "/v1/webhook-endpoints/"+ep.ID+"/rotate-secret", e.Acme.Key, nil, &r1)
+	second := r1.Secret
+	e.Clock.Advance(time.Hour)
+	e.MustDo(http.StatusOK, "POST", "/v1/webhook-endpoints/"+ep.ID+"/rotate-secret", e.Acme.Key, nil, &r2)
+	third := r2.Secret
+
+	// The first secret is dropped at once: only the current and the one before it sign.
+	body, header := deliverOne(t, e)
+	ts := e.Clock.Now().Unix()
+	if want := fmt.Sprintf("t=%d,v1=%s,v1=%s", ts, sigOf(third, ts, body), sigOf(second, ts, body)); header != want {
+		t.Fatalf("header = %s, want %s", header, want)
+	}
+	if err := webhooks.Verify(body, header, []string{first}, 0, e.Clock.Now()); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Fatalf("the dropped secret still verifies: %v", err)
+	}
+
+	// The grace period runs from the latest rotation: a day after the first one, the second one's is still running.
+	e.Clock.Advance(webhooks.SecretGracePeriod - time.Hour)
+	if _, header := deliverOne(t, e); strings.Count(header, ",v1=") != 2 {
+		t.Fatalf("a day after the first rotation, the second one's grace period should still be running: %s", header)
+	}
+}
