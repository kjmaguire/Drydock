+// waitClosed waits until Shutdown has closed the runner to new work.
+func waitClosed(t *testing.T, r *Runner) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		r.mu.Lock()
+		closed := r.closed
+		r.mu.Unlock()
+		if closed {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("Shutdown did not close the runner")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func names(jobs []Job) []string {
+	var out []string
+	for _, j := range jobs {
+		out = append(out, j.Name)
+	}
+	return out
+}
+
+func TestEnqueueAfterShutdownReturnsErrStopped(t *testing.T) {
+	r := NewRunner(2, 10, nil)
+	r.Start()
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	err := r.Enqueue(Job{Name: "late", Run: func(context.Context) error { return nil }})
+	if !errors.Is(err, ErrStopped) {
+		t.Fatalf("err = %v, want ErrStopped", err)
+	}
+	if p := r.Pending(); len(p) != 0 {
+		t.Fatalf("pending = %v, want none", names(p))
+	}
+}
+
+func TestPendingBeforeShutdownListsQueuedJobs(t *testing.T) {
+	r := NewRunner(1, 10, nil) // not started: every job stays queued
+	for _, name := range []string{"a", "b", "c"} {
+		if err := r.Enqueue(Job{Name: name, Run: func(context.Context) error { return nil }}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := names(r.Pending()); len(got) != 3 || got[0] != "a" || got[1] != "b" || got[2] != "c" {
+		t.Fatalf("pending = %v, want [a b c]", got)
