-// Stop stops the runner.
-func (r *Runner) Stop() {
+// Shutdown stops the runner: Enqueue refuses new jobs and jobs that have not started are not started.
+// It waits for running jobs to finish. If ctx ends first, it cancels the context of every running job,
+// waits for them to return and returns ctx.Err(). Otherwise it returns nil. Once it returns, none of the
+// runner's goroutines is left.
+//
+// Calls after the first do not wait. Each returns at once: nil if the first call has finished, and ErrStopped
+// if it has not.
+func (r *Runner) Shutdown(ctx context.Context) error {
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		select {
+		case <-r.done:
+			return nil
+		default:
+			return ErrStopped
+		}
+	}
+	r.closed = true
 	close(r.queue)
+	r.mu.Unlock()
+
+	// Start does not add a worker after closed is set, so every Add happens before this Wait.
+	workersDone := make(chan struct{})
+	go func() {
+		r.wg.Wait()
+		close(workersDone)
+	}()
+	var err error
+	select {
+	case <-workersDone:
+	case <-ctx.Done():
+		// ctx ended first: cancel the running jobs and wait for every worker to return.
+		err = ctx.Err()
+		r.cancel()
+		<-workersDone
+	}
+	r.cancel()
+	close(r.done)
+	return err
+}
+
+// Stop shuts the runner down, waiting up to 30 seconds for running jobs. See Shutdown.
+func (r *Runner) Stop() {
+	ctx, cancel := context.WithTimeout(context.Background(), stopTimeout)
+	defer cancel()
+	_ = r.Shutdown(ctx)
+}
+
+// Pending returns the jobs that still need to run, in enqueue order. Before Shutdown these are the queued
+// jobs that have not started. After Shutdown they are the jobs that were never started, followed by the
+// jobs that Shutdown cancelled and that returned an error. A panicked job is not returned.
+func (r *Runner) Pending() []Job {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	waiting := make([]entry, 0, len(r.waiting))
+	for _, e := range r.waiting {
+		waiting = append(waiting, e)
+	}
+	sortEntries(waiting)
+	canceled := append([]entry(nil), r.canceled...)
+	sortEntries(canceled)
+
+	jobs := make([]Job, 0, len(waiting)+len(canceled))
+	for _, e := range append(waiting, canceled...) {
+		jobs = append(jobs, e.job)
+	}
+	return jobs
+}
+
+func sortEntries(es []entry) {
+	sort.Slice(es, func(i, j int) bool { return es[i].seq < es[j].seq })
 }
