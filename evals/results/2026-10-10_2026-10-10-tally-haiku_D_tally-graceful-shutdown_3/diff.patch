+func TestShutdownLeavesNoGoroutines(t *testing.T) {
+	before := runtime.NumGoroutine()
+	r := NewRunner(4, 20, nil)
+	r.Start()
+	var wg sync.WaitGroup
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		if err := r.Enqueue(Job{Name: "job", Run: func(context.Context) error {
+			defer wg.Done()
+			return nil
+		}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	wg.Wait()
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	// A goroutine can still be finishing its last statement when Shutdown returns, so poll briefly.
+	deadline := time.Now().Add(5 * time.Second)
+	for runtime.NumGoroutine() > before {
+		if time.Now().After(deadline) {
+			t.Fatalf("goroutines = %d, want at most %d", runtime.NumGoroutine(), before)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
