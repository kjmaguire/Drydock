+func TestSecondShutdownReturnsAtOnce(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started := make(chan struct{})
+	release := make(chan struct{})
+	// "stuck" ignores cancellation until release is closed.
+	if err := r.Enqueue(Job{Name: "stuck", Run: func(context.Context) error {
+		close(started)
+		<-release
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	<-started
+
+	firstErr := make(chan error, 1)
+	go func() { firstErr <- r.Shutdown(context.Background()) }()
+	waitClosed(t, r)
+
+	// While the first call is still waiting, a second call returns at once with ErrStopped.
+	secondErr := make(chan error, 1)
+	go func() { secondErr <- r.Shutdown(context.Background()) }()
+	select {
+	case err := <-secondErr:
+		if !errors.Is(err, ErrStopped) {
+			t.Fatalf("second Shutdown = %v, want ErrStopped", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("second Shutdown did not return while the first is still running")
+	}
+
+	// The first call is still waiting for the stuck job; it returns once the job does.
+	select {
+	case err := <-firstErr:
+		t.Fatalf("first Shutdown returned early: %v", err)
+	default:
+	}
+	close(release)
+	if err := <-firstErr; err != nil {
+		t.Fatalf("first Shutdown = %v, want nil", err)
+	}
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatalf("Shutdown after the first finished = %v, want nil", err)
+	}
+}
