+func TestShutdownCancelsRunningJobsWhenCtxEnds(t *testing.T) {
+	r := NewRunner(2, 10, nil)
+	r.Start()
+	started := make(chan struct{}, 2)
+	// "stubborn" returns an error when cancelled, "polite" returns nil.
+	if err := r.Enqueue(Job{Name: "stubborn", Run: func(ctx context.Context) error {
+		started <- struct{}{}
+		<-ctx.Done()
+		return ctx.Err()
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Enqueue(Job{Name: "polite", Run: func(ctx context.Context) error {
+		started <- struct{}{}
+		<-ctx.Done()
+		return nil
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	<-started
+	<-started
+	if err := r.Enqueue(Job{Name: "later", Run: func(context.Context) error { return nil }}); err != nil {
+		t.Fatal(err)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if err := r.Shutdown(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Shutdown = %v, want DeadlineExceeded", err)
+	}
+	// Never started first, then the cancelled job that returned an error.
+	if got := names(r.Pending()); len(got) != 2 || got[0] != "later" || got[1] != "stubborn" {
+		t.Fatalf("pending = %v, want [later stubborn]", got)
+	}
+}
