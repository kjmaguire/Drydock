diff --git a/result/internal/api/ratelimit.go b/result/internal/api/ratelimit.go
new file mode 100644
index 0000000..a704c6b
--- /dev/null
+++ b/result/internal/api/ratelimit.go
@@ -0,0 +1,57 @@
+package api
+
+import (
+	"sync"
+	"time"
+
+	"example.com/saasapi/internal/store"
+)
+
+// rateWindow is the span over which an API key's requests are counted.
+const rateWindow = 60 * time.Second
+
+// rateLimit is how many requests a key may make in rateWindow. It follows the plan of the key's account.
+func rateLimit(p store.Plan) int {
+	if p == store.PlanPro {
+		return 600
+	}
+	return 60
+}
+
+// rateLimiter keeps, for each API key, the times of the requests it allowed. It is safe for concurrent use.
+type rateLimiter struct {
+	mu   sync.Mutex
+	logs map[string][]time.Time // API key -> allowed request times, oldest first
+}
+
+func newRateLimiter() *rateLimiter {
+	return &rateLimiter{logs: map[string][]time.Time{}}
+}
+
+// allow counts a request by key at time now if fewer than limit requests were allowed in (now-rateWindow, now].
+// Otherwise it refuses the request and returns how long until the oldest counted request leaves the window.
+// Times are expected not to go backwards for a key, as the log is kept oldest first.
+func (l *rateLimiter) allow(key string, limit int, now time.Time) (bool, time.Duration) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	cutoff := now.Add(-rateWindow)
+	log := l.logs[key]
+	for len(log) > 0 && !log[0].After(cutoff) {
+		log = log[1:]
+	}
+	if len(log) >= limit {
+		l.logs[key] = log
+		return false, log[0].Add(rateWindow).Sub(now)
+	}
+	l.logs[key] = append(log, now)
+	return true, 0
+}
+
+// retryAfterSeconds rounds d up to whole seconds, with a minimum of 1, for the Retry-After header.
+func retryAfterSeconds(d time.Duration) int {
+	s := int((d + time.Second - 1) / time.Second)
+	if s < 1 {
+		s = 1
+	}
+	return s
+}
diff --git a/result/internal/api/ratelimit_test.go b/result/internal/api/ratelimit_test.go
