index 0000000..c6d04f0
--- /dev/null
+++ b/result/internal/api/ratelimit_test.go
@@ -0,0 +1,213 @@
+package api_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/saasapi/internal/api"
+	"example.com/saasapi/internal/store"
+)
+
+// clock is a server clock that tests move by hand. It is safe for concurrent use.
+type clock struct {
+	mu sync.Mutex
+	t  time.Time
+}
+
+func (c *clock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.t
+}
+
+func (c *clock) Advance(d time.Duration) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.t = c.t.Add(d)
+}
+
+func newLimitedServer(t *testing.T) (*api.Server, *clock) {
+	t.Helper()
+	st := store.New()
+	st.AddAccount(store.Account{ID: "acc_acme", Name: "Acme", Plan: store.PlanFree})
+	st.AddAccount(store.Account{ID: "acc_globex", Name: "Globex", Plan: store.PlanPro})
+	st.AddKey("key-acme", "acc_acme")
+	st.AddKey("key-acme-2", "acc_acme")
+	st.AddKey("key-globex", "acc_globex")
+	clk := &clock{t: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)}
+	return api.New(st, api.Options{Now: clk.Now}), clk
+}
+
+// requests makes n requests with key and returns how many were answered 200.
+func requests(t *testing.T, srv *api.Server, key string, n int) int {
+	t.Helper()
+	ok := 0
+	for i := 0; i < n; i++ {
+		if do(t, srv, "GET", "/api/customers", key, "").Code == http.StatusOK {
+			ok++
+		}
+	}
+	return ok
+}
+
+func TestAFreeKeyGetsSixtyRequestsAndThenIsRateLimited(t *testing.T) {
+	srv, _ := newLimitedServer(t)
+	if got := requests(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("allowed %d of 60", got)
+	}
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if r.Code != http.StatusTooManyRequests {
+		t.Fatalf("61st request: %d", r.Code)
+	}
+	if r.Body.String() != `{"error":"rate_limited"}`+"\n" {
+		t.Fatalf("body %s", r.Body)
+	}
+	if got := r.Header().Get("Retry-After"); got != "60" {
+		t.Fatalf("Retry-After %q, want 60", got)
+	}
+}
+
+func TestAProKeyGetsSixHundredRequests(t *testing.T) {
+	srv, _ := newLimitedServer(t)
+	if got := requests(t, srv, "key-globex", 600); got != 600 {
+		t.Fatalf("allowed %d of 600", got)
+	}
+	if r := do(t, srv, "GET", "/api/customers", "key-globex", ""); r.Code != http.StatusTooManyRequests {
+		t.Fatalf("601st request: %d", r.Code)
+	}
+}
+
+func TestEachKeyHasItsOwnLimitEvenWithinAnAccount(t *testing.T) {
+	srv, _ := newLimitedServer(t)
+	if got := requests(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("key-acme allowed %d of 60", got)
+	}
+	if got := requests(t, srv, "key-acme-2", 60); got != 60 {
+		t.Fatalf("key-acme-2 allowed %d of 60", got)
+	}
+}
+
+func TestTheWindowSlides(t *testing.T) {
+	srv, clk := newLimitedServer(t)
+	if got := requests(t, srv, "key-acme", 1); got != 1 {
+		t.Fatal("first request refused")
+	}
+	clk.Advance(30 * time.Second)
+	if got := requests(t, srv, "key-acme", 59); got != 59 {
+		t.Fatalf("allowed %d of 59", got)
+	}
+	// The first request is still in the window at +30s, so the key is at its limit.
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if r.Code != http.StatusTooManyRequests || r.Header().Get("Retry-After") != "30" {
+		t.Fatalf("at +30s: %d Retry-After %q", r.Code, r.Header().Get("Retry-After"))
+	}
+	// At +60s the first request is 60s old, out of (t-60s, t], so one more request fits.
+	clk.Advance(30 * time.Second)
+	if got := requests(t, srv, "key-acme", 1); got != 1 {
+		t.Fatal("request at +60s refused")
+	}
+	if r := do(t, srv, "GET", "/api/customers", "key-acme", ""); r.Code != http.StatusTooManyRequests {
+		t.Fatalf("second request at +60s: %d", r.Code)
+	}
+}
+
+func TestRejectedRequestsDoNotCount(t *testing.T) {
+	srv, clk := newLimitedServer(t)
+	if got := requests(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("allowed %d of 60", got)
+	}
+	clk.Advance(time.Second)
+	if got := requests(t, srv, "key-acme", 10); got != 0 {
+		t.Fatalf("allowed %d while at the limit", got)
+	}
+	// Had the 10 refused requests counted, they would still be in the window at +60s.
+	clk.Advance(59 * time.Second)
+	if got := requests(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("at +60s allowed %d of 60", got)
+	}
+}
+
+func TestRetryAfterRoundsUpAndIsAtLeastOne(t *testing.T) {
+	srv, clk := newLimitedServer(t)
+	requests(t, srv, "key-acme", 60)
+	clk.Advance(59*time.Second + 400*time.Millisecond)
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if got := r.Header().Get("Retry-After"); got != "1" {
+		t.Fatalf("600ms left: Retry-After %q, want 1", got)
+	}
+	clk.Advance(600 * time.Millisecond)
+	r = do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("at +60s: %d, want the oldest request to have left", r.Code)
+	}
+}
+
+func TestRetryAfterCountsDownToTheOldestRequest(t *testing.T) {
+	srv, clk := newLimitedServer(t)
+	requests(t, srv, "key-acme", 1)
+	clk.Advance(20 * time.Second)
+	requests(t, srv, "key-acme", 59)
+	clk.Advance(15 * time.Second)
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if got, _ := strconv.Atoi(r.Header().Get("Retry-After")); got != 25 {
+		t.Fatalf("Retry-After %q, want 25 (oldest request is 35s old)", r.Header().Get("Retry-After"))
+	}
+}
+
+func TestUnauthorizedRequestsAreNotCounted(t *testing.T) {
+	srv, _ := newLimitedServer(t)
+	for i := 0; i < 100; i++ {
+		do(t, srv, "GET", "/api/customers", "nope", "")
+	}
+	if got := requests(t, srv, "key-acme", 60); got != 60 {
+		t.Fatalf("allowed %d of 60 after unauthorized requests", got)
+	}
+}
+
+func TestHealthzIsNotLimited(t *testing.T) {
+	srv, _ := newLimitedServer(t)
+	requests(t, srv, "key-acme", 60)
+	for i := 0; i < 100; i++ {
+		if r := do(t, srv, "GET", "/healthz", "", ""); r.Code != http.StatusOK {
+			t.Fatalf("healthz %d: %d", i, r.Code)
+		}
+	}
+}
+
+func TestConcurrentRequestsShareOneLimit(t *testing.T) {
+	srv, _ := newLimitedServer(t)
+	var (
+		wg      sync.WaitGroup
+		mu      sync.Mutex
+		allowed int
+	)
+	for i := 0; i < 200; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if got := requests(t, srv, "key-acme", 1); got == 1 {
+				mu.Lock()
+				allowed++
+				mu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+	if allowed != 60 {
+		t.Fatalf("allowed %d of 200 concurrent requests, want 60", allowed)
+	}
+}
+
+func TestRateLimitedBodyIsJSON(t *testing.T) {
+	srv, _ := newLimitedServer(t)
+	requests(t, srv, "key-acme", 60)
+	var body map[string]string
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if err := json.Unmarshal(r.Body.Bytes(), &body); err != nil || body["error"] != "rate_limited" {
+		t.Fatalf("body %s %v", r.Body, err)
+	}
+}
