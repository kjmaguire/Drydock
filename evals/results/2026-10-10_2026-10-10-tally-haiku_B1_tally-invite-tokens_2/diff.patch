+func TestInviteTokenIsHashedAndNotStored(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv, token, err := s.IssueInvite(o.ID, " New@People.example ", RoleMember, "usr_000001", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(token)
+	if err != nil || len(raw) != 32 || len(token) != 43 {
+		t.Fatalf("token %q is not 32 random bytes in unpadded base64url", token)
+	}
+	if inv.TokenHash != HashToken(token) || inv.TokenHash == token {
+		t.Fatalf("invite stores %q, want only the hash of the token", inv.TokenHash)
+	}
+	if !inv.ExpiresAt.Equal(t0.Add(InviteTTL)) {
+		t.Fatalf("expires at %v, want seven days after creation", inv.ExpiresAt)
+	}
+	_, other, err := s.IssueInvite(o.ID, "other@people.example", RoleMember, "usr_000001", t0)
+	if err != nil || other == token {
+		t.Fatalf("two invites got the same token (%v)", err)
+	}
+	for name, v := range map[string]any{"invite": inv, "invites": s.Invites(o.ID), "export": s.Export()} {
+		b, err := json.Marshal(v)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(string(b), token) {
+			t.Fatalf("%s contains the token", name)
+		}
+	}
+	if _, _, _, err := s.AcceptInvite(token, "New Person", t0); err != nil {
+		t.Fatalf("accepting with the token: %v", err)
+	}
+}
