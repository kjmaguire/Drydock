+func TestReinviteRevokesOpenInvite(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	_, old, _ := s.IssueInvite(o.ID, "Ann@People.example", RoleMember, "", t0)
+	_, bob, _ := s.IssueInvite(o.ID, "bob@people.example", RoleMember, "", t0)
+	later := t0.Add(time.Hour)
+	_, fresh, err := s.IssueInvite(o.ID, "ann@PEOPLE.example", RoleViewer, "", later)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := s.AcceptInvite(old, "Ann", later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("the replaced token = %v, want ErrNotFound", err)
+	}
+	if _, _, _, err := s.AcceptInvite(bob, "Bob", later); err != nil {
+		t.Fatalf("another address's invite: %v", err)
+	}
+	if _, _, _, err := s.AcceptInvite(fresh, "Ann", later); err != nil {
+		t.Fatalf("the newest token: %v", err)
+	}
+}
