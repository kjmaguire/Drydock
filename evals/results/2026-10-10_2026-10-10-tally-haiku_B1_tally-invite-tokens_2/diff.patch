+func TestAcceptInviteRules(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	for _, tok := range []string{"", "invite_nope"} {
+		if _, _, _, err := s.AcceptInvite(tok, "X", t0); !errors.Is(err, ErrNotFound) {
+			t.Errorf("AcceptInvite(%q) = %v, want ErrNotFound", tok, err)
+		}
+	}
+
+	// Exactly seven days after creation is still in time; a moment later it is too late.
+	_, onTime, _ := s.IssueInvite(o.ID, "b@people.example", RoleMember, "", t0)
+	if _, _, _, err := s.AcceptInvite(onTime, "B", t0.Add(InviteTTL)); err != nil {
+		t.Fatalf("accepting at seven days: %v", err)
+	}
+	if _, _, _, err := s.AcceptInvite(onTime, "B", t0); !errors.Is(err, ErrInviteUsed) {
+		t.Fatalf("accepting twice = %v, want ErrInviteUsed", err)
+	}
+
+	_, late, _ := s.IssueInvite(o.ID, "c@people.example", RoleMember, "", t0)
+	if _, _, _, err := s.AcceptInvite(late, "C", t0.Add(InviteTTL+time.Second)); !errors.Is(err, ErrInviteExpired) {
+		t.Fatalf("accepting after seven days = %v, want ErrInviteExpired", err)
+	}
+	if _, _, _, err := s.AcceptInvite(late, "C", t0.Add(2*InviteTTL)); !errors.Is(err, ErrInviteExpired) {
+		t.Fatalf("an expired invite works again: %v", err)
+	}
+
+	inv, revoked, _ := s.IssueInvite(o.ID, "d@people.example", RoleMember, "", t0)
+	if _, err := s.RevokeInvite(o.ID, inv.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := s.AcceptInvite(revoked, "D", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("a revoked invite = %v, want ErrNotFound", err)
+	}
