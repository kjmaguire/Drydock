+
+	created := e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "New@People.example", "role": "member"}, nil)
+	token := inviteToken(t, e)
+	if len(token) != 43 {
+		t.Fatalf("token %q is %d characters, want 43", token, len(token))
+	}
+	if strings.Contains(string(created.Body), token) {
+		t.Fatalf("the create answer contains the token: %s", created.Body)
+	}
+	var inv map[string]any
+	created.JSON(t, &inv)
+	if _, ok := inv["token"]; ok {
+		t.Fatalf("the invite has a token field: %v", inv)
+	}
+	if _, ok := inv["expires_at"]; !ok {
+		t.Fatalf("the invite has no expires_at: %v", inv)
+	}
+
+	// Neither the owner nor a viewer can read the token back from the list.
+	for _, key := range []string{e.Acme.Key, viewerKey} {
+		r := e.MustDo(http.StatusOK, "GET", "/v1/invites", key, nil, nil)
+		if strings.Contains(string(r.Body), token) || strings.Contains(string(r.Body), "token") {
+			t.Fatalf("the list contains a token: %s", r.Body)
+		}
+	}
+
+	// Inviting the same address again (ignoring case) replaces the invite: only the newest token works.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@PEOPLE.example", "role": "viewer"}, nil)
+	fresh := inviteToken(t, e)
+	var pending struct {
+		Items []struct{ Email, Role string }
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &pending)
+	if len(pending.Items) != 1 || pending.Items[0].Role != "viewer" {
+		t.Fatalf("pending after the second invite = %+v", pending.Items)
+	}
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "New"}); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("the replaced token: %s", r)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": fresh, "name": "New Person"}, nil)
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": fresh, "name": "New Person"}); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_used" {
+		t.Fatalf("accepting twice: %s", r)
+	}
+
+	// An invite is good for seven days after it was created.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "late@people.example", "role": "member"}, nil)
+	late := inviteToken(t, e)
+	e.Clock.Advance(7 * 24 * time.Hour)
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": late, "name": "Late"}); r.Code != http.StatusCreated {
+		t.Fatalf("accepting at seven days: %s", r)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "later@people.example", "role": "member"}, nil)
+	stale := inviteToken(t, e)
+	e.Clock.Advance(7*24*time.Hour + time.Second)
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &pending)
+	for _, it := range pending.Items {
+		if it.Email == "later@people.example" {
+			t.Fatalf("an expired invite is listed as pending: %+v", pending.Items)
+		}
+	}
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": stale, "name": "Later"}); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_expired" {
+		t.Fatalf("an expired invite: %s", r)
+	}
+
+	// A revoked invite's token is not found.
+	var revoked store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "gone@people.example", "role": "member"}, &revoked)
+	gone := inviteToken(t, e)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+revoked.ID, e.Acme.Key, nil, nil)
+	if r := e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": gone, "name": "Gone"}); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("a revoked invite: %s", r)
+	}
+}
