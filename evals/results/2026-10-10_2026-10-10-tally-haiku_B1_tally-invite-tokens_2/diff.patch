+func TestPendingInvites(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	_, acceptedToken, _ := s.IssueInvite(o.ID, "a@people.example", RoleMember, "", t0)
+	revoked, _, _ := s.IssueInvite(o.ID, "b@people.example", RoleMember, "", t0)
+	_, _, _ = s.IssueInvite(o.ID, "c@people.example", RoleMember, "", t0) // expires before now
+	_, _, _ = s.IssueInvite(o.ID, "d@people.example", RoleMember, "", t0.Add(InviteTTL))
+	now := t0.Add(InviteTTL + time.Hour)
+	if _, _, _, err := s.AcceptInvite(acceptedToken, "A", t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RevokeInvite(o.ID, revoked.ID, now); err != nil {
+		t.Fatal(err)
+	}
+	pending := s.PendingInvites(o.ID, now)
+	if len(pending) != 1 || pending[0].Email != "d@people.example" {
+		t.Fatalf("pending = %+v, want only the fresh invite", pending)
+	}
+}
