+// CanGrant reports whether a caller of role caller may give a member the role target, or take it away from a member who
+// has it. Only owners may do so for the owner and admin roles.
+func CanGrant(caller, target store.Role) bool {
+	return caller == store.RoleOwner || (target != store.RoleOwner && target != store.RoleAdmin)
+}
