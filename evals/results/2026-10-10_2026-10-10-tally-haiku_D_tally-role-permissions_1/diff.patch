+func TestRefusedRequestDoesNotTouchKey(t *testing.T) {
+	e := apitest.New(t)
+	_, viewer := e.AddMember(e.Acme, "lastused@acme.example", store.RoleViewer)
+	if r := e.Do("POST", "/v1/customers", viewer, map[string]string{"name": "X", "email": "x@example.com"}); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer write: %s", r)
+	}
+	if k, _ := e.Store.APIKeyByToken(viewer); k.LastUsedAt != nil {
+		t.Fatalf("a refused request recorded the key's last use at %v", k.LastUsedAt)
+	}
+	if r := e.Do("GET", "/v1/customers", viewer, nil); r.Code != http.StatusOK {
+		t.Fatalf("viewer read: %s", r)
+	}
+	if k, _ := e.Store.APIKeyByToken(viewer); k.LastUsedAt == nil {
+		t.Fatal("an allowed request did not record the key's last use")
+	}
+
+	_, member := e.AddMember(e.Acme, "refused@acme.example", store.RoleMember)
+	if r := e.Do("POST", "/v1/invites", member, map[string]string{"email": "new@acme.example", "role": "viewer"}); r.Code != http.StatusForbidden {
+		t.Fatalf("member invite: %s", r)
+	}
+	if k, _ := e.Store.APIKeyByToken(member); k.LastUsedAt != nil {
+		t.Fatalf("a request refused by the handler recorded the key's last use at %v", k.LastUsedAt)
+	}
+}
