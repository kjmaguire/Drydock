+++ b/result/internal/api/roles_test.go
@@ -0,0 +1,239 @@
+package api_test
+
+import (
+	"net/http"
+	"slices"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// roleMember is a member of Acme and their API key. A key acts with its member's current role, so a member's role may
+// change while their key stays the same.
+type roleMember struct {
+	user store.User
+	key  string
+}
+
+var allRoles = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer}
+
+// addRoles gives Acme a member of each role, and returns them with the owner.
+func addRoles(e *apitest.Env) map[store.Role]roleMember {
+	members := map[store.Role]roleMember{store.RoleOwner: {e.Acme.Owner, e.Acme.Key}}
+	for _, role := range allRoles[1:] {
+		u, key := e.AddMember(e.Acme, string(role)+"@acme.example", role)
+		members[role] = roleMember{u, key}
+	}
+	return members
+}
+
+func TestRoleMatrix(t *testing.T) {
+	e := apitest.New(t)
+	members := addRoles(e)
+	owners := []store.Role{store.RoleOwner, store.RoleAdmin}
+	billers := []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling}
+	writers := []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember}
+	cases := []struct {
+		name, method, path string
+		body               any
+		may                []store.Role
+	}{
+		{"read customers", "GET", "/v1/customers", nil, allRoles},
+		{"export customers", "GET", "/v1/customers/export.csv", nil, allRoles},
+		{"read customer", "GET", "/v1/customers/x", nil, allRoles},
+		{"read plans", "GET", "/v1/plans", nil, allRoles},
+		{"read subscriptions", "GET", "/v1/subscriptions", nil, allRoles},
+		{"read invoices", "GET", "/v1/invoices", nil, allRoles},
+		{"read payments", "GET", "/v1/payments", nil, allRoles},
+		{"read org", "GET", "/v1/org", nil, allRoles},
+		{"read members", "GET", "/v1/members", nil, allRoles},
+		{"read invites", "GET", "/v1/invites", nil, allRoles},
+
+		{"create customer", "POST", "/v1/customers", map[string]string{"name": "X", "email": "x@acme.example"}, writers},
+		{"update customer", "PATCH", "/v1/customers/x", map[string]string{"name": "Y"}, writers},
+		{"delete customer", "DELETE", "/v1/customers/x", nil, writers},
+
+		{"create plan", "POST", "/v1/plans", map[string]any{"name": "P", "currency": "USD", "price": "1", "interval": "month"}, billers},
+		{"update plan", "PATCH", "/v1/plans/x", map[string]string{"name": "Q"}, billers},
+
+		{"create subscription", "POST", "/v1/subscriptions", map[string]string{"customer_id": "x", "plan_id": "x"}, writers},
+		{"update subscription", "PATCH", "/v1/subscriptions/x", map[string]string{"plan_id": "x"}, writers},
+		{"cancel subscription", "POST", "/v1/subscriptions/x/cancel", nil, writers},
+		{"report usage", "POST", "/v1/subscriptions/x/usage", map[string]int{"quantity": 1}, writers},
+
+		{"create invoice", "POST", "/v1/invoices", map[string]string{"subscription_id": "x"}, billers},
+		{"pay invoice", "POST", "/v1/invoices/x/pay", nil, billers},
+		{"void invoice", "POST", "/v1/invoices/x/void", nil, billers},
+		{"revenue report", "GET", "/v1/reports/revenue", nil, billers},
+
+		{"list endpoints", "GET", "/v1/webhook-endpoints", nil, owners},
+		{"create endpoint", "POST", "/v1/webhook-endpoints", map[string]string{"url": "https://hooks.acme.example/a"}, owners},
+		{"read endpoint", "GET", "/v1/webhook-endpoints/x", nil, owners},
+		{"update endpoint", "PATCH", "/v1/webhook-endpoints/x", map[string]string{"url": "https://hooks.acme.example/b"}, owners},
+		{"delete endpoint", "DELETE", "/v1/webhook-endpoints/x", nil, owners},
+		{"list deliveries", "GET", "/v1/webhook-endpoints/x/deliveries", nil, owners},
+		{"list events", "GET", "/v1/events", nil, owners},
+		{"read event", "GET", "/v1/events/x", nil, owners},
+
+		{"update org", "PATCH", "/v1/org", map[string]string{"name": "Acme 2"}, owners},
+		{"invite member", "POST", "/v1/invites", map[string]string{"email": "invitee@acme.example", "role": "member"}, owners},
+		{"revoke invite", "DELETE", "/v1/invites/x", nil, owners},
+		{"change member role", "PATCH", "/v1/members/x", map[string]string{"role": "member"}, owners},
+		{"remove member", "DELETE", "/v1/members/x", nil, owners},
+
+		{"create own API key", "POST", "/v1/api-keys", map[string]string{"name": "k"}, allRoles},
+	}
+	for _, c := range cases {
+		for _, role := range allRoles {
+			r := e.Do(c.method, c.path, members[role].key, c.body)
+			if slices.Contains(c.may, role) {
+				if r.Code == http.StatusUnauthorized || r.Code == http.StatusForbidden || r.Code >= http.StatusInternalServerError {
+					t.Errorf("%s as %s: want the endpoint to run, got %s", c.name, role, r)
+				}
+				continue
+			}
+			if r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+				t.Errorf("%s as %s: want 403 forbidden, got %s", c.name, role, r)
+			}
+		}
+	}
+}
+
+func TestRoleChangeAppliesToExistingKeys(t *testing.T) {
+	e := apitest.New(t)
+	members := addRoles(e)
+	m := members[store.RoleMember]
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", m.key, map[string]string{"name": "X", "email": "x@acme.example"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+m.user.ID, e.Acme.Key, map[string]string{"role": "viewer"}, nil)
+	if r := e.Do("POST", "/v1/customers", m.key, map[string]string{"name": "Y", "email": "y@acme.example"}); r.Code != http.StatusForbidden {
+		t.Fatalf("demoted member's existing key: %s", r)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+m.user.ID, e.Acme.Key, map[string]string{"role": "member"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", m.key, map[string]string{"name": "Y", "email": "y@acme.example"}, nil)
+}
+
+func TestRefusedWritesChangeNothing(t *testing.T) {
+	e := apitest.New(t)
+	members := addRoles(e)
+	var before, after struct{ Items []store.Customer }
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", e.Acme.Key, nil, &before)
+	if r := e.Do("POST", "/v1/customers", members[store.RoleViewer].key, map[string]string{"name": "X", "email": "x@acme.example"}); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer creates a customer: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", e.Acme.Key, nil, &after)
+	if len(after.Items) != len(before.Items) {
+		t.Fatalf("a refused request created a customer: %d before, %d after", len(before.Items), len(after.Items))
+	}
+	var plans, plansAfter struct{ Items []store.Plan }
+	e.MustDo(http.StatusOK, "GET", "/v1/plans", e.Acme.Key, nil, &plans)
+	if r := e.Do("POST", "/v1/plans", members[store.RoleMember].key, map[string]any{"name": "P", "currency": "USD", "price": "1", "interval": "month"}); r.Code != http.StatusForbidden {
+		t.Fatalf("member creates a plan: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/plans", e.Acme.Key, nil, &plansAfter)
+	if len(plansAfter.Items) != len(plans.Items) {
+		t.Fatalf("a refused request created a plan")
+	}
+}
+
+func TestAnyoneMayLeave(t *testing.T) {
+	e := apitest.New(t)
+	members := addRoles(e)
+	viewer := members[store.RoleViewer]
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+viewer.user.ID, viewer.key, nil, nil)
+	if r := e.Do("GET", "/v1/org", viewer.key, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a member who left still has access: %s", r)
+	}
+}
+
+func TestMemberRoleRules(t *testing.T) {
+	e := apitest.New(t)
+	members := addRoles(e)
+	owner, admin, billing, mem := members[store.RoleOwner], members[store.RoleAdmin], members[store.RoleBilling], members[store.RoleMember]
+	forbidden := func(what string, r *apitest.Response) {
+		t.Helper()
+		if r.Code != http.StatusForbidden {
+			t.Fatalf("%s: want 403, got %s", what, r)
+		}
+	}
+
+	// Only owners and admins manage members.
+	forbidden("billing changes a member", e.Do("PATCH", "/v1/members/"+mem.user.ID, billing.key, map[string]string{"role": "viewer"}))
+	forbidden("member removes a member", e.Do("DELETE", "/v1/members/"+billing.user.ID, mem.key, nil))
+
+	// Only owners give or take away the owner and admin roles.
+	forbidden("admin makes a member an admin", e.Do("PATCH", "/v1/members/"+mem.user.ID, admin.key, map[string]string{"role": "admin"}))
+	forbidden("admin demotes the owner", e.Do("PATCH", "/v1/members/"+owner.user.ID, admin.key, map[string]string{"role": "billing"}))
+	forbidden("admin removes the owner", e.Do("DELETE", "/v1/members/"+owner.user.ID, admin.key, nil))
+	forbidden("admin invites an admin", e.Do("POST", "/v1/invites", admin.key, map[string]string{"email": "a@acme.example", "role": "admin"}))
+	forbidden("admin invites an owner", e.Do("POST", "/v1/invites", admin.key, map[string]string{"email": "o@acme.example", "role": "owner"}))
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", admin.key, map[string]string{"email": "i@acme.example", "role": "member"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+mem.user.ID, admin.key, map[string]string{"role": "billing"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+billing.user.ID, admin.key, nil, nil)
+
+	// Nobody changes their own role. An owner may step down while another owner remains.
+	forbidden("admin changes own role", e.Do("PATCH", "/v1/members/"+admin.user.ID, admin.key, map[string]string{"role": "member"}))
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+admin.user.ID, owner.key, map[string]string{"role": "owner"}, nil)
+	forbidden("owner changes own role to the same role", e.Do("PATCH", "/v1/members/"+owner.user.ID, owner.key, map[string]string{"role": "owner"}))
+	forbidden("owner steps down while another owner remains", e.Do("PATCH", "/v1/members/"+admin.user.ID, admin.key, map[string]string{"role": "admin"}))
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+owner.user.ID, admin.key, map[string]string{"role": "admin"}, nil)
+
+	// An organization always keeps at least one owner: the sole owner cannot step down or leave either.
+	if r := e.Do("PATCH", "/v1/members/"+admin.user.ID, admin.key, map[string]string{"role": "member"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the sole owner steps down: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/members/"+admin.user.ID, admin.key, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the sole owner leaves: %s", r)
+	}
+}
+
+func TestAPIKeyRules(t *testing.T) {
+	e := apitest.New(t)
+	members := addRoles(e)
+	viewer, member, admin, billing := members[store.RoleViewer], members[store.RoleMember], members[store.RoleAdmin], members[store.RoleBilling]
+
+	// Every member may create keys for themselves.
+	var own store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", viewer.key, map[string]string{"name": "mine"}, &own)
+	if own.UserID != viewer.user.ID {
+		t.Fatalf("viewer's new key = %+v", own)
+	}
+
+	// Owners and admins list every key; everyone else lists only their own.
+	var all, mine struct{ Items []store.APIKey }
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, &all)
+	if len(all.Items) != 6 {
+		t.Fatalf("owner lists %d keys, want 6", len(all.Items))
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", viewer.key, nil, &mine)
+	if len(mine.Items) != 2 {
+		t.Fatalf("viewer lists %d keys, want 2", len(mine.Items))
+	}
+	for _, k := range mine.Items {
+		if k.UserID != viewer.user.ID {
+			t.Fatalf("viewer sees another member's key: %+v", k)
+		}
+	}
+
+	// Anyone may revoke their own keys. Others' keys are for owners and admins.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+own.ID, viewer.key, nil, nil)
+	adminKey, _ := e.Store.APIKeyByToken(admin.key)
+	memberKey, _ := e.Store.APIKeyByToken(member.key)
+	ownerKey, _ := e.Store.APIKeyByToken(e.Acme.Key)
+	if r := e.Do("DELETE", "/v1/api-keys/"+adminKey.ID, member.key, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("member revokes an admin's key: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/api-keys/"+ownerKey.ID, billing.key, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("billing revokes the owner's key: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/api-keys/key_missing", member.key, nil); r.Code != http.StatusForbidden {
+		t.Fatalf("member revokes an unknown key: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/api-keys/key_missing", admin.key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("admin revokes an unknown key: %s", r)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+memberKey.ID, admin.key, nil, nil)
+	if r := e.Do("GET", "/v1/org", member.key, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("revoked key still works: %s", r)
+	}
+}
