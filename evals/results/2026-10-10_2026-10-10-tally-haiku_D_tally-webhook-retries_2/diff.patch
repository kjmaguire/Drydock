+func TestFailingEndpointEmailsOwnersOncePerDay(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	_, _ = e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	_, _ = e.AddMember(e.Acme, "owner2@acme.example", store.RoleOwner)
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusInternalServerError, nil }
+	ep := failingEndpoint(e, e.Acme, "https://hooks.acme.example/down")
+
+	// The first event fails for good first and emails the owners. The second, created 10 hours later, fails for good 10
+	// hours after that: no second email.
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "invoice.paid", map[string]string{"invoice_id": "in_8"})
+	e.Clock.Advance(10 * time.Hour)
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "invoice.paid", map[string]string{"invoice_id": "in_9"})
+	runUntilSettled(t, e, ep)
+
+	msgs := e.Mail.Messages()
+	if len(msgs) != 2 {
+		t.Fatalf("emails = %+v, want one to each owner", msgs)
+	}
+	to := map[string]bool{}
+	for _, m := range msgs {
+		to[m.To] = true
+		if m.Subject != "Webhook endpoint failing: https://hooks.acme.example/down" {
+			t.Fatalf("subject = %q", m.Subject)
+		}
+	}
+	if !to["owner@acme.example"] || !to["owner2@acme.example"] || to["admin@acme.example"] {
+		t.Fatalf("recipients = %v", to)
+	}
+
+	// A failure more than a day after the email is emailed again.
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "invoice.paid", map[string]string{"invoice_id": "in_10"})
+	runUntilSettled(t, e, ep)
+	if got := len(e.Mail.Messages()); got != 4 {
+		t.Fatalf("emails = %d, want 4", got)
 	}
 }
