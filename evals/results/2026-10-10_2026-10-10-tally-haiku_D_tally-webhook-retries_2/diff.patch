+func TestRetrySchedule(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusBadGateway, nil }
+	ep := failingEndpoint(e, e.Acme, "https://hooks.acme.example/retry")
+	start := e.Clock.Now()
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "invoice.paid", map[string]string{"invoice_id": "in_1"}); err != nil {
+		t.Fatal(err)
+	}
+
+	// The waits after the 1st to 6th failed attempts; the 7th failure ends the delivery.
+	waits := []time.Duration{time.Minute, 5 * time.Minute, 30 * time.Minute, 2 * time.Hour, 8 * time.Hour, 24 * time.Hour}
+	at := start
+	for i := 1; i <= 7; i++ {
+		e.Clock.Set(at)
+		if n, _ := e.Webhooks.RunDue(ctx); n != 1 {
+			t.Fatalf("attempt %d: RunDue = %d", i, n)
+		}
+		d := e.Store.Deliveries(ep.OrgID, ep.ID)[0]
+		if d.Attempts != i || d.LastAttemptAt == nil || !d.LastAttemptAt.Equal(at) || d.ResponseStatus != http.StatusBadGateway {
+			t.Fatalf("after attempt %d: %+v", i, d)
+		}
+		if i == 7 {
+			if d.Status != store.DeliveryFailed || d.NextAttemptAt != nil {
+				t.Fatalf("after the last attempt: %+v", d)
+			}
+			break
+		}
+		if d.Status != store.DeliveryPending || d.NextAttemptAt == nil || !d.NextAttemptAt.Equal(at.Add(waits[i-1])) {
+			t.Fatalf("after attempt %d: %+v, want the next one at %v", i, d, at.Add(waits[i-1]))
+		}
+		e.Clock.Set(d.NextAttemptAt.Add(-time.Second))
+		if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+			t.Fatalf("attempt %d was retried a second early", i+1)
+		}
