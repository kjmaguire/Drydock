+func TestAttemptHasTenSecondTimeout(t *testing.T) {
+	e := apitest.New(t)
+	var deadline time.Time
+	svc := webhooks.New(webhooks.Options{Store: e.Store, Clock: e.Clock, Doer: doerFunc(func(r *http.Request) (*http.Response, error) {
+		deadline, _ = r.Context().Deadline()
+		return nil, context.DeadlineExceeded
+	})})
+	ep := failingEndpoint(e, e.Acme, "https://hooks.acme.example/slow")
+	_ = svc.Publish(context.Background(), e.Acme.ID, "invoice.paid", map[string]string{"invoice_id": "in_5"})
+	if n, _ := svc.RunDue(context.Background()); n != 1 {
+		t.Fatalf("RunDue = %d", n)
+	}
+	if left := time.Until(deadline); left <= 9*time.Second || left > 10*time.Second {
+		t.Fatalf("the request's deadline is %v away, want 10 seconds", left)
+	}
+	if d := e.Store.Deliveries(e.Acme.ID, ep.ID)[0]; d.Status != store.DeliveryPending || d.Error == "" {
+		t.Fatalf("timed out: %+v", d)
+	}
+}
+
+// doerFunc adapts a function to webhooks.Doer.
+type doerFunc func(*http.Request) (*http.Response, error)
+
+func (f doerFunc) Do(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestGoneDisablesEndpoint(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep := failingEndpoint(e, e.Acme, "https://hooks.acme.example/gone")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusGone, nil }
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "invoice.paid", map[string]string{"invoice_id": "in_6"})
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "invoice.paid", map[string]string{"invoice_id": "in_7"})
+	if n, _ := e.Webhooks.RunDue(ctx); n != 1 {
+		t.Fatalf("RunDue = %d, want 1 (the second delivery is not sent)", n)
+	}
+	ds := e.Store.Deliveries(e.Acme.ID, ep.ID)
+	if ds[0].Status != store.DeliveryFailed || ds[0].Attempts != 1 || ds[0].ResponseStatus != http.StatusGone || ds[0].NextAttemptAt != nil {
+		t.Fatalf("410: %+v", ds[0])
+	}
+	if ds[1].Status != store.DeliveryFailed || ds[1].Attempts != 0 || ds[1].NextAttemptAt != nil {
+		t.Fatalf("the other delivery: %+v", ds[1])
+	}
+	got, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if got.Enabled || got.DisabledReason != "gone" {
+		t.Fatalf("endpoint = %+v", got)
+	}
+	if len(e.HTTP.Requests()) != 1 {
+		t.Fatalf("requests = %d", len(e.HTTP.Requests()))
+	}
+	if len(e.Mail.Messages()) != 0 {
+		t.Fatalf("a 410 emailed the owners: %+v", e.Mail.Messages())
+	}
+}
