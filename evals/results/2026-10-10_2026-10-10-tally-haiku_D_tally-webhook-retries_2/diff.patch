+func TestRedirectIsNotFollowed(t *testing.T) {
+	followed := false
+	target := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) { followed = true }))
+	defer target.Close()
+	redirect := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, target.URL, http.StatusMovedPermanently)
+	}))
+	defer redirect.Close()
+
+	e := apitest.New(t)
+	svc := webhooks.New(webhooks.Options{Store: e.Store, Clock: e.Clock})
+	ep := failingEndpoint(e, e.Acme, redirect.URL)
+	_ = e.Webhooks.Publish(context.Background(), e.Acme.ID, "invoice.paid", map[string]string{"invoice_id": "in_4"})
+	if n, _ := svc.RunDue(context.Background()); n != 1 {
+		t.Fatalf("RunDue = %d", n)
+	}
+	if followed {
+		t.Fatal("the redirect was followed")
+	}
+	d := e.Store.Deliveries(e.Acme.ID, ep.ID)[0]
+	if d.Status != store.DeliveryPending || d.ResponseStatus != http.StatusMovedPermanently || d.Error == "" {
+		t.Fatalf("delivery = %+v", d)
+	}
+}
