+// runUntilSettled runs the due deliveries, moving the clock to each next attempt, until nothing is pending. It returns the
+// number of attempts made.
+func runUntilSettled(t *testing.T, e *apitest.Env, eps ...store.WebhookEndpoint) int {
+	t.Helper()
+	total := 0
+	for i := 0; i < 100; i++ {
+		var next *time.Time
+		for _, ep := range eps {
+			for _, d := range e.Store.Deliveries(ep.OrgID, ep.ID) {
+				if d.Status == store.DeliveryPending && d.NextAttemptAt != nil && (next == nil || d.NextAttemptAt.Before(*next)) {
+					next = d.NextAttemptAt
+				}
+			}
+		}
+		if next == nil {
+			return total
+		}
+		if next.After(e.Clock.Now()) {
+			e.Clock.Set(*next)
+		}
+		n, err := e.Webhooks.RunDue(context.Background())
+		if err != nil {
+			t.Fatal(err)
+		}
+		total += n
+	}
+	t.Fatal("deliveries never settled")
+	return total
+}
