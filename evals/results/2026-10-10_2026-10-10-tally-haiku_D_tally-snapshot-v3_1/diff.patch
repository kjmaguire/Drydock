+// takeInvoiceNumber returns the next invoice number of an organization and moves its counter past it. The caller holds
+// s.mu, and calls it only once the invoice is valid, so a refused invoice uses no number.
+func (s *Store) takeInvoiceNumber(orgID string) string {
+	n := max(s.invoiceNext[orgID], 1)
+	s.invoiceNext[orgID] = n + 1
+	return InvoiceNumber(n)
+}
+
+// InvoiceNumber formats the n-th invoice number of an organization, for example "INV-000001".
+func InvoiceNumber(n int) string { return fmt.Sprintf("INV-%06d", n) }
+
+// parseInvoiceNumber returns n for a number written as InvoiceNumber(n) writes it.
+func parseInvoiceNumber(s string) (int, bool) {
+	digits, ok := strings.CutPrefix(s, "INV-")
+	n, err := strconv.Atoi(digits)
+	if !ok || err != nil || n < 1 || InvoiceNumber(n) != s {
+		return 0, false
+	}
+	return n, true
+}
