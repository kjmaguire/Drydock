+func numberInvoices(st *store.State) {
+	invs := make([]*store.Invoice, 0, len(st.Invoices))
+	for i := range st.Invoices {
+		invs = append(invs, &st.Invoices[i])
+	}
+	sort.Slice(invs, func(i, j int) bool {
+		if !invs[i].CreatedAt.Equal(invs[j].CreatedAt) {
+			return invs[i].CreatedAt.Before(invs[j].CreatedAt)
+		}
+		return invs[i].ID < invs[j].ID
+	})
+	next := map[string]int{}
+	for _, inv := range invs {
+		n := max(next[inv.OrgID], 1)
+		inv.Number = store.InvoiceNumber(n)
+		next[inv.OrgID] = n + 1
+	}
+	st.NextInvoiceNumbers = next
