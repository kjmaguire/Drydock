+func TestInvoiceNumbers(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Ann", "ann@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Ben", "ben@example.com", t0)
+	create := func(st *Store, orgID, customerID string, currency money.Currency) (Invoice, error) {
+		return st.CreateInvoice(Invoice{OrgID: orgID, CustomerID: customerID, Currency: currency, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+	}
+	for _, c := range []struct{ org, cus, want string }{
+		{a.ID, ca.ID, "INV-000001"},
+		{b.ID, cb.ID, "INV-000001"},
+		{a.ID, ca.ID, "INV-000002"},
+	} {
+		inv, err := create(s, c.org, c.cus, money.EUR)
+		if err != nil || inv.Number != c.want {
+			t.Fatalf("invoice number = %q, want %q: %v", inv.Number, c.want, err)
+		}
+	}
+	if _, err := create(s, a.ID, ca.ID, money.Currency("XXX")); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("a refused invoice: %v", err)
+	}
+	inv, err := create(s, a.ID, ca.ID, money.EUR)
+	if err != nil || inv.Number != "INV-000003" {
+		t.Fatalf("after a refused invoice the number is %q: %v", inv.Number, err)
+	}
+
+	first := s.ListInvoices(a.ID, InvoiceFilter{})[0]
+	paid, err := s.UpdateInvoice(a.ID, first.ID, func(inv *Invoice) error {
+		inv.Status = InvoicePaid
+		inv.Number = "INV-999999"
+		return nil
+	})
+	if err != nil || paid.Status != InvoicePaid || paid.Number != "INV-000001" {
+		t.Fatalf("updated invoice = %+v: %v", paid, err)
+	}
+
+	st := s.Export()
+	if st.NextInvoiceNumbers[a.ID] != 4 || st.NextInvoiceNumbers[b.ID] != 2 {
+		t.Fatalf("next invoice numbers = %v", st.NextInvoiceNumbers)
+	}
+	s2, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if inv, err := create(s2, a.ID, ca.ID, money.EUR); err != nil || inv.Number != "INV-000004" {
+		t.Fatalf("after FromState the number is %q: %v", inv.Number, err)
+	}
+
+	st.Invoices[0].Number = ""
+	if _, err := FromState(st); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("an invoice without a number: %v", err)
+	}
+}
