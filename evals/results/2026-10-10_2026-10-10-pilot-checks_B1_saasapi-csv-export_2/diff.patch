+// exportCustomers answers the account's customers as a CSV file for download.
+func (s *Server) exportCustomers(w http.ResponseWriter, r *http.Request, acct store.Account) {
+	w.Header().Set("Content-Type", "text/csv; charset=utf-8")
+	w.Header().Set("Content-Disposition", `attachment; filename="customers.csv"`)
+	w.WriteHeader(http.StatusOK)
+	_ = writeCustomersCSV(w, s.store.Customers(acct.ID))
+}
+
+// writeCustomersCSV writes a header row and one RFC 4180 row per customer, with CRLF line endings.
+func writeCustomersCSV(w io.Writer, customers []store.Customer) error {
+	if _, err := io.WriteString(w, "id,name,email,plan,created_at\r\n"); err != nil {
+		return err
+	}
+	for _, c := range customers {
+		row := []string{
+			csvField(c.ID),
+			csvField(neutralizeFormula(c.Name)),
+			csvField(neutralizeFormula(c.Email)),
+			csvField(string(c.Plan)),
+			csvField(c.CreatedAt.UTC().Format(time.RFC3339)),
+		}
+		if _, err := io.WriteString(w, strings.Join(row, ",")+"\r\n"); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// csvField quotes a field that contains a comma, a double quote or a line break, doubling its quotes.
+func csvField(s string) string {
+	if !strings.ContainsAny(s, ",\"\r\n") {
+		return s
+	}
+	return `"` + strings.ReplaceAll(s, `"`, `""`) + `"`
+}
+
+// neutralizeFormula puts a single quote in front of a value that a spreadsheet would read as a formula.
+func neutralizeFormula(s string) string {
+	if s != "" && strings.ContainsRune("=+-@", rune(s[0])) {
+		return "'" + s
+	}
+	return s
+}
