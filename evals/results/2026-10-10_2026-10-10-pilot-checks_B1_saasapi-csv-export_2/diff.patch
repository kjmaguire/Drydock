+func TestCustomersCSVIsTheCallersCustomersSortedByID(t *testing.T) {
+	srv, st := newServer(t)
+	// 05:06:07 at UTC+2 is 03:06:07 UTC.
+	when := time.Date(2026, 3, 4, 5, 6, 7, 0, time.FixedZone("UTC+2", 2*3600))
+	first, _ := st.CreateCustomer("acc_acme", "Jane Doe", "jane@example.com", store.PlanPro, when)
+	st.CreateCustomer("acc_globex", "Hank", "hank@globex.test", store.PlanFree, when)
+	second, _ := st.CreateCustomer("acc_acme", "Ann, Lee", "ann@example.com", store.PlanFree, when.Add(time.Hour))
+
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("export: %d %s", r.Code, r.Body)
+	}
+	if ct := r.Header().Get("Content-Type"); ct != "text/csv; charset=utf-8" {
+		t.Fatalf("Content-Type %q", ct)
+	}
+	if cd := r.Header().Get("Content-Disposition"); cd != `attachment; filename="customers.csv"` {
+		t.Fatalf("Content-Disposition %q", cd)
+	}
+	want := "id,name,email,plan,created_at\r\n" +
+		first.ID + ",Jane Doe,jane@example.com,pro,2026-03-04T03:06:07Z\r\n" +
+		second.ID + `,"Ann, Lee",ann@example.com,free,2026-03-04T04:06:07Z` + "\r\n"
+	if got := r.Body.String(); got != want {
+		t.Fatalf("body:\n%q\nwant:\n%q", got, want)
+	}
+}
