+func TestCustomersCSVQuotesFieldsAndNeutralizesFormulas(t *testing.T) {
+	srv, st := newServer(t)
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	names := []struct{ name, email string }{
+		{`=HYPERLINK("http://x","click")`, "=x@evil.test"},
+		{"+1 555", "+15@example.com"},
+		{"@SUM(A1)", "-ann@example.com"},
+		{"Quote \"Q\"\nNew line", "a=b@example.com"},
+		{"Plain, not formula", "plain@example.com"},
+	}
+	var ids []string
+	for _, n := range names {
+		c, err := st.CreateCustomer("acc_acme", n.name, n.email, store.PlanFree, now)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, c.ID)
+	}
+
+	r := do(t, srv, "GET", "/api/customers.csv", "key-acme", "")
+	if r.Code != http.StatusOK {
+		t.Fatalf("export: %d", r.Code)
+	}
+	// encoding/csv rejects malformed quoting, so a parse that succeeds is valid RFC 4180.
+	records, err := csv.NewReader(strings.NewReader(r.Body.String())).ReadAll()
+	if err != nil {
+		t.Fatalf("not valid CSV: %v\n%s", err, r.Body)
+	}
+	ts := "2026-01-02T03:04:05Z"
+	want := [][]string{
+		{"id", "name", "email", "plan", "created_at"},
+		{ids[0], `'=HYPERLINK("http://x","click")`, "'=x@evil.test", "free", ts},
+		{ids[1], "'+1 555", "'+15@example.com", "free", ts},
+		{ids[2], "'@SUM(A1)", "'-ann@example.com", "free", ts},
+		{ids[3], "Quote \"Q\"\nNew line", "a=b@example.com", "free", ts},
+		{ids[4], "Plain, not formula", "plain@example.com", "free", ts},
+	}
+	if !reflect.DeepEqual(records, want) {
+		t.Fatalf("records:\n%q\nwant:\n%q", records, want)
+	}
+}
