+package api_test
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+func TestCoupons(t *testing.T) {
+	e := apitest.New(t)
+
+	var pct store.Coupon
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "SPRING25", "percent_off": 25, "duration": "forever"}, &pct)
+	if pct.ID == "" || pct.Code != "SPRING25" || pct.PercentOff != 25 || pct.Duration != store.DurationForever || pct.TimesRedeemed != 0 {
+		t.Fatalf("percent coupon = %+v", pct)
+	}
+	var amt store.Coupon
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "FIVEEUR", "amount_off": "5.00", "currency": "EUR", "duration": "once"}, &amt)
+	if amt.AmountOff != 500 || amt.Currency != money.EUR || amt.PercentOff != 0 {
+		t.Fatalf("amount coupon = %+v", amt)
+	}
+	var rep store.Coupon
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "SIX_MONTHS", "percent_off": 10, "duration": "repeating",
+		"duration_in_months": 6, "max_redemptions": 3, "redeem_by": "2027-01-01T00:00:00Z"}, &rep)
+	if rep.DurationInMonths != 6 || rep.MaxRedemptions != 3 || rep.RedeemBy == nil {
+		t.Fatalf("repeating coupon = %+v", rep)
+	}
+
+	invalid := []map[string]any{
+		{"code": "AB", "percent_off": 5, "duration": "forever"},
+		{"code": "BOTH", "percent_off": 5, "amount_off": "5.00", "currency": "USD", "duration": "forever"},
+		{"code": "NEITHER", "duration": "forever"},
+		{"code": "PCT_ZERO", "percent_off": 0, "duration": "forever"},
+		{"code": "PCT_OVER", "percent_off": 101, "duration": "forever"},
+		{"code": "AMT_BAD", "amount_off": "5,00", "currency": "USD", "duration": "forever"},
+		{"code": "AMT_NOCUR", "amount_off": "5.00", "duration": "forever"},
+		{"code": "PCT_CUR", "percent_off": 5, "currency": "USD", "duration": "forever"},
+		{"code": "REP_NOMO", "percent_off": 5, "duration": "repeating"},
+		{"code": "ONCE_MO", "percent_off": 5, "duration": "once", "duration_in_months": 2},
+		{"code": "MO_37", "percent_off": 5, "duration": "repeating", "duration_in_months": 37},
+		{"code": "MAX_ZERO", "percent_off": 5, "duration": "forever", "max_redemptions": 0},
+		{"code": "REDEEM_BY", "percent_off": 5, "duration": "forever", "redeem_by": "tomorrow"},
+		{"code": "DURATION", "percent_off": 5, "duration": "sometimes"},
+	}
+	for _, body := range invalid {
+		if r := e.Do("POST", "/v1/coupons", e.Acme.Key, body); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid" {
+			t.Errorf("%v: %s", body, r)
+		}
+	}
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "spring25", "percent_off": 10, "duration": "forever"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "code_taken" {
+		t.Fatalf("code taken, other case: %s", r)
+	}
+	if r := e.Do("POST", "/v1/coupons", e.Globex.Key, map[string]any{"code": "spring25", "percent_off": 10, "duration": "forever"}); r.Code != http.StatusCreated {
+		t.Fatalf("another organization's coupon with the same code: %s", r)
+	}
+
+	var list struct{ Items []store.Coupon }
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons", e.Acme.Key, nil, &list)
+	if len(list.Items) != 3 || list.Items[0].Code != "SPRING25" || list.Items[2].Code != "SIX_MONTHS" {
+		t.Fatalf("list = %+v", list.Items)
+	}
+	var got store.Coupon
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/fivEEUR", e.Acme.Key, nil, &got)
+	if got.Code != "FIVEEUR" {
+		t.Fatalf("get = %+v", got)
+	}
+	if r := e.Do("GET", "/v1/coupons/NOPE", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("no such coupon: %s", r)
+	}
+	if r := e.Do("GET", "/v1/coupons/SPRING25", e.Globex.Key, nil); r.Code != http.StatusOK {
+		t.Fatalf("Globex's coupon: %s", r)
+	}
+	if r := e.Do("GET", "/v1/coupons/FIVEEUR", e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("another organization's coupon: %s", r)
+	}
+
+	customer := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	usd := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	newSub := func() store.Subscription {
+		var sub store.Subscription
+		e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": customer.ID, "plan_id": usd.ID, "quantity": 1}, &sub)
+		return sub
+	}
+	applyTo := func(sub store.Subscription, code string) *apitest.Response {
+		return e.Do("POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": code})
+	}
+
+	sub := newSub()
+	var applied store.Subscription
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "spring25"}, &applied)
+	if applied.Coupon != "SPRING25" || applied.CouponRedeemedAt == nil {
+		t.Fatalf("applied = %+v", applied)
+	}
+	if r := applyTo(sub, "SPRING25"); r.Code != http.StatusConflict || r.Map(t)["error"] != "coupon_already_applied" {
+		t.Fatalf("second coupon: %s", r)
+	}
+	if r := applyTo(newSub(), "NOPE"); r.Code != http.StatusNotFound {
+		t.Fatalf("no such coupon: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions/sub_nope/coupon", e.Acme.Key, map[string]string{"code": "SPRING25"}); r.Code != http.StatusNotFound {
+		t.Fatalf("no such subscription: %s", r)
+	}
+	if r := applyTo(newSub(), "FIVEEUR"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "currency_mismatch" {
+		t.Fatalf("currency: %s", r)
+	}
+	if r := applyTo(newSub(), "SIX_MONTHS"); r.Code != http.StatusOK {
+		t.Fatalf("SIX_MONTHS has room for three: %s", r)
+	}
+	if r := applyTo(newSub(), "SIX_MONTHS"); r.Code != http.StatusOK {
+		t.Fatalf("SIX_MONTHS, second: %s", r)
+	}
+	if r := applyTo(newSub(), "SIX_MONTHS"); r.Code != http.StatusOK {
+		t.Fatalf("SIX_MONTHS, third: %s", r)
+	}
+	if r := applyTo(newSub(), "SIX_MONTHS"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_exhausted" {
+		t.Fatalf("SIX_MONTHS, fourth: %s", r)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "OLD_DEAL", "percent_off": 5, "duration": "forever", "redeem_by": "2026-01-01T00:00:00Z"}, nil)
+	if r := applyTo(newSub(), "OLD_DEAL"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_expired" {
+		t.Fatalf("expired: %s", r)
+	}
+	canceled := newSub()
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+canceled.ID+"/cancel", e.Acme.Key, nil, &canceled)
+	if r := applyTo(canceled, "SPRING25"); r.Code != http.StatusConflict || r.Map(t)["error"] != "subscription_canceled" {
+		t.Fatalf("canceled: %s", r)
+	}
+
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/SPRING25", e.Acme.Key, nil, &got)
+	if got.TimesRedeemed != 1 {
+		t.Fatalf("times redeemed = %d, want 1", got.TimesRedeemed)
+	}
+}
+
+func TestCouponDiscountsRenewalInvoices(t *testing.T) {
+	e := apitest.New(t)
+	customer := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	plan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": customer.ID, "plan_id": plan.ID, "quantity": 1, "discount_percent": 10}, &sub)
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "QUARTER", "percent_off": 25, "duration": "once"}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "QUARTER"}, nil)
+
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	type invoice struct {
+		store.Invoice
+		Discount int64
+		Total    int64
+	}
+	var invs struct{ Items []invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 2 {
+		t.Fatalf("invoices = %+v", invs.Items)
+	}
+	if first := invs.Items[0]; first.Coupon != "" || first.Discount != 200 || first.Total != 1800 {
+		t.Fatalf("first invoice = %+v", first)
+	}
+	if renewal := invs.Items[1]; renewal.Coupon != "QUARTER" || renewal.Discount != 500 || renewal.Total != 1500 {
+		t.Fatalf("renewal = %+v", renewal)
+	}
+}
