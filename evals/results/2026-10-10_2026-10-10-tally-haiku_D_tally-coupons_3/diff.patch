diff --git a/result/internal/api/coupons.go b/result/internal/api/coupons.go
new file mode 100644
index 0000000..d30aa41
--- /dev/null
+++ b/result/internal/api/coupons.go
@@ -0,0 +1,139 @@
+package api
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+// couponRequest is the body of POST /v1/coupons. Exactly one of PercentOff and AmountOff is set. AmountOff is in major
+// units, as a string ("5.00"), in Currency.
+type couponRequest struct {
+	Code             string               `json:"code"`
+	PercentOff       *int                 `json:"percent_off"`
+	AmountOff        *string              `json:"amount_off"`
+	Currency         money.Currency       `json:"currency"`
+	Duration         store.CouponDuration `json:"duration"`
+	DurationInMonths *int                 `json:"duration_in_months"`
+	MaxRedemptions   *int                 `json:"max_redemptions"`
+	RedeemBy         *string              `json:"redeem_by"`
+}
+
+// couponInput reads a coupon request into a coupon. Anything it cannot read is store.ErrInvalid.
+func couponInput(in couponRequest) (store.Coupon, error) {
+	bad := func(msg string) error { return fmt.Errorf("%w: %s", store.ErrInvalid, msg) }
+	c := store.Coupon{Code: in.Code, Currency: in.Currency, Duration: in.Duration}
+	switch {
+	case in.PercentOff != nil && in.AmountOff != nil, in.PercentOff == nil && in.AmountOff == nil:
+		return c, bad("a coupon takes percent_off or amount_off, exactly one")
+	case in.PercentOff != nil:
+		if in.Currency != "" {
+			return c, bad("only an amount_off coupon has a currency")
+		}
+		c.PercentOff = *in.PercentOff
+	default:
+		amount, err := money.ParseMajor(*in.AmountOff, in.Currency)
+		if err != nil {
+			return c, bad("amount_off is an amount such as \"5.00\", in the coupon's currency")
+		}
+		c.AmountOff = amount
+	}
+	switch {
+	case in.Duration == store.DurationRepeating && in.DurationInMonths == nil:
+		return c, bad("a repeating coupon needs duration_in_months")
+	case in.Duration != store.DurationRepeating && in.DurationInMonths != nil:
+		return c, bad("only a repeating coupon has duration_in_months")
+	case in.DurationInMonths != nil:
+		c.DurationInMonths = *in.DurationInMonths
+	}
+	if in.MaxRedemptions != nil {
+		if *in.MaxRedemptions < 1 {
+			return c, bad("max_redemptions is at least 1")
+		}
+		c.MaxRedemptions = *in.MaxRedemptions
+	}
+	if in.RedeemBy != nil {
+		t, err := time.Parse(time.RFC3339, *in.RedeemBy)
+		if err != nil {
+			return c, bad("redeem_by is an RFC 3339 time")
+		}
+		t = t.UTC()
+		c.RedeemBy = &t
+	}
+	return c, nil
+}
+
+func (s *Server) listCoupons(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	writeJSON(w, http.StatusOK, list{Items: s.store.Coupons(p.OrgID)})
+}
+
+// createCoupon creates a coupon: see couponRequest.
+func (s *Server) createCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in couponRequest
+	if !decode(w, r, &in) {
+		return
+	}
+	c, err := couponInput(in)
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	created, err := s.store.CreateCoupon(p.OrgID, c, s.clock.Now())
+	if errors.Is(err, store.ErrCodeTaken) {
+		writeError(w, http.StatusConflict, "code_taken", err.Error())
+		return
+	}
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusCreated, created)
+}
+
+func (s *Server) getCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	c, ok := s.store.Coupon(p.OrgID, r.PathValue("code"))
+	if !ok {
+		writeError(w, http.StatusNotFound, "not_found", "no such coupon")
+		return
+	}
+	writeJSON(w, http.StatusOK, c)
+}
+
+// applyCoupon applies a coupon to a subscription: {"code": "..."}. The time of applying is the redemption time.
+func (s *Server) applyCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in struct {
+		Code string `json:"code"`
+	}
+	if !decode(w, r, &in) {
+		return
+	}
+	sub, err := s.store.ApplyCoupon(p.OrgID, r.PathValue("id"), in.Code, s.clock.Now())
+	if err != nil {
+		s.couponError(w, err)
+		return
+	}
+	s.publish(r.Context(), p.OrgID, "subscription.updated", sub)
+	writeJSON(w, http.StatusOK, sub)
+}
+
+func (s *Server) couponError(w http.ResponseWriter, err error) {
+	switch {
+	case errors.Is(err, store.ErrCouponExpired):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_expired", err.Error())
+	case errors.Is(err, store.ErrCouponExhausted):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_exhausted", err.Error())
+	case errors.Is(err, store.ErrCurrencyMismatch):
+		writeError(w, http.StatusUnprocessableEntity, "currency_mismatch", err.Error())
+	case errors.Is(err, store.ErrCouponApplied):
+		writeError(w, http.StatusConflict, "coupon_already_applied", err.Error())
+	case errors.Is(err, store.ErrSubscriptionCanceled):
+		writeError(w, http.StatusConflict, "subscription_canceled", err.Error())
+	default:
+		s.storeError(w, err)
+	}
+}
