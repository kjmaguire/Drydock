diff --git a/result/internal/store/coupons.go b/result/internal/store/coupons.go
new file mode 100644
index 0000000..7c7fd02
--- /dev/null
+++ b/result/internal/store/coupons.go
@@ -0,0 +1,168 @@
+package store
+
+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Coupon errors. Callers check them with errors.Is.
+var (
+	// ErrCodeTaken is returned when another coupon of the organization has the code, ignoring case.
+	ErrCodeTaken            = fmt.Errorf("%w: coupon code already in use", ErrConflict)
+	ErrCouponExpired        = errors.New("the coupon can no longer be redeemed")
+	ErrCouponExhausted      = errors.New("the coupon has no redemptions left")
+	ErrCurrencyMismatch     = errors.New("the coupon's currency is not the plan's currency")
+	ErrCouponApplied        = errors.New("the subscription already has a coupon")
+	ErrSubscriptionCanceled = errors.New("the subscription is canceled")
+)
+
+var couponCodeRe = regexp.MustCompile(`^[A-Za-z0-9_-]{3,32}$`)
+
+// checkCoupon checks the terms of a coupon that is about to be created.
+func checkCoupon(c Coupon) error {
+	switch {
+	case !couponCodeRe.MatchString(c.Code):
+		return invalid("a coupon code is 3 to 32 letters, digits, dashes or underscores")
+	case (c.PercentOff != 0) == (c.AmountOff != 0):
+		return invalid("a coupon takes percent_off or amount_off, exactly one")
+	case c.PercentOff != 0 && (c.PercentOff < 1 || c.PercentOff > 100):
+		return invalid("percent_off is 1 to 100")
+	case c.AmountOff < 0:
+		return invalid("amount_off is positive")
+	case c.AmountOff != 0 && !c.Currency.Valid():
+		return invalid("unknown currency %q", c.Currency)
+	case c.AmountOff == 0 && c.Currency != "":
+		return invalid("only an amount_off coupon has a currency")
+	case c.Duration != DurationOnce && c.Duration != DurationRepeating && c.Duration != DurationForever:
+		return invalid("a coupon's duration is once, repeating or forever")
+	case c.Duration == DurationRepeating && (c.DurationInMonths < 1 || c.DurationInMonths > 36):
+		return invalid("duration_in_months is 1 to 36")
+	case c.Duration != DurationRepeating && c.DurationInMonths != 0:
+		return invalid("only a repeating coupon has duration_in_months")
+	case c.MaxRedemptions < 0:
+		return invalid("max_redemptions is at least 1")
+	}
+	return nil
+}
+
+// CreateCoupon adds a coupon to an organization. Its code is unique within the organization, ignoring case.
+func (s *Store) CreateCoupon(orgID string, c Coupon, now time.Time) (Coupon, error) {
+	if err := checkCoupon(c); err != nil {
+		return Coupon{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return Coupon{}, ErrNotFound
+	}
+	if _, ok := s.couponByCode(orgID, c.Code); ok {
+		return Coupon{}, ErrCodeTaken
+	}
+	c.ID = s.newID("cpn")
+	c.OrgID = orgID
+	c.CreatedAt = now.UTC()
+	c = copyCoupon(c)
+	s.coupons[c.ID] = c
+	return copyCoupon(c), nil
+}
+
+// Coupon returns one of an organization's coupons, found by its code ignoring case.
+func (s *Store) Coupon(orgID, code string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.couponByCode(orgID, code)
+	if !ok {
+		return Coupon{}, false
+	}
+	return s.withRedemptions(c), true
+}
+
+// Coupons returns an organization's coupons, oldest first.
+func (s *Store) Coupons(orgID string) []Coupon {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Coupon{}
+	for _, c := range s.coupons {
+		if c.OrgID == orgID {
+			out = append(out, s.withRedemptions(c))
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// ApplyCoupon applies a coupon to one of the organization's subscriptions at now, which is the redemption time. The
+// subscription must not have a coupon yet, and must not be canceled.
+func (s *Store) ApplyCoupon(orgID, subID, code string, now time.Time) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.couponByCode(orgID, code)
+	if !ok {
+		return Subscription{}, ErrNotFound
+	}
+	sub, ok := s.subs[subID]
+	if !ok || sub.OrgID != orgID {
+		return Subscription{}, ErrNotFound
+	}
+	switch {
+	case c.RedeemBy != nil && now.After(*c.RedeemBy):
+		return Subscription{}, ErrCouponExpired
+	case c.MaxRedemptions > 0 && s.redemptions(orgID, c.Code) >= c.MaxRedemptions:
+		return Subscription{}, ErrCouponExhausted
+	case c.AmountOff > 0 && s.plans[sub.PlanID].Currency != c.Currency:
+		return Subscription{}, ErrCurrencyMismatch
+	case sub.Coupon != "":
+		return Subscription{}, ErrCouponApplied
+	case sub.Status == Canceled:
+		return Subscription{}, ErrSubscriptionCanceled
+	}
+	at := now.UTC()
+	sub.Coupon, sub.CouponRedeemedAt = c.Code, &at
+	s.subs[subID] = copySub(sub)
+	return copySub(sub), nil
+}
+
+// couponByCode finds a coupon of the organization by its code, ignoring case. The caller holds the lock.
+func (s *Store) couponByCode(orgID, code string) (Coupon, bool) {
+	for _, c := range s.coupons {
+		if c.OrgID == orgID && strings.EqualFold(c.Code, code) {
+			return copyCoupon(c), true
+		}
+	}
+	return Coupon{}, false
+}
+
+// redemptions counts the subscriptions of the organization that have the coupon with this code. The caller holds the lock.
+func (s *Store) redemptions(orgID, code string) int {
+	n := 0
+	for _, sub := range s.subs {
+		if sub.OrgID == orgID && sub.Coupon == code {
+			n++
+		}
+	}
+	return n
+}
+
+// withRedemptions sets a coupon's TimesRedeemed. The caller holds the lock.
+func (s *Store) withRedemptions(c Coupon) Coupon {
+	c.TimesRedeemed = s.redemptions(c.OrgID, c.Code)
+	return c
+}
+
+// copyCoupon is a deep copy, so callers cannot change the stored redeem-by time.
+func copyCoupon(c Coupon) Coupon {
+	if c.RedeemBy != nil {
+		t := *c.RedeemBy
+		c.RedeemBy = &t
+	}
+	return c
+}
