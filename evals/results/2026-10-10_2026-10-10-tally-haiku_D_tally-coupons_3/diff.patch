+package store
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+func TestCouponValidation(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	ok := Coupon{Code: "SPRING_25", PercentOff: 25, Duration: DurationForever}
+	if _, err := s.CreateCoupon(a.ID, ok, t0); err != nil {
+		t.Fatalf("valid coupon: %v", err)
+	}
+	bad := []struct {
+		name string
+		c    Coupon
+	}{
+		{"short code", Coupon{Code: "AB", PercentOff: 5, Duration: DurationForever}},
+		{"long code", Coupon{Code: "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456", PercentOff: 5, Duration: DurationForever}},
+		{"code with a space", Coupon{Code: "A B C", PercentOff: 5, Duration: DurationForever}},
+		{"neither off", Coupon{Code: "NOOFF", Duration: DurationForever}},
+		{"both off", Coupon{Code: "BOTHOFF", PercentOff: 5, AmountOff: 500, Currency: money.USD, Duration: DurationForever}},
+		{"percent over 100", Coupon{Code: "OVER100", PercentOff: 101, Duration: DurationForever}},
+		{"amount without currency", Coupon{Code: "NOCUR", AmountOff: 500, Duration: DurationForever}},
+		{"currency on percent", Coupon{Code: "PCTCUR", PercentOff: 5, Currency: money.USD, Duration: DurationForever}},
+		{"unknown duration", Coupon{Code: "BADDUR", PercentOff: 5, Duration: "sometimes"}},
+		{"repeating without months", Coupon{Code: "NOMONTHS", PercentOff: 5, Duration: DurationRepeating}},
+		{"37 months", Coupon{Code: "TOOLONG", PercentOff: 5, Duration: DurationRepeating, DurationInMonths: 37}},
+		{"months on once", Coupon{Code: "ONCEMONTHS", PercentOff: 5, Duration: DurationOnce, DurationInMonths: 3}},
+		{"negative redemptions", Coupon{Code: "NEGMAX", PercentOff: 5, Duration: DurationForever, MaxRedemptions: -1}},
+	}
+	for _, tc := range bad {
+		if _, err := s.CreateCoupon(a.ID, tc.c, t0); !errors.Is(err, ErrInvalid) {
+			t.Errorf("%s: err = %v, want ErrInvalid", tc.name, err)
+		}
+	}
+}
+
+func TestCouponCodesAreUniqueIgnoringCase(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	if _, err := s.CreateCoupon(a.ID, Coupon{Code: "Summer", PercentOff: 10, Duration: DurationForever}, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateCoupon(a.ID, Coupon{Code: "SUMMER", PercentOff: 20, Duration: DurationForever}, t0); !errors.Is(err, ErrCodeTaken) {
+		t.Fatalf("same code, other case: err = %v", err)
+	}
+	if _, err := s.CreateCoupon(b.ID, Coupon{Code: "summer", PercentOff: 20, Duration: DurationForever}, t0); err != nil {
+		t.Fatalf("another organization may use the code: %v", err)
+	}
+	if c, ok := s.Coupon(a.ID, "sUmMeR"); !ok || c.PercentOff != 10 {
+		t.Fatalf("Coupon by code = %+v, %v", c, ok)
+	}
+	if _, ok := s.Coupon(b.ID, "Summer"); !ok {
+		t.Fatal("the other organization's coupon was not found")
+	}
+	if got := s.Coupons(a.ID); len(got) != 1 {
+		t.Fatalf("Coupons = %+v", got)
+	}
+}
+
+func TestApplyCoupon(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	usd, _ := s.CreatePlan(Plan{OrgID: a.ID, Name: "Team", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, t0)
+	eur, _ := s.CreatePlan(Plan{OrgID: a.ID, Name: "Pro", Currency: money.EUR, UnitAmount: 2000, Interval: Monthly}, t0)
+	newSub := func(planID string) Subscription {
+		sub, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: c.ID, PlanID: planID, Quantity: 1, Status: Active}, t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return sub
+	}
+	sub := newSub(usd.ID)
+	expired := t0.Add(-time.Hour)
+	_, _ = s.CreateCoupon(a.ID, Coupon{Code: "OLD", PercentOff: 5, Duration: DurationForever, RedeemBy: &expired}, t0)
+	_, _ = s.CreateCoupon(a.ID, Coupon{Code: "ONE", PercentOff: 5, Duration: DurationForever, MaxRedemptions: 1}, t0)
+	_, _ = s.CreateCoupon(a.ID, Coupon{Code: "EURFIVE", AmountOff: 500, Currency: money.EUR, Duration: DurationOnce}, t0)
+	_, _ = s.CreateCoupon(a.ID, Coupon{Code: "FREE", PercentOff: 100, Duration: DurationForever}, t0)
+
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "missing", t0); !errors.Is(err, ErrNotFound) {
+		t.Errorf("no such coupon: %v", err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, "sub_nope", "FREE", t0); !errors.Is(err, ErrNotFound) {
+		t.Errorf("no such subscription: %v", err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "OLD", t0); !errors.Is(err, ErrCouponExpired) {
+		t.Errorf("expired: %v", err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "EURFIVE", t0); !errors.Is(err, ErrCurrencyMismatch) {
+		t.Errorf("currency: %v", err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, newSub(eur.ID).ID, "EURFIVE", t0); err != nil {
+		t.Errorf("a coupon in the plan's currency: %v", err)
+	}
+	applied, err := s.ApplyCoupon(a.ID, sub.ID, "one", t0.Add(time.Minute))
+	if err != nil || applied.Coupon != "ONE" || applied.CouponRedeemedAt == nil || !applied.CouponRedeemedAt.Equal(t0.Add(time.Minute)) {
+		t.Fatalf("apply = %+v, %v", applied, err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, sub.ID, "FREE", t0); !errors.Is(err, ErrCouponApplied) {
+		t.Errorf("already has one: %v", err)
+	}
+	if _, err := s.ApplyCoupon(a.ID, newSub(usd.ID).ID, "ONE", t0); !errors.Is(err, ErrCouponExhausted) {
+		t.Errorf("exhausted: %v", err)
+	}
+	if got, _ := s.Coupon(a.ID, "ONE"); got.TimesRedeemed != 1 {
+		t.Errorf("times redeemed = %d", got.TimesRedeemed)
+	}
+	canceled := newSub(usd.ID)
+	_, _ = s.UpdateSubscription(a.ID, canceled.ID, func(x *Subscription) error { x.Status = Canceled; return nil })
+	if _, err := s.ApplyCoupon(a.ID, canceled.ID, "FREE", t0); !errors.Is(err, ErrSubscriptionCanceled) {
+		t.Errorf("canceled: %v", err)
+	}
+}
+
+func TestCouponsSurviveExportAndFromState(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	p, _ := s.CreatePlan(Plan{OrgID: a.ID, Name: "Team", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, t0)
+	sub, _ := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: c.ID, PlanID: p.ID, Quantity: 1, Status: Active}, t0)
+	until := t0.AddDate(1, 0, 0)
+	_, _ = s.CreateCoupon(a.ID, Coupon{Code: "YEAR", PercentOff: 15, Duration: DurationRepeating, DurationInMonths: 6, RedeemBy: &until}, t0)
+	_, _ = s.ApplyCoupon(a.ID, sub.ID, "YEAR", t0)
+	st := s.Export()
+	s2, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(s2.Export(), st) {
+		t.Fatalf("round trip changed the state:\n%+v\n%+v", s2.Export(), st)
+	}
+	if got, ok := s2.Subscription(a.ID, sub.ID); !ok || got.Coupon != "YEAR" {
+		t.Fatalf("subscription after FromState = %+v", got)
+	}
+}
