+// couponFor returns the coupon that discounts an invoice created at now for a period starting at start, or nil. A coupon
+// discounts the invoices created after it was applied: once only the first of them, repeating those whose period starts
+// less than its months after the redemption, forever all of them.
+func (s *Service) couponFor(sub store.Subscription, start, now time.Time) *store.Coupon {
+	if sub.Coupon == "" || sub.CouponRedeemedAt == nil || now.Before(*sub.CouponRedeemedAt) {
+		return nil
+	}
+	c, ok := s.Store.Coupon(sub.OrgID, sub.Coupon)
+	if !ok {
+		return nil
+	}
+	switch c.Duration {
+	case store.DurationOnce:
+		for _, inv := range s.Store.ListInvoices(sub.OrgID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+			if inv.Coupon == c.Code {
+				return nil
+			}
+		}
+	case store.DurationRepeating:
+		if !start.Before(sub.CouponRedeemedAt.AddDate(0, c.DurationInMonths, 0)) {
+			return nil
+		}
+	}
+	return &c
+}
