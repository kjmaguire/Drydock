+func TestCouponLeavesEarlierInvoicesAlone(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.Store.CreateCoupon(e.Acme.ID, store.Coupon{Code: "FREE", PercentOff: 100, Duration: store.DurationForever}, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.Store.ApplyCoupon(e.Acme.ID, sub.ID, "free", e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 1 || invs[0].Coupon != "" || billing.Compute(invs[0]).Total != 2000 {
+		t.Fatalf("the first invoice = %+v", invs)
+	}
+}
