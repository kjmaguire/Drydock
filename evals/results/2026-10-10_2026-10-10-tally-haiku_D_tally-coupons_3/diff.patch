+)
+
+// A coupon applied on Feb 1 discounts the renewals on Feb 15, Mar 15 and Apr 15, which are the invoices created after it.
+// The subscription's own 10% discount applies to the invoices the coupon does not cover.
+func TestCouponDiscountsTheInvoicesItCovers(t *testing.T) {
+	cases := []struct {
+		name     string
+		duration store.CouponDuration
+		months   int
+		want     []bool // whether each renewal's invoice is discounted by the coupon
+	}{
+		{"once", store.DurationOnce, 0, []bool{true, false, false}},
+		{"repeating for two months", store.DurationRepeating, 2, []bool{true, true, false}},
+		{"forever", store.DurationForever, 0, []bool{true, true, true}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			e := apitest.New(t)
+			ctx := context.Background()
+			c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+			p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+			sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1, DiscountPercent: 10})
+			if err != nil {
+				t.Fatal(err)
+			}
+			e.Clock.Set(time.Date(2026, time.February, 1, 10, 0, 0, 0, time.UTC))
+			if _, err := e.Store.CreateCoupon(e.Acme.ID, store.Coupon{Code: "HALF", PercentOff: 50, Duration: tc.duration, DurationInMonths: tc.months}, e.Clock.Now()); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := e.Store.ApplyCoupon(e.Acme.ID, sub.ID, "HALF", e.Clock.Now()); err != nil {
+				t.Fatal(err)
+			}
+			for range tc.want {
+				got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+				e.Clock.Set(got.CurrentPeriodEnd)
+				if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+					t.Fatalf("RenewDue = %d, %v", n, err)
+				}
+			}
+			invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+			if len(invs) != len(tc.want)+1 {
+				t.Fatalf("%d invoices, want %d", len(invs), len(tc.want)+1)
+			}
+			if invs[0].Coupon != "" || billing.Compute(invs[0]).Discount != 200 {
+				t.Fatalf("the invoice before the coupon = %+v", invs[0])
+			}
+			for i, covered := range tc.want {
+				inv := invs[i+1]
+				d := billing.Compute(inv).Discount
+				switch {
+				case covered && (inv.Coupon != "HALF" || inv.DiscountPercent != 0 || d != 1000):
+					t.Errorf("renewal %d: coupon %q, discount_percent %d, discount %d; want the coupon's 50%%", i+1, inv.Coupon, inv.DiscountPercent, d)
+				case !covered && (inv.Coupon != "" || d != 200):
+					t.Errorf("renewal %d: coupon %q, discount %d; want the subscription's 10%%", i+1, inv.Coupon, d)
+				}
+			}
+		})
+	}
+}
