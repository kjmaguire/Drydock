+// Compute returns an invoice's totals: the sum of its lines, the discount, and tax at the invoice's rate on the subtotal
+// after the discount. The discount is the coupon's when a coupon discounted the invoice, else DiscountPercent of the
+// subtotal. The discount and the tax are each rounded half away from zero to a whole minor unit.
 func Compute(inv store.Invoice) Totals {
 	var subtotal int64
 	for _, l := range inv.Lines {
 		subtotal += l.Amount()
 	}
-	discount := money.Percent(subtotal, inv.DiscountPercent)
+	discount := discountOf(inv, subtotal)
 	taxable := subtotal - discount
 	tax := money.BasisPoints(taxable, inv.TaxRateBP)
 	return Totals{Subtotal: subtotal, Discount: discount, Tax: tax, Total: taxable + tax}
 }
 
+// discountOf is the discount on an invoice's subtotal. An amount off is never more than the subtotal.
+func discountOf(inv store.Invoice, subtotal int64) int64 {
+	switch {
+	case inv.Coupon == "":
+		return money.Percent(subtotal, inv.DiscountPercent)
+	case inv.CouponAmountOff > 0:
+		return min(inv.CouponAmountOff, max(subtotal, 0))
+	default:
+		return money.Percent(subtotal, inv.CouponPercentOff)
+	}
+}
