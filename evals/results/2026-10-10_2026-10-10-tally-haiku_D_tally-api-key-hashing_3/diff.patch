+func TestAPIKeyTokensAreHashed(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	u, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	_, _ = s.AddMember(o.ID, u.ID, RoleOwner, t0)
+	k, err := s.CreateAPIKey(o.ID, u.ID, "CI", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !apiKeyTokenRe.MatchString(k.Token) {
+		t.Fatalf("token %q is not tly_ and 40 letters or digits", k.Token)
+	}
+	if k.Last4 != k.Token[len(k.Token)-4:] || k.Hash != hashToken(k.Token) {
+		t.Fatalf("key = %+v", k)
+	}
+	if sum := sha256.Sum256([]byte(k.Token)); k.Hash != hex.EncodeToString(sum[:]) {
+		t.Fatalf("hash %q is not the hex SHA-256 of the token", k.Hash)
+	}
+
+	// Nothing stored, listed or exported holds the token, only its hash.
+	if got, ok := s.APIKey(o.ID, k.ID); !ok || got.Token != "" || got.Hash != k.Hash {
+		t.Fatalf("APIKey = %+v %v", got, ok)
+	}
+	if listed := s.APIKeys(o.ID); len(listed) != 1 || listed[0].Token != "" {
+		t.Fatalf("APIKeys = %+v", listed)
+	}
+	raw, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(raw), k.Token) {
