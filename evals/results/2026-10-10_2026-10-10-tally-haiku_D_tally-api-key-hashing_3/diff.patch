+func TestSnapshotsHoldNoPlainTextTokens(t *testing.T) {
+	const legacy = "tly_00000000000000000000000000000003"
+	now := time.Date(2026, 2, 1, 12, 0, 0, 0, time.UTC)
+
+	// A version 1 file holds the plain-text token. Its key keeps working, and the next snapshot does not hold the token.
+	st, err := Load(filepath.Join("testdata", "v1.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	fresh, _ := st.CreateAPIKey("org_000001", "usr_000002", "fresh", now)
+	path := filepath.Join(t.TempDir(), "tally.json")
+	if err := Save(st, path, now); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tok := range []string{legacy, fresh.Token} {
+		if strings.Contains(string(b), tok) {
+			t.Fatalf("the snapshot holds the plain-text token %s", tok)
+		}
+	}
+	got, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := got.APIKeyByToken(legacy); !ok {
+		t.Fatal("the migrated key does not work after a reload")
+	}
+	if _, ok := got.APIKeyByToken(fresh.Token); !ok {
+		t.Fatal("a new key does not work after a reload")
+	}
+}
