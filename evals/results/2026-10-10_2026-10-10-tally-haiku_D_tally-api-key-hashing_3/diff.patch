+// The token of a new key is answered once, by the call that creates the key or accepts the invite. Listings show only
+// the last four characters, never the token or its hash.
+func TestAPIKeyTokenIsShownOnce(t *testing.T) {
+	e := apitest.New(t)
+	tokenRe := regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`)
+
+	created := e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "CI"}, nil).Map(t)
+	token, _ := created["token"].(string)
+	if !tokenRe.MatchString(token) || created["last4"] != token[len(token)-4:] {
+		t.Fatalf("created key = %v", created)
+	}
+	if _, ok := created["token_hash"]; ok {
+		t.Fatalf("the create answer shows the hash: %v", created)
+	}
+
+	var inv struct {
+		Token string `json:"token"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "once@people.example", "role": "member"}, &inv)
+	accepted := e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": inv.Token, "name": "Once"}, nil).Map(t)
+	key, _ := accepted["api_key"].(map[string]any)
+	acceptedToken, _ := key["token"].(string)
+	if !tokenRe.MatchString(acceptedToken) {
+		t.Fatalf("accepted key = %v", key)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", acceptedToken, nil, nil)
+
+	list := e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, nil)
+	for _, leak := range []string{token, acceptedToken, "token", "_hash"} {
+		if strings.Contains(string(list.Body), leak) {
+			t.Fatalf("the listing shows %q: %s", leak, list)
+		}
+	}
+	var keys struct {
+		Items []map[string]any `json:"items"`
+	}
+	list.JSON(t, &keys)
+	if len(keys.Items) != 3 || keys.Items[1]["last4"] != token[len(token)-4:] {
+		t.Fatalf("keys = %v", keys.Items)
+	}
+}
