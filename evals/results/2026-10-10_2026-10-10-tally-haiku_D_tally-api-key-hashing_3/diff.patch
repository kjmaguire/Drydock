+// apiKeyTokenAlphabet is the set of characters in API key tokens. Its length, 62, divides 248 evenly, so the bytes below
+// 248 map onto it without bias.
+const apiKeyTokenAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+
+// apiKeyTouchInterval is the least time between two writes of a key's last use.
+const apiKeyTouchInterval = time.Minute
+
+// newAPIKeyToken returns "tly_" followed by 40 random characters from [A-Za-z0-9].
+func newAPIKeyToken() string {
+	const n = 40
+	out := make([]byte, 0, n)
+	buf := make([]byte, n)
+	for len(out) < n {
+		if _, err := rand.Read(buf); err != nil {
+			panic(err) // crypto/rand does not fail on supported platforms
+		}
+		for _, b := range buf {
+			if b < 248 && len(out) < n {
+				out = append(out, apiKeyTokenAlphabet[int(b)%len(apiKeyTokenAlphabet)])
+			}
+		}
+	}
+	return "tly_" + string(out)
+}
+
+// hashToken is how an API key token is stored: the hex SHA-256 of the token.
+func hashToken(token string) string {
+	sum := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(sum[:])
+}
+
+// lastFour returns the last four characters of a token, or all of it if it is shorter.
+func lastFour(token string) string {
+	if len(token) <= 4 {
+		return token
+	}
+	return token[len(token)-4:]
+}
