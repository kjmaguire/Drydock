+// indexInvoice adds a new invoice to its organization's index, in order. The caller holds the lock. A new invoice is
+// normally the newest, so it usually goes at the end.
+func (s *Store) indexInvoice(inv Invoice) {
+	ids := s.invoiceIDs[inv.OrgID]
+	at := sort.Search(len(ids), func(i int) bool {
+		return InvoiceCursor{Created: inv.CreatedAt, ID: inv.ID}.before(s.invoices[ids[i]])
+	})
+	s.invoiceIDs[inv.OrgID] = slices.Insert(ids, at, inv.ID)
+}
+
+// rebuildInvoiceIndex builds every organization's index from s.invoices. The caller holds the lock.
+func (s *Store) rebuildInvoiceIndex() {
+	s.invoiceIDs = map[string][]string{}
+	for id, inv := range s.invoices {
+		s.invoiceIDs[inv.OrgID] = append(s.invoiceIDs[inv.OrgID], id)
+	}
+	for _, ids := range s.invoiceIDs {
+		sort.Slice(ids, func(i, j int) bool {
+			a, b := s.invoices[ids[i]], s.invoices[ids[j]]
+			return InvoiceCursor{Created: a.CreatedAt, ID: a.ID}.before(b)
+		})
+	}
+}
