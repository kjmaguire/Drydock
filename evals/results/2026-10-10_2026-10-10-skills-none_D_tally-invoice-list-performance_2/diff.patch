+// TestListInvoicesAtScale lists a 60,000-invoice organization with 5,000 customers, beside another organization's invoices.
+// Every page answers quickly, and the pages hold exactly the matching invoices, oldest first.
+func TestListInvoicesAtScale(t *testing.T) {
+	if testing.Short() {
+		t.Skip("creates 60,000 invoices")
+	}
+	e := apitest.New(t)
+	const customers, invoices = 5000, 60000
+	cs := make([]store.Customer, customers)
+	for i := range cs {
+		c, err := e.Store.CreateCustomer(e.Acme.ID, fmt.Sprintf("Customer %d", i), fmt.Sprintf("customer%d@acme.example", i), apitest.Start)
+		if err != nil {
+			t.Fatal(err)
+		}
+		cs[i] = c
+	}
+	other, err := e.Store.CreateCustomer(e.Globex.ID, "Other", "other@globex.example", apitest.Start)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range 2000 {
+		if _, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Globex.ID, CustomerID: other.ID, Currency: money.EUR, Lines: []store.Line{{Description: "Other", Quantity: 1, UnitAmount: int64(i)}}}, apitest.Start); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// The invoices in creation order, which is also their listing order: two share each creation minute.
+	var acme []store.Invoice
+	for i := range invoices {
+		sub := ""
+		if i%10 == 0 {
+			sub = "sub_a"
+		}
+		inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: cs[i%customers].ID, Currency: money.USD, SubscriptionID: sub,
+			Lines: []store.Line{{Description: fmt.Sprintf("Item %d", i), Quantity: 1, UnitAmount: int64(100 + i)}}}, apitest.Start.Add(time.Duration(i/2)*time.Minute))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i%3 == 0 {
+			if inv, err = e.Store.UpdateInvoice(e.Acme.ID, inv.ID, func(v *store.Invoice) error { v.Status = store.InvoicePaid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+		acme = append(acme, inv)
+	}
+
+	walk := func(query string, keep func(store.Invoice) bool) {
+		t.Helper()
+		var want []string
+		for _, inv := range acme {
+			if keep(inv) {
+				want = append(want, inv.ID)
+			}
+		}
+		var got []string
+		var slowest time.Duration
+		path := "/v1/invoices?limit=100" + query
+		for {
+			start := time.Now()
+			r := e.Do("GET", path, e.Acme.Key, nil)
+			slowest = max(slowest, time.Since(start))
+			if r.Code != http.StatusOK {
+				t.Fatalf("GET %s: %s", path, r)
+			}
+			var page struct {
+				Items []struct {
+					ID string `json:"id"`
+				} `json:"items"`
+				NextCursor string `json:"next_cursor"`
+			}
+			if err := json.Unmarshal(r.Body, &page); err != nil {
+				t.Fatal(err)
+			}
+			for _, it := range page.Items {
+				got = append(got, it.ID)
+			}
+			if page.NextCursor == "" {
+				break
+			}
+			path = "/v1/invoices?limit=100" + query + "&cursor=" + url.QueryEscape(page.NextCursor)
+		}
+		if !slices.Equal(got, want) {
+			t.Fatalf("GET /v1/invoices%s listed %d invoices, want %d (in the same order)", query, len(got), len(want))
+		}
+		if slowest > 250*time.Millisecond {
+			t.Errorf("GET /v1/invoices%s: slowest page took %v", query, slowest)
+		}
+		t.Logf("GET /v1/invoices%s: %d invoices, slowest page %v", query, len(got), slowest)
+	}
+	walk("", func(store.Invoice) bool { return true })
+	walk("&status=open", func(inv store.Invoice) bool { return inv.Status == store.InvoiceOpen })
+	walk("&customer_id="+cs[7].ID, func(inv store.Invoice) bool { return inv.CustomerID == cs[7].ID })
+	walk("&subscription_id=sub_a&status=paid", func(inv store.Invoice) bool { return inv.SubscriptionID == "sub_a" && inv.Status == store.InvoicePaid })
+	walk("&status=void", func(inv store.Invoice) bool { return inv.Status == store.InvoiceVoid })
+}
