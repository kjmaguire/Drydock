+func TestInvoicePaging(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Joe", "joe@example.com", t0)
+	create := func(org Org, c Customer, at time.Time) Invoice {
+		t.Helper()
+		inv, err := s.CreateInvoice(Invoice{OrgID: org.ID, CustomerID: c.ID, Currency: money.EUR, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	// Three invoices share a creation time (ties by ID), and another organization's invoices sit between them.
+	i1 := create(a, ca, t0)
+	create(b, cb, t0)
+	i2 := create(a, ca, t0)
+	i3 := create(a, ca, t0)
+	create(b, cb, t0.Add(time.Second))
+	i4 := create(a, ca, t0.Add(time.Minute))
+	i5 := create(a, ca, t0.Add(time.Minute))
+	ids := func(invs []Invoice) []string {
+		out := []string{}
+		for _, inv := range invs {
+			out = append(out, inv.ID)
+		}
+		return out
+	}
+	want := []string{i1.ID, i2.ID, i3.ID, i4.ID, i5.ID}
+	if got := ids(s.ListInvoices(a.ID, InvoiceFilter{})); !reflect.DeepEqual(got, want) {
+		t.Fatalf("ListInvoices = %v, want %v", got, want)
+	}
+
+	// Walking the pages with a cursor sees every invoice once, in order.
+	walk := func(f InvoiceFilter, limit int) []string {
+		t.Helper()
+		var got []string
+		var after *InvoiceCursor
+		for range 100 {
+			page, more := s.InvoicePage(a.ID, f, after, limit)
+			got = append(got, ids(page)...)
+			if !more {
+				return got
+			}
+			last := page[len(page)-1]
+			after = &InvoiceCursor{Created: last.CreatedAt, ID: last.ID}
+		}
+		t.Fatal("paging did not end")
+		return nil
+	}
+	if got := walk(InvoiceFilter{}, 2); !reflect.DeepEqual(got, want) {
+		t.Fatalf("pages = %v, want %v", got, want)
+	}
+	if page, more := s.InvoicePage(a.ID, InvoiceFilter{}, &InvoiceCursor{Created: t0.Add(time.Hour), ID: "in_999999"}, 2); len(page) != 0 || more || page == nil {
+		t.Fatalf("page past the end = %v, %v", page, more)
+	}
+
+	// Filters apply before paging.
+	if _, err := s.UpdateInvoice(a.ID, i2.ID, func(i *Invoice) error { i.Status = InvoicePaid; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if got := walk(InvoiceFilter{Status: InvoiceOpen}, 1); !reflect.DeepEqual(got, []string{i1.ID, i3.ID, i4.ID, i5.ID}) {
+		t.Fatalf("open pages = %v", got)
+	}
+	if got := walk(InvoiceFilter{CustomerID: cb.ID}, 1); len(got) != 0 {
+		t.Fatalf("another customer's pages = %v", got)
+	}
+
+	// Invoices created between pages land in order: one at the newest time goes last, one older than everything goes first.
+	page, more := s.InvoicePage(a.ID, InvoiceFilter{}, nil, 2)
+	if !more || len(page) != 2 {
+		t.Fatalf("first page = %v, %v", ids(page), more)
+	}
+	last := page[1]
+	newest := create(a, ca, t0.Add(time.Hour))
+	oldest := create(a, ca, t0.Add(-time.Hour))
+	want = append([]string{oldest.ID}, append(want, newest.ID)...)
+	if got := ids(s.ListInvoices(a.ID, InvoiceFilter{})); !reflect.DeepEqual(got, want) {
+		t.Fatalf("ListInvoices after inserts = %v, want %v", got, want)
+	}
+	var got []string
+	after := &InvoiceCursor{Created: last.CreatedAt, ID: last.ID}
+	for {
+		page, more := s.InvoicePage(a.ID, InvoiceFilter{}, after, 2)
+		got = append(got, ids(page)...)
+		if !more {
+			break
+		}
+		after = &InvoiceCursor{Created: page[len(page)-1].CreatedAt, ID: page[len(page)-1].ID}
+	}
+	if !reflect.DeepEqual(got, []string{i3.ID, i4.ID, i5.ID, newest.ID}) {
+		t.Fatalf("pages after the first = %v", got)
+	}
+
+	// A reloaded store has the same order.
+	reloaded, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ids(reloaded.ListInvoices(a.ID, InvoiceFilter{})); !reflect.DeepEqual(got, want) {
+		t.Fatalf("ListInvoices after FromState = %v, want %v", got, want)
+	}
+}
