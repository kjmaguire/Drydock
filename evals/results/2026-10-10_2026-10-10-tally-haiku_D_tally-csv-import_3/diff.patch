+// CustomerInput is a customer for ImportCustomers.
+type CustomerInput struct {
+	Name                 string
+	Email                string
+	DefaultPaymentMethod string
+	Metadata             map[string]string
+}
+
+// ValidCustomerEmail reports whether email (ignoring surrounding spaces) is an address a customer can have.
+func ValidCustomerEmail(email string) bool { return validEmail(strings.TrimSpace(email)) }
+
+// ImportCustomers creates customers in the order given, all or none: when one of them cannot be created, nothing is, and
+// the error says why. The checks are CreateCustomer's, plus a payment method that looks like pm_..., and an email address
+// used by an existing customer or by an earlier one in ins is ErrEmailTaken (checked again here, so a concurrent create
+// cannot slip in between a caller's check and this call).
+func (s *Store) ImportCustomers(orgID string, ins []CustomerInput, now time.Time) ([]Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return nil, ErrNotFound
+	}
+	// The organization's own addresses, not the email index: that index holds one customer per address across all
+	// organizations.
+	taken := map[string]bool{}
+	for _, c := range s.customers {
+		if c.OrgID == orgID {
+			taken[normEmail(c.Email)] = true
+		}
+	}
+	out := make([]Customer, 0, len(ins))
+	for _, in := range ins {
+		c := Customer{OrgID: orgID, Name: strings.TrimSpace(in.Name), Email: strings.TrimSpace(in.Email),
+			DefaultPaymentMethod: strings.TrimSpace(in.DefaultPaymentMethod), Metadata: in.Metadata, CreatedAt: now.UTC()}
+		if c.Name == "" || !validEmail(c.Email) {
+			return nil, invalid("a customer needs a name and a valid email address")
+		}
+		if c.DefaultPaymentMethod != "" && !strings.HasPrefix(c.DefaultPaymentMethod, "pm_") {
+			return nil, invalid("a payment method looks like pm_...")
+		}
+		key := normEmail(c.Email)
+		if taken[key] {
+			return nil, ErrEmailTaken
+		}
+		taken[key] = true
+		out = append(out, c)
+	}
+	for i := range out {
+		out[i].ID = s.newID("cus")
+		s.customers[out[i].ID] = copyCustomer(out[i])
+		s.customersByEmail[normEmail(out[i].Email)] = out[i].ID
+	}
+	return out, nil
+}
