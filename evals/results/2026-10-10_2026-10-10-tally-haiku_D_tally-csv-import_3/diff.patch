+// importCustomers creates customers from a CSV body. The first record is a header: name and email columns are required,
+// default_payment_method and metadata.<key> columns are optional, and other columns are ignored. Every record is checked
+// before anything is created, and when one has a problem the answer lists all of them (422 invalid_rows). ?dry_run=true
+// only checks.
+func (s *Server) importCustomers(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_csv", "the body could not be read")
+		return
+	}
+	cr := csv.NewReader(bytes.NewReader(bytes.TrimPrefix(body, []byte("\xef\xbb\xbf"))))
+	cr.FieldsPerRecord = -1 // a short record is a customer with empty cells, which is reported per row
+	header, _, err := readRecord(cr)
+	if errors.Is(err, io.EOF) {
+		writeError(w, http.StatusUnprocessableEntity, "invalid_header", "the first record must name the columns, with name and email among them")
+		return
+	}
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_csv", "the body is not valid CSV: "+err.Error())
+		return
+	}
+	cols, ok := importColumnsOf(header)
+	if !ok {
+		writeError(w, http.StatusUnprocessableEntity, "invalid_header", "the first record must name the columns, with name and email among them")
+		return
+	}
+	var rows []importRow
+	for {
+		rec, line, err := readRecord(cr)
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			writeError(w, http.StatusBadRequest, "invalid_csv", "the body is not valid CSV: "+err.Error())
+			return
+		}
+		if len(rows) == maxImportRows {
+			writeError(w, http.StatusRequestEntityTooLarge, "too_many_rows", "an import takes at most 10000 customers")
+			return
+		}
+		rows = append(rows, importRow{line: line, in: cols.customer(rec)})
+	}
+
+	existing := map[string]bool{}
+	for _, c := range s.store.Customers(p.OrgID) {
+		existing[strings.ToLower(c.Email)] = true
+	}
+	seen := make(map[string]bool, len(rows))
+	var bad []rowError
+	for _, row := range rows {
+		if code := importProblem(row.in, existing, seen); code != "" {
+			bad = append(bad, rowError{Row: row.line, Error: code})
+		}
+	}
+	if len(bad) > 0 {
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]any{"error": "invalid_rows", "rows": bad})
+		return
+	}
+	if r.URL.Query().Get("dry_run") == "true" {
+		writeJSON(w, http.StatusOK, map[string]int{"created": 0, "would_create": len(rows)})
+		return
+	}
+	ins := make([]store.CustomerInput, len(rows))
+	for i, row := range rows {
+		ins[i] = row.in
+	}
+	created, err := s.store.ImportCustomers(p.OrgID, ins, s.clock.Now())
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	for _, c := range created {
+		s.publish(r.Context(), p.OrgID, "customer.created", c)
+	}
+	writeJSON(w, http.StatusCreated, map[string]any{"created": len(created), "items": created})
+}
+
+// importRow is a record of an import: the line it starts on, and the customer it asks for.
+type importRow struct {
+	line int
+	in   store.CustomerInput
+}
+
+// rowError is a record of an import that cannot be created.
+type rowError struct {
+	Row   int    `json:"row"`
+	Error string `json:"error"`
+}
+
+// importProblem returns the first problem with a record of an import, or "" when the record can be created. existing holds
+// the lower-case email addresses of the organization's customers, and seen those of the earlier records; this record's
+// address is added to seen.
+func importProblem(in store.CustomerInput, existing, seen map[string]bool) string {
+	email := strings.TrimSpace(in.Email)
+	key := strings.ToLower(email)
+	valid := store.ValidCustomerEmail(email)
+	dup := seen[key]
+	if valid {
+		seen[key] = true
+	}
+	pm := strings.TrimSpace(in.DefaultPaymentMethod)
+	switch {
+	case strings.TrimSpace(in.Name) == "":
+		return "missing_name"
+	case !valid:
+		return "invalid_email"
+	case pm != "" && !strings.HasPrefix(pm, "pm_"):
+		return "invalid_payment_method"
+	case existing[key]:
+		return "email_taken"
+	case dup:
+		return "duplicate_email"
+	}
+	return ""
+}
+
+// importColumns are the header positions of an import's columns, -1 when the header has no such column.
+type importColumns struct {
+	name, email, payment int
+	metadata             map[string]int // metadata key -> column
+}
+
+// importColumnsOf reads a header. Names match ignoring case and surrounding spaces; the first column with a name wins.
+// It reports false when there is no name or email column.
+func importColumnsOf(header []string) (importColumns, bool) {
+	const metaPrefix = "metadata."
+	cols := importColumns{name: -1, email: -1, payment: -1, metadata: map[string]int{}}
+	for i, h := range header {
+		h = strings.TrimSpace(h)
+		switch lower := strings.ToLower(h); {
+		case lower == "name" && cols.name < 0:
+			cols.name = i
+		case lower == "email" && cols.email < 0:
+			cols.email = i
+		case lower == "default_payment_method" && cols.payment < 0:
+			cols.payment = i
+		case len(h) > len(metaPrefix) && strings.EqualFold(h[:len(metaPrefix)], metaPrefix):
+			key := strings.TrimSpace(h[len(metaPrefix):])
+			if _, dup := cols.metadata[key]; !dup && key != "" {
+				cols.metadata[key] = i
+			}
+		}
+	}
+	return cols, cols.name >= 0 && cols.email >= 0
+}
+
+// customer is the customer a record asks for. Cells the record does not have are empty, and an empty metadata cell
+// sets no key.
+func (c importColumns) customer(rec []string) store.CustomerInput {
+	cell := func(i int) string {
+		if i < 0 || i >= len(rec) {
+			return ""
+		}
+		return rec[i]
+	}
+	in := store.CustomerInput{Name: cell(c.name), Email: cell(c.email), DefaultPaymentMethod: cell(c.payment)}
+	for key, i := range c.metadata {
+		if v := cell(i); v != "" {
+			if in.Metadata == nil {
+				in.Metadata = map[string]string{}
+			}
+			in.Metadata[key] = v
+		}
+	}
+	return in
+}
+
+var errNotUTF8 = errors.New("the body is not UTF-8")
+
+// readRecord returns the next record that is not blank, and the line it starts on. Fields that are not UTF-8 are an error.
+func readRecord(cr *csv.Reader) ([]string, int, error) {
+	for {
+		rec, err := cr.Read()
+		if err != nil {
+			return nil, 0, err
+		}
+		line, _ := cr.FieldPos(0)
+		if len(rec) == 1 && strings.TrimSpace(rec[0]) == "" {
+			continue
+		}
+		for _, f := range rec {
+			if !utf8.ValidString(f) {
+				return nil, 0, errNotUTF8
+			}
+		}
+		return rec, line, nil
+	}
+}
