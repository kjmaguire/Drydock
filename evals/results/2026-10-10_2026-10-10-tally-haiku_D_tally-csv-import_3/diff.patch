+
+type importAnswer struct {
+	Created     int              `json:"created"`
+	WouldCreate int              `json:"would_create"`
+	Items       []store.Customer `json:"items"`
+}
+
+func customersOf(t *testing.T, e *apitest.Env, key string) []store.Customer {
+	t.Helper()
+	var page struct {
+		Items []store.Customer `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", key, nil, &page)
+	return page.Items
+}
+
+func TestImportCustomers(t *testing.T) {
+	e := apitest.New(t)
+	body := "\xef\xbb\xbf" + // a byte order mark
+		"Email , Name,Ignored,default_payment_method,Metadata.CRM,metadata.plan\r\n" +
+		"a@example.com,\"Doe, Jane\",x,pm_123,\"7\",\"gold\"\r\n" +
+		"\r\n" +
+		"b@example.com,\"Quote \"\"Q\"\" Roe\",x,,,\"line\nbreak\"\r\n" +
+		"  \r\n" +
+		"C@Example.com,Cy,,,,\r\n"
+	var got importAnswer
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers/import", e.Acme.Key, body, &got)
+	if got.Created != 3 || len(got.Items) != 3 {
+		t.Fatalf("answer = %+v", got)
+	}
+	jane := got.Items[0]
+	if jane.Name != "Doe, Jane" || jane.Email != "a@example.com" || jane.DefaultPaymentMethod != "pm_123" ||
+		jane.Metadata["CRM"] != "7" || jane.Metadata["plan"] != "gold" || len(jane.Metadata) != 2 {
+		t.Fatalf("first customer = %+v", jane)
+	}
+	if q := got.Items[1]; q.Name != `Quote "Q" Roe` || q.DefaultPaymentMethod != "" || len(q.Metadata) != 1 || q.Metadata["plan"] != "line\nbreak" {
+		t.Fatalf("second customer = %+v", q)
+	}
+	if c := got.Items[2]; c.Email != "C@Example.com" || c.Metadata != nil {
+		t.Fatalf("third customer = %+v", c)
+	}
+
+	if all := customersOf(t, e, e.Acme.Key); len(all) != 3 || all[0].ID != got.Items[0].ID || all[2].ID != got.Items[2].ID {
+		t.Fatalf("customers = %+v", all)
+	}
+	var events struct {
+		Items []store.Event `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/events?type=customer.created", e.Acme.Key, nil, &events)
+	if len(events.Items) != 3 {
+		t.Fatalf("customer.created events = %d, want 3", len(events.Items))
+	}
+	if r := e.Do("POST", "/v1/customers/import", e.Globex.Key, "name,email\nJane,a@example.com\n"); r.Code != http.StatusCreated {
+		t.Fatalf("another org takes the same address: %s", r)
+	}
+}
+
+func TestImportCustomersHeaderOnly(t *testing.T) {
+	e := apitest.New(t)
+	var got importAnswer
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers/import", e.Acme.Key, "name,email\n", &got)
+	if got.Created != 0 || got.Items == nil || len(got.Items) != 0 {
+		t.Fatalf("answer = %+v", got)
+	}
+}
+
+func TestImportCustomersBadHeaderOrCSV(t *testing.T) {
+	e := apitest.New(t)
+	cases := []struct {
+		name, body, code string
+		status           int
+	}{
+		{"empty body", "", "invalid_header", http.StatusUnprocessableEntity},
+		{"only blank lines", "\r\n\r\n", "invalid_header", http.StatusUnprocessableEntity},
+		{"no email column", "name,mail\nJane,j@example.com\n", "invalid_header", http.StatusUnprocessableEntity},
+		{"no name column", "Email\nj@example.com\n", "invalid_header", http.StatusUnprocessableEntity},
+		{"unterminated quote", "name,email\n\"Jane,j@example.com\n", "invalid_csv", http.StatusBadRequest},
+		{"bare quote", "name,email\nJa\"ne,j@example.com\n", "invalid_csv", http.StatusBadRequest},
+		{"not UTF-8", "name,email\nJan\xff,j@example.com\n", "invalid_csv", http.StatusBadRequest},
+	}
+	for _, c := range cases {
+		r := e.Do("POST", "/v1/customers/import", e.Acme.Key, c.body)
+		if r.Code != c.status || r.Map(t)["error"] != c.code {
+			t.Errorf("%s: %s, want %d %s", c.name, r, c.status, c.code)
+		}
+	}
+	if all := customersOf(t, e, e.Acme.Key); len(all) != 0 {
+		t.Fatalf("customers created by a failed import: %+v", all)
+	}
+}
+
+func TestImportCustomersTooManyRows(t *testing.T) {
+	e := apitest.New(t)
+	var b strings.Builder
+	b.WriteString("name,email\n")
+	for i := range maxRows {
+		fmt.Fprintf(&b, "Customer %d,c%d@example.com\n", i, i)
+	}
+	if r := e.Do("POST", "/v1/customers/import?dry_run=true", e.Acme.Key, b.String()); r.Code != http.StatusOK || r.Map(t)["would_create"] != float64(maxRows) {
+		t.Fatalf("%d rows: %s", maxRows, r)
+	}
+	b.WriteString("Too Many,too-many@example.com\n")
+	if r := e.Do("POST", "/v1/customers/import", e.Acme.Key, b.String()); r.Code != http.StatusRequestEntityTooLarge || r.Map(t)["error"] != "too_many_rows" {
+		t.Fatalf("%d rows: %s", maxRows+1, r)
+	}
+	if all := customersOf(t, e, e.Acme.Key); len(all) != 0 {
+		t.Fatalf("customers created by a refused import: %d", len(all))
+	}
+}
+
+// maxRows is the most records an import takes, as the API states it.
+const maxRows = 10000
+
+func TestImportCustomersRowProblems(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane Doe", "jane@example.com")
+	body := "name,email,default_payment_method\n" + // line 1
+		"Ann,ann@example.com,pm_1\n" + // 2: fine
+		",noname@example.com,\n" + // 3: missing_name
+		"Bob,not-an-email,\n" + // 4: invalid_email
+		"Cy,cy@example.com,card_1\n" + // 5: invalid_payment_method
+		"\"Jane 2\",JANE@example.com,\n" + // 6: email_taken
+		"Dee,dee@example.com,\n" + // 7: fine
+		"Dup,DEE@example.com,\n" + // 8: duplicate_email
+		"\"Multi\nline\",ann@EXAMPLE.com,\n" + // 9 (two lines): duplicate_email
+		"Eve,eve@example.com,pm_2\n" + // 11: fine
+		"Fay,dee@example.com,\n" // 12: duplicate_email
+	want := []string{"3:missing_name", "4:invalid_email", "5:invalid_payment_method", "6:email_taken", "8:duplicate_email", "9:duplicate_email", "12:duplicate_email"}
+
+	for _, dry := range []string{"", "?dry_run=true"} {
+		r := e.Do("POST", "/v1/customers/import"+dry, e.Acme.Key, body)
+		if r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_rows" {
+			t.Fatalf("dry_run%q: %s", dry, r)
+		}
+		var answer struct {
+			Rows []struct {
+				Row   int    `json:"row"`
+				Error string `json:"error"`
+			} `json:"rows"`
+		}
+		r.JSON(t, &answer)
+		var got []string
+		for _, row := range answer.Rows {
+			got = append(got, fmt.Sprintf("%d:%s", row.Row, row.Error))
+		}
+		if strings.Join(got, " ") != strings.Join(want, " ") {
+			t.Fatalf("dry_run%q: rows = %v, want %v", dry, got, want)
+		}
+	}
+	if all := customersOf(t, e, e.Acme.Key); len(all) != 1 || all[0].ID != jane.ID {
+		t.Fatalf("customers after a refused import = %+v", all)
+	}
+}
+
+func TestImportCustomersDryRun(t *testing.T) {
+	e := apitest.New(t)
+	body := "name,email\nAnn,ann@example.com\nBob,bob@example.com\n"
+	var got importAnswer
+	e.MustDo(http.StatusOK, "POST", "/v1/customers/import?dry_run=true", e.Acme.Key, body, &got)
+	if got.Created != 0 || got.WouldCreate != 2 {
+		t.Fatalf("dry run = %+v", got)
+	}
+	if all := customersOf(t, e, e.Acme.Key); len(all) != 0 {
+		t.Fatalf("a dry run created %d customers", len(all))
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers/import", e.Acme.Key, body, &got)
+	if got.Created != 2 || len(customersOf(t, e, e.Acme.Key)) != 2 {
+		t.Fatalf("import after the dry run = %+v", got)
+	}
+}
+
+func TestImportCustomersNeedsWriteAccess(t *testing.T) {
+	e := apitest.New(t)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	if r := e.Do("POST", "/v1/customers/import", viewer, "name,email\nAnn,ann@example.com\n"); r.Code != http.StatusForbidden {
+		t.Fatalf("viewer import: %s", r)
+	}
+}
