+	"errors"
+	"testing"
+	"time"
+)
+
+func TestImportCustomers(t *testing.T) {
+	s := New()
+	now := time.Date(2026, time.January, 1, 0, 0, 0, 0, time.UTC)
+	a, _ := s.CreateOrg("Acme", OrgTeam, "UTC", 0, now)
+	b, _ := s.CreateOrg("Globex", OrgTeam, "UTC", 0, now)
+	if _, err := s.CreateCustomer(a.ID, "Jane", "jane@example.com", now); err != nil {
+		t.Fatal(err)
+	}
+
+	// An address the organization already has takes the whole batch down, and nothing is created.
+	batch := []CustomerInput{{Name: "Ann", Email: "ann@example.com"}, {Name: "Jane 2", Email: "JANE@example.com"}}
+	if _, err := s.ImportCustomers(a.ID, batch, now); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("taken: %v", err)
+	}
+	if n := len(s.Customers(a.ID)); n != 1 {
+		t.Fatalf("customers after a failed import = %d", n)
+	}
+
+	// Another organization's customer does not count.
+	if _, err := s.ImportCustomers(b.ID, batch[1:], now); err != nil {
+		t.Fatalf("another organization's address: %v", err)
+	}
+
+	// Repeats within the batch do.
+	if _, err := s.ImportCustomers(b.ID, []CustomerInput{{Name: "X", Email: "x@example.com"}, {Name: "Y", Email: "X@example.com"}}, now); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("repeat: %v", err)
+	}
+
+	// A payment method that does not look like pm_... is invalid.
+	if _, err := s.ImportCustomers(b.ID, []CustomerInput{{Name: "X", Email: "x@example.com", DefaultPaymentMethod: "card"}}, now); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("payment method: %v", err)
+	}
+
+	got, err := s.ImportCustomers(a.ID, []CustomerInput{{Name: "Ann", Email: " ann@example.com ", DefaultPaymentMethod: "pm_1", Metadata: map[string]string{"crm": "7"}}}, now)
+	if err != nil || len(got) != 1 || got[0].Email != "ann@example.com" || got[0].DefaultPaymentMethod != "pm_1" || got[0].Metadata["crm"] != "7" {
+		t.Fatalf("import = %+v, %v", got, err)
+	}
+	if c, ok := s.Customer(a.ID, got[0].ID); !ok || c.Name != "Ann" {
+		t.Fatalf("stored customer = %+v %v", c, ok)
+	}
+}
