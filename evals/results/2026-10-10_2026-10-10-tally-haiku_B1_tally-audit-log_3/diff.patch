+func TestAuditRecordsWebhookDeletionOfOwnEndpointOnly(t *testing.T) {
+	e := apitest.New(t)
+	var ep struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/x", "events": []string{"*"}}, &ep)
+	if r := e.Do("DELETE", "/v1/webhook-endpoints/"+ep.ID, e.Globex.Key, nil); r.Code != http.StatusNotFound {
