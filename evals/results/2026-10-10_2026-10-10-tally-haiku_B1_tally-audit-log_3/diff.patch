+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"slices"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// auditView is an audit entry as the API shows it.
+type auditView struct {
+	ID        string                        `json:"id"`
+	Action    string                        `json:"action"`
+	Actor     store.AuditActor              `json:"actor"`
+	Target    store.AuditTarget             `json:"target"`
+	RequestID string                        `json:"request_id"`
+	At        time.Time                     `json:"at"`
+	Changes   *map[string]store.AuditChange `json:"changes,omitempty"`
+}
+
+func auditKey(e store.AuditEntry) cursor { return cursor{T: e.At, ID: e.ID} }
+
+// audit records a request that succeeded: the API key that made it, what it changed and the request's ID. Call it only on
+// the success path. changes is nil except for updates, where it is auditDiff.
+func (s *Server) audit(r *http.Request, p auth.Principal, action, targetType, targetID string, changes *map[string]store.AuditChange) {
+	s.store.AddAuditEntry(p.OrgID, store.AuditEntry{
+		Action:    action,
+		Actor:     store.AuditActor{Type: "api_key", ID: p.KeyID, UserID: p.UserID},
+		Target:    store.AuditTarget{Type: targetType, ID: targetID},
+		RequestID: RequestID(r.Context()),
+		At:        s.clock.Now().UTC(),
+		Changes:   changes,
+	})
+}
+
+// auditDiff returns the fields whose JSON values differ between before and after, keyed by JSON field name, with both
+// values. The fields named in skip are left out, so that secrets never reach the log.
+func auditDiff(before, after any, skip ...string) *map[string]store.AuditChange {
+	b, a := jsonFields(before), jsonFields(after)
+	names := map[string]bool{}
+	for name := range b {
+		names[name] = true
+	}
+	for name := range a {
+		names[name] = true
+	}
+	changes := map[string]store.AuditChange{}
+	for name := range names {
+		if slices.Contains(skip, name) || reflect.DeepEqual(b[name], a[name]) {
+			continue
+		}
+		changes[name] = store.AuditChange{From: b[name], To: a[name]}
+	}
+	return &changes
+}
+
+// jsonFields returns v as the JSON object the API would send for it.
+func jsonFields(v any) map[string]any {
+	var m map[string]any
+	b, _ := json.Marshal(v)
+	_ = json.Unmarshal(b, &m)
+	return m
+}
+
+// listAuditEvents lists the organization's audit log, newest first, optionally only the entries with ?action=, ?target_id=
+// or ?actor_id= (an API key ID or a user ID). Only owners and admins may read it.
+func (s *Server) listAuditEvents(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	if !auth.CanManageTeam(p.Role) {
+		writeJSON(w, http.StatusForbidden, map[string]string{"error": "forbidden"})
+		return
+	}
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	q := r.URL.Query()
+	es := s.store.AuditEntries(p.OrgID, store.AuditFilter{Action: q.Get("action"), TargetID: q.Get("target_id"), ActorID: q.Get("actor_id")})
+	items, next := pageOfNewest(es, auditKey, pg)
+	views := make([]auditView, 0, len(items))
+	for _, e := range items {
+		views = append(views, auditView{ID: e.ID, Action: e.Action, Actor: e.Actor, Target: e.Target, RequestID: e.RequestID, At: e.At, Changes: e.Changes})
+	}
+	writeJSON(w, http.StatusOK, list{Items: views, NextCursor: next})
+}
