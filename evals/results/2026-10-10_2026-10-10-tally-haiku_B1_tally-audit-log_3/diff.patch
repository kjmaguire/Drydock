+func TestAuditFiltersAndPaging(t *testing.T) {
+	e := apitest.New(t)
+	k := e.Acme.Key
+	var ids []string
+	for i := 0; i < 5; i++ {
+		e.Clock.Advance(time.Minute)
+		ids = append(ids, e.CreateCustomer(e.Acme, fmt.Sprintf("Customer %d", i), fmt.Sprintf("c%d@example.com", i)).ID)
+	}
+	e.Clock.Advance(time.Minute)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+ids[0], k, map[string]string{"name": "Renamed"}, nil)
+	e.Clock.Advance(time.Minute)
+	e.CreateCustomer(e.Globex, "Globex customer", "g@example.com")
+
+	// Newest first, in pages of two, and every entry exactly once.
+	first := auditLog(t, e, k, "?limit=2")
+	if len(first.Items) != 2 || first.Items[0].Action != "customer.updated" || first.Items[1].Target.ID != ids[4] || first.NextCursor == "" {
+		t.Fatalf("first page = %+v", first)
+	}
+	var all []auditEvent
+	query := "?limit=2"
+	for {
+		p := auditLog(t, e, k, query)
+		all = append(all, p.Items...)
+		if p.NextCursor == "" {
+			break
+		}
+		query = "?limit=2&cursor=" + url.QueryEscape(p.NextCursor)
+	}
+	if len(all) != 6 {
+		t.Fatalf("paging gave %d entries, want 6", len(all))
+	}
+	seen := map[string]bool{}
+	for _, ev := range all {
+		if seen[ev.ID] {
+			t.Fatalf("entry %s twice", ev.ID)
+		}
+		seen[ev.ID] = true
+	}
+
+	if got := auditLog(t, e, k, "?action=customer.created").Items; len(got) != 5 {
+		t.Errorf("action filter gave %d", len(got))
+	}
+	if got := auditLog(t, e, k, "?target_id="+ids[0]).Items; len(got) != 2 {
+		t.Errorf("target filter gave %d", len(got))
+	}
+	if got := auditLog(t, e, k, "?actor_id="+keyID(t, e, k)).Items; len(got) != 6 {
+		t.Errorf("actor filter by key gave %d", len(got))
+	}
+	if got := auditLog(t, e, k, "?actor_id="+e.Acme.Owner.ID).Items; len(got) != 6 {
+		t.Errorf("actor filter by user gave %d", len(got))
+	}
+	if got := auditLog(t, e, k, "?actor_id=key_nobody").Items; len(got) != 0 {
+		t.Errorf("unknown actor gave %d", len(got))
+	}
+	// Another organization's changes are not in this log.
+	if got := auditLog(t, e, e.Globex.Key, "").Items; len(got) != 1 || got[0].Target.Type != "customer" {
+		t.Errorf("globex log = %+v", got)
+	}
+	if r := e.Do("GET", "/v1/audit-events?limit=0", k, nil); r.Code != http.StatusBadRequest {
+		t.Errorf("bad limit: %s", r)
+	}
+}
