+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// auditEvent is an entry of the audit log as the API answers it.
+type auditEvent struct {
+	ID     string `json:"id"`
+	Action string `json:"action"`
+	Actor  struct {
+		Type   string `json:"type"`
+		ID     string `json:"id"`
+		UserID string `json:"user_id"`
+	} `json:"actor"`
+	Target struct {
+		Type string `json:"type"`
+		ID   string `json:"id"`
+	} `json:"target"`
+	RequestID string                     `json:"request_id"`
+	At        time.Time                  `json:"at"`
+	Changes   *map[string]map[string]any `json:"changes"`
+}
+
+type auditPage struct {
+	Items      []auditEvent `json:"items"`
+	NextCursor string       `json:"next_cursor"`
+}
+
+// auditLog reads the audit log of the caller's organization; query is "" or starts with "?".
+func auditLog(t *testing.T, e *apitest.Env, key, query string) auditPage {
+	t.Helper()
+	var page auditPage
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events"+query, key, nil, &page)
+	return page
+}
+
+// keyID is the ID of the API key the caller presents.
+func keyID(t *testing.T, e *apitest.Env, key string) string {
+	t.Helper()
+	var me struct {
+		APIKeyID string `json:"api_key_id"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", key, nil, &me)
+	return me.APIKeyID
+}
+
+// newest returns the newest entry of the action, failing the test when there is none.
+func newest(t *testing.T, page auditPage, action string) auditEvent {
+	t.Helper()
+	for _, ev := range page.Items {
+		if ev.Action == action {
+			return ev
+		}
+	}
+	t.Fatalf("no %s entry in %+v", action, page.Items)
+	return auditEvent{}
+}
+
+func createInvoice(t *testing.T, e *apitest.Env, key, customerID string) string {
+	t.Helper()
+	var inv struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{
+		"customer_id": customerID, "currency": "USD", "lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 500}},
+	}, &inv)
+	return inv.ID
+}
+
+func TestAuditRecordsEveryKindOfChange(t *testing.T) {
+	e := apitest.New(t)
+	k := e.Acme.Key
+	self := keyID(t, e, k)
+	e.Clock.Advance(time.Minute)
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", k, map[string]any{"name": "Acme Inc"}, nil)
+	plan := e.CreatePlan(e.Acme, "Pro", "USD", "10.00")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/plans/"+plan.ID, k, map[string]any{"name": "Pro Plus"}, nil)
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+jane.ID, k, map[string]any{"name": "Jane Doe"}, nil)
+	ann := e.CreateCustomer(e.Acme, "Ann", "ann@example.com")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+ann.ID, k, nil, nil)
+
+	var sub struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", k, map[string]any{"customer_id": jane.ID, "plan_id": plan.ID}, &sub)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, k, map[string]any{"quantity": 3}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", k, map[string]any{"at_period_end": true}, nil)
+
+	paid := createInvoice(t, e, k, jane.ID)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+paid+"/pay", k, map[string]string{"payment_method": "pm_card_visa"}, nil)
+	voided := createInvoice(t, e, k, jane.ID)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+voided+"/void", k, nil, nil)
+
+	var ck struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", k, map[string]string{"name": "CI"}, &ck)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+ck.ID, k, nil, nil)
+
+	var inv struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", k, map[string]string{"email": "new@acme.example", "role": "member"}, &inv)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+inv.ID, k, nil, nil)
+
+	ben, _ := e.AddMember(e.Acme, "ben@acme.example", store.RoleMember)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+ben.ID, k, map[string]string{"role": "billing"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+ben.ID, k, nil, nil)
+
+	var ep struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", k, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"customer.created"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, k, map[string]any{"enabled": false}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+ep.ID, k, nil, nil)
+
+	page := auditLog(t, e, k, "?limit=100")
+	seen := map[string]bool{}
+	for _, ev := range page.Items {
+		seen[ev.Action] = true
+	}
+	for _, action := range []string{
+		"customer.created", "customer.updated", "customer.deleted", "plan.created", "plan.updated",
+		"subscription.created", "subscription.updated", "subscription.canceled", "invoice.created", "invoice.paid",
+		"invoice.voided", "api_key.created", "api_key.revoked", "member.role_changed", "member.removed", "invite.created",
+		"invite.revoked", "webhook_endpoint.created", "webhook_endpoint.updated", "webhook_endpoint.deleted", "org.updated",
+	} {
+		if !seen[action] {
+			t.Errorf("no %s entry", action)
+		}
+		delete(seen, action)
+	}
+	if len(seen) != 0 {
+		t.Errorf("unexpected actions %v", seen)
+	}
+
+	// Who and when: the calling key, the member it acts for, the request, the service's clock.
+	ev := newest(t, page, "org.updated")
+	if ev.Actor.Type != "api_key" || ev.Actor.ID != self || ev.Actor.UserID != e.Acme.Owner.ID {
+		t.Errorf("actor = %+v", ev.Actor)
+	}
+	if ev.Target.Type != "org" || ev.Target.ID != e.Acme.ID {
+		t.Errorf("target = %+v", ev.Target)
+	}
+	if !ev.At.Equal(e.Clock.Now()) || !strings.HasPrefix(ev.RequestID, "req_") {
+		t.Errorf("at = %v, request_id = %q", ev.At, ev.RequestID)
+	}
+
+	// Changes hold exactly the fields that changed, with their old and new values.
+	if ch := *ev.Changes; len(ch) != 1 || ch["name"]["from"] != "Acme" || ch["name"]["to"] != "Acme Inc" {
+		t.Errorf("org changes = %v", ch)
+	}
+	if ch := *newest(t, page, "plan.updated").Changes; len(ch) != 1 || ch["name"]["from"] != "Pro" || ch["name"]["to"] != "Pro Plus" {
+		t.Errorf("plan changes = %v", ch)
+	}
+	if ch := *newest(t, page, "customer.updated").Changes; len(ch) != 1 || ch["name"]["from"] != "Jane" || ch["name"]["to"] != "Jane Doe" {
+		t.Errorf("customer changes = %v", ch)
+	}
+	if ch := *newest(t, page, "subscription.updated").Changes; len(ch) != 1 || ch["quantity"]["from"] != float64(1) || ch["quantity"]["to"] != float64(3) {
+		t.Errorf("subscription changes = %v", ch)
+	}
+	if ev := newest(t, page, "member.role_changed"); ev.Target.ID != ben.ID || len(*ev.Changes) != 1 || (*ev.Changes)["role"]["from"] != "member" || (*ev.Changes)["role"]["to"] != "billing" {
+		t.Errorf("role change = %+v", ev)
+	}
+	if ch := *newest(t, page, "webhook_endpoint.updated").Changes; len(ch) != 1 || ch["enabled"]["from"] != true || ch["enabled"]["to"] != false {
+		t.Errorf("endpoint changes = %v", ch)
+	}
+
+	// Creations, deletions and actions have no changes field at all.
+	if ev := newest(t, page, "plan.created"); ev.Changes != nil {
+		t.Errorf("plan.created has changes %v", *ev.Changes)
+	}
+	if ev := newest(t, page, "member.removed"); ev.Changes != nil {
+		t.Errorf("member.removed has changes %v", *ev.Changes)
+	}
+}
+
+func TestAuditUpdateWithoutChangesHasEmptyChanges(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+jane.ID, e.Acme.Key, map[string]any{"name": "Jane"}, nil)
+	ev := newest(t, auditLog(t, e, e.Acme.Key, ""), "customer.updated")
+	if ev.Changes == nil || len(*ev.Changes) != 0 {
+		t.Fatalf("a no-op update should have an empty changes object, got %v", ev.Changes)
+	}
+}
+
+func TestAuditRecordsNothingForFailedRequests(t *testing.T) {
+	e := apitest.New(t)
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	memberUser, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	var globexEP struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Globex.Key, map[string]any{"url": "https://hooks.globex.example/tally", "events": []string{"*"}}, &globexEP)
+
+	before := len(auditLog(t, e, e.Acme.Key, "").Items)
+	failing := map[string]*apitest.Response{
+		"duplicate customer":        e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane 2", "email": "JANE@example.com"}),
+		"invalid JSON":              e.Do("PATCH", "/v1/customers/"+jane.ID, e.Acme.Key, "{not json"),
+		"viewer writes":             e.Do("PATCH", "/v1/customers/"+jane.ID, viewer, map[string]string{"name": "X"}),
+		"member changes role":       e.Do("PATCH", "/v1/members/"+memberUser.ID, memberKey, map[string]string{"role": "admin"}),
+		"another org's customer":    e.Do("PATCH", "/v1/customers/"+jane.ID, e.Globex.Key, map[string]string{"name": "X"}),
+		"invalid plan price":        e.Do("POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "Bad", "currency": "USD", "price": "ten", "interval": "month"}),
+		"another org's endpoint":    e.Do("DELETE", "/v1/webhook-endpoints/"+globexEP.ID, e.Acme.Key, nil),
+		"invoice without any lines": e.Do("POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": jane.ID, "currency": "USD", "lines": []any{}}),
+	}
+	for name, r := range failing {
+		if r.Code < 400 {
+			t.Errorf("%s: want an error, got %s", name, r)
+		}
+	}
+	if after := len(auditLog(t, e, e.Acme.Key, "").Items); after != before {
+		t.Fatalf("failed requests recorded %d entries", after-before)
+	}
+	// The other organization's endpoint is still there, and the failed delete did not touch it.
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+globexEP.ID, e.Globex.Key, nil, nil)
+}
+
+func TestAuditNeverHoldsSecrets(t *testing.T) {
+	e := apitest.New(t)
+	k := e.Acme.Key
+	var key struct {
+		Token string `json:"token"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", k, map[string]string{"name": "CI"}, &key)
+	var ep struct {
+		ID     string `json:"id"`
+		Secret string `json:"secret"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", k, map[string]any{"url": "https://hooks.acme.example/a", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, k, map[string]any{"url": "https://hooks.acme.example/b"}, nil)
+	var inv struct {
+		Token string `json:"token"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", k, map[string]string{"email": "new@acme.example", "role": "member"}, &inv)
+
+	body := string(e.Do("GET", "/v1/audit-events?limit=100", k, nil).Body)
+	for _, secret := range []string{key.Token, ep.Secret, inv.Token} {
+		if secret == "" || strings.Contains(body, secret) {
+			t.Fatalf("the audit log holds a secret (%q)", secret)
+		}
+	}
+	if !strings.Contains(body, "webhook_endpoint.updated") {
+		t.Fatal("the update was not recorded")
+	}
+}
