 // pageOf returns one page of items, which are sorted by key (creation time, then ID), and the cursor of the next page.
 func pageOf[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	return pageIn(items, key, p, func(k, after cursor) bool { return after.less(k) })
+}
+
+// pageOfNewest is pageOf for items sorted newest first.
+func pageOfNewest[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	return pageIn(items, key, p, func(k, after cursor) bool { return k.less(after) })
+}
+
+// pageIn is the paging of pageOf and pageOfNewest: past reports whether an item with key k comes after the cursor.
+func pageIn[T any](items []T, key func(T) cursor, p page, past func(k, after cursor) bool) ([]T, string) {
 	start := 0
 	if p.after != nil {
 		start = len(items)
 		for i, it := range items {
-			if p.after.less(key(it)) {
+			if past(key(it), *p.after) {
 				start = i
 				break
 			}
