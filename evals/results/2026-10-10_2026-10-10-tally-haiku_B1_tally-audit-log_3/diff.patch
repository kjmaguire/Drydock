diff --git a/result/internal/store/audit.go b/result/internal/store/audit.go
new file mode 100644
index 0000000..7a4dc4e
--- /dev/null
+++ b/result/internal/store/audit.go
@@ -0,0 +1,77 @@
+package store
+
+import (
+	"fmt"
+	"sort"
+	"time"
+)
+
+// AuditActor is who made a change: an API key, and the member it acts for.
+type AuditActor struct {
+	Type   string `json:"type"` // "api_key"
+	ID     string `json:"id"`
+	UserID string `json:"user_id"`
+}
+
+// AuditTarget is the object a change was made to.
+type AuditTarget struct {
+	Type string `json:"type"`
+	ID   string `json:"id"`
+}
+
+// AuditChange is one field's value before and after a change.
+type AuditChange struct {
+	From any `json:"from"`
+	To   any `json:"to"`
+}
+
+// AuditEntry records one successful change made through the API. Entries are never changed or deleted.
+type AuditEntry struct {
+	ID        string      `json:"id"`
+	OrgID     string      `json:"org_id"`
+	Action    string      `json:"action"`
+	Actor     AuditActor  `json:"actor"`
+	Target    AuditTarget `json:"target"`
+	RequestID string      `json:"request_id"`
+	At        time.Time   `json:"at"`
+	// Changes is set on entries of updates, where it is present even when empty; nil leaves it out.
+	Changes *map[string]AuditChange `json:"changes,omitempty"`
+}
+
+// AuditFilter narrows AuditEntries. An empty field matches everything. ActorID matches a key ID or a user ID.
+type AuditFilter struct {
+	Action   string
+	TargetID string
+	ActorID  string
+}
+
+// AddAuditEntry appends an entry to the log of orgID and returns it with its ID.
+func (s *Store) AddAuditEntry(orgID string, e AuditEntry) AuditEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e.ID = fmt.Sprintf("aud_%06d", len(s.audit)+1) // entries are never deleted, so the count is the last number
+	e.OrgID = orgID
+	s.audit = append(s.audit, e)
+	return e
+}
+
+// AuditEntries returns an organization's audit entries that match f, newest first.
+func (s *Store) AuditEntries(orgID string, f AuditFilter) []AuditEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []AuditEntry{}
+	for _, e := range s.audit {
+		if e.OrgID != orgID || (f.Action != "" && e.Action != f.Action) || (f.TargetID != "" && e.Target.ID != f.TargetID) ||
+			(f.ActorID != "" && e.Actor.ID != f.ActorID && e.Actor.UserID != f.ActorID) {
+			continue
+		}
+		out = append(out, e)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].At.Equal(out[j].At) {
+			return out[i].At.After(out[j].At)
+		}
+		return out[i].ID > out[j].ID
+	})
+	return out
+}
diff --git a/result/internal/store/audit_test.go b/result/internal/store/audit_test.go
new file mode 100644
index 0000000..415204a
--- /dev/null
+++ b/result/internal/store/audit_test.go
@@ -0,0 +1,62 @@
+package store
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+)
+
+func TestAuditLogSurvivesExport(t *testing.T) {
+	now := time.Date(2026, time.March, 1, 12, 0, 0, 0, time.UTC)
+	st := New()
+	o, err := st.CreateOrg("Acme", OrgTeam, "UTC", 0, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	actor := AuditActor{Type: "api_key", ID: "key_000001", UserID: "usr_000002"}
+	renamed := map[string]AuditChange{"name": {From: "Acme", To: "Acme Inc"}}
+	st.AddAuditEntry(o.ID, AuditEntry{Action: "org.updated", Actor: actor, Target: AuditTarget{Type: "org", ID: o.ID}, RequestID: "req_1", At: now, Changes: &renamed})
+	st.AddAuditEntry(o.ID, AuditEntry{Action: "org.updated", Actor: actor, Target: AuditTarget{Type: "org", ID: o.ID}, RequestID: "req_2", At: now.Add(time.Minute), Changes: &map[string]AuditChange{}})
+
+	// Through JSON, as the snapshot file does it.
+	b, err := json.Marshal(st.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var state State
+	if err := json.Unmarshal(b, &state); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := FromState(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := loaded.AuditEntries(o.ID, AuditFilter{})
+	if len(got) != 2 || got[0].RequestID != "req_2" || got[1].RequestID != "req_1" {
+		t.Fatalf("entries = %+v", got)
+	}
+	if got[0].Changes == nil || len(*got[0].Changes) != 0 {
+		t.Errorf("the empty changes of an update were lost: %v", got[0].Changes)
+	}
+	if c := (*got[1].Changes)["name"]; c.From != "Acme" || c.To != "Acme Inc" {
+		t.Errorf("changes = %+v", c)
+	}
+	// IDs continue from the loaded log.
+	if e := loaded.AddAuditEntry(o.ID, AuditEntry{Action: "org.updated", At: now}); e.ID != "aud_000003" {
+		t.Errorf("next ID = %s", e.ID)
+	}
+}
+
+func TestAuditEntriesAreScopedToTheirOrganization(t *testing.T) {
+	now := time.Date(2026, time.March, 1, 12, 0, 0, 0, time.UTC)
+	st := New()
+	a, _ := st.CreateOrg("Acme", OrgTeam, "UTC", 0, now)
+	g, _ := st.CreateOrg("Globex", OrgTeam, "UTC", 0, now)
+	st.AddAuditEntry(a.ID, AuditEntry{Action: "plan.created", Target: AuditTarget{Type: "plan", ID: "plan_1"}, At: now})
+	if got := st.AuditEntries(g.ID, AuditFilter{}); len(got) != 0 {
+		t.Fatalf("another organization sees %+v", got)
+	}
+	if got := st.AuditEntries(a.ID, AuditFilter{Action: "plan.updated"}); len(got) != 0 {
+		t.Fatalf("action filter matched %+v", got)
+	}
+}
