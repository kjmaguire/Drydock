+package api_test
+
+import (
+	"net/http"
+	"net/url"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// auditLog returns the audit log that key sees for query, newest first.
+func auditLog(t *testing.T, e *apitest.Env, key, query string) []store.AuditEntry {
+	t.Helper()
+	var page struct {
+		Items []store.AuditEntry `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events"+query, key, nil, &page)
+	return page.Items
+}
+
+func actionsOf(entries []store.AuditEntry) []string {
+	out := []string{}
+	for _, en := range entries {
+		out = append(out, en.Action)
+	}
+	return out
+}
+
+// change returns the old and new value of one field in an entry's changes.
+func change(t *testing.T, en store.AuditEntry, field string) (any, any) {
+	t.Helper()
+	c, ok := en.Changes[field]
+	if !ok {
+		t.Fatalf("%s: %s did not change: %+v", en.Action, field, en.Changes)
+	}
+	return c.From, c.To
+}
+
+func TestAuditLogRecordsSuccessfulWrites(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	keyRec, _ := e.Store.APIKeyByToken(key)
+
+	r := e.DoWith("POST", "/v1/customers", key, map[string]string{"name": "Jane Doe", "email": "jane@example.com"}, http.Header{"X-Request-Id": {"audit-req-1"}})
+	if r.Code != http.StatusCreated {
+		t.Fatalf("create customer: %s", r)
+	}
+	var c store.Customer
+	r.JSON(t, &c)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, key, map[string]string{"name": "Jane Q. Doe"}, &c)
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/plans/"+p.ID, key, map[string]string{"name": "Team Plus"}, nil)
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", key, map[string]string{"customer_id": c.ID, "plan_id": p.ID}, &sub)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, key, map[string]int{"quantity": 5}, &sub)
+	lines := []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 1000}}
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD", "lines": lines}, &inv)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+inv.ID+"/pay", key, map[string]string{"payment_method": "pm_card_visa"}, nil)
+	var voided store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD", "lines": lines}, &voided)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+voided.ID+"/void", key, nil, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", key, nil, nil)
+	var k store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", key, map[string]string{"name": "CI"}, &k)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+k.ID, key, nil, nil)
+	var invite store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "new@people.example", "role": "member"}, &invite)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+invite.ID, key, nil, nil)
+	member, _ := e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, key, map[string]string{"role": "admin"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+member.ID, key, nil, nil)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, key, map[string]bool{"enabled": false}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+ep.ID, key, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]int{"tax_rate_bp": 2000}, nil)
+	// A change that changes nothing is still a successful update, with no changes.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]int{"tax_rate_bp": 2000}, nil)
+
+	// Created subscriptions and their first invoice are not requests of the audited kinds, so they are not logged.
+	want := []string{"customer.created", "customer.updated", "plan.created", "plan.updated", "subscription.created", "subscription.updated",
+		"invoice.created", "invoice.paid", "invoice.created", "invoice.voided", "subscription.canceled", "api_key.created", "api_key.revoked",
+		"invite.created", "invite.revoked", "member.role_changed", "member.removed", "webhook_endpoint.created", "webhook_endpoint.updated",
+		"webhook_endpoint.deleted", "org.updated", "org.updated"}
+	slices.Reverse(want)
+	got := auditLog(t, e, key, "?limit=100")
+	if !slices.Equal(actionsOf(got), want) {
+		t.Fatalf("actions = %v\nwant %v", actionsOf(got), want)
+	}
+	byAction := func(action string) store.AuditEntry {
+		t.Helper()
+		for _, en := range got {
+			if en.Action == action {
+				return en
+			}
+		}
+		t.Fatalf("no %s entry", action)
+		return store.AuditEntry{}
+	}
+
+	created := byAction("customer.created")
+	if created.RequestID != "audit-req-1" || created.Actor != (store.AuditActor{Type: "api_key", ID: keyRec.ID, UserID: e.Acme.Owner.ID}) ||
+		created.Target != (store.AuditTarget{Type: "customer", ID: c.ID}) || created.Changes != nil || !created.At.Equal(apitest.Start) {
+		t.Fatalf("customer.created = %+v", created)
+	}
+	if from, to := change(t, byAction("customer.updated"), "name"); from != "Jane Doe" || to != "Jane Q. Doe" || len(byAction("customer.updated").Changes) != 1 {
+		t.Fatalf("customer.updated changes = %+v", byAction("customer.updated").Changes)
+	}
+	if from, to := change(t, byAction("plan.updated"), "name"); from != "Team" || to != "Team Plus" || len(byAction("plan.updated").Changes) != 1 {
+		t.Fatalf("plan.updated changes = %+v", byAction("plan.updated").Changes)
+	}
+	if from, to := change(t, byAction("subscription.updated"), "quantity"); from != float64(1) || to != float64(5) || len(byAction("subscription.updated").Changes) != 1 {
+		t.Fatalf("subscription.updated changes = %+v", byAction("subscription.updated").Changes)
+	}
+	if got := byAction("invoice.paid").Target; got != (store.AuditTarget{Type: "invoice", ID: inv.ID}) {
+		t.Fatalf("invoice.paid target = %+v", got)
+	}
+	if got := byAction("api_key.revoked").Target; got != (store.AuditTarget{Type: "api_key", ID: k.ID}) {
+		t.Fatalf("api_key.revoked target = %+v", got)
+	}
+	if got := byAction("invite.created").Target; got != (store.AuditTarget{Type: "invite", ID: invite.ID}) {
+		t.Fatalf("invite.created target = %+v", got)
+	}
+	if got := byAction("member.removed").Target; got != (store.AuditTarget{Type: "member", ID: member.ID}) {
+		t.Fatalf("member.removed target = %+v", got)
+	}
+	if from, to := change(t, byAction("member.role_changed"), "role"); from != "member" || to != "admin" || len(byAction("member.role_changed").Changes) != 1 {
+		t.Fatalf("member.role_changed changes = %+v", byAction("member.role_changed").Changes)
+	}
+	if from, to := change(t, byAction("webhook_endpoint.updated"), "enabled"); from != true || to != false || len(byAction("webhook_endpoint.updated").Changes) != 1 {
+		t.Fatalf("webhook_endpoint.updated changes = %+v", byAction("webhook_endpoint.updated").Changes)
+	}
+	if got := byAction("webhook_endpoint.deleted").Target; got != (store.AuditTarget{Type: "webhook_endpoint", ID: ep.ID}) {
+		t.Fatalf("webhook_endpoint.deleted target = %+v", got)
+	}
+	if from, to := change(t, got[1], "tax_rate_bp"); from != float64(0) || to != float64(2000) {
+		t.Fatalf("org.updated changes = %+v", got[1].Changes)
+	}
+	if got[0].Changes == nil || len(got[0].Changes) != 0 {
+		t.Fatalf("the no-op org.updated has changes %+v", got[0].Changes)
+	}
+	if raw := e.Do("GET", "/v1/audit-events?limit=100", key, nil).Body; !strings.Contains(string(raw), `"changes":{}`) {
+		t.Fatalf("a no-op update has no empty changes in %s", raw)
+	}
+
+	// The log never holds a secret: not an API key's token, a webhook endpoint's secret or an invite's token.
+	raw := string(e.Do("GET", "/v1/audit-events?limit=100", key, nil).Body)
+	for _, secret := range []string{e.Acme.Key, k.Token, ep.Secret, invite.Token} {
+		if secret == "" || strings.Contains(raw, secret) {
+			t.Fatalf("the audit log holds a secret (%q)", secret)
+		}
+	}
+}
+
+func TestAuditLogRecordsNothingForFailedRequests(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]string{"customer_id": c.ID, "plan_id": p.ID}, &sub)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", e.Acme.Key, nil, nil)
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 1000}}}, &inv)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	var other store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Globex.Key, map[string]any{"url": "https://hooks.globex.example/tally", "events": []string{"*"}}, &other)
+	globexKey, _ := e.Store.APIKeyByToken(e.Globex.Key)
+
+	before := len(auditLog(t, e, e.Acme.Key, "?limit=100"))
+	for _, tc := range []struct {
+		name, method, path, key string
+		body                    any
+		want                    int
+	}{
+		{"blank name", "POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "", "email": "x@example.com"}, http.StatusUnprocessableEntity},
+		{"unknown customer", "PATCH", "/v1/customers/cus_nope", e.Acme.Key, map[string]string{"name": "X"}, http.StatusNotFound},
+		{"a viewer writes", "POST", "/v1/customers", viewer, map[string]string{"name": "V", "email": "v@example.com"}, http.StatusForbidden},
+		{"canceled subscription", "PATCH", "/v1/subscriptions/" + sub.ID, e.Acme.Key, map[string]int{"quantity": 2}, http.StatusConflict},
+		{"declined charge", "POST", "/v1/invoices/" + inv.ID + "/pay", e.Acme.Key, map[string]string{"payment_method": "pm_card_declined"}, http.StatusPaymentRequired},
+		{"another org's endpoint", "DELETE", "/v1/webhook-endpoints/" + other.ID, e.Acme.Key, nil, http.StatusNotFound},
+		{"another org's key", "DELETE", "/v1/api-keys/" + globexKey.ID, e.Acme.Key, nil, http.StatusNotFound},
+		{"no key", "POST", "/v1/customers", "", map[string]string{"name": "N", "email": "n@example.com"}, http.StatusUnauthorized},
+	} {
+		if r := e.Do(tc.method, tc.path, tc.key, tc.body); r.Code != tc.want {
+			t.Fatalf("%s: %s", tc.name, r)
+		}
+	}
+	if after := len(auditLog(t, e, e.Acme.Key, "?limit=100")); after != before {
+		t.Fatalf("failed requests added %d entries", after-before)
+	}
+}
