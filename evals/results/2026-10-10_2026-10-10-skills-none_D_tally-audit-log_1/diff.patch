+func TestAuditLogFiltersAndPaging(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	john := e.CreateCustomer(e.Acme, "John", "john@example.com")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+jane.ID, key, map[string]string{"name": "Jane Q"}, nil)
+	keyRec, _ := e.Store.APIKeyByToken(key)
+
+	all := auditLog(t, e, key, "?limit=100")
+	if len(all) != 3 {
+		t.Fatalf("entries = %v", actionsOf(all))
+	}
+	created := auditLog(t, e, key, "?action=customer.created")
+	if len(created) != 2 || created[0].Target.ID != john.ID || created[1].Target.ID != jane.ID {
+		t.Fatalf("by action = %+v", created)
+	}
+	ofJane := auditLog(t, e, key, "?target_id="+jane.ID)
+	if !slices.Equal(actionsOf(ofJane), []string{"customer.updated", "customer.created"}) {
+		t.Fatalf("by target = %v", actionsOf(ofJane))
+	}
+	if n := len(auditLog(t, e, key, "?action=customer.updated&target_id="+jane.ID)); n != 1 {
+		t.Fatalf("by action and target: %d entries", n)
+	}
+	if n := len(auditLog(t, e, key, "?actor_id="+keyRec.ID)); n != 3 {
+		t.Fatalf("by API key: %d entries", n)
+	}
+	if n := len(auditLog(t, e, key, "?actor_id="+e.Acme.Owner.ID)); n != 3 {
+		t.Fatalf("by user: %d entries", n)
+	}
+	if n := len(auditLog(t, e, key, "?actor_id="+e.Globex.Owner.ID)); n != 0 {
+		t.Fatalf("another user's entries: %d", n)
+	}
+
+	// Pages of two, newest first, cover the whole log once.
+	var ids []string
+	query := "?limit=2"
+	for {
+		// A fresh page each time: a decode would keep the previous page's cursor when this one has none.
+		var page struct {
+			Items      []store.AuditEntry `json:"items"`
+			NextCursor string             `json:"next_cursor"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/audit-events"+query, key, nil, &page)
+		for _, en := range page.Items {
+			ids = append(ids, en.ID)
+		}
+		if page.NextCursor == "" {
+			break
+		}
+		query = "?limit=2&cursor=" + url.QueryEscape(page.NextCursor)
+	}
+	var allIDs []string
+	for _, en := range all {
+		allIDs = append(allIDs, en.ID)
+	}
+	if !slices.Equal(ids, allIDs) {
+		t.Fatalf("paged ids = %v, want %v", ids, allIDs)
+	}
+	for _, q := range []string{"?limit=0", "?cursor=%21%21"} {
+		if r := e.Do("GET", "/v1/audit-events"+q, key, nil); r.Code != http.StatusBadRequest {
+			t.Fatalf("%s: %s", q, r)
+		}
+	}
+}
