+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// unloggedFields are the JSON fields that hold secrets. They never appear in the audit log, not even as changes.
+var unloggedFields = map[string]bool{"secret": true, "token": true}
+
+// audit records a change that a successful request made. changes is nil for changes that are not updates.
+func (s *Server) audit(r *http.Request, p auth.Principal, action, targetType, targetID string, changes map[string]store.AuditChange) {
+	s.store.AddAuditEntry(p.OrgID, store.AuditEntry{
+		Action:    action,
+		Actor:     store.AuditActor{Type: "api_key", ID: p.KeyID, UserID: p.UserID},
+		Target:    store.AuditTarget{Type: targetType, ID: targetID},
+		RequestID: RequestID(r.Context()),
+		At:        s.clock.Now().UTC(),
+		Changes:   changes,
+	})
+}
+
+// auditChanges returns the fields whose JSON values differ between before and after, with both values. It is never nil.
+func auditChanges(before, after any) map[string]store.AuditChange {
+	b, a := jsonFields(before), jsonFields(after)
+	out := map[string]store.AuditChange{}
+	for k := range b {
+		if !unloggedFields[k] && !reflect.DeepEqual(b[k], a[k]) {
+			out[k] = store.AuditChange{From: b[k], To: a[k]}
+		}
+	}
+	for k := range a {
+		if _, ok := b[k]; !ok && !unloggedFields[k] && a[k] != nil {
+			out[k] = store.AuditChange{From: nil, To: a[k]}
+		}
+	}
+	return out
+}
+
+// jsonFields is v as its JSON fields, by their JSON names.
+func jsonFields(v any) map[string]any {
+	b, _ := json.Marshal(v)
+	var m map[string]any
+	_ = json.Unmarshal(b, &m)
+	return m
+}
+
+// listAuditEvents lists the organization's audit log, newest first, optionally only the entries of ?action=, ?target_id=
+// or ?actor_id= (an API key ID or a user ID). Only owners and admins may read it.
+func (s *Server) listAuditEvents(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	if !auth.CanManageTeam(p.Role) {
+		writeJSON(w, http.StatusForbidden, map[string]string{"error": "forbidden"})
+		return
+	}
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	q := r.URL.Query()
+	entries := s.store.AuditEntries(p.OrgID, store.AuditFilter{Action: q.Get("action"), TargetID: q.Get("target_id"), ActorID: q.Get("actor_id")})
+	items, next := auditPage(entries, pg)
+	writeJSON(w, http.StatusOK, list{Items: items, NextCursor: next})
+}
+
+// auditPage returns one page of entries, which are newest first, and the cursor of the next page. A cursor is the last entry
+// of the previous page.
+func auditPage(entries []store.AuditEntry, p page) ([]store.AuditEntry, string) {
+	start := 0
+	if p.after != nil {
+		start = len(entries)
+		for i, e := range entries {
+			if e.ID == p.after.ID {
+				start = i + 1
+				break
+			}
+		}
+	}
+	end := min(start+p.limit, len(entries))
+	out := entries[start:end]
+	next := ""
+	if end < len(entries) && len(out) > 0 {
+		last := out[len(out)-1]
+		next = encodeCursor(cursor{T: last.At, ID: last.ID})
+	}
+	return out, next
+}
