diff --git a/result/internal/store/audit.go b/result/internal/store/audit.go
new file mode 100644
index 0000000..330555a
--- /dev/null
+++ b/result/internal/store/audit.go
@@ -0,0 +1,75 @@
+package store
+
+import "time"
+
+// AuditEntry is one entry of an organization's audit log: a change that a successful API request made. Entries are only
+// ever added, never changed or removed.
+type AuditEntry struct {
+	ID        string      `json:"id"`
+	Action    string      `json:"action"`
+	Actor     AuditActor  `json:"actor"`
+	Target    AuditTarget `json:"target"`
+	RequestID string      `json:"request_id"`
+	At        time.Time   `json:"at"`
+	// Changes maps the JSON name of each field an update changed to its old and new values. Updates always have it, possibly
+	// empty; other entries do not.
+	Changes map[string]AuditChange `json:"changes,omitzero"`
+}
+
+// AuditActor is who made a change: an API key, and the member the key acts for.
+type AuditActor struct {
+	Type   string `json:"type"` // "api_key"
+	ID     string `json:"id"`
+	UserID string `json:"user_id"`
+}
+
+// AuditTarget is the object a change was made to.
+type AuditTarget struct {
+	Type string `json:"type"`
+	ID   string `json:"id"`
+}
+
+// AuditChange is one field's value before and after an update.
+type AuditChange struct {
+	From any `json:"from"`
+	To   any `json:"to"`
+}
+
+// AuditRecord is an audit entry with the organization it belongs to, as the store keeps it.
+type AuditRecord struct {
+	OrgID string     `json:"org_id"`
+	Entry AuditEntry `json:"entry"`
+}
+
+// AuditFilter narrows AuditEntries. An empty field matches everything. ActorID matches an API key ID or a user ID.
+type AuditFilter struct {
+	Action   string
+	TargetID string
+	ActorID  string
+}
+
+// AddAuditEntry appends an entry to an organization's audit log and returns it with its ID.
+func (s *Store) AddAuditEntry(orgID string, e AuditEntry) AuditEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e.ID = s.newID("aud")
+	s.audit = append(s.audit, AuditRecord{OrgID: orgID, Entry: e})
+	return e
+}
+
+// AuditEntries returns an organization's audit entries that match f, newest first.
+func (s *Store) AuditEntries(orgID string, f AuditFilter) []AuditEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []AuditEntry{}
+	for i := len(s.audit) - 1; i >= 0; i-- {
+		r := s.audit[i]
+		e := r.Entry
+		if r.OrgID != orgID || (f.Action != "" && e.Action != f.Action) || (f.TargetID != "" && e.Target.ID != f.TargetID) ||
+			(f.ActorID != "" && e.Actor.ID != f.ActorID && e.Actor.UserID != f.ActorID) {
+			continue
+		}
+		out = append(out, e)
+	}
+	return out
+}
diff --git a/result/internal/store/audit_test.go b/result/internal/store/audit_test.go
new file mode 100644
index 0000000..f2d03ea
--- /dev/null
+++ b/result/internal/store/audit_test.go
@@ -0,0 +1,47 @@
+package store_test
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/store"
+)
+
+func TestAuditLogSurvivesSaveAndLoad(t *testing.T) {
+	now := time.Date(2026, time.March, 1, 9, 0, 0, 0, time.UTC)
+	s := store.New()
+	org, err := s.CreateOrg("Acme", store.OrgTeam, "UTC", 0, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	added := s.AddAuditEntry(org.ID, store.AuditEntry{
+		Action:    "org.updated",
+		Actor:     store.AuditActor{Type: "api_key", ID: "key_000001", UserID: "usr_000001"},
+		Target:    store.AuditTarget{Type: "org", ID: org.ID},
+		RequestID: "req_1",
+		At:        now,
+		Changes:   map[string]store.AuditChange{"name": {From: "Acme", To: "Acme Inc"}},
+	})
+
+	b, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var st store.State
+	if err := json.Unmarshal(b, &st); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := store.FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := restored.AuditEntries(org.ID, store.AuditFilter{})
+	if len(got) != 1 || !reflect.DeepEqual(got[0], added) {
+		t.Fatalf("restored = %+v, want %+v", got, added)
+	}
+	if other := restored.AuditEntries("org_other", store.AuditFilter{}); len(other) != 0 {
+		t.Fatalf("another organization sees %d entries", len(other))
+	}
+}
