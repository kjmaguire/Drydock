+func TestAuditLogIsForOwnersAndAdmins(t *testing.T) {
+	e := apitest.New(t)
+	_, admin := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	_, billing := e.AddMember(e.Acme, "billing@acme.example", store.RoleBilling)
+	_, member := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	for _, key := range []string{e.Acme.Key, admin} {
+		if r := e.Do("GET", "/v1/audit-events", key, nil); r.Code != http.StatusOK {
+			t.Fatalf("owner or admin: %s", r)
+		}
+	}
+	for _, key := range []string{billing, member, viewer} {
+		r := e.Do("GET", "/v1/audit-events", key, nil)
+		if r.Code != http.StatusForbidden || !reflect.DeepEqual(r.Map(t), map[string]any{"error": "forbidden"}) {
+			t.Fatalf("not an owner or admin: %s", r)
+		}
+	}
+	if r := e.Do("GET", "/v1/audit-events", "", nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("no key: %s", r)
+	}
+}
