 func (s *Store) DeleteWebhookEndpoint(id string) error {
 	s.mu.Lock()
 	defer s.mu.Unlock()
+	return s.deleteEndpoint(id)
+}
+
+// DeleteOrgWebhookEndpoint removes one of an organization's endpoints and its pending deliveries. Another organization's
+// endpoint is not found.
+func (s *Store) DeleteOrgWebhookEndpoint(orgID, id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if ep, ok := s.endpoints[id]; !ok || ep.OrgID != orgID {
+		return ErrNotFound
+	}
+	return s.deleteEndpoint(id)
+}
+
+// deleteEndpoint removes an endpoint that exists, and its pending deliveries. The caller holds the lock.
+func (s *Store) deleteEndpoint(id string) error {
 	if _, ok := s.endpoints[id]; !ok {
 		return ErrNotFound
 	}
