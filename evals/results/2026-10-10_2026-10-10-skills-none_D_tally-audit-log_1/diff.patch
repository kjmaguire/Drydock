+func TestAuditLogIsPerOrganization(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	e.CreateCustomer(e.Globex, "John", "john@example.com")
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+
+	// Globex cannot delete Acme's endpoint: it is not found, it still exists, and nothing is logged for it.
+	if r := e.Do("DELETE", "/v1/webhook-endpoints/"+ep.ID, e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("delete another org's endpoint: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, nil, nil)
+
+	acme := auditLog(t, e, e.Acme.Key, "?limit=100")
+	if !slices.Equal(actionsOf(acme), []string{"webhook_endpoint.created", "customer.created"}) {
+		t.Fatalf("Acme's log = %v", actionsOf(acme))
+	}
+	globex := auditLog(t, e, e.Globex.Key, "?limit=100")
+	if !slices.Equal(actionsOf(globex), []string{"customer.created"}) {
+		t.Fatalf("Globex's log = %v", actionsOf(globex))
+	}
+	for _, en := range globex {
+		if en.Target.Type == "webhook_endpoint" {
+			t.Fatalf("Globex's log has Acme's endpoint: %+v", en)
+		}
+	}
+}
