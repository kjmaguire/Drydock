+// ---- seats
+
+// SeatsUsed returns how many seats an organization uses: its members and its pending invites whose role is not viewer.
+func (s *Store) SeatsUsed(orgID string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.seatsUsed(orgID)
+}
+
+// seatsUsed counts the seats in use. The caller holds the lock.
+func (s *Store) seatsUsed(orgID string) int {
+	used := 0
+	for _, m := range s.members {
+		if m.OrgID == orgID && m.Role != RoleViewer {
+			used++
+		}
+	}
+	for _, inv := range s.invites {
+		if inv.OrgID == orgID && inv.Role != RoleViewer && inv.AcceptedAt == nil && inv.RevokedAt == nil {
+			used++
+		}
+	}
+	return used
+}
+
+// checkSeat returns a SeatError when the organization's plan has no free seat. The caller holds the lock.
+func (s *Store) checkSeat(orgID string) error {
+	limit := s.orgs[orgID].Plan.SeatLimit()
+	if limit == Unlimited {
+		return nil
+	}
+	if used := s.seatsUsed(orgID); used >= limit {
+		return &SeatError{Limit: limit, Used: used}
+	}
+	return nil
+}
