+// seatsOf reads the organization's seats through the API.
+func seatsOf(t *testing.T, e *apitest.Env, key string) (int, *int) {
+	t.Helper()
+	var o struct {
+		Seats struct {
+			Used  int  `json:"used"`
+			Limit *int `json:"limit"`
+		} `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", key, nil, &o)
+	return o.Seats.Used, o.Seats.Limit
+}
+
+func TestSeatLimits(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Free", store.OrgFree, "UTC")
+	if used, limit := seatsOf(t, e, free.Key); used != 1 || limit == nil || *limit != 3 {
+		t.Fatalf("seats = %d, %v", used, limit)
+	}
+	if used, limit := seatsOf(t, e, e.Globex.Key); used != 1 || limit != nil {
+		t.Fatalf("business seats = %d, %v; want unlimited", used, limit)
+	}
+	e.AddMember(free, "member@free.example", store.RoleMember)
+	e.AddMember(free, "viewer@free.example", store.RoleViewer)
+
+	// Viewers are free: invites for viewers never need a seat.
+	for i := range 3 {
+		e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": fmt.Sprintf("v%d@free.example", i), "role": "viewer"}, nil)
+	}
+	if used, _ := seatsOf(t, e, free.Key); used != 2 {
+		t.Fatalf("used after viewer invites = %d", used)
+	}
+
+	// Pending invites hold seats: one seat is left, so one more non-viewer invite fits.
+	var held store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "a@free.example", "role": "member"}, &held)
+	r := e.Do("POST", "/v1/invites", free.Key, map[string]string{"email": "b@free.example", "role": "member"})
+	if r.Code != http.StatusPaymentRequired {
+		t.Fatalf("invite over the limit: %s", r)
+	}
+	if got := r.Map(t); got["error"] != "seat_limit_reached" || got["limit"] != float64(3) || got["used"] != float64(3) {
+		t.Fatalf("402 body = %v", got)
+	}
+
+	// A revoked invite gives its seat back.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+held.ID, free.Key, nil, nil)
+	if used, _ := seatsOf(t, e, free.Key); used != 2 {
+		t.Fatalf("used after revoke = %d", used)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "c@free.example", "role": "admin"}, &held)
+
+	// Accepting an invite never fails for lack of a seat: the invite already holds one.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": held.Token, "name": "C"}, nil)
+	if used, _ := seatsOf(t, e, free.Key); used != 3 {
+		t.Fatalf("used after accept = %d", used)
+	}
+
+	// Changing a viewer to another role needs a free seat.
+	viewer, _ := e.Store.UserByEmail("viewer@free.example")
+	r = e.Do("PATCH", "/v1/members/"+viewer.ID, free.Key, map[string]string{"role": "member"})
+	if r.Code != http.StatusPaymentRequired {
+		t.Fatalf("viewer promoted over the limit: %s", r)
+	}
+	if got := r.Map(t); got["error"] != "seat_limit_reached" || got["limit"] != float64(3) || got["used"] != float64(3) {
+		t.Fatalf("402 body = %v", got)
+	}
+	member, _ := e.Store.UserByEmail("member@free.example")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, free.Key, map[string]string{"role": "viewer"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+viewer.ID, free.Key, map[string]string{"role": "billing"}, nil)
+	if used, _ := seatsOf(t, e, free.Key); used != 3 {
+		t.Fatalf("used at the end = %d", used)
+	}
+}
+
+func TestSeatLimitsOnPlanChange(t *testing.T) {
+	e := apitest.New(t)
+	org := e.NewOrg("Solo", store.OrgFree, "UTC")
+	e.AddMember(org, "member@solo.example", store.RoleMember)
+	e.AddMember(org, "admin@solo.example", store.RoleAdmin)
+	e.AddMember(org, "viewer@solo.example", store.RoleViewer)
+
+	// Business has no limit, so the organization can grow past the free plan's three seats.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", org.Key, map[string]string{"plan": "business"}, nil)
+	e.AddMember(org, "extra@solo.example", store.RoleMember)
+	if used, limit := seatsOf(t, e, org.Key); used != 4 || limit != nil {
+		t.Fatalf("seats = %d, %v", used, limit)
+	}
+
+	// Free allows three seats: the change is refused, and nothing else in the request changes either.
+	r := e.Do("PATCH", "/v1/org", org.Key, map[string]string{"name": "Renamed", "plan": "free"})
+	if r.Code != http.StatusConflict {
+		t.Fatalf("downgrade over the limit: %s", r)
+	}
+	if got := r.Map(t); got["error"] != "over_seat_limit" || got["limit"] != float64(3) || got["used"] != float64(4) {
+		t.Fatalf("409 body = %v", got)
+	}
+	if o, _ := e.Store.Org(org.ID); o.Plan != store.OrgBusiness || o.Name != "Solo" {
+		t.Fatalf("org after the refused change = %+v", o)
+	}
+
+	// Team allows ten seats, which is enough for four.
+	var o struct {
+		Plan  string `json:"plan"`
+		Seats struct {
+			Limit *int `json:"limit"`
+		} `json:"seats"`
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", org.Key, map[string]string{"plan": "team"}, &o)
+	if o.Plan != "team" || o.Seats.Limit == nil || *o.Seats.Limit != 10 {
+		t.Fatalf("org = %+v", o)
+	}
+}
+
+func TestSeatLimitHoldsUnderConcurrency(t *testing.T) {
+	e := apitest.New(t)
+	org := e.NewOrg("Race", store.OrgFree, "UTC")
+	e.AddMember(org, "member@race.example", store.RoleMember)
+	// The owner and the member use two of the free plan's three seats, so one is left.
+
+	const n = 8
+	codes := make(chan int, n)
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			r := e.Do("POST", "/v1/invites", org.Key, map[string]string{"email": fmt.Sprintf("p%d@race.example", i), "role": "member"})
+			codes <- r.Code
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(codes)
+
+	created := 0
+	for code := range codes {
+		switch code {
+		case http.StatusCreated:
+			created++
+		case http.StatusPaymentRequired:
+		default:
+			t.Fatalf("unexpected status %d", code)
+		}
+	}
+	if created != 1 {
+		t.Fatalf("%d of %d concurrent invites succeeded; want exactly 1", created, n)
+	}
+	if used, limit := seatsOf(t, e, org.Key); used != 3 || limit == nil || *limit != 3 {
+		t.Fatalf("seats = %d, %v", used, limit)
+	}
+}
