+// TestInvoicesWithoutLines reproduces the incident: an invoice with no lines (what a free plan's invoice was stored as) made
+// GET /v1/invoices and GET /v1/invoices/{id} answer 500 with "index out of range [0] with length 0".
+func TestInvoicesWithoutLines(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: money.USD}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var listed struct {
+		Items []struct{ ID, Description string }
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices", e.Acme.Key, nil, &listed)
+	if len(listed.Items) != 1 || listed.Items[0].ID != inv.ID || listed.Items[0].Description != "" {
+		t.Fatalf("listed = %+v", listed)
+	}
+	var got struct{ ID, Description string }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &got)
+	if got.ID != inv.ID || got.Description != "" {
+		t.Fatalf("got = %+v", got)
+	}
+	var paid struct {
+		Invoice store.Invoice `json:"invoice"`
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+inv.ID+"/pay", e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"}, &paid)
+	if paid.Invoice.Status != store.InvoicePaid {
+		t.Fatalf("paid = %+v", paid.Invoice)
+	}
+	other := e.CreateCustomer(e.Acme, "Bob", "bob@example.com")
+	void, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: other.ID, Currency: money.USD}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+void.ID+"/void", e.Acme.Key, nil, nil)
+	if n := len(e.Gateway.Charges()); n != 0 {
+		t.Fatalf("charges = %d, want none for a zero-total invoice", n)
+	}
+}
+
+// TestFreePlanInvoicesHaveOneLine: a free licensed plan is invoiced like any other, with one line for the plan and no charge.
+func TestFreePlanInvoicesHaveOneLine(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	plan, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Free", Currency: money.USD, UnitAmount: 0, Interval: store.Monthly}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: plan.ID, Quantity: 3})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	var listed struct {
+		Items []struct {
+			store.Invoice
+			Description string `json:"description"`
+			Total       int64
+		}
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &listed)
+	if len(listed.Items) != 2 {
+		t.Fatalf("invoices = %+v, want the first and one renewal", listed.Items)
+	}
+	for _, inv := range listed.Items {
+		if inv.Status != store.InvoicePaid || inv.Total != 0 || len(inv.Lines) != 1 || inv.Lines[0].UnitAmount != 0 || inv.Lines[0].Quantity != 3 {
+			t.Fatalf("invoice = %+v", inv)
+		}
+		if !strings.HasPrefix(inv.Description, "Free, ") {
+			t.Fatalf("description = %q", inv.Description)
+		}
+	}
+	if n := len(e.Gateway.Charges()); n != 0 {
+		t.Fatalf("charges = %d, want none", n)
+	}
+	var lines struct{ Items []struct{ Amount int64 } }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+listed.Items[0].ID+"/lines", e.Acme.Key, nil, &lines)
+	if len(lines.Items) != 1 || lines.Items[0].Amount != 0 {
+		t.Fatalf("lines = %+v", lines.Items)
+	}
+}
