+func utc(y int, m time.Month, d, hh, mm int) time.Time {
+	return time.Date(y, m, d, hh, mm, 0, 0, time.UTC)
+}
+
+func TestAddIntervalClampsToShortMonth(t *testing.T) {
+	if got := AddInterval(utc(2026, 1, 31, 10, 0), store.Monthly); !got.Equal(utc(2026, 2, 28, 10, 0)) {
+		t.Errorf("Jan 31 + 1 month = %v, want Feb 28", got)
+	}
+	if got := AddInterval(utc(2028, 1, 31, 10, 0), store.Monthly); !got.Equal(utc(2028, 2, 29, 10, 0)) {
+		t.Errorf("leap Jan 31 + 1 month = %v, want Feb 29", got)
+	}
+}
+
+func TestPeriodStartMonthly(t *testing.T) {
+	anchor := utc(2026, 1, 31, 10, 30)
+	want := []time.Time{
+		utc(2026, 1, 31, 10, 30), // period 0
+		utc(2026, 2, 28, 10, 30), // Feb has 28 days
+		utc(2026, 3, 31, 10, 30), // back on the 31st: the anchor does not drift
+		utc(2026, 4, 30, 10, 30), // April has 30 days
+		utc(2026, 5, 31, 10, 30),
+		utc(2026, 6, 30, 10, 30),
+		utc(2026, 7, 31, 10, 30),
+		utc(2026, 8, 31, 10, 30),
+		utc(2026, 9, 30, 10, 30),
+		utc(2026, 10, 31, 10, 30),
+		utc(2026, 11, 30, 10, 30),
+		utc(2026, 12, 31, 10, 30),
+		utc(2027, 1, 31, 10, 30), // period 12
+	}
+	for n, w := range want {
+		if got := PeriodStart(anchor, store.Monthly, n); !got.Equal(w) {
+			t.Errorf("period %d = %v, want %v", n, got, w)
+		}
+	}
+}
+
+func TestPeriodStartLeapDayMonthly(t *testing.T) {
+	anchor := utc(2024, 2, 29, 0, 0)
+	if got := PeriodStart(anchor, store.Monthly, 1); !got.Equal(utc(2024, 3, 29, 0, 0)) {
+		t.Errorf("period 1 = %v", got)
+	}
+	if got := PeriodStart(anchor, store.Monthly, 12); !got.Equal(utc(2025, 2, 28, 0, 0)) {
+		t.Errorf("period 12 = %v, want Feb 28 2025", got)
+	}
+	if got := PeriodStart(anchor, store.Monthly, 24); !got.Equal(utc(2026, 2, 28, 0, 0)) {
+		t.Errorf("period 24 = %v, want Feb 28 2026", got)
+	}
+	if got := PeriodStart(anchor, store.Monthly, 48); !got.Equal(utc(2028, 2, 29, 0, 0)) {
+		t.Errorf("period 48 = %v, want Feb 29 2028", got)
+	}
+}
+
+func TestPeriodStartYearly(t *testing.T) {
+	leap := utc(2024, 2, 29, 9, 0)
+	if got := PeriodStart(leap, store.Yearly, 1); !got.Equal(utc(2025, 2, 28, 9, 0)) {
+		t.Errorf("common year = %v, want Feb 28", got)
+	}
+	if got := PeriodStart(leap, store.Yearly, 4); !got.Equal(utc(2028, 2, 29, 9, 0)) {
+		t.Errorf("leap year = %v, want Feb 29", got)
+	}
+	if got := PeriodStart(utc(2026, 3, 14, 9, 30), store.Yearly, 2); !got.Equal(utc(2028, 3, 14, 9, 30)) {
+		t.Errorf("two years = %v", got)
+	}
+}
+
+func TestNextPeriodEndsWhereTheNextStarts(t *testing.T) {
+	anchor := utc(2026, 1, 31, 10, 0)
+	// A period that starts on the schedule ends on the next period's start.
+	start, end := NextPeriod(anchor, store.Monthly, utc(2026, 2, 28, 10, 0))
+	if !start.Equal(utc(2026, 2, 28, 10, 0)) || !end.Equal(utc(2026, 3, 31, 10, 0)) {
+		t.Errorf("period after Feb 28 = [%v, %v)", start, end)
+	}
+	// A start that is not on the schedule (a late renewal) still ends on the schedule, and the period starts where the
+	// previous one ended.
+	start, end = NextPeriod(anchor, store.Monthly, utc(2026, 3, 1, 12, 0))
+	if !start.Equal(utc(2026, 3, 1, 12, 0)) || !end.Equal(utc(2026, 3, 31, 10, 0)) {
+		t.Errorf("period after Mar 1 12:00 = [%v, %v)", start, end)
+	}
+}
