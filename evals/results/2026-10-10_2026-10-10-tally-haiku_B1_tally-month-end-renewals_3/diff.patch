-// AddInterval returns t moved forward by one billing interval: a month or a year.
-func AddInterval(t time.Time, iv store.Interval) time.Time {
+// Anchor returns the start of a subscription's first paid period, which its billing periods are counted from: its
+// TrialEnd when it started with a trial, otherwise its StartedAt. The result is in UTC.
+func Anchor(sub store.Subscription) time.Time {
+	if sub.TrialEnd != nil {
+		return sub.TrialEnd.UTC()
+	}
+	return sub.StartedAt.UTC()
+}
+
+// PeriodStart returns when period n (n = 0, 1, 2, ...) starts for a subscription anchored at anchor: n months (monthly) or
+// n years (yearly) after the anchor, on the anchor's day of the month and at its time of day, or on the last day of that
+// month when the month is shorter. Each period is counted from the anchor, so a short month never moves later periods.
+// The result is in UTC.
+func PeriodStart(anchor time.Time, iv store.Interval, n int) time.Time {
+	a := anchor.UTC()
+	step := 1
 	if iv == store.Yearly {
-		return t.AddDate(1, 0, 0)
+		step = 12
 	}
-	return t.AddDate(0, 1, 0)
+	first := time.Date(a.Year(), a.Month()+time.Month(n*step), 1, a.Hour(), a.Minute(), a.Second(), a.Nanosecond(), time.UTC)
+	daysInMonth := time.Date(first.Year(), first.Month()+1, 0, 0, 0, 0, 0, time.UTC).Day()
+	day := min(a.Day(), daysInMonth)
+	return time.Date(first.Year(), first.Month(), day, a.Hour(), a.Minute(), a.Second(), a.Nanosecond(), time.UTC)
+}
+
+// NextPeriod returns the period that begins at from, the end of the period before it, and where it ends: the first period
+// start of the anchored schedule that is after from. Periods made this way follow the schedule, not the day the renewal
+// happened to run, so each one ends exactly where the next one starts.
+func NextPeriod(anchor time.Time, iv store.Interval, from time.Time) (start, end time.Time) {
+	a := anchor.UTC()
+	from = from.UTC()
+	step := 1
+	if iv == store.Yearly {
+		step = 12
+	}
+	months := (from.Year()-a.Year())*12 + int(from.Month()-a.Month())
+	n := months / step
+	for !PeriodStart(a, iv, n).After(from) {
+		n++
+	}
+	for PeriodStart(a, iv, n-1).After(from) {
+		n--
+	}
+	return from, PeriodStart(a, iv, n)
+}
+
+// AddInterval returns t moved forward by one billing interval: a month or a year. When the later month is shorter, the
+// result is its last day, so January 31 plus one month is February 28 (or 29).
+func AddInterval(t time.Time, iv store.Interval) time.Time {
+	return PeriodStart(t, iv, 1)
 }
