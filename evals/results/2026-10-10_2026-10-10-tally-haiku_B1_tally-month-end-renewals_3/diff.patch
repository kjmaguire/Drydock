+func TestMonthEndAnchorDoesNotDrift(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	e.Clock.Set(time.Date(2026, time.January, 31, 10, 0, 0, 0, time.UTC))
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Each renewal happens exactly when the period ends. The period after a short month is back on the 31st.
+	for _, end := range []time.Time{
+		time.Date(2026, 3, 31, 10, 0, 0, 0, time.UTC),
+		time.Date(2026, 4, 30, 10, 0, 0, 0, time.UTC),
+		time.Date(2026, 5, 31, 10, 0, 0, 0, time.UTC),
+	} {
+		e.Clock.Set(sub.CurrentPeriodEnd)
+		if _, err := e.Subs.RenewDue(ctx); err != nil {
+			t.Fatal(err)
+		}
+		sub, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+		if !sub.CurrentPeriodEnd.Equal(end) {
+			t.Fatalf("period ends %v, want %v", sub.CurrentPeriodEnd, end)
+		}
+	}
+	if got := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(got) != 4 {
+		t.Fatalf("invoices = %d, want 4 (one per period)", len(got))
+	}
+}
+
+func TestLateRenewalCatchesUpEachPeriod(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	e.Clock.Set(time.Date(2026, time.January, 31, 10, 0, 0, 0, time.UTC))
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The job did not run for two months. The renewal runs on April 15, after the periods ending Feb 28 and Mar 31.
+	e.Clock.Set(time.Date(2026, time.April, 15, 10, 0, 0, 0, time.UTC))
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(time.Date(2026, 3, 31, 10, 0, 0, 0, time.UTC)) ||
+		!got.CurrentPeriodEnd.Equal(time.Date(2026, 4, 30, 10, 0, 0, 0, time.UTC)) {
+		t.Fatalf("after the catch-up = %+v", got)
+	}
+	// Each missed period has its own paid invoice, in order, and each was charged.
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	wantStarts := []time.Time{
+		time.Date(2026, 1, 31, 10, 0, 0, 0, time.UTC),
+		time.Date(2026, 2, 28, 10, 0, 0, 0, time.UTC),
+		time.Date(2026, 3, 31, 10, 0, 0, 0, time.UTC),
+	}
+	if len(invs) != len(wantStarts) {
+		t.Fatalf("invoices = %d, want %d", len(invs), len(wantStarts))
+	}
+	for _, want := range wantStarts {
+		found := false
+		for _, inv := range invs {
+			if inv.PeriodStart != nil && inv.PeriodStart.Equal(want) {
+				found = true
+				if inv.Status != store.InvoicePaid || inv.PeriodEnd == nil || !inv.PeriodEnd.After(want) {
+					t.Errorf("invoice for %v = %+v", want, inv)
+				}
+			}
+		}
+		if !found {
+			t.Errorf("no invoice for the period starting %v", want)
+		}
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 3 {
+		t.Fatalf("charges = %d, want 3", len(cs))
+	}
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+		t.Fatalf("RenewDue again = %d, %v", n, err)
+	}
+}
+
