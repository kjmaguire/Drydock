+// setPaymentMethod sets the customer's default payment method.
+func setPaymentMethod(e *apitest.Env, c store.Customer, pm string) {
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = pm; return nil })
+}
+
+// lastInvoice returns the subscription's newest invoice.
+func lastInvoice(e *apitest.Env, subID string) store.Invoice {
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: subID})
+	return invs[len(invs)-1]
+}
+
+func intp(n int) *int { return &n }
+
+func TestUpgradeBillsTheRemainingTime(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	_, _ = e.Store.UpdateOrg(e.Acme.ID, func(o *store.Org) error { o.TaxRateBP = 2000; return nil })
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setPaymentMethod(e, c, "pm_card_visa")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "49.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: team.ID, Quantity: 1, DiscountPercent: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// 10 of the period's 31 days have passed, so 21 remain.
+	e.Clock.Set(sub.CurrentPeriodStart.AddDate(0, 0, 10))
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &pro.ID})
+	if err != nil || got.PlanID != pro.ID || got.Status != store.Active || got.PendingPlanID != nil || got.PendingQuantity != nil {
+		t.Fatalf("upgrade = %+v, %v", got, err)
+	}
+	if !got.CurrentPeriodStart.Equal(sub.CurrentPeriodStart) || !got.CurrentPeriodEnd.Equal(sub.CurrentPeriodEnd) {
+		t.Fatalf("the upgrade moved the period: %+v", got)
+	}
+	// Unused: 2000 * 21/31 = 1354.84, credited as 1355. Remaining: 4900 * 21/31 = 3319.35, charged as 3319.
+	// The subtotal is 1964; the 10% discount (196) leaves 1768, and the 20% tax (354) makes 2122.
+	inv := lastInvoice(e, sub.ID)
+	want := []store.Line{{Description: "Unused time on Team", Quantity: 1, UnitAmount: -1355}, {Description: "Remaining time on Pro", Quantity: 1, UnitAmount: 3319}}
+	if !reflect.DeepEqual(inv.Lines, want) || inv.Status != store.InvoicePaid || inv.DiscountPercent != 10 || inv.TaxRateBP != 2000 {
+		t.Fatalf("invoice = %+v", inv)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[1].Amount != 2122 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
