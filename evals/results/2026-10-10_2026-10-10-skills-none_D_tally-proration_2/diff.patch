+func TestPatchSubscriptionOverHTTP(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setPaymentMethod(e, c, "pm_card_visa")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	eur, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Euro", Currency: money.EUR, UnitAmount: 4900, Interval: store.Monthly}, e.Clock.Now())
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": team.ID, "quantity": 3}, &sub)
+	if r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": eur.ID}); r.Code != http.StatusUnprocessableEntity || len(r.Map(t)) != 1 || r.Map(t)["error"] != "incompatible_plan" {
+		t.Fatalf("incompatible: %s", r)
+	}
+	var down map[string]any
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"quantity": 1}, &down)
+	if down["pending_plan_id"] != team.ID || down["pending_quantity"] != float64(1) || down["quantity"] != float64(3) {
+		t.Fatalf("downgrade = %v", down)
+	}
+	var back map[string]any
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"quantity": 3}, &back)
+	if v, ok := back["pending_plan_id"]; !ok || v != nil {
+		t.Fatalf("pending_plan_id after returning to the current quantity = %v", v)
+	}
+	if v, ok := back["pending_quantity"]; !ok || v != nil {
+		t.Fatalf("pending_quantity after returning to the current quantity = %v", v)
+	}
+}
