+func TestProrate(t *testing.T) {
+	for _, c := range []struct {
+		amount, part, whole int64
+		want                int64
+	}{
+		{4000, 1, 2, 2000},
+		{2000, 1, 3, 667}, // 666.67
+		{2000, 1, 4, 500},
+		{1000, 1, 8, 125},
+		{1001, 1, 2, 501}, // 500.5 rounds up
+		{-1001, 1, 2, -501},
+		{1001, -1, 2, -501},
+		{4000, 0, 2592000, 0},
+		{10000, 2592000, 2592000, 10000},
+		{math.MaxInt64 / 2, 3, 3, math.MaxInt64 / 2}, // the product does not overflow
+	} {
+		if got := Prorate(c.amount, c.part, c.whole); got != c.want {
+			t.Errorf("Prorate(%d, %d, %d) = %d, want %d", c.amount, c.part, c.whole, got, c.want)
+		}
+	}
+}
