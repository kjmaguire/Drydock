+func TestUpgradeWithoutPaymentMethodStaysOpen(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: team.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodStart.AddDate(0, 0, 10))
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: intp(3)})
+	if err != nil || got.Quantity != 3 || got.Status != store.Active {
+		t.Fatalf("upgrade = %+v, %v", got, err)
+	}
+	// Unused: 2000 * 21/31 is 1355. Remaining: 6000 * 21/31 is 4065.
+	inv := lastInvoice(e, sub.ID)
+	if inv.Status != store.InvoiceOpen || len(inv.Lines) != 2 || inv.Lines[0].UnitAmount != -1355 || inv.Lines[1].UnitAmount != 4065 {
+		t.Fatalf("invoice = %+v", inv)
+	}
+	if n := len(e.Gateway.Calls()); n != 0 {
+		t.Fatalf("%d charge attempts without a payment method", n)
+	}
+}
