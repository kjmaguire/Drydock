+func TestDowngradeAppliesAtRenewal(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	setPaymentMethod(e, c, "pm_card_visa")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: team.ID, Quantity: 3})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodStart.AddDate(0, 0, 10))
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: intp(1)})
+	if err != nil || got.Quantity != 3 || got.PendingQuantity == nil || *got.PendingQuantity != 1 || got.PendingPlanID == nil || *got.PendingPlanID != team.ID {
+		t.Fatalf("downgrade = %+v, %v", got, err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("a downgrade was billed: %+v", invs)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Quantity != 1 || got.PendingPlanID != nil || got.PendingQuantity != nil || got.Status != store.Active {
+		t.Fatalf("after the renewal = %+v", got)
+	}
+	inv := lastInvoice(e, sub.ID)
+	if len(inv.Lines) != 1 || inv.Lines[0].Quantity != 1 || inv.Lines[0].UnitAmount != 2000 {
+		t.Fatalf("renewal invoice = %+v", inv)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[1].Amount != 2000 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
