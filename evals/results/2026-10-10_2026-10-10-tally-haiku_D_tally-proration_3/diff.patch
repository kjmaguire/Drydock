+// Prorate returns amount times part over whole, rounded half away from zero to a whole minor unit. whole must not be zero.
+// The product is computed without overflow, so amount can be a price times a quantity and part and whole durations.
+func Prorate(amount, part, whole int64) int64 {
+	num := new(big.Int).Mul(big.NewInt(amount), big.NewInt(part))
+	neg := (num.Sign() < 0) != (whole < 0)
+	num.Abs(num)
+	den := big.NewInt(whole)
+	den.Abs(den)
+	q, r := new(big.Int).QuoRem(num, den, new(big.Int))
+	if r.Lsh(r, 1).Cmp(den) >= 0 {
+		q.Add(q, big.NewInt(1))
+	}
+	if neg {
+		q.Neg(q)
+	}
+	return q.Int64()
+}
