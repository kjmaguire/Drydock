+func TestDowngradeTakesEffectAtTheNextRenewal(t *testing.T) {
+	e, c, team, pro := setupPlans(t, "pm_card_visa")
+	ctx := context.Background()
+	sub := subscribe(t, e, c, pro, 1)
+	lastThird(e, sub)
+	// Pro x 1 is 5000; Team x 2 is 4000, so this is a downgrade.
+	qty := 2
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &team.ID, Quantity: &qty})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != pro.ID || got.Quantity != 1 || got.Status != store.Active ||
+		got.PendingPlanID == nil || *got.PendingPlanID != team.ID || got.PendingQuantity == nil || *got.PendingQuantity != 2 {
+		t.Fatalf("downgraded = %+v", got)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("a downgrade was billed: %d invoices", len(invs))
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	renewed, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if renewed.PlanID != team.ID || renewed.Quantity != 2 || renewed.PendingPlanID != nil || renewed.PendingQuantity != nil || renewed.Status != store.Active {
+		t.Fatalf("renewed = %+v", renewed)
+	}
+	for _, inv := range e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+		if inv.PeriodStart != nil && inv.PeriodStart.Equal(renewed.CurrentPeriodStart) {
+			if len(inv.Lines) != 1 || inv.Lines[0].Quantity != 2 || inv.Lines[0].UnitAmount != 2000 || inv.Status != store.InvoicePaid {
+				t.Fatalf("renewal invoice = %+v, want 2 x Team", inv)
+			}
+			return
+		}
+	}
+	t.Fatal("no renewal invoice")
+}
