+func TestIncompatiblePlansAreRefused(t *testing.T) {
+	e, c, team, _ := setupPlans(t, "pm_card_visa")
+	ctx := context.Background()
+	sub := subscribe(t, e, c, team, 1)
+	now := e.Clock.Now()
+	for _, p := range []store.Plan{
+		{OrgID: e.Acme.ID, Name: "Euro", Currency: money.EUR, UnitAmount: 9000, Interval: store.Monthly},
+		{OrgID: e.Acme.ID, Name: "Yearly", Currency: money.USD, UnitAmount: 90000, Interval: store.Yearly},
+		{OrgID: e.Acme.ID, Name: "Metered", Currency: money.USD, UnitAmount: 2, Interval: store.Monthly, UsageType: store.Metered},
+	} {
+		created, err := e.Store.CreatePlan(p, now)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &created.ID}); !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+			t.Fatalf("change to %s: %v", created.Name, err)
+		}
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.PlanID != team.ID || got.Status != store.Active || got.PendingPlanID != nil {
+		t.Fatalf("refused change left = %+v", got)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("a refused change was billed: %d invoices", len(invs))
+	}
+	metered, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Usage", Currency: money.USD, UnitAmount: 2, Interval: store.Monthly, UsageType: store.Metered}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	usage := subscribe(t, e, c, metered, 1)
+	qty := 2
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, usage.ID, subscriptions.UpdateInput{Quantity: &qty}); !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+		t.Fatalf("quantity of a metered subscription: %v", err)
+	}
+}
