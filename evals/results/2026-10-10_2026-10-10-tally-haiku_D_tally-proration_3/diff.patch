+// lastThird moves the clock so that a third of the subscription's current period is left.
+func lastThird(e *apitest.Env, sub store.Subscription) {
+	e.Clock.Set(sub.CurrentPeriodEnd.Add(-sub.CurrentPeriodEnd.Sub(sub.CurrentPeriodStart) / 3))
+}
