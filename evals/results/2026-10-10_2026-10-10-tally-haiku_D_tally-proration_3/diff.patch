+package api_test
+
+import (
+	"net/http"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+func TestChangingASubscriptionOverHTTP(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	euro, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Euro", Currency: money.EUR, UnitAmount: 2000, Interval: store.Monthly}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": pro.ID, "quantity": 1}, &sub)
+	if r := e.Do("GET", "/v1/subscriptions/"+sub.ID, e.Acme.Key, nil); r.Map(t)["pending_plan_id"] != nil || r.Map(t)["pending_quantity"] != nil {
+		t.Fatalf("a new subscription has a pending change: %s", r)
+	}
+
+	if r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": euro.ID}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "incompatible_plan" {
+		t.Fatalf("change to another currency: %s", r)
+	}
+	if r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"quantity": 0}); r.Code != http.StatusUnprocessableEntity {
+		t.Fatalf("quantity 0: %s", r)
+	}
+
+	// Team x 2 is worth 4000, less than Pro x 1 at 5000: a downgrade, pending until the next renewal.
+	var got map[string]any
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": team.ID, "quantity": 2}, &got)
+	if got["plan_id"] != pro.ID || got["pending_plan_id"] != team.ID || got["pending_quantity"] != float64(2) {
+		t.Fatalf("downgrade = %v", got)
+	}
+}
