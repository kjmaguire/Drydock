+	sub := subscribe(t, e, c, team, 1)
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_declined"; return nil })
+	lastThird(e, sub)
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &pro.ID})
+	if err != nil || got.PlanID != pro.ID || got.Status != store.PastDue {
+		t.Fatalf("upgraded = %+v, %v", got, err)
+	}
+	inv := prorationInvoice(t, e, sub)
+	if ps := e.Store.Payments(e.Acme.ID, inv.ID); inv.Status != store.InvoiceOpen || len(ps) != 1 || ps[0].Status != store.PaymentFailed {
+		t.Fatalf("invoice = %+v, payments = %+v", inv, ps)
+	}
+}
