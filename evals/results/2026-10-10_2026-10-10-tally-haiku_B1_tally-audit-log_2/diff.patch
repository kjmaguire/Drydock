diff --git a/result/internal/store/audit.go b/result/internal/store/audit.go
new file mode 100644
index 0000000..131674e
--- /dev/null
+++ b/result/internal/store/audit.go
@@ -0,0 +1,38 @@
+package store
+
+import "time"
+
+// AuditFilter narrows AuditEntries. An empty field matches everything. ActorID is an API key ID or a user ID.
+type AuditFilter struct {
+	Action   string
+	TargetID string
+	ActorID  string
+}
+
+// AppendAudit records an entry at now. The store sets its ID and time. There is no way to change or remove an entry.
+func (s *Store) AppendAudit(e AuditEntry, now time.Time) AuditEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e.ID = s.newID("aud")
+	e.At = now.UTC()
+	s.audit = append(s.audit, e)
+	return e
+}
+
+// AuditEntries returns an organization's audit entries that match f, oldest first.
+func (s *Store) AuditEntries(orgID string, f AuditFilter) []AuditEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []AuditEntry{}
+	for _, e := range s.audit {
+		switch {
+		case e.OrgID != orgID:
+		case f.Action != "" && e.Action != f.Action:
+		case f.TargetID != "" && e.Target.ID != f.TargetID:
+		case f.ActorID != "" && e.Actor.ID != f.ActorID && e.Actor.UserID != f.ActorID:
+		default:
+			out = append(out, e)
+		}
+	}
+	return out
+}
diff --git a/result/internal/store/audit_test.go b/result/internal/store/audit_test.go
new file mode 100644
index 0000000..65135b5
--- /dev/null
+++ b/result/internal/store/audit_test.go
@@ -0,0 +1,103 @@
+package store
+
+import (
+	"encoding/json"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestAuditLogIsAppendOnlyPerOrg(t *testing.T) {
+	s := New()
+	t0 := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	acme, _ := s.CreateOrg("Acme", OrgTeam, "UTC", 0, t0)
+	globex, _ := s.CreateOrg("Globex", OrgTeam, "UTC", 0, t0)
+
+	one := s.AppendAudit(AuditEntry{OrgID: acme.ID, Action: "customer.created", Target: AuditTarget{Type: "customer", ID: "cus_1"}}, t0)
+	s.AppendAudit(AuditEntry{OrgID: globex.ID, Action: "customer.created", Target: AuditTarget{Type: "customer", ID: "cus_2"}}, t0.Add(time.Minute))
+	two := s.AppendAudit(AuditEntry{OrgID: acme.ID, Action: "plan.updated", Target: AuditTarget{Type: "plan", ID: "plan_1"}}, t0.Add(2*time.Minute))
+
+	if one.ID == "" || one.ID == two.ID || !two.At.Equal(t0.Add(2*time.Minute)) {
+		t.Fatalf("entries = %+v, %+v", one, two)
+	}
+	got := s.AuditEntries(acme.ID, AuditFilter{})
+	if len(got) != 2 || got[0].ID != one.ID || got[1].ID != two.ID {
+		t.Fatalf("Acme's entries = %+v", got)
+	}
+	if got := s.AuditEntries(acme.ID, AuditFilter{Action: "plan.updated"}); len(got) != 1 || got[0].ID != two.ID {
+		t.Fatalf("by action = %+v", got)
+	}
+	if got := s.AuditEntries(acme.ID, AuditFilter{TargetID: "cus_2"}); len(got) != 0 {
+		t.Fatalf("another org's target matched: %+v", got)
+	}
+}
+
+func TestAuditLogSurvivesExport(t *testing.T) {
+	s := New()
+	t0 := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	o, _ := s.CreateOrg("Acme", OrgTeam, "UTC", 0, t0)
+	changes := map[string]AuditChange{"name": {From: "Old", To: "New"}}
+	s.AppendAudit(AuditEntry{OrgID: o.ID, Action: "org.updated", Actor: AuditActor{Type: "api_key", ID: "key_1", UserID: "usr_1"},
+		Target: AuditTarget{Type: "org", ID: o.ID}, RequestID: "req_1", Changes: &changes}, t0)
+
+	b, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var st State
+	if err := json.Unmarshal(b, &st); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := FromState(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := restored.AuditEntries(o.ID, AuditFilter{})
+	if len(got) != 1 || got[0].Action != "org.updated" || got[0].Actor.ID != "key_1" || got[0].RequestID != "req_1" {
+		t.Fatalf("restored = %+v", got)
+	}
+	if got[0].Changes == nil || (*got[0].Changes)["name"].To != "New" {
+		t.Fatalf("restored changes = %+v", got[0].Changes)
+	}
+}
+
+func TestChangeMemberRoleReturnsBothStates(t *testing.T) {
+	s := New()
+	t0 := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	o, _ := s.CreateOrg("Acme", OrgTeam, "UTC", 0, t0)
+	u, _ := s.CreateUser("m@acme.example", "M", t0)
+	if _, err := s.AddMember(o.ID, u.ID, RoleMember, t0); err != nil {
+		t.Fatal(err)
+	}
+	before, after, err := s.ChangeMemberRole(o.ID, u.ID, RoleAdmin)
+	if err != nil || before.Role != RoleMember || after.Role != RoleAdmin {
+		t.Fatalf("before %+v after %+v err %v", before, after, err)
+	}
+	if m, _ := s.Member(o.ID, u.ID); m.Role != RoleAdmin {
+		t.Fatalf("stored role = %s", m.Role)
