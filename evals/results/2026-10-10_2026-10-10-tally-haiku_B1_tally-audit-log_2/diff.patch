+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"slices"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// The audit log records every change a request made successfully (2xx) and nothing else. Owners and admins read it at
+// GET /v1/audit-events.
+
+// auditActorAPIKey is the actor type of every entry: changes are made with API keys.
+const auditActorAPIKey = "api_key"
+
+// auditView is an audit entry as the API shows it. Entries have no organization field: the list is the caller's own.
+type auditView struct {
+	ID        string                        `json:"id"`
+	Action    string                        `json:"action"`
+	Actor     store.AuditActor              `json:"actor"`
+	Target    store.AuditTarget             `json:"target"`
+	RequestID string                        `json:"request_id"`
+	At        time.Time                     `json:"at"`
+	Changes   *map[string]store.AuditChange `json:"changes,omitempty"`
+}
+
+func viewAudit(e store.AuditEntry) auditView {
+	return auditView{ID: e.ID, Action: e.Action, Actor: e.Actor, Target: e.Target, RequestID: e.RequestID, At: e.At, Changes: e.Changes}
+}
+
+// record writes an audit entry for a change the request made. Call it once the change is made and before the answer is
+// written, so the answer's reader can see the entry. changes is nil for actions that are not updates; an update passes its
+// changed fields, which may be none.
+func (s *Server) record(r *http.Request, p auth.Principal, action string, target store.AuditTarget, changes map[string]store.AuditChange) {
+	e := store.AuditEntry{OrgID: p.OrgID, Action: action, Actor: store.AuditActor{Type: auditActorAPIKey, ID: p.KeyID, UserID: p.UserID},
+		Target: target, RequestID: RequestID(r.Context())}
+	if changes != nil {
+		e.Changes = &changes
+	}
+	s.store.AppendAudit(e, s.clock.Now())
+}
+
+// secretFields are never written to the audit log.
+var secretFields = []string{"secret", "token"}
+
+// changed returns the fields whose JSON value differs between before and after, with both values. It compares the values
+// as the API shows them, so the names are JSON names. Secrets are left out.
+func changed(before, after any) map[string]store.AuditChange {
+	b, a := jsonFields(before), jsonFields(after)
+	names := map[string]bool{}
+	for k := range b {
+		names[k] = true
+	}
+	for k := range a {
+		names[k] = true
+	}
+	out := map[string]store.AuditChange{}
+	for k := range names {
+		if !reflect.DeepEqual(b[k], a[k]) {
+			out[k] = store.AuditChange{From: b[k], To: a[k]}
+		}
+	}
+	return out
+}
+
+// jsonFields is v as a JSON object, without the secret fields. v is always a struct of plain values, so it marshals.
+func jsonFields(v any) map[string]any {
+	raw, _ := json.Marshal(v)
+	var m map[string]any
+	_ = json.Unmarshal(raw, &m)
+	for _, k := range secretFields {
+		delete(m, k)
+	}
+	return m
+}
+
+func auditKey(e store.AuditEntry) cursor { return cursor{T: e.At, ID: e.ID} }
+
+// listAuditEvents lists the organization's audit entries, newest first, optionally only those of ?action=, ?target_id= or
+// by ?actor_id= (an API key ID or a user ID). Only owners and admins may read them.
+func (s *Server) listAuditEvents(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	if !auth.CanManageTeam(p.Role) {
+		writeJSON(w, http.StatusForbidden, map[string]string{"error": "forbidden"})
+		return
+	}
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	q := r.URL.Query()
+	es := s.store.AuditEntries(p.OrgID, store.AuditFilter{Action: q.Get("action"), TargetID: q.Get("target_id"), ActorID: q.Get("actor_id")})
+	slices.Reverse(es)
+	items, next := pageOfNewest(es, auditKey, pg)
+	views := make([]auditView, 0, len(items))
+	for _, e := range items {
+		views = append(views, viewAudit(e))
+	}
+	writeJSON(w, http.StatusOK, list{Items: views, NextCursor: next})
+}
