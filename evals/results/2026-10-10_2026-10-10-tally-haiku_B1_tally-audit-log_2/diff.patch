+package api_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// auditEntry is an audit entry as the API shows it.
+type auditEntry struct {
+	ID        string                        `json:"id"`
+	Action    string                        `json:"action"`
+	Actor     store.AuditActor              `json:"actor"`
+	Target    store.AuditTarget             `json:"target"`
+	RequestID string                        `json:"request_id"`
+	At        time.Time                     `json:"at"`
+	Changes   *map[string]store.AuditChange `json:"changes"`
+}
+
+// auditLog returns the audit entries the key may read for query, newest first.
+func auditLog(t *testing.T, e *apitest.Env, key, query string) []auditEntry {
+	t.Helper()
+	var out struct {
+		Items []auditEntry `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events?limit=100&"+query, key, nil, &out)
+	return out.Items
+}
+
+// actions returns the entries' actions, oldest first.
+func actions(es []auditEntry) []string {
+	out := []string{}
+	for i := len(es) - 1; i >= 0; i-- {
+		out = append(out, es[i].Action)
+	}
+	return out
+}
+
+// asJSON is v as JSON, for comparing values that decode as untyped.
+func asJSON(t *testing.T, v any) string {
+	t.Helper()
+	b, err := json.Marshal(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
+
+func TestAuditRecordsEachSuccessfulChange(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+jane.ID, key, map[string]any{"name": "Jane Roe", "email": "jane.roe@example.com"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+jane.ID, key, map[string]any{"name": "Jane Roe"}, nil)
+	if r := e.Do("POST", "/v1/customers", key, map[string]string{"name": "Dup", "email": "JANE.ROE@example.com"}); r.Code != http.StatusConflict {
+		t.Fatalf("duplicate: %s", r)
+	}
+	gone := e.CreateCustomer(e.Acme, "Gone", "gone@example.com")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+gone.ID, key, nil, nil)
+
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/plans/"+team.ID, key, map[string]any{"name": "Team Plus"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/plans/"+team.ID, key, map[string]any{"active": false}, nil)
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "10.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", key, map[string]any{"customer_id": jane.ID, "plan_id": pro.ID}, &sub)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, key, map[string]any{"quantity": 3}, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", key, map[string]any{"at_period_end": true}, nil)
+
+	type invoice struct {
+		ID string `json:"id"`
+	}
+	invBody := map[string]any{"customer_id": jane.ID, "currency": "USD", "lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 5000}}}
+	var inv1, inv2 invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, invBody, &inv1)
+	if r := e.Do("POST", "/v1/invoices/"+inv1.ID+"/pay", key, map[string]string{"payment_method": "pm_card_declined"}); r.Code != http.StatusPaymentRequired {
+		t.Fatalf("declined: %s", r)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+inv1.ID+"/pay", key, map[string]string{"payment_method": "pm_card_visa"}, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, invBody, &inv2)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+inv2.ID+"/void", key, nil, nil)
+	if r := e.Do("POST", "/v1/invoices/"+inv2.ID+"/void", key, nil); r.Code != http.StatusConflict {
+		t.Fatalf("void twice: %s", r)
+	}
+
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]any{"tax_rate_bp": 2000}, nil)
+
+	var k store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", key, map[string]string{"name": "CI"}, &k)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+k.ID, key, nil, nil)
+
+	var inv store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "new@people.example", "role": "member"}, &inv)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+inv.ID, key, nil, nil)
+
+	member, _ := e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, key, map[string]string{"role": "admin"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+member.ID, key, nil, nil)
+
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, key, map[string]any{"enabled": false}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+ep.ID, key, nil, nil)
+
+	es := auditLog(t, e, key, "")
+	// Oldest first. The reads, the refused and the failed requests record nothing.
+	want := []string{
+		"customer.created", "customer.updated", "customer.updated", "customer.created", "customer.deleted",
+		"plan.created", "plan.updated", "plan.updated", "plan.created",
+		"subscription.created", "subscription.updated", "subscription.canceled",
+		"invoice.created", "invoice.paid", "invoice.created", "invoice.voided",
+		"org.updated", "api_key.created", "api_key.revoked", "invite.created", "invite.revoked",
+		"member.role_changed", "member.removed",
+		"webhook_endpoint.created", "webhook_endpoint.updated", "webhook_endpoint.deleted",
+	}
+	if got := actions(es); asJSON(t, got) != asJSON(t, want) {
+		t.Fatalf("actions =\n%v\nwant\n%v", got, want)
+	}
+
+	// The changes of the updates: exactly the fields that changed; an update that changed nothing has none.
+	chronological := make([]auditEntry, len(es))
+	for i := range es {
+		chronological[len(es)-1-i] = es[i]
+	}
+	wantChanges := map[int]map[string]store.AuditChange{
+		1:  {"name": {From: "Jane", To: "Jane Roe"}, "email": {From: "jane@example.com", To: "jane.roe@example.com"}},
+		2:  {},
+		6:  {"name": {From: "Team", To: "Team Plus"}},
+		7:  {"active": {From: true, To: false}},
+		10: {"quantity": {From: 1, To: 3}},
+		16: {"tax_rate_bp": {From: 0, To: 2000}},
+		21: {"role": {From: "member", To: "admin"}},
+		24: {"enabled": {From: true, To: false}},
+	}
+	for i, ce := range chronological {
+		w, isUpdate := wantChanges[i]
+		switch {
+		case isUpdate:
+			if ce.Changes == nil {
+				t.Fatalf("entry %d (%s) has no changes", i, ce.Action)
+			}
+			if asJSON(t, *ce.Changes) != asJSON(t, w) {
+				t.Fatalf("entry %d (%s) changes = %s, want %s", i, ce.Action, asJSON(t, *ce.Changes), asJSON(t, w))
+			}
+		case ce.Changes != nil:
+			t.Fatalf("entry %d (%s) has changes %s but is not an update", i, ce.Action, asJSON(t, *ce.Changes))
+		}
+	}
+}
+
+func TestAuditEntryShape(t *testing.T) {
+	e := apitest.New(t)
+	apiKey, _ := e.Store.APIKeyByToken(e.Acme.Key)
+	r := e.DoWith("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane", "email": "jane@example.com"}, http.Header{"X-Request-Id": {"req-audit-1"}})
+	if r.Code != http.StatusCreated {
+		t.Fatalf("create: %s", r)
+	}
+	var c store.Customer
+	r.JSON(t, &c)
+
+	r = e.DoWith("PATCH", "/v1/customers/"+c.ID, e.Acme.Key, map[string]string{"name": "Jane Roe"}, http.Header{"X-Request-Id": {"req-audit-2"}})
+	if r.Code != http.StatusOK {
+		t.Fatalf("update: %s", r)
+	}
+
+	var page struct {
+		Items []map[string]any `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events", e.Acme.Key, nil, &page)
+	if len(page.Items) != 2 {
+		t.Fatalf("entries = %v", page.Items)
+	}
+	upd, created := page.Items[0], page.Items[1]
+	if upd["action"] != "customer.updated" || created["action"] != "customer.created" {
+		t.Fatalf("newest first: %v, %v", upd["action"], created["action"])
+	}
+	if _, ok := created["changes"]; ok {
+		t.Fatalf("a create has changes: %v", created)
+	}
+	if _, ok := upd["changes"]; !ok {
+		t.Fatalf("an update has no changes: %v", upd)
+	}
+	for _, key := range []string{"id", "action", "actor", "target", "request_id", "at"} {
+		if _, ok := created[key]; !ok {
+			t.Fatalf("entry has no %q: %v", key, created)
+		}
+	}
+	if len(created) != 6 {
+		t.Fatalf("entry has extra fields: %v", created)
+	}
+
+	var es []auditEntry
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events", e.Acme.Key, nil, &struct {
+		Items *[]auditEntry `json:"items"`
+	}{&es})
+	got := es[1]
+	if got.Actor != (store.AuditActor{Type: "api_key", ID: apiKey.ID, UserID: e.Acme.Owner.ID}) {
+		t.Fatalf("actor = %+v", got.Actor)
+	}
+	if got.Target != (store.AuditTarget{Type: "customer", ID: c.ID}) {
+		t.Fatalf("target = %+v", got.Target)
+	}
+	if got.RequestID != "req-audit-1" {
+		t.Fatalf("request id = %q", got.RequestID)
+	}
+	if !got.At.Equal(apitest.Start) || got.At.Location() != time.UTC {
+		t.Fatalf("at = %v", got.At)
+	}
+	if es[0].RequestID != "req-audit-2" {
+		t.Fatalf("update request id = %q", es[0].RequestID)
+	}
+}
+
+func TestAuditNeverHoldsSecrets(t *testing.T) {
+	e := apitest.New(t)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/other", "enabled": false}, nil)
+	var k store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "CI"}, &k)
+	var inv store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"}, &inv)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+k.ID, e.Acme.Key, nil, nil)
+
+	raw := e.Do("GET", "/v1/audit-events?limit=100", e.Acme.Key, nil).Body
+	for _, secret := range []string{ep.Secret, k.Token, inv.Token, e.Acme.Key} {
+		if strings.Contains(string(raw), secret) {
+			t.Fatalf("the audit log holds the secret %q", secret)
+		}
+	}
+	if strings.Contains(string(raw), `"secret"`) || strings.Contains(string(raw), `"token"`) {
+		t.Fatalf("the audit log names a secret field: %s", raw)
+	}
+	if !strings.Contains(string(raw), "webhook_endpoint.updated") {
+		t.Fatalf("no endpoint update recorded: %s", raw)
+	}
+}
+
+func TestAuditFiltersAndPaging(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	var ids []string
+	for _, name := range []string{"A", "B", "C", "D", "E"} {
+		ids = append(ids, e.CreateCustomer(e.Acme, name, strings.ToLower(name)+"@example.com").ID)
+	}
+	e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	_, adminKey := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	e.MustDo(http.StatusCreated, "POST", "/v1/customers", adminKey, map[string]string{"name": "F", "email": "f@example.com"}, nil)
+	ownerKeyID, _ := e.Store.APIKeyByToken(key)
+	adminKeyRec, _ := e.Store.APIKeyByToken(adminKey)
+
+	if got := auditLog(t, e, key, "action=customer.created"); len(got) != 6 || got[0].Target.ID == ids[0] {
+		t.Fatalf("by action: %d entries", len(got))
+	}
+	if got := auditLog(t, e, key, "action=customer.created&target_id="+ids[2]); len(got) != 1 || got[0].Target.ID != ids[2] {
+		t.Fatalf("by target: %+v", got)
+	}
+	if got := auditLog(t, e, key, "actor_id="+ownerKeyID.ID); len(got) != 6 {
+		t.Fatalf("by key: %d entries", len(got))
+	}
+	if got := auditLog(t, e, key, "actor_id="+e.Acme.Owner.ID); len(got) != 6 {
+		t.Fatalf("by owner's user ID: %d entries", len(got))
+	}
+	if got := auditLog(t, e, key, "actor_id="+adminKeyRec.ID); len(got) != 1 || got[0].Actor.UserID == e.Acme.Owner.ID {
+		t.Fatalf("by admin's key: %+v", got)
+	}
+	if got := auditLog(t, e, key, "actor_id=nobody"); len(got) != 0 {
+		t.Fatalf("by nobody: %+v", got)
+	}
+
+	// Pages of two, newest first, cover every entry once.
+	var all []auditEntry
+	cursor := ""
+	for {
+		var page struct {
+			Items      []auditEntry `json:"items"`
+			NextCursor string       `json:"next_cursor"`
+		}
+		q := "/v1/audit-events?limit=2"
+		if cursor != "" {
+			q += "&cursor=" + cursor
+		}
+		e.MustDo(http.StatusOK, "GET", q, key, nil, &page)
+		if len(page.Items) > 2 {
+			t.Fatalf("page of %d", len(page.Items))
+		}
+		all = append(all, page.Items...)
+		if page.NextCursor == "" {
+			break
+		}
+		cursor = page.NextCursor
+	}
+	if len(all) != 7 {
+		t.Fatalf("paged %d entries, want 7", len(all))
+	}
+	for i := 1; i < len(all); i++ {
+		if all[i].ID >= all[i-1].ID {
+			t.Fatalf("not newest first at %d: %s then %s", i, all[i-1].ID, all[i].ID)
+		}
+	}
+	if all[len(all)-1].Target.ID != ids[0] {
+		t.Fatalf("the last page does not end with the oldest entry: %+v", all[len(all)-1])
+	}
+	if r := e.Do("GET", "/v1/audit-events?limit=0", key, nil); r.Code != http.StatusBadRequest {
+		t.Fatalf("limit 0: %s", r)
+	}
+}
+
+func TestAuditIsForOwnersAndAdmins(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, admin := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events", admin, nil, nil)
+	for _, role := range []store.Role{store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		_, key := e.AddMember(e.Acme, string(role)+"@acme.example", role)
+		r := e.Do("GET", "/v1/audit-events", key, nil)
+		if r.Code != http.StatusForbidden {
+			t.Fatalf("%s: %s", role, r)
+		}
+		if asJSON(t, r.Map(t)) != `{"error":"forbidden"}` {
+			t.Fatalf("%s: body %s", role, r.Body)
+		}
+	}
+}
+
+func TestAuditIsScopedAndUnchangeable(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	if es := auditLog(t, e, e.Globex.Key, ""); len(es) != 0 {
+		t.Fatalf("Globex sees Acme's entries: %+v", es)
+	}
+
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	before := len(auditLog(t, e, e.Acme.Key, ""))
+	if r := e.Do("DELETE", "/v1/webhook-endpoints/"+ep.ID, e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("Globex deletes Acme's endpoint: %s", r)
+	}
+	if _, ok := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID); !ok {
+		t.Fatal("Acme's endpoint was deleted by Globex")
+	}
+	if n := len(auditLog(t, e, e.Acme.Key, "")); n != before {
+		t.Fatalf("a refused delete recorded an entry: %d -> %d", before, n)
+	}
+	if es := auditLog(t, e, e.Globex.Key, ""); len(es) != 0 {
+		t.Fatalf("Globex's log holds %+v", es)
+	}
+
+	for _, req := range [][2]string{{"POST", "/v1/audit-events"}, {"PATCH", "/v1/audit-events"}, {"DELETE", "/v1/audit-events"}, {"DELETE", "/v1/audit-events/aud_000001"}} {
+		if r := e.Do(req[0], req[1], e.Acme.Key, map[string]string{}); r.Code < 300 {
+			t.Fatalf("%s %s: %s", req[0], req[1], r)
+		}
+	}
+	if n := len(auditLog(t, e, e.Acme.Key, "")); n != before {
+		t.Fatalf("the log changed: %d -> %d", before, n)
+	}
+}
+
+func TestAuditRecordsNothingForFailedRequests(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	before := len(auditLog(t, e, e.Acme.Key, ""))
+	failing := []struct {
+		method, path, key string
+		body              any
+		code              int
+	}{
+		{"PATCH", "/v1/org", e.Acme.Key, map[string]any{"tax_rate_bp": 99999}, http.StatusUnprocessableEntity},
+		{"DELETE", "/v1/customers/cus_missing", e.Acme.Key, nil, http.StatusNotFound},
+		{"PATCH", "/v1/customers/" + c.ID, e.Acme.Key, "{nope", http.StatusBadRequest},
+		{"POST", "/v1/plans", e.Acme.Key, map[string]string{"name": "X", "currency": "XXX", "price": "1", "interval": "month"}, http.StatusUnprocessableEntity},
+		{"POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": c.ID, "currency": "USD", "lines": []map[string]any{}}, http.StatusUnprocessableEntity},
+		{"POST", "/v1/customers", viewer, map[string]string{"name": "V", "email": "v@example.com"}, http.StatusForbidden},
+		{"POST", "/v1/api-keys", "tly_nope", map[string]string{"name": "X"}, http.StatusUnauthorized},
+	}
+	for _, f := range failing {
+		if r := e.Do(f.method, f.path, f.key, f.body); r.Code != f.code {
+			t.Fatalf("%s %s: %s, want %d", f.method, f.path, r, f.code)
+		}
+	}
+	if n := len(auditLog(t, e, e.Acme.Key, "")); n != before {
+		t.Fatalf("failed requests recorded %d entries", n-before)
+	}
+}
