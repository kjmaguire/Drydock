diff --git a/start/internal/api/respond.go b/result/internal/api/respond.go
index f27c62b..a63f8e9 100644
--- a/start/internal/api/respond.go
+++ b/result/internal/api/respond.go
@@ -127,3 +127,25 @@ func pageOf[T any](items []T, key func(T) cursor, p page) ([]T, string) {
 	}
 	return out, next
 }
+
+// pageOfNewest is pageOf for items sorted newest first: the next page holds the items after the cursor's position, which
+// are older.
+func pageOfNewest[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	start := 0
+	if p.after != nil {
+		start = len(items)
+		for i, it := range items {
+			if key(it).less(*p.after) {
+				start = i
+				break
+			}
+		}
+	}
+	end := min(start+p.limit, len(items))
+	out := items[start:end]
+	next := ""
+	if end < len(items) && len(out) > 0 {
+		next = encodeCursor(key(out[len(out)-1]))
+	}
+	return out, next
+}
