+func TestDeleteOrgWebhookEndpointIsScoped(t *testing.T) {
+	s := New()
+	t0 := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	acme, _ := s.CreateOrg("Acme", OrgTeam, "UTC", 0, t0)
+	globex, _ := s.CreateOrg("Globex", OrgTeam, "UTC", 0, t0)
+	ep, _ := s.CreateWebhookEndpoint(WebhookEndpoint{OrgID: acme.ID, URL: "https://hooks.acme.example/", Events: []string{"*"}, Enabled: true}, t0)
+
+	if err := s.DeleteOrgWebhookEndpoint(globex.ID, ep.ID); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("another org's delete: %v", err)
+	}
+	if _, ok := s.WebhookEndpoint(acme.ID, ep.ID); !ok {
+		t.Fatal("the endpoint was deleted by another organization")
+	}
+	if err := s.DeleteOrgWebhookEndpoint(acme.ID, ep.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.WebhookEndpoint(acme.ID, ep.ID); ok {
+		t.Fatal("the endpoint is still there")
+	}
+}
