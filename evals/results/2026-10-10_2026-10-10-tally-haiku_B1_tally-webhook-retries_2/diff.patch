+	e := apitest.New(t)
+	ctx := context.Background()
+	ep := newEndpoint(t, e, e.Acme, "https://hooks.acme.example/gone", "*")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusGone, nil }
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"})
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_2"})
+	if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v (the second delivery must not be sent)", n, err)
+	}
+	if reqs := e.HTTP.Requests(); len(reqs) != 1 {
+		t.Fatalf("requests = %d, want 1", len(reqs))
+	}
+	ds := e.Store.Deliveries(e.Acme.ID, ep.ID)
+	if len(ds) != 2 {
+		t.Fatalf("deliveries = %+v", ds)
+	}
+	if ds[0].Status != store.DeliveryFailed || ds[0].Attempts != 1 || ds[0].NextAttemptAt != nil || ds[0].ResponseStatus != http.StatusGone {
+		t.Fatalf("410 delivery = %+v, want failed at once", ds[0])
+	}
+	if ds[1].Status != store.DeliveryFailed || ds[1].Attempts != 0 || ds[1].Error != "the endpoint answered 410 Gone" {
+		t.Fatalf("unsent delivery = %+v", ds[1])
+	}
+	got, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if got.Enabled || got.DisabledReason != "gone" {
+		t.Fatalf("endpoint = %+v, want disabled for gone", got)
+	}
+	if n, _ := e.Webhooks.RunDue(ctx); n != 0 || len(e.Mail.Messages()) != 0 {
+		t.Fatalf("after 410: RunDue = %d, emails = %+v", n, e.Mail.Messages())
+	}
+}
+
+func TestFailureEmailAtMostOncePerDay(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	_, _ = e.AddMember(e.Acme, "second@acme.example", store.RoleOwner)
+	newEndpoint(t, e, e.Acme, "https://hooks.acme.example/broken", "*")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusInternalServerError, nil }
+	// Two events that fail for good at the same time: one email to each of the two owners, not one per event.
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"})
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_2"})
+	runFor(t, e, 3000)
+	if got := len(e.Mail.Messages()); got != 2 {
+		t.Fatalf("emails = %d, want 2 (one per owner)", got)
+	}
+	// The endpoint keeps failing, so a later delivery that fails for good is emailed again, a day or more on.
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusInternalServerError, nil }
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_3"})
+	runFor(t, e, 3000)
+	if got := len(e.Mail.Messages()); got != 4 {
+		t.Fatalf("emails = %d, want 4", got)
+	}
+}
+
+// runFor runs the due deliveries once a minute for minutes minutes.
+func runFor(t *testing.T, e *apitest.Env, minutes int) {
+	t.Helper()
+	for i := 0; i < minutes; i++ {
+		if _, err := e.Webhooks.RunDue(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+		e.Clock.Advance(time.Minute)
 	}
 }
