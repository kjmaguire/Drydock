+
+// failForGood ends a pending delivery that will not be sent, without an attempt.
+func (s *Service) failForGood(deliveryID, reason string) {
+	_, _ = s.store.UpdateDelivery(deliveryID, func(d *store.Delivery) error {
+		if d.Status != store.DeliveryPending {
+			return nil // already ended, by an earlier answer or an earlier run
+		}
+		d.Status = store.DeliveryFailed
+		d.NextAttemptAt = nil
+		d.Error = reason
+		return nil
+	})
+}
+
+// disableGone disables an endpoint that answered 410 Gone, and ends its other pending deliveries without sending them.
+func (s *Service) disableGone(ep store.WebhookEndpoint) {
+	_, _ = s.store.UpdateWebhookEndpoint(ep.OrgID, ep.ID, func(ep *store.WebhookEndpoint) error {
+		ep.Enabled = false
+		ep.DisabledReason = "gone"
+		return nil
+	})
+	for _, d := range s.store.Deliveries(ep.OrgID, ep.ID) {
+		if d.Status == store.DeliveryPending {
+			s.failForGood(d.ID, "the endpoint answered 410 Gone")
+		}
+	}
+}
+
+// notifyFailure emails every owner of the organization that a delivery to the endpoint failed for good. It sends at most one
+// such email per endpoint in failureMailInterval.
+func (s *Service) notifyFailure(ctx context.Context, ep store.WebhookEndpoint, e store.Event, d store.Delivery) error {
+	now := s.clock.Now()
+	due := false
+	_, err := s.store.UpdateWebhookEndpoint(ep.OrgID, ep.ID, func(ep *store.WebhookEndpoint) error {
+		if ep.FailureMailedAt != nil && now.Sub(*ep.FailureMailedAt) < failureMailInterval {
+			return nil
+		}
+		ep.FailureMailedAt = &now
+		due = true
+		return nil
+	})
+	if err != nil || !due {
+		return err
+	}
+	var errs []error
+	for _, m := range s.store.Members(ep.OrgID) {
+		u, ok := s.store.User(m.UserID)
+		if m.Role != store.RoleOwner || !ok {
+			continue
+		}
+		body := fmt.Sprintf("Tally stopped trying to deliver the %s event %s to %s after %d attempts.\n\nThe last attempt failed: %s\n",
+			e.Type, e.ID, ep.URL, d.Attempts, d.Error)
+		if err := s.mail.Send(ctx, mail.Message{To: u.Email, Subject: "Webhook endpoint failing: " + ep.URL, Body: body}); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return errors.Join(errs...)
 }
 
