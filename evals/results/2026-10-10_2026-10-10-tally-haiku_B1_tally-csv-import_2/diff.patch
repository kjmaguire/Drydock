diff --git a/result/internal/store/import.go b/result/internal/store/import.go
new file mode 100644
index 0000000..ae9edfd
--- /dev/null
+++ b/result/internal/store/import.go
@@ -0,0 +1,94 @@
+package store
+
+import (
+	"strings"
+	"time"
+)
+
+// NewCustomer is a customer to create with ImportCustomers. Row is the caller's number for the record (the line it came
+// from), which a CustomerProblem refers to.
+type NewCustomer struct {
+	Row                  int
+	Name                 string
+	Email                string
+	DefaultPaymentMethod string
+	Metadata             map[string]string
+}
+
+// CustomerProblem is why one record cannot be imported: Code is missing_name, invalid_email, invalid_payment_method,
+// email_taken (an existing customer of the organization has the address) or duplicate_email (an earlier record has it).
+type CustomerProblem struct {
+	Row  int
+	Code string
+}
+
+// ImportCustomers creates customers in order, all or none. It checks every record the way CreateCustomer and
+// UpdateCustomer do, and also against the organization's existing customers and the earlier records. When any record
+// has a problem, nothing is created and every problem is returned, in order, one per record. With dryRun it only checks.
+func (s *Store) ImportCustomers(orgID string, in []NewCustomer, now time.Time, dryRun bool) ([]Customer, []CustomerProblem, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return nil, nil, ErrNotFound
+	}
+	// The email index is shared by all organizations, so it cannot answer for one of them; look at the organization's own
+	// customers instead.
+	taken := map[string]bool{}
+	for _, c := range s.customers {
+		if c.OrgID == orgID {
+			taken[normEmail(c.Email)] = true
+		}
+	}
+	var problems []CustomerProblem
+	seen := map[string]bool{}
+	for _, r := range in {
+		name, email := strings.TrimSpace(r.Name), strings.TrimSpace(r.Email)
+		key := normEmail(email)
+		var code string
+		switch {
+		case name == "":
+			code = "missing_name"
+		case !validEmail(email):
+			code = "invalid_email"
+		case r.DefaultPaymentMethod != "" && !strings.HasPrefix(r.DefaultPaymentMethod, "pm_"):
+			code = "invalid_payment_method"
+		case taken[key]:
+			code = "email_taken"
+		case seen[key]:
+			code = "duplicate_email"
+		}
+		if code != "" {
+			problems = append(problems, CustomerProblem{Row: r.Row, Code: code})
+		}
+		seen[key] = true
+	}
+	if len(problems) > 0 || dryRun {
+		return nil, problems, nil
+	}
+	out := make([]Customer, 0, len(in))
+	for _, r := range in {
+		c := Customer{
+			ID:                   s.newID("cus"),
+			OrgID:                orgID,
+			Name:                 strings.TrimSpace(r.Name),
+			Email:                strings.TrimSpace(r.Email),
+			DefaultPaymentMethod: r.DefaultPaymentMethod,
+			CreatedAt:            now.UTC(),
+		}
+		if len(r.Metadata) > 0 {
+			c.Metadata = copyMetadata(r.Metadata)
+		}
+		s.customers[c.ID] = c
+		s.customersByEmail[normEmail(c.Email)] = c.ID
+		out = append(out, copyCustomer(c))
+	}
+	return out, nil, nil
+}
+
+func copyMetadata(m map[string]string) map[string]string {
+	out := make(map[string]string, len(m))
+	for k, v := range m {
+		out[k] = v
+	}
+	return out
+}
diff --git a/result/internal/store/import_test.go b/result/internal/store/import_test.go
new file mode 100644
index 0000000..8e6be2c
--- /dev/null
+++ b/result/internal/store/import_test.go
@@ -0,0 +1,62 @@
+package store
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestImportCustomers(t *testing.T) {
+	s := New()
+	acme := newOrg(t, s, "Acme")
+	globex := newOrg(t, s, "Globex")
+	if _, err := s.CreateCustomer(acme.ID, "Jane", "jane@example.com", t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateCustomer(globex.ID, "Other", "other@example.com", t0); err != nil {
+		t.Fatal(err)
+	}
+
+	bad := []NewCustomer{
+		{Row: 2, Name: "John", Email: "john@example.com"},
+		{Row: 3, Name: "Jane 2", Email: "JANE@example.com"},
+		{Row: 4, Name: "Other", Email: "other@example.com"}, // another organization's customer
+		{Row: 5, Name: "Ann", Email: "ann@example.com", DefaultPaymentMethod: "card_1"},
+		{Row: 6, Name: "Ann 2", Email: "Ann@example.com"},
+		{Row: 7, Name: "", Email: "x@example.com"},
+	}
+	want := []CustomerProblem{
+		{Row: 3, Code: "email_taken"},
+		{Row: 5, Code: "invalid_payment_method"},
+		{Row: 6, Code: "duplicate_email"},
+		{Row: 7, Code: "missing_name"},
+	}
+	created, problems, err := s.ImportCustomers(acme.ID, bad, t0, false)
+	if err != nil || created != nil || !reflect.DeepEqual(problems, want) {
+		t.Fatalf("import = %v, %v, %v", created, problems, err)
+	}
+	if n := len(s.Customers(acme.ID)); n != 1 {
+		t.Fatalf("a refused import created customers: %d", n)
+	}
+
+	good := []NewCustomer{
+		{Row: 2, Name: " John ", Email: " john@example.com ", Metadata: map[string]string{"crm": "9"}},
+		{Row: 3, Name: "Ann", Email: "ann@example.com", DefaultPaymentMethod: "pm_1"},
+	}
+	_, problems, err = s.ImportCustomers(acme.ID, good, t0, true)
+	if err != nil || problems != nil || len(s.Customers(acme.ID)) != 1 {
+		t.Fatalf("dry run = %v, %v", problems, err)
+	}
+	created, problems, err = s.ImportCustomers(acme.ID, good, t0, false)
+	if err != nil || problems != nil || len(created) != 2 {
+		t.Fatalf("import = %v, %v, %v", created, problems, err)
+	}
+	if created[0].Name != "John" || created[0].Email != "john@example.com" || created[0].Metadata["crm"] != "9" || created[0].OrgID != acme.ID {
+		t.Fatalf("created[0] = %+v", created[0])
+	}
+	if c, ok := s.FindCustomerByEmail(acme.ID, "ANN@example.com"); !ok || c.ID != created[1].ID {
+		t.Fatalf("the imported customer is not found by email: %+v", c)
+	}
+	if _, _, err := s.ImportCustomers("org_nope", good, t0, false); err != ErrNotFound {
+		t.Fatalf("unknown org: %v", err)
+	}
+}
