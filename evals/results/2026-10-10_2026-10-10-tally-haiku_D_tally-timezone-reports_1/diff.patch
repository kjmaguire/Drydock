+	}
+	want := Report{TimeZone: "UTC", Group: GroupMonth, Buckets: []Bucket{
+		{Start: "2026-01-01", Amounts: map[money.Currency]int64{money.USD: 50}, Payments: 1},
+		{Start: "2026-02-01", Amounts: map[money.Currency]int64{}, Payments: 0},
+		{Start: "2026-03-01", Amounts: map[money.Currency]int64{money.USD: 70}, Payments: 1},
+	}}
+	if g, w := mustJSON(t, rep), mustJSON(t, want); g != w {
+		t.Fatalf("report = %s, want %s", g, w)
+	}
+}
+
+func TestRevenueReportDefaultGroup(t *testing.T) {
