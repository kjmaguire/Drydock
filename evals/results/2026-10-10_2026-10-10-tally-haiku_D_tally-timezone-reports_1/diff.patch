+		out = append(out, DayRevenue{Date: k.day, Currency: k.cur, Amount: t.amount, Payments: t.payments})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Date != out[j].Date {
+			return out[i].Date < out[j].Date
+		}
+		return out[i].Currency < out[j].Currency
+	})
+	return out, nil
+}
+
+// RevenueReport adds up the organization's succeeded payments per bucket of group (day, week or month, "" for day) and
+// currency, for the days from to to in the organization's time zone (both included). A week starts on Monday, a bucket is
+// named by its first day, and every bucket from the one holding from to the one holding to is in the report, in order.
+func RevenueReport(st *store.Store, orgID, from, to, group string) (Report, error) {
+	start, last, err := parseRange(from, to)
+	if err != nil {
+		return Report{}, err
+	}
+	g := Group(group)
+	switch g {
+	case "":
+		g = GroupDay
+	case GroupDay, GroupWeek, GroupMonth:
+	default:
+		return Report{}, fmt.Errorf("%w: %q", ErrInvalidGroup, group)
+	}
+	name, loc := orgLocation(st, orgID)
+	rep := Report{TimeZone: name, Group: g, Buckets: []Bucket{}}
+	index := map[string]int{}
+	for b, end := bucketStart(start, g), bucketStart(last, g); !b.After(end); b = nextBucket(b, g) {
+		index[b.Format(time.DateOnly)] = len(rep.Buckets)
+		rep.Buckets = append(rep.Buckets, Bucket{Start: b.Format(time.DateOnly), Amounts: map[money.Currency]int64{}})
+	}
