+	}
+}
+
+func TestRevenueReportErrors(t *testing.T) {
+	st := store.New()
+	for _, c := range []struct {
+		from, to, group string
+		want            error
+	}{
+		{"2026-03-01", "2026/03/05", "day", ErrInvalidDate},
+		{"2026-03-05", "2026-03-01", "day", ErrInvalidRange},
+		{"2026-01-01", "2027-01-02", "day", ErrInvalidRange},
+		{"2026-03-01", "2026-03-05", "fortnight", ErrInvalidGroup},
+		{"2026-03-01", "2026-03-05", "Week", ErrInvalidGroup},
