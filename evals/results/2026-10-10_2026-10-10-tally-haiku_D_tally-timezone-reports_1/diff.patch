+// reportOrg returns a store with an organization in the time zone tz, and a function that records a payment for it.
+func reportOrg(t *testing.T, tz string) (*store.Store, string, func(int64, money.Currency, store.PaymentStatus, time.Time)) {
+	t.Helper()
+	st := store.New()
+	at := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	o, err := st.CreateOrg("A", store.OrgTeam, tz, 0, at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, _ := st.CreateCustomer(o.ID, "Jane", "jane@example.com", at)
+	inv, _ := st.CreateInvoice(store.Invoice{OrgID: o.ID, CustomerID: c.ID, Currency: money.USD, Lines: []store.Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, at)
+	pay := func(amount int64, cur money.Currency, status store.PaymentStatus, when time.Time) {
+		t.Helper()
+		if _, err := st.CreatePayment(store.Payment{OrgID: o.ID, InvoiceID: inv.ID, Amount: amount, Currency: cur, Status: status}, when); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return st, o.ID, pay
+}
+
+func TestRevenueInOrganizationTimeZone(t *testing.T) {
+	ny, err := time.LoadLocation("America/New_York")
+	if err != nil {
+		t.Fatal(err)
+	}
+	st, orgID, pay := reportOrg(t, "America/New_York")
+	local := func(month time.Month, d, h, m int) time.Time { return time.Date(2026, month, d, h, m, 0, 0, ny) }
+	pay(1000, money.USD, store.PaymentSucceeded, local(3, 2, 21, 0)) // March 3 in UTC
+	// March 8 2026 is the day daylight saving time starts in New York, so it is 23 hours long.
+	pay(200, money.USD, store.PaymentSucceeded, local(3, 8, 0, 30))
+	pay(300, money.USD, store.PaymentSucceeded, local(3, 8, 23, 30)) // March 9 in UTC
+	pay(400, money.USD, store.PaymentSucceeded, local(3, 9, 0, 10))
+
+	got, err := Revenue(st, orgID, "2026-03-02", "2026-03-09")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []DayRevenue{
+		{Date: "2026-03-02", Currency: money.USD, Amount: 1000, Payments: 1},
+		{Date: "2026-03-08", Currency: money.USD, Amount: 500, Payments: 2},
+		{Date: "2026-03-09", Currency: money.USD, Amount: 400, Payments: 1},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("Revenue = %+v", got)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("day %d = %+v, want %+v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestRevenueReportWeeks(t *testing.T) {
+	st, orgID, pay := reportOrg(t, "UTC")
+	day := func(month time.Month, d int) time.Time { return time.Date(2026, month, d, 12, 0, 0, 0, time.UTC) }
+	pay(900, money.USD, store.PaymentSucceeded, day(2, 27)) // before from, in the week that starts February 23
+	pay(100, money.USD, store.PaymentSucceeded, day(3, 1))  // a Sunday, the last day of the week that starts February 23
+	pay(200, money.USD, store.PaymentSucceeded, day(3, 2))  // a Monday
+	pay(300, money.USD, store.PaymentSucceeded, day(3, 8))
+	pay(400, money.EUR, store.PaymentSucceeded, day(3, 9))
+	pay(500, money.USD, store.PaymentFailed, day(3, 9))
+
+	rep, err := RevenueReport(st, orgID, "2026-03-01", "2026-03-16", "week")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := Report{TimeZone: "UTC", Group: GroupWeek, Buckets: []Bucket{
+		{Start: "2026-02-23", Amounts: map[money.Currency]int64{money.USD: 100}, Payments: 1},
+		{Start: "2026-03-02", Amounts: map[money.Currency]int64{money.USD: 500}, Payments: 2},
+		{Start: "2026-03-09", Amounts: map[money.Currency]int64{money.EUR: 400}, Payments: 1},
+		{Start: "2026-03-16", Amounts: map[money.Currency]int64{}, Payments: 0},
+	}}
+	if g, w := mustJSON(t, rep), mustJSON(t, want); g != w {
+		t.Fatalf("report = %s, want %s", g, w)
+	}
+}
+
+func TestRevenueReportMonths(t *testing.T) {
+	st, orgID, pay := reportOrg(t, "UTC")
+	pay(999, money.USD, store.PaymentSucceeded, time.Date(2026, 1, 10, 12, 0, 0, 0, time.UTC)) // before from
+	pay(50, money.USD, store.PaymentSucceeded, time.Date(2026, 1, 20, 12, 0, 0, 0, time.UTC))
+	pay(70, money.USD, store.PaymentSucceeded, time.Date(2026, 3, 2, 12, 0, 0, 0, time.UTC))
