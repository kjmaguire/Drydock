+package api_test
+
+import (
+	"net/http"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// keyID returns the ID of the API key with this token.
+func keyID(t *testing.T, e *apitest.Env, token string) string {
+	t.Helper()
+	k, ok := e.Store.APIKeyByToken(token)
+	if !ok {
+		t.Fatalf("no key for token %q", token)
+	}
+	return k.ID
+}
+
+// auditList answers the entries the caller can read for the query (for example "?limit=100"), and the next cursor.
+func auditList(t *testing.T, e *apitest.Env, key, query string) ([]store.AuditEntry, string) {
+	t.Helper()
+	var out struct {
+		Items      []store.AuditEntry `json:"items"`
+		NextCursor string             `json:"next_cursor"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events"+query, key, nil, &out)
+	return out.Items, out.NextCursor
+}
+
+func TestAuditLogRecordsSuccessfulChanges(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	owner := keyID(t, e, key)
+
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, key, map[string]any{"name": "Jane Q. Doe", "metadata": map[string]string{"crm": "7"}}, nil)
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", key, map[string]any{"customer_id": c.ID, "plan_id": p.ID}, &sub)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, key, map[string]any{"quantity": 5}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/plans/"+p.ID, key, map[string]any{"active": false}, nil)
+	var paidInv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 1000}}}, &paidInv)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+paidInv.ID+"/pay", key, map[string]string{"payment_method": "pm_card_visa"}, nil)
+	var voidInv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Extra", "quantity": 1, "unit_amount": 500}}}, &voidInv)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+voidInv.ID+"/void", key, nil, nil)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", key, nil, nil)
+	var k store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", key, map[string]string{"name": "CI"}, &k)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+k.ID, key, nil, nil)
+	var inv store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "new@people.example", "role": "member"}, &inv)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+inv.ID, key, nil, nil)
+	member, _ := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+member.ID, key, map[string]string{"role": "member"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+member.ID, key, nil, nil)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, key, map[string]any{"enabled": false}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+ep.ID, key, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", key, map[string]any{"tax_rate_bp": 2000, "time_zone": "Asia/Tokyo"}, nil)
+
+	// The last change is made a while later, with a request ID of the caller's own.
+	e.Clock.Advance(time.Hour)
+	r := e.DoWith("DELETE", "/v1/customers/"+c.ID, key, nil, http.Header{"X-Request-Id": {"req-final"}})
+	if r.Code != http.StatusNoContent {
+		t.Fatalf("delete customer: %s", r)
+	}
+
+	// The subscription's first invoice is not a request, so it is not logged.
+	type want struct {
+		action, target string
+		changed        []string // nil for changes that are not updates
+	}
+	wants := []want{
+		{"customer.created", "customer", nil},
+		{"customer.updated", "customer", []string{"metadata", "name"}},
+		{"plan.created", "plan", nil},
+		{"subscription.created", "subscription", nil},
+		{"subscription.updated", "subscription", []string{"quantity"}},
+		{"plan.updated", "plan", []string{"active"}},
+		{"invoice.created", "invoice", nil},
+		{"invoice.paid", "invoice", nil},
+		{"invoice.created", "invoice", nil},
+		{"invoice.voided", "invoice", nil},
+		{"subscription.canceled", "subscription", nil},
+		{"api_key.created", "api_key", nil},
+		{"api_key.revoked", "api_key", nil},
+		{"invite.created", "invite", nil},
+		{"invite.revoked", "invite", nil},
+		{"member.role_changed", "member", []string{"role"}},
+		{"member.removed", "member", nil},
+		{"webhook_endpoint.created", "webhook_endpoint", nil},
+		{"webhook_endpoint.updated", "webhook_endpoint", []string{"enabled"}},
+		{"webhook_endpoint.deleted", "webhook_endpoint", nil},
+		{"org.updated", "org", []string{"tax_rate_bp", "time_zone"}},
+		{"customer.deleted", "customer", nil},
+	}
+	entries, next := auditList(t, e, key, "?limit=100")
+	if next != "" || len(entries) != len(wants) {
+		t.Fatalf("%d entries, next %q; want %d", len(entries), next, len(wants))
+	}
+	for i, w := range wants {
+		got := entries[len(entries)-1-i] // newest first
+		if got.Action != w.action || got.Target.Type != w.target || got.Target.ID == "" {
+			t.Fatalf("entry %d = %+v; want %s on %s", i, got, w.action, w.target)
+		}
+		if got.Actor.Type != "api_key" || got.Actor.ID != owner || got.Actor.UserID != e.Acme.Owner.ID {
+			t.Fatalf("entry %d actor = %+v", i, got.Actor)
+		}
+		if w.changed == nil {
+			if got.Changes != nil {
+				t.Fatalf("entry %d (%s) has changes %v", i, w.action, *got.Changes)
+			}
+			continue
+		}
+		if got.Changes == nil {
+			t.Fatalf("entry %d (%s) has no changes", i, w.action)
+		}
+		var names []string
+		for name := range *got.Changes {
+			names = append(names, name)
+		}
+		sort.Strings(names)
+		if strings.Join(names, ",") != strings.Join(w.changed, ",") {
+			t.Fatalf("entry %d (%s) changed %v; want %v", i, w.action, names, w.changed)
+		}
+	}
+
+	first, last := entries[len(entries)-1], entries[0]
+	if first.Target.ID != c.ID || first.Changes != nil {
+		t.Fatalf("first entry = %+v", first)
+	}
+	find := func(action string) store.AuditEntry {
+		for _, en := range entries {
+			if en.Action == action {
+				return en
+			}
+		}
+		t.Fatalf("no %s entry", action)
+		return store.AuditEntry{}
+	}
+	if ch := *find("customer.updated").Changes; ch["name"].From != "Jane" || ch["name"].To != "Jane Q. Doe" || ch["metadata"].From != nil {
+		t.Fatalf("customer changes = %+v", ch)
+	}
+	if ch := *find("org.updated").Changes; ch["tax_rate_bp"].From != float64(0) || ch["tax_rate_bp"].To != float64(2000) || ch["time_zone"].To != "Asia/Tokyo" {
+		t.Fatalf("org changes = %+v", ch)
+	}
+	if last.Action != "customer.deleted" || last.RequestID != "req-final" || !last.At.Equal(apitest.Start.Add(time.Hour)) {
+		t.Fatalf("last entry = %+v", last)
+	}
+	if first.RequestID == "" || !regexp.MustCompile(`^req_[0-9a-f]{16}$`).MatchString(first.RequestID) {
+		t.Fatalf("request id %q", first.RequestID)
+	}
+}
+
+func TestAuditLogRecordsNothingForFailures(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	var inv, voided store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 1000}}}, &inv)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Extra", "quantity": 1, "unit_amount": 500}}}, &voided)
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+voided.ID+"/void", key, nil, nil)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+
+	// A webhook endpoint of Globex, which Acme must not be able to delete.
+	var globex store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Globex.Key, map[string]any{"url": "https://hooks.globex.example/tally", "events": []string{"*"}}, &globex)
+
+	before, _ := auditList(t, e, key, "?limit=100")
+	failures := []struct {
+		method, path, key string
+		body              any
+		want              int
+	}{
+		{"PATCH", "/v1/customers/cus_999999", key, map[string]string{"name": "X"}, http.StatusNotFound},
+		{"PATCH", "/v1/customers/" + c.ID, key, map[string]string{"email": "not an email"}, http.StatusUnprocessableEntity},
+		{"POST", "/v1/customers", viewer, map[string]string{"name": "X", "email": "x@example.com"}, http.StatusForbidden},
+		{"POST", "/v1/plans", key, map[string]string{"name": "Bad", "currency": "USD", "price": "ten", "interval": "month"}, http.StatusUnprocessableEntity},
+		{"PATCH", "/v1/org", key, map[string]string{"time_zone": "Not/AZone"}, http.StatusUnprocessableEntity},
+		{"POST", "/v1/invites", key, map[string]string{"email": "owner@acme.example", "role": "member"}, http.StatusConflict},
+		{"POST", "/v1/invoices/" + inv.ID + "/pay", key, map[string]string{"payment_method": "pm_card_declined"}, http.StatusPaymentRequired},
+		{"POST", "/v1/invoices/" + voided.ID + "/void", key, nil, http.StatusConflict},
+		{"DELETE", "/v1/webhook-endpoints/" + globex.ID, key, nil, http.StatusNotFound},
+	}
+	for _, f := range failures {
+		if r := e.Do(f.method, f.path, f.key, f.body); r.Code != f.want {
+			t.Fatalf("%s %s: want %d, got %s", f.method, f.path, f.want, r)
+		}
+	}
+	if _, ok := e.Store.WebhookEndpoint(e.Globex.ID, globex.ID); !ok {
+		t.Fatal("a key of Acme deleted an endpoint of Globex")
+	}
+	after, _ := auditList(t, e, key, "?limit=100")
+	if len(after) != len(before) {
+		t.Fatalf("%d entries after the failures, %d before", len(after), len(before))
+	}
+}
+
+func TestAuditLogHoldsNoSecrets(t *testing.T) {
+	e := apitest.New(t)
+	key := e.Acme.Key
+	var k store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", key, map[string]string{"name": "CI"}, &k)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/webhook-endpoints/"+ep.ID, key, map[string]any{"url": "https://hooks.acme.example/v2"}, nil)
+	var inv store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", key, map[string]string{"email": "new@people.example", "role": "member"}, &inv)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+k.ID, key, nil, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+inv.ID, key, nil, nil)
+
+	r := e.Do("GET", "/v1/audit-events?limit=100", key, nil)
+	if !strings.Contains(string(r.Body), `"action":"webhook_endpoint.updated"`) {
+		t.Fatalf("the log has no entries to check: %s", r)
+	}
+	for _, secret := range []string{k.Token, ep.Secret, inv.Token, key} {
+		if strings.Contains(string(r.Body), secret) {
+			t.Fatalf("the log shows the secret %q: %s", secret, r)
+		}
+	}
+}
+
+func TestAuditEventsAccessFiltersAndPaging(t *testing.T) {
+	e := apitest.New(t)
+	owner := e.Acme.Key
+	for _, role := range []store.Role{store.RoleViewer, store.RoleMember, store.RoleBilling} {
+		_, key := e.AddMember(e.Acme, string(role)+"@acme.example", role)
+		r := e.Do("GET", "/v1/audit-events", key, nil)
+		if r.Code != http.StatusForbidden || strings.TrimSpace(string(r.Body)) != `{"error":"forbidden"}` {
+			t.Fatalf("%s reads the log: %s", role, r)
+		}
+	}
+	adminUser, admin := e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	adminOrg := apitest.Org{Org: e.Acme.Org, Owner: adminUser, Key: admin}
+
+	c1 := e.CreateCustomer(e.Acme, "A", "a@example.com")
+	c2 := e.CreateCustomer(e.Acme, "B", "b@example.com")
+	c3 := e.CreateCustomer(e.Acme, "C", "c@example.com")
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c1.ID, owner, map[string]string{"name": "A2"}, nil)
+	c4 := e.CreateCustomer(adminOrg, "D", "d@example.com")
+
+	all, _ := auditList(t, e, admin, "?limit=100")
+	if len(all) != 5 || all[0].Target.ID != c4.ID || all[0].Actor.UserID != adminUser.ID {
+		t.Fatalf("admin reads %d entries, newest %+v", len(all), all[0])
+	}
+	if got, _ := auditList(t, e, owner, "?action=customer.created"); len(got) != 4 {
+		t.Fatalf("by action: %d entries", len(got))
+	}
+	if got, _ := auditList(t, e, owner, "?target_id="+c2.ID); len(got) != 1 || got[0].Action != "customer.created" {
+		t.Fatalf("by target: %+v", got)
+	}
+	if got, _ := auditList(t, e, owner, "?actor_id="+adminUser.ID); len(got) != 1 || got[0].Target.ID != c4.ID {
+		t.Fatalf("by user: %+v", got)
+	}
+	if got, _ := auditList(t, e, owner, "?actor_id="+keyID(t, e, admin)); len(got) != 1 || got[0].Target.ID != c4.ID {
+		t.Fatalf("by key: %+v", got)
+	}
+	if got, _ := auditList(t, e, owner, "?action=customer.created&actor_id="+keyID(t, e, owner)); len(got) != 3 {
+		t.Fatalf("by action and key: %d entries", len(got))
+	}
+	r := e.Do("GET", "/v1/audit-events?action=plan.created", owner, nil)
+	if r.Code != http.StatusOK || !strings.Contains(string(r.Body), `"items":[]`) {
+		t.Fatalf("no matches: %s", r)
+	}
+
+	// Pages of the customers created, newest first.
+	var ids []string
+	items, next := auditList(t, e, owner, "?action=customer.created&limit=3")
+	for _, it := range items {
+		ids = append(ids, it.Target.ID)
+	}
+	if len(items) != 3 || next == "" {
+		t.Fatalf("first page: %d entries, next %q", len(items), next)
+	}
+	items, next = auditList(t, e, owner, "?action=customer.created&limit=3&cursor="+next)
+	for _, it := range items {
+		ids = append(ids, it.Target.ID)
+	}
+	if next != "" || strings.Join(ids, ",") != strings.Join([]string{c4.ID, c3.ID, c2.ID, c1.ID}, ",") {
+		t.Fatalf("paged = %v, next %q", ids, next)
+	}
+	if r := e.Do("GET", "/v1/audit-events?cursor=bogus", owner, nil); r.Code != http.StatusBadRequest {
+		t.Fatalf("bad cursor: %s", r)
+	}
+}
