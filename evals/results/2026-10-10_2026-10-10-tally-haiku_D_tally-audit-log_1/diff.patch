+package api
+
+import (
+	"net/http"
+	"reflect"
+	"sort"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// audit records that the caller changed a target. Handlers call it only once the change has succeeded. changes is set
+// for updates (even when nothing changed) and nil otherwise.
+func (s *Server) audit(r *http.Request, p auth.Principal, action, targetType, targetID string, changes map[string]store.AuditChange) {
+	e := store.AuditEntry{
+		Action:    action,
+		Actor:     store.AuditActor{Type: "api_key", ID: p.KeyID, UserID: p.UserID},
+		Target:    store.AuditTarget{Type: targetType, ID: targetID},
+		RequestID: RequestID(r.Context()),
+	}
+	if changes != nil {
+		e.Changes = &changes
+	}
+	if _, err := s.store.AddAuditEntry(p.OrgID, e, s.clock.Now()); err != nil {
+		s.log.Error("audit", "action", action, "err", err)
+	}
+}
+
+// changeSet holds the fields of an update whose values differ.
+type changeSet map[string]store.AuditChange
+
+// field records name as changed when its value differs between before and after.
+func (c changeSet) field(name string, before, after any) {
+	if !reflect.DeepEqual(before, after) {
+		c[name] = store.AuditChange{From: before, To: after}
+	}
+}
+
+func auditKey(e store.AuditEntry) cursor { return cursor{T: e.At, ID: e.ID} }
+
+// listAuditEvents lists the organization's audit entries, newest first: ?action= , ?target_id= and ?actor_id= (a user ID or
+// an API key ID) narrow them. Only owners and admins may read the log.
+func (s *Server) listAuditEvents(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	if !auth.CanManageTeam(p.Role) {
+		writeJSON(w, http.StatusForbidden, map[string]string{"error": "forbidden"})
+		return
+	}
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	q := r.URL.Query()
+	entries := s.store.AuditEntries(p.OrgID, store.AuditFilter{Action: q.Get("action"), TargetID: q.Get("target_id"), ActorID: q.Get("actor_id")})
+	items, next := pageNewestFirst(entries, pg)
+	writeJSON(w, http.StatusOK, list{Items: items, NextCursor: next})
+}
+
+// pageNewestFirst returns one page of entries that are sorted newest first, and the cursor of the next page. A cursor
+// starts the page after the entry it names, so the page holds the entries older than it.
+func pageNewestFirst(items []store.AuditEntry, p page) ([]store.AuditEntry, string) {
+	start := 0
+	if p.after != nil {
+		start = sort.Search(len(items), func(i int) bool { return auditKey(items[i]).less(*p.after) })
+	}
+	end := min(start+p.limit, len(items))
+	out := items[start:end]
+	next := ""
+	if end < len(items) && len(out) > 0 {
+		next = encodeCursor(auditKey(out[len(out)-1]))
+	}
+	return out, next
+}
