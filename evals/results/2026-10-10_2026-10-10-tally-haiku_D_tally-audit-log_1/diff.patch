diff --git a/result/internal/store/audit.go b/result/internal/store/audit.go
new file mode 100644
index 0000000..21fd5b4
--- /dev/null
+++ b/result/internal/store/audit.go
@@ -0,0 +1,81 @@
+package store
+
+import (
+	"sort"
+	"time"
+)
+
+// AuditEntry records a successful change that a member, through an API key, made to an organization. Entries are only
+// ever added: nothing changes or deletes one.
+type AuditEntry struct {
+	ID        string      `json:"id"`
+	OrgID     string      `json:"-"`
+	Action    string      `json:"action"` // for example "customer.updated"
+	Actor     AuditActor  `json:"actor"`
+	Target    AuditTarget `json:"target"`
+	RequestID string      `json:"request_id"`
+	At        time.Time   `json:"at"`
+	// Changes is set for *.updated, member.role_changed and org.updated, even when empty. It is keyed by JSON field name.
+	Changes *map[string]AuditChange `json:"changes,omitempty"`
+}
+
+// AuditActor is the API key that made a change, and the member it acts for.
+type AuditActor struct {
+	Type   string `json:"type"` // "api_key"
+	ID     string `json:"id"`
+	UserID string `json:"user_id"`
+}
+
+// AuditTarget is the object a change was made to.
+type AuditTarget struct {
+	Type string `json:"type"`
+	ID   string `json:"id"`
+}
+
+// AuditChange is one field's value before and after a change.
+type AuditChange struct {
+	From any `json:"from"`
+	To   any `json:"to"`
+}
+
+// AuditFilter selects audit entries. Empty fields match everything. ActorID is a user ID or an API key ID.
+type AuditFilter struct {
+	Action   string
+	TargetID string
+	ActorID  string
+}
+
+// AddAuditEntry appends an entry to an organization's audit log. The ID and the time are set here.
+func (s *Store) AddAuditEntry(orgID string, e AuditEntry, now time.Time) (AuditEntry, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return AuditEntry{}, ErrNotFound
+	}
+	e.ID, e.OrgID, e.At = s.newID("aud"), orgID, now.UTC()
+	s.audit = append(s.audit, e)
+	return e, nil
+}
+
+// AuditEntries returns an organization's audit entries that match f, newest first.
+func (s *Store) AuditEntries(orgID string, f AuditFilter) []AuditEntry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []AuditEntry{}
+	for _, e := range s.audit {
+		if e.OrgID != orgID || (f.Action != "" && e.Action != f.Action) || (f.TargetID != "" && e.Target.ID != f.TargetID) {
+			continue
+		}
+		if f.ActorID != "" && e.Actor.ID != f.ActorID && e.Actor.UserID != f.ActorID {
+			continue
+		}
+		out = append(out, e)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].At.Equal(out[j].At) {
+			return out[i].At.After(out[j].At)
+		}
+		return out[i].ID > out[j].ID
+	})
+	return out
+}
diff --git a/result/internal/store/audit_test.go b/result/internal/store/audit_test.go
new file mode 100644
index 0000000..9b5f1c8
--- /dev/null
+++ b/result/internal/store/audit_test.go
@@ -0,0 +1,56 @@
+package store
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestAuditLog(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	if _, err := s.AddAuditEntry("org_missing", AuditEntry{Action: "plan.created"}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("an entry for an unknown organization: %v", err)
+	}
+	first, err := s.AddAuditEntry(a.ID, AuditEntry{Action: "plan.created", Actor: AuditActor{Type: "api_key", ID: "key_1", UserID: "usr_1"},
+		Target: AuditTarget{Type: "plan", ID: "pl_1"}}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	changes := map[string]AuditChange{"name": {From: "Team", To: "Team Plus"}}
+	second, err := s.AddAuditEntry(a.ID, AuditEntry{Action: "plan.updated", Actor: AuditActor{Type: "api_key", ID: "key_2", UserID: "usr_2"},
+		Target: AuditTarget{Type: "plan", ID: "pl_1"}, Changes: &changes}, t0.Add(time.Minute))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.AddAuditEntry(b.ID, AuditEntry{Action: "plan.created"}, t0); err != nil {
+		t.Fatal(err)
+	}
+
+	got := s.AuditEntries(a.ID, AuditFilter{})
+	if !reflect.DeepEqual(got, []AuditEntry{second, first}) {
+		t.Fatalf("entries = %+v", got)
+	}
+	if got := s.AuditEntries(a.ID, AuditFilter{ActorID: "usr_2"}); len(got) != 1 || got[0].ID != second.ID {
+		t.Fatalf("by user = %+v", got)
+	}
+	if got := s.AuditEntries(a.ID, AuditFilter{ActorID: "key_1", Action: "plan.created"}); len(got) != 1 || got[0].ID != first.ID {
+		t.Fatalf("by key and action = %+v", got)
+	}
+	if got := s.AuditEntries(a.ID, AuditFilter{TargetID: "pl_2"}); len(got) != 0 {
+		t.Fatalf("by target = %+v", got)
+	}
+
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(s2.AuditEntries(a.ID, AuditFilter{}), got) {
+		t.Fatal("the audit log changed in a snapshot round trip")
+	}
+	if next, _ := s2.AddAuditEntry(a.ID, AuditEntry{Action: "plan.created"}, t0); next.ID == first.ID || next.ID == second.ID {
+		t.Fatal("IDs restart after FromState")
+	}
+}
