+package api_test
+
+import (
+	"net/http"
+	"net/url"
+	"slices"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// IDs that no organization has. Another organization's ID must be answered exactly as one of these is.
+const (
+	unknownInvoice      = "in_999999"
+	unknownCustomer     = "cus_999999"
+	unknownPlan         = "plan_999999"
+	unknownSubscription = "sub_999999"
+	unknownEndpoint     = "we_999999"
+	unknownEvent        = "evt_999999"
+)
+
+func invoiceBody(customer string) map[string]any {
+	return map[string]any{"customer_id": customer, "currency": "USD", "lines": []map[string]any{{"description": "Consulting", "quantity": 1, "unit_amount": 10000}}}
+}
+
+// TestAnotherOrganizationsIDsAreNotFound checks that an ID of another organization gets the same answer as an unknown ID,
+// wherever the ID is named: in the path, in the body or in the query. The caller is the other organization.
+func TestAnotherOrganizationsIDsAreNotFound(t *testing.T) {
+	e := apitest.New(t)
+	acmeCustomer := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	acmePlan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	globexCustomer := e.CreateCustomer(e.Globex, "Gina", "gina@globex.example")
+	globexPlan := e.CreatePlan(e.Globex, "Biz", "USD", "20.00")
+
+	var acmeInvoice store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, invoiceBody(acmeCustomer.ID), &acmeInvoice)
+	var acmeSub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": acmeCustomer.ID, "plan_id": acmePlan.ID}, &acmeSub)
+	var acmeEndpoint store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &acmeEndpoint)
+	acmeEvent := e.Store.Events(e.Acme.ID, "invoice.created")[0]
+
+	type probe struct {
+		name, key, method, path string
+		id, unknown             string
+		body                    func(id string) any
+		// list is set for a query that names an ID: the answer is an empty list, not a 404.
+		list bool
+	}
+	noBody := func(string) any { return nil }
+	probes := []probe{
+		{name: "get invoice", key: e.Globex.Key, method: "GET", path: "/v1/invoices/{id}", id: acmeInvoice.ID, unknown: unknownInvoice, body: noBody},
+		// The invoice lines leak: this answered 200 with another organization's lines.
+		{name: "get invoice lines", key: e.Globex.Key, method: "GET", path: "/v1/invoices/{id}/lines", id: acmeInvoice.ID, unknown: unknownInvoice, body: noBody},
+		{name: "pay invoice", key: e.Globex.Key, method: "POST", path: "/v1/invoices/{id}/pay", id: acmeInvoice.ID, unknown: unknownInvoice,
+			body: func(string) any { return map[string]string{"payment_method": "pm_card_visa"} }},
+		{name: "void invoice", key: e.Globex.Key, method: "POST", path: "/v1/invoices/{id}/void", id: acmeInvoice.ID, unknown: unknownInvoice, body: noBody},
+		{name: "get customer", key: e.Globex.Key, method: "GET", path: "/v1/customers/{id}", id: acmeCustomer.ID, unknown: unknownCustomer, body: noBody},
+		{name: "update customer", key: e.Globex.Key, method: "PATCH", path: "/v1/customers/{id}", id: acmeCustomer.ID, unknown: unknownCustomer,
+			body: func(string) any { return map[string]string{"name": "Changed"} }},
+		{name: "delete customer", key: e.Globex.Key, method: "DELETE", path: "/v1/customers/{id}", id: acmeCustomer.ID, unknown: unknownCustomer, body: noBody},
+		{name: "get plan", key: e.Globex.Key, method: "GET", path: "/v1/plans/{id}", id: acmePlan.ID, unknown: unknownPlan, body: noBody},
+		{name: "update plan", key: e.Globex.Key, method: "PATCH", path: "/v1/plans/{id}", id: acmePlan.ID, unknown: unknownPlan,
+			body: func(string) any { return map[string]string{"name": "Changed"} }},
+		{name: "get subscription", key: e.Globex.Key, method: "GET", path: "/v1/subscriptions/{id}", id: acmeSub.ID, unknown: unknownSubscription, body: noBody},
+		{name: "update subscription", key: e.Globex.Key, method: "PATCH", path: "/v1/subscriptions/{id}", id: acmeSub.ID, unknown: unknownSubscription,
+			body: func(string) any { return map[string]int{"quantity": 9} }},
+		{name: "cancel subscription", key: e.Globex.Key, method: "POST", path: "/v1/subscriptions/{id}/cancel", id: acmeSub.ID, unknown: unknownSubscription, body: noBody},
+		{name: "report usage", key: e.Globex.Key, method: "POST", path: "/v1/subscriptions/{id}/usage", id: acmeSub.ID, unknown: unknownSubscription,
+			body: func(string) any { return map[string]int{"quantity": 1} }},
+		{name: "get endpoint", key: e.Globex.Key, method: "GET", path: "/v1/webhook-endpoints/{id}", id: acmeEndpoint.ID, unknown: unknownEndpoint, body: noBody},
+		{name: "update endpoint", key: e.Globex.Key, method: "PATCH", path: "/v1/webhook-endpoints/{id}", id: acmeEndpoint.ID, unknown: unknownEndpoint,
+			body: func(string) any { return map[string]bool{"enabled": false} }},
+		// The webhook endpoint delete leak: it deleted another organization's endpoint.
+		{name: "delete endpoint", key: e.Globex.Key, method: "DELETE", path: "/v1/webhook-endpoints/{id}", id: acmeEndpoint.ID, unknown: unknownEndpoint, body: noBody},
+		{name: "list endpoint deliveries", key: e.Globex.Key, method: "GET", path: "/v1/webhook-endpoints/{id}/deliveries", id: acmeEndpoint.ID, unknown: unknownEndpoint, body: noBody},
+		{name: "get event", key: e.Globex.Key, method: "GET", path: "/v1/events/{id}", id: acmeEvent.ID, unknown: unknownEvent, body: noBody},
+
+		// IDs named in a body. Creating an invoice or subscription for another organization's customer or plan is refused as
+		// if the customer or plan did not exist. The customer leak: an invoice for it answered 422 customer_org_mismatch.
+		{name: "invoice for another org's customer", key: e.Globex.Key, method: "POST", path: "/v1/invoices", id: acmeCustomer.ID, unknown: unknownCustomer,
+			body: func(id string) any { return invoiceBody(id) }},
+		{name: "invoice for another org's customer, other way", key: e.Acme.Key, method: "POST", path: "/v1/invoices", id: globexCustomer.ID, unknown: unknownCustomer,
+			body: func(id string) any { return invoiceBody(id) }},
+		// The subscription leak: a subscription was created for another organization's customer.
+		{name: "subscription for another org's customer", key: e.Globex.Key, method: "POST", path: "/v1/subscriptions", id: acmeCustomer.ID, unknown: unknownCustomer,
+			body: func(id string) any { return map[string]string{"customer_id": id, "plan_id": globexPlan.ID} }},
+		{name: "subscription to another org's plan", key: e.Globex.Key, method: "POST", path: "/v1/subscriptions", id: acmePlan.ID, unknown: unknownPlan,
+			body: func(id string) any { return map[string]string{"customer_id": globexCustomer.ID, "plan_id": id} }},
+
+		// IDs named in a query: the other organization's objects are not found, so the list is empty.
+		{name: "invoices of another org's customer", key: e.Globex.Key, method: "GET", path: "/v1/invoices?customer_id={id}", id: acmeCustomer.ID, unknown: unknownCustomer, body: noBody, list: true},
+		{name: "invoices of another org's subscription", key: e.Globex.Key, method: "GET", path: "/v1/invoices?subscription_id={id}", id: acmeSub.ID, unknown: unknownSubscription, body: noBody, list: true},
+		{name: "subscriptions of another org's customer", key: e.Globex.Key, method: "GET", path: "/v1/subscriptions?customer_id={id}", id: acmeCustomer.ID, unknown: unknownCustomer, body: noBody, list: true},
+		{name: "payments of another org's invoice", key: e.Globex.Key, method: "GET", path: "/v1/payments?invoice_id={id}", id: acmeInvoice.ID, unknown: unknownInvoice, body: noBody, list: true},
+	}
+	for _, p := range probes {
+		t.Run(p.name, func(t *testing.T) {
+			path := func(id string) string { return strings.ReplaceAll(p.path, "{id}", id) }
+			foreign := e.Do(p.method, path(p.id), p.key, p.body(p.id))
+			unknown := e.Do(p.method, path(p.unknown), p.key, p.body(p.unknown))
+			if foreign.Code != unknown.Code || string(foreign.Body) != string(unknown.Body) {
+				t.Fatalf("another org's ID answered %s, an unknown ID answered %s", foreign, unknown)
+			}
+			if p.list {
+				var page struct {
+					Items []any `json:"items"`
+				}
+				foreign.JSON(t, &page)
+				if foreign.Code != http.StatusOK || len(page.Items) != 0 {
+					t.Fatalf("list = %s", foreign)
+				}
+				return
+			}
+			if foreign.Code != http.StatusNotFound || foreign.Map(t)["error"] != "not_found" {
+				t.Fatalf("another org's ID answered %s, want 404 not_found", foreign)
+			}
+		})
+	}
+
+	// The refused requests changed nothing in Acme.
+	var inv store.Invoice
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+acmeInvoice.ID, e.Acme.Key, nil, &inv)
+	if inv.Status != store.InvoiceOpen {
+		t.Fatalf("invoice = %+v", inv)
+	}
+	var cus store.Customer
+	e.MustDo(http.StatusOK, "GET", "/v1/customers/"+acmeCustomer.ID, e.Acme.Key, nil, &cus)
+	if cus.Name != "Jane" {
+		t.Fatalf("customer = %+v", cus)
+	}
+	var plan store.Plan
+	e.MustDo(http.StatusOK, "GET", "/v1/plans/"+acmePlan.ID, e.Acme.Key, nil, &plan)
+	if plan.Name != "Team" {
+		t.Fatalf("plan = %+v", plan)
+	}
+	var sub store.Subscription
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions/"+acmeSub.ID, e.Acme.Key, nil, &sub)
+	if sub.Status != store.Active || sub.Quantity != 1 {
+		t.Fatalf("subscription = %+v", sub)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+acmeEndpoint.ID, e.Acme.Key, nil, nil)
+}
+
+// TestEmailsArePerOrganization checks that a lookup by email finds only the caller's organization's customer, and that two
+// organizations can each have a customer with the same address.
+func TestEmailsArePerOrganization(t *testing.T) {
+	e := apitest.New(t)
+	acme := e.CreateCustomer(e.Acme, "Jane Acme", "jane@example.com")
+	globex := e.CreateCustomer(e.Globex, "Jane Globex", "Jane@Example.com")
+	e.CreateCustomer(e.Acme, "Ann", "ann@example.com")
+
+	find := func(key, email string) []string {
+		var page struct {
+			Items []store.Customer `json:"items"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/customers?email="+url.QueryEscape(email), key, nil, &page)
+		ids := []string{}
+		for _, c := range page.Items {
+			ids = append(ids, c.ID)
+		}
+		return ids
+	}
+	if got := find(e.Acme.Key, "jane@example.com"); !slices.Equal(got, []string{acme.ID}) {
+		t.Fatalf("Acme finds %v, want its own customer %s", got, acme.ID)
+	}
+	if got := find(e.Globex.Key, "jane@example.com"); !slices.Equal(got, []string{globex.ID}) {
+		t.Fatalf("Globex finds %v, want its own customer %s", got, globex.ID)
+	}
+	if got := find(e.Globex.Key, "ann@example.com"); len(got) != 0 {
+		t.Fatalf("Globex finds Acme's customer %v", got)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+globex.ID, e.Globex.Key, nil, nil)
+	if got := find(e.Acme.Key, "jane@example.com"); !slices.Equal(got, []string{acme.ID}) {
+		t.Fatalf("after Globex deleted its customer, Acme finds %v", got)
+	}
+}
