+++ b/result/internal/store/isolation_test.go
@@ -0,0 +1,105 @@
+package store
+
+import (
+	"errors"
+	"testing"
+
+	"example.com/tally/internal/money"
+)
+
+// The email index is per organization: the same address in two organizations are two customers.
+func TestCustomerEmailsArePerOrganization(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, err := s.CreateCustomer(a.ID, "Jane A", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); ok {
+		t.Fatal("another org's customer was found by email")
+	}
+	cb, err := s.CreateCustomer(b.ID, "Jane B", "JANE@example.com", t0)
+	if err != nil {
+		t.Fatalf("the same email in another org: %v", err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+		t.Fatalf("org A finds %+v %v, want its own customer", got, ok)
+	}
+	if got, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); !ok || got.ID != cb.ID {
+		t.Fatalf("org B finds %+v %v, want its own customer", got, ok)
+	}
+
+	// Deleting one organization's customer leaves the other's email lookup alone.
+	if err := s.DeleteCustomer(b.ID, cb.ID); err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+		t.Fatalf("after org B deleted its customer, org A finds %+v %v", got, ok)
+	}
+
+	// Moving a customer to an address another organization uses does not touch that organization.
+	cb2, _ := s.CreateCustomer(b.ID, "Jane B", "jane.b@example.com", t0)
+	if _, err := s.UpdateCustomer(b.ID, cb2.ID, func(c *Customer) error { c.Email = "jane@example.com"; return nil }); err != nil {
+		t.Fatalf("an address org A uses, on org B's customer: %v", err)
+	}
+	if got, _ := s.FindCustomerByEmail(a.ID, "jane@example.com"); got.ID != ca.ID {
+		t.Fatalf("org A finds %+v after org B changed its email", got)
+	}
+	if _, err := s.UpdateCustomer(b.ID, cb2.ID, func(c *Customer) error { c.Email = "elsewhere@example.com"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); ok {
+		t.Fatal("org B still finds the address it gave up")
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+		t.Fatalf("org A lost its address when org B gave up its own: %+v %v", got, ok)
+	}
+}
+
+// Subscriptions and invoices can only name a customer of their own organization; another organization's customer is
+// ErrNotFound, as an unknown one is.
+func TestBillingRefusesAnotherOrgsCustomer(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	p, err := s.CreatePlan(Plan{OrgID: b.ID, Name: "Pro", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub := Subscription{OrgID: b.ID, CustomerID: ca.ID, PlanID: p.ID, Quantity: 1, Status: Active, StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}
+	if _, err := s.CreateSubscription(sub, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for another org's customer: %v, want ErrNotFound", err)
+	}
+	inv := Invoice{OrgID: b.ID, CustomerID: ca.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}
+	if _, err := s.CreateInvoice(inv, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for another org's customer: %v, want ErrNotFound", err)
+	}
+	if got := s.ListInvoices(b.ID, InvoiceFilter{}); len(got) != 0 {
+		t.Fatalf("org B has invoices %+v", got)
+	}
+	if got := s.Subscriptions(b.ID, SubscriptionFilter{}); len(got) != 0 {
+		t.Fatalf("org B has subscriptions %+v", got)
+	}
+}
+
+// A webhook endpoint is removed only by its own organization.
+func TestRemoveWebhookEndpointIsScoped(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ep, err := s.CreateWebhookEndpoint(WebhookEndpoint{OrgID: a.ID, URL: "https://hooks.example/a", Events: []string{"*"}, Enabled: true}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.RemoveWebhookEndpoint(b.ID, ep.ID); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("removed through another org: %v", err)
+	}
+	if _, ok := s.WebhookEndpoint(a.ID, ep.ID); !ok {
+		t.Fatal("another org removed the endpoint")
+	}
+	if err := s.RemoveWebhookEndpoint(a.ID, ep.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.WebhookEndpoint(a.ID, ep.ID); ok {
+		t.Fatal("removed endpoint still there")
+	}
+}
