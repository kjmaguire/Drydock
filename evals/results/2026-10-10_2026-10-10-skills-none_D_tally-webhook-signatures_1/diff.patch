+// signTimestamped returns the signature of "<t>.<payload>" keyed with secret, where t is Unix seconds.
+func signTimestamped(secret string, t int64, payload []byte) string {
+	return hmacHex(secret, []byte(strconv.FormatInt(t, 10)+"."), payload)
+}
+
+// SignatureHeader returns the Tally-Signature header of a delivery sent at t: "t=<unix seconds>" and one "v1=" entry per
+// secret, in the order given (the current secret first).
+func SignatureHeader(secrets []string, t time.Time, body []byte) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "t=%d", t.Unix())
+	for _, s := range secrets {
+		fmt.Fprintf(&b, ",v1=%s", signTimestamped(s, t.Unix(), body))
+	}
+	return b.String()
+}
+
+// Verify checks a delivery's Tally-Signature header against its payload. It returns nil when the header's timestamp is
+// within tolerance of now (0 means DefaultTolerance) and one of its v1 entries is the signature of the payload with one of
+// the secrets.
+func Verify(payload []byte, header string, secrets []string, tolerance time.Duration, now time.Time) error {
+	if header == "" {
+		return fmt.Errorf("%w: the header is empty", ErrMalformedHeader)
+	}
+	var (
+		t    int64
+		hasT bool
+		sigs []string
+	)
+	for _, pair := range strings.Split(header, ",") {
+		k, v, ok := strings.Cut(strings.TrimSpace(pair), "=")
+		if !ok {
+			return fmt.Errorf("%w: %q is not key=value", ErrMalformedHeader, strings.TrimSpace(pair))
+		}
+		k, v = strings.TrimSpace(k), strings.TrimSpace(v)
+		switch k {
+		case "t":
+			if hasT {
+				continue
+			}
+			n, err := strconv.ParseInt(v, 10, 64)
+			if err != nil {
+				return fmt.Errorf("%w: the timestamp %q is not an integer", ErrMalformedHeader, v)
+			}
+			t, hasT = n, true
+		case "v1":
+			sigs = append(sigs, v)
+		}
+	}
+	if !hasT {
+		return ErrNoTimestamp
+	}
+	if tolerance <= 0 {
+		tolerance = DefaultTolerance
+	}
+	at := time.Unix(t, 0)
+	if at.Before(now.Add(-tolerance)) || at.After(now.Add(tolerance)) {
+		return fmt.Errorf("%w: the timestamp %d is more than %s from now", ErrTimestampTolerance, t, tolerance)
+	}
+	if len(sigs) == 0 {
+		return ErrNoSignature
+	}
+	for _, sig := range sigs {
+		for _, secret := range secrets {
+			if hmac.Equal([]byte(sig), []byte(signTimestamped(secret, t, payload))) {
+				return nil
+			}
+		}
+	}
+	return ErrSignatureMismatch
+}
+
+// RotateSecret gives an endpoint a new secret. Its previous secret keeps signing deliveries for SecretOverlap, so that
+// customers can switch over. A rotation within that time drops the previous secret at once.
+func RotateSecret(ep *store.WebhookEndpoint, now time.Time) {
+	ep.PreviousSecret = ep.Secret
+	ep.PreviousSecretUntil = now.Add(SecretOverlap)
+	ep.Secret = NewSecret()
+}
+
+// signingSecrets returns the secrets that sign a delivery sent at now: the current secret, then the previous one while its
+// overlap lasts.
+func signingSecrets(ep store.WebhookEndpoint, now time.Time) []string {
+	secrets := []string{ep.Secret}
+	if ep.PreviousSecret != "" && now.Before(ep.PreviousSecretUntil) {
+		secrets = append(secrets, ep.PreviousSecret)
+	}
+	return secrets
+}
