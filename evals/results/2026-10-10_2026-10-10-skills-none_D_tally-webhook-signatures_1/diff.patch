+		want := webhooks.SignatureHeader(secrets, e.Clock.Now(), r.Body)
+		if got := r.Header.Get("Tally-Signature"); got != want {
+			t.Fatalf("Tally-Signature = %s, want %s", got, want)
+		}
+	}
+	rotate := func() string {
+		t.Helper()
+		var rotated store.WebhookEndpoint
+		r := e.MustDo(http.StatusOK, "POST", "/v1/webhook-endpoints/"+ep.ID+"/rotate-secret", e.Acme.Key, nil, &rotated)
+		if !regexp.MustCompile(`^whsec_[0-9a-f]{32}$`).MatchString(rotated.Secret) || rotated.ID != ep.ID {
+			t.Fatalf("rotate answered %s", r)
+		}
+		if _, ok := r.Map(t)["previous_secret"]; ok {
+			t.Fatalf("rotate showed the previous secret: %s", r)
+		}
+		return rotated.Secret
+	}
+
+	if r := e.Do("POST", "/v1/webhook-endpoints/we_missing/rotate-secret", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("rotate of a missing endpoint = %s", r)
+	}
+
+	second := rotate()
+	if second == first {
+		t.Fatal("rotate kept the secret")
+	}
+	expectSecrets(send(), second, first)
+
+	e.Clock.Advance(webhooks.SecretOverlap - time.Second)
+	expectSecrets(send(), second, first)
+
+	e.Clock.Advance(time.Second)
+	expectSecrets(send(), second)
+
+	third := rotate()
+	expectSecrets(send(), third, second)
+
+	fourth := rotate()
+	r := send()
+	expectSecrets(r, fourth, third)
+	if err := webhooks.Verify(r.Body, r.Header.Get("Tally-Signature"), []string{second}, 0, e.Clock.Now()); !errors.Is(err, webhooks.ErrSignatureMismatch) {
+		t.Fatalf("the secret dropped by a second rotation still verifies: %v", err)
+	}
+}
+
+func TestSecretRotationSurvivesReload(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	first := ep.Secret
+	var rotated store.WebhookEndpoint
+	e.MustDo(http.StatusOK, "POST", "/v1/webhook-endpoints/"+ep.ID+"/rotate-secret", e.Acme.Key, nil, &rotated)
+
+	// The server restarts within the overlap, so its data goes through a snapshot.
+	path := filepath.Join(t.TempDir(), "tally.json")
+	if err := snapshot.Save(e.Store, path, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := snapshot.Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	svc := webhooks.New(webhooks.Options{Store: loaded, Clock: e.Clock, Doer: e.HTTP, Resolver: e.DNS})
+
+	// send delivers an event through the reloaded service and checks that it is signed with exactly these secrets.
+	send := func(secrets ...string) {
+		t.Helper()
+		if err := svc.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+			t.Fatal(err)
+		}
+		if n, err := svc.RunDue(ctx); err != nil || n != 1 {
+			t.Fatalf("RunDue = %d, %v", n, err)
+		}
+		reqs := e.HTTP.Requests()
+		r := reqs[len(reqs)-1]
+		want := webhooks.SignatureHeader(secrets, e.Clock.Now(), r.Body)
+		if got := r.Header.Get("Tally-Signature"); got != want {
+			t.Fatalf("Tally-Signature = %s, want %s", got, want)
+		}
+	}
+
+	send(rotated.Secret, first)
+	e.Clock.Advance(webhooks.SecretOverlap - time.Second)
+	send(rotated.Secret, first)
+	e.Clock.Advance(time.Second)
+	send(rotated.Secret)
+}
