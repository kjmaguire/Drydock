+// isPublic reports whether a is a public address. An IPv4-mapped IPv6 address is judged as the IPv4 address it holds.
+func isPublic(a netip.Addr) bool {
+	if !a.IsValid() {
+		return false
+	}
+	a = a.Unmap().WithZone("")
+	for _, p := range nonPublic {
+		if p.Contains(a) {
+			return false
+		}
+	}
+	return true
+}
