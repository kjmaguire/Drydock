+// hostAddrs returns the addresses a URL host stands for: the host itself when it is an IP address, else every address the
+// Resolver finds for it.
+func (s *Service) hostAddrs(ctx context.Context, host string) ([]netip.Addr, error) {
+	if a, err := netip.ParseAddr(host); err == nil {
+		return []netip.Addr{a}, nil
+	}
+	ips, err := s.resolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	addrs := make([]netip.Addr, 0, len(ips))
+	for _, ip := range ips {
+		a, _ := netip.AddrFromSlice(ip.IP) // an invalid address is refused by isPublic
+		addrs = append(addrs, a)
+	}
+	return addrs, nil
+}
