 }
 
+// Before invites kept only the hash of their token, snapshots held the token itself, as "token" on each invite. Load hashes
+// it, so pending invites keep working after an upgrade. Snapshots written now have no token to hash.
+func hashLegacyInviteTokens(b []byte, st *store.State) error {
+	var f struct {
+		State struct {
+			Invites []struct {
+				ID    string `json:"id"`
+				Token string `json:"token"`
+			} `json:"invites"`
+		} `json:"state"`
+	}
+	if err := json.Unmarshal(b, &f); err != nil {
+		return err
+	}
+	tokens := map[string]string{}
+	for _, i := range f.State.Invites {
+		if i.Token != "" {
+			tokens[i.ID] = i.Token
+		}
+	}
+	for i := range st.Invites {
+		if tok, ok := tokens[st.Invites[i].ID]; ok && st.Invites[i].TokenHash == "" {
+			st.Invites[i].TokenHash = store.HashToken(tok)
+		}
+	}
+	return nil
+}
