+package store
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+func newInvite(t *testing.T, s *Store, orgID, email string, now time.Time) Invite {
+	t.Helper()
+	inv, err := s.CreateInvite(orgID, email, RoleMember, "usr_000001", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return inv
+}
+
+func TestInviteTokenFormatAndStorage(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv := newInvite(t, s, o.ID, "new@people.example", t0)
+
+	raw, err := base64.RawURLEncoding.DecodeString(inv.Token)
+	if err != nil || len(inv.Token) != 43 || len(raw) != 32 {
+		t.Fatalf("token %q: want 32 random bytes in unpadded base64url, got %d characters (%v)", inv.Token, len(inv.Token), err)
+	}
+	if other := newInvite(t, s, o.ID, "other@people.example", t0); other.Token == inv.Token {
+		t.Fatal("two invites got the same token")
+	}
+	if inv.TokenHash != HashToken(inv.Token) || len(inv.TokenHash) != 64 {
+		t.Fatalf("token hash = %q", inv.TokenHash)
+	}
+
+	stored, ok := s.Invite(o.ID, inv.ID)
+	if !ok || stored.Token != "" || stored.TokenHash != inv.TokenHash {
+		t.Fatalf("stored invite = %+v", stored)
+	}
+	b, err := json.Marshal(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), inv.Token) {
+		t.Fatal("the export contains the token")
+	}
+	if !strings.Contains(string(b), inv.TokenHash) {
+		t.Fatal("the export lacks the token's hash, so a reloaded store could not accept the invite")
+	}
+}
+
+func TestAcceptInvite(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv := newInvite(t, s, o.ID, "new@people.example", t0)
+
+	if _, _, _, err := s.AcceptInvite("", "X", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("empty token: %v", err)
+	}
+	if _, _, _, err := s.AcceptInvite(inv.TokenHash, "X", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("the stored hash works as a token: %v", err)
+	}
+	u, m, k, err := s.AcceptInvite(inv.Token, "New Person", t0)
+	if err != nil || u.Email != "new@people.example" || m.Role != RoleMember || k.Token == "" {
+		t.Fatalf("accept = %+v %+v %+v %v", u, m, k, err)
+	}
+	if _, _, _, err := s.AcceptInvite(inv.Token, "New Person", t0); !errors.Is(err, ErrInviteUsed) {
+		t.Fatalf("second accept: %v", err)
+	}
+	if got := s.PendingInvites(o.ID, t0); len(got) != 0 {
+		t.Fatalf("pending after accept = %+v", got)
+	}
+}
+
+func TestInviteExpiry(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	edge := newInvite(t, s, o.ID, "edge@people.example", t0)
+	late := newInvite(t, s, o.ID, "late@people.example", t0)
+
+	atEdge := t0.Add(7 * 24 * time.Hour)
+	if got := s.PendingInvites(o.ID, atEdge); len(got) != 2 {
+		t.Fatalf("pending exactly 7 days after creation = %+v", got)
+	}
+	if _, _, _, err := s.AcceptInvite(late.Token, "Late", atEdge.Add(time.Second)); !errors.Is(err, ErrInviteExpired) {
+		t.Fatalf("accept 7 days and a second later: %v", err)
+	}
+	if _, _, _, err := s.AcceptInvite(edge.Token, "Edge", atEdge); err != nil {
+		t.Fatalf("accept exactly 7 days later: %v", err)
+	}
+	if got := s.PendingInvites(o.ID, atEdge.Add(time.Second)); len(got) != 0 {
+		t.Fatalf("pending after expiry = %+v", got)
+	}
+	if got := s.Invites(o.ID); len(got) != 1 || got[0].ID != late.ID {
+		t.Fatalf("Invites (neither accepted nor revoked) = %+v", got)
+	}
+}
+
+func TestRevokedInviteIsNotFound(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv := newInvite(t, s, o.ID, "new@people.example", t0)
+	if _, err := s.RevokeInvite(o.ID, inv.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := s.AcceptInvite(inv.Token, "X", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("revoked: %v", err)
+	}
+}
+
+func TestNewInviteSupersedesPendingOne(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	old := newInvite(t, s, o.ID, "Ann@People.example", t0)
+	other := newInvite(t, s, o.ID, "bob@people.example", t0)
+	fresh := newInvite(t, s, o.ID, " ann@people.example ", t0.Add(time.Hour))
+
+	if _, _, _, err := s.AcceptInvite(old.Token, "Ann", t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("superseded token: %v", err)
+	}
+	if got := s.PendingInvites(o.ID, t0.Add(time.Hour)); len(got) != 2 || got[0].ID != other.ID || got[1].ID != fresh.ID {
+		t.Fatalf("pending = %+v", got)
+	}
+	if _, _, _, err := s.AcceptInvite(fresh.Token, "Ann", t0.Add(time.Hour)); err != nil {
+		t.Fatalf("newest token: %v", err)
+	}
+}
+
+func TestNewInviteDoesNotRevokeAnotherOrganization(t *testing.T) {
+	s := New()
+	acme := newOrg(t, s, "Acme")
+	globex := newOrg(t, s, "Globex")
+	theirs := newInvite(t, s, globex.ID, "ann@people.example", t0)
+	newInvite(t, s, acme.ID, "ann@people.example", t0)
+	if _, _, _, err := s.AcceptInvite(theirs.Token, "Ann", t0); err != nil {
+		t.Fatalf("another organization's invite: %v", err)
+	}
+}
+
+func TestInvitesSurviveReload(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	inv := newInvite(t, s, o.ID, "new@people.example", t0)
+	s2, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := s2.AcceptInvite(inv.Token, "New Person", t0); err != nil {
+		t.Fatalf("accept after reload: %v", err)
+	}
+}
