+package api_test
+
+import (
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// emailedToken returns the token in the newest invitation email.
+func emailedToken(t *testing.T, e *apitest.Env) string {
+	t.Helper()
+	msgs := e.Mail.Messages()
+	m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[len(msgs)-1].Body)
+	if m == nil {
+		t.Fatalf("no link in %q", msgs[len(msgs)-1].Body)
+	}
+	token, err := url.QueryUnescape(m[1])
+	if err != nil {
+		t.Fatal(err)
+	}
+	return token
+}
+
+func acceptBody(token string) map[string]string {
+	return map[string]string{"token": token, "name": "New Person"}
+}
+
+func invite(t *testing.T, e *apitest.Env, email string) string {
+	t.Helper()
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": email, "role": "member"}, nil)
+	return emailedToken(t, e)
+}
+
+func TestInviteTokenIsNeverInAnAnswer(t *testing.T) {
+	e := apitest.New(t)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	r := e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"})
+	if r.Code != http.StatusCreated {
+		t.Fatalf("invite: %s", r)
+	}
+	token := emailedToken(t, e)
+	if strings.Contains(string(r.Body), token) || strings.Contains(string(r.Body), `"token"`) {
+		t.Fatalf("the create answer has the token: %s", r.Body)
+	}
+	if r.Map(t)["expires_at"] == nil {
+		t.Fatalf("the create answer lacks expires_at: %s", r.Body)
+	}
+	for _, key := range []string{e.Acme.Key, viewer} {
+		list := e.Do("GET", "/v1/invites", key, nil)
+		if list.Code != http.StatusOK || strings.Contains(string(list.Body), token) || strings.Contains(string(list.Body), `"token"`) {
+			t.Fatalf("the list has the token: %s", list.Body)
+		}
+	}
+}
+
+func TestListShowsOnlyPendingInvites(t *testing.T) {
+	e := apitest.New(t)
+	accepted := invite(t, e, "a@people.example")
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", acceptBody(accepted), nil)
+	var revoked store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "b@people.example", "role": "member"}, &revoked)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+revoked.ID, e.Acme.Key, nil, nil)
+
+	var list struct {
+		Items []struct {
+			Email     string    `json:"email"`
+			ExpiresAt time.Time `json:"expires_at"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &list)
+	if len(list.Items) != 0 {
+		t.Fatalf("pending after accepting and revoking = %+v", list.Items)
+	}
+
+	e.Clock.Advance(time.Hour)
+	created := e.Clock.Now()
+	invite(t, e, "c@people.example")
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 || list.Items[0].Email != "c@people.example" || !list.Items[0].ExpiresAt.Equal(created.Add(7*24*time.Hour)) {
+		t.Fatalf("pending = %+v", list.Items)
+	}
+
+	e.Clock.Advance(7 * 24 * time.Hour) // exactly 7 days after the invite
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 {
+		t.Fatalf("an invite 7 days old is not pending yet: %+v", list.Items)
+	}
+	e.Clock.Advance(time.Second)
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &list)
+	if len(list.Items) != 0 {
+		t.Fatalf("an expired invite is listed: %+v", list.Items)
+	}
+}
+
+func TestAcceptAnswers(t *testing.T) {
+	e := apitest.New(t)
+	token := invite(t, e, "new@people.example")
+
+	if r := e.Do("POST", "/v1/invites/accept", "", acceptBody("invite_nope")); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("unknown token: %s", r)
+	}
+	if r := e.Do("POST", "/v1/invites/accept", "", acceptBody("")); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("empty token: %s", r)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", acceptBody(token), nil)
+	if r := e.Do("POST", "/v1/invites/accept", "", acceptBody(token)); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_used" {
+		t.Fatalf("second accept: %s", r)
+	}
+}
+
+func TestAcceptExpiredInvite(t *testing.T) {
+	e := apitest.New(t)
+	token := invite(t, e, "new@people.example")
+	e.Clock.Advance(7*24*time.Hour + time.Second)
+	if r := e.Do("POST", "/v1/invites/accept", "", acceptBody(token)); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_expired" {
+		t.Fatalf("expired: %s", r)
+	}
+}
+
+func TestReinviteRevokesEarlierToken(t *testing.T) {
+	e := apitest.New(t)
+	first := invite(t, e, "new@people.example")
+	second := invite(t, e, "NEW@people.example")
+	if first == second {
+		t.Fatal("the new invite has the old token")
+	}
+	if r := e.Do("POST", "/v1/invites/accept", "", acceptBody(first)); r.Code != http.StatusNotFound {
+		t.Fatalf("the superseded token: %s", r)
+	}
+	var accepted struct {
+		User store.User `json:"user"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", acceptBody(second), &accepted)
+	if accepted.User.Email != "NEW@people.example" {
+		t.Fatalf("accepted = %+v", accepted)
+	}
+}
