+package snapshot
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/store"
+)
+
+func TestSnapshotHasNoInviteToken(t *testing.T) {
+	now := time.Date(2026, 2, 1, 12, 0, 0, 0, time.UTC)
+	st := store.New()
+	o, _ := st.CreateOrg("A", store.OrgTeam, "UTC", 0, now)
+	inv, err := st.CreateInvite(o.ID, "new@people.example", store.RoleMember, "usr_000001", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "tally.json")
+	if err := Save(st, path, now); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), inv.Token) {
+		t.Fatal("the snapshot contains the invite's token")
+	}
+	got, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := got.AcceptInvite(inv.Token, "New Person", now); err != nil {
+		t.Fatalf("accept after a reload: %v", err)
+	}
+}
+
+// A snapshot written before invites kept only their token's hash holds the token itself. Loading it must keep the
+// invite working.
+func TestLoadHashesLegacyInviteTokens(t *testing.T) {
+	now := time.Date(2026, 2, 1, 12, 0, 0, 0, time.UTC)
+	const token = "Qm9yaW5nIHRva2VuIGZvciB0ZXN0aW5nIG9ubHkhIQ"
+	legacy := fmt.Sprintf(`{"version": 2, "saved_at": %q, "state": {
+		"seq": 3,
+		"orgs": [{"id": "org_000001", "name": "Acme", "plan": "team", "time_zone": "UTC", "tax_rate_bp": 0, "created_at": %[1]q}],
+		"users": [{"id": "usr_000002", "email": "owner@acme.example", "name": "Owner", "created_at": %[1]q}],
+		"members": [{"org_id": "org_000001", "user_id": "usr_000002", "role": "owner", "created_at": %[1]q}],
+		"invites": [{"id": "inv_000003", "org_id": "org_000001", "email": "new@people.example", "role": "member",
+			"token": %q, "invited_by": "usr_000002", "created_at": %[1]q}]
+	}}`, now.Format(time.RFC3339), token)
+	path := filepath.Join(t.TempDir(), "tally.json")
+	if err := os.WriteFile(path, []byte(legacy), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	st, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := st.AcceptInvite(token, "New Person", now); err != nil {
+		t.Fatalf("legacy token: %v", err)
+	}
+	if _, _, _, err := st.AcceptInvite(token, "New Person", now); !errors.Is(err, store.ErrInviteUsed) {
+		t.Fatalf("second accept: %v", err)
+	}
+	if err := Save(st, path, now); err != nil {
+		t.Fatal(err)
+	}
+	b, _ := os.ReadFile(path)
+	if strings.Contains(string(b), token) {
+		t.Fatal("saving again kept the legacy token")
+	}
+}
