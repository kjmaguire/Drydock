+// inviteAccept accepts the invitation sent to address and returns the new member's user ID and API key.
+func inviteAccept(t *testing.T, e *apitest.Env, address string) (string, string) {
+	t.Helper()
+	for _, msg := range e.Mail.Messages() {
+		if msg.To != address {
+			continue
+		}
+		m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msg.Body)
+		token, _ := url.QueryUnescape(m[1])
+		var accepted struct {
+			User   store.User   `json:"user"`
+			APIKey store.APIKey `json:"api_key"`
+		}
+		e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "Person"}, &accepted)
+		return accepted.User.ID, accepted.APIKey.Token
+	}
+	t.Fatalf("no invitation sent to %s", address)
+	return "", ""
+}
+
+func TestSeatLimits(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Free", store.OrgFree, "UTC")
+	seats := func(org apitest.Org) store.Seats {
+		var o struct {
+			Seats store.Seats `json:"seats"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/org", org.Key, nil, &o)
+		return o.Seats
+	}
+
+	// The owner and two pending invites take the free plan's three seats.
+	var a, b store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "a@free.example", "role": "member"}, &a)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "b@free.example", "role": "admin"}, &b)
+	r := e.Do("POST", "/v1/invites", free.Key, map[string]string{"email": "c@free.example", "role": "member"})
+	if r.Code != http.StatusPaymentRequired {
+		t.Fatalf("invite past the limit: %s", r)
+	}
+	if got := r.Map(t); got["error"] != "seat_limit_reached" || got["limit"] != float64(3) || got["used"] != float64(3) {
+		t.Fatalf("seat limit answer = %v", got)
+	}
+	if s := seats(free); s.Used != 3 || s.Limit == nil || *s.Limit != 3 {
+		t.Fatalf("seats = %+v", s)
+	}
+
+	// Viewers are free.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "d@free.example", "role": "viewer"}, nil)
+	if s := seats(free); s.Used != 3 {
+		t.Fatalf("a viewer invite used a seat: %+v", s)
+	}
+
+	// Accepting an invite never needs a seat: the invite already holds one.
+	inviteAccept(t, e, "a@free.example")
+	viewerID, _ := inviteAccept(t, e, "d@free.example")
+	if s := seats(free); s.Used != 3 {
+		t.Fatalf("accepting changed the seats used: %+v", s)
+	}
+
+	// A viewer who becomes a member needs a free seat; revoking an invite frees one.
+	path := "/v1/members/" + viewerID
+	r = e.Do("PATCH", path, free.Key, map[string]string{"role": "member"})
+	if r.Code != http.StatusPaymentRequired {
+		t.Fatalf("viewer to member past the limit: %s", r)
+	}
+	if got := r.Map(t); got["error"] != "seat_limit_reached" || got["limit"] != float64(3) || got["used"] != float64(3) {
+		t.Fatalf("seat limit answer = %v", got)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+b.ID, free.Key, nil, nil)
+	e.MustDo(http.StatusOK, "PATCH", path, free.Key, map[string]string{"role": "member"}, nil)
+	if s := seats(free); s.Used != 3 {
+		t.Fatalf("seats after the change = %+v", s)
+	}
+
+	// The business plan has no limit.
+	if s := seats(e.Globex); s.Limit != nil {
+		t.Fatalf("business seats = %+v", s)
+	}
+
+	// A plan change may not leave more seats used than the new plan includes.
+	acme := e.Acme
+	var ids []string
+	for _, email := range []string{"p@acme.example", "q@acme.example", "r@acme.example"} {
+		u, _ := e.AddMember(acme, email, store.RoleMember)
+		ids = append(ids, u.ID)
+	}
+	r = e.Do("PATCH", "/v1/org", acme.Key, map[string]string{"plan": "free"})
+	if r.Code != http.StatusConflict {
+		t.Fatalf("downgrade over the limit: %s", r)
+	}
+	if got := r.Map(t); got["error"] != "over_seat_limit" || got["limit"] != float64(3) || got["used"] != float64(4) {
+		t.Fatalf("over_seat_limit answer = %v", got)
+	}
+	if o, _ := e.Store.Org(acme.ID); o.Plan != store.OrgTeam {
+		t.Fatalf("a refused downgrade changed the plan to %s", o.Plan)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/members/"+ids[0], acme.Key, map[string]string{"role": "viewer"}, nil)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/org", acme.Key, map[string]string{"plan": "free"}, nil)
+	if s := seats(acme); s.Used != 3 || s.Limit == nil || *s.Limit != 3 {
+		t.Fatalf("seats after the downgrade = %+v", s)
+	}
+}
+
+func TestSeatLimitHoldsUnderConcurrency(t *testing.T) {
+	e := apitest.New(t)
+	org := e.NewOrg("Race", store.OrgFree, "UTC")
+	e.AddMember(org, "member@race.example", store.RoleMember) // the owner and this member leave one seat free
+
+	const n = 5
+	codes := make([]int, n)
+	var wg sync.WaitGroup
+	for i := range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			email := fmt.Sprintf("p%d@race.example", i)
+			codes[i] = e.Do("POST", "/v1/invites", org.Key, map[string]string{"email": email, "role": "member"}).Code
+		}()
+	}
+	wg.Wait()
+	created := 0
+	for _, c := range codes {
+		switch c {
+		case http.StatusCreated:
+			created++
+		case http.StatusPaymentRequired:
+		default:
+			t.Fatalf("invite answered %d, want 201 or 402", c)
+		}
+	}
+	if created != 1 {
+		t.Fatalf("%d of %d concurrent invites succeeded, want exactly 1 (codes %v)", created, n, codes)
+	}
+}
