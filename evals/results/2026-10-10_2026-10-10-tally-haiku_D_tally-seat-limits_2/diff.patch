+package store
+
+import "fmt"
+
+// SeatLimit returns how many seats a plan includes. limited is false when the plan's seats are unlimited.
+func (p OrgPlan) SeatLimit() (limit int, limited bool) {
+	switch p {
+	case OrgFree:
+		return 3, true
+	case OrgTeam:
+		return 10, true
+	}
+	return 0, false
+}
+
+// Seats is an organization's seat use. A seat is taken by a member whose role is not viewer, and by a pending invite
+// (neither accepted nor revoked) whose role is not viewer. Viewers are free. Limit is nil when the plan is unlimited.
+type Seats struct {
+	Used  int  `json:"used"`
+	Limit *int `json:"limit"`
+}
+
+// SeatLimitError says a change needs a seat the organization's plan does not have: Used seats are taken and the plan
+// includes Limit.
+type SeatLimitError struct {
+	Limit, Used int
+}
+
+func (e *SeatLimitError) Error() string {
+	return fmt.Sprintf("seat limit reached: the plan includes %d seats and %d are used", e.Limit, e.Used)
+}
+
+// Seats returns an organization's seat use.
+func (s *Store) Seats(orgID string) Seats {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.seatsLocked(orgID)
+}
+
+// seatsLocked is Seats for a caller that holds the lock.
+func (s *Store) seatsLocked(orgID string) Seats {
+	seats := Seats{Used: s.usedSeatsLocked(orgID)}
+	if n, limited := s.orgs[orgID].Plan.SeatLimit(); limited {
+		seats.Limit = &n
+	}
+	return seats
+}
+
+// usedSeatsLocked counts the seats taken in an organization. The caller holds the lock.
+func (s *Store) usedSeatsLocked(orgID string) int {
+	used := 0
+	for _, m := range s.members {
+		if m.OrgID == orgID && m.Role != RoleViewer {
+			used++
+		}
+	}
+	for _, inv := range s.invites {
+		if inv.OrgID == orgID && inv.AcceptedAt == nil && inv.RevokedAt == nil && inv.Role != RoleViewer {
+			used++
+		}
+	}
+	return used
+}
+
+// requireSeatLocked returns a SeatLimitError unless the organization has a seat free for one more. The caller holds the
+// lock, so the check and the change it guards are atomic.
+func (s *Store) requireSeatLocked(orgID string) error {
+	seats := s.seatsLocked(orgID)
+	if seats.Limit != nil && seats.Used >= *seats.Limit {
+		return &SeatLimitError{Limit: *seats.Limit, Used: seats.Used}
+	}
+	return nil
+}
