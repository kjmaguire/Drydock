+package api_test
+
+import (
+	"net/http"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func TestSubscriptionChangesOverTheAPI(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": team.ID, "quantity": 2}, &sub)
+
+	// A new subscription has nothing pending, and says so with nulls.
+	m := e.MustDo(http.StatusOK, "GET", "/v1/subscriptions/"+sub.ID, e.Acme.Key, nil, nil).Map(t)
+	if v, ok := m["pending_plan_id"]; !ok || v != nil {
+		t.Fatalf("pending_plan_id = %v (present %v), want null", v, ok)
+	}
+	if v, ok := m["pending_quantity"]; !ok || v != nil {
+		t.Fatalf("pending_quantity = %v (present %v), want null", v, ok)
+	}
+
+	// An upgrade applies and bills at once.
+	e.Clock.Advance(10 * 24 * time.Hour)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": pro.ID}, &sub)
+	if sub.PlanID != pro.ID || sub.PendingPlanID != nil {
+		t.Fatalf("after the upgrade = %+v", sub)
+	}
+	var invs struct{ Items []store.Invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 2 || len(invs.Items[1].Lines) != 2 || invs.Items[1].Status != store.InvoicePaid {
+		t.Fatalf("invoices = %+v", invs.Items)
+	}
+
+	// A downgrade is pending until the next renewal.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": team.ID}, &sub)
+	if sub.PlanID != pro.ID || sub.PendingPlanID == nil || *sub.PendingPlanID != team.ID || sub.PendingQuantity == nil || *sub.PendingQuantity != 2 {
+		t.Fatalf("after the downgrade = %+v", sub)
+	}
+	var got store.Subscription
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions/"+sub.ID, e.Acme.Key, nil, &got)
+	if got.PendingPlanID == nil || *got.PendingPlanID != team.ID {
+		t.Fatalf("GET after the downgrade = %+v", got)
+	}
+}
+
+func TestIncompatiblePlanIsUnprocessable(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	euro := e.CreatePlan(e.Acme, "Euro", "EUR", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": team.ID}, &sub)
+	r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": euro.ID})
+	if r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "incompatible_plan" {
+		t.Fatalf("change to another currency: %s", r)
+	}
+}
