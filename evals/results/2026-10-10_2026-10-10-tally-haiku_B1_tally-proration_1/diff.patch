+package subscriptions_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/billing"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/payments"
+	"example.com/tally/internal/store"
+	"example.com/tally/internal/subscriptions"
+)
+
+// subscribe starts a monthly subscription at apitest.Start for a new customer whose default payment method is pm (empty for
+// none). Start is the first day of a 31-day period, so ten days in, 21 of its 31 days remain.
+func subscribe(t *testing.T, e *apitest.Env, pm string, plan store.Plan, qty int) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	if pm != "" {
+		_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = pm; return nil })
+	}
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: plan.ID, Quantity: qty})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+func invoicesOf(e *apitest.Env, subID string) []store.Invoice {
+	return e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: subID})
+}
+
+func setPlan(id string) subscriptions.UpdateInput { return subscriptions.UpdateInput{PlanID: &id} }
+
+func setQty(q int) subscriptions.UpdateInput { return subscriptions.UpdateInput{Quantity: &q} }
+
+func TestUpgradeMidPeriodBillsTheProratedDifference(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	sub := subscribe(t, e, "pm_card_visa", team, 3)
+	before := len(e.Gateway.Charges())
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, setPlan(pro.ID))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != pro.ID || got.Quantity != 3 || got.Status != store.Active || got.PendingPlanID != nil || got.PendingQuantity != nil {
+		t.Fatalf("subscription = %+v", got)
+	}
+	if !got.CurrentPeriodStart.Equal(sub.CurrentPeriodStart) || !got.CurrentPeriodEnd.Equal(sub.CurrentPeriodEnd) {
+		t.Fatalf("the period changed: %v..%v", got.CurrentPeriodStart, got.CurrentPeriodEnd)
+	}
+	// Old value 6000, new value 15000, 21 of 31 days left: credit -round(6000*21/31) = -4065, charge round(15000*21/31) = 10161.
+	invs := invoicesOf(e, sub.ID)
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %d, want the first and the upgrade", len(invs))
+	}
+	up := invs[1]
+	if up.Status != store.InvoicePaid || len(up.Lines) != 2 {
+		t.Fatalf("upgrade invoice = %+v", up)
+	}
+	if l := up.Lines[0]; l.Description != "Unused time on Team" || l.Quantity != 1 || l.UnitAmount != -4065 {
+		t.Fatalf("credit line = %+v", l)
+	}
+	if l := up.Lines[1]; l.Description != "Remaining time on Pro" || l.Quantity != 1 || l.UnitAmount != 10161 {
+		t.Fatalf("charge line = %+v", l)
+	}
+	cs := e.Gateway.Charges()
+	if len(cs) != before+1 || cs[len(cs)-1].Amount != 6096 || cs[len(cs)-1].PaymentMethod != "pm_card_visa" {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
+
+func TestUpgradeAppliesDiscountAndTax(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	_, _ = e.Store.UpdateOrg(e.Acme.ID, func(o *store.Org) error { o.TaxRateBP = 1000; return nil })
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: team.ID, Quantity: 1, DiscountPercent: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, setPlan(pro.ID)); err != nil {
+		t.Fatal(err)
+	}
+	// Credit -1355, charge 3387: subtotal 2032, discount 203, taxable 1829, tax 183 at 10%, total 2012.
+	up := invoicesOf(e, sub.ID)[1]
+	if tot := billing.Compute(up); tot.Subtotal != 2032 || tot.Discount != 203 || tot.Tax != 183 || tot.Total != 2012 {
+		t.Fatalf("totals = %+v", tot)
+	}
+	if cs := e.Gateway.Charges(); cs[len(cs)-1].Amount != 2012 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
+
+// setPaymentMethod changes the default payment method of the subscription's customer.
+func setPaymentMethod(e *apitest.Env, sub store.Subscription, pm string) {
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, sub.CustomerID, func(c *store.Customer) error { c.DefaultPaymentMethod = pm; return nil })
+}
+
+func TestDeclinedUpgradeAppliesAndIsPastDue(t *testing.T) {
+	e := apitest.New(t)
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	sub := subscribe(t, e, "pm_card_visa", team, 1)
+	setPaymentMethod(e, sub, "pm_card_declined")
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+
+	got, err := e.Subs.Update(context.Background(), e.Acme.ID, sub.ID, setPlan(pro.ID))
+	if err != nil {
+		t.Fatalf("a declined charge is not an error: %v", err)
+	}
+	if got.PlanID != pro.ID || got.Status != store.PastDue {
+		t.Fatalf("subscription = %+v", got)
+	}
+	up := invoicesOf(e, sub.ID)[1]
+	if up.Status != store.InvoiceOpen || len(e.Store.Payments(e.Acme.ID, up.ID)) != 1 {
+		t.Fatalf("upgrade invoice = %+v", up)
+	}
+}
+
+func TestUpgradeWithoutPaymentMethodStaysOpen(t *testing.T) {
+	e := apitest.New(t)
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	sub := subscribe(t, e, "", team, 1)
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+
+	got, err := e.Subs.Update(context.Background(), e.Acme.ID, sub.ID, setPlan(pro.ID))
+	if err != nil || got.PlanID != pro.ID || got.Status != store.Active {
+		t.Fatalf("subscription = %+v, %v", got, err)
+	}
+	if up := invoicesOf(e, sub.ID)[1]; up.Status != store.InvoiceOpen || len(up.Lines) != 2 {
+		t.Fatalf("upgrade invoice = %+v", up)
+	}
+}
+
+func TestUpgradeGatewayDownKeepsTheChange(t *testing.T) {
+	e := apitest.New(t)
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	sub := subscribe(t, e, "pm_card_visa", team, 1)
+	setPaymentMethod(e, sub, "pm_gateway_down")
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+
+	got, err := e.Subs.Update(context.Background(), e.Acme.ID, sub.ID, setPlan(pro.ID))
+	if !errors.Is(err, payments.ErrUnavailable) || got.ID == "" || got.PlanID != pro.ID {
+		t.Fatalf("subscription = %+v, %v", got, err)
+	}
+	if up := invoicesOf(e, sub.ID)[1]; up.Status != store.InvoiceOpen {
+		t.Fatalf("upgrade invoice = %+v", up)
+	}
+}
+
+func TestDowngradeIsPendingUntilRenewal(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "50.00")
+	sub := subscribe(t, e, "pm_card_visa", pro, 2)
+	charges := len(e.Gateway.Charges())
+	e.Clock.Set(e.Clock.Now().AddDate(0, 0, 10))
+
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &team.ID, Quantity: intp(1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != pro.ID || got.Quantity != 2 || got.PendingPlanID == nil || *got.PendingPlanID != team.ID ||
+		got.PendingQuantity == nil || *got.PendingQuantity != 1 {
+		t.Fatalf("subscription = %+v", got)
+	}
+	if len(invoicesOf(e, sub.ID)) != 1 || len(e.Gateway.Charges()) != charges {
+		t.Fatalf("a downgrade billed: invoices = %+v", invoicesOf(e, sub.ID))
+	}
+
+	e.Clock.Set(got.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	renewed, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if renewed.PlanID != team.ID || renewed.Quantity != 1 || renewed.PendingPlanID != nil || renewed.PendingQuantity != nil || renewed.Status != store.Active {
+		t.Fatalf("after renewal = %+v", renewed)
+	}
+	invs := invoicesOf(e, sub.ID)
+	if last := invs[len(invs)-1]; len(last.Lines) != 1 || last.Lines[0].UnitAmount != 2000 || last.Lines[0].Quantity != 1 {
+		t.Fatalf("renewal invoice = %+v", last)
+	}
+	if cs := e.Gateway.Charges(); cs[len(cs)-1].Amount != 2000 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
+
+func TestPendingDowngradeIsClearedByRevertOrUpgrade(t *testing.T) {
