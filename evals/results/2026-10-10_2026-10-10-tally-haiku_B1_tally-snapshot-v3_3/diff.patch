+// numberInvoices checks the numbers of invoices read from a file and gives a number to each invoice that has none, in
+// creation order (created_at, then ID), per organization. It returns each organization's next number, which is never
+// lower than the one the file recorded, so a number is not reused after a file is loaded.
+func numberInvoices(invs []Invoice, recorded map[string]int) (map[string]int, error) {
+	next := map[string]int{}
+	for org, n := range recorded {
+		next[org] = n
+	}
+	type numKey struct {
+		org string
+		n   int
+	}
+	taken := map[numKey]bool{}
+	for _, inv := range invs {
+		if inv.Number == "" {
+			continue
+		}
+		var n int
+		if _, err := fmt.Sscanf(inv.Number, "INV-%d", &n); err != nil || n < 1 || invoiceNumber(n) != inv.Number {
+			return nil, fmt.Errorf("%w: invoice %s has the number %q", ErrInvalid, inv.ID, inv.Number)
+		}
+		if taken[numKey{inv.OrgID, n}] {
+			return nil, fmt.Errorf("%w: invoice number %s is used twice in organization %s", ErrInvalid, inv.Number, inv.OrgID)
+		}
+		taken[numKey{inv.OrgID, n}] = true
+		if next[inv.OrgID] <= n {
+			next[inv.OrgID] = n + 1
+		}
+	}
+	sort.SliceStable(invs, func(i, j int) bool {
+		if !invs[i].CreatedAt.Equal(invs[j].CreatedAt) {
+			return invs[i].CreatedAt.Before(invs[j].CreatedAt)
+		}
+		return invs[i].ID < invs[j].ID
+	})
+	for i := range invs {
+		if invs[i].Number != "" {
+			continue
+		}
+		n := max(next[invs[i].OrgID], 1)
+		invs[i].Number = invoiceNumber(n)
+		next[invs[i].OrgID] = n + 1
+	}
+	return next, nil
+}
