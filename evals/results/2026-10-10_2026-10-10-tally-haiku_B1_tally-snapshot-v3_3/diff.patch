+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, orig, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	other := []byte("someone else's backup")
+	if err := os.WriteFile(path+".v1.bak", other, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := Upgrade(path); err == nil {
