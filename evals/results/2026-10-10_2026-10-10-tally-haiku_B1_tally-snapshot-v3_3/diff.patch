+	cb, _ := s.CreateCustomer(b.ID, "John", "john@example.com", t0)
+	line := []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}
+	mk := func(org Org, c Customer) Invoice {
+		t.Helper()
+		inv, err := s.CreateInvoice(Invoice{OrgID: org.ID, CustomerID: c.ID, Currency: money.USD, Lines: line}, t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	if got := mk(a, ca).Number; got != "INV-000001" {
+		t.Fatalf("first number = %q", got)
+	}
+	if got := mk(b, cb).Number; got != "INV-000001" {
+		t.Fatalf("another organization's first number = %q", got)
+	}
+	if got := mk(a, ca).Number; got != "INV-000002" {
+		t.Fatalf("second number = %q", got)
+	}
+	// A refused invoice takes no number.
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: cb.ID, Currency: money.USD, Lines: line}, t0); !errors.Is(err, ErrCustomerOrgMismatch) {
+		t.Fatalf("err = %v", err)
+	}
+	if got := mk(a, ca).Number; got != "INV-000003" {
+		t.Fatalf("number after a refused invoice = %q", got)
+	}
+	if got := s.Export().NextInvoiceNos; !reflect.DeepEqual(got, map[string]int{a.ID: 4, b.ID: 2}) {
+		t.Fatalf("next numbers = %v", got)
+	}
