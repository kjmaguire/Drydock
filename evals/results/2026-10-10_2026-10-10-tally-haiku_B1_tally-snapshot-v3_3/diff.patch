+	}
+	if b, _ := os.ReadFile(path + ".v1.bak"); !bytes.Equal(b, other) {
+		t.Fatal("the existing backup changed")
+	}
+	if b, _ := os.ReadFile(path); !bytes.Equal(b, orig) {
+		t.Fatal("a failed Upgrade changed the file")
