+// PendingInvites returns an organization's invites that can still be accepted at now: not accepted, not revoked and not
+// expired. Sorted by ID.
+func (s *Store) PendingInvites(orgID string, now time.Time) []Invite {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Invite{}
+	for _, inv := range s.invites {
+		if inv.OrgID == orgID && inv.AcceptedAt == nil && inv.RevokedAt == nil && !now.After(inv.ExpiresAt()) {
+			out = append(out, inv)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
+	return out
+}
