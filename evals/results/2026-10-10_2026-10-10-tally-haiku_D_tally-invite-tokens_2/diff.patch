+func TestInviteExpiry(t *testing.T) {
+	e := apitest.New(t)
+
+	// Exactly 7 days after creation the invite still works.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "week@people.example", "role": "member"}, nil)
+	week := inviteToken(t, e)
+	e.Clock.Advance(7 * 24 * time.Hour)
+	if r := acceptInvite(e, week); r.Code != http.StatusCreated {
+		t.Fatalf("accept after 7 days: %s", r)
+	}
+
+	// Later than 7 days it does not: the list leaves it out and accepting it is refused.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "late@people.example", "role": "member"}, nil)
+	late := inviteToken(t, e)
+	e.Clock.Advance(7*24*time.Hour + time.Second)
+	var pending struct{ Items []store.Invite }
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &pending)
+	if len(pending.Items) != 0 {
+		t.Fatalf("expired invites are listed: %+v", pending.Items)
+	}
+	if r := acceptInvite(e, late); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_expired" {
+		t.Fatalf("accept after expiry: %s", r)
+	}
+}
