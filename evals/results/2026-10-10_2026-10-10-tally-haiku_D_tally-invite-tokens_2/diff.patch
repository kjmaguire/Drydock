+// inviteToken returns the token in the newest invitation email.
+func inviteToken(t *testing.T, e *apitest.Env) string {
+	t.Helper()
+	msgs := e.Mail.Messages()
+	m := regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[len(msgs)-1].Body)
+	if m == nil {
+		t.Fatalf("no link in %q", msgs[len(msgs)-1].Body)
+	}
+	token, _ := url.QueryUnescape(m[1])
+	return token
+}
+
+func acceptInvite(e *apitest.Env, token string) *apitest.Response {
+	return e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "Invited Person"})
+}
+
+func TestInviteTokens(t *testing.T) {
+	e := apitest.New(t)
+
+	// The token is 32 random bytes in unpadded base64url, and only the email carries it.
+	r := e.Do("POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@people.example", "role": "member"})
+	if r.Code != http.StatusCreated {
+		t.Fatalf("invite: %s", r)
+	}
+	token := inviteToken(t, e)
+	if raw, err := base64.RawURLEncoding.DecodeString(token); err != nil || len(raw) != 32 || len(token) != 43 {
+		t.Fatalf("token %q is not 32 bytes in unpadded base64url", token)
+	}
+	if strings.Contains(r.String(), token) {
+		t.Fatalf("the create answer contains the token: %s", r)
+	}
+	var created struct {
+		ID        string    `json:"id"`
+		ExpiresAt time.Time `json:"expires_at"`
+	}
+	r.JSON(t, &created)
+	list := e.Do("GET", "/v1/invites", e.Acme.Key, nil)
+	if strings.Contains(list.String(), token) {
+		t.Fatalf("the list answer contains a token: %s", list)
+	}
+	var pending struct {
+		Items []struct {
+			ID        string    `json:"id"`
+			ExpiresAt time.Time `json:"expires_at"`
+		} `json:"items"`
+	}
+	list.JSON(t, &pending)
+	if len(pending.Items) != 1 || pending.Items[0].ID != created.ID || !pending.Items[0].ExpiresAt.Equal(created.ExpiresAt) {
+		t.Fatalf("pending = %+v, created = %+v", pending.Items, created)
+	}
+	if want := e.Clock.Now().Add(7 * 24 * time.Hour); !created.ExpiresAt.Equal(want) {
+		t.Fatalf("expires_at = %s, want %s", created.ExpiresAt, want)
+	}
+	state, err := json.Marshal(e.Store.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(state), token) {
+		t.Fatal("a snapshot contains the token")
+	}
+
+	// Inviting the same address again, in another case, revokes the old invite: only the newest token works.
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "New@People.example", "role": "viewer"}, nil)
+	newest := inviteToken(t, e)
+	if newest == token {
+		t.Fatal("the new invite reused the old token")
+	}
+	if r := acceptInvite(e, token); r.Code != http.StatusNotFound {
+		t.Fatalf("the replaced token: %s", r)
+	}
+	list = e.Do("GET", "/v1/invites", e.Acme.Key, nil)
+	if n := strings.Count(list.String(), `"email":"New@People.example"`); n != 1 {
+		t.Fatalf("pending after the re-invite = %s", list)
+	}
+
+	// Accepting once works; the same token again is used up.
+	if r := acceptInvite(e, newest); r.Code != http.StatusCreated {
+		t.Fatalf("accept: %s", r)
+	}
+	if r := acceptInvite(e, newest); r.Code != http.StatusGone || r.Map(t)["error"] != "invite_used" {
+		t.Fatalf("accept again: %s", r)
+	}
+
+	// A revoked invite is not found.
+	var gone struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "gone@people.example", "role": "member"}, &gone)
+	revoked := inviteToken(t, e)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+gone.ID, e.Acme.Key, nil, nil)
+	if r := acceptInvite(e, revoked); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("a revoked invite: %s", r)
+	}
+	if r := acceptInvite(e, "nope"); r.Code != http.StatusNotFound || r.Map(t)["error"] != "invite_not_found" {
+		t.Fatalf("an unknown token: %s", r)
+	}
+}
