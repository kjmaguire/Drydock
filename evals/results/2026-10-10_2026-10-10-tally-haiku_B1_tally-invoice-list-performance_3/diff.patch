+package api_test
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"reflect"
+	"sort"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+// wantInvoiceIDs is the list GET /v1/invoices must page through, worked out from the whole store.
+func wantInvoiceIDs(e *apitest.Env, org apitest.Org, f store.InvoiceFilter) []string {
+	var invs []store.Invoice
+	for _, inv := range e.Store.Export().Invoices {
+		if inv.OrgID != org.ID {
+			continue
+		}
+		if (f.CustomerID != "" && inv.CustomerID != f.CustomerID) || (f.SubscriptionID != "" && inv.SubscriptionID != f.SubscriptionID) || (f.Status != "" && inv.Status != f.Status) {
+			continue
+		}
+		invs = append(invs, inv)
+	}
+	sort.Slice(invs, func(i, j int) bool {
+		if !invs[i].CreatedAt.Equal(invs[j].CreatedAt) {
+			return invs[i].CreatedAt.Before(invs[j].CreatedAt)
+		}
+		return invs[i].ID < invs[j].ID
+	})
+	ids := []string{}
+	for _, inv := range invs {
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
+
+// cursorAt is the cursor of a page that starts after the invoice inv, as the API gives them out.
+func cursorAt(inv store.Invoice) string {
+	b, _ := json.Marshal(map[string]any{"t": inv.CreatedAt, "id": inv.ID})
+	return base64.RawURLEncoding.EncodeToString(b)
+}
+
+// listPage is one page of GET /v1/invoices, with the items as raw JSON so every field is compared.
+type listPage struct {
+	Items      []map[string]any `json:"items"`
+	NextCursor string           `json:"next_cursor"`
+}
+
+func TestInvoiceListPagesMatchTheListOrder(t *testing.T) {
+	e := apitest.New(t)
+	cus := []store.Customer{}
+	for i := 0; i < 4; i++ {
+		cus = append(cus, e.CreateCustomer(e.Acme, fmt.Sprintf("Cust %d", i), fmt.Sprintf("c%d@acme.example", i)))
+	}
+	gc := e.CreateCustomer(e.Globex, "Globex", "g@globex.example")
+	now := apitest.Start
+	for i := 0; i < 90; i++ {
+		switch {
+		case i%7 == 3:
+			now = now.Add(-time.Hour) // the clock went back: this invoice sorts before its predecessors
+		case i%5 != 0:
+			now = now.Add(time.Minute) // every fifth invoice shares the previous timestamp: ties go by ID
+		}
+		e.Clock.Set(now)
+		c := cus[i%4]
+		if _, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, SubscriptionID: []string{"", "sub_a", "sub_b"}[i%3], Currency: money.USD,
+			Lines: []store.Line{{Description: fmt.Sprintf("Item %d", i), Quantity: 1, UnitAmount: int64(100 + i)}}}, now); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := 0; i < 10; i++ {
+		e.Clock.Advance(time.Minute)
+		if _, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Globex.ID, CustomerID: gc.ID, Currency: money.USD, Lines: []store.Line{{Description: "G", Quantity: 1, UnitAmount: 1}}}, e.Clock.Now()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i, inv := range e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{}) {
+		switch {
+		case i%11 == 5:
+			e.Do("POST", "/v1/invoices/"+inv.ID+"/void", e.Acme.Key, nil)
+		case i%13 == 7:
+			e.Do("POST", "/v1/invoices/"+inv.ID+"/pay", e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"})
+		}
+	}
+
+	filters := []url.Values{
+		{}, {"customer_id": {cus[1].ID}}, {"subscription_id": {"sub_b"}}, {"status": {"paid"}}, {"status": {"void"}},
+		{"customer_id": {cus[2].ID}, "status": {"open"}}, {"subscription_id": {"sub_a"}, "status": {"paid"}}, {"customer_id": {gc.ID}},
+	}
+	for _, f := range filters {
+		fst := store.InvoiceFilter{CustomerID: f.Get("customer_id"), SubscriptionID: f.Get("subscription_id"), Status: store.InvoiceStatus(f.Get("status"))}
+		want := wantInvoiceIDs(e, e.Acme, fst)
+		for _, limit := range []int{1, 4, 20, 100} {
+			got := []string{}
+			cursor := ""
+			for pages := 0; ; pages++ {
+				q := url.Values{"limit": {fmt.Sprint(limit)}}
+				for k, v := range f {
+					q[k] = v
+				}
+				if cursor != "" {
+					q.Set("cursor", cursor)
+				}
+				var page listPage
+				e.MustDo(http.StatusOK, "GET", "/v1/invoices?"+q.Encode(), e.Acme.Key, nil, &page)
+				if len(page.Items) > limit {
+					t.Fatalf("%v: %d items with limit %d", f, len(page.Items), limit)
+				}
+				for _, item := range page.Items {
+					got = append(got, item["id"].(string))
+					// Every field of a listed invoice is what its own GET answers.
+					var one map[string]any
+					e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+item["id"].(string), e.Acme.Key, nil, &one)
+					if !reflect.DeepEqual(item, one) {
+						t.Fatalf("listed %v\nbut GET answers %v", item, one)
+					}
+				}
+				if page.NextCursor == "" {
+					break
+				}
+				cursor = page.NextCursor
+				if pages > len(want) {
+					t.Fatalf("%v: paging never ends", f)
+				}
+			}
+			if !reflect.DeepEqual(got, want) {
+				t.Fatalf("%v with limit %d: got %d invoices %v, want %d %v", f, limit, len(got), got, len(want), want)
+			}
+		}
+	}
+
+	// Invoices created between pages come after the cursor, and the paging carries on from it.
+	var first listPage
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=5", e.Acme.Key, nil, &first)
+	e.Clock.Set(apitest.Start.Add(24 * time.Hour)) // later than every invoice above
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": cus[0].ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "later", "quantity": 1, "unit_amount": 10}}}, nil)
+	got := []string{}
+	cursor := first.NextCursor
+	for cursor != "" {
+		var page listPage
+		e.MustDo(http.StatusOK, "GET", "/v1/invoices?limit=5&cursor="+url.QueryEscape(cursor), e.Acme.Key, nil, &page)
+		for _, item := range page.Items {
+			got = append(got, item["id"].(string))
+		}
+		cursor = page.NextCursor
+	}
+	firstIDs := []string{}
+	for _, item := range first.Items {
+		firstIDs = append(firstIDs, item["id"].(string))
+	}
+	all := wantInvoiceIDs(e, e.Acme, store.InvoiceFilter{})
+	if !reflect.DeepEqual(append(firstIDs, got...), all) {
+		t.Fatalf("paging across a new invoice = %v, want %v", append(firstIDs, got...), all)
+	}
+}
+
+func TestInvoiceListIsFastForALargeOrganization(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds 80,000 invoices")
+	}
+	e := apitest.New(t)
+	const customers, invoices, otherInvoices = 5000, 60000, 20000
+	cus := make([]store.Customer, 0, customers)
+	for i := 0; i < customers; i++ {
+		c, err := e.Store.CreateCustomer(e.Acme.ID, fmt.Sprintf("Customer %d", i), fmt.Sprintf("c%d@acme.example", i), e.Clock.Now())
+		if err != nil {
+			t.Fatal(err)
+		}
+		cus = append(cus, c)
+	}
+	ids := make([]store.Invoice, 0, invoices)
+	start := apitest.Start
+	for i := 0; i < invoices; i++ {
+		now := start.Add(time.Duration(i) * time.Second)
+		inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: cus[i%customers].ID, SubscriptionID: fmt.Sprintf("sub_%03d", i%100), Currency: money.USD,
+			Lines: []store.Line{{Description: "Seats", Quantity: 1 + int64(i%5), UnitAmount: 1000}}}, now)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i%10 == 0 {
+			_, _ = e.Store.UpdateInvoice(e.Acme.ID, inv.ID, func(x *store.Invoice) error { x.Status = store.InvoicePaid; return nil })
+		}
+		if i%1000 == 999 {
+			_, _ = e.Store.UpdateInvoice(e.Acme.ID, inv.ID, func(x *store.Invoice) error { x.Status = store.InvoiceVoid; return nil })
+		}
+		ids = append(ids, inv)
+	}
+	globex := []store.Customer{}
+	for i := 0; i < 50; i++ {
+		c, err := e.Store.CreateCustomer(e.Globex.ID, fmt.Sprintf("G %d", i), fmt.Sprintf("g%d@globex.example", i), e.Clock.Now())
+		if err != nil {
+			t.Fatal(err)
+		}
+		globex = append(globex, c)
+	}
+	for i := 0; i < otherInvoices; i++ {
+		if _, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Globex.ID, CustomerID: globex[i%50].ID, Currency: money.USD,
+			Lines: []store.Line{{Description: "G", Quantity: 1, UnitAmount: 1}}}, start.Add(time.Duration(i)*time.Second)); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	const budget = 250 * time.Millisecond // the check's allowance on a slow machine; ours is well under 100ms
+	cursor := func(inv store.Invoice) string { return "&cursor=" + url.QueryEscape(cursorAt(inv)) }
+	for _, tc := range []struct {
+		name, path string
+		want       int // items expected, or -1 for a full 100
+	}{
+		{"first page", "/v1/invoices", 20},
+		{"deep page", "/v1/invoices?limit=100" + cursor(ids[30000]), 100},
+		{"deep page of one customer", "/v1/invoices?limit=100&customer_id=" + cus[7].ID + cursor(ids[30000]), 6},
+		{"one customer", "/v1/invoices?customer_id=" + cus[7].ID, 12},
+		{"one subscription, deep", "/v1/invoices?limit=100&subscription_id=sub_042" + cursor(ids[50000]), -1},
+		{"rare status", "/v1/invoices?limit=100&status=void", 60},
+		{"one customer and a status that matches nothing", "/v1/invoices?customer_id=" + cus[7].ID + "&status=void", 0},
+		{"unknown customer", "/v1/invoices?customer_id=cus_nope", 0},
+		{"open, near the end", "/v1/invoices?limit=100&status=open" + cursor(ids[59000]), -1},
+	} {
+		began := time.Now()
+		r := e.Do("GET", tc.path, e.Acme.Key, nil)
+		elapsed := time.Since(began)
+		if r.Code != http.StatusOK {
+			t.Fatalf("%s: %s", tc.name, r)
+		}
+		var page listPage
+		r.JSON(t, &page)
+		if (tc.want >= 0 && len(page.Items) != tc.want) || (tc.want < 0 && len(page.Items) == 0) {
+			t.Errorf("%s: %d items", tc.name, len(page.Items))
+		}
+		t.Logf("%s: %v for %d items", tc.name, elapsed, len(page.Items))
+		if elapsed > budget {
+			t.Errorf("%s took %v, want under %v", tc.name, elapsed, budget)
+		}
+	}
+}
