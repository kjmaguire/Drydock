+// invoiceKey places an invoice in its organization's list: by creation time, then ID.
+type invoiceKey struct {
+	at time.Time
+	id string
+}
+
+func (k invoiceKey) less(o invoiceKey) bool {
+	if !k.at.Equal(o.at) {
+		return k.at.Before(o.at)
+	}
+	return k.id < o.id
+}
+
+// indexInvoice puts a new invoice in its organization's list order. The caller holds the lock. A new invoice is normally the
+// newest, so this is an append; a clock that went back puts it earlier.
+func (s *Store) indexInvoice(inv Invoice) {
+	k := invoiceKey{inv.CreatedAt, inv.ID}
+	keys := s.invoiceOrder[inv.OrgID]
+	if n := len(keys); n == 0 || keys[n-1].less(k) {
+		s.invoiceOrder[inv.OrgID] = append(keys, k)
+		return
+	}
+	i := sort.Search(len(keys), func(i int) bool { return k.less(keys[i]) })
+	keys = append(keys, invoiceKey{})
+	copy(keys[i+1:], keys[i:])
+	keys[i] = k
+	s.invoiceOrder[inv.OrgID] = keys
+}
