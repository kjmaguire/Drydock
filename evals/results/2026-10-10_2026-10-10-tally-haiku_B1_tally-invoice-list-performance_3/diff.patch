+
+// referenceInvoices is the list ListInvoices must answer, worked out from the whole store rather than the index.
+func referenceInvoices(s *Store, orgID string, f InvoiceFilter) []Invoice {
+	out := []Invoice{}
+	for _, inv := range s.Export().Invoices {
+		if inv.OrgID != orgID {
+			continue
+		}
+		if (f.CustomerID != "" && inv.CustomerID != f.CustomerID) || (f.SubscriptionID != "" && inv.SubscriptionID != f.SubscriptionID) || (f.Status != "" && inv.Status != f.Status) {
+			continue
+		}
+		out = append(out, inv)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+func newOrgTB(t testing.TB, s *Store, name string) Org {
+	t.Helper()
+	o, err := s.CreateOrg(name, OrgTeam, "UTC", 0, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return o
+}
+
+func invoiceIDs(invs []Invoice) []string {
+	ids := []string{}
+	for _, inv := range invs {
+		ids = append(ids, inv.ID)
+	}
+	return ids
+}
+
+// fillInvoices creates invoices for two organizations: several share a timestamp, some are created with the clock turned
+// back, some are paid, and some carry a subscription.
+func fillInvoices(t testing.TB, s *Store, n int) (a, b Org, ca, cb Customer) {
+	t.Helper()
+	a, b = newOrgTB(t, s, "A"), newOrgTB(t, s, "B")
+	ca, _ = s.CreateCustomer(a.ID, "Ann", "ann@a.example", t0)
+	cb, _ = s.CreateCustomer(b.ID, "Bob", "bob@b.example", t0)
+	subs := []string{"", "sub_1", "sub_2"}
+	for i := 0; i < n; i++ {
+		org, cus := a, ca
+		if i%4 == 3 {
+			org, cus = b, cb
+		}
+		now := t0.Add(time.Duration(i/3) * time.Minute)
+		if i%17 == 16 {
+			now = t0.Add(-time.Duration(i) * time.Second) // the clock went back
+		}
+		inv, err := s.CreateInvoice(Invoice{OrgID: org.ID, CustomerID: cus.ID, SubscriptionID: subs[i%3], Currency: money.USD,
+			Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: int64(i)}}}, now)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i%5 == 0 {
+			if _, err := s.UpdateInvoice(org.ID, inv.ID, func(i *Invoice) error { i.Status = InvoicePaid; return nil }); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	return a, b, ca, cb
+}
+
+var testFilters = func(ca, cb Customer) []InvoiceFilter {
+	return []InvoiceFilter{
+		{}, {CustomerID: ca.ID}, {CustomerID: cb.ID}, {CustomerID: "cus_none"}, {SubscriptionID: "sub_1"},
+		{SubscriptionID: "sub_2", Status: InvoiceOpen}, {Status: InvoicePaid}, {Status: InvoiceOpen}, {Status: InvoiceVoid},
+		{CustomerID: ca.ID, Status: InvoiceOpen},
+	}
+}
+
+func TestInvoicePageMatchesTheListOrder(t *testing.T) {
+	s := New()
+	a, b, ca, cb := fillInvoices(t, s, 120)
+	for _, org := range []Org{a, b} {
+		for _, f := range testFilters(ca, cb) {
+			want := referenceInvoices(s, org.ID, f)
+			if got := s.ListInvoices(org.ID, f); !reflect.DeepEqual(invoiceIDs(got), invoiceIDs(want)) {
+				t.Fatalf("ListInvoices(%+v) = %v, want %v", f, invoiceIDs(got), invoiceIDs(want))
+			}
+			for limit := 1; limit <= 9; limit++ {
+				var got []Invoice
+				var after *InvoicePosition
+				for pages := 0; ; pages++ {
+					if pages > len(want) {
+						t.Fatalf("paging %+v at %d never ends", f, limit)
+					}
+					page, more := s.InvoicePage(org.ID, f, after, limit)
+					if len(page) > limit || (more && len(page) != limit) {
+						t.Fatalf("page of %d with limit %d, more=%v", len(page), limit, more)
+					}
+					got = append(got, page...)
+					if !more {
+						break
+					}
+					last := page[len(page)-1]
+					after = &InvoicePosition{At: last.CreatedAt, ID: last.ID}
+				}
+				if !reflect.DeepEqual(invoiceIDs(got), invoiceIDs(want)) {
+					t.Fatalf("paging %+v with limit %d = %v, want %v", f, limit, invoiceIDs(got), invoiceIDs(want))
+				}
+			}
+			// A page that starts after each invoice of the list is the rest of the list.
+			for k, inv := range want {
+				page, more := s.InvoicePage(org.ID, f, &InvoicePosition{At: inv.CreatedAt, ID: inv.ID}, 1000)
+				if !reflect.DeepEqual(invoiceIDs(page), invoiceIDs(want[k+1:])) || more {
+					t.Fatalf("after %s: %v, want %v", inv.ID, invoiceIDs(page), invoiceIDs(want[k+1:]))
+				}
+			}
+		}
+	}
+	if got, more := s.InvoicePage(a.ID, InvoiceFilter{}, nil, 0); len(got) != 0 || !more {
+		t.Fatalf("limit 0 = %v, more %v", got, more)
+	}
+	if got, _ := s.InvoicePage("org_none", InvoiceFilter{}, nil, 10); got == nil || len(got) != 0 {
+		t.Fatalf("an organization without invoices = %v, want an empty list", got)
+	}
+}
