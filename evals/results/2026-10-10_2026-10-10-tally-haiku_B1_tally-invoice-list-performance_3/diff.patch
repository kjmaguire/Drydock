+func TestInvoiceOrderSurvivesSnapshot(t *testing.T) {
+	s := New()
+	a, _, ca, cb := fillInvoices(t, s, 60)
+	restored, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, f := range testFilters(ca, cb) {
+		if got, want := invoiceIDs(restored.ListInvoices(a.ID, f)), invoiceIDs(s.ListInvoices(a.ID, f)); !reflect.DeepEqual(got, want) {
+			t.Fatalf("restored %+v = %v, want %v", f, got, want)
+		}
+	}
+	// New invoices after a restore go in the right place too, including one from before the others.
+	early, _ := restored.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: ca.ID, Currency: money.USD, Lines: []Line{{Description: "e", Quantity: 1, UnitAmount: 1}}}, t0.Add(-time.Hour))
+	if got := restored.ListInvoices(a.ID, InvoiceFilter{}); got[0].ID != early.ID || !reflect.DeepEqual(invoiceIDs(got), invoiceIDs(referenceInvoices(restored, a.ID, InvoiceFilter{}))) {
+		t.Fatalf("after restore, the list starts with %s: %v", got[0].ID, invoiceIDs(got))
+	}
+}
