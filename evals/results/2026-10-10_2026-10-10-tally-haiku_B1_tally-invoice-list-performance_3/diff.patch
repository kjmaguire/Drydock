+func TestInvoicesCreatedBetweenPagesKeepTheCursorWorking(t *testing.T) {
+	s := New()
+	a, _, ca, _ := fillInvoices(t, s, 40)
+	page, more := s.InvoicePage(a.ID, InvoiceFilter{}, nil, 10)
+	if !more {
+		t.Fatal("expected more invoices")
+	}
+	last := page[len(page)-1]
+	pos := &InvoicePosition{At: last.CreatedAt, ID: last.ID}
+
+	// A newer invoice comes after the cursor; an older one (the clock went back) is before it and is not listed again.
+	newer, _ := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: ca.ID, Currency: money.USD, Lines: []Line{{Description: "n", Quantity: 1, UnitAmount: 1}}}, t0.Add(time.Hour))
+	older, _ := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: ca.ID, Currency: money.USD, Lines: []Line{{Description: "o", Quantity: 1, UnitAmount: 1}}}, t0.Add(-time.Hour))
+
+	var got []string
+	for {
+		page, more := s.InvoicePage(a.ID, InvoiceFilter{}, pos, 7)
+		got = append(got, invoiceIDs(page)...)
+		if !more {
+			break
+		}
+		last := page[len(page)-1]
+		pos = &InvoicePosition{At: last.CreatedAt, ID: last.ID}
+	}
+	want := []string{}
+	for _, inv := range referenceInvoices(s, a.ID, InvoiceFilter{}) {
+		if inv.CreatedAt.After(last.CreatedAt) || (inv.CreatedAt.Equal(last.CreatedAt) && inv.ID > last.ID) {
+			want = append(want, inv.ID)
+		}
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("rest of the list = %v, want %v", got, want)
+	}
+	if got[len(got)-1] != newer.ID {
+		t.Fatalf("the newer invoice %s is not last in %v", newer.ID, got)
+	}
+	for _, id := range got {
+		if id == older.ID {
+			t.Fatalf("the older invoice %s was listed after the cursor", older.ID)
+		}
+	}
+}
