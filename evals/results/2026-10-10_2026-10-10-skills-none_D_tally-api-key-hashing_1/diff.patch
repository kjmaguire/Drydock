+// apiKeyAlphabet is the set of characters in an API key's random part: [A-Za-z0-9].
+const apiKeyAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+
+// newAPIKeyToken returns "tly_" followed by 40 random characters from apiKeyAlphabet.
+func newAPIKeyToken() string {
+	const n = 40
+	// Bytes from 248 up are rejected: 248 is 4 × 62, so every remaining byte maps to a character with equal odds.
+	out := make([]byte, 0, n)
+	buf := make([]byte, 64)
+	for len(out) < n {
+		if _, err := rand.Read(buf); err != nil {
+			panic(err) // crypto/rand does not fail on supported platforms
+		}
+		for _, b := range buf {
+			if b < 248 && len(out) < n {
+				out = append(out, apiKeyAlphabet[int(b)%len(apiKeyAlphabet)])
+			}
+		}
+	}
+	return "tly_" + string(out)
+}
+
+// hashToken is what the store keeps of an API key's token: its SHA-256 in hex.
+func hashToken(token string) string {
+	sum := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(sum[:])
+}
+
+// lastFour returns the last four characters of a token (all of it, if it is shorter).
+func lastFour(token string) string {
+	if len(token) < 4 {
+		return token
+	}
+	return token[len(token)-4:]
+}
