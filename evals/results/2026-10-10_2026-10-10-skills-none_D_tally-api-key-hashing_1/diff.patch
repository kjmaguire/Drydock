+// A snapshot written before API keys were hashed keeps its plain-text tokens, which must keep working. The next snapshot
+// must not hold any of them.
+func TestLoadPlainTokensThenSave(t *testing.T) {
+	// Built at run time so that no token-shaped literal sits in the source.
+	token := "tly_" + strings.Repeat("ab", 20)
+	dir := t.TempDir()
+	old := filepath.Join(dir, "old.json")
+	body := fmt.Sprintf(`{"version": 2, "saved_at": "2026-02-01T12:00:00Z", "state": {
+		"orgs": [{"id": "org_000001", "name": "A", "plan": "free", "time_zone": "UTC"}],
+		"users": [{"id": "usr_000002", "email": "ann@example.com", "name": "Ann"}],
+		"members": [{"org_id": "org_000001", "user_id": "usr_000002", "role": "owner"}],
+		"api_keys": [{"id": "key_000003", "org_id": "org_000001", "user_id": "usr_000002", "name": "old", "token": %q}]}}`, token)
+	if err := os.WriteFile(old, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	st, err := Load(old)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := st.APIKeyByToken(token); !ok {
+		t.Fatal("a plain-text key does not work after loading")
+	}
+	next := filepath.Join(dir, "next.json")
+	if err := Save(st, next, time.Date(2026, 2, 2, 12, 0, 0, 0, time.UTC)); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), token) {
+		t.Fatal("the next snapshot holds a plain-text token")
+	}
+	again, err := Load(next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := again.APIKeyByToken(token); !ok {
+		t.Fatal("the key does not work after the next snapshot")
+	}
+}
