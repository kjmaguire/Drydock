+// payWithKey runs a pay request that carries an Idempotency-Key. A key used before for the same request replays that
+// request's response. A response of 500 or more is not kept, so a retry pays again.
+func (s *Server) payWithKey(w http.ResponseWriter, r *http.Request, orgID, key string, req payRequest) {
+	rec, claimed, err := s.idem.reserve(orgID, key, req, s.clock.Now())
+	switch {
+	case errors.Is(err, errIdempotencyReused):
+		writeError(w, http.StatusUnprocessableEntity, "idempotency_key_reused", "this Idempotency-Key was used for another request")
+		return
+	case errors.Is(err, errIdempotencyInProgress):
+		writeError(w, http.StatusConflict, "request_in_progress", "a request with this Idempotency-Key is still being handled")
+		return
+	case !claimed:
+		w.Header().Set("Idempotent-Replayed", "true")
+		writeStored(w, rec.status, rec.header, rec.body)
+		return
+	}
+	kept := false
+	defer func() {
+		if !kept { // the handler panicked
+			s.idem.drop(orgID, key, rec)
+		}
+	}()
+	resp := newCapture()
+	s.charge(resp, r, orgID, req.InvoiceID, req.PaymentMethod)
+	kept = true
+	if resp.status >= http.StatusInternalServerError {
+		s.idem.drop(orgID, key, rec)
+	} else {
+		s.idem.keep(rec, resp)
+	}
+	writeStored(w, resp.status, resp.header, resp.body.Bytes())
+}
