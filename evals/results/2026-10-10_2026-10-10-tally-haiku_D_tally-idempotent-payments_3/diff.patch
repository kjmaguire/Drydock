+package api_test
+
+import (
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/payments"
+	"example.com/tally/internal/store"
+)
+
+// openInvoice creates a customer with this email in org, and an open invoice of 10.00 for them.
+func openInvoice(e *apitest.Env, org apitest.Org, email string) store.Invoice {
+	c := e.CreateCustomer(org, "Jane", email)
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", org.Key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Pro", "quantity": 1, "unit_amount": 1000}}}, &inv)
+	return inv
+}
+
+// payWithKey pays an invoice with pm, sending key as the Idempotency-Key header.
+func payWithKey(e *apitest.Env, org apitest.Org, invoiceID, key, pm string) *apitest.Response {
+	h := http.Header{}
+	h.Set("Idempotency-Key", key)
+	return e.DoWith("POST", "/v1/invoices/"+invoiceID+"/pay", org.Key, map[string]string{"payment_method": pm}, h)
+}
+
+func TestIdempotencyKeyFormat(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(e, e.Acme, "jane@one.example")
+	for _, key := range []string{"", strings.Repeat("k", 256), "ключ", "tab\tkey", "del\x7f"} {
+		if r := payWithKey(e, e.Acme, inv.ID, key, "pm_card_declined"); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_idempotency_key" {
+			t.Fatalf("key %q: %s", key, r)
+		}
+	}
+	// Valid keys are accepted; a declined payment is used so that nothing is charged.
+	for _, key := range []string{"k", strings.Repeat("k", 255), "order 42!~"} {
+		if r := payWithKey(e, e.Acme, inv.ID, key, "pm_card_declined"); r.Code != http.StatusPaymentRequired {
+			t.Fatalf("key %q: %s", key, r)
+		}
+	}
+	if n := len(e.Gateway.Charges()); n != 0 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestIdempotentRetryGetsTheFirstResponse(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(e, e.Acme, "jane@one.example")
+	first := payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_declined")
+	if first.Code != http.StatusPaymentRequired || first.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("first: %s", first)
+	}
+	retry := payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_declined")
+	if retry.Code != first.Code || string(retry.Body) != string(first.Body) || retry.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("retry: %s (replayed %q), first: %s", retry, retry.Header.Get("Idempotent-Replayed"), first)
+	}
+	if n := len(e.Gateway.Calls()); n != 1 {
+		t.Fatalf("%d gateway calls", n)
+	}
+
+	paid := payWithKey(e, e.Acme, inv.ID, "k2", "pm_card_visa")
+	if paid.Code != http.StatusOK {
+		t.Fatalf("pay: %s", paid)
+	}
+	again := payWithKey(e, e.Acme, inv.ID, "k2", "pm_card_visa")
+	if again.Code != http.StatusOK || string(again.Body) != string(paid.Body) || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("replay of the payment: %s", again)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestIdempotencyKeyReusedForAnotherRequest(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(e, e.Acme, "jane@one.example")
+	other := openInvoice(e, e.Acme, "john@one.example")
+	payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_declined")
+	if r := payWithKey(e, e.Acme, other.ID, "k1", "pm_card_declined"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("another invoice: %s", r)
+	}
+	if r := payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_visa"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+		t.Fatalf("another body: %s", r)
+	}
+}
+
+func TestIdempotencyKeysBelongToAnOrganization(t *testing.T) {
+	e := apitest.New(t)
+	acme := openInvoice(e, e.Acme, "jane@one.example")
+	globex := openInvoice(e, e.Globex, "jane@two.example")
+	payWithKey(e, e.Acme, acme.ID, "same", "pm_card_visa")
+	r := payWithKey(e, e.Globex, globex.ID, "same", "pm_card_visa")
+	if r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("the other organization's pay: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestServerErrorsAreNotKept(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(e, e.Acme, "jane@one.example")
+	if r := payWithKey(e, e.Acme, inv.ID, "k1", "pm_gateway_down"); r.Code != http.StatusServiceUnavailable {
+		t.Fatalf("gateway down: %s", r)
+	}
+	r := payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_visa")
+	if r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("retry after a 503: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestIdempotencyKeyExpiresAfterADay(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(e, e.Acme, "jane@one.example")
+	payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_declined")
+	e.Clock.Advance(23 * time.Hour)
+	if r := payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_declined"); r.Header.Get("Idempotent-Replayed") != "true" || r.Code != http.StatusPaymentRequired {
+		t.Fatalf("23 hours later: %s", r)
+	}
+	e.Clock.Advance(2 * time.Hour)
+	if r := payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_visa"); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("a day later the key is new: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestSameKeyWhileTheFirstRequestIsRunning(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(e, e.Acme, "jane@one.example")
+	started, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	e.Gateway.OnCharge = func(payments.ChargeRequest) { once.Do(func() { close(started); <-release }) }
+	first := make(chan *apitest.Response, 1)
+	go func() { first <- payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_visa") }()
+	<-started
+	if r := payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_visa"); r.Code != http.StatusConflict || r.Map(t)["error"] != "request_in_progress" {
+		t.Fatalf("while running: %s", r)
+	}
+	close(release)
+	if r := <-first; r.Code != http.StatusOK {
+		t.Fatalf("first request: %s", r)
+	}
+	if r := payWithKey(e, e.Acme, inv.ID, "k1", "pm_card_visa"); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("after it finished: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func TestInvoiceIsNotChargedTwiceAtOnce(t *testing.T) {
+	e := apitest.New(t)
+	inv := openInvoice(e, e.Acme, "jane@one.example")
+	started, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	e.Gateway.OnCharge = func(payments.ChargeRequest) { once.Do(func() { close(started); <-release }) }
+	first := make(chan *apitest.Response, 1)
+	go func() {
+		first <- e.Do("POST", "/v1/invoices/"+inv.ID+"/pay", e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"})
+	}()
+	<-started
+	if r := e.Do("POST", "/v1/invoices/"+inv.ID+"/pay", e.Acme.Key, map[string]string{"payment_method": "pm_card_visa"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("without a key, while charging: %s", r)
+	}
+	if r := payWithKey(e, e.Acme, inv.ID, "k2", "pm_card_visa"); r.Code != http.StatusConflict || r.Map(t)["error"] != "payment_in_progress" {
+		t.Fatalf("with another key, while charging: %s", r)
+	}
+	close(release)
+	if r := <-first; r.Code != http.StatusOK {
+		t.Fatalf("first request: %s", r)
+	}
+	if r := payWithKey(e, e.Acme, inv.ID, "k3", "pm_card_visa"); r.Code != http.StatusConflict || r.Map(t)["error"] != "already_paid" {
+		t.Fatalf("after the charge: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
