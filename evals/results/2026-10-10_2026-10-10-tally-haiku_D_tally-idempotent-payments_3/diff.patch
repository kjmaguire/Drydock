+package api
+
+import (
+	"bytes"
+	"errors"
+	"net/http"
+	"sync"
+	"time"
+)
+
+// idempotencyTTL is how long a kept response is replayed.
+const idempotencyTTL = 24 * time.Hour
+
+var (
+	errIdempotencyReused     = errors.New("idempotency key used for another request")
+	errIdempotencyInProgress = errors.New("idempotency key's request is still in progress")
+)
+
+// payRequest is what a pay request asks for. A key may only be reused for the same one.
+type payRequest struct {
+	InvoiceID     string
+	PaymentMethod string
+}
+
+// idemRecord is the request that claimed an Idempotency-Key, and its response once it is kept.
+type idemRecord struct {
+	req       payRequest
+	createdAt time.Time
+	done      bool
+	status    int
+	header    http.Header
+	body      []byte
+}
+
+type idemKey struct{ org, key string }
+
+// idempotency keeps the responses to requests that carried an Idempotency-Key, per organization. It is in memory, like the
+// store.
+type idempotency struct {
+	mu      sync.Mutex
+	records map[idemKey]*idemRecord
+}
+
+// reserve claims key for req in an organization. A new key (or one whose response has expired) is claimed for req: reserve
+// returns its record and true, and the caller must settle it with keep or drop. A key whose response is kept returns that
+// record and false, to replay. A key used for another request, or whose request is still running, returns an error.
+func (c *idempotency) reserve(orgID, key string, req payRequest, now time.Time) (*idemRecord, bool, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.records == nil {
+		c.records = map[idemKey]*idemRecord{}
+	}
+	k := idemKey{orgID, key}
+	rec, ok := c.records[k]
+	if ok && !now.Before(rec.createdAt.Add(idempotencyTTL)) {
+		ok = false
+	}
+	if ok {
+		switch {
+		case rec.req != req:
+			return nil, false, errIdempotencyReused
+		case !rec.done:
+			return nil, false, errIdempotencyInProgress
+		}
+		return rec, false, nil
+	}
+	rec = &idemRecord{req: req, createdAt: now}
+	c.records[k] = rec
+	return rec, true, nil
+}
+
+// keep stores the response of the request that claimed rec, for replay.
+func (c *idempotency) keep(rec *idemRecord, resp *capture) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	rec.done = true
+	rec.status = resp.status
+	rec.header = resp.header.Clone()
+	rec.body = resp.body.Bytes()
+}
+
+// drop releases the key of rec, so that a retry runs its request again.
+func (c *idempotency) drop(orgID, key string, rec *idemRecord) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.records[idemKey{orgID, key}] == rec {
+		delete(c.records, idemKey{orgID, key})
+	}
+}
+
+// idempotencyKey reads the Idempotency-Key header: "" when there is none, or answers 400 and returns false when it is not
+// 1 to 255 printable ASCII characters.
+func idempotencyKey(w http.ResponseWriter, r *http.Request) (string, bool) {
+	vals := r.Header.Values("Idempotency-Key")
+	if len(vals) == 0 {
+		return "", true
+	}
+	key := vals[0]
+	ok := len(vals) == 1 && len(key) >= 1 && len(key) <= 255
+	for i := 0; ok && i < len(key); i++ {
+		ok = key[i] >= 0x20 && key[i] <= 0x7e
+	}
+	if !ok {
+		writeError(w, http.StatusBadRequest, "invalid_idempotency_key", "Idempotency-Key is 1 to 255 printable ASCII characters")
+		return "", false
+	}
+	return key, true
+}
+
+// capture records a response, so that it can be kept and replayed.
+type capture struct {
+	header http.Header
+	status int
+	body   bytes.Buffer
+}
+
+func newCapture() *capture { return &capture{header: http.Header{}, status: http.StatusOK} }
+
+func (c *capture) Header() http.Header { return c.header }
+
+func (c *capture) WriteHeader(status int) { c.status = status }
+
+func (c *capture) Write(b []byte) (int, error) { return c.body.Write(b) }
+
+// writeStored answers with a recorded response: its status, headers and body.
+func writeStored(w http.ResponseWriter, status int, header http.Header, body []byte) {
+	for k, vs := range header {
+		w.Header()[k] = vs
+	}
+	w.WriteHeader(status)
+	_, _ = w.Write(body)
+}
