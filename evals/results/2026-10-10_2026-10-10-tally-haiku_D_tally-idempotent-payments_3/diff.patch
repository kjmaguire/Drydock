@@ -0,0 +1,84 @@
+package payments
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+
+	"example.com/tally/internal/store"
+)
+
+func TestPayHoldsTheInvoiceWhileCharging(t *testing.T) {
+	s, gw, _, inv := setup(t, store.Line{Description: "x", Quantity: 1, UnitAmount: 500})
+	started, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	gw.OnCharge = func(ChargeRequest) {
+		once.Do(func() {
+			close(started)
+			<-release
+		})
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa")
+		done <- err
+	}()
+	<-started
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); !errors.Is(err, ErrPaymentInProgress) {
+		t.Fatalf("pay while charging: %v", err)
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if n := len(gw.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); !errors.Is(err, ErrAlreadyPaid) {
+		t.Fatalf("pay after the charge: %v", err)
+	}
+}
+
+func TestRetryDoesNotChargeAgainWhenThePaymentCannotBeStored(t *testing.T) {
+	s, gw, _, inv := setup(t, store.Line{Description: "x", Quantity: 1, UnitAmount: 500})
+	st := s.Store
+	gw.OnCharge = func(ChargeRequest) {
+		// The gateway takes the money; the store does not know the invoice when the payment is recorded.
+		s.Store = store.New()
+	}
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); err == nil {
+		t.Fatal("pay with the payment unstored: no error")
+	}
+	gw.OnCharge = nil
+	s.Store = st
+	got, p, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa")
+	if err != nil {
+		t.Fatalf("retry: %v", err)
+	}
+	if got.Status != store.InvoicePaid || p.Status != store.PaymentSucceeded {
+		t.Fatalf("retry settled to invoice %q and payment %q", got.Status, p.Status)
+	}
+	if n := len(gw.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+	if ps := st.Payments(inv.OrgID, inv.ID); len(ps) != 1 {
+		t.Fatalf("%d payments stored", len(ps))
+	}
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); !errors.Is(err, ErrAlreadyPaid) {
+		t.Fatalf("pay after the retry: %v", err)
+	}
+}
+
+func TestPayReleasesTheInvoiceWhenTheChargeFails(t *testing.T) {
+	s, gw, _, inv := setup(t, store.Line{Description: "x", Quantity: 1, UnitAmount: 500})
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_gateway_down"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("gateway down: %v", err)
+	}
+	if _, _, err := s.Pay(context.Background(), inv.OrgID, inv.ID, "pm_card_visa"); err != nil {
+		t.Fatalf("pay after a failed charge: %v", err)
+	}
+	if n := len(gw.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
