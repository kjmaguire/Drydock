+func TestDeclinedRenewalIsPastDue(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := licensedSub(t, e, "jane@example.com", "pm_card_declined")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); n != 1 || err != nil {
