+// licensedSub starts a $20-a-month subscription for a new customer. Its first period is not charged (the customer has no
+// payment method yet); pm is the customer's payment method from then on, so renewals charge it.
+func licensedSub(t *testing.T, e *apitest.Env, email, pm string) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", email)
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = pm; return nil })
+	return sub
+}
+
+func TestRenewalChargesOncePerPeriodAcrossRepeatedRuns(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := licensedSub(t, e, "jane@example.com", "pm_card_visa")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	total := 0
+	for range 3 {
+		n, err := e.Subs.RenewDue(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		total += n
+	}
+	if total != 1 {
+		t.Fatalf("renewed %d times, want 1", total)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoicePaid {
+		t.Fatalf("invoices = %+v, want the first (open) and the paid renewal", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 1 || cs[0].Amount != 2000 {
+		t.Fatalf("charges = %+v, want one charge of 2000", cs)
+	}
+}
+
+func TestConcurrentRenewDueChargesOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := licensedSub(t, e, "jane@example.com", "pm_card_visa")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	// Hold each charge a moment, so that the calls overlap.
+	e.Gateway.OnCharge = func(payments.ChargeRequest) { time.Sleep(5 * time.Millisecond) }
+	var (
+		mu    sync.Mutex
+		total int
+		errs  []error
+		wg    sync.WaitGroup
+	)
+	for range 20 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			n, err := e.Subs.RenewDue(ctx)
+			mu.Lock()
+			defer mu.Unlock()
+			total += n
+			if err != nil {
+				errs = append(errs, err)
+			}
+		}()
+	}
+	wg.Wait()
+	if len(errs) != 0 || total != 1 {
+		t.Fatalf("renewed %d times, errors %v; want 1 and none", total, errs)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 {
+		t.Fatalf("invoices = %d, want 2 (the first and one renewal)", len(invs))
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 1 {
+		t.Fatalf("charges = %d, want 1", len(cs))
+	}
+}
+
+func TestGatewayDownRenewalMovesThePeriodAndKeepsTheStatus(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := licensedSub(t, e, "jane@example.com", "pm_gateway_down")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	n, err := e.Subs.RenewDue(ctx)
+	if !errors.Is(err, payments.ErrUnavailable) || n != 1 {
+		t.Fatalf("RenewDue = %d, %v; want 1 and the gateway error", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(sub.CurrentPeriodEnd) {
+		t.Fatalf("subscription = %+v, want the next period and the status kept", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoiceOpen {
+		t.Fatalf("invoices = %+v, want the renewal open", invs)
+	}
+	if n, err := e.Subs.RenewDue(ctx); n != 0 || err != nil {
+		t.Fatalf("second RenewDue = %d, %v; the period was already renewed", n, err)
+	}
+	if calls := e.Gateway.Calls(); len(calls) != 1 {
+		t.Fatalf("gateway calls = %d, want 1", len(calls))
+	}
+}
