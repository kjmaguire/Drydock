+	e.Clock.Set(good.CurrentPeriodEnd)
+	n, err := e.Subs.RenewDue(ctx)
+	if !errors.Is(err, payments.ErrUnavailable) || n != 2 {
+		t.Fatalf("RenewDue = %d, %v; want both renewed and the gateway error", n, err)
+	}
+	if got, _ := e.Store.Subscription(e.Acme.ID, failing.ID); !got.CurrentPeriodStart.Equal(good.CurrentPeriodEnd) {
+		t.Fatalf("failing subscription = %+v, want its period moved on", got)
