+// timeoutDoer checks that each request has a deadline 10 seconds away, then times out.
+type timeoutDoer struct{ t *testing.T }
+
+func (d timeoutDoer) Do(req *http.Request) (*http.Response, error) {
+	dl, ok := req.Context().Deadline()
+	if !ok || time.Until(dl) > 10*time.Second {
+		d.t.Errorf("request deadline = %v (set: %v), want within 10 seconds", time.Until(dl), ok)
+	}
+	return nil, context.DeadlineExceeded
+}
