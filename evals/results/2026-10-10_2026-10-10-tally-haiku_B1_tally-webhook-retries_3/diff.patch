+// runUntil runs the due deliveries of the endpoints as the clock moves from its time to end, one attempt at each moment a
+// delivery is due.
+func runUntil(t *testing.T, e *apitest.Env, end time.Time, eps ...store.WebhookEndpoint) {
+	t.Helper()
+	for {
+		if _, err := e.Webhooks.RunDue(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+		now, next := e.Clock.Now(), end
+		for _, ep := range eps {
+			for _, d := range e.Store.Deliveries(e.Acme.ID, ep.ID) {
+				if d.Status == store.DeliveryPending && d.NextAttemptAt != nil && d.NextAttemptAt.After(now) && d.NextAttemptAt.Before(next) {
+					next = *d.NextAttemptAt
+				}
+			}
+		}
+		if !next.After(now) {
+			return
+		}
+		e.Clock.Set(next)
+	}
+}
