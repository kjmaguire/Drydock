+func TestRetrySchedule(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep := newEndpoint(t, e, "https://hooks.acme.example/retry")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusInternalServerError, nil }
+	publish(t, e, "customer.created")
+
+	for attempt := 1; attempt <= 7; attempt++ {
+		if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+			t.Fatalf("attempt %d: RunDue = %d, %v", attempt, n, err)
+		}
+		d := onlyDelivery(t, e, ep)
+		if d.Attempts != attempt || d.ResponseStatus != 500 || d.Error == "" || d.LastAttemptAt == nil || !d.LastAttemptAt.Equal(e.Clock.Now()) {
+			t.Fatalf("after attempt %d: %+v", attempt, d)
+		}
+		if attempt == 7 {
+			if d.Status != store.DeliveryFailed || d.NextAttemptAt != nil {
+				t.Fatalf("after the last attempt: %+v, want failed with no next attempt", d)
+			}
+			break
+		}
+		wait := retryWaits[attempt-1]
+		if d.Status != store.DeliveryPending || d.NextAttemptAt == nil || !d.NextAttemptAt.Equal(e.Clock.Now().Add(wait)) {
+			t.Fatalf("after attempt %d: %+v, want pending and next attempt %v later", attempt, d, wait)
+		}
+		e.Clock.Advance(wait - time.Second)
+		if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+			t.Fatalf("attempt %d was made %v early", attempt+1, time.Second)
+		}
+		e.Clock.Advance(time.Second)
+	}
+	if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+		t.Fatalf("a failed-for-good delivery was sent again: %d", n)
+	}
+	if got := len(e.HTTP.Requests()); got != 7 {
+		t.Fatalf("%d requests, want 7", got)
+	}
+}
