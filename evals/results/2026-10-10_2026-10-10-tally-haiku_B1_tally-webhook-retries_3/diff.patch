+// mailOwners emails every owner of the organization that the endpoint keeps failing. It emails at most once per endpoint in
+// failureMailInterval.
+func (s *Service) mailOwners(ctx context.Context, orgID, endpointID string, now time.Time) error {
+	ep, ok := s.store.WebhookEndpoint(orgID, endpointID)
+	if !ok || (ep.FailureMailedAt != nil && now.Sub(*ep.FailureMailedAt) < failureMailInterval) {
+		return nil
+	}
+	var errs []error
+	for _, m := range s.store.Members(orgID) {
+		if m.Role != store.RoleOwner {
+			continue
+		}
+		u, ok := s.store.User(m.UserID)
+		if !ok {
+			continue
+		}
+		err := s.mail.Send(ctx, mail.Message{
+			To:      u.Email,
+			Subject: "Webhook endpoint failing: " + ep.URL,
+			Body: fmt.Sprintf("Tally could not deliver events to the webhook endpoint %s after %d attempts, so the deliveries have failed.\n\n"+
+				"Check that the endpoint is up and answers with a 2xx status. Its deliveries are listed in the dashboard.\n", ep.URL, maxAttempts),
+		})
+		if err != nil {
+			errs = append(errs, err)
 		}
+	}
+	// The mark is set even when some emails failed, so that the owners who got theirs are not emailed again.
+	_, _ = s.store.UpdateWebhookEndpoint(orgID, endpointID, func(ep *store.WebhookEndpoint) error {
+		ep.FailureMailedAt = &now
 		return nil
 	})
+	return errors.Join(errs...)
 }
 
