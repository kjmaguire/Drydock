+	ctx := context.Background()
+	ep := newEndpoint(t, e, "https://hooks.acme.example/gone")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusGone, nil }
+	publish(t, e, "customer.created")
+	publish(t, e, "customer.updated")
+	if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v (only one attempt: the endpoint is gone after it)", n, err)
+	}
+	if reqs := e.HTTP.Requests(); len(reqs) != 1 {
+		t.Fatalf("%d requests, want 1", len(reqs))
+	}
+	got, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if got.Enabled || got.DisabledReason != "gone" {
+		t.Fatalf("endpoint = %+v, want disabled for gone", got)
+	}
+	attempts := 0
+	for _, d := range e.Store.Deliveries(e.Acme.ID, ep.ID) {
+		attempts += d.Attempts
+		if d.Status != store.DeliveryFailed || d.NextAttemptAt != nil || d.Error == "" {
+			t.Fatalf("delivery = %+v, want failed for good", d)
+		}
+	}
+	if attempts != 1 {
+		t.Fatalf("attempts = %d, want 1", attempts)
+	}
+	e.Clock.Advance(time.Hour)
+	if n, _ := e.Webhooks.RunDue(ctx); n != 0 || len(e.HTTP.Requests()) != 1 {
+		t.Fatalf("a delivery to a gone endpoint was sent")
+	}
+	if len(e.Mail.Messages()) != 0 {
+		t.Fatalf("a 410 emailed the owners: %+v", e.Mail.Messages())
+	}
+}
+
+func TestOwnersEmailedWhenDeliveryFailsForGood(t *testing.T) {
+	e := apitest.New(t)
+	e.AddMember(e.Acme, "second@acme.example", store.RoleOwner)
+	e.AddMember(e.Acme, "admin@acme.example", store.RoleAdmin)
+	ep := newEndpoint(t, e, "https://hooks.acme.example/down")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusServiceUnavailable, nil }
+	start := e.Clock.Now()
+	publish(t, e, "customer.created")
+	publish(t, e, "customer.updated")
+
+	// The two deliveries fail for good at the same moment: the owners get one email each, not one per delivery.
+	runUntil(t, e, start.Add(48*time.Hour), ep)
+	msgs := e.Mail.Messages()
+	if len(msgs) != 2 {
+		t.Fatalf("%d emails, want 2 (one per owner): %+v", len(msgs), msgs)
+	}
+	to := map[string]bool{}
+	for _, m := range msgs {
+		to[m.To] = true
+		if m.Subject != "Webhook endpoint failing: https://hooks.acme.example/down" {
+			t.Fatalf("subject = %q", m.Subject)
+		}
+	}
+	if !to["owner@acme.example"] || !to["second@acme.example"] || to["admin@acme.example"] {
+		t.Fatalf("recipients = %v", to)
+	}
+	if got, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID); got.FailureMailedAt == nil {
+		t.Fatal("the endpoint does not record the email")
+	}
+}
+
+func TestFailureEmailAtMostOncePerDay(t *testing.T) {
+	e := apitest.New(t)
+	ep := newEndpoint(t, e, "https://hooks.acme.example/flaky")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusServiceUnavailable, nil }
+	start := e.Clock.Now()
+
+	// The first delivery fails for good 34h36m after it is made; the second, made 12 hours later, fails for good 12 hours
+	// after the first email, within a day of it.
+	publish(t, e, "customer.created")
+	runUntil(t, e, start.Add(12*time.Hour), ep)
+	publish(t, e, "customer.updated")
+	runUntil(t, e, start.Add(100*time.Hour), ep)
+	if n := len(e.Mail.Messages()); n != 1 {
+		t.Fatalf("%d emails after two failures within a day, want 1 (the owner, once)", n)
+	}
+
+	// A failure more than a day after the last email is emailed again.
+	publish(t, e, "invoice.paid")
+	runUntil(t, e, start.Add(200*time.Hour), ep)
+	if n := len(e.Mail.Messages()); n != 2 {
+		t.Fatalf("%d emails, want 2", n)
 	}
 }
