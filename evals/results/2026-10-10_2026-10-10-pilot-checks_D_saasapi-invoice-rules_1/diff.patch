-// Compute returns the totals of an invoice: the subtotal of its lines, the credit and the coupon, then tax.
+// Compute returns the totals of an invoice: the subtotal of its lines, then the coupon,
+// then the credit (never taking the amount below zero), then tax on what remains.
 func Compute(inv store.Invoice) Totals {
 	var subtotal int64
 	for _, l := range inv.Lines {
 		subtotal += int64(l.Quantity) * l.UnitCents
 	}
-	afterCredit := subtotal - inv.CreditCents
-	coupon := afterCredit * int64(inv.CouponPercent) / 100
-	discounted := afterCredit - coupon
-	tax := discounted * int64(inv.TaxRateBP) / 10000
-	return Totals{SubtotalCents: subtotal, DiscountCents: subtotal - discounted, TaxCents: tax, TotalCents: discounted + tax}
+	coupon := divRoundHalfUp(subtotal*int64(inv.CouponPercent), 100)
+	afterCoupon := subtotal - coupon
+	afterDiscounts := max(afterCoupon-inv.CreditCents, 0)
+	tax := divRoundHalfUp(afterDiscounts*int64(inv.TaxRateBP), 10000)
+	return Totals{SubtotalCents: subtotal, DiscountCents: subtotal - afterDiscounts, TaxCents: tax, TotalCents: afterDiscounts + tax}
+}
+
+// divRoundHalfUp returns num/den rounded to the nearest integer, with halves rounded up.
+// It is for non-negative num and positive den.
+func divRoundHalfUp(num, den int64) int64 {
+	return (num + den/2) / den
 }
