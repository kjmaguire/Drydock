+
+func TestCouponIsAppliedToTheSubtotalBeforeCredit(t *testing.T) {
+	inv := store.Invoice{Lines: []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 10000}}, CouponPercent: 10, CreditCents: 500}
+	got := Compute(inv)
+	want := Totals{SubtotalCents: 10000, DiscountCents: 1500, TaxCents: 0, TotalCents: 8500}
+	if got != want {
+		t.Fatalf("got %+v, want %+v", got, want)
+	}
+}
+
+func TestCouponAndCreditWithTax(t *testing.T) {
+	inv := store.Invoice{
+		Lines:         []store.LineItem{{Description: "Seats", Quantity: 3, UnitCents: 2500}, {Description: "Setup", Quantity: 1, UnitCents: 2500}},
+		CouponPercent: 15,
+		CreditCents:   1000,
+		TaxRateBP:     825,
+	}
+	got := Compute(inv)
+	// Coupon 1500, after coupon 8500, after credit 7500, tax 618.75 rounds to 619.
+	want := Totals{SubtotalCents: 10000, DiscountCents: 2500, TaxCents: 619, TotalCents: 8119}
+	if got != want {
+		t.Fatalf("got %+v, want %+v", got, want)
+	}
+}
+
+func TestCreditIsCappedAtTheAmountAfterCoupon(t *testing.T) {
+	inv := store.Invoice{Lines: []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 1000}}, CreditCents: 5000, TaxRateBP: 825}
+	got := Compute(inv)
+	want := Totals{SubtotalCents: 1000, DiscountCents: 1000, TaxCents: 0, TotalCents: 0}
+	if got != want {
+		t.Fatalf("got %+v, want %+v", got, want)
+	}
+}
+
+func TestCouponHalfCentRoundsUp(t *testing.T) {
+	// 50% of 1005 is 502.5, which rounds up to a coupon of 503.
+	inv := store.Invoice{Lines: []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 1005}}, CouponPercent: 50}
+	got := Compute(inv)
+	want := Totals{SubtotalCents: 1005, DiscountCents: 503, TaxCents: 0, TotalCents: 502}
+	if got != want {
+		t.Fatalf("got %+v, want %+v", got, want)
+	}
+}
+
+func TestTaxHalfCentRoundsUp(t *testing.T) {
+	// 5% of 1010 is 50.5, which rounds up to tax of 51.
+	inv := store.Invoice{Lines: []store.LineItem{{Description: "Seats", Quantity: 1, UnitCents: 1010}}, TaxRateBP: 500}
+	got := Compute(inv)
+	want := Totals{SubtotalCents: 1010, DiscountCents: 0, TaxCents: 51, TotalCents: 1061}
