+// TestObjectsOfAnotherOrganizationAreNotFound: every route that takes an ID in the path answers another organization's object
+// as 404 not_found, the same as an unknown one, and changes nothing.
+func TestObjectsOfAnotherOrganizationAreNotFound(t *testing.T) {
+	e := apitest.New(t)
+	gc := e.CreateCustomer(e.Globex, "Gina", "gina@globex.example")
+	gp := e.CreatePlan(e.Globex, "Business", "USD", "20.00")
+	var gs struct{ ID string }
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Globex.Key, map[string]any{"customer_id": gc.ID, "plan_id": gp.ID}, &gs)
+	var gi struct{ ID string }
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Globex.Key, invoiceBody(gc.ID), &gi)
+	now := e.Clock.Now()
+	ge, err := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Globex.ID, URL: "https://hooks.globex.example/in", Events: []string{"*"}, Enabled: true}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ev, err := e.Store.AddEvent(e.Globex.ID, "invoice.paid", json.RawMessage(`{}`), now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inv, err := e.Store.CreateInvite(e.Globex.ID, "new@globex.example", store.RoleMember, e.Globex.Owner.ID, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	gk, _ := e.Store.APIKeyByToken(e.Globex.Key)
+
+	probes := []struct{ method, path, body, id string }{
+		{"GET", "/v1/customers/%s", "", gc.ID},
+		{"PATCH", "/v1/customers/%s", `{"name":"Taken"}`, gc.ID},
+		{"DELETE", "/v1/customers/%s", "", gc.ID},
+		{"GET", "/v1/plans/%s", "", gp.ID},
+		{"PATCH", "/v1/plans/%s", `{"name":"Taken"}`, gp.ID},
+		{"GET", "/v1/subscriptions/%s", "", gs.ID},
+		{"PATCH", "/v1/subscriptions/%s", `{"quantity":5}`, gs.ID},
+		{"POST", "/v1/subscriptions/%s/cancel", "", gs.ID},
+		{"POST", "/v1/subscriptions/%s/usage", `{"quantity":1}`, gs.ID},
+		{"GET", "/v1/invoices/%s", "", gi.ID},
+		{"POST", "/v1/invoices/%s/pay", "", gi.ID},
+		{"POST", "/v1/invoices/%s/void", "", gi.ID},
+		{"GET", "/v1/webhook-endpoints/%s", "", ge.ID},
+		{"PATCH", "/v1/webhook-endpoints/%s", `{"enabled":false}`, ge.ID},
+		{"GET", "/v1/webhook-endpoints/%s/deliveries", "", ge.ID},
+		{"GET", "/v1/events/%s", "", ev.ID},
+		{"PATCH", "/v1/members/%s", `{"role":"viewer"}`, e.Globex.Owner.ID},
+		{"DELETE", "/v1/members/%s", "", e.Globex.Owner.ID},
+		{"DELETE", "/v1/invites/%s", "", inv.ID},
+		{"DELETE", "/v1/api-keys/%s", "", gk.ID},
+	}
+	for _, p := range probes {
+		var body any
+		if p.body != "" {
+			body = json.RawMessage(p.body)
+		}
+		r := e.Do(p.method, fmt.Sprintf(p.path, p.id), e.Acme.Key, body)
+		if r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+			t.Errorf("%s %s by Acme: %s", p.method, p.path, r)
+		}
+	}
+
+	if c, ok := e.Store.Customer(e.Globex.ID, gc.ID); !ok || c.Name != "Gina" {
+		t.Errorf("customer changed or deleted: %+v %v", c, ok)
+	}
+	if p, ok := e.Store.Plan(e.Globex.ID, gp.ID); !ok || p.Name != "Business" {
+		t.Errorf("plan changed: %+v %v", p, ok)
+	}
+	if s, ok := e.Store.Subscription(e.Globex.ID, gs.ID); !ok || s.Quantity != 1 || s.Status == store.Canceled {
+		t.Errorf("subscription changed: %+v %v", s, ok)
+	}
+	if i, ok := e.Store.Invoice(e.Globex.ID, gi.ID); !ok || i.Status != store.InvoiceOpen {
+		t.Errorf("invoice changed: %+v %v", i, ok)
+	}
+	if ep, ok := e.Store.WebhookEndpoint(e.Globex.ID, ge.ID); !ok || !ep.Enabled {
+		t.Errorf("endpoint changed: %+v %v", ep, ok)
+	}
+	if m, ok := e.Store.Member(e.Globex.ID, e.Globex.Owner.ID); !ok || m.Role != store.RoleOwner {
+		t.Errorf("member changed: %+v %v", m, ok)
+	}
+	if i, ok := e.Store.Invite(e.Globex.ID, inv.ID); !ok || i.RevokedAt != nil {
+		t.Errorf("invite revoked: %+v %v", i, ok)
+	}
+	if k, ok := e.Store.APIKey(e.Globex.ID, gk.ID); !ok || k.RevokedAt != nil {
+		t.Errorf("API key revoked: %+v %v", k, ok)
+	}
+}
