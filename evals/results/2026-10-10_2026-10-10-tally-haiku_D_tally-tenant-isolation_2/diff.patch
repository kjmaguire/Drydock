+package api_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// assertLikeUnknown asserts that a request naming another organization's object is answered exactly as one naming an object
+// that does not exist: 404 not_found with the same body. do sends the request with the given ID.
+func assertLikeUnknown(t *testing.T, do func(id string) *apitest.Response, foreignID string) {
+	t.Helper()
+	foreign, unknown := do(foreignID), do("missing_999999")
+	if foreign.Code != http.StatusNotFound || foreign.Map(t)["error"] != "not_found" {
+		t.Fatalf("another organization's object: %s", foreign)
+	}
+	if string(foreign.Body) != string(unknown.Body) {
+		t.Fatalf("another organization's object answers %s, an unknown one %s", foreign, unknown)
+	}
+}
+
+// invoiceBody is a one-line EUR invoice for customerID.
+func invoiceBody(customerID string) map[string]any {
+	return map[string]any{"customer_id": customerID, "currency": "EUR", "lines": []map[string]any{{"description": "Consulting", "quantity": 2, "unit_amount": 1000}}}
+}
+
+func TestInvoiceLinesOfAnotherOrganization(t *testing.T) {
+	e := apitest.New(t)
+	var gi struct{ ID string }
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Globex.Key, invoiceBody(e.CreateCustomer(e.Globex, "Gina", "gina@globex.example").ID), &gi)
+	var ai struct{ ID string }
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, invoiceBody(e.CreateCustomer(e.Acme, "Ann", "ann@acme.example").ID), &ai)
+
+	var own struct{ Items []map[string]any }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+ai.ID+"/lines", e.Acme.Key, nil, &own)
+	if len(own.Items) != 1 {
+		t.Fatalf("own lines = %+v", own.Items)
+	}
+	assertLikeUnknown(t, func(id string) *apitest.Response {
+		return e.Do("GET", "/v1/invoices/"+id+"/lines", e.Acme.Key, nil)
+	}, gi.ID)
+}
+
+func TestInvoiceForAnotherOrganizationsCustomer(t *testing.T) {
+	e := apitest.New(t)
+	gc := e.CreateCustomer(e.Globex, "Gina", "gina@globex.example")
+	assertLikeUnknown(t, func(id string) *apitest.Response {
+		return e.Do("POST", "/v1/invoices", e.Acme.Key, invoiceBody(id))
+	}, gc.ID)
+	if n := len(e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{})); n != 0 {
+		t.Fatalf("Acme has %d invoices, want none", n)
+	}
+}
+
+func TestSubscriptionForAnotherOrganization(t *testing.T) {
+	e := apitest.New(t)
+	gc := e.CreateCustomer(e.Globex, "Gina", "gina@globex.example")
+	gp := e.CreatePlan(e.Globex, "Business", "USD", "20.00")
+	ac := e.CreateCustomer(e.Acme, "Ann", "ann@acme.example")
+	ap := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	assertLikeUnknown(t, func(id string) *apitest.Response {
+		return e.Do("POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": id, "plan_id": ap.ID})
+	}, gc.ID)
+	assertLikeUnknown(t, func(id string) *apitest.Response {
+		return e.Do("POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": ac.ID, "plan_id": id})
+	}, gp.ID)
+	if n := len(e.Store.Subscriptions(e.Acme.ID, store.SubscriptionFilter{})); n != 0 {
+		t.Fatalf("Acme has %d subscriptions, want none", n)
+	}
+}
+
+func TestWebhookEndpointOfAnotherOrganization(t *testing.T) {
+	e := apitest.New(t)
+	now := e.Clock.Now()
+	ge, err := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Globex.ID, URL: "https://hooks.globex.example/in", Events: []string{"*"}, Enabled: true}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertLikeUnknown(t, func(id string) *apitest.Response {
+		return e.Do("DELETE", "/v1/webhook-endpoints/"+id, e.Acme.Key, nil)
+	}, ge.ID)
+	if _, ok := e.Store.WebhookEndpoint(e.Globex.ID, ge.ID); !ok {
+		t.Fatal("another organization's endpoint was deleted")
+	}
+	ae, err := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/in", Events: []string{"*"}, Enabled: true}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+ae.ID, e.Acme.Key, nil, nil)
+}
+
+// TestCustomersByEmailAreWithinOrganization: each organization finds only its own customer by email, and two organizations can
+// each have a customer with the same address without affecting each other.
+func TestCustomersByEmailAreWithinOrganization(t *testing.T) {
+	e := apitest.New(t)
+	a := e.CreateCustomer(e.Acme, "Acme Shared", "shared@example.com")
+	g := e.CreateCustomer(e.Globex, "Globex Shared", "SHARED@example.com")
+	find := func(key, email string) []store.Customer {
+		var out struct{ Items []store.Customer }
+		e.MustDo(http.StatusOK, "GET", "/v1/customers?email="+email, key, nil, &out)
+		return out.Items
+	}
+	if got := find(e.Acme.Key, "shared@example.com"); len(got) != 1 || got[0].ID != a.ID {
+		t.Fatalf("Acme finds %+v, want its own customer", got)
+	}
+	if got := find(e.Globex.Key, "shared@example.com"); len(got) != 1 || got[0].ID != g.ID {
+		t.Fatalf("Globex finds %+v, want its own customer", got)
+	}
+	only := e.CreateCustomer(e.Acme, "Only Acme", "only@acme.example")
+	if got := find(e.Globex.Key, "only@acme.example"); len(got) != 0 {
+		t.Fatalf("Globex finds %+v, want nothing", got)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+a.ID, e.Acme.Key, nil, nil)
+	if got := find(e.Globex.Key, "shared@example.com"); len(got) != 1 || got[0].ID != g.ID {
+		t.Fatalf("after Acme deleted its customer, Globex finds %+v", got)
+	}
+	if got := find(e.Acme.Key, "only@acme.example"); len(got) != 1 || got[0].ID != only.ID {
+		t.Fatalf("Acme finds %+v, want %s", got, only.ID)
+	}
+}
