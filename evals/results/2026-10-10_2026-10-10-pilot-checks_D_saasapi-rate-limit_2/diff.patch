+package api_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"example.com/saasapi/internal/api"
+	"example.com/saasapi/internal/store"
+)
+
+// newLimitedServer is like newServer, but its clock is moved by setting *now.
+// It also gives acc_acme a second key, so two keys of one account can be told apart.
+func newLimitedServer(t *testing.T, now *time.Time) *api.Server {
+	t.Helper()
+	st := store.New()
+	st.AddAccount(store.Account{ID: "acc_acme", Name: "Acme", Plan: store.PlanFree})
+	st.AddAccount(store.Account{ID: "acc_globex", Name: "Globex", Plan: store.PlanPro})
+	st.AddKey("key-acme", "acc_acme")
+	st.AddKey("key-acme-2", "acc_acme")
+	st.AddKey("key-globex", "acc_globex")
+	return api.New(st, api.Options{Now: func() time.Time { return *now }})
+}
+
+var t0 = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+// spend makes n requests with key at the current clock and wants each to be allowed.
+func spend(t *testing.T, srv http.Handler, key string, n int) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		if r := do(t, srv, "GET", "/api/customers", key, ""); r.Code != http.StatusOK {
+			t.Fatalf("request %d with %s: status %d, want 200", i+1, key, r.Code)
+		}
+	}
+}
+
+func TestFreeKeyIsLimitedTo60RequestsAMinute(t *testing.T) {
+	now := t0
+	srv := newLimitedServer(t, &now)
+	spend(t, srv, "key-acme", 60)
+
+	r := do(t, srv, "GET", "/api/customers", "key-acme", "")
+	if r.Code != http.StatusTooManyRequests {
+		t.Fatalf("61st request: status %d, want 429", r.Code)
+	}
+	var body map[string]string
+	if err := json.Unmarshal(r.Body.Bytes(), &body); err != nil || body["error"] != "rate_limited" || len(body) != 1 {
+		t.Fatalf("body %s %v, want {\"error\":\"rate_limited\"}", r.Body, err)
+	}
+	if got := r.Header().Get("Retry-After"); got != "60" {
+		t.Fatalf("Retry-After %q, want 60", got)
+	}
+}
+
+func TestProKeyIsLimitedTo600RequestsAMinute(t *testing.T) {
+	now := t0
+	srv := newLimitedServer(t, &now)
+	spend(t, srv, "key-globex", 600)
+
+	if r := do(t, srv, "GET", "/api/customers", "key-globex", ""); r.Code != http.StatusTooManyRequests {
+		t.Fatalf("601st request: status %d, want 429", r.Code)
+	}
+}
+
+func TestWindowSlidesAndRetryAfterRoundsUp(t *testing.T) {
+	now := t0
+	srv := newLimitedServer(t, &now)
+
+	spend(t, srv, "key-acme", 1) // at t0
+	now = t0.Add(10 * time.Second)
+	spend(t, srv, "key-acme", 59) // 60 counted in (t0-50s, t0+10s]
+
+	// The oldest counted request (t0) leaves the window at t0+60s: 49.5s away, rounded up to 50.
+	now = t0.Add(10*time.Second + 500*time.Millisecond)
+	if r := do(t, srv, "GET", "/api/customers", "key-acme", ""); r.Code != http.StatusTooManyRequests || r.Header().Get("Retry-After") != "50" {
+		t.Fatalf("at t0+10.5s: status %d Retry-After %q, want 429 and 50", r.Code, r.Header().Get("Retry-After"))
+	}
+
+	// 0.5s from the window freeing a slot: rounds up to 1, never 0.
+	now = t0.Add(59*time.Second + 500*time.Millisecond)
+	if r := do(t, srv, "GET", "/api/customers", "key-acme", ""); r.Code != http.StatusTooManyRequests || r.Header().Get("Retry-After") != "1" {
+		t.Fatalf("at t0+59.5s: status %d Retry-After %q, want 429 and 1", r.Code, r.Header().Get("Retry-After"))
+	}
+
+	// At exactly t0+60s the window is (t0, t0+60s], so the t0 request no longer counts.
+	now = t0.Add(60 * time.Second)
+	spend(t, srv, "key-acme", 1)
+	if r := do(t, srv, "GET", "/api/customers", "key-acme", ""); r.Code != http.StatusTooManyRequests || r.Header().Get("Retry-After") != "10" {
+		t.Fatalf("at t0+60s after refill: status %d Retry-After %q, want 429 and 10", r.Code, r.Header().Get("Retry-After"))
+	}
+
+	now = t0.Add(70 * time.Second)
+	spend(t, srv, "key-acme", 1)
+}
+
+func TestRejectedRequestsDoNotCount(t *testing.T) {
+	now := t0
+	srv := newLimitedServer(t, &now)
+	spend(t, srv, "key-acme", 59)
+	now = t0.Add(30 * time.Second)
+	spend(t, srv, "key-acme", 1)
+
+	now = t0.Add(31 * time.Second)
+	for i := 0; i < 5; i++ {
+		if r := do(t, srv, "GET", "/api/customers", "key-acme", ""); r.Code != http.StatusTooManyRequests {
+			t.Fatalf("rejected request %d: status %d, want 429", i+1, r.Code)
+		}
+	}
+
+	// At t0+60s only the t0+30s request is still counted, so 59 more are allowed and no more.
+	now = t0.Add(60 * time.Second)
+	spend(t, srv, "key-acme", 59)
+	if r := do(t, srv, "GET", "/api/customers", "key-acme", ""); r.Code != http.StatusTooManyRequests {
+		t.Fatalf("request after 60 counted: status %d, want 429", r.Code)
+	}
+}
+
+func TestEachKeyHasItsOwnLimit(t *testing.T) {
+	now := t0
+	srv := newLimitedServer(t, &now)
+	spend(t, srv, "key-acme", 60)
+
+	if r := do(t, srv, "GET", "/api/customers", "key-acme", ""); r.Code != http.StatusTooManyRequests {
+		t.Fatalf("exhausted key: status %d, want 429", r.Code)
+	}
+	spend(t, srv, "key-acme-2", 60)
+}
+
+func TestUnauthorizedRequestsAreNotCounted(t *testing.T) {
+	now := t0
+	srv := newLimitedServer(t, &now)
+	for i := 0; i < 100; i++ {
+		for _, key := range []string{"", "nope"} {
+			if r := do(t, srv, "GET", "/api/customers", key, ""); r.Code != http.StatusUnauthorized {
+				t.Fatalf("key %q: status %d, want 401", key, r.Code)
+			}
+		}
+	}
+	spend(t, srv, "key-acme", 60)
+}
+
+func TestHealthzIsNotLimited(t *testing.T) {
+	now := t0
+	srv := newLimitedServer(t, &now)
+	spend(t, srv, "key-acme", 60)
+	if r := do(t, srv, "GET", "/api/customers", "key-acme", ""); r.Code != http.StatusTooManyRequests {
+		t.Fatalf("exhausted key: status %d, want 429", r.Code)
+	}
+	for i := 0; i < 100; i++ {
+		if r := do(t, srv, "GET", "/healthz", "", ""); r.Code != http.StatusOK {
+			t.Fatalf("healthz %d: status %d", i+1, r.Code)
+		}
+	}
+}
+
+func TestConcurrentRequestsShareOneCount(t *testing.T) {
+	now := t0
+	srv := newLimitedServer(t, &now)
+
+	var allowed, limited atomic.Int64
+	var wg sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			switch do(t, srv, "GET", "/api/customers", "key-acme", "").Code {
+			case http.StatusOK:
+				allowed.Add(1)
+			case http.StatusTooManyRequests:
+				limited.Add(1)
+			}
+		}()
+	}
+	wg.Wait()
+
+	if allowed.Load() != 60 || limited.Load() != 40 {
+		t.Fatalf("allowed %d, limited %d; want 60 and 40", allowed.Load(), limited.Load())
+	}
+}
