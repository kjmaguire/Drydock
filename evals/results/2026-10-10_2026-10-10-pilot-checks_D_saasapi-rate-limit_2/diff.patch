+package api
+
+import (
+	"sync"
+	"time"
+
+	"example.com/saasapi/internal/store"
+)
+
+// rateWindow is the rolling window that requests are counted over.
+const rateWindow = 60 * time.Second
+
+// limitFor is how many requests a key may make per rateWindow, given its account's plan.
+func limitFor(p store.Plan) int {
+	if p == store.PlanPro {
+		return 600
+	}
+	return 60
+}
+
+// limiter counts each API key's allowed requests over a rolling window.
+type limiter struct {
+	now func() time.Time
+
+	mu      sync.Mutex
+	allowed map[string][]time.Time // per key: times of allowed requests, ascending
+}
+
+func newLimiter(now func() time.Time) *limiter {
+	return &limiter{now: now, allowed: map[string][]time.Time{}}
+}
+
+// allow records a request by key when fewer than limit requests were allowed in (t-rateWindow, t].
+// Otherwise it reports the whole seconds, at least 1, until the oldest counted request leaves the window.
+func (l *limiter) allow(key string, limit int) (ok bool, retryAfter int) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	t := l.now()
+	times := l.allowed[key]
+	n := 0
+	for n < len(times) && !times[n].After(t.Add(-rateWindow)) {
+		n++
+	}
+	times = times[n:]
+
+	if len(times) >= limit {
+		l.allowed[key] = times
+		wait := times[0].Add(rateWindow).Sub(t)
+		secs := int((wait + time.Second - 1) / time.Second)
+		if secs < 1 {
+			secs = 1
+		}
+		return false, secs
+	}
+	l.allowed[key] = append(times, t)
+	return true, 0
+}
