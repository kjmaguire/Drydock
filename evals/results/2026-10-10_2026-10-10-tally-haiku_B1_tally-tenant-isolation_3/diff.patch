index 0000000..9444d21
--- /dev/null
+++ b/result/internal/api/isolation_test.go
@@ -0,0 +1,261 @@
+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"net/url"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// unknownID is an ID that no object has.
+const unknownID = "no_such_object"
+
+// idList is the shape of a list response, read for the IDs of its items.
+type idList struct {
+	Items []struct {
+		ID string `json:"id"`
+	} `json:"items"`
+}
+
+// TestAnotherOrgsObjectsAnswerLikeMissingOnes makes Acme send each request that names an ID, first with an ID of a Globex
+// object and then with an ID that does not exist. Each must answer the same way, 404 not_found, and Globex's data must not
+// change.
+func TestAnotherOrgsObjectsAnswerLikeMissingOnes(t *testing.T) {
+	e := apitest.New(t)
+
+	// Acme's own objects, used by the requests that name a Globex object in their body.
+	acmeCustomer := e.CreateCustomer(e.Acme, "Ann Lee", "ann@acme.example")
+	acmePlan := e.CreatePlan(e.Acme, "Pro", "USD", "10.00")
+	var acmeSub struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": acmeCustomer.ID, "plan_id": acmePlan.ID}, &acmeSub)
+
+	// Globex's objects, which Acme must never see or change.
+	gCustomer := e.CreateCustomer(e.Globex, "Jane Doe", "jane@globex.example")
+	gPlan := e.CreatePlan(e.Globex, "Pro", "USD", "10.00")
+	var gSub, gInvoice, gEndpoint, gKey, gInvite struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Globex.Key, map[string]any{"customer_id": gCustomer.ID, "plan_id": gPlan.ID}, &gSub)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Globex.Key, map[string]any{"customer_id": gCustomer.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 500}}}, &gInvoice)
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Globex.Key, map[string]any{"url": "https://hooks.globex.example/tally", "events": []string{"*"}}, &gEndpoint)
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Globex.Key, map[string]any{"name": "CI"}, &gKey)
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Globex.Key, map[string]any{"email": "new@globex.example", "role": "member"}, &gInvite)
+	var gEvents idList
+	e.MustDo(http.StatusOK, "GET", "/v1/events", e.Globex.Key, nil, &gEvents)
+	if len(gEvents.Items) == 0 {
+		t.Fatal("Globex has no events")
+	}
+	gEvent, gOwner := gEvents.Items[0].ID, e.Globex.Owner.ID
+
+	type request struct {
+		method, path string
+		body         any
+	}
+	// Each case builds the request that names id, the ID under test.
+	cases := []struct {
+		name  string
+		id    string // a Globex object's ID, which Acme must not reach
+		build func(id string) request
+	}{
+		{"customers: get", gCustomer.ID, func(id string) request { return request{"GET", "/v1/customers/" + id, nil} }},
+		{"customers: update", gCustomer.ID, func(id string) request {
+			return request{"PATCH", "/v1/customers/" + id, map[string]any{"name": "Changed"}}
+		}},
+		{"customers: delete", gCustomer.ID, func(id string) request { return request{"DELETE", "/v1/customers/" + id, nil} }},
+		{"plans: get", gPlan.ID, func(id string) request { return request{"GET", "/v1/plans/" + id, nil} }},
+		{"plans: update", gPlan.ID, func(id string) request {
+			return request{"PATCH", "/v1/plans/" + id, map[string]any{"name": "Changed"}}
+		}},
+		{"subscriptions: get", gSub.ID, func(id string) request { return request{"GET", "/v1/subscriptions/" + id, nil} }},
+		{"subscriptions: update", gSub.ID, func(id string) request {
+			return request{"PATCH", "/v1/subscriptions/" + id, map[string]any{"quantity": 5}}
+		}},
+		{"subscriptions: update to another org's plan", gPlan.ID, func(id string) request {
+			return request{"PATCH", "/v1/subscriptions/" + acmeSub.ID, map[string]any{"plan_id": id}}
+		}},
+		{"subscriptions: cancel", gSub.ID, func(id string) request { return request{"POST", "/v1/subscriptions/" + id + "/cancel", nil} }},
+		{"subscriptions: report usage", gSub.ID, func(id string) request {
+			return request{"POST", "/v1/subscriptions/" + id + "/usage", map[string]any{"quantity": 1}}
+		}},
+		{"subscriptions: create for another org's customer", gCustomer.ID, func(id string) request {
+			return request{"POST", "/v1/subscriptions", map[string]any{"customer_id": id, "plan_id": acmePlan.ID}}
+		}},
+		{"subscriptions: create with another org's plan", gPlan.ID, func(id string) request {
+			return request{"POST", "/v1/subscriptions", map[string]any{"customer_id": acmeCustomer.ID, "plan_id": id}}
+		}},
+		{"invoices: get", gInvoice.ID, func(id string) request { return request{"GET", "/v1/invoices/" + id, nil} }},
+		{"invoices: lines", gInvoice.ID, func(id string) request { return request{"GET", "/v1/invoices/" + id + "/lines", nil} }},
+		{"invoices: pay", gInvoice.ID, func(id string) request { return request{"POST", "/v1/invoices/" + id + "/pay", nil} }},
+		{"invoices: void", gInvoice.ID, func(id string) request { return request{"POST", "/v1/invoices/" + id + "/void", nil} }},
+		{"invoices: create for another org's customer", gCustomer.ID, func(id string) request {
+			return request{"POST", "/v1/invoices", map[string]any{"customer_id": id, "currency": "USD",
+				"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 500}}}}
+		}},
+		{"webhook endpoints: get", gEndpoint.ID, func(id string) request { return request{"GET", "/v1/webhook-endpoints/" + id, nil} }},
+		{"webhook endpoints: update", gEndpoint.ID, func(id string) request {
+			return request{"PATCH", "/v1/webhook-endpoints/" + id, map[string]any{"enabled": false}}
+		}},
+		{"webhook endpoints: delete", gEndpoint.ID, func(id string) request { return request{"DELETE", "/v1/webhook-endpoints/" + id, nil} }},
+		{"webhook endpoints: deliveries", gEndpoint.ID, func(id string) request {
+			return request{"GET", "/v1/webhook-endpoints/" + id + "/deliveries", nil}
+		}},
+		{"events: get", gEvent, func(id string) request { return request{"GET", "/v1/events/" + id, nil} }},
+		{"members: update", gOwner, func(id string) request {
+			return request{"PATCH", "/v1/members/" + id, map[string]any{"role": "viewer"}}
+		}},
+		{"members: remove", gOwner, func(id string) request { return request{"DELETE", "/v1/members/" + id, nil} }},
+		{"invites: revoke", gInvite.ID, func(id string) request { return request{"DELETE", "/v1/invites/" + id, nil} }},
+		{"api keys: revoke", gKey.ID, func(id string) request { return request{"DELETE", "/v1/api-keys/" + id, nil} }},
+	}
+
+	// What Globex sees before and after: none of it may change.
+	globexPaths := []string{
+		"/v1/customers", "/v1/customers/" + gCustomer.ID, "/v1/plans", "/v1/plans/" + gPlan.ID,
+		"/v1/subscriptions", "/v1/subscriptions/" + gSub.ID, "/v1/invoices", "/v1/invoices/" + gInvoice.ID,
+		"/v1/invoices/" + gInvoice.ID + "/lines", "/v1/webhook-endpoints", "/v1/webhook-endpoints/" + gEndpoint.ID,
+		"/v1/webhook-endpoints/" + gEndpoint.ID + "/deliveries", "/v1/events", "/v1/events/" + gEvent,
+		"/v1/members", "/v1/invites", "/v1/payments",
+	}
+	type view struct {
+		code int
+		body string
+	}
+	globexView := func() map[string]view {
+		out := map[string]view{}
+		for _, p := range globexPaths {
+			r := e.Do("GET", p, e.Globex.Key, nil)
+			out[p] = view{r.Code, string(r.Body)}
+		}
+		return out
+	}
+	before := globexView()
+	for p, v := range before {
+		if v.code != http.StatusOK {
+			t.Fatalf("GET %s as Globex before the requests: %d %s", p, v.code, v.body)
+		}
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			cross := c.build(c.id)
+			missing := c.build(unknownID)
+			got := e.Do(cross.method, cross.path, e.Acme.Key, cross.body)
+			want := e.Do(missing.method, missing.path, e.Acme.Key, missing.body)
+			if got.Code != http.StatusNotFound || got.Map(t)["error"] != "not_found" {
+				t.Errorf("another org's ID: %s %s = %s; want 404 not_found", cross.method, cross.path, got)
+			}
+			if got.Code != want.Code || string(got.Body) != string(want.Body) {
+				t.Errorf("another org's ID answers %s, an unknown ID answers %s", got, want)
+			}
+		})
+	}
+
+	after := globexView()
+	for _, p := range globexPaths {
+		if before[p] != after[p] {
+			t.Errorf("GET %s as Globex changed after Acme's requests:\nbefore %d %s\nafter  %d %s", p, before[p].code, before[p].body, after[p].code, after[p].body)
+		}
+	}
+}
+
+// TestListsIgnoreAnotherOrgsIDs checks that a list filtered by another organization's ID is empty, the same as one filtered
+// by an ID that does not exist.
+func TestListsIgnoreAnotherOrgsIDs(t *testing.T) {
+	e := apitest.New(t)
+	gCustomer := e.CreateCustomer(e.Globex, "Jane Doe", "jane@globex.example")
+	gPlan := e.CreatePlan(e.Globex, "Pro", "USD", "10.00")
+	var gSub struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Globex.Key, map[string]any{"customer_id": gCustomer.ID, "plan_id": gPlan.ID}, &gSub)
+	var gInvoice struct {
+		ID string `json:"id"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Globex.Key, map[string]any{"customer_id": gCustomer.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Setup", "quantity": 1, "unit_amount": 500}}}, &gInvoice)
+
+	for _, path := range []string{
+		"/v1/invoices?customer_id=%s", "/v1/invoices?subscription_id=%s", "/v1/subscriptions?customer_id=%s",
+		"/v1/payments?invoice_id=%s",
+	} {
+		for _, id := range []string{gCustomer.ID, gSub.ID, gInvoice.ID} {
+			var list idList
+			e.MustDo(http.StatusOK, "GET", fmt.Sprintf(path, id), e.Acme.Key, nil, &list)
+			if len(list.Items) != 0 {
+				t.Errorf("GET %s found %d items of another organization", fmt.Sprintf(path, id), len(list.Items))
+			}
+		}
+	}
+}
+
+// TestCustomerEmailLookupIsPerOrganization checks that ?email= finds only the caller's organization's customers, and that
+// two organizations can each have a customer with the same address without affecting each other.
+func TestCustomerEmailLookupIsPerOrganization(t *testing.T) {
+	e := apitest.New(t)
+	find := func(org apitest.Org, email string) []string {
+		t.Helper()
+		var list struct {
+			Items []store.Customer `json:"items"`
+		}
+		e.MustDo(http.StatusOK, "GET", "/v1/customers?email="+url.QueryEscape(email), org.Key, nil, &list)
+		ids := []string{}
+		for _, c := range list.Items {
+			ids = append(ids, c.ID)
+		}
+		return ids
+	}
+	same := func(got []string, want ...string) bool {
+		if len(got) != len(want) {
+			return false
+		}
+		for i := range got {
+			if got[i] != want[i] {
+				return false
+			}
+		}
+		return true
+	}
+
+	acme := e.CreateCustomer(e.Acme, "Jane Acme", "jane@example.com")
+	globex := e.CreateCustomer(e.Globex, "Jane Globex", "Jane@Example.com")
+	if got := find(e.Acme, "jane@example.com"); !same(got, acme.ID) {
+		t.Fatalf("Acme finds %v; want only its own %s", got, acme.ID)
+	}
+	if got := find(e.Globex, "JANE@example.com"); !same(got, globex.ID) {
+		t.Fatalf("Globex finds %v; want only its own %s", got, globex.ID)
+	}
+
+	// An address that only Globex has is not found by Acme.
+	ann := e.CreateCustomer(e.Globex, "Ann", "ann@example.com")
+	if got := find(e.Acme, "ann@example.com"); !same(got) {
+		t.Fatalf("Acme finds Globex's customer %v", got)
+	}
+	if got := find(e.Globex, "ann@example.com"); !same(got, ann.ID) {
+		t.Fatalf("Globex finds %v; want %s", got, ann.ID)
+	}
+
+	// Acme's changes to its own customer leave Globex's alone, and Acme may then use the address again.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+acme.ID, e.Acme.Key, map[string]any{"email": "jane.acme@example.com"}, nil)
+	if got := find(e.Globex, "jane@example.com"); !same(got, globex.ID) {
+		t.Fatalf("after Acme changed its address, Globex finds %v; want %s", got, globex.ID)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+acme.ID, e.Acme.Key, nil, nil)
+	if got := find(e.Globex, "jane@example.com"); !same(got, globex.ID) {
+		t.Fatalf("after Acme deleted its customer, Globex finds %v; want %s", got, globex.ID)
+	}
+	e.CreateCustomer(e.Acme, "Jane Again", "jane@example.com")
+	if got := find(e.Acme, "jane@example.com"); len(got) != 1 {
+		t.Fatalf("Acme finds %v after it re-created the address", got)
+	}
+
+	// Within one organization the address is still unique, ignoring case.
+	if r := e.Do("POST", "/v1/customers", e.Globex.Key, map[string]string{"name": "Dup", "email": "JANE@example.com"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "email_taken" {
+		t.Fatalf("duplicate address within Globex: %s", r)
+	}
+}
