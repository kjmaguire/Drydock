+// TestDeleteOrgWebhookEndpoint checks that an endpoint is deleted only by its own organization.
+func TestDeleteOrgWebhookEndpoint(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "Acme"), newOrg(t, s, "Globex")
+	ep, err := s.CreateWebhookEndpoint(WebhookEndpoint{OrgID: a.ID, URL: "https://hooks.acme.example/", Events: []string{"*"}, Enabled: true}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.DeleteOrgWebhookEndpoint(b.ID, ep.ID); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("another org deleted the endpoint: %v", err)
+	}
+	if _, ok := s.WebhookEndpoint(a.ID, ep.ID); !ok {
+		t.Fatal("the endpoint is gone after another org's delete")
+	}
+	if err := s.DeleteOrgWebhookEndpoint(a.ID, ep.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.WebhookEndpoint(a.ID, ep.ID); ok {
+		t.Fatal("the endpoint is still there after its own organization deleted it")
+	}
+}
