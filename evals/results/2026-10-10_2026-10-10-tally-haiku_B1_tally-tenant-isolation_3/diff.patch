+// TestAnotherOrgsCustomerIsNotFound checks that an invoice or subscription that names another organization's customer
+// fails as if the customer did not exist: ErrNotFound, and nothing is stored.
+func TestAnotherOrgsCustomerIsNotFound(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "Acme"), newOrg(t, s, "Globex")
+	cb, err := s.CreateCustomer(b.ID, "Jane", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	plan, err := s.CreatePlan(Plan{OrgID: a.ID, Name: "Pro", Currency: money.USD, UnitAmount: 1000, Interval: Monthly}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	line := []Line{{Description: "Setup", Quantity: 1, UnitAmount: 500}}
+
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: cb.ID, Currency: money.USD, Lines: line}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for another org's customer = %v; want ErrNotFound", err)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: "cus_unknown", Currency: money.USD, Lines: line}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for an unknown customer = %v; want ErrNotFound", err)
+	}
+	if _, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: cb.ID, PlanID: plan.ID, Quantity: 1, Status: Active}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for another org's customer = %v; want ErrNotFound", err)
+	}
+	if got := s.ListInvoices(a.ID, InvoiceFilter{}); len(got) != 0 {
+		t.Fatalf("an invoice was stored: %+v", got)
+	}
+	if got := s.Subscriptions(a.ID, SubscriptionFilter{}); len(got) != 0 {
+		t.Fatalf("a subscription was stored: %+v", got)
+	}
+}
