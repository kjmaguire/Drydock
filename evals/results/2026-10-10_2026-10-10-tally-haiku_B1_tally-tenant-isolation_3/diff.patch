+package store
+
+import (
+	"errors"
+	"testing"
+
+	"example.com/tally/internal/money"
+)
+
+// TestCustomerEmailIndexIsPerOrganization checks that two organizations can each have a customer with the same address,
+// that each finds only its own, that changes in one leave the other alone, and that the index survives a save and load.
+func TestCustomerEmailIndexIsPerOrganization(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "Acme"), newOrg(t, s, "Globex")
+	ca, err := s.CreateCustomer(a.ID, "Jane Acme", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cb, err := s.CreateCustomer(b.ID, "Jane Globex", "Jane@Example.com", t0)
+	if err != nil {
+		t.Fatalf("the same address in another organization: %v", err)
+	}
+	check := func(s *Store, when string) {
+		t.Helper()
+		if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+			t.Fatalf("%s: Acme finds %+v %v; want %s", when, got, ok, ca.ID)
+		}
+		if got, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); !ok || got.ID != cb.ID {
+			t.Fatalf("%s: Globex finds %+v %v; want %s", when, got, ok, cb.ID)
+		}
+	}
+	check(s, "after both were created")
+
+	if _, err := s.CreateCustomer(a.ID, "Jane Again", "JANE@example.com", t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("duplicate address within Acme = %v; want ErrEmailTaken", err)
+	}
+
+	// Acme moves its customer to another address: Globex's index entry must stay.
+	if _, err := s.UpdateCustomer(a.ID, ca.ID, func(c *Customer) error { c.Email = "jane.acme@example.com"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); !ok || got.ID != cb.ID {
+		t.Fatalf("after Acme changed its address, Globex finds %+v %v", got, ok)
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); ok {
+		t.Fatal("Acme still finds the address it gave up")
+	}
+	if _, err := s.UpdateCustomer(a.ID, ca.ID, func(c *Customer) error { c.Email = "jane@example.com"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	check(s, "after Acme changed its address back")
+
+	// Deleting Acme's customer leaves Globex's entry.
+	if err := s.DeleteCustomer(a.ID, ca.ID); err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); !ok || got.ID != cb.ID {
+		t.Fatalf("after Acme deleted its customer, Globex finds %+v %v", got, ok)
+	}
+
+	// A save and load rebuilds the index per organization.
+	ca2, err := s.CreateCustomer(a.ID, "Jane Acme", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := loaded.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca2.ID {
+		t.Fatalf("after load, Acme finds %+v %v; want %s", got, ok, ca2.ID)
+	}
+	if got, ok := loaded.FindCustomerByEmail(b.ID, "jane@example.com"); !ok || got.ID != cb.ID {
+		t.Fatalf("after load, Globex finds %+v %v; want %s", got, ok, cb.ID)
+	}
+}
