+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Errors for applying a coupon to a subscription. Callers check them with errors.Is.
+var (
+	// ErrCodeTaken is returned when the organization already has a coupon with the code, ignoring case.
+	ErrCodeTaken            = fmt.Errorf("%w: coupon code already in use", ErrConflict)
+	ErrCouponExpired        = errors.New("the coupon's redeem-by date has passed")
+	ErrCouponExhausted      = errors.New("the coupon has no redemptions left")
+	ErrCurrencyMismatch     = errors.New("the coupon's currency is not the plan's")
+	ErrCouponApplied        = fmt.Errorf("%w: the subscription already has a coupon", ErrConflict)
+	ErrSubscriptionCanceled = errors.New("the subscription is canceled")
+)
+
+var couponCodeRe = regexp.MustCompile(`^[A-Za-z0-9_-]{3,32}$`)
+
+// couponKey finds a coupon by its organization and its code, ignoring case.
+type couponKey struct{ org, code string }
+
+func couponKeyOf(orgID, code string) couponKey {
+	return couponKey{orgID, strings.ToLower(code)}
+}
+
+// CreateCoupon adds a coupon to an organization. It takes exactly one of PercentOff and AmountOff. Codes are unique in the
+// organization, ignoring case.
+func (s *Store) CreateCoupon(c Coupon, now time.Time) (Coupon, error) {
+	if c.PercentOff != nil {
+		c.Currency = ""
+	}
+	if err := checkCoupon(c); err != nil {
+		return Coupon{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[c.OrgID]; !ok {
+		return Coupon{}, ErrNotFound
+	}
+	k := couponKeyOf(c.OrgID, c.Code)
+	if _, ok := s.couponsByCode[k]; ok {
+		return Coupon{}, ErrCodeTaken
+	}
+	c.ID = s.newID("cpn")
+	c.CreatedAt = now.UTC()
+	if c.RedeemBy != nil {
+		t := c.RedeemBy.UTC()
+		c.RedeemBy = &t
+	}
+	c.TimesRedeemed = 0
+	s.coupons[c.ID] = copyCoupon(c)
+	s.couponsByCode[k] = c.ID
+	return copyCoupon(c), nil
+}
+
+func checkCoupon(c Coupon) error {
+	if !couponCodeRe.MatchString(c.Code) {
+		return invalid("a coupon code is 3 to 32 letters, digits, dashes or underscores")
+	}
+	if (c.PercentOff == nil) == (c.AmountOff == nil) {
+		return invalid("a coupon takes a percent off or an amount off, not both or neither")
+	}
+	if c.PercentOff != nil && (*c.PercentOff < 1 || *c.PercentOff > 100) {
+		return invalid("a percent off is 1 to 100")
+	}
+	if c.AmountOff != nil {
+		if *c.AmountOff < 1 {
+			return invalid("an amount off is more than zero")
+		}
+		if !c.Currency.Valid() {
+			return invalid("unknown currency %q", c.Currency)
+		}
+	}
+	switch c.Duration {
+	case CouponOnce, CouponForever:
+		if c.DurationInMonths != nil {
+			return invalid("only a repeating coupon has a duration in months")
+		}
+	case CouponRepeating:
+		if c.DurationInMonths == nil || *c.DurationInMonths < 1 || *c.DurationInMonths > 36 {
+			return invalid("a repeating coupon lasts 1 to 36 months")
+		}
+	default:
+		return invalid("a coupon's duration is once, repeating or forever")
+	}
+	if c.MaxRedemptions != nil && *c.MaxRedemptions < 1 {
+		return invalid("a coupon's max redemptions is at least 1")
+	}
+	return nil
+}
+
+// Coupon returns one of an organization's coupons by its code, ignoring case.
+func (s *Store) Coupon(orgID, code string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	id, ok := s.couponsByCode[couponKeyOf(orgID, code)]
+	if !ok {
+		return Coupon{}, false
+	}
+	return s.couponView(s.coupons[id]), true
+}
+
+// Coupons returns an organization's coupons, oldest first.
+func (s *Store) Coupons(orgID string) []Coupon {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Coupon{}
+	for _, c := range s.coupons {
+		if c.OrgID == orgID {
+			out = append(out, s.couponView(c))
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// RedeemCoupon applies the coupon with this code to a subscription at now. It refuses when the coupon's redeem-by date has
+// passed, when max redemptions are used up, when an amount off is in another currency than the plan's, when the
+// subscription already has a coupon and when it is canceled. The checks and the change happen under one lock.
+func (s *Store) RedeemCoupon(orgID, subID, code string, now time.Time) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	id, ok := s.couponsByCode[couponKeyOf(orgID, code)]
+	if !ok {
+		return Subscription{}, ErrNotFound
+	}
+	c := s.coupons[id]
+	sub, ok := s.subs[subID]
+	if !ok || sub.OrgID != orgID {
+		return Subscription{}, ErrNotFound
+	}
+	switch {
+	case c.RedeemBy != nil && now.After(*c.RedeemBy):
+		return Subscription{}, ErrCouponExpired
+	case c.MaxRedemptions != nil && s.couponView(c).TimesRedeemed >= *c.MaxRedemptions:
+		return Subscription{}, ErrCouponExhausted
+	case c.AmountOff != nil && s.plans[sub.PlanID].Currency != c.Currency:
+		return Subscription{}, ErrCurrencyMismatch
+	case sub.Coupon != "":
+		return Subscription{}, ErrCouponApplied
+	case sub.Status == Canceled:
+		return Subscription{}, ErrSubscriptionCanceled
+	}
+	t := now.UTC()
+	sub.Coupon, sub.CouponRedeemedAt = c.Code, &t
+	s.subs[subID] = sub
+	return copySub(sub), nil
+}
+
+// couponView is a copy of c with how many subscriptions have it. The caller holds the lock.
+func (s *Store) couponView(c Coupon) Coupon {
+	c = copyCoupon(c)
+	c.TimesRedeemed = 0
+	for _, sub := range s.subs {
+		if sub.OrgID == c.OrgID && sub.Coupon == c.Code {
+			c.TimesRedeemed++
+		}
+	}
+	return c
+}
+
+func copyCoupon(c Coupon) Coupon {
+	if c.PercentOff != nil {
+		v := *c.PercentOff
+		c.PercentOff = &v
+	}
+	if c.AmountOff != nil {
+		v := *c.AmountOff
+		c.AmountOff = &v
+	}
+	if c.DurationInMonths != nil {
+		v := *c.DurationInMonths
+		c.DurationInMonths = &v
+	}
+	if c.MaxRedemptions != nil {
+		v := *c.MaxRedemptions
+		c.MaxRedemptions = &v
+	}
+	if c.RedeemBy != nil {
+		t := *c.RedeemBy
+		c.RedeemBy = &t
+	}
+	return c
+}
