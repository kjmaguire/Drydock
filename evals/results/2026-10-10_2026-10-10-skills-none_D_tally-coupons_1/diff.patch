+// ApplyCoupon applies the coupon with this code to a subscription now. The coupon discounts the subscription's invoices from
+// then on, as its duration says. store.RedeemCoupon says what refuses it.
+func (s *Service) ApplyCoupon(ctx context.Context, orgID, id, code string) (store.Subscription, error) {
+	sub, err := s.Store.RedeemCoupon(orgID, id, code, s.Clock.Now())
+	if err != nil {
+		return store.Subscription{}, err
+	}
+	s.publish(ctx, orgID, "subscription.updated", sub)
+	return sub, nil
+}
+
+// couponFor returns the coupon that discounts an invoice created now for a period starting at start, or nil when none does.
+// A coupon discounts the invoices created after it was applied: a once coupon only the first of them, a repeating coupon
+// those whose period starts less than its duration in months after it was applied, and a forever coupon all of them.
+func (s *Service) couponFor(sub store.Subscription, start, now time.Time) (*store.Coupon, error) {
+	if sub.Coupon == "" || sub.CouponRedeemedAt == nil || !now.After(*sub.CouponRedeemedAt) {
+		return nil, nil
+	}
+	c, ok := s.Store.Coupon(sub.OrgID, sub.Coupon)
+	if !ok {
+		return nil, store.ErrNotFound
+	}
+	switch c.Duration {
+	case store.CouponOnce:
+		for _, inv := range s.Store.ListInvoices(sub.OrgID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+			if inv.Coupon != "" {
+				return nil, nil
+			}
+		}
+	case store.CouponRepeating:
+		if !start.Before(sub.CouponRedeemedAt.AddDate(0, *c.DurationInMonths, 0)) {
+			return nil, nil
+		}
+	}
+	return &c, nil
+}
