+package api_test
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func TestCouponsCRUD(t *testing.T) {
+	e := apitest.New(t)
+	var pct store.Coupon
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "SPRING25", "percent_off": 25, "duration": "forever"}, &pct)
+	if pct.Code != "SPRING25" || pct.PercentOff == nil || *pct.PercentOff != 25 || pct.AmountOff != nil || pct.TimesRedeemed != 0 {
+		t.Fatalf("percent coupon = %+v", pct)
+	}
+
+	r := e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "take_20-off", "amount_off": "20.00", "currency": "USD", "duration": "repeating",
+		"duration_in_months": 3, "max_redemptions": 5, "redeem_by": "2027-01-01T00:00:00Z"})
+	m := r.Map(t)
+	if r.Code != http.StatusCreated || m["amount_off"] != float64(2000) || m["times_redeemed"] != float64(0) || m["currency"] != "USD" || m["duration_in_months"] != float64(3) {
+		t.Fatalf("amount coupon: %s", r)
+	}
+
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "spring25", "percent_off": 10, "duration": "once"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "code_taken" {
+		t.Fatalf("code taken, ignoring case: %s", r)
+	}
+	// Codes are unique per organization, so Globex may use the same one.
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Globex.Key, map[string]any{"code": "SPRING25", "percent_off": 10, "duration": "once"}, nil)
+
+	bad := []map[string]any{
+		{"code": "ab", "percent_off": 10, "duration": "once"},
+		{"code": "has space", "percent_off": 10, "duration": "once"},
+		{"code": "OKAY", "percent_off": 10, "amount_off": "1.00", "currency": "USD", "duration": "once"},
+		{"code": "OKAY", "duration": "once"},
+		{"code": "OKAY", "percent_off": 0, "duration": "once"},
+		{"code": "OKAY", "percent_off": 101, "duration": "once"},
+		{"code": "OKAY", "amount_off": "0.00", "currency": "USD", "duration": "once"},
+		{"code": "OKAY", "amount_off": "abc", "currency": "USD", "duration": "once"},
+		{"code": "OKAY", "amount_off": "5.00", "duration": "once"},
+		{"code": "OKAY", "percent_off": 10, "duration": "weekly"},
+		{"code": "OKAY", "percent_off": 10, "duration": "once", "duration_in_months": 3},
+		{"code": "OKAY", "percent_off": 10, "duration": "repeating"},
+		{"code": "OKAY", "percent_off": 10, "duration": "repeating", "duration_in_months": 37},
+		{"code": "OKAY", "percent_off": 10, "duration": "once", "max_redemptions": 0},
+		{"code": "OKAY", "percent_off": "10", "duration": "once"},
+		{"code": "OKAY", "percent_off": 10, "duration": "repeating", "duration_in_months": "3"},
+		{"code": "OKAY", "percent_off": 10, "duration": "once", "max_redemptions": 1.5},
+		{"code": "OKAY", "percent_off": 10, "duration": "once", "redeem_by": "not-a-date"},
+		{"code": 1234, "percent_off": 10, "duration": "once"},
+	}
+	for _, in := range bad {
+		if r := e.Do("POST", "/v1/coupons", e.Acme.Key, in); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid" {
+			t.Fatalf("%v: %s", in, r)
+		}
+	}
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, `{"code": "OKAY",`); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_json" {
+		t.Fatalf("malformed JSON: %s", r)
+	}
+
+	var list struct {
+		Items []store.Coupon `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons", e.Acme.Key, nil, &list)
+	if len(list.Items) != 2 || list.Items[0].ID != pct.ID || list.Items[1].Code != "take_20-off" {
+		t.Fatalf("list = %+v", list.Items)
+	}
+	var got store.Coupon
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/spring25", e.Acme.Key, nil, &got)
+	if got.ID != pct.ID {
+		t.Fatalf("get ignoring case = %+v", got)
+	}
+	if r := e.Do("GET", "/v1/coupons/SPRING25", e.Globex.Key, nil); r.Code != http.StatusOK || r.Map(t)["id"] == pct.ID {
+		t.Fatalf("Globex's own coupon: %s", r)
+	}
+	if r := e.Do("GET", "/v1/coupons/nope", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("missing coupon: %s", r)
+	}
+}
+
+func TestApplyCoupon(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	usd := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	eur := e.CreatePlan(e.Acme, "Pro", "EUR", "30.00")
+	newSub := func(plan store.Plan) store.Subscription {
+		t.Helper()
+		var s store.Subscription
+		e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": plan.ID}, &s)
+		return s
+	}
+	coupon := func(in map[string]any) {
+		t.Helper()
+		e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, in, nil)
+	}
+	coupon(map[string]any{"code": "SPRING25", "percent_off": 25, "duration": "forever"})
+	coupon(map[string]any{"code": "ONEUSE", "percent_off": 10, "duration": "forever", "max_redemptions": 1})
+	coupon(map[string]any{"code": "EUR5", "amount_off": "5.00", "currency": "EUR", "duration": "once"})
+	coupon(map[string]any{"code": "OLD", "percent_off": 10, "duration": "once", "redeem_by": "2026-01-14T00:00:00Z"})
+	s1, s2, s3 := newSub(usd), newSub(usd), newSub(usd)
+	s4, s5, s6 := newSub(usd), newSub(eur), newSub(usd)
+	apply := func(subID, code string) *apitest.Response {
+		return e.Do("POST", "/v1/subscriptions/"+subID+"/coupon", e.Acme.Key, map[string]string{"code": code})
+	}
+
+	if r := apply("sub_999999", "SPRING25"); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("no such subscription: %s", r)
+	}
+	if r := apply(s1.ID, "nope"); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("no such coupon: %s", r)
+	}
+	var got store.Subscription
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+s1.ID+"/coupon", e.Acme.Key, map[string]string{"code": "spring25"}, &got)
+	if got.Coupon != "SPRING25" || got.CouponRedeemedAt == nil {
+		t.Fatalf("applied = %+v", got)
+	}
+	if r := apply(s1.ID, "ONEUSE"); r.Code != http.StatusConflict || r.Map(t)["error"] != "coupon_already_applied" {
+		t.Fatalf("second coupon: %s", r)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+s2.ID+"/coupon", e.Acme.Key, map[string]string{"code": "ONEUSE"}, nil)
+	if r := apply(s3.ID, "ONEUSE"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_exhausted" {
+		t.Fatalf("exhausted: %s", r)
+	}
+	if r := apply(s4.ID, "EUR5"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "currency_mismatch" {
+		t.Fatalf("currency: %s", r)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+s5.ID+"/coupon", e.Acme.Key, map[string]string{"code": "EUR5"}, nil)
+	if r := apply(s4.ID, "OLD"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_expired" {
+		t.Fatalf("expired: %s", r)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+s6.ID+"/cancel", e.Acme.Key, nil, nil)
+	if r := apply(s6.ID, "SPRING25"); r.Code != http.StatusConflict || r.Map(t)["error"] != "subscription_canceled" {
+		t.Fatalf("canceled: %s", r)
+	}
+
+	// A refused coupon is not redeemed: only the subscriptions that have it count.
+	var spring, oneUse store.Coupon
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/SPRING25", e.Acme.Key, nil, &spring)
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/ONEUSE", e.Acme.Key, nil, &oneUse)
+	if spring.TimesRedeemed != 1 || oneUse.TimesRedeemed != 1 {
+		t.Fatalf("times redeemed: SPRING25 %d, ONEUSE %d", spring.TimesRedeemed, oneUse.TimesRedeemed)
+	}
+	var s3Now store.Subscription
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions/"+s3.ID, e.Acme.Key, nil, &s3Now)
+	if s3Now.Coupon != "" {
+		t.Fatalf("refused coupon was applied: %+v", s3Now)
+	}
+
+	// The coupon shows on the invoice of the next period, with its discount.
+	e.Clock.Set(e.Clock.Now().AddDate(0, 1, 0))
+	if _, err := e.Subs.RenewDue(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	var invs struct {
+		Items []struct {
+			Coupon   string `json:"coupon"`
+			Discount int64  `json:"discount"`
+			Total    int64  `json:"total"`
+		} `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+s1.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 2 || invs.Items[0].Coupon != "" || invs.Items[1].Coupon != "SPRING25" || invs.Items[1].Discount != 500 || invs.Items[1].Total != 1500 {
+		t.Fatalf("invoices = %+v", invs.Items)
+	}
+}
