diff --git a/result/internal/subscriptions/coupons_test.go b/result/internal/subscriptions/coupons_test.go
new file mode 100644
index 0000000..abfe74b
--- /dev/null
+++ b/result/internal/subscriptions/coupons_test.go
@@ -0,0 +1,127 @@
+package subscriptions_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/billing"
+	"example.com/tally/internal/store"
+	"example.com/tally/internal/subscriptions"
+)
+
+func ptr[T any](v T) *T { return &v }
+
+// invoiceWant is what an invoice of a subscription should show: the coupon that discounted it, its discount and its total.
+type invoiceWant struct {
+	coupon   string
+	discount int64
+	total    int64
+}
+
+func TestCouponDiscountsTheInvoicesItsDurationCovers(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	start := e.Clock.Now()
+
+	create := func(discount int) store.Subscription {
+		t.Helper()
+		sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1, DiscountPercent: discount})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return sub
+	}
+	once, repeating, forever := create(0), create(0), create(10)
+
+	for _, cp := range []store.Coupon{
+		{Code: "ONCE50", PercentOff: ptr(50), Duration: store.CouponOnce},
+		{Code: "THREE5", AmountOff: ptr(int64(500)), Currency: "USD", Duration: store.CouponRepeating, DurationInMonths: ptr(2)},
+		{Code: "FOREVER20", PercentOff: ptr(20), Duration: store.CouponForever},
+	} {
+		cp.OrgID = e.Acme.ID
+		if _, err := e.Store.CreateCoupon(cp, start); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// Applied after each subscription's first invoice, which the coupon must not discount.
+	for sub, code := range map[string]string{once.ID: "ONCE50", repeating.ID: "THREE5", forever.ID: "FOREVER20"} {
+		if _, err := e.Subs.ApplyCoupon(ctx, e.Acme.ID, sub, code); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	check := func(name string, sub store.Subscription, want []invoiceWant) {
+		t.Helper()
+		invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+		if len(invs) != len(want) {
+			t.Fatalf("%s: %d invoices, want %d", name, len(invs), len(want))
+		}
+		for i, inv := range invs {
+			tot := billing.Compute(inv)
+			if got := (invoiceWant{inv.Coupon, tot.Discount, tot.Total}); got != want[i] {
+				t.Fatalf("%s: invoice %d = %+v, want %+v", name, i, got, want[i])
+			}
+		}
+	}
+
+	// Each subscription is renewed a month, then another month, later.
+	e.Clock.Set(start.AddDate(0, 1, 0))
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 3 {
+		t.Fatalf("first renewal: %d, %v", n, err)
+	}
+	e.Clock.Set(start.AddDate(0, 2, 0))
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 3 {
+		t.Fatalf("second renewal: %d, %v", n, err)
+	}
+
+	// A once coupon discounts only the first invoice after it was applied.
+	check("once", once, []invoiceWant{{"", 0, 2000}, {"ONCE50", 1000, 1000}, {"", 0, 2000}})
+	// A coupon of two months discounts the invoices whose period starts less than two months after it was applied.
+	check("repeating", repeating, []invoiceWant{{"", 0, 2000}, {"THREE5", 500, 1500}, {"", 0, 2000}})
+	// A forever coupon discounts all of them, and the subscription's own discount does not apply to them. The first
+	// invoice, made before the coupon, has the subscription's 10 percent.
+	check("forever", forever, []invoiceWant{{"", 200, 1800}, {"FOREVER20", 400, 1600}, {"FOREVER20", 400, 1600}})
+
+	got, _ := e.Store.Subscription(e.Acme.ID, forever.ID)
+	if got.Coupon != "FOREVER20" || got.DiscountPercent != 10 {
+		t.Fatalf("forever subscription = %+v", got)
+	}
+}
+
+func TestCouponIsRedeemedAtTheTimeItIsApplied(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.Store.CreateCoupon(store.Coupon{OrgID: e.Acme.ID, Code: "LATER", PercentOff: ptr(25), Duration: store.CouponOnce}, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	// Applied a month into the subscription, so the first renewal is the first invoice after it.
+	e.Clock.Advance(7 * 24 * time.Hour)
+	redeemed := e.Clock.Now()
+	if _, err := e.Subs.ApplyCoupon(ctx, e.Acme.ID, sub.ID, "LATER"); err != nil {
+		t.Fatal(err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.CouponRedeemedAt == nil || !got.CouponRedeemedAt.Equal(redeemed) {
+		t.Fatalf("redeemed at %v, want %v", got.CouponRedeemedAt, redeemed)
+	}
+	e.Clock.Set(e.Clock.Now().AddDate(0, 1, 0))
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("renewal: %d, %v", n, err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[0].Coupon != "" || invs[1].Coupon != "LATER" || billing.Compute(invs[1]).Discount != 500 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+}
