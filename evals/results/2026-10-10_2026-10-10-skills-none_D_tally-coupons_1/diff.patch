@@ -0,0 +1,44 @@
+package store
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+func TestCouponsSurviveExport(t *testing.T) {
+	now := time.Date(2026, 2, 1, 0, 0, 0, 0, time.UTC)
+	st := New()
+	o, _ := st.CreateOrg("A", OrgTeam, "UTC", 0, now)
+	c, _ := st.CreateCustomer(o.ID, "Jane", "jane@example.com", now)
+	p, _ := st.CreatePlan(Plan{OrgID: o.ID, Name: "Team", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, now)
+	sub, _ := st.CreateSubscription(Subscription{OrgID: o.ID, CustomerID: c.ID, PlanID: p.ID, Quantity: 1, Status: Active}, now)
+	pct := 25
+	if _, err := st.CreateCoupon(Coupon{OrgID: o.ID, Code: "Sale_25", PercentOff: &pct, Duration: CouponForever}, now); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := st.RedeemCoupon(o.ID, sub.ID, "sale_25", now); err != nil {
+		t.Fatal(err)
+	}
+
+	loaded, err := FromState(st.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(loaded.Export(), st.Export()) {
+		t.Fatal("the loaded store differs from the saved one")
+	}
+	got, ok := loaded.Coupon(o.ID, "SALE_25")
+	if !ok || got.Code != "Sale_25" || got.TimesRedeemed != 1 {
+		t.Fatalf("coupon after reload = %+v, %v", got, ok)
+	}
+	if _, err := loaded.CreateCoupon(Coupon{OrgID: o.ID, Code: "sale_25", PercentOff: &pct, Duration: CouponForever}, now); !errors.Is(err, ErrCodeTaken) {
+		t.Fatalf("code after reload: %v", err)
+	}
+	if sub, _ := loaded.Subscription(o.ID, sub.ID); sub.Coupon != "Sale_25" || sub.CouponRedeemedAt == nil {
+		t.Fatalf("subscription after reload = %+v", sub)
+	}
+}
