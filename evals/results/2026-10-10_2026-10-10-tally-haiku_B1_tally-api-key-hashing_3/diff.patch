+func TestAPIKeyTokenFormat(t *testing.T) {
+	const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+	seen := map[string]bool{}
+	counts := map[rune]int{}
+	for i := 0; i < 500; i++ {
+		tok := newAPIKeyToken()
+		if len(tok) != len("tly_")+40 || tok[:4] != "tly_" {
+			t.Fatalf("token %q has the wrong shape", tok)
+		}
+		for _, c := range tok[4:] {
+			if !strings.ContainsRune(alphabet, c) {
+				t.Fatalf("token %q has the character %q", tok, c)
+			}
+			counts[c]++
+		}
+		if seen[tok] {
+			t.Fatalf("token %q repeated", tok)
+		}
+		seen[tok] = true
+	}
+	// 500 tokens of 40 characters is 20000 draws over 62 characters: about 323 each. A broken generator would be far off.
+	for _, c := range alphabet {
+		if counts[c] < 150 || counts[c] > 500 {
+			t.Fatalf("character %q appears %d times in 20000", c, counts[c])
+		}
+	}
+}
