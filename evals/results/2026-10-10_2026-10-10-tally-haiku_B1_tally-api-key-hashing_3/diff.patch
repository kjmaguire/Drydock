+const (
+	apiKeyPrefix   = "tly_"
+	apiKeyLength   = 40 // random characters after the prefix
+	apiKeyAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+)
+
+// newAPIKeyToken returns "tly_" followed by 40 random characters from [A-Za-z0-9].
+func newAPIKeyToken() string {
+	out := make([]byte, 0, apiKeyLength)
+	buf := make([]byte, 64)
+	// 248 is the largest multiple of 62 that fits in a byte. Bytes from 248 up are redrawn so that every character is equally
+	// likely.
+	for len(out) < apiKeyLength {
+		if _, err := rand.Read(buf); err != nil {
+			panic(err) // crypto/rand does not fail on supported platforms
+		}
+		for _, b := range buf {
+			if b < 248 && len(out) < apiKeyLength {
+				out = append(out, apiKeyAlphabet[int(b)%len(apiKeyAlphabet)])
+			}
+		}
+	}
+	return apiKeyPrefix + string(out)
+}
+
+// hashToken returns the SHA-256 of a token, in hex. It is what the store keeps in place of the token.
+func hashToken(token string) string {
+	sum := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(sum[:])
+}
+
+// lastFour returns the last four characters of a token (all of it if it is shorter).
+func lastFour(token string) string {
+	if len(token) <= 4 {
+		return token
+	}
+	return token[len(token)-4:]
+}
