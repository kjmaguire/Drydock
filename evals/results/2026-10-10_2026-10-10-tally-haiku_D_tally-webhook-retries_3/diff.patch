+// failForGood fails a pending delivery without an attempt, with why it was not sent.
+func (s *Service) failForGood(id, reason string) {
+	_, _ = s.store.UpdateDelivery(id, func(d *store.Delivery) error {
+		d.Status = store.DeliveryFailed
+		d.NextAttemptAt = nil
+		d.Error = reason
+		return nil
+	})
+}
