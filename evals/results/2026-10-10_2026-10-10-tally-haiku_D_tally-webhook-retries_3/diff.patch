+func TestGoneDisablesEndpoint(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/gone", Events: []string{"*"}, Secret: "whsec_g", Enabled: true}, e.Clock.Now())
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusGone, nil }
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"})
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.updated", map[string]string{"id": "cus_1"})
+	if n, _ := e.Webhooks.RunDue(ctx); n != 1 {
+		t.Fatalf("RunDue = %d, want 1 (the endpoint's other delivery is not sent)", n)
+	}
+	if got := len(e.HTTP.Requests()); got != 1 {
+		t.Fatalf("requests = %d, want 1", got)
+	}
+	var gone, other store.Delivery
+	for _, d := range e.Store.Deliveries(e.Acme.ID, ep.ID) {
+		if d.Attempts == 1 {
+			gone = d
+		} else {
+			other = d
+		}
+	}
+	if gone.Status != store.DeliveryFailed || gone.ResponseStatus != http.StatusGone || gone.NextAttemptAt != nil {
+		t.Fatalf("410 delivery = %+v", gone)
+	}
+	if other.Status != store.DeliveryFailed || other.Attempts != 0 {
+		t.Fatalf("other delivery = %+v", other)
+	}
+	got, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID)
+	if got.Enabled || got.DisabledReason != "gone" {
+		t.Fatalf("endpoint = %+v", got)
+	}
+	if n := len(e.Mail.Messages()); n != 0 {
+		t.Fatalf("a 410 sent %d emails, want none", n)
+	}
+}
