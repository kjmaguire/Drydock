+// settle runs the due deliveries of ep, moving the clock to each next attempt, until none is pending.
+func settle(t *testing.T, e *apitest.Env, ep store.WebhookEndpoint) {
+	t.Helper()
+	for range 20 {
+		var next *time.Time
+		for _, d := range e.Store.Deliveries(ep.OrgID, ep.ID) {
+			if d.Status == store.DeliveryPending && (next == nil || d.NextAttemptAt.Before(*next)) {
+				next = d.NextAttemptAt
+			}
+		}
+		if next == nil {
+			return
+		}
+		if next.After(e.Clock.Now()) {
+			e.Clock.Set(*next)
+		}
+		if _, err := e.Webhooks.RunDue(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Fatal("deliveries are still pending after 20 rounds")
+}
+
+func TestRetrySchedule(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/retry", Events: []string{"*"}, Secret: "whsec_r", Enabled: true}, e.Clock.Now())
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusInternalServerError, nil }
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"})
+	delays := []time.Duration{time.Minute, 5 * time.Minute, 30 * time.Minute, 2 * time.Hour, 8 * time.Hour, 24 * time.Hour}
+
+	for attempt := 1; attempt <= 7; attempt++ {
+		if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+			t.Fatalf("attempt %d: RunDue = %d, %v", attempt, n, err)
+		}
+		d := e.Store.Deliveries(e.Acme.ID, ep.ID)[0]
+		if d.Attempts != attempt || d.ResponseStatus != 500 || d.Error == "" || d.LastAttemptAt == nil || !d.LastAttemptAt.Equal(e.Clock.Now()) {
+			t.Fatalf("attempt %d: delivery = %+v", attempt, d)
+		}
+		if attempt == 7 {
+			if d.Status != store.DeliveryFailed || d.NextAttemptAt != nil {
+				t.Fatalf("after 7 attempts: delivery = %+v, want failed with no next attempt", d)
+			}
+			break
+		}
+		if d.Status != store.DeliveryPending || d.NextAttemptAt == nil || !d.NextAttemptAt.Equal(e.Clock.Now().Add(delays[attempt-1])) {
+			t.Fatalf("after attempt %d: delivery = %+v, want pending, retried %v later", attempt, d, delays[attempt-1])
+		}
+		e.Clock.Advance(delays[attempt-1] - time.Second)
+		if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+			t.Fatalf("after attempt %d: %d attempts a second early", attempt, n)
+		}
+		e.Clock.Advance(time.Second)
+	}
+	if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+		t.Fatalf("a delivery that failed for good was attempted again: %d", n)
+	}
+	if got := len(e.HTTP.Requests()); got != 7 {
+		t.Fatalf("requests = %d, want 7", got)
+	}
+	raw, _ := json.Marshal(e.Store.Deliveries(e.Acme.ID, ep.ID)[0])
+	if !strings.Contains(string(raw), `"next_attempt_at":null`) || !strings.Contains(string(raw), `"attempts":7`) {
+		t.Fatalf("delivery JSON = %s", raw)
+	}
+}
