+// reportFailing emails every owner of the endpoint's organization that the endpoint keeps failing, at most once per
+// endpoint in failureMailInterval.
+func (s *Service) reportFailing(ctx context.Context, ep store.WebhookEndpoint) {
+	if s.mail == nil {
+		return
+	}
+	now := s.clock.Now()
+	s.mu.Lock()
+	if last, ok := s.lastMail[ep.ID]; ok && now.Sub(last) < failureMailInterval {
+		s.mu.Unlock()
+		return
+	}
+	s.lastMail[ep.ID] = now
+	s.mu.Unlock()
+	for _, m := range s.store.Members(ep.OrgID) {
+		if m.Role != store.RoleOwner {
+			continue
+		}
+		u, ok := s.store.User(m.UserID)
+		if !ok {
+			continue
+		}
+		_ = s.mail.Send(ctx, mail.Message{
+			To:      u.Email,
+			Subject: "Webhook endpoint failing: " + ep.URL,
+			Body:    fmt.Sprintf("Tally could not deliver events to %s after %d attempts, so those deliveries have failed for good. Check that the endpoint answers with a 2xx status within 10 seconds.", ep.URL, maxAttempts),
+		})
+	}
 }
 
