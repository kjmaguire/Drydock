+func TestFailingEndpointEmailsOwnersOncePerDay(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/fail", Events: []string{"*"}, Secret: "whsec_f", Enabled: true}, e.Clock.Now())
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusBadGateway, nil }
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"})
+	_, _ = e.Webhooks.RunDue(ctx)
+	// A second event arrives an hour later, while the first is still being retried. Both then fail for good about an hour
+	// apart, which is within 24 hours of each other.
+	e.Clock.Advance(time.Hour)
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.updated", map[string]string{"id": "cus_2"})
+	settle(t, e, ep)
+
+	msgs := e.Mail.Messages()
+	if len(msgs) != 1 || msgs[0].To != "owner@acme.example" || msgs[0].Subject != "Webhook endpoint failing: "+ep.URL {
+		t.Fatalf("emails = %+v, want one to the owner", msgs)
+	}
+	// Once more than a day has passed since that email, a new failure for good is reported again.
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.deleted", map[string]string{"id": "cus_3"})
+	settle(t, e, ep)
+	if n := len(e.Mail.Messages()); n != 2 {
+		t.Fatalf("emails = %d, want 2", n)
+	}
