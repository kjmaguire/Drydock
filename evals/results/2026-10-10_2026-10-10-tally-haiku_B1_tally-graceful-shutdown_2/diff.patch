+// shutdownWithin calls Shutdown and fails the test if it does not return within 5 seconds.
+func shutdownWithin(t *testing.T, r *Runner, ctx context.Context) error {
+	t.Helper()
+	errc := make(chan error, 1)
+	go func() { errc <- r.Shutdown(ctx) }()
+	select {
+	case err := <-errc:
+		return err
+	case <-time.After(5 * time.Second):
+		t.Fatal("Shutdown did not return")
+		return nil
+	}
+}
+
+func jobNames(jobs []Job) []string {
+	names := make([]string, 0, len(jobs))
+	for _, j := range jobs {
+		names = append(names, j.Name)
+	}
+	return names
+}
+
+func sameNames(got []Job, want ...string) bool {
+	names := jobNames(got)
+	if len(names) != len(want) {
+		return false
+	}
+	for i := range names {
+		if names[i] != want[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// blocker returns a job that reports its start and then runs until its context ends, returning ctx.Err().
+func blocker(name string, started chan<- string) Job {
+	return Job{Name: name, Run: func(ctx context.Context) error {
+		started <- name
+		<-ctx.Done()
+		return ctx.Err()
+	}}
+}
+
+// quick returns a job that finishes at once.
+func quick(name string) Job {
+	return Job{Name: name, Run: func(context.Context) error { return nil }}
+}
+
+func TestEnqueueAfterShutdown(t *testing.T) {
+	r := NewRunner(2, 10, nil)
+	r.Start()
+	if err := shutdownWithin(t, r, context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Enqueue(quick("x")); !errors.Is(err, ErrStopped) {
+		t.Fatalf("err = %v, want ErrStopped", err)
+	}
+	if got := r.Pending(); len(got) != 0 {
+		t.Fatalf("Pending = %v, want none", jobNames(got))
+	}
+}
+
+func TestShutdownWaitsForRunningJobs(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started := make(chan string, 1)
+	release := make(chan struct{})
+	var ran []string
+	var mu sync.Mutex
+	record := func(name string) Job {
+		return Job{Name: name, Run: func(context.Context) error {
+			mu.Lock()
+			ran = append(ran, name)
+			mu.Unlock()
+			return nil
+		}}
+	}
+	if err := r.Enqueue(Job{Name: "a", Run: func(context.Context) error {
+		started <- "a"
