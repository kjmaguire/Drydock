+// A job that ignores its context keeps Shutdown waiting, because Shutdown must not return while a job
+// goroutine is still running. Later calls wait for the first call to finish, or until their own ctx ends.
+func (r *Runner) Shutdown(ctx context.Context) error {
+	r.mu.Lock()
+	if r.stopping {
+		r.mu.Unlock()
+		select {
+		case <-r.done:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	r.stopping = true
+	r.cond.Broadcast()
+	r.mu.Unlock()
+	defer close(r.done)
