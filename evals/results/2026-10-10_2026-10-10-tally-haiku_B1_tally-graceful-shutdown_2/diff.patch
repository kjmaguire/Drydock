+func TestEnqueueRacingShutdown(t *testing.T) {
+	r := NewRunner(4, 100000, nil)
+	r.Start()
+	var mu sync.Mutex
+	ran := map[string]bool{}
+	accepted := map[string]bool{}
+	var wg sync.WaitGroup
+	for p := 0; p < 8; p++ {
+		wg.Add(1)
+		go func(p int) {
+			defer wg.Done()
+			for i := 0; i < 500; i++ {
+				name := fmt.Sprintf("p%d-%d", p, i)
+				err := r.Enqueue(Job{Name: name, Run: func(context.Context) error {
+					mu.Lock()
+					ran[name] = true
+					mu.Unlock()
+					return nil
+				}})
+				switch {
+				case err == nil:
+					mu.Lock()
+					accepted[name] = true
+					mu.Unlock()
+				case errors.Is(err, ErrStopped):
+					return
+				default:
+					t.Errorf("Enqueue = %v", err)
+					return
+				}
+			}
+		}(p)
+	}
+	time.Sleep(time.Millisecond)
+	if err := shutdownWithin(t, r, context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	wg.Wait()
+
+	// Every accepted job either ran or is still pending, and no job is both.
+	pending := map[string]bool{}
+	for _, j := range r.Pending() {
+		pending[j.Name] = true
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	for name := range accepted {
+		if ran[name] == pending[name] {
+			t.Fatalf("job %s: ran = %v, pending = %v; want exactly one", name, ran[name], pending[name])
+		}
+	}
+	for name := range ran {
+		if !accepted[name] {
+			t.Fatalf("job %s ran but Enqueue did not accept it", name)
+		}
+	}
+}
