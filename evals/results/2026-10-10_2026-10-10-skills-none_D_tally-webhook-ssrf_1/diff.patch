+// isPublic reports whether ip is a public address. An IPv4 address written as IPv6 is judged as the IPv4 address it holds.
+func isPublic(ip netip.Addr) bool {
+	if !ip.IsValid() {
+		return false
+	}
+	ip = ip.Unmap().WithZone("")
+	for _, p := range blockedPrefixes {
+		if p.Contains(ip) {
+			return false
+		}
+	}
+	return true
+}
+
+// addrsOf returns the addresses a host stands for: the host itself when it is an IP address, else every address it resolves to.
+// An address that cannot be read comes back as the zero netip.Addr, which isPublic refuses.
+func (s *Service) addrsOf(ctx context.Context, host string) ([]netip.Addr, error) {
+	if ip, err := netip.ParseAddr(host); err == nil {
+		return []netip.Addr{ip}, nil
+	}
+	ips, err := s.resolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]netip.Addr, 0, len(ips))
+	for _, ip := range ips {
+		a, _ := netip.AddrFromSlice(ip.IP)
+		out = append(out, a)
+	}
+	return out, nil
+}
