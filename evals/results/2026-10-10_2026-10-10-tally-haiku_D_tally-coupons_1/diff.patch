+package api_test
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+func TestCreateAndFindCoupons(t *testing.T) {
+	e := apitest.New(t)
+	var pct store.Coupon
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "spring_25", "percent_off": 25, "duration": "forever"}, &pct)
+	if pct.Code != "spring_25" || pct.PercentOff != 25 || pct.AmountOff != 0 || pct.Duration != store.CouponForever || pct.TimesRedeemed != 0 || pct.Currency != "" {
+		t.Fatalf("percent coupon = %+v", pct)
+	}
+	var off store.Coupon
+	e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "TEN-OFF", "amount_off": "10.50", "currency": "EUR", "duration": "repeating",
+		"duration_in_months": 3, "max_redemptions": 5, "redeem_by": "2026-12-31T23:59:59Z"}, &off)
+	if off.AmountOff != 1050 || off.Currency != money.EUR || off.Duration != store.CouponRepeating || off.DurationInMonths != 3 || off.MaxRedemptions != 5 ||
+		off.RedeemBy == nil || !off.RedeemBy.Equal(time.Date(2026, 12, 31, 23, 59, 59, 0, time.UTC)) {
+		t.Fatalf("amount coupon = %+v", off)
+	}
+	if r := e.Do("POST", "/v1/coupons", e.Acme.Key, map[string]any{"code": "Spring_25", "percent_off": 10, "duration": "once"}); r.Code != http.StatusConflict || r.Map(t)["error"] != "code_taken" {
+		t.Fatalf("code taken, ignoring case: %s", r)
+	}
+	if r := e.Do("POST", "/v1/coupons", e.Globex.Key, map[string]any{"code": "spring_25", "percent_off": 10, "duration": "once"}); r.Code != http.StatusCreated {
+		t.Fatalf("the same code in another organization: %s", r)
+	}
+
+	bad := []map[string]any{
+		{"code": "ab", "percent_off": 10, "duration": "once"},
+		{"code": "has space", "percent_off": 10, "duration": "once"},
+		{"code": "BAD!", "percent_off": 10, "duration": "once"},
+		{"code": "BOTH", "percent_off": 10, "amount_off": "1.00", "currency": "USD", "duration": "once"},
+		{"code": "NEITHER", "duration": "once"},
+		{"code": "ZERO", "percent_off": 0, "duration": "once"},
+		{"code": "OVER", "percent_off": 101, "duration": "once"},
+		{"code": "WORDS", "amount_off": "abc", "currency": "USD", "duration": "once"},
+		{"code": "FREE", "amount_off": "0.00", "currency": "USD", "duration": "once"},
+		{"code": "NOCUR", "amount_off": "1.00", "duration": "once"},
+		{"code": "SOMETIMES", "percent_off": 10, "duration": "sometimes"},
+		{"code": "NODUR", "percent_off": 10},
+		{"code": "NOMONTHS", "percent_off": 10, "duration": "repeating"},
+		{"code": "LONG", "percent_off": 10, "duration": "repeating", "duration_in_months": 37},
+		{"code": "ZEROMONTHS", "percent_off": 10, "duration": "repeating", "duration_in_months": 0},
+		{"code": "ONCEMONTHS", "percent_off": 10, "duration": "once", "duration_in_months": 3},
+		{"code": "NOLIMIT", "percent_off": 10, "duration": "once", "max_redemptions": 0},
+		{"code": "LATER", "percent_off": 10, "duration": "once", "redeem_by": "next week"},
+		{"code": " PADDED ", "percent_off": 10, "duration": "once"},
+		{"code": "STRPCT", "percent_off": "25", "duration": "once"},
+		{"code": "FRACPCT", "percent_off": 25.5, "duration": "once"},
+		{"code": "NUMAMT", "amount_off": 5, "currency": "USD", "duration": "once"},
+		{"code": "STRMONTHS", "percent_off": 10, "duration": "repeating", "duration_in_months": "3"},
+		{"code": "BADCUR", "amount_off": "1.00", "currency": 840, "duration": "once"},
+		{"code": "BADDUR", "percent_off": 10, "duration": 1},
+	}
+	for _, b := range bad {
+		if r := e.Do("POST", "/v1/coupons", e.Acme.Key, b); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid" {
+			t.Fatalf("%v: %s", b, r)
+		}
+	}
+
+	var found store.Coupon
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/TEN-OFF", e.Acme.Key, nil, &found)
+	if found.ID != off.ID || found.AmountOff != 1050 {
+		t.Fatalf("found = %+v", found)
+	}
+	if r := e.Do("GET", "/v1/coupons/nope", e.Acme.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("unknown coupon: %s", r)
+	}
+	if r := e.Do("GET", "/v1/coupons/spring_25", e.Globex.Key, nil); r.Code != http.StatusOK {
+		t.Fatalf("Globex's own coupon: %s", r)
+	}
+	var list struct{ Items []store.Coupon }
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons", e.Acme.Key, nil, &list)
+	if len(list.Items) != 2 || list.Items[0].ID != pct.ID || list.Items[1].ID != off.ID {
+		t.Fatalf("list = %+v", list.Items)
+	}
+}
+
+func TestApplyCoupon(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	usd := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	eur := e.CreatePlan(e.Acme, "Team EU", "EUR", "20.00")
+	subscribe := func(p store.Plan) store.Subscription {
+		var sub store.Subscription
+		e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": p.ID}, &sub)
+		return sub
+	}
+	apply := func(sub store.Subscription, code string) *apitest.Response {
+		return e.Do("POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": code})
+	}
+	coupon := func(body map[string]any) {
+		e.MustDo(http.StatusCreated, "POST", "/v1/coupons", e.Acme.Key, body, nil)
+	}
+	coupon(map[string]any{"code": "PCT", "percent_off": 10, "duration": "forever"})
+	coupon(map[string]any{"code": "EUR5", "amount_off": "5.00", "currency": "EUR", "duration": "once"})
+	coupon(map[string]any{"code": "ONE", "percent_off": 10, "duration": "forever", "max_redemptions": 1})
+	coupon(map[string]any{"code": "OLD", "percent_off": 10, "duration": "once", "redeem_by": e.Clock.Now().Add(time.Hour).Format(time.RFC3339)})
+
+	sub := subscribe(usd)
+	var applied store.Subscription
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Acme.Key, map[string]string{"code": "pct"}, &applied)
+	if applied.Coupon != "PCT" || applied.CouponRedeemedAt == nil || !applied.CouponRedeemedAt.Equal(e.Clock.Now()) {
+		t.Fatalf("applied = %+v", applied)
+	}
+	if r := apply(sub, "PCT"); r.Code != http.StatusConflict || r.Map(t)["error"] != "coupon_already_applied" {
+		t.Fatalf("a second coupon: %s", r)
+	}
+	if r := apply(subscribe(usd), "EUR5"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "currency_mismatch" {
+		t.Fatalf("a EUR coupon on a USD plan: %s", r)
+	}
+	var eurSub store.Subscription
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+subscribe(eur).ID+"/coupon", e.Acme.Key, map[string]string{"code": "eur5"}, &eurSub)
+	if eurSub.Coupon != "EUR5" {
+		t.Fatalf("EUR coupon = %+v", eurSub)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+subscribe(usd).ID+"/coupon", e.Acme.Key, map[string]string{"code": "ONE"}, nil)
+	if r := apply(subscribe(usd), "ONE"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_exhausted" {
+		t.Fatalf("exhausted: %s", r)
+	}
+	e.Clock.Advance(2 * time.Hour)
+	if r := apply(subscribe(usd), "OLD"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "coupon_expired" {
+		t.Fatalf("expired: %s", r)
+	}
+	canceled := subscribe(usd)
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+canceled.ID+"/cancel", e.Acme.Key, nil, nil)
+	if r := apply(canceled, "PCT"); r.Code != http.StatusConflict || r.Map(t)["error"] != "subscription_canceled" {
+		t.Fatalf("canceled subscription: %s", r)
+	}
+	if r := apply(subscribe(usd), "NOPE"); r.Code != http.StatusNotFound {
+		t.Fatalf("unknown coupon: %s", r)
+	}
+	if r := e.Do("POST", "/v1/subscriptions/"+sub.ID+"/coupon", e.Globex.Key, map[string]string{"code": "PCT"}); r.Code != http.StatusNotFound {
+		t.Fatalf("another organization's subscription: %s", r)
+	}
+	var pct store.Coupon
+	e.MustDo(http.StatusOK, "GET", "/v1/coupons/PCT", e.Acme.Key, nil, &pct)
+	if pct.TimesRedeemed != 1 {
+		t.Fatalf("times redeemed = %d", pct.TimesRedeemed)
+	}
+
+	// The next renewal is discounted by the coupon, and the invoice shows it.
+	e.Clock.Advance(40 * 24 * time.Hour)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	type invoice struct {
+		store.Invoice
+		Discount int64
+		Total    int64
+	}
+	var invs struct{ Items []invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?subscription_id="+sub.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 2 || invs.Items[0].Coupon != "" || invs.Items[1].Coupon != "PCT" || invs.Items[1].Discount != 200 || invs.Items[1].Total != 1800 {
+		t.Fatalf("invoices = %+v", invs.Items)
+	}
+}
