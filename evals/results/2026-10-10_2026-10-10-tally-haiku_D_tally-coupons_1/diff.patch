+// couponOf returns the coupon that discounts an invoice for the period starting at start, if one does. A once coupon
+// discounts only the first invoice created after it was applied; a repeating coupon discounts the invoices whose period
+// starts less than its duration in months after it was applied; a forever coupon discounts them all.
+func (s *Service) couponOf(sub store.Subscription, start time.Time) (store.Coupon, bool) {
+	if sub.Coupon == "" || sub.CouponRedeemedAt == nil {
+		return store.Coupon{}, false
+	}
+	c, ok := s.Store.CouponByCode(sub.OrgID, sub.Coupon)
+	if !ok {
+		return store.Coupon{}, false
+	}
+	switch c.Duration {
+	case store.CouponOnce:
+		for _, inv := range s.Store.ListInvoices(sub.OrgID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+			if inv.CreatedAt.After(*sub.CouponRedeemedAt) {
+				return store.Coupon{}, false
+			}
+		}
+	case store.CouponRepeating:
+		if !start.Before(sub.CouponRedeemedAt.AddDate(0, c.DurationInMonths, 0)) {
+			return store.Coupon{}, false
+		}
+	}
+	return c, true
+}
+
+// ApplyCoupon applies a coupon to a subscription now. It discounts the invoices the subscription gets from now on, as the
+// coupon's duration says, in place of the subscription's own discount. A subscription has one coupon at a time.
+func (s *Service) ApplyCoupon(ctx context.Context, orgID, id, code string) (store.Subscription, error) {
+	sub, err := s.Store.RedeemCoupon(orgID, id, code, s.Clock.Now(), func(sub store.Subscription) error {
+		if sub.Status == store.Canceled {
+			return ErrCanceled
+		}
+		return nil
+	})
+	if err != nil {
+		return store.Subscription{}, err
+	}
+	s.publish(ctx, orgID, "subscription.updated", sub)
+	return sub, nil
+}
+
 func (s *Service) setStatus(ctx context.Context, sub store.Subscription, st store.SubStatus) (store.Subscription, error) {
 	sub, err := s.Store.UpdateSubscription(sub.OrgID, sub.ID, func(x *store.Subscription) error {
 		x.Status = st
