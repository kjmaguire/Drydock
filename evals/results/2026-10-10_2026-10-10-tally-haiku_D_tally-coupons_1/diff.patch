new file mode 100644
index 0000000..fd68847
--- /dev/null
+++ b/result/internal/store/coupons.go
@@ -0,0 +1,157 @@
+package store
+
+import (
+	"errors"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Coupon errors. Callers check them with errors.Is.
+var (
+	// ErrCouponCodeTaken is returned when a coupon's code is already used in its organization, ignoring case.
+	ErrCouponCodeTaken = fmt.Errorf("%w: coupon code already in use", ErrConflict)
+	// ErrCouponExpired is returned when a coupon's redeem-by time has passed.
+	ErrCouponExpired = errors.New("the coupon can no longer be redeemed")
+	// ErrCouponExhausted is returned when as many subscriptions already have a coupon as its max redemptions.
+	ErrCouponExhausted = errors.New("the coupon has no redemptions left")
+	// ErrCurrencyMismatch is returned when an amount-off coupon is in another currency than the subscription's plan.
+	ErrCurrencyMismatch = errors.New("the coupon's currency is not the plan's currency")
+	// ErrCouponAlreadyApplied is returned when a subscription already has a coupon.
+	ErrCouponAlreadyApplied = errors.New("the subscription already has a coupon")
+)
+
+type couponKey struct{ org, code string }
+
+// couponKeyOf is the index key of a code: codes are unique in an organization, ignoring case.
+func couponKeyOf(orgID, code string) couponKey {
+	return couponKey{orgID, strings.ToLower(code)}
+}
+
+var couponCodeRe = regexp.MustCompile(`^[A-Za-z0-9_-]{3,32}$`)
+
+// CreateCoupon adds a coupon to an organization. It has either PercentOff or AmountOff. TimesRedeemed starts at 0.
+func (s *Store) CreateCoupon(c Coupon, now time.Time) (Coupon, error) {
+	if err := checkCoupon(c); err != nil {
+		return Coupon{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[c.OrgID]; !ok {
+		return Coupon{}, ErrNotFound
+	}
+	k := couponKeyOf(c.OrgID, c.Code)
+	if _, ok := s.couponsByCode[k]; ok {
+		return Coupon{}, ErrCouponCodeTaken
+	}
+	c.ID = s.newID("cpn")
+	c.TimesRedeemed = 0
+	c.CreatedAt = now.UTC()
+	if c.RedeemBy != nil {
+		t := c.RedeemBy.UTC()
+		c.RedeemBy = &t
+	}
+	s.coupons[c.ID] = c
+	s.couponsByCode[k] = c.ID
+	return copyCoupon(c), nil
+}
+
+func checkCoupon(c Coupon) error {
+	switch {
+	case !couponCodeRe.MatchString(c.Code):
+		return invalid("a coupon code is 3 to 32 letters, digits, dashes or underscores")
+	case (c.PercentOff != 0) == (c.AmountOff != 0):
+		return invalid("a coupon takes exactly one of a percentage and an amount off")
+	case c.PercentOff != 0 && (c.PercentOff < 1 || c.PercentOff > 100):
+		return invalid("a percentage off is 1 to 100")
+	case c.AmountOff != 0 && (c.AmountOff < 0 || !c.Currency.Valid()):
+		return invalid("an amount off is positive, in a currency Tally bills in")
+	case c.Duration != CouponOnce && c.Duration != CouponRepeating && c.Duration != CouponForever:
+		return invalid("a coupon lasts once, repeating or forever")
+	case c.Duration == CouponRepeating && (c.DurationInMonths < 1 || c.DurationInMonths > 36):
+		return invalid("a repeating coupon lasts 1 to 36 months")
+	case c.Duration != CouponRepeating && c.DurationInMonths != 0:
+		return invalid("only a repeating coupon has a duration in months")
+	case c.MaxRedemptions < 0:
+		return invalid("a coupon's max redemptions is at least 1")
+	}
+	return nil
+}
+
+// CouponByCode returns an organization's coupon with this code, ignoring case.
+func (s *Store) CouponByCode(orgID, code string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	id, ok := s.couponsByCode[couponKeyOf(orgID, code)]
+	if !ok {
+		return Coupon{}, false
+	}
+	return copyCoupon(s.coupons[id]), true
+}
+
+// Coupons returns an organization's coupons, oldest first.
+func (s *Store) Coupons(orgID string) []Coupon {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Coupon{}
+	for _, c := range s.coupons {
+		if c.OrgID == orgID {
+			out = append(out, copyCoupon(c))
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// RedeemCoupon applies an organization's coupon with this code to one of its subscriptions at now. It returns ErrNotFound
+// for an unknown coupon or subscription, and the coupon errors above when the coupon cannot be applied. check, when not nil,
+// runs last, under the lock, and may refuse with an error of its own; it must not call the store.
+func (s *Store) RedeemCoupon(orgID, subID, code string, now time.Time, check func(Subscription) error) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	sub, ok := s.subs[subID]
+	if !ok || sub.OrgID != orgID {
+		return Subscription{}, ErrNotFound
+	}
+	id, ok := s.couponsByCode[couponKeyOf(orgID, code)]
+	if !ok {
+		return Subscription{}, ErrNotFound
+	}
+	c := s.coupons[id]
+	switch {
+	case c.RedeemBy != nil && now.After(*c.RedeemBy):
+		return Subscription{}, ErrCouponExpired
+	case c.MaxRedemptions > 0 && c.TimesRedeemed >= c.MaxRedemptions:
+		return Subscription{}, ErrCouponExhausted
+	case c.AmountOff != 0 && s.plans[sub.PlanID].Currency != c.Currency:
+		return Subscription{}, ErrCurrencyMismatch
+	case sub.Coupon != "":
+		return Subscription{}, ErrCouponAlreadyApplied
+	}
+	if check != nil {
+		if err := check(copySub(sub)); err != nil {
+			return Subscription{}, err
+		}
+	}
+	t := now.UTC()
+	sub.Coupon, sub.CouponRedeemedAt = c.Code, &t
+	c.TimesRedeemed++
+	s.subs[subID] = sub
+	s.coupons[id] = c
+	return copySub(sub), nil
+}
+
+func copyCoupon(c Coupon) Coupon {
+	if c.RedeemBy != nil {
+		t := *c.RedeemBy
+		c.RedeemBy = &t
+	}
+	return c
+}
