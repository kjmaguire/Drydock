@@ -0,0 +1,80 @@
+package subscriptions_test
+
+import (
+	"context"
+	"slices"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/billing"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+	"example.com/tally/internal/subscriptions"
+)
+
+// shown is an invoice's coupon and its discount.
+type shown struct {
+	coupon   string
+	discount int64
+}
+
+// couponedRenewals starts a 20.00 USD subscription with a 10% discount, applies coupon a day later and renews the
+// subscription at each of the next months. It returns each of its invoices' coupon and discount, oldest first.
+func couponedRenewals(t *testing.T, coupon store.Coupon, months int) []shown {
+	t.Helper()
+	ctx := context.Background()
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1, DiscountPercent: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	coupon.OrgID = e.Acme.ID
+	if _, err := e.Store.CreateCoupon(coupon, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Advance(24 * time.Hour)
+	if _, err := e.Subs.ApplyCoupon(ctx, e.Acme.ID, sub.ID, coupon.Code); err != nil {
+		t.Fatal(err)
+	}
+	for i := 1; i <= months; i++ {
+		e.Clock.Set(apitest.Start.AddDate(0, i, 0))
+		if _, err := e.Subs.RenewDue(ctx); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var out []shown
+	for _, inv := range e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}) {
+		out = append(out, shown{inv.Coupon, billing.Compute(inv).Discount})
+	}
+	return out
+}
+
+func TestOnceCouponDiscountsTheFirstInvoiceAfterIt(t *testing.T) {
+	got := couponedRenewals(t, store.Coupon{Code: "ONCE50", PercentOff: 50, Duration: store.CouponOnce}, 3)
+	// The first invoice predates the coupon and keeps the subscription's 10%; the coupon replaces it, not adds to it.
+	want := []shown{{"", 200}, {"ONCE50", 1000}, {"", 200}, {"", 200}}
+	if !slices.Equal(got, want) {
+		t.Fatalf("invoices = %+v, want %+v", got, want)
+	}
+}
+
+func TestRepeatingCouponDiscountsPeriodsStartingWithinItsMonths(t *testing.T) {
+	got := couponedRenewals(t, store.Coupon{Code: "TWO", PercentOff: 25, Duration: store.CouponRepeating, DurationInMonths: 2}, 3)
+	// The coupon was applied a day after the subscription began: the periods starting at months 1 and 2 are discounted.
+	want := []shown{{"", 200}, {"TWO", 500}, {"TWO", 500}, {"", 200}}
+	if !slices.Equal(got, want) {
+		t.Fatalf("invoices = %+v, want %+v", got, want)
+	}
+}
+
+func TestForeverAmountCouponIsCappedAtTheSubtotal(t *testing.T) {
+	got := couponedRenewals(t, store.Coupon{Code: "BIG", AmountOff: 3000, Currency: money.USD, Duration: store.CouponForever}, 3)
+	// 30.00 off a 20.00 invoice takes the whole subtotal and no more.
+	want := []shown{{"", 200}, {"BIG", 2000}, {"BIG", 2000}, {"BIG", 2000}}
+	if !slices.Equal(got, want) {
+		t.Fatalf("invoices = %+v, want %+v", got, want)
+	}
+}
