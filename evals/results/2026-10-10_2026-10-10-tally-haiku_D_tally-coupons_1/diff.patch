-// whole minor unit.
+// Compute returns an invoice's totals: the sum of its lines, the discount, and tax at the invoice's rate on the subtotal after
+// the discount. The discount is its coupon's when a coupon discounts the invoice, and DiscountPercent of the subtotal
+// otherwise. The discount and the tax are each rounded half away from zero to a whole minor unit.
 func Compute(inv store.Invoice) Totals {
 	var subtotal int64
 	for _, l := range inv.Lines {
 		subtotal += l.Amount()
 	}
-	discount := money.Percent(subtotal, inv.DiscountPercent)
+	discount := discountOf(inv, subtotal)
 	taxable := subtotal - discount
 	tax := money.BasisPoints(taxable, inv.TaxRateBP)
 	return Totals{Subtotal: subtotal, Discount: discount, Tax: tax, Total: taxable + tax}
 }
 
+// discountOf is the discount on an invoice with this subtotal. An amount off never takes more than the subtotal.
+func discountOf(inv store.Invoice, subtotal int64) int64 {
+	switch {
+	case inv.Coupon == "":
+		return money.Percent(subtotal, inv.DiscountPercent)
+	case inv.CouponPercentOff > 0:
+		return money.Percent(subtotal, inv.CouponPercentOff)
+	default:
+		return min(inv.CouponAmountOff, max(subtotal, 0))
+	}
+}
