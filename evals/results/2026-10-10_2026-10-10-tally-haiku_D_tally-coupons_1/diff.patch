+	lines := []store.Line{{Description: "Seats", Quantity: 3, UnitAmount: 1500}, {Description: "Setup", Quantity: 1, UnitAmount: 999}}
+	// A coupon replaces the invoice's discount percent. Tax is on the subtotal after the discount.
+	got := Compute(store.Invoice{Lines: lines, DiscountPercent: 10, TaxRateBP: 825, Coupon: "QUARTER", CouponPercentOff: 25})
+	// subtotal 5499; discount 1374.75 -> 1375; taxable 4124; tax 340.23 -> 340
+	if want := (Totals{Subtotal: 5499, Discount: 1375, Tax: 340, Total: 4464}); got != want {
+		t.Fatalf("percent coupon: Compute = %+v, want %+v", got, want)
+	}
+	got = Compute(store.Invoice{Lines: lines, Coupon: "TEN", CouponAmountOff: 1000})
+	if want := (Totals{Subtotal: 5499, Discount: 1000, Total: 4499}); got != want {
+		t.Fatalf("amount coupon: Compute = %+v, want %+v", got, want)
+	}
+	got = Compute(store.Invoice{Lines: []store.Line{{Description: "x", Quantity: 1, UnitAmount: 500}}, Coupon: "TEN", CouponAmountOff: 1000})
+	if want := (Totals{Subtotal: 500, Discount: 500}); got != want {
+		t.Fatalf("amount coupon above the subtotal: Compute = %+v, want %+v", got, want)
+	}
+}
