+// Pending returns the jobs that still need to run, in enqueue order. Before Shutdown these are the
+// queued jobs. After Shutdown they are the jobs that never started, followed by the jobs that Shutdown
+// canceled and that then returned an error.
+func (r *Runner) Pending() []Job {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	entries := append([]entry{}, r.queue...)
+	sort.Slice(entries, func(i, j int) bool { return entries[i].seq < entries[j].seq })
+	failed := append([]entry{}, r.failed...)
+	sort.Slice(failed, func(i, j int) bool { return failed[i].seq < failed[j].seq })
+	entries = append(entries, failed...)
+	jobs := make([]Job, 0, len(entries))
+	for _, e := range entries {
+		jobs = append(jobs, e.job)
+	}
+	return jobs
 }
