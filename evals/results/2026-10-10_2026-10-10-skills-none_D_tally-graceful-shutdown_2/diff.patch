+func TestPanickingJobIsRecovered(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	var mu sync.Mutex
+	runs := map[string]int{}
+	after := make(chan struct{})
+	jobs := []Job{
+		{Name: "boom", Run: func(context.Context) error {
+			mu.Lock()
+			runs["boom"]++
+			mu.Unlock()
+			panic("boom")
+		}},
+		{Name: "after", Run: func(context.Context) error {
+			mu.Lock()
+			runs["after"]++
+			mu.Unlock()
+			close(after)
+			return nil
+		}},
+	}
+	for _, j := range jobs {
+		if err := r.Enqueue(j); err != nil {
+			t.Fatal(err)
+		}
+	}
+	select {
+	case <-after:
+	case <-time.After(5 * time.Second):
+		t.Fatal("job after the panic did not run")
+	}
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if runs["boom"] != 1 || runs["after"] != 1 {
+		t.Fatalf("runs = %v, want boom once and after once", runs)
+	}
+	if got := names(r.Pending()); len(got) != 0 {
+		t.Fatalf("pending = %v, want none (a panicked job is not run again)", got)
+	}
+}
