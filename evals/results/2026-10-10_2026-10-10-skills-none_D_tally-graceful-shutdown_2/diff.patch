+// blocker returns a job that signals started and then runs until its context is cancelled.
+// It returns the job's context error and records that it saw the cancellation in cancelled.
+func blocker(name string, started chan<- struct{}, cancelled *bool) Job {
+	return Job{Name: name, Run: func(ctx context.Context) error {
+		started <- struct{}{}
+		<-ctx.Done()
+		*cancelled = true
+		return ctx.Err()
+	}}
+}
+
+func names(jobs []Job) []string {
+	out := make([]string, 0, len(jobs))
+	for _, j := range jobs {
+		out = append(out, j.Name)
+	}
+	return out
+}
+
+func equalNames(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestEnqueueAfterShutdownReturnsErrStopped(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	job := Job{Name: "late", Run: func(context.Context) error { return nil }}
+	if err := r.Enqueue(job); !errors.Is(err, ErrStopped) {
+		t.Fatalf("err = %v, want ErrStopped", err)
+	}
+	if got := names(r.Pending()); len(got) != 0 {
+		t.Fatalf("pending = %v, want none", got)
+	}
+}
+
+func TestShutdownWaitsForRunningJobs(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	finished := false
+	if err := r.Enqueue(Job{Name: "slow", Run: func(context.Context) error {
+		time.Sleep(50 * time.Millisecond)
+		finished = true
