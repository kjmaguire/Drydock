+func TestShutdownDoesNotStartQueuedJobs(t *testing.T) {
+	r := NewRunner(1, 10, nil) // one worker, so the other jobs wait in the queue
+	r.Start()
+	started := make(chan struct{}, 1)
+	var cancelled bool
+	var ran []string
+	var mu sync.Mutex
+	record := func(name string) Job {
+		return Job{Name: name, Run: func(context.Context) error {
+			mu.Lock()
+			ran = append(ran, name)
+			mu.Unlock()
+			return nil
+		}}
+	}
+	if err := r.Enqueue(blocker("first", started, &cancelled)); err != nil {
+		t.Fatal(err)
+	}
+	<-started
+	for _, name := range []string{"second", "third"} {
+		if err := r.Enqueue(record(name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if err := r.Shutdown(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Shutdown = %v, want context.DeadlineExceeded", err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(ran) != 0 {
+		t.Fatalf("queued jobs ran: %v", ran)
+	}
+	// Never-started jobs come first, then the canceled job.
+	if got := names(r.Pending()); !equalNames(got, []string{"second", "third", "first"}) {
+		t.Fatalf("pending = %v, want [second third first]", got)
+	}
+}
