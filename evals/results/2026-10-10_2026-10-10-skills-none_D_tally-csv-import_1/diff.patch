+	}
+
+	// Emails are unique within an organization only.
+	if r := e.Do("POST", "/v1/customers/import", e.Globex.Key, "name,email\nJane,jane@example.com\n"); r.Code != http.StatusCreated {
+		t.Fatalf("another org's email: %s", r)
+	}
+	// Globex's customer has the same address as Acme's Jane. Acme still has her, so Acme's import must refuse it.
+	if r := imp("", "name,email\nJane,jane@example.com\n"); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_rows" ||
+		!strings.Contains(r.String(), `"email_taken"`) {
+		t.Fatalf("email of Acme's customer after Globex took it: %s", r)
+	}
+	if n := count(); n != 4 {
+		t.Fatalf("a refused import created Acme customers: %d", n)
+	}
+
+	// The limit is 10,000 data records. Dry runs keep the test quick.
+	rows := func(n int) string {
+		var b strings.Builder
+		b.WriteString("name,email\n")
+		for i := range n {
+			fmt.Fprintf(&b, "Person %d,person%d@example.com\n", i, i)
+		}
+		return b.String()
+	}
+	if r := imp("?dry_run=true", rows(10000)); r.Code != http.StatusOK || r.Map(t)["would_create"] != float64(10000) {
+		t.Fatalf("at the limit: %s", r)
+	}
+	if r := imp("?dry_run=true", rows(10001)); r.Code != http.StatusRequestEntityTooLarge || r.Map(t)["error"] != "too_many_rows" {
+		t.Fatalf("over the limit: %s", r)
+	}
+
+	// A header and no records creates nothing.
+	if r := imp("", "name,email\n"); r.Code != http.StatusCreated || r.Map(t)["created"] != float64(0) {
+		t.Fatalf("header only: %s", r)
+	}
+}
