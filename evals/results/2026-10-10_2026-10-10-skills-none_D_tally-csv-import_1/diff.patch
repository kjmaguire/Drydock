+func TestImportCustomers(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane Doe", "jane@example.com")
+	imp := func(query, body string) *apitest.Response {
+		return e.Do("POST", "/v1/customers/import"+query, e.Acme.Key, body)
+	}
+	count := func() int {
+		t.Helper()
+		var l struct{ Items []store.Customer }
+		e.MustDo(http.StatusOK, "GET", "/v1/customers", e.Acme.Key, nil, &l)
+		return len(l.Items)
+	}
+
+	for _, c := range []struct{ body, code string }{
+		{"", "invalid_header"},
+		{"\r\n\n", "invalid_header"},
+		{"name,phone\nJo,1\n", "invalid_header"},
+		{"email,phone\nx@example.com,1\n", "invalid_header"},
+	} {
+		if r := imp("", c.body); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != c.code {
+			t.Fatalf("%q: %s", c.body, r)
+		}
+	}
+	for _, body := range []string{
+		"name,email\n\"Jo,jo@example.com\n",     // unclosed quote
+		"name,email\nJo,jo\"@example.com\n",     // bare quote
+		"name,email\nJo,jo@example.com,extra\n", // more fields than the header
+	} {
+		if r := imp("", body); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_csv" {
+			t.Fatalf("%q: %s", body, r)
+		}
+	}
+
+	// Any column order, case and spacing in the header, quoted fields with commas, quotes and line breaks, CRLF, a BOM
+	// and blank lines.
+	body := "\xEF\xBB\xBF Email , Name ,Default_Payment_Method,Metadata.CRM,metadata.plan,Notes\r\n" +
+		"jane.doe@example.com,\"Doe, Jane \"\"JD\"\"\",pm_123,7,gold,hi\r\n" +
+		"\r\n" +
+		" ann@example.com ,\"Lee\nAnn\",,,,\r\n" +
+		"bob@example.com,Bob,,,,\r\n"
+	var created struct {
+		Created int              `json:"created"`
+		Items   []store.Customer `json:"items"`
+	}
+	r := imp("", body)
+	if r.Code != http.StatusCreated {
+		t.Fatalf("import: %s", r)
+	}
+	r.JSON(t, &created)
+	if created.Created != 3 || len(created.Items) != 3 {
+		t.Fatalf("created = %+v", created)
+	}
+	if jd := created.Items[0]; jd.Email != "jane.doe@example.com" || jd.Name != `Doe, Jane "JD"` || jd.DefaultPaymentMethod != "pm_123" ||
+		jd.Metadata["CRM"] != "7" || jd.Metadata["plan"] != "gold" || len(jd.Metadata) != 2 {
+		t.Fatalf("first = %+v", jd)
+	}
+	if ann := created.Items[1]; ann.Email != "ann@example.com" || ann.Name != "Lee\nAnn" || ann.Metadata != nil {
+		t.Fatalf("second = %+v", ann)
+	}
+	if bob := created.Items[2]; bob.Email != "bob@example.com" || bob.Name != "Bob" || bob.DefaultPaymentMethod != "" || bob.Metadata != nil {
+		t.Fatalf("third = %+v", bob)
+	}
+	if n := count(); n != 4 {
+		t.Fatalf("%d customers, want 4", n)
+	}
+	var evs struct{ Items []store.Event }
+	e.MustDo(http.StatusOK, "GET", "/v1/events?type=customer.created", e.Acme.Key, nil, &evs)
+	if len(evs.Items) != 4 {
+		t.Fatalf("customer.created events = %d, want 4", len(evs.Items))
+	}
+
+	// Every bad record is listed, once, with its first problem. Nothing is created.
+	bad := "name,email,default_payment_method\n" +
+		",new@example.com,\n" + // 2
+		"Ok,not-an-email,\n" + // 3
+		"Ok,ok@example.com,card_1\n" + // 4
+		"Jane,JANE@example.com,\n" + // 5
+		",jane@example.com,\n" + // 6: a missing name comes before a taken email
+		"Dup,dup@example.com,\n" + // 7
+		"Dup 2,Dup@Example.com,\n" + // 8
+		"\"Multi\nline\",nope,\n" // 9: a record that spans two lines starts on line 9
+	want := []store.RowProblem{
+		{Row: 2, Error: "missing_name"}, {Row: 3, Error: "invalid_email"}, {Row: 4, Error: "invalid_payment_method"},
+		{Row: 5, Error: "email_taken"}, {Row: 6, Error: "missing_name"}, {Row: 8, Error: "duplicate_email"},
+		{Row: 9, Error: "invalid_email"},
