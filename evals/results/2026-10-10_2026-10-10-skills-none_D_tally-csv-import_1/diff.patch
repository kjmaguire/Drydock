+// CustomerRecord is one customer to import, read from a line of an import file.
+type CustomerRecord struct {
+	Row                  int // the line where the record starts, in the file
+	Name                 string
+	Email                string
+	DefaultPaymentMethod string
+	Metadata             map[string]string
+}
+
+// RowProblem says why a record of an import is refused: its first problem, as an error code.
+type RowProblem struct {
+	Row   int    `json:"row"`
+	Error string `json:"error"`
+}
+
+// ImportCustomers creates a customer for each record, in order, or for none: when any record has a problem it creates
+// nothing and returns every problem in file order. The checks are those of CreateCustomer, and an email address may not
+// repeat an earlier record's. With dryRun it only checks. The whole import happens under one lock.
+func (s *Store) ImportCustomers(orgID string, recs []CustomerRecord, now time.Time, dryRun bool) ([]Customer, []RowProblem, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return nil, nil, ErrNotFound
+	}
+	// The global email index holds one customer per address across all organizations, so it cannot say whether this
+	// organization has the address too. Collect this organization's own addresses instead.
+	taken := map[string]bool{}
+	for _, c := range s.customers {
+		if c.OrgID == orgID {
+			taken[normEmail(c.Email)] = true
+		}
+	}
+	var problems []RowProblem
+	seen := map[string]bool{}
+	for _, rec := range recs {
+		name, email := strings.TrimSpace(rec.Name), strings.TrimSpace(rec.Email)
+		key := normEmail(email)
+		code := ""
+		switch {
+		case name == "":
+			code = "missing_name"
+		case !validEmail(email):
+			code = "invalid_email"
+		case rec.DefaultPaymentMethod != "" && !strings.HasPrefix(rec.DefaultPaymentMethod, "pm_"):
+			code = "invalid_payment_method"
+		case taken[key]:
+			code = "email_taken"
+		case seen[key]:
+			code = "duplicate_email"
+		}
+		seen[key] = true
+		if code != "" {
+			problems = append(problems, RowProblem{Row: rec.Row, Error: code})
+		}
+	}
+	if len(problems) > 0 || dryRun {
+		return nil, problems, nil
+	}
+	out := make([]Customer, 0, len(recs))
+	for _, rec := range recs {
+		c := Customer{ID: s.newID("cus"), OrgID: orgID, Name: strings.TrimSpace(rec.Name), Email: strings.TrimSpace(rec.Email),
+			DefaultPaymentMethod: rec.DefaultPaymentMethod, Metadata: rec.Metadata, CreatedAt: now.UTC()}
+		s.customers[c.ID] = c
+		s.customersByEmail[normEmail(c.Email)] = c.ID
+		out = append(out, copyCustomer(c))
+	}
+	return out, nil, nil
+}
