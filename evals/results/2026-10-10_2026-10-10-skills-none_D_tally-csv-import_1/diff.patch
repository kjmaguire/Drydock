+// maxImportRows is the most data records one import may have.
+const maxImportRows = 10000
+
+// importCustomers creates the customers in a CSV body, all or none (see store.ImportCustomers). ?dry_run=true only checks.
+func (s *Server) importCustomers(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	recs, code := parseCustomerCSV(r.Body)
+	switch code {
+	case "invalid_header":
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]string{"error": code})
+		return
+	case "invalid_csv":
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": code})
+		return
+	case "too_many_rows":
+		writeJSON(w, http.StatusRequestEntityTooLarge, map[string]string{"error": code})
+		return
+	}
+	dryRun := r.URL.Query().Get("dry_run") == "true"
+	cs, problems, err := s.store.ImportCustomers(p.OrgID, recs, s.clock.Now(), dryRun)
+	if err != nil {
+		s.storeError(w, err)
+		return
+	}
+	if len(problems) > 0 {
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]any{"error": "invalid_rows", "rows": problems})
+		return
+	}
+	if dryRun {
+		writeJSON(w, http.StatusOK, map[string]int{"created": 0, "would_create": len(recs)})
+		return
+	}
+	for _, c := range cs {
+		s.publish(r.Context(), p.OrgID, "customer.created", c)
+	}
+	writeJSON(w, http.StatusCreated, map[string]any{"created": len(cs), "items": cs})
+}
+
+// parseCustomerCSV reads an import file: a header with "name" and "email" (and optionally "default_payment_method" and
+// "metadata.<key>" columns), then one record per line. It returns the records, or the error code "invalid_header",
+// "invalid_csv" or "too_many_rows".
+func parseCustomerCSV(body io.Reader) ([]store.CustomerRecord, string) {
+	br := bufio.NewReader(body)
+	if bom, err := br.Peek(3); err == nil && bytes.Equal(bom, []byte("\xEF\xBB\xBF")) {
+		_, _ = br.Discard(3)
+	}
+	cr := csv.NewReader(br) // RFC 4180; FieldsPerRecord 0: every record has as many fields as the header
+	header, err := cr.Read()
+	if errors.Is(err, io.EOF) {
+		return nil, "invalid_header"
+	}
+	if err != nil {
+		return nil, "invalid_csv"
+	}
+	const metaPrefix = "metadata."
+	cols := map[string]int{}     // "name", "email", "default_payment_method": the first column with that header
+	metaCols := map[int]string{} // column of a "metadata.<key>" header: the key
+	for i, h := range header {
+		t := strings.TrimSpace(h)
+		if len(t) >= len(metaPrefix) && strings.EqualFold(t[:len(metaPrefix)], metaPrefix) {
+			if key := strings.TrimSpace(t[len(metaPrefix):]); key != "" {
+				metaCols[i] = key
+			}
+			continue
+		}
+		if name := strings.ToLower(t); name != "" {
+			if _, seen := cols[name]; !seen {
+				cols[name] = i
+			}
+		}
+	}
+	nameCol, hasName := cols["name"]
+	emailCol, hasEmail := cols["email"]
+	if !hasName || !hasEmail {
+		return nil, "invalid_header"
+	}
+	paymentCol, hasPayment := cols["default_payment_method"]
+
+	var recs []store.CustomerRecord
+	for {
+		fields, err := cr.Read()
+		if errors.Is(err, io.EOF) {
+			return recs, ""
+		}
+		if err != nil {
+			return nil, "invalid_csv"
+		}
+		if len(recs) == maxImportRows {
+			return nil, "too_many_rows"
+		}
+		line, _ := cr.FieldPos(0)
+		rec := store.CustomerRecord{Row: line, Name: fields[nameCol], Email: fields[emailCol]}
+		if hasPayment {
+			rec.DefaultPaymentMethod = fields[paymentCol]
+		}
+		for i, key := range metaCols {
+			if v := fields[i]; v != "" {
+				if rec.Metadata == nil {
+					rec.Metadata = map[string]string{}
+				}
+				rec.Metadata[key] = v
+			}
+		}
+		recs = append(recs, rec)
+	}
+}
