+			Error string              `json:"error"`
+			Rows  []store.RowProblem `json:"rows"`
+		}
+		if r.Code != http.StatusUnprocessableEntity {
+			t.Fatalf("%s: %s", query, r)
+		}
+		r.JSON(t, &got)
+		if got.Error != "invalid_rows" || !slices.Equal(got.Rows, want) {
+			t.Fatalf("%s: %+v", query, got)
+		}
+	}
+	if n := count(); n != 4 {
+		t.Fatalf("a refused import created customers: %d", n)
+	}
+
+	// A dry run checks the same way and creates nothing.
+	if r := imp("?dry_run=true", "name,email\nAnn,ann2@example.com\nBob,bob2@example.com\n"); r.Code != http.StatusOK || r.Map(t)["would_create"] != float64(2) || r.Map(t)["created"] != float64(0) {
+		t.Fatalf("dry run: %s", r)
