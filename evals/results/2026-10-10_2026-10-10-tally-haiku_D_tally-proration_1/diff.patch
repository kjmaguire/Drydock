+// prorate bills an upgrade for the time left in the current period: the unused part of the old value is credited and the
+// remaining part of the new value is charged. The period does not change. When the period has already ended but its renewal
+// has not run yet, nothing is left to prorate: the remaining time is zero, so the upgrade bills nothing and the renewal
+// bills the new plan in full.
+func (s *Service) prorate(ctx context.Context, sub store.Subscription, oldPlan, newPlan store.Plan, oldValue, newValue int64) (bool, error) {
+	now, end := s.Clock.Now(), sub.CurrentPeriodEnd
