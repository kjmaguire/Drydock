+func TestUpgradeGatewayFailureIsA502OverTheAPI(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	business := e.CreatePlan(e.Acme, "Business", "USD", "50.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": team.ID}, &sub)
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_gateway_down"; return nil })
+
+	r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": business.ID})
+	if r.Code != http.StatusBadGateway {
+		t.Fatalf("status = %d, want 502: %s", r.Code, r)
+	}
+	var body struct {
+		Error        string             `json:"error"`
+		Subscription store.Subscription `json:"subscription"`
+	}
+	r.JSON(t, &body)
+	if body.Error != "upgrade_not_billed" || body.Subscription.PlanID != business.ID || body.Subscription.Status != store.PastDue {
+		t.Fatalf("body = %+v", body)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.PlanID != business.ID || got.Status != store.PastDue {
+		t.Fatalf("stored subscription = %+v", got)
+	}
+}
+
+func TestPendingDowngradeAppliesAtRenewalOverTheAPI(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	business := e.CreatePlan(e.Acme, "Business", "USD", "50.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": business.ID, "quantity": 2}, &sub)
+
+	var got store.Subscription
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": team.ID}, &got)
+	if got.PlanID != business.ID || got.PendingPlanID == nil || *got.PendingPlanID != team.ID || got.PendingQuantity == nil || *got.PendingQuantity != 2 {
+		t.Fatalf("downgrade = %+v", got)
+	}
+
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.PlanID != team.ID || got.Quantity != 2 || got.PendingPlanID != nil || got.PendingQuantity != nil || got.Status != store.Active {
+		t.Fatalf("after renewal = %+v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || len(invs[1].Lines) != 1 || invs[1].Lines[0].Quantity != 2 || invs[1].Lines[0].UnitAmount != 2000 {
+		t.Fatalf("renewal invoice = %+v", invs)
+	}
+}
