+func TestUpgradeGatewayFailureIsReturnedAndPastDue(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	team, business := plan(t, e, "Team", 2000), plan(t, e, "Business", 5000)
+	sub := subscribe(t, e, team, "pm_card_visa", 1, 0)
+	// The gateway is down: the charge fails without a decline, so the error must reach the caller, not read as paid.
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, sub.CustomerID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_gateway_down"; return nil })
+	id := business.ID
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &id})
+	if !errors.Is(err, payments.ErrUnavailable) {
+		t.Fatalf("err = %v, want the gateway error", err)
+	}
+	if got.ID != sub.ID || got.PlanID != business.ID || got.Status != store.PastDue {
+		t.Fatalf("subscription = %+v", got)
+	}
+	if invs := invoicesOf(e, sub); len(invs) != 2 || invs[1].Status != store.InvoiceOpen {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 1 {
+		t.Fatalf("charges = %+v", cs)
+	}
