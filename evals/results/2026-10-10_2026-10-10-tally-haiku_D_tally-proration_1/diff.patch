+func TestUpgradeBillsTheTimeLeftInThePeriod(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	team, business := plan(t, e, "Team", 2000), plan(t, e, "Business", 5000)
+	sub := subscribe(t, e, team, "pm_card_visa", 1, 10)
+	// 10 of the period's 31 days have passed: 21 days (1814400 s) of 2678400 s remain.
+	e.Clock.Set(sub.CurrentPeriodStart.AddDate(0, 0, 10))
+	id := business.ID
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &id})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != business.ID || got.Status != store.Active || !got.CurrentPeriodStart.Equal(sub.CurrentPeriodStart) || !got.CurrentPeriodEnd.Equal(sub.CurrentPeriodEnd) {
+		t.Fatalf("subscription = %+v", got)
+	}
+	invs := invoicesOf(e, sub)
+	if len(invs) != 2 {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	up := invs[1]
+	// Unused: -round(2000 * 21/31) = -1355. Remaining: round(5000 * 21/31) = 3387. The 10% discount is 203 of 2032.
+	want := []store.Line{{Description: "Unused time on Team", Quantity: 1, UnitAmount: -1355}, {Description: "Remaining time on Business", Quantity: 1, UnitAmount: 3387}}
+	if len(up.Lines) != 2 || up.Lines[0] != want[0] || up.Lines[1] != want[1] || up.DiscountPercent != 10 || up.Status != store.InvoicePaid {
+		t.Fatalf("upgrade invoice = %+v", up)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[1].Amount != 1829 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
