+func TestUpgradeAfterThePeriodEndBillsNothingUntilRenewal(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	team, business := plan(t, e, "Team", 2000), plan(t, e, "Business", 5000)
+	sub := subscribe(t, e, team, "pm_card_visa", 1, 0)
+	// The period has ended but RenewDue has not run: no time remains, so the remaining time is zero, not negative.
+	e.Clock.Set(sub.CurrentPeriodEnd.AddDate(0, 0, 1))
+	id := business.ID
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &id})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != business.ID || got.Status != store.Active {
+		t.Fatalf("subscription = %+v", got)
+	}
+	invs := invoicesOf(e, sub)
+	if len(invs) != 2 || len(invs[1].Lines) != 2 || invs[1].Lines[0].UnitAmount != 0 || invs[1].Lines[1].UnitAmount != 0 || invs[1].Status != store.InvoicePaid {
+		t.Fatalf("upgrade invoice = %+v", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 1 {
+		t.Fatalf("charges = %+v", cs)
+	}
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	invs = invoicesOf(e, sub)
+	if len(invs) != 3 || len(invs[2].Lines) != 1 || invs[2].Lines[0].Quantity != 1 || invs[2].Lines[0].UnitAmount != 5000 {
+		t.Fatalf("renewal invoice = %+v", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[1].Amount != 5000 {
+		t.Fatalf("charges = %+v", cs)
+	}
+}
