+func TestSubscriptionChangesOverTheAPI(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	business := e.CreatePlan(e.Acme, "Business", "USD", "50.00")
+	euro := e.CreatePlan(e.Acme, "Euro", "EUR", "20.00")
+	r := e.Do("POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": business.ID, "quantity": 2})
+	if r.Code != http.StatusCreated {
+		t.Fatalf("create: %s", r)
+	}
+	if m := r.Map(t); m["pending_plan_id"] != nil || m["pending_quantity"] != nil {
+		t.Fatalf("nothing is pending yet: %v", m)
+	}
+	var sub store.Subscription
+	r.JSON(t, &sub)
+
+	// A downgrade is pending: the plan and quantity do not change yet.
+	r = e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": team.ID})
+	if m := r.Map(t); r.Code != http.StatusOK || m["plan_id"] != business.ID || m["pending_plan_id"] != team.ID || m["pending_quantity"] != float64(2) {
+		t.Fatalf("downgrade: %s", r)
+	}
+	if r := e.Do("PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": euro.ID}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "incompatible_plan" {
+		t.Fatalf("incompatible change: %s", r)
+	}
+}
+
+func TestUpgradeEqualAndTrialChangesOverTheAPI(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	team := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	business := e.CreatePlan(e.Acme, "Business", "USD", "50.00")
+	pro := e.CreatePlan(e.Acme, "Pro", "USD", "25.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": team.ID}, &sub)
+	// 21 of the period's 31 days remain: the unused 2000 is credited and the remaining 5000 is charged.
+	e.Clock.Set(sub.CurrentPeriodStart.AddDate(0, 0, 10))
+
+	var got store.Subscription
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": business.ID}, &got)
+	if got.PlanID != business.ID || got.Status != store.Active {
+		t.Fatalf("upgrade = %+v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || len(invs[1].Lines) != 2 ||
+		invs[1].Lines[0] != (store.Line{Description: "Unused time on Team", Quantity: 1, UnitAmount: -1355}) ||
+		invs[1].Lines[1] != (store.Line{Description: "Remaining time on Business", Quantity: 1, UnitAmount: 3387}) {
+		t.Fatalf("upgrade invoice = %+v", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 || cs[1].Amount != 2032 {
+		t.Fatalf("charges = %+v", cs)
+	}
+
+	// Pro at 25.00 x 2 is worth the same as Business at 50.00 x 1: the change applies at once and bills nothing.
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+sub.ID, e.Acme.Key, map[string]any{"plan_id": pro.ID, "quantity": 2}, &got)
+	if got.PlanID != pro.ID || got.Quantity != 2 || got.PendingPlanID != nil {
+		t.Fatalf("equal change = %+v", got)
+	}
+	if n := len(e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})); n != 2 {
+		t.Fatalf("an equal change was billed: %d invoices", n)
+	}
+
+	// A trialing subscription applies any change at once and bills nothing.
+	var trial store.Plan
+	r := e.Do("POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "Trial", "currency": "USD", "price": "30.00", "interval": "month", "trial_days": 14})
+	if r.Code != http.StatusCreated {
+		t.Fatalf("create trial plan: %s", r)
+	}
+	r.JSON(t, &trial)
+	c2 := e.CreateCustomer(e.Acme, "Joe", "joe@example.com")
+	var tsub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c2.ID, "plan_id": trial.ID}, &tsub)
+	if tsub.Status != store.Trialing {
+		t.Fatalf("subscription = %+v", tsub)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/subscriptions/"+tsub.ID, e.Acme.Key, map[string]any{"plan_id": business.ID}, &got)
+	if got.PlanID != business.ID || got.Status != store.Trialing || got.PendingPlanID != nil {
+		t.Fatalf("trial change = %+v", got)
+	}
+	if n := len(e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: tsub.ID})); n != 0 {
+		t.Fatalf("a trial change was billed: %d invoices", n)
+	}
+}
