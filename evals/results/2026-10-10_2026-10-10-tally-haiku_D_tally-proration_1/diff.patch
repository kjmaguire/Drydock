+	team, business := plan(t, e, "Team", 2000), plan(t, e, "Business", 5000)
+	sub := subscribe(t, e, business, "pm_card_visa", 2, 0)
+	id := team.ID
+	got, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &id})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.PlanID != business.ID || got.Quantity != 2 || got.PendingPlanID == nil || *got.PendingPlanID != team.ID || got.PendingQuantity == nil || *got.PendingQuantity != 2 {
+		t.Fatalf("subscription = %+v", got)
+	}
+	if invs := invoicesOf(e, sub); len(invs) != 1 {
+		t.Fatalf("a downgrade was billed: %+v", invs)
+	}
+	none := 0
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: &none}); !errors.Is(err, store.ErrInvalid) {
+		t.Fatalf("a quantity of 0: err = %v", err)
+	}
+	if got, _ := e.Store.Subscription(e.Acme.ID, sub.ID); got.PendingQuantity == nil || *got.PendingQuantity != 2 {
+		t.Fatalf("a refused quantity changed the pending change: %+v", got)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ = e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.PlanID != team.ID || got.Quantity != 2 || got.PendingPlanID != nil || got.PendingQuantity != nil || got.Status != store.Active {
+		t.Fatalf("after renewal = %+v", got)
+	}
+	invs := invoicesOf(e, sub)
+	if len(invs) != 2 || len(invs[1].Lines) != 1 || invs[1].Lines[0].Quantity != 2 || invs[1].Lines[0].UnitAmount != 2000 {
+		t.Fatalf("renewal invoice = %+v", invs)
+	}
+}
