+	yearly, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Yearly", Currency: money.USD, UnitAmount: 30000, Interval: store.Yearly}, e.Clock.Now())
+	metered, _ := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "Calls", Currency: money.USD, UnitAmount: 2, Interval: store.Monthly, UsageType: store.Metered}, e.Clock.Now())
+	for _, p := range []store.Plan{eur, yearly, metered} {
+		id := p.ID
+		if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{PlanID: &id}); !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+			t.Fatalf("change to %s: err = %v", p.Name, err)
+		}
+	}
+	meteredSub := subscribe(t, e, metered, "", 1, 0)
+	qty := 2
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, meteredSub.ID, subscriptions.UpdateInput{Quantity: &qty}); !errors.Is(err, subscriptions.ErrIncompatiblePlan) {
+		t.Fatalf("quantity of a metered subscription: err = %v", err)
+	}
+	if got, _ := e.Store.Subscription(e.Acme.ID, sub.ID); got.PlanID != team.ID || len(invoicesOf(e, sub)) != 1 {
