+// plan makes a monthly licensed plan of the Acme organization in USD, priced in minor units.
+func plan(t *testing.T, e *apitest.Env, name string, unit int64) store.Plan {
+	t.Helper()
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: name, Currency: money.USD, UnitAmount: unit, Interval: store.Monthly}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// subscribe starts a subscription to p for a new customer whose default payment method is pm (empty for none).
+func subscribe(t *testing.T, e *apitest.Env, p store.Plan, pm string, qty, discount int) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane+"+p.ID+"@example.com")
+	if pm != "" {
+		_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = pm; return nil })
+	}
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: qty, DiscountPercent: discount})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+func invoicesOf(e *apitest.Env, sub store.Subscription) []store.Invoice {
+	return e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+}
