+++ b/result/internal/store/tenant_test.go
@@ -0,0 +1,108 @@
+package store
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/money"
+)
+
+// Two organizations can each have a customer with the same email address, and neither sees or affects the other's.
+func TestSameEmailInTwoOrgs(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, err := s.CreateCustomer(a.ID, "Jane A", "jane@example.com", t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cb, err := s.CreateCustomer(b.ID, "Jane B", "JANE@example.com", t0)
+	if err != nil {
+		t.Fatalf("the same email in another org: %v", err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+		t.Fatalf("A finds %+v %v, want its own customer", got, ok)
+	}
+	if got, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); !ok || got.ID != cb.ID {
+		t.Fatalf("B finds %+v %v, want its own customer", got, ok)
+	}
+	if _, err := s.CreateCustomer(a.ID, "Jane again", "jane@example.com", t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("duplicate within A: %v", err)
+	}
+
+	// B's changes and deletes leave A's index alone.
+	if _, err := s.UpdateCustomer(b.ID, cb.ID, func(c *Customer) error { c.Email = "jb@example.com"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+		t.Fatalf("after B's update, A finds %+v %v", got, ok)
+	}
+	if err := s.DeleteCustomer(b.ID, cb.ID); err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+		t.Fatalf("after B's delete, A finds %+v %v", got, ok)
+	}
+	if _, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); ok {
+		t.Fatal("B finds a customer of A")
+	}
+
+	// The index survives a save and load.
+	st, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := st.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+		t.Fatalf("after reload, A finds %+v %v", got, ok)
+	}
+}
+
+// Objects that name a customer, a plan or an endpoint of another organization are refused as if they did not exist.
+func TestCrossOrgReferencesAreNotFound(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	pb, _ := s.CreatePlan(Plan{OrgID: b.ID, Name: "Pro", Currency: money.USD, UnitAmount: 100, Interval: Monthly}, t0)
+
+	if _, err := s.CreateInvoice(Invoice{OrgID: b.ID, CustomerID: ca.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for another org's customer: %v", err)
+	}
+	sub := Subscription{OrgID: b.ID, CustomerID: ca.ID, PlanID: pb.ID, Quantity: 1, Status: Active, StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}
+	if _, err := s.CreateSubscription(sub, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for another org's customer: %v", err)
+	}
+	if got := s.Subscriptions(b.ID, SubscriptionFilter{}); len(got) != 0 {
+		t.Fatalf("a refused subscription was stored: %+v", got)
+	}
+	if got := s.ListInvoices(b.ID, InvoiceFilter{}); len(got) != 0 {
+		t.Fatalf("a refused invoice was stored: %+v", got)
+	}
+}
+
+func TestDeleteOrgWebhookEndpoint(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ep, err := s.CreateWebhookEndpoint(WebhookEndpoint{OrgID: a.ID, URL: "https://hooks.a.example/", Events: []string{"*"}, Enabled: true}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ev, _ := s.AddEvent(a.ID, "customer.created", nil, t0)
+	if _, err := s.CreateDelivery(Delivery{OrgID: a.ID, EndpointID: ep.ID, EventID: ev.ID}, t0); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.DeleteOrgWebhookEndpoint(b.ID, ep.ID); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleted through another org: %v", err)
+	}
+	if _, ok := s.WebhookEndpoint(a.ID, ep.ID); !ok {
+		t.Fatal("another org's endpoint was deleted")
+	}
+	if got := s.Deliveries(a.ID, ep.ID); len(got) != 1 {
+		t.Fatalf("another org's deliveries were deleted: %+v", got)
+	}
+	if err := s.DeleteOrgWebhookEndpoint(a.ID, ep.ID); err != nil {
+		t.Fatal(err)
+	}
+	if got := s.DueDeliveries(t0.Add(time.Hour)); len(got) != 0 {
+		t.Fatalf("pending deliveries of a deleted endpoint: %+v", got)
+	}
+}
