+
+// DeleteWebhookEndpoint removes an endpoint of any organization and its pending deliveries (the admin tool). The API uses
+// DeleteOrgWebhookEndpoint.
 func (s *Store) DeleteWebhookEndpoint(id string) error {
 	s.mu.Lock()
