@@ -0,0 +1,140 @@
+package api_test
+
+import (
+	"bytes"
+	"context"
+	"net/http"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// A foreign ID must be answered byte for byte like an unknown ID, so a caller learns nothing about other organizations.
+func sameAnswer(t *testing.T, foreign, unknown *apitest.Response) {
+	t.Helper()
+	if foreign.Code != http.StatusNotFound || unknown.Code != http.StatusNotFound {
+		t.Fatalf("foreign %s, unknown %s: both should be 404", foreign, unknown)
+	}
+	if !bytes.Equal(foreign.Body, unknown.Body) {
+		t.Fatalf("foreign answer %s differs from unknown answer %s", foreign, unknown)
+	}
+	if foreign.Map(t)["error"] != "not_found" {
+		t.Fatalf("answer is not not_found: %s", foreign)
+	}
+}
+
+func createInvoice(t *testing.T, e *apitest.Env, org apitest.Org, customerID string) store.Invoice {
+	t.Helper()
+	var inv store.Invoice
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", org.Key, map[string]any{
+		"customer_id": customerID, "currency": "USD", "lines": []map[string]any{{"description": "Seats", "quantity": 2, "unit_amount": 500}},
+	}, &inv)
+	return inv
+}
+
+// GET /v1/invoices/{id}/lines once answered another organization's lines (the bug a customer reported).
+func TestInvoiceLinesOfAnotherOrgAreNotFound(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	inv := createInvoice(t, e, e.Acme, c.ID)
+
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID+"/lines", e.Acme.Key, nil, nil)
+	foreign := e.Do("GET", "/v1/invoices/"+inv.ID+"/lines", e.Globex.Key, nil)
+	unknown := e.Do("GET", "/v1/invoices/in_999999/lines", e.Globex.Key, nil)
+	sameAnswer(t, foreign, unknown)
+	if r := e.Do("GET", "/v1/invoices/"+inv.ID, e.Globex.Key, nil); r.Code != http.StatusNotFound {
+		t.Fatalf("invoice of another org: %s", r)
+	}
+}
+
+// Writes on another organization's invoice are refused as for an unknown one.
+func TestInvoiceWritesOnAnotherOrgAreNotFound(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	inv := createInvoice(t, e, e.Acme, c.ID)
+
+	for _, action := range []string{"void", "pay"} {
+		body := map[string]string{"payment_method": "pm_1"}
+		foreign := e.Do("POST", "/v1/invoices/"+inv.ID+"/"+action, e.Globex.Key, body)
+		unknown := e.Do("POST", "/v1/invoices/in_999999/"+action, e.Globex.Key, body)
+		sameAnswer(t, foreign, unknown)
+	}
+	var got store.Invoice
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &got)
+	if got.Status != store.InvoiceOpen {
+		t.Fatalf("another org changed the invoice: %s", got.Status)
+	}
+}
+
+// An invoice or subscription may not name another organization's customer; the answer is the one for an unknown customer.
+func TestCustomerIDOfAnotherOrgIsNotFound(t *testing.T) {
+	e := apitest.New(t)
+	foreignCustomer := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	globexPlan := e.CreatePlan(e.Globex, "Pro", "USD", "20.00")
+
+	invBody := func(customerID string) map[string]any {
+		return map[string]any{"customer_id": customerID, "currency": "USD", "lines": []map[string]any{{"description": "x", "quantity": 1, "unit_amount": 100}}}
+	}
+	sameAnswer(t, e.Do("POST", "/v1/invoices", e.Globex.Key, invBody(foreignCustomer.ID)), e.Do("POST", "/v1/invoices", e.Globex.Key, invBody("cus_999999")))
+
+	subBody := func(customerID string) map[string]any {
+		return map[string]any{"customer_id": customerID, "plan_id": globexPlan.ID, "quantity": 1}
+	}
+	sameAnswer(t, e.Do("POST", "/v1/subscriptions", e.Globex.Key, subBody(foreignCustomer.ID)), e.Do("POST", "/v1/subscriptions", e.Globex.Key, subBody("cus_999999")))
+
+	var subs struct{ Items []store.Subscription }
+	e.MustDo(http.StatusOK, "GET", "/v1/subscriptions", e.Globex.Key, nil, &subs)
+	if len(subs.Items) != 0 {
+		t.Fatalf("a subscription for another org's customer was created: %+v", subs.Items)
+	}
+	var invs struct{ Items []store.Invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices", e.Globex.Key, nil, &invs)
+	if len(invs.Items) != 0 {
+		t.Fatalf("an invoice for another org's customer was created: %+v", invs.Items)
+	}
+}
+
+// DELETE /v1/webhook-endpoints/{id} once deleted another organization's endpoint and its pending deliveries.
+func TestWebhookEndpointOfAnotherOrgIsNotFound(t *testing.T) {
+	e := apitest.New(t)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/tally", "events": []string{"*"}}, &ep)
+	e.CreateCustomer(e.Acme, "Jane", "jane@example.com") // a pending delivery to ep
+
+	sameAnswer(t, e.Do("DELETE", "/v1/webhook-endpoints/"+ep.ID, e.Globex.Key, nil), e.Do("DELETE", "/v1/webhook-endpoints/we_999999", e.Globex.Key, nil))
+	if r := e.Do("GET", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, nil); r.Code != http.StatusOK {
+		t.Fatalf("the endpoint was deleted by another org: %s", r)
+	}
+	if n, err := e.Webhooks.RunDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v; the pending delivery should survive", n, err)
+	}
+}
+
+// ?email= finds only the caller's organization's customer, even when another organization has the same address.
+func TestEmailLookupIsScopedToOrg(t *testing.T) {
+	e := apitest.New(t)
+	ja := e.CreateCustomer(e.Acme, "Jane A", "jane@example.com")
+	jg := e.CreateCustomer(e.Globex, "Jane G", "Jane@Example.com")
+
+	var page struct{ Items []store.Customer }
+	e.MustDo(http.StatusOK, "GET", "/v1/customers?email=jane@example.com", e.Acme.Key, nil, &page)
+	if len(page.Items) != 1 || page.Items[0].ID != ja.ID {
+		t.Fatalf("Acme's email lookup = %+v, want only its own customer", page.Items)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers?email=jane@example.com", e.Globex.Key, nil, &page)
+	if len(page.Items) != 1 || page.Items[0].ID != jg.ID {
+		t.Fatalf("Globex's email lookup = %+v, want only its own customer", page.Items)
+	}
+
+	// Globex deleting its customer does not hide Acme's.
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+jg.ID, e.Globex.Key, nil, nil)
+	e.MustDo(http.StatusOK, "GET", "/v1/customers?email=jane@example.com", e.Acme.Key, nil, &page)
+	if len(page.Items) != 1 || page.Items[0].ID != ja.ID {
+		t.Fatalf("after Globex's delete, Acme's lookup = %+v", page.Items)
+	}
+	// And a duplicate within Acme is still refused.
+	if r := e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane 2", "email": "jane@example.com"}); r.Code != http.StatusConflict {
+		t.Fatalf("duplicate in Acme: %s", r)
+	}
+}
