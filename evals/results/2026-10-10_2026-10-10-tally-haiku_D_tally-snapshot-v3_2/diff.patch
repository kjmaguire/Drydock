+// invoiceNumberPrefix starts every invoice number.
+const invoiceNumberPrefix = "INV-"
+
+// takeInvoiceNumber returns the organization's next invoice number and advances the sequence. The caller holds the lock.
+func (s *Store) takeInvoiceNumber(orgID string) string {
+	n := max(s.invoiceNext[orgID], 1)
+	s.invoiceNext[orgID] = n + 1
+	return fmt.Sprintf("%s%06d", invoiceNumberPrefix, n)
+}
+
+// parseInvoiceNumber returns the sequence number of an invoice number such as "INV-000042".
+func parseInvoiceNumber(number string) (int, bool) {
+	digits, ok := strings.CutPrefix(number, invoiceNumberPrefix)
+	if !ok {
+		return 0, false
+	}
+	n, err := strconv.Atoi(digits)
+	return n, err == nil && n > 0
+}
+
+// restoreInvoiceNumbers sets the organizations' next invoice numbers when a store is built from a snapshot. Each is the
+// one next in the snapshot, or after the highest number in use if that is higher. Invoices without a number (from snapshots
+// of versions 1 and 2) get the next numbers, oldest first. It runs before the store is shared.
+func (s *Store) restoreInvoiceNumbers(next map[string]int) {
+	for orgID, n := range next {
+		s.invoiceNext[orgID] = n
+	}
+	var unnumbered []Invoice
+	for _, inv := range s.invoices {
+		if n, ok := parseInvoiceNumber(inv.Number); ok {
+			if n >= s.invoiceNext[inv.OrgID] {
+				s.invoiceNext[inv.OrgID] = n + 1
+			}
+		} else {
+			unnumbered = append(unnumbered, inv)
+		}
+	}
+	sort.Slice(unnumbered, func(i, j int) bool {
+		if !unnumbered[i].CreatedAt.Equal(unnumbered[j].CreatedAt) {
+			return unnumbered[i].CreatedAt.Before(unnumbered[j].CreatedAt)
+		}
+		return unnumbered[i].ID < unnumbered[j].ID
+	})
+	for _, inv := range unnumbered {
+		inv.Number = s.takeInvoiceNumber(inv.OrgID)
+		s.invoices[inv.ID] = inv
+	}
+}
