+
+func TestInvoiceNumbers(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	ca, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Joe", "joe@example.com", t0)
+	lines := []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}
+	create := func(orgID, customerID string) Invoice {
+		t.Helper()
+		inv, err := s.CreateInvoice(Invoice{OrgID: orgID, CustomerID: customerID, Currency: money.EUR, Lines: lines, Number: "INV-999999"}, t0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return inv
+	}
+	first := create(a.ID, ca.ID)
+	second := create(a.ID, ca.ID)
+	other := create(b.ID, cb.ID)
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: cb.ID, Currency: money.EUR, Lines: lines}, t0); !errors.Is(err, ErrCustomerOrgMismatch) {
+		t.Fatalf("err = %v", err)
+	}
+	voided, err := s.UpdateInvoice(a.ID, second.ID, func(i *Invoice) error { i.Status = InvoiceVoid; return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	third := create(a.ID, ca.ID)
+	for _, c := range []struct{ got, want string }{
+		{first.Number, "INV-000001"}, {second.Number, "INV-000002"}, {other.Number, "INV-000001"},
+		{voided.Number, "INV-000002"}, {third.Number, "INV-000003"},
+	} {
+		if c.got != c.want {
+			t.Fatalf("number = %q, want %q", c.got, c.want)
+		}
+	}
+	if got, _ := s.Invoice(a.ID, third.ID); got.Number != "INV-000003" {
+		t.Fatalf("the stored number is %q", got.Number)
+	}
+}
