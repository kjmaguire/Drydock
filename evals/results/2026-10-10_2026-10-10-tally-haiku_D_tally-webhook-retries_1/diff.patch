+// mailOwners emails every owner of the organization that deliveries to the endpoint are failing. It sends at most one such
+// email per endpoint in mailEvery.
+func (s *Service) mailOwners(ctx context.Context, orgID string, ep store.WebhookEndpoint, lastErr string) {
+	if s.mail == nil {
+		return
+	}
+	now := s.clock.Now()
+	s.mu.Lock()
+	if last, ok := s.mailed[ep.ID]; ok && now.Sub(last) < mailEvery {
+		s.mu.Unlock()
+		return
+	}
+	s.mailed[ep.ID] = now
+	s.mu.Unlock()
+	body := fmt.Sprintf("Tally could not deliver an event to %s after %d attempts. The last attempt failed: %s.\n\nThe endpoint is still enabled; Tally keeps the events that are not delivered.", ep.URL, maxAttempts, lastErr)
+	for _, m := range s.store.Members(orgID) {
+		if u, ok := s.store.User(m.UserID); ok && m.Role == store.RoleOwner {
+			_ = s.mail.Send(ctx, mail.Message{To: u.Email, Subject: "Webhook endpoint failing: " + ep.URL, Body: body})
+		}
+	}
 }
 
