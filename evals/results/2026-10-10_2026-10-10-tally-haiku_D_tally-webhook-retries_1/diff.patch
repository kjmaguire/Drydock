+func TestFailingEndpointEmailedOncePerDay(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep := failingEndpoint(t, e, "https://hooks.acme.example/down", "customer.created")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return 0, errors.New("no route to host") }
+
+	// Two deliveries to the endpoint fail for good at the same time: one email, not two.
+	for range 2 {
+		if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	runSchedule(t, e)
+	for _, d := range e.Store.Deliveries(e.Acme.ID, ep.ID) {
+		if d.Status != store.DeliveryFailed || d.Attempts != 7 {
+			t.Fatalf("delivery = %+v", d)
+		}
+	}
+	msgs := e.Mail.Messages()
+	if len(msgs) != 1 || msgs[0].To != "owner@acme.example" || msgs[0].Subject != "Webhook endpoint failing: "+ep.URL {
+		t.Fatalf("emails = %+v, want one to the owner", msgs)
+	}
+
+	// Another endpoint failing for good is emailed too: the limit is per endpoint.
+	other := failingEndpoint(t, e, "https://hooks.acme.example/other", "invoice.paid")
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "invoice.paid", map[string]string{}); err != nil {
+		t.Fatal(err)
+	}
+	runSchedule(t, e)
+	if got := e.Store.Deliveries(e.Acme.ID, other.ID)[0]; got.Status != store.DeliveryFailed {
+		t.Fatalf("other endpoint's delivery = %+v", got)
+	}
+	if n := len(e.Mail.Messages()); n != 2 {
+		t.Fatalf("emails = %d, want 2 (one per endpoint)", n)
+	}
+
+	// A day later the first endpoint fails for good again: it is emailed again.
+	e.Clock.Advance(48 * time.Hour)
