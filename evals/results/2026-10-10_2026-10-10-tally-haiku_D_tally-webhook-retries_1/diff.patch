+// runSchedule advances the clock through the retry schedule, running the due deliveries at each step, and returns how many
+// attempts were made.
+func runSchedule(t *testing.T, e *apitest.Env) int {
+	t.Helper()
+	total := 0
+	for _, wait := range []time.Duration{0, time.Minute, 5 * time.Minute, 30 * time.Minute, 2 * time.Hour, 8 * time.Hour, 24 * time.Hour} {
+		e.Clock.Advance(wait)
+		n, err := e.Webhooks.RunDue(context.Background())
+		if err != nil {
+			t.Fatal(err)
+		}
+		total += n
+	}
+	return total
+}
