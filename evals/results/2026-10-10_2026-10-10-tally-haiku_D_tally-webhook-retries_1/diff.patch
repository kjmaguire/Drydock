+func TestRetrySchedule(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep := failingEndpoint(t, e, "https://hooks.acme.example/retry", "*")
+	e.HTTP.Respond = func(apitest.Request) (int, error) { return http.StatusServiceUnavailable, nil }
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"}); err != nil {
+		t.Fatal(err)
+	}
+	waits := []time.Duration{time.Minute, 5 * time.Minute, 30 * time.Minute, 2 * time.Hour, 8 * time.Hour, 24 * time.Hour}
+	for i := 1; i <= 7; i++ {
+		if n, _ := e.Webhooks.RunDue(ctx); n != 1 {
+			t.Fatalf("attempt %d: RunDue = %d, want 1", i, n)
+		}
+		d := e.Store.Deliveries(e.Acme.ID, ep.ID)[0]
+		if d.Attempts != i || d.LastAttemptAt == nil || !d.LastAttemptAt.Equal(e.Clock.Now()) {
+			t.Fatalf("after attempt %d: %+v", i, d)
+		}
+		if i == 7 {
+			if d.Status != store.DeliveryFailed || d.NextAttemptAt != nil {
+				t.Fatalf("after the last attempt: %+v", d)
+			}
+			break
+		}
+		if d.Status != store.DeliveryPending || d.NextAttemptAt == nil || !d.NextAttemptAt.Equal(e.Clock.Now().Add(waits[i-1])) {
+			t.Fatalf("after attempt %d: want pending, retry in %v: %+v", i, waits[i-1], d)
+		}
+		if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+			t.Fatalf("attempt %d retried early", i)
+		}
+		e.Clock.Advance(waits[i-1])
+	}
+	if got := len(e.HTTP.Requests()); got != 7 {
+		t.Fatalf("requests = %d, want 7", got)
+	}
+	e.Clock.Advance(48 * time.Hour)
+	if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+		t.Fatalf("a failed delivery was sent after its last attempt: %d", n)
+	}
+}
+
+func TestRetryRecovers(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep := failingEndpoint(t, e, "https://hooks.acme.example/flaky", "*")
+	answers := []struct {
+		status int
+		err    error
+	}{{http.StatusFound, nil}, {0, errors.New("connection reset")}, {http.StatusNoContent, nil}}
+	e.HTTP.Respond = func(apitest.Request) (int, error) {
+		a := answers[0]
+		answers = answers[1:]
+		return a.status, a.err
+	}
+	if err := e.Webhooks.Publish(ctx, e.Acme.ID, "invoice.paid", map[string]string{"invoice_id": "in_1"}); err != nil {
+		t.Fatal(err)
+	}
+	// A redirect is a failure: the attempts come 1 and then 5 minutes after the failed one before.
+	waits := []time.Duration{0, time.Minute, 5 * time.Minute}
+	for i, want := range []string{"the endpoint answered 302", "connection reset", ""} {
+		e.Clock.Advance(waits[i])
+		if n, _ := e.Webhooks.RunDue(ctx); n != 1 {
+			t.Fatalf("attempt %d: RunDue = %d", i+1, n)
+		}
+		d := e.Store.Deliveries(e.Acme.ID, ep.ID)[0]
+		if d.Error != want {
+			t.Fatalf("attempt %d: error %q, want %q", i+1, d.Error, want)
+		}
+	}
+	d := e.Store.Deliveries(e.Acme.ID, ep.ID)[0]
+	if d.Status != store.DeliverySucceeded || d.Attempts != 3 || d.NextAttemptAt != nil || d.ResponseStatus != http.StatusNoContent {
+		t.Fatalf("delivery = %+v", d)
+	}
+	if n := runSchedule(t, e); n != 0 {
+		t.Fatalf("a succeeded delivery was sent again: %d", n)
+	}
+}
