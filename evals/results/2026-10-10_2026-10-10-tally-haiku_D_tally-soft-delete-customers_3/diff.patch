+		t.Fatalf("list = %+v", page.Items)
+	}
+	for _, q := range []string{"?q=jane", "?email=JANE@example.com"} {
+		page.Items = nil
+		e.MustDo(http.StatusOK, "GET", "/v1/customers"+q, e.Acme.Key, nil, &page)
+		if len(page.Items) != 0 {
+			t.Fatalf("GET /v1/customers%s = %+v", q, page.Items)
+		}
+	}
+	r := e.MustDo(http.StatusOK, "GET", "/v1/customers/export.csv", e.Acme.Key, nil, nil)
+	if rows, err := csv.NewReader(strings.NewReader(string(r.Body))).ReadAll(); err != nil || len(rows) != 2 || rows[1][0] != john.ID {
+		t.Fatalf("csv = %v, %v", rows, err)
+	}
+	var events struct {
+		Items []store.Event `json:"items"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/events?type=customer.deleted", e.Acme.Key, nil, &events)
+	if len(events.Items) != 1 {
+		t.Fatalf("customer.deleted events = %+v", events.Items)
+	}
+
+	// Its invoice still shows it, marked deleted.
+	type invoice struct {
+		ID       string `json:"id"`
+		Customer *struct {
+			ID, Name, Email string
+			Deleted         bool
+		} `json:"customer"`
+	}
+	var invs struct{ Items []invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?customer_id="+jane.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 1 || invs.Items[0].Customer == nil || invs.Items[0].Customer.Name != "Jane" || !invs.Items[0].Customer.Deleted {
+		t.Fatalf("invoices of a deleted customer = %+v", invs)
+	}
+
+	// The address is free: a new customer takes it, so restoring the old one is refused until that one is deleted.
+	again := e.CreateCustomer(e.Acme, "Jane Again", "jane@example.com")
+	if r := e.Do("POST", "/v1/customers/"+jane.ID+"/restore", e.Acme.Key, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "email_taken" {
