+		{"GET", "/v1/customers/" + jane.ID, nil},
+		{"PATCH", "/v1/customers/" + jane.ID, map[string]string{"name": "Changed"}},
+		{"DELETE", "/v1/customers/" + jane.ID, nil},
+		{"POST", "/v1/invoices", map[string]any{"customer_id": jane.ID, "currency": "USD", "lines": []map[string]any{{"description": "x", "quantity": 1, "unit_amount": 100}}}},
+		{"POST", "/v1/subscriptions", map[string]any{"customer_id": jane.ID, "plan_id": p.ID}},
+	}
+	for _, g := range gone {
+		if r := e.Do(g.method, g.path, e.Acme.Key, g.body); r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+			t.Fatalf("%s %s: %s", g.method, g.path, r)
