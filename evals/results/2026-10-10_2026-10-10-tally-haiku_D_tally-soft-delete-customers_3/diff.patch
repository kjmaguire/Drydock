+		t.Fatalf("delete with an active subscription: %s", r)
+	}
+	e.MustDo(http.StatusOK, "POST", "/v1/subscriptions/"+sub.ID+"/cancel", e.Acme.Key, nil, nil)
+
+	e.Clock.Advance(time.Minute)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+jane.ID, e.Acme.Key, nil, nil)
+	gone := []struct {
+		method, path string
+		body         any
