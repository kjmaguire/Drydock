+// SoftDeleteCustomer marks a customer deleted at now. It is then hidden and its email address is free, but its invoices
+// and payments stay, and RestoreCustomer can undo the deletion for 30 days. A customer with a subscription that is not
+// canceled cannot be deleted.
+func (s *Store) SoftDeleteCustomer(orgID, id string, now time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt != nil {
+		return ErrNotFound
+	}
+	for _, sub := range s.subs {
+		if sub.OrgID == orgID && sub.CustomerID == id && sub.Status != Canceled {
+			return ErrHasActiveSubscriptions
+		}
+	}
+	at := now.UTC()
+	c.DeletedAt = &at
+	s.customers[id] = c
+	if s.customersByEmail[emailKey(orgID, c.Email)] == id {
+		delete(s.customersByEmail, emailKey(orgID, c.Email))
+	}
+	return nil
+}
+
+// RestoreCustomer undoes SoftDeleteCustomer, if it was no more than 30 days before now. It is ErrNotFound when the customer
+// is not deleted or was deleted longer ago, and ErrEmailTaken when another customer now has its email address.
+func (s *Store) RestoreCustomer(orgID, id string, now time.Time) (Customer, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.customers[id]
+	if !ok || c.OrgID != orgID || c.DeletedAt == nil || now.Sub(*c.DeletedAt) > customerRetention {
+		return Customer{}, ErrNotFound
+	}
+	key := emailKey(orgID, c.Email)
+	if _, ok := s.customersByEmail[key]; ok {
+		return Customer{}, ErrEmailTaken
+	}
+	c.DeletedAt = nil
+	s.customers[id] = c
+	s.customersByEmail[key] = id
+	return copyCustomer(c), nil
+}
+
+// PurgeDeletedCustomers removes, for good, the customers deleted more than 30 days before now, and returns how many it
+// removed. Their invoices and payments stay, but show no customer.
+func (s *Store) PurgeDeletedCustomers(now time.Time) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n := 0
+	for id, c := range s.customers {
+		if c.DeletedAt != nil && now.Sub(*c.DeletedAt) > customerRetention {
+			delete(s.customers, id)
+			n++
+		}
+	}
+	return n
+}
