+	e.MustDo(http.StatusOK, "GET", "/v1/invoices?customer_id="+jane.ID, e.Acme.Key, nil, &invs)
+	if len(invs.Items) != 1 || invs.Items[0].Customer != nil {
+		t.Fatalf("invoices of a purged customer = %+v", invs)
