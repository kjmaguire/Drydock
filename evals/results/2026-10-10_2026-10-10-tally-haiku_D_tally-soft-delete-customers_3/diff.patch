+func TestSoftDeleteCustomer(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	b := newOrg(t, s, "B")
+	jane, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	john, _ := s.CreateCustomer(a.ID, "John", "john@example.com", t0)
+	janeB, _ := s.CreateCustomer(b.ID, "Jane B", "jane@example.com", t0)
+	if got, ok := s.FindCustomerByEmail(b.ID, "JANE@example.com"); !ok || got.ID != janeB.ID {
+		t.Fatalf("the same address in another organization = %+v, %v", got, ok)
+	}
+	p, _ := s.CreatePlan(Plan{OrgID: a.ID, Name: "Pro", Currency: money.USD, UnitAmount: 2000, Interval: Monthly}, t0)
+	sub, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: jane.ID, PlanID: p.ID, Quantity: 1, Status: Active,
+		StartedAt: t0, CurrentPeriodStart: t0, CurrentPeriodEnd: t0.AddDate(0, 1, 0)}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inv, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: jane.ID, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}, t0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, t0); !errors.Is(err, ErrHasActiveSubscriptions) {
+		t.Fatalf("delete with an active subscription: %v", err)
+	}
+	if _, err := s.UpdateSubscription(a.ID, sub.ID, func(x *Subscription) error { x.Status = Canceled; return nil }); err != nil {
+		t.Fatal(err)
+	}
+
+	later := t0.Add(time.Hour)
+	if err := s.SoftDeleteCustomer(b.ID, jane.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleted through another org: %v", err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, later); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("deleted twice: %v", err)
+	}
+	if _, ok := s.Customer(a.ID, jane.ID); ok {
+		t.Fatal("deleted customer still visible")
+	}
+	if _, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); ok {
+		t.Fatal("deleted customer's email still found")
+	}
+	if got := s.Customers(a.ID); len(got) != 1 || got[0].ID != john.ID {
+		t.Fatalf("Customers = %+v", got)
+	}
+	if got := s.SearchCustomers(a.ID, "jane"); len(got) != 0 {
+		t.Fatalf("SearchCustomers = %+v", got)
+	}
+	if got := s.CustomersIncludingDeleted(a.ID); len(got) != 2 {
+		t.Fatalf("CustomersIncludingDeleted = %+v", got)
+	}
+	if _, err := s.UpdateCustomer(a.ID, jane.ID, func(c *Customer) error { c.Name = "Changed"; return nil }); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("update a deleted customer: %v", err)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: jane.ID, Currency: money.USD, Lines: []Line{{Description: "y", Quantity: 1, UnitAmount: 100}}}, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("invoice for a deleted customer: %v", err)
+	}
+	if _, err := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: jane.ID, PlanID: p.ID, Quantity: 1, Status: Active}, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("subscription for a deleted customer: %v", err)
+	}
+	if got, ok := s.CustomerIncludingDeleted(a.ID, jane.ID); !ok || got.DeletedAt == nil || !got.DeletedAt.Equal(later) {
+		t.Fatalf("CustomerIncludingDeleted = %+v, %v", got, ok)
+	}
+	if _, ok := s.Invoice(a.ID, inv.ID); !ok {
+		t.Fatal("the deleted customer's invoice is gone")
+	}
+
+	// The address is free: a new customer takes it, so restoring the old one is refused.
+	jane2, err := s.CreateCustomer(a.ID, "Jane 2", "jane@example.com", later)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, jane.ID, later); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("restore with the address taken: %v", err)
+	}
+	if err := s.SoftDeleteCustomer(a.ID, jane2.ID, later); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := s.RestoreCustomer(a.ID, jane.ID, later.Add(customerRetention))
+	if err != nil || restored.DeletedAt != nil {
+		t.Fatalf("restore at 30 days = %+v, %v", restored, err)
+	}
+	if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != jane.ID {
+		t.Fatalf("after restore, FindCustomerByEmail = %+v, %v", got, ok)
+	}
+	if _, err := s.RestoreCustomer(a.ID, jane2.ID, later); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("restore the other customer with the address taken: %v", err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, jane.ID, later); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore a customer that is not deleted: %v", err)
+	}
+
+	// Purging keeps customers deleted 30 days ago or less, and removes the rest.
+	if err := s.SoftDeleteCustomer(a.ID, john.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if n := s.PurgeDeletedCustomers(t0.Add(customerRetention)); n != 0 {
+		t.Fatalf("purged %d customers at 30 days", n)
+	}
+	if _, err := s.RestoreCustomer(a.ID, john.ID, t0.Add(customerRetention+time.Second)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore after 30 days: %v", err)
+	}
+	if n := s.PurgeDeletedCustomers(t0.Add(customerRetention + time.Second)); n != 1 {
+		t.Fatalf("purged %d customers, want 1", n)
+	}
+	if _, ok := s.CustomerIncludingDeleted(a.ID, john.ID); ok {
+		t.Fatal("purged customer still there")
+	}
+	if got, ok := s.Invoice(a.ID, inv.ID); !ok || got.CustomerID != jane.ID {
+		t.Fatalf("invoice after purge = %+v, %v", got, ok)
+	}
+}
