+func TestTieredMeteredBillsOneLine(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	_, _ = e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = "pm_card_visa"; return nil })
+	upTo := int64(100)
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, Interval: store.Monthly, UsageType: store.Metered,
+		TiersMode: store.Volume, Tiers: []store.Tier{{UpTo: &upTo, UnitAmount: 2}, {UnitAmount: 1, FlatAmount: 100}}}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// 150 units fall in the last tier (volume): 150 at 1 plus its flat amount of 100.
+	if _, err := e.Store.AddUsage(e.Acme.ID, sub.ID, 150, sub.CurrentPeriodStart, e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 1 || len(invs[0].Lines) != 1 {
+		t.Fatalf("invoices = %+v, want one invoice with one line", invs)
+	}
+	line := invs[0].Lines[0]
+	if line.Quantity != 1 || line.UnitAmount != 250 || !strings.HasPrefix(line.Description, "API calls") || invs[0].Status != store.InvoicePaid {
+		t.Fatalf("line = %+v, invoice = %+v", line, invs[0])
+	}
+
+	// The next period has no usage: no invoice.
+	renewed, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	e.Clock.Set(renewed.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 1 {
+		t.Fatalf("a period without usage was invoiced: %+v", invs)
+	}
