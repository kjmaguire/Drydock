@@ -37,3 +37,33 @@ func AddInterval(t time.Time, iv store.Interval) time.Time {
 	}
 	return t.AddDate(0, 1, 0)
 }
+
+// TieredAmount returns what quantity units cost on a tiered plan, in minor units. Graduated: each unit is priced at the tier
+// it falls in, and every tier that at least one unit falls in adds its flat amount. Volume: every unit is priced at the tier
+// the quantity falls in, and that tier's flat amount is added once. A tier's UpTo is inclusive, and a quantity of 0 costs 0.
+func TieredAmount(tiers []store.Tier, mode store.TiersMode, quantity int64) int64 {
+	if quantity <= 0 {
+		return 0
+	}
+	var total, floor int64 // floor: the last unit the previous tiers cover
+	for _, t := range tiers {
+		if mode == store.Volume {
+			if t.UpTo == nil || quantity <= *t.UpTo {
+				return quantity*t.UnitAmount + t.FlatAmount
+			}
+			continue
+		}
+		units := quantity - floor
+		if t.UpTo != nil && *t.UpTo-floor < units {
+			units = *t.UpTo - floor
+		}
+		if units > 0 {
+			total += units*t.UnitAmount + t.FlatAmount
+		}
+		if t.UpTo == nil || quantity <= *t.UpTo {
+			break
+		}
+		floor = *t.UpTo
+	}
+	return total
+}
