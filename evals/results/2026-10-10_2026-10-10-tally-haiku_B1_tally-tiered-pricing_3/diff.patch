+// checkTiers checks a tiered plan: a metered plan with a mode and tiers, sorted by UpTo, with only the last tier unlimited.
+func checkTiers(p Plan) error {
+	tierErr := func(msg string) error { return fmt.Errorf("%w: %s", ErrInvalidTiers, msg) }
+	switch {
+	case p.UsageType != Metered:
+		return tierErr("only a metered plan can have tiers")
+	case !p.TiersMode.Valid():
+		return tierErr("tiers_mode is graduated or volume")
+	case len(p.Tiers) == 0:
+		return tierErr("a tiered plan needs at least one tier")
+	}
+	var prev int64
+	for i, t := range p.Tiers {
+		last := i == len(p.Tiers)-1
+		switch {
+		case t.UnitAmount < 0 || t.FlatAmount < 0:
+			return tierErr("a tier's amounts cannot be negative")
+		case last && t.UpTo != nil:
+			return tierErr("the last tier has no up_to")
+		case !last && t.UpTo == nil:
+			return tierErr("only the last tier has no up_to")
+		case t.UpTo != nil && *t.UpTo <= 0:
+			return tierErr("up_to is a positive whole number")
+		case t.UpTo != nil && *t.UpTo <= prev:
+			return tierErr("the tiers' up_to values must strictly ascend")
+		}
+		if t.UpTo != nil {
+			prev = *t.UpTo
+		}
+	}
 	return nil
 }
 
