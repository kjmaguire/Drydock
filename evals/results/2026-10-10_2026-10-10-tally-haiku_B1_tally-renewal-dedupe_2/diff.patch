+func TestFailingRenewalDoesNotStopTheOthers(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	now := e.Clock.Now()
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	// This subscription's customer belongs to Globex, so its renewal invoice cannot be created.
+	stranger := e.CreateCustomer(e.Globex, "Sam", "sam@example.com")
+	bad, err := e.Store.CreateSubscription(store.Subscription{OrgID: e.Acme.ID, CustomerID: stranger.ID, PlanID: p.ID, Quantity: 1,
+		Status: store.Active, StartedAt: now, CurrentPeriodStart: now, CurrentPeriodEnd: now.AddDate(0, 1, 0)}, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	good := subscribe(t, e, "jane@example.com", "pm_card_visa")
+	e.Clock.Set(good.CurrentPeriodEnd)
+
+	n, err := e.Subs.RenewDue(ctx)
+	if !errors.Is(err, store.ErrCustomerOrgMismatch) || n != 1 {
+		t.Fatalf("RenewDue = %d, %v; want 1 renewal and the failure", n, err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: good.ID}); len(invs) != 2 || invs[1].Status != store.InvoicePaid {
+		t.Fatalf("the other subscription's invoices = %+v", invs)
+	}
+	// The failed renewal gave its period back, so the next run tries it again.
+	if got, _ := e.Store.Subscription(e.Acme.ID, bad.ID); !got.CurrentPeriodEnd.Equal(bad.CurrentPeriodEnd) {
+		t.Fatalf("the failed subscription moved on: %+v", got)
+	}
