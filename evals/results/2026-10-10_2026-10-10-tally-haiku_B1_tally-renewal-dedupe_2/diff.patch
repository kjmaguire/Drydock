+// subscribe starts a monthly team subscription for a new customer of Acme, charged to the card pm at the start, and
+// returns it.
+func subscribe(t *testing.T, e *apitest.Env, email, pm string) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", email)
+	setCard(t, e, c.ID, pm)
+	p := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sub
+}
+
+// setCard makes pm the customer's default payment method.
