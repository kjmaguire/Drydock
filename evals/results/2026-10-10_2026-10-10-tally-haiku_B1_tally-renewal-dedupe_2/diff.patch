+func TestGatewayDownStillMovesThePeriodOn(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	sub := subscribe(t, e, "jane@example.com", "pm_card_visa")
+	setCard(t, e, sub.CustomerID, "pm_gateway_down")
+	e.Clock.Set(sub.CurrentPeriodEnd)
+
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(e.Clock.Now()) || !got.CurrentPeriodEnd.Equal(e.Clock.Now().AddDate(0, 1, 0)) {
+		t.Fatalf("after the outage = %+v", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoiceOpen {
+		t.Fatalf("invoices = %+v, want the renewal open", invs)
+	}
+
+	// The period is not invoiced again, and the open invoice is not charged by RenewDue.
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 0 {
+		t.Fatalf("RenewDue again = %d, %v", n, err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 {
+		t.Fatalf("invoices = %d after a repeated run, want 2", len(invs))
+	}
+
+	// The next period is invoiced as usual once the gateway is back.
+	setCard(t, e, sub.CustomerID, "pm_card_visa")
+	e.Clock.Set(got.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue next period = %d, %v", n, err)
+	}
+	invs = e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 3 || invs[1].Status != store.InvoiceOpen || invs[2].Status != store.InvoicePaid {
+		t.Fatalf("invoices = %+v", invs)
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2 {
+		t.Fatalf("charges = %d, want 2", len(cs))
+	}
+}
