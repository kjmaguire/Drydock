+func TestConcurrentRenewDueInvoicesEachPeriodOnce(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	var subs []store.Subscription
+	for i := range 3 {
+		subs = append(subs, subscribe(t, e, fmt.Sprintf("jane%d@example.com", i), "pm_card_visa"))
+	}
+	e.Clock.Set(subs[0].CurrentPeriodEnd)
+
+	// Eight runs at once, as two server instances and their retries would make them.
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	total := 0
+	var errs []error
+	for range 8 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			n, err := e.Subs.RenewDue(ctx)
+			mu.Lock()
+			defer mu.Unlock()
+			total += n
+			if err != nil {
+				errs = append(errs, err)
+			}
+		}()
+	}
+	wg.Wait()
+	if len(errs) != 0 || total != len(subs) {
+		t.Fatalf("renewed %d subscriptions, want %d; errors: %v", total, len(subs), errs)
+	}
+	for _, sub := range subs {
+		invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+		if len(invs) != 2 || invs[1].Status != store.InvoicePaid || !invs[1].PeriodStart.Equal(e.Clock.Now()) {
+			t.Fatalf("invoices of %s = %+v, want the first and one renewal", sub.ID, invs)
+		}
+	}
+	if cs := e.Gateway.Charges(); len(cs) != 2*len(subs) {
+		t.Fatalf("charges = %d, want %d (one per invoice)", len(cs), 2*len(subs))
+	}
+}
