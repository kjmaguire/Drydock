+func TestConcurrentInvitesTakeOneSeat(t *testing.T) {
+	e := apitest.New(t)
+	for i := range 8 {
+		e.AddMember(e.Acme, fmt.Sprintf("m%d@acme.example", i), store.RoleMember)
+	}
+	codes := make(chan int, 10)
+	var wg sync.WaitGroup
+	for i := range 10 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			req := httptest.NewRequest("POST", "/v1/invites", strings.NewReader(fmt.Sprintf(`{"email":"r%d@people.example","role":"member"}`, i)))
+			req.Header.Set("Authorization", "Bearer "+e.Acme.Key)
+			rec := httptest.NewRecorder()
+			e.Server.ServeHTTP(rec, req)
+			codes <- rec.Code
+		}()
+	}
+	wg.Wait()
+	close(codes)
+	created := 0
+	for c := range codes {
+		if c == http.StatusCreated {
+			created++
+		}
+	}
+	if created != 1 {
+		t.Fatalf("%d invites took the last seat", created)
+	}
+}
