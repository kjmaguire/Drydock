+		t.Fatalf("an invite over the limit: %v", err)
+	}
+	if _, _, _, err := s.AcceptInvite(inv.Token, "X", t0); err != nil {
+		t.Fatalf("accepting an invite at the limit: %v", err)
+	}
+	var over *OverSeatLimitError
