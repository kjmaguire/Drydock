+// SeatsUsed returns how many of its plan's seats an organization uses: its members and its pending invites (neither
+// accepted nor revoked) whose role is not viewer. Viewers are free.
+func (s *Store) SeatsUsed(orgID string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
