+	if _, err := s.UpdateOrg(o.ID, func(o *Org) error { o.Plan = OrgTeam; o.Name = "B"; return nil }); !errors.As(err, &over) || over.Limit != 10 || over.Used != 11 {
+		t.Fatalf("a downgrade over the limit: %v", err)
+	}
+	if got, _ := s.Org(o.ID); got.Plan != OrgBusiness || got.Name != "A" {
