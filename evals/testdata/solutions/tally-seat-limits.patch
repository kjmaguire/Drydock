+	if o.Plan != store.OrgTeam || o.Name != "Acme" {
+		t.Fatalf("a refused downgrade changed the org: %+v", o)
+	}
+	var g struct{ Seats map[string]any }
+	e.MustDo(http.StatusOK, "GET", "/v1/org", e.Globex.Key, nil, &g)
+	if v, ok := g.Seats["limit"]; !ok || v != nil || g.Seats["used"] != 1.0 {
+		t.Fatalf("business seats = %v", g.Seats)
+	}
+}
