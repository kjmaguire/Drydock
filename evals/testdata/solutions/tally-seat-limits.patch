+		e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": email, "role": "member"}, nil)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", free.Key, nil, &org)
+	if org.Seats.Used != 3 || org.Seats.Limit == nil || *org.Seats.Limit != 3 {
+		t.Fatalf("seats = %+v", org.Seats)
+	}
+	r := e.Do("POST", "/v1/invites", free.Key, map[string]string{"email": "c@people.example", "role": "admin"})
+	if m := r.Map(t); r.Code != http.StatusPaymentRequired || m["error"] != "seat_limit_reached" || m["limit"] != 3.0 || m["used"] != 3.0 {
+		t.Fatalf("invite over the limit: %s", r)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", free.Key, map[string]string{"email": "v@people.example", "role": "viewer"}, nil)
+	if r := e.Do("PATCH", "/v1/members/"+viewer.ID, free.Key, map[string]string{"role": "member"}); r.Code != http.StatusPaymentRequired {
+		t.Fatalf("promote a viewer without a free seat: %s", r)
+	}
+	msgs := e.Mail.Messages()
+	token, _ := url.QueryUnescape(regexp.MustCompile(`token=([^\s]+)`).FindStringSubmatch(msgs[0].Body)[1])
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "A"}, nil)
+
+	e.AddMember(e.Acme, "m1@acme.example", store.RoleMember)
+	e.AddMember(e.Acme, "m2@acme.example", store.RoleMember)
+	e.AddMember(e.Acme, "m3@acme.example", store.RoleMember)
+	r = e.Do("PATCH", "/v1/org", e.Acme.Key, map[string]any{"plan": "free", "name": "Renamed"})
+	if m := r.Map(t); r.Code != http.StatusConflict || m["error"] != "over_seat_limit" || m["limit"] != 3.0 || m["used"] != 4.0 {
+		t.Fatalf("downgrade below the seats used: %s", r)
+	}
+	var o store.Org
