+func TestSeatLimits(t *testing.T) {
+	e := apitest.New(t)
+	free := e.NewOrg("Initech", store.OrgFree, "UTC")
+	viewer, _ := e.AddMember(free, "viewer@initech.example", store.RoleViewer)
