+}
+
+func (s *Store) seatsUsed(orgID string) int {
+	n := 0
+	for _, m := range s.members {
+		if m.OrgID == orgID && m.Role != RoleViewer {
+			n++
+		}
+	}
+	for _, inv := range s.invites {
+		if inv.OrgID == orgID && inv.AcceptedAt == nil && inv.RevokedAt == nil && inv.Role != RoleViewer {
+			n++
+		}
+	}
+	return n
+}
+
+// takeSeat returns an *SeatLimitError when the organization has no seat free. The caller holds the lock, so the seat stays
+// free until the caller's change is stored.
+func (s *Store) takeSeat(orgID string) error {
+	limit, limited := s.orgs[orgID].Plan.SeatLimit()
+	if !limited {
+		return nil
+	}
+	if used := s.seatsUsed(orgID); used >= limit {
+		return &SeatLimitError{Limit: limit, Used: used}
+	}
+	return nil
+}
