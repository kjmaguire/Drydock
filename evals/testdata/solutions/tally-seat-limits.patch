+func TestSeats(t *testing.T) {
+	s := New()
+	o, _ := s.CreateOrg("A", OrgFree, "UTC", 0, t0)
+	for i, role := range []Role{RoleOwner, RoleViewer, RoleMember} {
+		u, _ := s.CreateUser(string(rune('a'+i))+"@example.com", "U", t0)
+		_, _ = s.AddMember(o.ID, u.ID, role, t0)
+	}
+	if _, err := s.CreateInvite(o.ID, "v@example.com", RoleViewer, "", t0); err != nil {
+		t.Fatal(err)
+	}
+	inv, err := s.CreateInvite(o.ID, "x@example.com", RoleBilling, "", t0)
+	if err != nil || s.SeatsUsed(o.ID) != 3 {
