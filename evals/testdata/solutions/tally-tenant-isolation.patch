+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.FindCustomerByEmail(b.ID, "jane@example.com"); ok {
+		t.Fatal("B finds A's customer by email")
+	}
+	cb, err := s.CreateCustomer(b.ID, "Jane B", "JANE@example.com", t0)
+	if err != nil {
+		t.Fatalf("B cannot use an address A uses: %v", err)
+	}
+	check := func(s *Store) {
+		t.Helper()
+		if got, ok := s.FindCustomerByEmail(a.ID, "jane@example.com"); !ok || got.ID != ca.ID {
+			t.Fatalf("A finds %+v %v, want %s", got, ok, ca.ID)
+		}
+		if got, ok := s.FindCustomerByEmail(b.ID, "Jane@Example.com"); !ok || got.ID != cb.ID {
+			t.Fatalf("B finds %+v %v, want %s", got, ok, cb.ID)
+		}
+	}
+	check(s)
+	if _, err := s.CreateCustomer(a.ID, "Jane 2", "jane@example.com", t0); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("a duplicate in A: %v", err)
+	}
+	reloaded, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	check(reloaded)
