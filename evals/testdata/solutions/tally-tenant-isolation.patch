diff --git a/internal/api/isolation_test.go b/internal/api/isolation_test.go
new file mode 100644
index 0000000..0947944
--- /dev/null
+++ b/internal/api/isolation_test.go
@@ -0,0 +1,196 @@
+package api_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+// sameAnswer fails unless two answers are the same once the IDs they name are left out: another organization's ID must be
+// answered exactly like an ID that does not exist.
+func sameAnswer(t *testing.T, what string, other, unknown *apitest.Response, otherID, unknownID string) {
+	t.Helper()
+	a := bytes.ReplaceAll(other.Body, []byte(otherID), []byte("ID"))
+	b := bytes.ReplaceAll(unknown.Body, []byte(unknownID), []byte("ID"))
+	if other.Code != unknown.Code || !bytes.Equal(a, b) {
+		t.Fatalf("%s: another organization's ID got %s, an unknown ID got %s", what, other, unknown)
+	}
+}
+
+func TestInvoiceLinesOfAnotherOrg(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	var inv struct{ ID string }
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Secret consulting", "quantity": 1, "unit_amount": 900}}}, &inv)
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID+"/lines", e.Acme.Key, nil, nil)
+
+	other := e.Do("GET", "/v1/invoices/"+inv.ID+"/lines", e.Globex.Key, nil)
+	if other.Code != http.StatusNotFound || other.Map(t)["error"] != "not_found" {
+		t.Fatalf("another organization's invoice lines: %s", other)
+	}
+	sameAnswer(t, "invoice lines", other, e.Do("GET", "/v1/invoices/in_999999/lines", e.Globex.Key, nil), inv.ID, "in_999999")
+}
+
+func TestBodyIDsOfAnotherOrg(t *testing.T) {
+	e := apitest.New(t)
+	acmeCustomer := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	globexPlan := e.CreatePlan(e.Globex, "Team", "EUR", "10.00")
+
+	sub := func(customerID string) *apitest.Response {
+		return e.Do("POST", "/v1/subscriptions", e.Globex.Key, map[string]any{"customer_id": customerID, "plan_id": globexPlan.ID})
+	}
+	sameAnswer(t, "subscription for another organization's customer", sub(acmeCustomer.ID), sub("cus_999999"), acmeCustomer.ID, "cus_999999")
+
+	invoice := func(customerID string) *apitest.Response {
+		return e.Do("POST", "/v1/invoices", e.Globex.Key, map[string]any{"customer_id": customerID, "currency": "EUR",
+			"lines": []map[string]any{{"description": "x", "quantity": 1, "unit_amount": 100}}})
+	}
+	r := invoice(acmeCustomer.ID)
+	if r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("invoice for another organization's customer: %s", r)
+	}
+	sameAnswer(t, "invoice for another organization's customer", r, invoice("cus_999999"), acmeCustomer.ID, "cus_999999")
+
+	if subs := e.Store.Subscriptions(e.Globex.ID, store.SubscriptionFilter{}); len(subs) != 0 {
+		t.Fatalf("subscriptions were created: %+v", subs)
+	}
+	for _, org := range []string{e.Acme.ID, e.Globex.ID} {
+		if invs := e.Store.ListInvoices(org, store.InvoiceFilter{}); len(invs) != 0 {
+			t.Fatalf("invoices were created: %+v", invs)
+		}
+	}
+}
+
+func TestCustomerEmailsArePerOrg(t *testing.T) {
+	e := apitest.New(t)
+	find := func(org apitest.Org, email string) []store.Customer {
+		t.Helper()
+		var page struct{ Items []store.Customer }
+		e.MustDo(http.StatusOK, "GET", "/v1/customers?email="+email, org.Key, nil, &page)
+		return page.Items
+	}
+	jane := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	if got := find(e.Globex, "jane@example.com"); len(got) != 0 {
+		t.Fatalf("Globex finds Acme's customer: %+v", got)
+	}
+	globexJane := e.CreateCustomer(e.Globex, "Jane at Globex", "JANE@example.com")
+	if got := find(e.Acme, "jane@example.com"); len(got) != 1 || got[0].ID != jane.ID {
+		t.Fatalf("Acme's lookup = %+v, want only %s", got, jane.ID)
+	}
+	if got := find(e.Globex, "jane@example.com"); len(got) != 1 || got[0].ID != globexJane.ID {
+		t.Fatalf("Globex's lookup = %+v, want only %s", got, globexJane.ID)
+	}
+	if r := e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane again", "email": "jane@example.com"}); r.Code != http.StatusConflict {
+		t.Fatalf("a duplicate in Acme after Globex used the address: %s", r)
+	}
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+globexJane.ID, e.Globex.Key, map[string]string{"email": "jane.g@example.com"}, nil)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/customers/"+globexJane.ID, e.Globex.Key, nil, nil)
+	if got := find(e.Acme, "jane@example.com"); len(got) != 1 || got[0].ID != jane.ID {
+		t.Fatalf("Acme's lookup after Globex's changes = %+v", got)
+	}
+	if r := e.Do("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane again", "email": "Jane@Example.com"}); r.Code != http.StatusConflict {
+		t.Fatalf("a duplicate in Acme after Globex's changes: %s", r)
+	}
+}
+
+func TestDeleteAnotherOrgsEndpoint(t *testing.T) {
+	e := apitest.New(t)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/in", "events": []string{"*"}}, &ep)
+	e.CreateCustomer(e.Acme, "Jane", "jane@example.com") // a pending delivery
+	r := e.Do("DELETE", "/v1/webhook-endpoints/"+ep.ID, e.Globex.Key, nil)
+	if r.Code != http.StatusNotFound || r.Map(t)["error"] != "not_found" {
+		t.Fatalf("delete another organization's endpoint: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, nil, nil)
+	if n, err := e.Webhooks.RunDue(context.Background()); err != nil || n != 1 {
+		t.Fatalf("the pending delivery is gone: RunDue = %d, %v", n, err)
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/webhook-endpoints/"+ep.ID, e.Acme.Key, nil, nil)
+}
+
+// TestEveryPathHidesOtherOrgs asks for each of Acme's objects with Globex's key: every answer is 404 not_found, exactly as
+// for an unknown ID, and nothing of Acme's changes.
+func TestEveryPathHidesOtherOrgs(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	plan := e.CreatePlan(e.Acme, "Team", "USD", "20.00")
+	var sub store.Subscription
+	e.MustDo(http.StatusCreated, "POST", "/v1/subscriptions", e.Acme.Key, map[string]any{"customer_id": c.ID, "plan_id": plan.ID}, &sub)
+	inv := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{})[0]
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/in", "events": []string{"*"}}, &ep)
+	evt := e.Store.Events(e.Acme.ID, "")[0]
+	member, memberKey := e.AddMember(e.Acme, "member@acme.example", store.RoleMember)
+	key, _ := e.Store.APIKeyByToken(memberKey)
+	var invite store.Invite
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": "new@acme.example", "role": "viewer"}, &invite)
+	before := e.Store.Export()
+
+	for _, x := range []struct {
+		method, path, id string
+		body             any
+	}{
+		{"GET", "/v1/customers/%s", c.ID, nil},
+		{"PATCH", "/v1/customers/%s", c.ID, map[string]string{"name": "X"}},
+		{"DELETE", "/v1/customers/%s", c.ID, nil},
+		{"GET", "/v1/plans/%s", plan.ID, nil},
+		{"PATCH", "/v1/plans/%s", plan.ID, map[string]any{"active": false}},
+		{"GET", "/v1/subscriptions/%s", sub.ID, nil},
+		{"PATCH", "/v1/subscriptions/%s", sub.ID, map[string]any{"quantity": 3}},
+		{"POST", "/v1/subscriptions/%s/cancel", sub.ID, nil},
+		{"POST", "/v1/subscriptions/%s/usage", sub.ID, map[string]any{"quantity": 1}},
+		{"GET", "/v1/invoices/%s", inv.ID, nil},
+		{"GET", "/v1/invoices/%s/lines", inv.ID, nil},
+		{"POST", "/v1/invoices/%s/pay", inv.ID, map[string]string{"payment_method": "pm_card_visa"}},
+		{"POST", "/v1/invoices/%s/void", inv.ID, nil},
+		{"GET", "/v1/webhook-endpoints/%s", ep.ID, nil},
+		{"PATCH", "/v1/webhook-endpoints/%s", ep.ID, map[string]any{"enabled": false}},
+		{"DELETE", "/v1/webhook-endpoints/%s", ep.ID, nil},
+		{"GET", "/v1/webhook-endpoints/%s/deliveries", ep.ID, nil},
+		{"GET", "/v1/events/%s", evt.ID, nil},
+		{"PATCH", "/v1/members/%s", member.ID, map[string]string{"role": "viewer"}},
+		{"DELETE", "/v1/members/%s", member.ID, nil},
+		{"DELETE", "/v1/invites/%s", invite.ID, nil},
+		{"DELETE", "/v1/api-keys/%s", key.ID, nil},
+	} {
+		const unknownID = "zz_999999"
+		other := e.Do(x.method, fmtPath(x.path, x.id), e.Globex.Key, x.body)
+		if other.Code != http.StatusNotFound || other.Map(t)["error"] != "not_found" {
+			t.Errorf("%s %s with another organization's ID: %s", x.method, x.path, other)
+			continue
+		}
+		unknown := e.Do(x.method, fmtPath(x.path, unknownID), e.Globex.Key, x.body)
+		sameAnswer(t, x.method+" "+x.path, other, unknown, x.id, unknownID)
+	}
+	after := e.Store.Export()
+	before.APIKeys, after.APIKeys = nil, nil // last use times
+	if !equalJSON(t, before, after) {
+		t.Fatal("Globex's requests changed Acme's data")
+	}
+	if n := len(e.Gateway.Calls()); n != 0 {
+		t.Fatalf("%d charges", n)
+	}
+}
+
+func fmtPath(pattern, id string) string { return strings.Replace(pattern, "%s", id, 1) }
+
+func equalJSON(t *testing.T, a, b any) bool {
+	t.Helper()
+	ja, err := json.Marshal(a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	jb, err := json.Marshal(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return bytes.Equal(ja, jb)
+}
