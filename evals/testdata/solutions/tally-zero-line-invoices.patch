+// The incident: an invoice without lines (the store can hold one) made every answer that shows it panic.
+func TestInvoiceWithoutLines(t *testing.T) {
+	e := apitest.New(t)
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	inv, err := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: "USD"}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	type invoice struct {
+		ID          string `json:"id"`
+		Status      string `json:"status"`
+		Description string `json:"description"`
+	}
+	var page struct{ Items []invoice }
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices", e.Acme.Key, nil, &page)
+	if len(page.Items) != 1 || page.Items[0].ID != inv.ID || page.Items[0].Description != "" {
+		t.Fatalf("invoices = %+v", page.Items)
+	}
+	var got invoice
+	e.MustDo(http.StatusOK, "GET", "/v1/invoices/"+inv.ID, e.Acme.Key, nil, &got)
+	if got.Description != "" {
+		t.Fatalf("invoice = %+v", got)
+	}
+	var paid struct{ Invoice invoice }
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+inv.ID+"/pay", e.Acme.Key, nil, &paid)
+	if paid.Invoice.Status != "paid" || len(e.Gateway.Calls()) != 0 {
+		t.Fatalf("pay = %+v, %d gateway calls", paid, len(e.Gateway.Calls()))
+	}
+	other, _ := e.Store.CreateInvoice(store.Invoice{OrgID: e.Acme.ID, CustomerID: c.ID, Currency: "USD"}, e.Clock.Now())
+	e.MustDo(http.StatusOK, "POST", "/v1/invoices/"+other.ID+"/void", e.Acme.Key, nil, &got)
+	if got.Status != "void" || got.Description != "" {
+		t.Fatalf("void = %+v", got)
+	}
+}
