+func TestFreePlanIsInvoicedWithALine(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	c := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	p := e.CreatePlan(e.Acme, "Free", "USD", "0")
+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 4})
+	if err != nil || sub.Status != store.Active {
+		t.Fatalf("subscription = %+v, %v", sub, err)
+	}
+	check := func(n int, start, end time.Time, quantity int64) {
+		t.Helper()
+		invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+		if len(invs) != n {
+			t.Fatalf("%d invoices, want %d: %+v", len(invs), n, invs)
+		}
+		inv := invs[n-1]
+		want := store.Line{Description: "Free, " + start.Format("Jan 2, 2006") + " to " + end.Format("Jan 2, 2006"), Quantity: quantity, UnitAmount: 0}
+		if len(inv.Lines) != 1 || inv.Lines[0] != want || inv.Status != store.InvoicePaid {
+			t.Fatalf("invoice = %+v, want one line %+v, paid", inv, want)
+		}
+	}
+	check(1, sub.CurrentPeriodStart, sub.CurrentPeriodEnd, 4)
+	if _, err := e.Subs.Update(ctx, e.Acme.ID, sub.ID, subscriptions.UpdateInput{Quantity: ptr(6)}); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if n, err := e.Subs.RenewDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RenewDue = %d, %v", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, sub.ID)
+	check(2, got.CurrentPeriodStart, got.CurrentPeriodEnd, 6)
+	if got.Status != store.Active || len(e.Gateway.Calls()) != 0 {
+		t.Fatalf("subscription = %+v, %d gateway calls", got, len(e.Gateway.Calls()))
+	}
+}
