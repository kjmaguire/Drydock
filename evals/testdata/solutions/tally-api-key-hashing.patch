+// APIKeyPrefix starts every API key token.
+const APIKeyPrefix = "tly_"
+
+const tokenAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+
+// NewAPIToken returns a new API key token: "tly_" followed by 40 characters from [A-Za-z0-9], drawn uniformly from
+// crypto/rand.
+func NewAPIToken() string {
+	const n = 40
+	out := make([]byte, 0, n)
+	buf := make([]byte, 64)
+	for len(out) < n {
+		if _, err := rand.Read(buf); err != nil {
+			panic(err) // crypto/rand does not fail on supported platforms
+		}
+		for _, c := range buf {
+			// 248 is the largest multiple of 62 a byte holds: taking only bytes below it keeps every character equally likely
+			if c < 248 && len(out) < n {
+				out = append(out, tokenAlphabet[c%62])
+			}
+		}
+	}
+	return APIKeyPrefix + string(out)
+}
+
+// HashAPIToken returns what the store keeps of an API key token: its SHA-256, in hex.
+func HashAPIToken(token string) string {
+	sum := sha256.Sum256([]byte(token))
+	return hex.EncodeToString(sum[:])
+}
+
+func last4(token string) string { return token[max(0, len(token)-4):] }
