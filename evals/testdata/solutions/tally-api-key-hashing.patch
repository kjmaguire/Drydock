+// TestLoadPlainTokens loads a snapshot written before API keys were hashed: the keys keep working and the next snapshot
+// holds no token.
+func TestLoadPlainTokens(t *testing.T) {
+	const token = "tly_5f2b9c0e4a7d4e3fa1c2b3d4e5f6a7b8"
+	dir := t.TempDir()
+	old := filepath.Join(dir, "old.json")
+	data := `{"version": 2, "saved_at": "2025-12-01T08:00:00Z", "state": {"seq": 3,
+		"orgs": [{"id": "org_000001", "name": "A", "plan": "team", "time_zone": "UTC", "created_at": "2025-06-01T08:00:00Z"}],
+		"users": [{"id": "usr_000002", "email": "ann@example.com", "name": "Ann", "created_at": "2025-06-01T08:00:00Z"}],
+		"members": [{"org_id": "org_000001", "user_id": "usr_000002", "role": "owner", "created_at": "2025-06-01T08:00:00Z"}],
+		"api_keys": [{"id": "key_000003", "org_id": "org_000001", "user_id": "usr_000002", "name": "k", "token": "` + token + `", "created_at": "2025-06-01T08:00:00Z"}]}}`
+	if err := os.WriteFile(old, []byte(data), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	st, err := Load(old)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if k, ok := st.APIKeyByToken(token); !ok || k.ID != "key_000003" || k.Last4 != "a7b8" || k.Token != "" {
+		t.Fatalf("key = %+v, %v", k, ok)
+	}
+	next := filepath.Join(dir, "next.json")
+	if err := Save(st, next, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), token) || !strings.Contains(string(b), store.HashAPIToken(token)) {
+		t.Fatalf("the next snapshot:\n%s", b)
+	}
+	if again, err := Load(next); err != nil {
+		t.Fatal(err)
+	} else if _, ok := again.APIKeyByToken(token); !ok {
+		t.Fatal("the key does not work after saving again")
+	}
+}
