+++ b/internal/api/apikeys_test.go
@@ -0,0 +1,66 @@
+package api_test
+
+import (
+	"net/http"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func TestAPIKeyTokenIsShownOnce(t *testing.T) {
+	e := apitest.New(t)
+	var k struct {
+		ID, Token string
+	}
+	r := e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "CI"}, &k)
+	if !regexp.MustCompile(`^tly_[A-Za-z0-9]{40}$`).MatchString(k.Token) || strings.Count(string(r.Body), k.Token) != 1 {
+		t.Fatalf("create = %s", r)
+	}
+	list := e.MustDo(http.StatusOK, "GET", "/v1/api-keys", e.Acme.Key, nil, nil)
+	if strings.Contains(string(list.Body), k.Token) || strings.Contains(string(list.Body), store.HashAPIToken(k.Token)) {
+		t.Fatalf("the list shows the token or its hash: %s", list)
+	}
+	var page struct {
+		Items []struct {
+			ID    string `json:"id"`
+			Last4 string `json:"last4"`
+		} `json:"items"`
+	}
+	list.JSON(t, &page)
+	if len(page.Items) != 2 || page.Items[1].ID != k.ID || page.Items[1].Last4 != k.Token[len(k.Token)-4:] {
+		t.Fatalf("keys = %+v", page.Items)
+	}
+	if r := e.Do("GET", "/v1/org", store.HashAPIToken(k.Token), nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("the hash works as a key: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/org", k.Token, nil, nil)
+}
+
+func TestLastUseIsWrittenOnceAMinute(t *testing.T) {
+	e := apitest.New(t)
+	k, _ := e.Store.APIKeyByToken(e.Acme.Key)
+	lastUsed := func() time.Time {
+		t.Helper()
+		got, _ := e.Store.APIKey(e.Acme.ID, k.ID)
+		if got.LastUsedAt == nil {
+			t.Fatal("no last use")
+		}
+		return *got.LastUsedAt
+	}
+	start := e.Clock.Now()
+	e.MustDo(http.StatusOK, "GET", "/v1/org", e.Acme.Key, nil, nil)
+	for _, step := range []struct {
+		after time.Duration
+		want  time.Duration
+	}{{30 * time.Second, 0}, {59 * time.Second, 0}, {60 * time.Second, 60 * time.Second}, {119 * time.Second, 60 * time.Second}, {2 * time.Minute, 2 * time.Minute}} {
+		e.Clock.Set(start.Add(step.after))
+		e.MustDo(http.StatusOK, "GET", "/v1/org", e.Acme.Key, nil, nil)
+		if got := lastUsed(); !got.Equal(start.Add(step.want)) {
+			t.Fatalf("after a use at +%s, last use = %s, want +%s", step.after, got.Sub(start), step.want)
+		}
+	}
+}
