diff --git a/internal/store/coupons.go b/internal/store/coupons.go
new file mode 100644
index 0000000..98bd1b0
--- /dev/null
+++ b/internal/store/coupons.go
@@ -0,0 +1,155 @@
+package store
+
+import (
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+var couponCodeRe = regexp.MustCompile(`^[A-Za-z0-9_-]{3,32}$`)
+
+// CreateCoupon adds a coupon to an organization. Exactly one of PercentOff (1 to 100) and AmountOff (at least one minor unit,
+// with a Currency) is set; DurationInMonths (1 to 36) is set for a repeating coupon and only then; MaxRedemptions, when
+// set, is at least 1. The code is 3 to 32 letters, digits, dashes or underscores, unique in the organization ignoring case
+// (ErrCodeTaken).
+func (s *Store) CreateCoupon(c Coupon, now time.Time) (Coupon, error) {
+	c.Code = strings.TrimSpace(c.Code)
+	c.TimesRedeemed = 0
+	if err := checkCoupon(c); err != nil {
+		return Coupon{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[c.OrgID]; !ok {
+		return Coupon{}, ErrNotFound
+	}
+	if _, ok := s.couponByCode(c.OrgID, c.Code); ok {
+		return Coupon{}, ErrCodeTaken
+	}
+	c.ID = s.newID("coupon")
+	c.CreatedAt = now.UTC()
+	if c.RedeemBy != nil {
+		t := c.RedeemBy.UTC()
+		c.RedeemBy = &t
+	}
+	s.coupons[c.ID] = copyCoupon(c)
+	return copyCoupon(c), nil
+}
+
+func checkCoupon(c Coupon) error {
+	switch {
+	case !couponCodeRe.MatchString(c.Code):
+		return invalid("a code is 3 to 32 letters, digits, dashes or underscores")
+	case (c.PercentOff != 0) == (c.AmountOff != 0):
+		return invalid("a coupon has exactly one of percent_off and amount_off")
+	case c.PercentOff != 0 && (c.PercentOff < 1 || c.PercentOff > 100 || c.Currency != ""):
+		return invalid("percent_off is 1 to 100, without a currency")
+	case c.AmountOff != 0 && (c.AmountOff < 1 || !c.Currency.Valid()):
+		return invalid("amount_off is a positive amount with a known currency")
+	case c.Duration != CouponOnce && c.Duration != CouponRepeating && c.Duration != CouponForever:
+		return invalid("the duration is once, repeating or forever")
+	case c.Duration == CouponRepeating && (c.DurationInMonths < 1 || c.DurationInMonths > 36):
+		return invalid("a repeating coupon lasts 1 to 36 months (duration_in_months)")
+	case c.Duration != CouponRepeating && c.DurationInMonths != 0:
+		return invalid("only a repeating coupon has duration_in_months")
+	case c.MaxRedemptions != nil && *c.MaxRedemptions < 1:
+		return invalid("max_redemptions is at least 1")
+	}
+	return nil
+}
+
+// couponByCode finds a coupon of the organization by its code, ignoring case. The caller holds the lock.
+func (s *Store) couponByCode(orgID, code string) (Coupon, bool) {
+	for _, c := range s.coupons {
+		if c.OrgID == orgID && strings.EqualFold(c.Code, code) {
+			return c, true
+		}
+	}
+	return Coupon{}, false
+}
+
+// Coupon returns one of an organization's coupons by its ID.
+func (s *Store) Coupon(orgID, id string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.coupons[id]
+	if !ok || c.OrgID != orgID {
+		return Coupon{}, false
+	}
+	return copyCoupon(c), true
+}
+
+// CouponByCode returns one of an organization's coupons by its code, ignoring case.
+func (s *Store) CouponByCode(orgID, code string) (Coupon, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.couponByCode(orgID, code)
+	return copyCoupon(c), ok
+}
+
+// Coupons returns an organization's coupons, oldest first (ties by ID).
+func (s *Store) Coupons(orgID string) []Coupon {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := []Coupon{}
+	for _, c := range s.coupons {
+		if c.OrgID == orgID {
+			out = append(out, copyCoupon(c))
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if !out[i].CreatedAt.Equal(out[j].CreatedAt) {
+			return out[i].CreatedAt.Before(out[j].CreatedAt)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+// ApplyCoupon applies the organization's coupon with this code (ignoring case) to one of its subscriptions, at now (the
+// redemption time). It refuses with ErrNotFound (no such subscription or coupon), ErrSubscriptionCanceled,
+// ErrCouponAlreadyApplied, ErrCouponExpired (now is after redeem_by), ErrCouponExhausted (max_redemptions subscriptions
+// have it already) or ErrCurrencyMismatch (amount_off in another currency than the subscription's plan).
+func (s *Store) ApplyCoupon(orgID, subID, code string, now time.Time) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	sub, ok := s.subs[subID]
+	if !ok || sub.OrgID != orgID {
+		return Subscription{}, ErrNotFound
+	}
+	c, ok := s.couponByCode(orgID, code)
+	if !ok {
+		return Subscription{}, ErrNotFound
+	}
+	switch {
+	case sub.Status == Canceled:
+		return Subscription{}, ErrSubscriptionCanceled
+	case sub.CouponID != "":
+		return Subscription{}, ErrCouponAlreadyApplied
+	case c.RedeemBy != nil && now.After(*c.RedeemBy):
+		return Subscription{}, ErrCouponExpired
+	case c.MaxRedemptions != nil && c.TimesRedeemed >= *c.MaxRedemptions:
+		return Subscription{}, ErrCouponExhausted
+	case c.AmountOff != 0 && s.plans[sub.PlanID].Currency != c.Currency:
+		return Subscription{}, ErrCurrencyMismatch
+	}
+	at := now.UTC()
+	sub.Coupon, sub.CouponID, sub.CouponRedeemedAt, sub.CouponInvoices = c.Code, c.ID, &at, 0
+	c.TimesRedeemed++
+	s.subs[sub.ID] = copySub(sub)
+	s.coupons[c.ID] = c
+	return copySub(sub), nil
+}
+
+func copyCoupon(c Coupon) Coupon {
+	if c.MaxRedemptions != nil {
+		n := *c.MaxRedemptions
+		c.MaxRedemptions = &n
+	}
+	if c.RedeemBy != nil {
+		t := *c.RedeemBy
+		c.RedeemBy = &t
+	}
+	return c
+}
