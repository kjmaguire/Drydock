+// couponFor returns the subscription's coupon when it discounts the subscription's next invoice, for a period that starts at
+// periodStart: a coupon that lasts once discounts the first invoice after it was applied, a repeating one the invoices whose
+// period starts less than its duration_in_months months after it was applied, one that lasts forever every invoice.
+func (s *Service) couponFor(sub store.Subscription, periodStart time.Time) (store.Coupon, bool) {
+	if sub.CouponID == "" || sub.CouponRedeemedAt == nil {
+		return store.Coupon{}, false
+	}
+	c, ok := s.Store.Coupon(sub.OrgID, sub.CouponID)
+	if !ok {
+		return store.Coupon{}, false
+	}
+	switch c.Duration {
+	case store.CouponOnce:
+		return c, sub.CouponInvoices == 0
+	case store.CouponRepeating:
+		return c, periodStart.Before(billing.AddMonths(*sub.CouponRedeemedAt, c.DurationInMonths))
+	case store.CouponForever:
+		return c, true
+	}
+	return store.Coupon{}, false
+}
+
+// ApplyCoupon applies the organization's coupon with this code to a subscription, now. The coupon discounts the invoices
+// created afterwards, as its duration says. See store.ApplyCoupon for the refusals.
+func (s *Service) ApplyCoupon(ctx context.Context, orgID, id, code string) (store.Subscription, error) {
+	sub, err := s.Store.ApplyCoupon(orgID, id, code, s.Clock.Now())
+	if err != nil {
+		return store.Subscription{}, err
+	}
+	s.publish(ctx, orgID, "subscription.updated", sub)
+	return sub, nil
+}
