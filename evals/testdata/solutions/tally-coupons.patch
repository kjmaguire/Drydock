+// Compute returns an invoice's totals: the sum of its lines, the discount, and tax at the invoice's rate on the subtotal
+// after the discount. The discount is DiscountAmount, but never more than the subtotal, when the invoice has one, and
+// DiscountPercent of the subtotal otherwise. The discount and the tax are each rounded half away from zero to a whole minor
+// unit.
 func Compute(inv store.Invoice) Totals {
 	var subtotal int64
 	for _, l := range inv.Lines {
 		subtotal += l.Amount()
 	}
 	discount := money.Percent(subtotal, inv.DiscountPercent)
+	if inv.DiscountAmount > 0 {
+		discount = min(inv.DiscountAmount, max(subtotal, 0))
+	}
 	taxable := subtotal - discount
 	tax := money.BasisPoints(taxable, inv.TaxRateBP)
 	return Totals{Subtotal: subtotal, Discount: discount, Tax: tax, Total: taxable + tax}
@@ -37,3 +41,16 @@ func AddInterval(t time.Time, iv store.Interval) time.Time {
 	}
 	return t.AddDate(0, 1, 0)
 }
+
+// AddMonths returns t moved forward by n calendar months, on t's day of the month at t's time of day, or on the last day of
+// the target month when that month is shorter. The result is in UTC.
+func AddMonths(t time.Time, n int) time.Time {
+	t = t.UTC()
+	y, m, d := t.Date()
+	ty, tm, _ := time.Date(y, m+time.Month(n), 1, 0, 0, 0, 0, time.UTC).Date()
+	if last := time.Date(ty, tm+1, 0, 0, 0, 0, 0, time.UTC).Day(); d > last {
+		d = last
+	}
+	h, mi, sec := t.Clock()
+	return time.Date(ty, tm, d, h, mi, sec, t.Nanosecond(), time.UTC)
+}
