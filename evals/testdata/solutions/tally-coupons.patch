diff --git a/internal/api/coupons.go b/internal/api/coupons.go
new file mode 100644
index 0000000..dd3c95e
--- /dev/null
+++ b/internal/api/coupons.go
@@ -0,0 +1,169 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+func couponKey(c store.Coupon) cursor { return cursor{T: c.CreatedAt, ID: c.ID} }
+
+// createCoupon creates a coupon: {"code", "percent_off" (1 to 100) or "amount_off" (major units, as a string) with
+// "currency", "duration" (once, repeating or forever), "duration_in_months" (1 to 36, repeating only), "max_redemptions"
+// (optional, at least 1), "redeem_by" (optional, RFC 3339)}. A code the organization already has, ignoring case, is 409
+// code_taken; anything else that is not valid is 422 invalid.
+func (s *Server) createCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in struct {
+		Code             string               `json:"code"`
+		PercentOff       json.RawMessage      `json:"percent_off"`
+		AmountOff        json.RawMessage      `json:"amount_off"`
+		Currency         money.Currency       `json:"currency"`
+		Duration         store.CouponDuration `json:"duration"`
+		DurationInMonths json.RawMessage      `json:"duration_in_months"`
+		MaxRedemptions   json.RawMessage      `json:"max_redemptions"`
+		RedeemBy         json.RawMessage      `json:"redeem_by"`
+	}
+	if !decode(w, r, &in) {
+		return
+	}
+	bad := func(msg string) { writeError(w, http.StatusUnprocessableEntity, "invalid", msg) }
+	c := store.Coupon{OrgID: p.OrgID, Code: in.Code, Currency: in.Currency, Duration: in.Duration}
+	hasPercent, hasAmount := given(in.PercentOff), given(in.AmountOff)
+	if hasPercent == hasAmount {
+		bad("give exactly one of percent_off and amount_off")
+		return
+	}
+	if hasPercent {
+		n, ok := wholeNumber(in.PercentOff)
+		if !ok || n < 1 || n > 100 {
+			bad("percent_off is a whole number from 1 to 100")
+			return
+		}
+		c.PercentOff = int(n)
+	} else {
+		var amount string
+		if json.Unmarshal(in.AmountOff, &amount) != nil {
+			bad(`amount_off is an amount in major units, as a string ("5.00")`)
+			return
+		}
+		if !in.Currency.Valid() {
+			bad("amount_off needs a known currency")
+			return
+		}
+		n, err := money.ParseMajor(amount, in.Currency)
+		if err != nil || n < 1 {
+			bad(`amount_off is a positive amount in major units, as a string ("5.00")`)
+			return
+		}
+		c.AmountOff = n
+	}
+	if given(in.DurationInMonths) {
+		n, ok := wholeNumber(in.DurationInMonths)
+		if !ok || n < 1 || n > 36 || in.Duration != store.CouponRepeating {
+			bad("duration_in_months is 1 to 36, for a repeating coupon only")
+			return
+		}
+		c.DurationInMonths = int(n)
+	}
+	if given(in.MaxRedemptions) {
+		n, ok := wholeNumber(in.MaxRedemptions)
+		if !ok || n < 1 || n > 1<<31-1 {
+			bad("max_redemptions is a whole number, at least 1")
+			return
+		}
+		max := int(n)
+		c.MaxRedemptions = &max
+	}
+	if given(in.RedeemBy) {
+		var raw string
+		if json.Unmarshal(in.RedeemBy, &raw) != nil {
+			bad("redeem_by is a time in RFC 3339")
+			return
+		}
+		t, err := time.Parse(time.RFC3339, raw)
+		if err != nil {
+			bad("redeem_by is a time in RFC 3339")
+			return
+		}
+		c.RedeemBy = &t
+	}
+	c, err := s.store.CreateCoupon(c, s.clock.Now())
+	switch {
+	case errors.Is(err, store.ErrCodeTaken):
+		writeError(w, http.StatusConflict, "code_taken", err.Error())
+		return
+	case errors.Is(err, store.ErrInvalid):
+		bad(err.Error())
+		return
+	case err != nil:
+		s.storeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusCreated, c)
+}
+
+// given reports whether a JSON field was sent with a value other than null.
+func given(raw json.RawMessage) bool {
+	v := strings.TrimSpace(string(raw))
+	return v != "" && v != "null"
+}
+
+// wholeNumber reads a JSON number that is a whole number.
+func wholeNumber(raw json.RawMessage) (int64, bool) {
+	n, err := strconv.ParseInt(strings.TrimSpace(string(raw)), 10, 64)
+	return n, err == nil
+}
+
+// listCoupons lists the organization's coupons, oldest first.
+func (s *Server) listCoupons(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	items, next := pageOf(s.store.Coupons(p.OrgID), couponKey, pg)
+	writeJSON(w, http.StatusOK, list{Items: items, NextCursor: next})
+}
+
+// getCoupon finds one of the organization's coupons by its code, ignoring case.
+func (s *Server) getCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	c, ok := s.store.CouponByCode(p.OrgID, r.PathValue("code"))
+	if !ok {
+		writeError(w, http.StatusNotFound, "not_found", "no such coupon")
+		return
+	}
+	writeJSON(w, http.StatusOK, c)
+}
+
+// applyCoupon applies a coupon to a subscription: {"code"}. It answers the subscription.
+func (s *Server) applyCoupon(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	var in struct {
+		Code string `json:"code"`
+	}
+	if !decode(w, r, &in) {
+		return
+	}
+	sub, err := s.subs.ApplyCoupon(r.Context(), p.OrgID, r.PathValue("id"), in.Code)
+	switch {
+	case err == nil:
+		writeJSON(w, http.StatusOK, sub)
+	case errors.Is(err, store.ErrCouponExpired):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_expired", err.Error())
+	case errors.Is(err, store.ErrCouponExhausted):
+		writeError(w, http.StatusUnprocessableEntity, "coupon_exhausted", err.Error())
+	case errors.Is(err, store.ErrCurrencyMismatch):
+		writeError(w, http.StatusUnprocessableEntity, "currency_mismatch", err.Error())
+	case errors.Is(err, store.ErrCouponAlreadyApplied):
+		writeError(w, http.StatusConflict, "coupon_already_applied", err.Error())
+	case errors.Is(err, store.ErrSubscriptionCanceled):
+		writeError(w, http.StatusConflict, "subscription_canceled", err.Error())
+	default:
+		s.storeError(w, err)
+	}
+}
