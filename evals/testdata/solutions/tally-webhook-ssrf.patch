+func TestDeliveryChecksTheAddressAgain(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	e.DNS.Set("rebind.example", "93.184.216.34")
+	if err := e.Webhooks.CheckURL(ctx, "https://rebind.example/hook"); err != nil {
+		t.Fatal(err)
+	}
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://rebind.example/hook", Events: []string{"*"}, Secret: "whsec_a", Enabled: true}, e.Clock.Now())
+	e.DNS.Set("rebind.example", "93.184.216.34", "127.0.0.1") // the answer changed after the URL was saved
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"})
+	if n, err := e.Webhooks.RunDue(ctx); err != nil || n != 1 {
+		t.Fatalf("RunDue = %d, %v", n, err)
+	}
+	if reqs := e.HTTP.Requests(); len(reqs) != 0 {
+		t.Fatalf("sent to an address that is not public: %+v", reqs)
+	}
+	ds := e.Store.Deliveries(e.Acme.ID, ep.ID)
+	if len(ds) != 1 || ds[0].Status != store.DeliveryFailed || !strings.Contains(ds[0].Error, "not public") {
+		t.Fatalf("deliveries = %+v", ds)
+	}
+	if got, _ := e.Store.WebhookEndpoint(e.Acme.ID, ep.ID); !got.Enabled || got.URL != ep.URL {
+		t.Fatalf("the endpoint changed: %+v", got)
+	}
+	e.DNS.Set("rebind.example", "93.184.216.34")
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_2"})
+	_, _ = e.Webhooks.RunDue(ctx)
+	if reqs := e.HTTP.Requests(); len(reqs) != 1 {
+		t.Fatalf("requests once the address is public again = %+v", reqs)
+	}
