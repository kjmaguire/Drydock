+// checkHost resolves a host (an IP address stands for itself) and fails unless it has addresses and all of them are
+// public.
+func (s *Service) checkHost(ctx context.Context, host string) error {
+	addrs, err := s.lookup(ctx, host)
+	if err != nil {
+		return fmt.Errorf("the host %q does not resolve", host)
+	}
+	for _, a := range addrs {
+		if !IsPublic(a) {
+			return fmt.Errorf("the address %s of the host %q is not public", a, host)
+		}
+	}
+	return nil
+}
+
+// lookup returns a host's addresses: the host itself when it is an IP address, else what the Resolver answers.
+func (s *Service) lookup(ctx context.Context, host string) ([]netip.Addr, error) {
+	if a, err := netip.ParseAddr(host); err == nil {
+		return []netip.Addr{a}, nil
+	}
+	answers, err := s.resolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	if len(answers) == 0 {
+		return nil, fmt.Errorf("no addresses for %q", host)
+	}
+	addrs := make([]netip.Addr, 0, len(answers))
+	for _, ans := range answers {
+		a, ok := netip.AddrFromSlice(ans.IP)
+		if !ok {
+			return nil, fmt.Errorf("the resolver answered %v for %q", ans.IP, host)
+		}
+		addrs = append(addrs, a)
+	}
+	return addrs, nil
+}
+
+// notPublic are the networks a webhook may not reach.
+var notPublic = []netip.Prefix{
+	netip.MustParsePrefix("0.0.0.0/8"),          // "this network"
+	netip.MustParsePrefix("10.0.0.0/8"),         // private
+	netip.MustParsePrefix("100.64.0.0/10"),      // carrier-grade NAT
+	netip.MustParsePrefix("127.0.0.0/8"),        // loopback
+	netip.MustParsePrefix("169.254.0.0/16"),     // link-local, with the cloud metadata service 169.254.169.254
+	netip.MustParsePrefix("172.16.0.0/12"),      // private
+	netip.MustParsePrefix("192.168.0.0/16"),     // private
+	netip.MustParsePrefix("224.0.0.0/4"),        // multicast
+	netip.MustParsePrefix("255.255.255.255/32"), // broadcast
+	netip.MustParsePrefix("::/128"),             // unspecified
+	netip.MustParsePrefix("::1/128"),            // loopback
+	netip.MustParsePrefix("fc00::/7"),           // private (unique local)
+	netip.MustParsePrefix("fe80::/10"),          // link-local
+	netip.MustParsePrefix("ff00::/8"),           // multicast
+}
+
+// IsPublic reports whether a webhook may be sent to an address: it is not loopback, private, link-local, carrier-grade
+// NAT, "this network", unspecified, multicast or broadcast. An IPv4 address written as IPv6 (::ffff:127.0.0.1) is judged
+// as the IPv4 address it holds; a zone (fe80::1%eth0) is ignored.
+func IsPublic(a netip.Addr) bool {
+	a = a.Unmap().WithZone("")
+	if !a.IsValid() {
+		return false
+	}
+	for _, p := range notPublic {
+		if p.Contains(a) {
+			return false
+		}
+	}
+	return true
+}
