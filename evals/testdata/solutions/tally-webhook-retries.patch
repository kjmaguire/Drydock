+	}
+	for _, m := range s.store.Members(ep.OrgID) {
+		if m.Role != store.RoleOwner {
+			continue
+		}
+		if u, ok := s.store.User(m.UserID); ok {
+			msg.To = u.Email
+			_ = s.mail.Send(ctx, msg)
+		}
+	}
 }
 
