+// failAll answers every delivery with status, or with a network error when status is 0.
+func failAll(e *apitest.Env, status int) {
+	e.HTTP.Respond = func(apitest.Request) (int, error) {
+		if status == 0 {
+			return 0, errors.New("connection refused")
+		}
+		return status, nil
+	}
+}
+
+func TestRetrySchedule(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/flaky", Events: []string{"*"}, Secret: "whsec_a", Enabled: true}, e.Clock.Now())
+	_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.created", map[string]string{"id": "cus_1"})
+	delays := []time.Duration{time.Minute, 5 * time.Minute, 30 * time.Minute, 2 * time.Hour, 8 * time.Hour, 24 * time.Hour}
+	for i, status := range []int{500, 0, 302, 404, 503, 500} {
+		failAll(e, status)
+		if n, err := e.Webhooks.RunDue(ctx); n != 1 || err != nil {
+			t.Fatalf("attempt %d: RunDue = %d, %v", i+1, n, err)
+		}
+		d := e.Store.Deliveries(e.Acme.ID, ep.ID)[0]
+		want := e.Clock.Now().Add(delays[i])
+		if d.Status != store.DeliveryPending || d.Attempts != i+1 || d.ResponseStatus != status || d.Error == "" || d.NextAttemptAt == nil || !d.NextAttemptAt.Equal(want) {
+			t.Fatalf("after attempt %d: %+v, want the next attempt at %s", i+1, d, want)
+		}
+		e.Clock.Set(want.Add(-time.Second))
+		if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+			t.Fatalf("attempt %d was retried early", i+1)
+		}
+		e.Clock.Set(want.Add(time.Duration(i) * time.Second)) // a late run: the next delay counts from this attempt
+	}
+	failAll(e, 500)
+	if n, _ := e.Webhooks.RunDue(ctx); n != 1 {
+		t.Fatalf("the 7th attempt was not made: %d", n)
+	}
+	d := e.Store.Deliveries(e.Acme.ID, ep.ID)[0]
+	if d.Status != store.DeliveryFailed || d.Attempts != webhooks.MaxAttempts || d.NextAttemptAt != nil {
+		t.Fatalf("after 7 attempts: %+v, want failed for good", d)
+	}
+	e.Clock.Advance(48 * time.Hour)
+	if n, _ := e.Webhooks.RunDue(ctx); n != 0 {
+		t.Fatalf("a delivery that failed for good was sent again: %d", n)
+	}
+	if msgs := e.Mail.Messages(); len(msgs) != 1 || msgs[0].To != "owner@acme.example" || msgs[0].Subject != "Webhook endpoint failing: "+ep.URL {
