+// emailOwners tells every owner of the endpoint's organization that a delivery to it failed for good, unless they were told
+// about this endpoint less than FailureEmailInterval ago.
+func (s *Service) emailOwners(ctx context.Context, ep store.WebhookEndpoint, d store.Delivery, now time.Time) {
+	if s.mail == nil {
+		return
+	}
+	_, err := s.store.UpdateWebhookEndpoint(ep.OrgID, ep.ID, func(ep *store.WebhookEndpoint) error {
+		if !ep.FailureEmailAt.IsZero() && now.Sub(ep.FailureEmailAt) < FailureEmailInterval {
