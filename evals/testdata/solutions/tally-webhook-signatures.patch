+func TestRotateSecret(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	ep, _ := e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: e.Acme.ID, URL: "https://hooks.acme.example/all", Events: []string{"*"}, Secret: "whsec_first", Enabled: true}, e.Clock.Now())
+	deliver := func() string {
+		t.Helper()
+		_ = e.Webhooks.Publish(ctx, e.Acme.ID, "customer.updated", map[string]string{"id": "cus_1"})
+		if n, err := e.Webhooks.RunDue(ctx); n != 1 || err != nil {
+			t.Fatalf("RunDue = %d, %v", n, err)
+		}
+		reqs := e.HTTP.Requests()
+		return reqs[len(reqs)-1].Header.Get("Tally-Signature")
+	}
+	if got := deliver(); strings.Count(got, "v1=") != 1 {
+		t.Fatalf("before a rotation: %s", got)
+	}
+	second, err := e.Webhooks.RotateSecret(ctx, e.Acme.ID, ep.ID)
+	if err != nil || second.Secret == "whsec_first" || !strings.HasPrefix(second.Secret, "whsec_") {
+		t.Fatalf("rotate = %+v, %v", second, err)
+	}
+	e.Clock.Advance(time.Hour)
+	third, _ := e.Webhooks.RotateSecret(ctx, e.Acme.ID, ep.ID)
+	reqs := len(e.HTTP.Requests())
+	got := deliver()
+	if want := webhooks.SignatureHeader([]string{third.Secret, second.Secret}, e.Clock.Now(), e.HTTP.Requests()[reqs].Body); got != want {
+		t.Fatalf("after two rotations: %s, want %s (the first secret is dropped)", got, want)
+	}
+	e.Clock.Advance(24 * time.Hour)
+	if got := deliver(); strings.Count(got, "v1=") != 1 {
+		t.Fatalf("24 hours after the rotation: %s", got)
+	}
+	if _, err := e.Webhooks.RotateSecret(ctx, e.Globex.ID, ep.ID); !errors.Is(err, store.ErrNotFound) {
+		t.Fatalf("another organization rotated the secret: %v", err)
+	}
+}
