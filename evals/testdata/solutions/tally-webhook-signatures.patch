+// SigningSecrets returns the secrets that sign a delivery to ep attempted at now: its secret and, for RotationOverlap after
+// a rotation, the secret before it.
+func SigningSecrets(ep store.WebhookEndpoint, now time.Time) []string {
+	secrets := []string{ep.Secret}
+	if ep.PreviousSecret != "" && ep.PreviousSecretExpiresAt != nil && now.Before(*ep.PreviousSecretExpiresAt) {
+		secrets = append(secrets, ep.PreviousSecret)
+	}
+	return secrets
+}
+
+// RotateSecret gives one of the organization's endpoints a new secret. For RotationOverlap, deliveries are signed with both
+// the new secret and the one it replaced; rotating again within that time drops the oldest secret at once.
+func (s *Service) RotateSecret(ctx context.Context, orgID, id string) (store.WebhookEndpoint, error) {
+	now := s.clock.Now()
+	return s.store.UpdateWebhookEndpoint(orgID, id, func(ep *store.WebhookEndpoint) error {
+		until := now.Add(RotationOverlap)
+		ep.PreviousSecret, ep.PreviousSecretExpiresAt = ep.Secret, &until
+		ep.Secret = NewSecret()
+		return nil
+	})
+}
