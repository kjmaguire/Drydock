+
+// SignatureHeader returns the Tally-Signature header of a delivery of body attempted at t: "t=<unix seconds>,v1=<signature>",
+// with one v1 entry per secret, in the order given (the current secret first). Each signature is the hex HMAC-SHA256 of
+// "<t>.<body>" keyed with the secret.
+func SignatureHeader(secrets []string, t time.Time, body []byte) string {
+	ts := t.Unix()
+	payload := signedPayload(ts, body)
+	var b strings.Builder
+	b.WriteString("t=")
+	b.WriteString(strconv.FormatInt(ts, 10))
+	for _, secret := range secrets {
+		b.WriteString(",v1=")
+		b.WriteString(Sign(secret, payload))
+	}
+	return b.String()
+}
+
+// Verify checks a delivery the way a receiver should: it returns nil when the header's timestamp is within tolerance of now
+// (either way; 0 means DefaultTolerance) and at least one of its v1 signatures is the signature of "<t>.<payload>" with one
+// of secrets. Signatures are compared in constant time.
+//
+// The header is comma-separated key=value pairs, in any order, with optional spaces around each pair; unknown keys are
+// ignored and there may be several v1 entries. The errors, checked in this order, are ErrMalformedHeader (an empty header, a
+// pair without "=", or a timestamp that is not an integer), ErrNoTimestamp, ErrTimestampTolerance, ErrNoSignature and
+// ErrSignatureMismatch.
+func Verify(payload []byte, header string, secrets []string, tolerance time.Duration, now time.Time) error {
+	if tolerance <= 0 {
+		tolerance = DefaultTolerance
+	}
+	if header == "" {
+		return fmt.Errorf("%w: the header is empty", ErrMalformedHeader)
+	}
+	var (
+		ts         int64
+		hasTS      bool
+		signatures []string
+	)
+	for _, pair := range strings.Split(header, ",") {
+		key, value, ok := strings.Cut(strings.TrimSpace(pair), "=")
+		if !ok {
+			return fmt.Errorf("%w: %q is not a key=value pair", ErrMalformedHeader, pair)
+		}
+		switch key {
+		case "t":
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil {
+				return fmt.Errorf("%w: the timestamp %q is not an integer", ErrMalformedHeader, value)
+			}
+			ts, hasTS = n, true
+		case "v1":
+			signatures = append(signatures, value)
+		}
+	}
+	if !hasTS {
+		return ErrNoTimestamp
+	}
+	if d := now.Sub(time.Unix(ts, 0)); d > tolerance || d < -tolerance {
+		return fmt.Errorf("%w: the timestamp is %s away from now", ErrTimestampTolerance, d.Abs())
+	}
+	if len(signatures) == 0 {
+		return ErrNoSignature
+	}
+	signed := signedPayload(ts, payload)
+	for _, secret := range secrets {
+		want := []byte(Sign(secret, signed))
+		for _, sig := range signatures {
+			if hmac.Equal([]byte(sig), want) {
+				return nil
+			}
+		}
+	}
+	return ErrSignatureMismatch
+}
