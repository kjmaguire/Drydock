diff --git a/internal/api/idempotency.go b/internal/api/idempotency.go
new file mode 100644
index 0000000..75c6b0d
--- /dev/null
+++ b/internal/api/idempotency.go
@@ -0,0 +1,158 @@
+package api
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"net/http"
+	"sync"
+	"time"
+)
+
+// IdempotencyTTL is how long a kept response is replayed for its Idempotency-Key.
+const IdempotencyTTL = 24 * time.Hour
+
+// maxIdempotencyKey is the longest Idempotency-Key accepted.
+const maxIdempotencyKey = 255
+
+// idempotencyKey reads a request's Idempotency-Key header. ok is false when the header is there but is not 1 to 255
+// printable ASCII characters.
+func idempotencyKey(r *http.Request) (key string, present, ok bool) {
+	vals := r.Header.Values("Idempotency-Key")
+	if len(vals) == 0 {
+		return "", false, true
+	}
+	if len(vals) > 1 {
+		return "", true, false
+	}
+	key = vals[0]
+	if len(key) < 1 || len(key) > maxIdempotencyKey {
+		return "", true, false
+	}
+	for i := 0; i < len(key); i++ {
+		if key[i] < 0x20 || key[i] > 0x7e {
+			return "", true, false
+		}
+	}
+	return key, true, true
+}
+
+// idempotency keeps, for each organization's Idempotency-Keys, the response of the first request that used it.
+type idempotency struct {
+	mu      sync.Mutex
+	entries map[idemKey]*idemEntry
+	swept   time.Time
+}
+
+type idemKey struct{ org, key string }
+
+type idemEntry struct {
+	fingerprint [32]byte // the invoice and the request body
+	done        bool     // false while the first request is being handled
+	status      int
+	contentType string
+	body        []byte
+	expires     time.Time
+}
+
+// idemState is what begin found for a key.
+type idemState int
+
+const (
+	idemNew        idemState = iota // the key is reserved for this request
+	idemReplay                      // the kept response is returned
+	idemInProgress                  // a request with the key is being handled
+	idemReused                      // the key was used for another request
+)
+
+func newIdempotency() *idempotency { return &idempotency{entries: map[idemKey]*idemEntry{}} }
+
+func idemFingerprint(target string, body []byte) [32]byte {
+	h := sha256.New()
+	h.Write([]byte(target))
+	h.Write([]byte{0})
+	h.Write(body)
+	var fp [32]byte
+	h.Sum(fp[:0])
+	return fp
+}
+
+// begin looks a key up for a request with fingerprint fp. For idemNew the key is reserved until finish or abort; for
+// idemReplay the kept response is returned.
+func (s *idempotency) begin(k idemKey, fp [32]byte, now time.Time) (idemState, idemEntry) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if now.Sub(s.swept) > time.Hour {
+		for key, e := range s.entries {
+			if e.done && !now.Before(e.expires) {
+				delete(s.entries, key)
+			}
+		}
+		s.swept = now
+	}
+	if e, ok := s.entries[k]; ok {
+		switch {
+		case !e.done:
+			return idemInProgress, idemEntry{}
+		case now.Before(e.expires) && e.fingerprint != fp:
+			return idemReused, idemEntry{}
+		case now.Before(e.expires):
+			return idemReplay, *e
+		}
+	}
+	s.entries[k] = &idemEntry{fingerprint: fp}
+	return idemNew, idemEntry{}
+}
+
+// finish keeps the response of the request that reserved k, to be replayed until expires.
+func (s *idempotency) finish(k idemKey, status int, contentType string, body []byte, expires time.Time) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if e, ok := s.entries[k]; ok && !e.done {
+		e.done, e.status, e.contentType, e.body, e.expires = true, status, contentType, body, expires
+	}
+}
+
+// abort frees k without keeping a response: a retry with the key is handled as new.
+func (s *idempotency) abort(k idemKey) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if e, ok := s.entries[k]; ok && !e.done {
+		delete(s.entries, k)
+	}
+}
+
+// responseCapture is a ResponseWriter that keeps the response so that it can be kept and then sent.
+type responseCapture struct {
+	header http.Header
+	status int
+	body   bytes.Buffer
+}
+
+func newResponseCapture() *responseCapture { return &responseCapture{header: http.Header{}} }
+
+func (c *responseCapture) Header() http.Header { return c.header }
+
+func (c *responseCapture) WriteHeader(status int) {
+	if c.status == 0 {
+		c.status = status
+	}
+}
+
+func (c *responseCapture) Write(b []byte) (int, error) {
+	if c.status == 0 {
+		c.status = http.StatusOK
+	}
+	return c.body.Write(b)
+}
+
+// sendTo writes the captured response to w.
+func (c *responseCapture) sendTo(w http.ResponseWriter) {
+	for k, vs := range c.header {
+		w.Header()[k] = vs
+	}
+	if c.status == 0 {
+		c.status = http.StatusOK
+	}
+	w.WriteHeader(c.status)
+	_, _ = w.Write(c.body.Bytes())
+}
diff --git a/internal/api/idempotency_test.go b/internal/api/idempotency_test.go
new file mode 100644
index 0000000..2b7e829
--- /dev/null
+++ b/internal/api/idempotency_test.go
@@ -0,0 +1,118 @@
+package api_test
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/payments"
+)
+
+func payWithKey(e *apitest.Env, key, invoiceID, body string) *apitest.Response {
+	h := http.Header{}
+	if key != "" {
+		h.Set("Idempotency-Key", key)
+	}
+	return e.DoWith("POST", "/v1/invoices/"+invoiceID+"/pay", e.Acme.Key, body, h)
+}
+
+func newInvoice(t *testing.T, e *apitest.Env, email string, amount int) string {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", email)
+	var inv struct{ ID string }
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": c.ID, "currency": "USD",
+		"lines": []map[string]any{{"description": "Work", "quantity": 1, "unit_amount": amount}}}, &inv)
+	return inv.ID
+}
+
+func TestPayIdempotencyKey(t *testing.T) {
+	e := apitest.New(t)
+	inv := newInvoice(t, e, "jane@example.com", 1000)
+	other := newInvoice(t, e, "john@example.com", 2000)
+	visa := `{"payment_method":"pm_card_visa"}`
+	first := payWithKey(e, "order-1", inv, visa)
+	if first.Code != http.StatusOK || first.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("first: %s", first)
+	}
+	again := payWithKey(e, "order-1", inv, visa)
+	if again.Code != http.StatusOK || string(again.Body) != string(first.Body) || again.Header.Get("Idempotent-Replayed") != "true" {
+		t.Fatalf("replay: %s %v", again, again.Header)
+	}
+	for _, r := range []*apitest.Response{payWithKey(e, "order-1", other, visa), payWithKey(e, "order-1", inv, `{"payment_method":"pm_card_mastercard"}`)} {
+		if r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "idempotency_key_reused" {
+			t.Fatalf("reused key: %s", r)
+		}
+	}
+	if r := e.DoWith("POST", "/v1/invoices/"+other+"/pay", e.Globex.Key, visa, http.Header{"Idempotency-Key": {"order-1"}}); r.Code != http.StatusNotFound {
+		t.Fatalf("Globex's own use of the key: %s", r)
+	}
+	for _, bad := range []string{strings.Repeat("k", 256), "tab\there", "café"} {
+		if r := payWithKey(e, bad, other, visa); r.Code != http.StatusBadRequest || r.Map(t)["error"] != "invalid_idempotency_key" {
+			t.Fatalf("key %q: %s", bad, r)
+		}
+	}
+	e.Clock.Advance(24*time.Hour + time.Second)
+	if r := payWithKey(e, "order-1", other, visa); r.Code != http.StatusOK || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("a key 24 hours later counts as new: %s", r)
+	}
+	if n := len(e.Gateway.Charges()); n != 2 {
+		t.Fatalf("%d charges, want 2", n)
+	}
+}
+
+func TestPayServerErrorsAreNotKept(t *testing.T) {
+	e := apitest.New(t)
+	inv := newInvoice(t, e, "jane@example.com", 1000)
+	if r := payWithKey(e, "k", inv, `{"payment_method":"pm_gateway_down"}`); r.Code != http.StatusServiceUnavailable {
+		t.Fatalf("gateway down: %s", r)
+	}
+	if r := payWithKey(e, "k", inv, `{"payment_method":"pm_gateway_down"}`); r.Code != http.StatusServiceUnavailable || r.Header.Get("Idempotent-Replayed") != "" {
+		t.Fatalf("a 503 was replayed: %s", r)
+	}
+	if n := len(e.Gateway.Calls()); n != 2 {
+		t.Fatalf("the retry did not try the payment again: %d calls", n)
+	}
+}
+
+func TestPayInProgress(t *testing.T) {
+	e := apitest.New(t)
+	inv := newInvoice(t, e, "jane@example.com", 1000)
+	entered, release := make(chan struct{}), make(chan struct{})
+	e.Gateway.OnCharge = func(payments.ChargeRequest) {
+		select {
+		case <-entered:
+		default:
+			close(entered)
+			<-release
+		}
+	}
+	serve := func(key string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest("POST", "/v1/invoices/"+inv+"/pay", strings.NewReader(`{"payment_method":"pm_card_visa"}`))
+		req.Header.Set("Authorization", "Bearer "+e.Acme.Key)
+		if key != "" {
+			req.Header.Set("Idempotency-Key", key)
+		}
+		rec := httptest.NewRecorder()
+		e.Server.ServeHTTP(rec, req)
+		return rec
+	}
+	done := make(chan *httptest.ResponseRecorder, 1)
+	go func() { done <- serve("slow") }()
+	<-entered
+	if r := serve("slow"); r.Code != http.StatusConflict || !strings.Contains(r.Body.String(), `"request_in_progress"`) {
+		t.Fatalf("the same key meanwhile: %d %s", r.Code, r.Body)
+	}
+	if r := serve(""); r.Code != http.StatusConflict || !strings.Contains(r.Body.String(), `"payment_in_progress"`) {
+		t.Fatalf("another pay request meanwhile: %d %s", r.Code, r.Body)
+	}
+	close(release)
+	if r := <-done; r.Code != http.StatusOK {
+		t.Fatalf("the first request: %d %s", r.Code, r.Body)
+	}
+	if n := len(e.Gateway.Charges()); n != 1 {
+		t.Fatalf("%d charges", n)
+	}
+}
