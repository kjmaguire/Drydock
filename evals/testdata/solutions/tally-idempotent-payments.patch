 // payInvoice charges an invoice: {"payment_method": "pm_..."}, or the customer's default payment method when it is absent.
+//
+// With an Idempotency-Key header (1 to 255 printable ASCII characters, one namespace per organization), the first response
+// for the key is kept for IdempotencyTTL and a repeat of the request (the same invoice and body) gets it again, with
+// Idempotent-Replayed: true, and charges nothing. The key with another invoice or body is refused, and so is a repeat while
+// the first request is still being handled. Responses with a 5xx status are not kept, so a retry pays again.
 func (s *Server) payInvoice(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	key, present, ok := idempotencyKey(r)
+	if !ok {
+		writeError(w, http.StatusBadRequest, "invalid_idempotency_key", "the Idempotency-Key is 1 to 255 printable ASCII characters")
+		return
+	}
+	body, err := io.ReadAll(io.LimitReader(r.Body, 1<<20))
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_json", "the body could not be read: "+err.Error())
+		return
+	}
+	if !present {
+		s.charge(w, r, p, body)
+		return
+	}
+	k := idemKey{org: p.OrgID, key: key}
+	now := s.clock.Now()
+	state, kept := s.idem.begin(k, idemFingerprint(r.PathValue("id"), body), now)
+	switch state {
+	case idemInProgress:
+		writeError(w, http.StatusConflict, "request_in_progress", "a request with this Idempotency-Key is still being handled; try again later")
+		return
+	case idemReused:
+		writeError(w, http.StatusUnprocessableEntity, "idempotency_key_reused", "this Idempotency-Key was used for another request")
+		return
+	case idemReplay:
+		if kept.contentType != "" {
+			w.Header().Set("Content-Type", kept.contentType)
+		}
+		w.Header().Set("Idempotent-Replayed", "true")
+		w.WriteHeader(kept.status)
+		_, _ = w.Write(kept.body)
+		return
+	}
+	settled := false
+	defer func() {
+		if !settled {
+			s.idem.abort(k) // the handler panicked: free the key
+		}
+	}()
+	rec := newResponseCapture()
+	s.charge(rec, r, p, body)
+	if rec.status >= 500 {
+		s.idem.abort(k)
+	} else {
+		s.idem.finish(k, rec.status, rec.header.Get("Content-Type"), bytes.Clone(rec.body.Bytes()), now.Add(IdempotencyTTL))
+	}
+	settled = true
+	rec.sendTo(w)
+}
