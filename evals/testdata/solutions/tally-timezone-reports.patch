+func reportStore(t *testing.T, zone string, pays ...store.Payment) (*store.Store, string) {
+	t.Helper()
+	st := store.New()
+	at := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	o, err := st.CreateOrg("A", store.OrgTeam, zone, 0, at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, _ := st.CreateCustomer(o.ID, "Jane", "jane@example.com", at)
+	inv, _ := st.CreateInvoice(store.Invoice{OrgID: o.ID, CustomerID: c.ID, Currency: money.USD, Lines: []store.Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, at)
+	for _, p := range pays {
+		p.OrgID, p.InvoiceID = o.ID, inv.ID
+		if p.Status == "" {
+			p.Status = store.PaymentSucceeded
+		}
+		if _, err := st.CreatePayment(p, p.CreatedAt); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return st, o.ID
+}
+
+func pay(at string, amount int64, cur money.Currency) store.Payment {
+	t, err := time.Parse(time.RFC3339, at)
+	if err != nil {
+		panic(err)
+	}
+	return store.Payment{Amount: amount, Currency: cur, CreatedAt: t}
+}
+
+func checkBuckets(t *testing.T, rep Report, want []Bucket) {
+	t.Helper()
+	if len(rep.Buckets) != len(want) {
+		t.Fatalf("buckets = %+v, want %+v", rep.Buckets, want)
+	}
+	for i, w := range want {
+		g := rep.Buckets[i]
+		if g.Start != w.Start || g.Payments != w.Payments || len(g.Amounts) != len(w.Amounts) || g.Amounts == nil {
+			t.Fatalf("bucket %d = %+v, want %+v", i, g, w)
+		}
+		for c, a := range w.Amounts {
+			if g.Amounts[c] != a {
+				t.Fatalf("bucket %d = %+v, want %+v", i, g, w)
+			}
+		}
+	}
+}
+
+func TestRevenueReportDaysInTheOrganizationsTimeZone(t *testing.T) {
+	failed := pay("2026-03-08T12:00:00Z", 999, money.USD)
+	failed.Status = store.PaymentFailed
+	st, org := reportStore(t, "America/New_York",
+		pay("2026-03-07T04:59:00Z", 1, money.USD),  // March 6, 23:59 in New York: before the report
+		pay("2026-03-08T04:59:00Z", 2, money.USD),  // March 7, 23:59
+		pay("2026-03-08T05:01:00Z", 4, money.USD),  // March 8, 00:01 (a 23-hour day)
+		pay("2026-03-09T03:59:00Z", 8, money.EUR),  // March 8, 23:59
+		pay("2026-03-09T04:01:00Z", 16, money.USD), // March 9, 00:01
+		failed,
+	)
+	rep, err := RevenueReport(st, org, "2026-03-07", "2026-03-10", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rep.TimeZone != "America/New_York" || rep.Group != ByDay {
+		t.Fatalf("report = %+v", rep)
+	}
+	checkBuckets(t, rep, []Bucket{
+		{Start: "2026-03-07", Amounts: map[money.Currency]int64{money.USD: 2}, Payments: 1},
+		{Start: "2026-03-08", Amounts: map[money.Currency]int64{money.USD: 4, money.EUR: 8}, Payments: 2},
+		{Start: "2026-03-09", Amounts: map[money.Currency]int64{money.USD: 16}, Payments: 1},
+		{Start: "2026-03-10", Amounts: map[money.Currency]int64{}, Payments: 0},
+	})
+}
+
+func TestRevenueReportWeeksAndMonths(t *testing.T) {
+	st, org := reportStore(t, "America/New_York",
+		pay("2026-03-03T17:00:00Z", 1, money.USD),  // Tuesday March 3: before the weeks' from
+		pay("2026-03-09T03:59:00Z", 2, money.USD),  // Sunday March 8, 23:59
+		pay("2026-03-09T04:01:00Z", 4, money.USD),  // Monday March 9, 00:01
+		pay("2026-04-01T03:59:00Z", 8, money.USD),  // March 31, 23:59
+		pay("2026-04-11T04:01:00Z", 16, money.USD), // April 11: after to
+	)
+	rep, err := RevenueReport(st, org, "2026-03-04", "2026-03-17", ByWeek)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkBuckets(t, rep, []Bucket{
+		{Start: "2026-03-02", Amounts: map[money.Currency]int64{money.USD: 2}, Payments: 1},
+		{Start: "2026-03-09", Amounts: map[money.Currency]int64{money.USD: 4}, Payments: 1},
+		{Start: "2026-03-16", Amounts: map[money.Currency]int64{}, Payments: 0},
+	})
+	rep, err = RevenueReport(st, org, "2026-02-15", "2026-04-10", ByMonth)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkBuckets(t, rep, []Bucket{
+		{Start: "2026-02-01", Amounts: map[money.Currency]int64{}, Payments: 0},
+		{Start: "2026-03-01", Amounts: map[money.Currency]int64{money.USD: 15}, Payments: 4},
+		{Start: "2026-04-01", Amounts: map[money.Currency]int64{}, Payments: 0},
+	})
+}
+
+func TestRevenueReportErrors(t *testing.T) {
+	st, org := reportStore(t, "America/New_York")
+	for _, c := range []struct {
+		from, to string
+		group    Group
+		want     error
+	}{
+		{"", "2026-03-05", "", ErrInvalidDate},
+		{"2026-03-01", "2026-02-30", "", ErrInvalidDate},
+		{"2026-03-05", "2026-03-01", "", ErrInvalidRange},
+		{"2026-01-01", "2027-01-02", "", ErrInvalidRange}, // 367 days
+		{"2025-03-08", "2026-03-09", "", ErrInvalidRange}, // 367 days, one of them 23 hours long
+		{"2026-01-01", "2026-01-31", "year", ErrInvalidGroup},
+	} {
+		if _, err := RevenueReport(st, org, c.from, c.to, c.group); !errors.Is(err, c.want) {
+			t.Errorf("RevenueReport(%s, %s, %s) = %v, want %v", c.from, c.to, c.group, err, c.want)
+		}
+	}
+	rep, err := RevenueReport(st, org, "2025-03-08", "2026-03-08", ByDay) // 366 days
+	if err != nil || len(rep.Buckets) != 366 || rep.Buckets[365].Start != "2026-03-08" {
+		t.Fatalf("366 days: %d buckets, %v", len(rep.Buckets), err)
+	}
+}
