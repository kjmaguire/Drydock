+
+// Group is how a revenue report puts days together.
+type Group string
+
+// Groups.
+const (
+	ByDay   Group = "day"
+	ByWeek  Group = "week"  // weeks start on Monday
+	ByMonth Group = "month" // calendar months
+)
+
+// Bucket is what an organization took in one day, week or month, per currency.
+type Bucket struct {
+	Start    string                   `json:"start"` // YYYY-MM-DD: the bucket's first day, even when it is before the report's
+	Amounts  map[money.Currency]int64 `json:"amounts"`
+	Payments int                      `json:"payments"`
+}
+
+// Report is the money an organization took, bucket by bucket.
+type Report struct {
+	TimeZone string   `json:"time_zone"`
+	Group    Group    `json:"group"`
+	Buckets  []Bucket `json:"buckets"`
+}
+
+// RevenueReport adds up the organization's succeeded payments per day, week or month (group; "" is ByDay) of the
+// organization's time zone, from the day from to the day to (YYYY-MM-DD in that time zone, both included). A payment
+// belongs to the day, in that time zone, when it was made, so days are as long as they really are there (23 or 25 hours
+// when daylight saving time starts or ends). Every bucket from the one holding from to the one holding to is in the
+// report, in order, also those without payments; a bucket only counts payments from from to to.
+func RevenueReport(st *store.Store, orgID, from, to string, group Group) (Report, error) {
+	first, err := time.Parse(time.DateOnly, from)
+	if err != nil {
+		return Report{}, fmt.Errorf("%w: from %q", ErrInvalidDate, from)
+	}
+	last, err := time.Parse(time.DateOnly, to)
+	if err != nil {
+		return Report{}, fmt.Errorf("%w: to %q", ErrInvalidDate, to)
+	}
+	// first and last are dates (midnight UTC, where every day has 24 hours), not instants
+	if last.Before(first) {
+		return Report{}, fmt.Errorf("%w: to is before from", ErrInvalidRange)
+	}
+	if days := int(last.Sub(first)/(24*time.Hour)) + 1; days > MaxDays {
+		return Report{}, fmt.Errorf("%w: %d days, at most %d", ErrInvalidRange, days, MaxDays)
+	}
+	if group == "" {
+		group = ByDay
+	}
+	if group != ByDay && group != ByWeek && group != ByMonth {
+		return Report{}, fmt.Errorf("%w: %q, use day, week or month", ErrInvalidGroup, group)
+	}
+	org, ok := st.Org(orgID)
+	if !ok {
+		return Report{}, store.ErrNotFound
+	}
+	loc, err := time.LoadLocation(org.TimeZone)
+	if err != nil {
+		return Report{}, fmt.Errorf("organization %s: time zone %q: %w", orgID, org.TimeZone, err)
+	}
+	rep := Report{TimeZone: org.TimeZone, Group: group, Buckets: []Bucket{}}
+	index := map[time.Time]int{}
+	for b := group.start(first); !b.After(last); b = group.next(b) {
+		index[b] = len(rep.Buckets)
+		rep.Buckets = append(rep.Buckets, Bucket{Start: b.Format(time.DateOnly), Amounts: map[money.Currency]int64{}})
+	}
+	for _, p := range st.Payments(orgID, "") {
+		if p.Status != store.PaymentSucceeded {
+			continue
+		}
+		local := p.CreatedAt.In(loc)
+		day := time.Date(local.Year(), local.Month(), local.Day(), 0, 0, 0, 0, time.UTC)
+		if day.Before(first) || day.After(last) {
+			continue
+		}
+		b := &rep.Buckets[index[group.start(day)]]
+		b.Amounts[p.Currency] += p.Amount
+		b.Payments++
+	}
+	return rep, nil
+}
+
+// start is the first day of the bucket holding day (a date at midnight UTC).
+func (g Group) start(day time.Time) time.Time {
+	switch g {
+	case ByWeek:
+		return day.AddDate(0, 0, -((int(day.Weekday()) + 6) % 7)) // back to Monday
+	case ByMonth:
+		return time.Date(day.Year(), day.Month(), 1, 0, 0, 0, 0, time.UTC)
+	}
+	return day
+}
+
+// next is the first day of the bucket after the one starting on start.
+func (g Group) next(start time.Time) time.Time {
+	switch g {
+	case ByWeek:
+		return start.AddDate(0, 0, 7)
+	case ByMonth:
+		return start.AddDate(0, 1, 0)
+	}
+	return start.AddDate(0, 0, 1)
+}
