+	sub, err := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []time.Time{day(2027, 1, 31), day(2027, 2, 28), day(2027, 3, 31), day(2027, 4, 30), day(2027, 5, 31)}
+	for i := 1; i < len(want)-1; i++ {
