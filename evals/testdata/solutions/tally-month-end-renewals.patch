+
+func TestPeriodStartKeepsTheAnchorDay(t *testing.T) {
+	anchor := time.Date(2027, 1, 31, 23, 59, 59, 0, time.UTC)
+	want := []string{"2027-01-31", "2027-02-28", "2027-03-31", "2027-04-30", "2027-05-31", "2027-06-30", "2027-07-31",
+		"2027-08-31", "2027-09-30", "2027-10-31", "2027-11-30", "2027-12-31", "2028-01-31", "2028-02-29", "2028-03-31"}
+	for n, w := range want {
+		got := PeriodStart(anchor, store.Monthly, n)
+		if got.Format(time.DateOnly) != w || got.Format("15:04:05") != "23:59:59" {
+			t.Errorf("period %d starts %v, want %s at 23:59:59", n, got, w)
+		}
+	}
+	leap := time.Date(2028, 2, 29, 12, 0, 0, 0, time.UTC)
+	for n, w := range []string{"2028-02-29", "2029-02-28", "2030-02-28", "2031-02-28", "2032-02-29"} {
+		if got := PeriodStart(leap, store.Yearly, n).Format(time.DateOnly); got != w {
+			t.Errorf("yearly period %d starts %s, want %s", n, got, w)
+		}
+	}
+}
+
+func TestPeriodEnd(t *testing.T) {
+	anchor := time.Date(2027, 1, 31, 10, 0, 0, 0, time.UTC)
+	for _, c := range []struct{ start, want time.Time }{
+		{anchor, time.Date(2027, 2, 28, 10, 0, 0, 0, time.UTC)},
+		{time.Date(2027, 2, 28, 10, 0, 0, 0, time.UTC), time.Date(2027, 3, 31, 10, 0, 0, 0, time.UTC)},
+		// a period that drifted under an older version goes back to the anchor's day
+		{time.Date(2027, 3, 3, 10, 0, 0, 0, time.UTC), time.Date(2027, 3, 31, 10, 0, 0, 0, time.UTC)},
+	} {
+		if got := PeriodEnd(anchor, c.start, store.Monthly); !got.Equal(c.want) {
+			t.Errorf("PeriodEnd(%v) = %v, want %v", c.start, got, c.want)
+		}
+	}
+}
