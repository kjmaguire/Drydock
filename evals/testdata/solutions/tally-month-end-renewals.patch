 }
 
-// AddInterval returns t moved forward by one billing interval: a month or a year.
+// AddInterval returns t moved forward by one billing interval: a month or a year, on t's day of the month at t's time of
+// day, or on the last day of the target month when that month is shorter (January 31 plus a month is February 28, or 29 in
+// a leap year). The result is in UTC.
+//
+// Adding an interval to the end of the previous period drifts after a short month (January 31, February 28, March 28);
+// billing periods are therefore counted from the subscription's anchor with PeriodStart and PeriodEnd.
 func AddInterval(t time.Time, iv store.Interval) time.Time {
+	return PeriodStart(t, iv, 1)
+}
+
+// PeriodStart returns when billing period n (n = 0, 1, 2, ...) of a subscription anchored at anchor starts: n months (or n
+// years) after the anchor, on the anchor's day of the month at the anchor's time of day, or on the last day of that month
+// when the month is shorter. Period 0 starts at the anchor. The result is in UTC.
+func PeriodStart(anchor time.Time, iv store.Interval, n int) time.Time {
+	anchor = anchor.UTC()
+	months := n
+	if iv == store.Yearly {
+		months = 12 * n
+	}
+	y, m, day := anchor.Date()
+	// The first day of the target month: it never overflows into the following month, whatever the anchor's day.
+	ty, tm, _ := time.Date(y, m+time.Month(months), 1, 0, 0, 0, 0, time.UTC).Date()
+	if last := daysIn(ty, tm); day > last {
+		day = last
+	}
+	h, mi, s := anchor.Clock()
+	return time.Date(ty, tm, day, h, mi, s, anchor.Nanosecond(), time.UTC)
+}
+
+// PeriodEnd returns when the billing period that starts at start ends: the first period start of the anchor's schedule
+// (PeriodStart) after start. For a period that starts on the schedule, that is the start of the next period. A period that
+// starts off the schedule (a subscription renewed by an older version of Tally) ends at the next date on it, so the
+// subscription goes back to its anchor's day.
+func PeriodEnd(anchor, start time.Time, iv store.Interval) time.Time {
+	anchor, start = anchor.UTC(), start.UTC()
+	step := 1
 	if iv == store.Yearly {
-		return t.AddDate(1, 0, 0)
+		step = 12
+	}
+	ay, am, _ := anchor.Date()
+	sy, sm, _ := start.Date()
+	n := max(((sy-ay)*12+int(sm-am))/step, 0)
+	for {
+		if p := PeriodStart(anchor, iv, n); p.After(start) {
+			return p
+		}
+		n++
 	}
-	return t.AddDate(0, 1, 0)
+}
+
+// daysIn returns the number of days of a month.
+func daysIn(y int, m time.Month) int {
+	return time.Date(y, m+1, 0, 0, 0, 0, 0, time.UTC).Day()
 }
