+		{at(2027, 1, 31), at(2027, 2, 28), store.Monthly},
+		{at(2028, 1, 31), at(2028, 2, 29), store.Monthly},
+		{at(2027, 3, 31), at(2027, 4, 30), store.Monthly},
+		{at(2027, 12, 31), at(2028, 1, 31), store.Monthly},
