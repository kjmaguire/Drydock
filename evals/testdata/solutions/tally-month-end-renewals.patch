+// periodsOf returns the periods of a subscription's invoices, oldest first, as "start/end" in RFC 3339.
+func periodsOf(t *testing.T, e *apitest.Env, subID string) []string {
+	t.Helper()
+	var out []string
+	for _, inv := range e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: subID}) {
+		if inv.PeriodStart == nil || inv.PeriodEnd == nil {
+			t.Fatalf("invoice %s has no period", inv.ID)
+		}
+		out = append(out, inv.PeriodStart.Format(time.RFC3339)+"/"+inv.PeriodEnd.Format(time.RFC3339))
+	}
+	return out
+}
+
+func periods(bounds ...time.Time) []string {
+	var out []string
+	for i := 0; i+1 < len(bounds); i++ {
+		out = append(out, bounds[i].Format(time.RFC3339)+"/"+bounds[i+1].Format(time.RFC3339))
+	}
+	return out
+}
