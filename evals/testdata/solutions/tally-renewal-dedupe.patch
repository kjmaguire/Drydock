+// subscribe starts a monthly subscription for a new customer whose default payment method is pm_card_visa, then switches
+// the customer to method.
+func subscribe(t *testing.T, e *apitest.Env, email, method string) store.Subscription {
+	t.Helper()
+	c := e.CreateCustomer(e.Acme, "Jane", email)
+	setMethod := func(m string) {
+		if _, err := e.Store.UpdateCustomer(e.Acme.ID, c.ID, func(c *store.Customer) error { c.DefaultPaymentMethod = m; return nil }); err != nil {
+			t.Fatal(err)
+		}
+	}
+	setMethod("pm_card_visa")
+	p := e.CreatePlan(e.Acme, "Team "+email, "USD", "20.00")
+	sub, err := e.Subs.Create(context.Background(), e.Acme.ID, subscriptions.CreateInput{CustomerID: c.ID, PlanID: p.ID, Quantity: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	setMethod(method)
+	return sub
+}
