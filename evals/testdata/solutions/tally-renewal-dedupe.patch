+// ErrAlreadyRenewed is returned by RenewSubscription when the subscription is no longer in the period the caller saw: another
+// caller (another server instance) renewed or canceled it first.
+var ErrAlreadyRenewed = fmt.Errorf("%w: the subscription was renewed already", ErrConflict)
+
+// RenewSubscription ends a subscription's current period, which ends at periodEnd, in one step: it changes the subscription
+// with change (to its next period, or canceled) and stores inv, when not nil, as the invoice of the renewal. When the
+// subscription is canceled or its current period no longer ends at periodEnd, nothing changes and ErrAlreadyRenewed is
+// returned, so a period is renewed, and invoiced, once however many callers try at the same time. When inv cannot be
+// stored, nothing changes either.
+func (s *Store) RenewSubscription(orgID, id string, periodEnd time.Time, change func(*Subscription), inv *Invoice, now time.Time) (Subscription, Invoice, error) {
+	if inv != nil {
+		if err := checkInvoice(*inv); err != nil {
+			return Subscription{}, Invoice{}, err
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	old, ok := s.subs[id]
+	if !ok || old.OrgID != orgID {
+		return Subscription{}, Invoice{}, ErrNotFound
+	}
+	if old.Status == Canceled || !old.CurrentPeriodEnd.Equal(periodEnd) {
+		return Subscription{}, Invoice{}, ErrAlreadyRenewed
+	}
+	sub := copySub(old)
+	change(&sub)
+	sub.ID, sub.OrgID, sub.CustomerID, sub.PlanID, sub.CreatedAt = old.ID, old.OrgID, old.CustomerID, old.PlanID, old.CreatedAt
+	var created Invoice
+	if inv != nil {
+		in := *inv
+		in.OrgID, in.SubscriptionID = orgID, id
+		var err error
+		if created, err = s.createInvoice(in, now); err != nil {
+			return Subscription{}, Invoice{}, err
+		}
+	}
+	s.subs[id] = sub
+	return copySub(sub), created, nil
+}
