+func TestConcurrentRenewalsInvoiceOnce(t *testing.T) {
+	e := apitest.New(t)
+	var subs []store.Subscription
+	for _, email := range []string{"a@example.com", "b@example.com", "c@example.com"} {
+		subs = append(subs, subscribe(t, e, email, "pm_card_visa"))
+	}
+	e.Clock.Set(subs[0].CurrentPeriodEnd)
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ { // eight server instances
+		pay := &payments.Service{Store: e.Store, Gateway: e.Gateway, Clock: e.Clock, Publisher: e.Webhooks}
+		instance := &subscriptions.Service{Store: e.Store, Payments: pay, Clock: e.Clock, Publisher: e.Webhooks}
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, _ = instance.RenewDue(context.Background())
+		}()
+	}
+	wg.Wait()
+	for _, sub := range subs {
+		if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID}); len(invs) != 2 {
+			t.Fatalf("%s has %d invoices, want 2", sub.ID, len(invs))
+		}
+	}
+	if n := len(e.Gateway.Charges()); n != 6 {
+		t.Fatalf("%d charges, want 6", n)
+	}
+}
+
+func TestRenewalWithTheGatewayDown(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	down := subscribe(t, e, "down@example.com", "pm_gateway_down")
+	fine := subscribe(t, e, "fine@example.com", "pm_card_visa")
+	e.Clock.Set(down.CurrentPeriodEnd)
+	n, err := e.Subs.RenewDue(ctx)
+	if n != 2 || err == nil {
+		t.Fatalf("RenewDue = %d, %v; want both renewed and the gateway's error", n, err)
+	}
+	got, _ := e.Store.Subscription(e.Acme.ID, down.ID)
+	if got.Status != store.Active || !got.CurrentPeriodStart.Equal(down.CurrentPeriodEnd) {
+		t.Fatalf("after the renewal = %+v, want the next period, still active", got)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: down.ID})
+	if len(invs) != 2 || invs[1].Status != store.InvoiceOpen {
+		t.Fatalf("invoices = %+v, want the renewal's open", invs)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: fine.ID}); len(invs) != 2 || invs[1].Status != store.InvoicePaid {
+		t.Fatalf("the other subscription's invoices = %+v", invs)
+	}
+	if n, err := e.Subs.RenewDue(ctx); n != 0 || err != nil {
+		t.Fatalf("the next run = %d, %v; want nothing to do", n, err)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: down.ID}); len(invs) != 2 {
+		t.Fatalf("the period was invoiced again: %+v", invs)
+	}
