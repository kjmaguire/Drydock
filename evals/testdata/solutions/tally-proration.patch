+func TestProrate(t *testing.T) {
+	day := 24 * time.Hour
+	for _, c := range []struct {
+		value             int64
+		remaining, length time.Duration
+		want              int64
+	}{
+		{4000, 21 * day, 31 * day, 2710},             // 2709.68
+		{999, 14 * day, 28 * day, 500},               // 499.5 rounds away from zero
+		{-999, 14 * day, 28 * day, -500},             // and so does -499.5
+		{999, 5 * day, 30 * day, 167},                // 166.5
+		{2000, 0, 31 * day, 0},                       // at the end of the period
+		{2000, 40 * day, 31 * day, 2000},             // never more than the whole period
+		{1 << 40, 30 * day, 31 * day, 1064043510751}, // no overflow
+	} {
+		if got := Prorate(c.value, c.remaining, c.length); got != c.want {
+			t.Errorf("Prorate(%d, %v, %v) = %d, want %d", c.value, c.remaining, c.length, got, c.want)
+		}
+	}
+}
