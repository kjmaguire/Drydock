+// Prorate returns the part of value that falls in remaining out of a period of length: value * remaining / length, with
+// both durations counted in whole seconds, rounded half away from zero to a whole minor unit. remaining is held between 0
+// and length. The arithmetic is exact, whatever the size of the numbers.
+func Prorate(value int64, remaining, length time.Duration) int64 {
+	n := int64(length / time.Second)
+	if n <= 0 {
+		return 0
+	}
+	r := min(max(int64(remaining/time.Second), 0), n)
+	num := new(big.Int).Mul(big.NewInt(value), big.NewInt(r))
+	den := big.NewInt(n)
+	q, rem := new(big.Int).QuoRem(num, den, new(big.Int))
+	// Half away from zero: move the truncated quotient one step away from zero when the remainder is at least half.
+	if new(big.Int).Abs(new(big.Int).Lsh(rem, 1)).Cmp(den) >= 0 {
+		q.Add(q, big.NewInt(int64(num.Sign())))
+	}
+	return q.Int64()
+}
