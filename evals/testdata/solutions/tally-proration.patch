+// invoiceUpgrade bills an upgrade made at now with an invoice of two lines: a credit for the unused time of the current
+// period at the old value and a charge for its remaining time at the new value. It charges the invoice like a renewal
+// invoice and reports false when the charge was declined. When the gateway is unavailable the invoice stays open, to be
+// paid later.
+func (s *Service) invoiceUpgrade(ctx context.Context, sub store.Subscription, oldPlan, newPlan store.Plan, oldValue, newValue int64, now time.Time) (bool, error) {
+	length := sub.CurrentPeriodEnd.Sub(sub.CurrentPeriodStart)
+	remaining := sub.CurrentPeriodEnd.Sub(now)
+	lines := []store.Line{
+		{Description: "Unused time on " + oldPlan.Name, Quantity: 1, UnitAmount: -billing.Prorate(oldValue, remaining, length)},
+		{Description: "Remaining time on " + newPlan.Name, Quantity: 1, UnitAmount: billing.Prorate(newValue, remaining, length)},
+	}
+	ps, pe := now, sub.CurrentPeriodEnd
+	inv, err := s.Store.CreateInvoice(store.Invoice{OrgID: sub.OrgID, CustomerID: sub.CustomerID, SubscriptionID: sub.ID, Currency: newPlan.Currency,
+		Lines: lines, DiscountPercent: sub.DiscountPercent, PeriodStart: &ps, PeriodEnd: &pe}, now)
+	if err != nil {
+		return false, err
+	}
+	s.publish(ctx, sub.OrgID, "invoice.created", map[string]any{"invoice_id": inv.ID, "subscription_id": sub.ID})
+	paid, err := s.charge(ctx, sub.OrgID, inv.ID)
+	if errors.Is(err, payments.ErrUnavailable) {
+		return true, nil
+	}
+	return paid, err
+}
