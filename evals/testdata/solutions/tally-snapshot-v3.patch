+			return fmt.Errorf("%w: next invoice number %d of organization %q", ErrInvalid, n, org)
+		}
+		s.invoiceNo[org] = n - 1
+	}
+	used := map[string]string{} // organization ID and number -> invoice ID
+	var unnumbered []Invoice
+	for _, inv := range s.invoices {
+		if inv.Number == "" {
+			unnumbered = append(unnumbered, inv)
+			continue
+		}
+		n, ok := ParseInvoiceNumber(inv.Number)
+		if !ok {
+			return fmt.Errorf("%w: invoice %s has the number %q", ErrInvalid, inv.ID, inv.Number)
+		}
+		key := inv.OrgID + " " + inv.Number
+		if other, ok := used[key]; ok {
+			return fmt.Errorf("%w: invoices %s and %s have the number %s", ErrInvalid, other, inv.ID, inv.Number)
+		}
+		used[key] = inv.ID
+		s.invoiceNo[inv.OrgID] = max(s.invoiceNo[inv.OrgID], n)
+	}
+	sort.Slice(unnumbered, func(i, j int) bool {
+		if !unnumbered[i].CreatedAt.Equal(unnumbered[j].CreatedAt) {
+			return unnumbered[i].CreatedAt.Before(unnumbered[j].CreatedAt)
+		}
+		return unnumbered[i].ID < unnumbered[j].ID
+	})
+	for _, inv := range unnumbered {
+		s.invoiceNo[inv.OrgID]++
+		inv.Number = InvoiceNumber(s.invoiceNo[inv.OrgID])
+		s.invoices[inv.ID] = inv
+	}
+	return nil
+}
