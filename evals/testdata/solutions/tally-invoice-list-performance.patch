+// The invoice list answers each page quickly for a large organization, and its pages hold the whole list in order.
+func TestInvoiceListIsFastForALargeOrganization(t *testing.T) {
+	e := apitest.New(t)
+	at := apitest.Start.Add(-90 * 24 * time.Hour)
+	var customers []store.Customer
+	for i := range 5000 {
+		c, err := e.Store.CreateCustomer(e.Acme.ID, fmt.Sprintf("C%d", i), fmt.Sprintf("c%d@example.com", i), at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		customers = append(customers, c)
+	}
+	g := e.CreateCustomer(e.Globex, "Gus", "gus@example.com")
+	const n = 60000
+	for i := range n {
+		inv := store.Invoice{OrgID: e.Acme.ID, CustomerID: customers[i%5000].ID, Currency: "USD", Lines: []store.Line{{Description: "x", Quantity: 1, UnitAmount: 100}}}
+		if _, err := e.Store.CreateInvoice(inv, at.Add(time.Duration(i/2)*time.Second)); err != nil {
+			t.Fatal(err)
+		}
+		if i%2 == 0 {
+			_, _ = e.Store.CreateInvoice(store.Invoice{OrgID: e.Globex.ID, CustomerID: g.ID, Currency: "EUR"}, at)
+		}
+	}
+	timed := func(query string) []string {
+		t.Helper()
+		var page struct {
+			Items []struct {
+				ID string `json:"id"`
+			}
+			NextCursor string `json:"next_cursor"`
+		}
+		var fastest time.Duration
+		for try := range 5 {
+			start := time.Now()
+			e.MustDo(http.StatusOK, "GET", "/v1/invoices?"+query, e.Acme.Key, nil, &page)
+			if d := time.Since(start); try == 0 || d < fastest {
+				fastest = d
+			}
+			if fastest < 250*time.Millisecond {
+				break
+			}
+		}
+		if fastest >= 250*time.Millisecond {
+			t.Fatalf("GET /v1/invoices?%s took %s", query, fastest)
+		}
+		ids := []string{}
+		for _, it := range page.Items {
+			ids = append(ids, it.ID)
+		}
+		return append(ids, page.NextCursor)
+	}
+	seen, cursor := 0, ""
+	for cursor != "" || seen == 0 {
+		got := timed("limit=100&cursor=" + url.QueryEscape(cursor))
+		seen += len(got) - 1
+		cursor = got[len(got)-1]
+	}
+	if seen != n {
+		t.Fatalf("the pages hold %d invoices, want %d", seen, n)
+	}
+	timed("status=open")
+	timed("customer_id=" + customers[1234].ID)
+}
