+func TestInvoicePagesFollowTheList(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	ca1, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	ca2, _ := s.CreateCustomer(a.ID, "John", "john@example.com", t0)
+	cb, _ := s.CreateCustomer(b.ID, "Gus", "gus@example.com", t0)
+	for i := range 60 {
+		// creation times out of creation order, several invoices to a time
+		at := t0.Add(time.Duration((i*7)%20) * time.Minute)
+		c, sub := ca1, ""
+		if i%2 == 1 {
+			c = ca2
+		}
+		if i%5 == 0 {
+			sub = "sub_x"
+		}
+		inv, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, SubscriptionID: sub, Currency: money.USD, Lines: []Line{{Description: "x", Quantity: 1, UnitAmount: 1}}}, at)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i%3 == 0 {
+			_, _ = s.UpdateInvoice(a.ID, inv.ID, func(x *Invoice) error { x.Status = InvoicePaid; return nil })
+		}
+		_, _ = s.CreateInvoice(Invoice{OrgID: b.ID, CustomerID: cb.ID, SubscriptionID: sub, Currency: money.USD}, at)
+	}
+	check := func(s *Store) {
+		t.Helper()
+		for _, f := range []InvoiceFilter{{}, {CustomerID: ca2.ID}, {SubscriptionID: "sub_x"}, {Status: InvoicePaid}, {CustomerID: ca1.ID, Status: InvoiceOpen}, {CustomerID: cb.ID}} {
+			all := s.ListInvoices(a.ID, f)
+			for i := 1; i < len(all); i++ {
+				if !(InvoicePosition{all[i-1].CreatedAt, all[i-1].ID}).Before(InvoicePosition{all[i].CreatedAt, all[i].ID}) {
+					t.Fatalf("ListInvoices(%+v) is out of order at %d", f, i)
+				}
+			}
+			for _, limit := range []int{1, 7, 100} {
+				var got []Invoice
+				var after *InvoicePosition
+				for {
+					page, more := s.InvoicePage(a.ID, f, after, limit)
+					got = append(got, page...)
+					if !more {
+						break
+					}
+					if len(page) != limit {
+						t.Fatalf("filter %+v, limit %d: a page of %d before the end", f, limit, len(page))
+					}
+					last := page[len(page)-1]
+					after = &InvoicePosition{last.CreatedAt, last.ID}
+				}
+				if !reflect.DeepEqual(got, all) && len(got)+len(all) > 0 {
+					t.Fatalf("filter %+v, limit %d: the pages hold %d invoices, the list %d", f, limit, len(got), len(all))
+				}
+			}
+		}
+	}
+	check(s)
+	loaded, err := FromState(s.Export())
+	if err != nil {
+		t.Fatal(err)
+	}
+	check(loaded)
+}
