+// InviteTTL is how long an invite can be accepted after it was created.
+const InviteTTL = 7 * 24 * time.Hour
+
+// ExpiresAt is when the invite stops working.
+func (i Invite) ExpiresAt() time.Time { return i.CreatedAt.Add(InviteTTL) }
+
+// Expired reports whether the invite was created more than InviteTTL before now.
+func (i Invite) Expired(now time.Time) bool { return now.Sub(i.CreatedAt) > InviteTTL }
+
+// Pending reports whether the invite can still be accepted at now: it was neither accepted nor revoked, and has not expired.
+func (i Invite) Pending(now time.Time) bool {
+	return i.AcceptedAt == nil && i.RevokedAt == nil && !i.Expired(now)
+}
