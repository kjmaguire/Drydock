+
+// invite invites email to Acme and returns the invite's ID and the token from the email.
+func invite(t *testing.T, e *apitest.Env, email, role string) (string, string) {
+	t.Helper()
+	var inv struct{ ID string }
+	r := e.MustDo(http.StatusCreated, "POST", "/v1/invites", e.Acme.Key, map[string]string{"email": email, "role": role}, &inv)
+	msgs := e.Mail.Messages()
+	m := regexp.MustCompile(`token=([^\s&]+)`).FindStringSubmatch(msgs[len(msgs)-1].Body)
+	if m == nil {
+		t.Fatalf("no link in %q", msgs[len(msgs)-1].Body)
+	}
+	token, _ := url.QueryUnescape(m[1])
+	if !regexp.MustCompile(`^[A-Za-z0-9_-]{43}$`).MatchString(token) || strings.Contains(string(r.Body), token) {
+		t.Fatalf("token %q, answer %s", token, r)
+	}
+	return inv.ID, token
+}
+
+func accept(e *apitest.Env, token string) *apitest.Response {
+	return e.Do("POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "New Person"})
+}
+
+func wantError(t *testing.T, r *apitest.Response, status int, code string) {
+	t.Helper()
+	if r.Code != status || r.Map(t)["error"] != code {
+		t.Fatalf("want %d %s, got %s", status, code, r)
+	}
+}
+
+func TestInviteTokens(t *testing.T) {
+	e := apitest.New(t)
+	_, viewer := e.AddMember(e.Acme, "viewer@acme.example", store.RoleViewer)
+	id, token := invite(t, e, "new@people.example", "member")
+	var list struct {
+		Items []struct {
+			ID        string    `json:"id"`
+			ExpiresAt time.Time `json:"expires_at"`
+		}
+	}
+	r := e.MustDo(http.StatusOK, "GET", "/v1/invites", viewer, nil, &list)
+	if strings.Contains(string(r.Body), token) || len(list.Items) != 1 || list.Items[0].ID != id || !list.Items[0].ExpiresAt.Equal(apitest.Start.Add(7*24*time.Hour)) {
+		t.Fatalf("invites = %s", r)
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": token, "name": "New"}, nil)
+	wantError(t, accept(e, token), http.StatusGone, "invite_used")
+	wantError(t, accept(e, "nope"), http.StatusNotFound, "invite_not_found")
+
+	revokedID, revoked := invite(t, e, "revoked@people.example", "member")
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/invites/"+revokedID, e.Acme.Key, nil, nil)
+	wantError(t, accept(e, revoked), http.StatusNotFound, "invite_not_found")
+
+	_, expiring := invite(t, e, "late@people.example", "member")
+	e.Clock.Advance(7*24*time.Hour + time.Second)
+	wantError(t, accept(e, expiring), http.StatusGone, "invite_expired")
+	list.Items = nil
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &list)
+	if len(list.Items) != 0 {
+		t.Fatalf("pending invites = %+v", list.Items)
+	}
+}
+
+func TestInvitingAgainReplacesTheInvite(t *testing.T) {
+	e := apitest.New(t)
+	_, first := invite(t, e, "Ann@people.example", "viewer")
+	second, newest := invite(t, e, "ann@PEOPLE.example", "billing")
+	var list struct{ Items []struct{ ID string } }
+	e.MustDo(http.StatusOK, "GET", "/v1/invites", e.Acme.Key, nil, &list)
+	if len(list.Items) != 1 || list.Items[0].ID != second {
+		t.Fatalf("pending invites = %+v", list.Items)
+	}
+	wantError(t, accept(e, first), http.StatusNotFound, "invite_not_found")
+	var accepted struct {
+		Member struct{ Role string } `json:"member"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invites/accept", "", map[string]string{"token": newest, "name": "Ann"}, &accepted)
+	if accepted.Member.Role != "billing" {
+		t.Fatalf("role = %q", accepted.Member.Role)
+	}
+}
