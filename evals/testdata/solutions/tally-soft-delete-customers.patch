+
+func TestSoftDeleteRestoreAndPurge(t *testing.T) {
+	s := New()
+	a := newOrg(t, s, "A")
+	c, _ := s.CreateCustomer(a.ID, "Jane", "jane@example.com", t0)
+	p, _ := s.CreatePlan(Plan{OrgID: a.ID, Name: "Pro", Currency: money.USD, UnitAmount: 100, Interval: Monthly}, t0)
+	sub, _ := s.CreateSubscription(Subscription{OrgID: a.ID, CustomerID: c.ID, PlanID: p.ID, Quantity: 1, Status: Active}, t0)
+	if err := s.SoftDeleteCustomer(a.ID, c.ID, t0); !errors.Is(err, ErrHasActiveSubscriptions) {
+		t.Fatalf("delete with an active subscription: %v", err)
+	}
+	_, _ = s.UpdateSubscription(a.ID, sub.ID, func(x *Subscription) error { x.Status = Canceled; return nil })
+	if err := s.SoftDeleteCustomer(a.ID, c.ID, t0); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := s.Customer(a.ID, c.ID); ok {
+		t.Fatal("a deleted customer is found")
+	}
+	if got, ok := s.CustomerIncludingDeleted(a.ID, c.ID); !ok || got.DeletedAt == nil || !got.DeletedAt.Equal(t0) {
+		t.Fatalf("CustomerIncludingDeleted = %+v, %v", got, ok)
+	}
+	if _, err := s.CreateInvoice(Invoice{OrgID: a.ID, CustomerID: c.ID, Currency: money.USD}, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("an invoice for a deleted customer: %v", err)
+	}
+	other, err := s.CreateCustomer(a.ID, "Other Jane", "JANE@example.com", t0)
+	if err != nil {
+		t.Fatalf("the deleted customer's address is not free: %v", err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, c.ID, t0.Add(time.Hour)); !errors.Is(err, ErrEmailTaken) {
+		t.Fatalf("restore while the address is taken: %v", err)
+	}
+	_ = s.DeleteCustomer(a.ID, other.ID)
+	if _, err := s.RestoreCustomer(a.ID, c.ID, t0.Add(CustomerRestoreWindow)); err != nil {
+		t.Fatalf("restore at the end of the window: %v", err)
+	}
+	if _, err := s.RestoreCustomer(a.ID, c.ID, t0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore a customer that is not deleted: %v", err)
+	}
+	_ = s.SoftDeleteCustomer(a.ID, c.ID, t0)
+	if _, err := s.RestoreCustomer(a.ID, c.ID, t0.Add(CustomerRestoreWindow+time.Second)); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("restore after the window: %v", err)
+	}
+	if n := s.PurgeDeletedCustomers(t0.Add(CustomerRestoreWindow)); n != 0 {
+		t.Fatalf("purged %d customers deleted exactly 30 days ago", n)
+	}
+	if n := s.PurgeDeletedCustomers(t0.Add(CustomerRestoreWindow + time.Second)); n != 1 {
+		t.Fatalf("purged %d, want 1", n)
+	}
+	if _, ok := s.CustomerByID(c.ID); ok {
+		t.Fatal("a purged customer is still in the store")
+	}
+}
