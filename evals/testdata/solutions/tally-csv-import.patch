@@ -0,0 +1,104 @@
+package api_test
+
+import (
+	"net/http"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+func importCSV(e *apitest.Env, query, body string) *apitest.Response {
+	path := "/v1/customers/import"
+	if query != "" {
+		path += "?" + query
+	}
+	return e.DoWith("POST", path, e.Acme.Key, body, http.Header{"Content-Type": {"text/csv"}})
+}
+
+func TestImportCustomers(t *testing.T) {
+	e := apitest.New(t)
+	body := "\xEF\xBB\xBF Email ,Name,metadata.crm,ignored\r\n" +
+		"jane@example.com,\"Doe, Jane\",7,x\r\n" +
+		"\r\n" +
+		"john@example.com,\"John \"\"JJ\"\" Roe\",8,y\r\n"
+	r := importCSV(e, "dry_run=true", body)
+	if m := r.Map(t); r.Code != http.StatusOK || m["created"] != 0.0 || m["would_create"] != 2.0 {
+		t.Fatalf("dry run: %s", r)
+	}
+	if got := e.Store.Customers(e.Acme.ID); len(got) != 0 {
+		t.Fatalf("a dry run created %+v", got)
+	}
+	var out struct {
+		Created int
+		Items   []store.Customer
+	}
+	r = importCSV(e, "", body)
+	if r.Code != http.StatusCreated {
+		t.Fatalf("import: %s", r)
+	}
+	r.JSON(t, &out)
+	if out.Created != 2 || out.Items[0].Name != "Doe, Jane" || out.Items[1].Name != `John "JJ" Roe` || !reflect.DeepEqual(out.Items[1].Metadata, map[string]string{"crm": "8"}) {
+		t.Fatalf("import = %+v", out)
+	}
+	if evs := e.Store.Events(e.Acme.ID, "customer.created"); len(evs) != 2 {
+		t.Fatalf("%d customer.created events", len(evs))
+	}
+}
+
+func TestImportReportsEveryBadRecordAndCreatesNothing(t *testing.T) {
+	e := apitest.New(t)
+	e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	body := strings.Join([]string{
+		"name,email,default_payment_method",
+		"Ann,ann@example.com,",
+		",x@example.com,card",
+		"\"Two",
+		"Lines\",bad,",
+		"Bob,JANE@example.com,",
+		"Ann Again,ANN@example.com,",
+		"Cid,cid@example.com,card_1",
+		"",
+	}, "\n")
+	r := importCSV(e, "", body)
+	var out struct {
+		Error string
+		Rows  []struct {
+			Row   int
+			Error string
+		}
+	}
+	r.JSON(t, &out)
+	want := "3 missing_name, 4 invalid_email, 6 email_taken, 7 duplicate_email, 8 invalid_payment_method"
+	var got []string
+	for _, row := range out.Rows {
+		got = append(got, strconv.Itoa(row.Row)+" "+row.Error)
+	}
+	if r.Code != http.StatusUnprocessableEntity || out.Error != "invalid_rows" || strings.Join(got, ", ") != want {
+		t.Fatalf("bad rows: %s", r)
+	}
+	if n := len(e.Store.Customers(e.Acme.ID)); n != 1 {
+		t.Fatalf("%d customers after a refused import", n)
+	}
+	for body, code := range map[string]string{
+		"":                           "invalid_header",
+		"name,mail\nA,a@x.com\n":     "invalid_header",
+		"name,email\n\"A,a@x.com\n":  "invalid_csv",
+		"name,email\nA\"B,a@x.com\n": "invalid_csv",
+	} {
+		if r := importCSV(e, "", body); r.Map(t)["error"] != code {
+			t.Fatalf("%q: want %s, got %s", body, code, r)
+		}
+	}
+	var many strings.Builder
+	many.WriteString("name,email\n")
+	for i := range 10001 {
+		many.WriteString("C,c" + strconv.Itoa(i) + "@example.com\n")
+	}
+	if r := importCSV(e, "", many.String()); r.Code != http.StatusRequestEntityTooLarge || r.Map(t)["error"] != "too_many_rows" {
+		t.Fatalf("10001 records: %s", r)
+	}
+}
