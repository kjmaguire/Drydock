+// NewCustomer is a customer for CreateCustomers to create.
+type NewCustomer struct {
+	Name                 string
+	Email                string
+	DefaultPaymentMethod string // empty, or "pm_..."
+	Metadata             map[string]string
+}
+
+// CreateCustomers adds several customers to an organization at once, in order: all of them, or none when one is invalid
+// (ErrInvalid) or has an email address that a customer of the organization or an earlier one of the list has, ignoring
+// case (ErrEmailTaken). The error names the customer by its position in the list, from 1.
+func (s *Store) CreateCustomers(orgID string, in []NewCustomer, now time.Time) ([]Customer, error) {
+	cs := make([]Customer, len(in))
+	for i, n := range in {
+		c := Customer{OrgID: orgID, Name: strings.TrimSpace(n.Name), Email: strings.TrimSpace(n.Email), DefaultPaymentMethod: n.DefaultPaymentMethod,
+			CreatedAt: now.UTC()}
+		if len(n.Metadata) > 0 {
+			c.Metadata = copyCustomer(Customer{Metadata: n.Metadata}).Metadata
+		}
+		if c.Name == "" || !validEmail(c.Email) {
+			return nil, fmt.Errorf("customer %d: %w", i+1, invalid("a customer needs a name and a valid email address"))
+		}
+		if c.DefaultPaymentMethod != "" && !strings.HasPrefix(c.DefaultPaymentMethod, "pm_") {
+			return nil, fmt.Errorf("customer %d: %w", i+1, invalid("a payment method looks like pm_..."))
+		}
+		cs[i] = c
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[orgID]; !ok {
+		return nil, ErrNotFound
+	}
+	used := map[string]bool{}
+	for _, c := range s.customers {
+		if c.OrgID == orgID {
+			used[normEmail(c.Email)] = true
+		}
+	}
+	for i, c := range cs {
+		key := normEmail(c.Email)
+		if used[key] {
+			return nil, fmt.Errorf("customer %d: %w", i+1, ErrEmailTaken)
+		}
+		used[key] = true
+	}
+	out := make([]Customer, len(cs))
+	for i, c := range cs {
+		c.ID = s.newID("cus")
+		s.customers[c.ID] = c
+		s.customersByEmail[normEmail(c.Email)] = c.ID
+		out[i] = copyCustomer(c)
+	}
+	return out, nil
+}
+
