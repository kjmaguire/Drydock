new file mode 100644
index 0000000..7ddc53c
--- /dev/null
+++ b/internal/api/import.go
@@ -0,0 +1,193 @@
+package api
+
+import (
+	"bytes"
+	"encoding/csv"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+const (
+	// maxImportRows is how many data records one import may have.
+	maxImportRows = 10000
+	// maxImportBytes is how large an import's body may be.
+	maxImportBytes = 32 << 20
+)
+
+// importColumns says where a CSV import's columns are: indexes into each record, -1 for a column the header lacks.
+type importColumns struct {
+	name, email, paymentMethod int
+	metadata                   []metadataColumn
+}
+
+type metadataColumn struct {
+	key   string
+	index int
+}
+
+// readImportHeader finds the columns in the header: name and email (required), default_payment_method and
+// metadata.<key>, matched ignoring case and surrounding spaces. Other columns are ignored.
+func readImportHeader(header []string) (importColumns, bool) {
+	cols := importColumns{name: -1, email: -1, paymentMethod: -1}
+	const prefix = "metadata."
+	for i, h := range header {
+		h = strings.TrimSpace(h)
+		switch lower := strings.ToLower(h); {
+		case lower == "name" && cols.name < 0:
+			cols.name = i
+		case lower == "email" && cols.email < 0:
+			cols.email = i
+		case lower == "default_payment_method" && cols.paymentMethod < 0:
+			cols.paymentMethod = i
+		case strings.HasPrefix(lower, prefix) && len(h) > len(prefix):
+			cols.metadata = append(cols.metadata, metadataColumn{key: h[len(prefix):], index: i})
+		}
+	}
+	return cols, cols.name >= 0 && cols.email >= 0
+}
+
+func cell(rec []string, i int) string {
+	if i < 0 || i >= len(rec) {
+		return ""
+	}
+	return rec[i]
+}
+
+// importRow is one data record of an import: the line where it starts and the customer it describes.
+type importRow struct {
+	line     int
+	customer store.NewCustomer
+}
+
+// rowProblem is a bad record in the answer to an import: its line and the first problem it has.
+type rowProblem struct {
+	Row   int    `json:"row"`
+	Error string `json:"error"`
+}
+
+// importCustomers creates customers from a CSV body (RFC 4180): a header with the columns name and email, and optionally
+// default_payment_method and metadata.<key>, then one record per customer, at most maxImportRows. It is all or nothing:
+// every bad record is reported (422 invalid_rows) and nothing is created, or every customer is created in file order.
+// With ?dry_run=true it only checks.
+func (s *Server) importCustomers(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	dryRun := false
+	if v := r.URL.Query().Get("dry_run"); v != "" {
+		b, err := strconv.ParseBool(v)
+		if err != nil {
+			writeError(w, http.StatusBadRequest, "invalid_dry_run", "dry_run is true or false")
+			return
+		}
+		dryRun = b
+	}
+	body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, maxImportBytes))
+	if err != nil {
+		var tooBig *http.MaxBytesError
+		if errors.As(err, &tooBig) {
+			writeError(w, http.StatusRequestEntityTooLarge, "body_too_large", "the body is larger than 32 MiB")
+			return
+		}
+		writeError(w, http.StatusBadRequest, "invalid_csv", "the body could not be read")
+		return
+	}
+	body = bytes.TrimPrefix(body, []byte("\xEF\xBB\xBF")) // a UTF-8 byte order mark
+
+	cr := csv.NewReader(bytes.NewReader(body))
+	cr.FieldsPerRecord = -1 // a short record has empty cells; a long one, ignored ones
+	header, err := cr.Read()
+	if errors.Is(err, io.EOF) {
+		writeError(w, http.StatusUnprocessableEntity, "invalid_header", "the body has no header")
+		return
+	}
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_csv", "the body is not valid CSV: "+err.Error())
+		return
+	}
+	cols, ok := readImportHeader(header)
+	if !ok {
+		writeError(w, http.StatusUnprocessableEntity, "invalid_header", "the header needs the columns name and email")
+		return
+	}
+	var rows []importRow
+	for {
+		rec, err := cr.Read()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			writeError(w, http.StatusBadRequest, "invalid_csv", "the body is not valid CSV: "+err.Error())
+			return
+		}
+		if len(rows) == maxImportRows {
+			writeError(w, http.StatusRequestEntityTooLarge, "too_many_rows", "an import has at most 10000 records")
+			return
+		}
+		line, _ := cr.FieldPos(0)
+		c := store.NewCustomer{Name: strings.TrimSpace(cell(rec, cols.name)), Email: strings.TrimSpace(cell(rec, cols.email)),
+			DefaultPaymentMethod: strings.TrimSpace(cell(rec, cols.paymentMethod))}
+		for _, m := range cols.metadata {
+			if v := cell(rec, m.index); v != "" {
+				if c.Metadata == nil {
+					c.Metadata = map[string]string{}
+				}
+				c.Metadata[m.key] = v
+			}
+		}
+		rows = append(rows, importRow{line: line, customer: c})
+	}
+
+	taken := map[string]bool{}
+	for _, c := range s.store.Customers(p.OrgID) {
+		taken[strings.ToLower(strings.TrimSpace(c.Email))] = true
+	}
+	seen := map[string]bool{}
+	problems := []rowProblem{}
+	for _, row := range rows {
+		c := row.customer
+		key := strings.ToLower(c.Email)
+		code := ""
+		switch {
+		case c.Name == "":
+			code = "missing_name"
+		case !store.ValidEmail(c.Email):
+			code = "invalid_email"
+		case c.DefaultPaymentMethod != "" && !strings.HasPrefix(c.DefaultPaymentMethod, "pm_"):
+			code = "invalid_payment_method"
+		case taken[key]:
+			code = "email_taken"
+		case seen[key]:
+			code = "duplicate_email"
+		}
+		seen[key] = true
+		if code != "" {
+			problems = append(problems, rowProblem{Row: row.line, Error: code})
+		}
+	}
+	if len(problems) > 0 {
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]any{"error": "invalid_rows", "message": "some records have problems; nothing was created",
+			"rows": problems})
+		return
+	}
+	if dryRun {
+		writeJSON(w, http.StatusOK, map[string]any{"created": 0, "would_create": len(rows)})
+		return
+	}
+	in := make([]store.NewCustomer, len(rows))
+	for i, row := range rows {
+		in[i] = row.customer
+	}
+	created, err := s.store.CreateCustomers(p.OrgID, in, s.clock.Now())
+	if err != nil {
+		s.storeError(w, err) // a customer created meanwhile took an address: 409 email_taken
+		return
+	}
+	for _, c := range created {
+		s.publish(r.Context(), p.OrgID, "customer.created", c)
+	}
+	writeJSON(w, http.StatusCreated, map[string]any{"created": len(created), "items": created})
+}
