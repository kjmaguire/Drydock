diff --git a/internal/api/audit.go b/internal/api/audit.go
new file mode 100644
index 0000000..ac5eceb
--- /dev/null
+++ b/internal/api/audit.go
@@ -0,0 +1,108 @@
+package api
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+
+	"example.com/tally/internal/auth"
+	"example.com/tally/internal/store"
+)
+
+// audit records in the audit log that the request changed something. Handlers call it once the change has succeeded, just
+// before answering: a request that fails records nothing. changes is set for updates (see changedFields).
+func (s *Server) audit(r *http.Request, p auth.Principal, action, targetType, targetID string, changes map[string]store.AuditChange) {
+	_, err := s.store.AddAuditEntry(store.AuditEntry{
+		OrgID:     p.OrgID,
+		Action:    action,
+		Actor:     store.AuditActor{Type: "api_key", ID: p.KeyID, UserID: p.UserID},
+		Target:    store.AuditTarget{Type: targetType, ID: targetID},
+		Changes:   changes,
+		RequestID: RequestID(r.Context()),
+		At:        s.clock.Now(),
+	})
+	if err != nil {
+		s.log.Error("audit", "action", action, "target", targetID, "err", err)
+	}
+}
+
+// secretFields are never written to the audit log, changed or not.
+var secretFields = map[string]bool{"secret": true, "token": true}
+
+// changedFields compares two versions of an object as the API shows them (JSON objects) and returns the fields whose value
+// changed, by JSON field name, with the old and the new value (null for a field that is absent). Secrets are left out.
+func changedFields(before, after any) map[string]store.AuditChange {
+	b, a := jsonFields(before), jsonFields(after)
+	out := map[string]store.AuditChange{}
+	for k, v := range a {
+		if old, ok := b[k]; !secretFields[k] && (!ok || !bytes.Equal(old, v)) {
+			out[k] = store.AuditChange{From: old, To: v}
+		}
+	}
+	for k, old := range b {
+		if _, ok := a[k]; !ok && !secretFields[k] {
+			out[k] = store.AuditChange{From: old}
+		}
+	}
+	return out
+}
+
+// jsonFields returns the fields of v's JSON object, each value as json.Marshal writes it (compact, map keys sorted), so
+// that equal values have equal bytes.
+func jsonFields(v any) map[string]json.RawMessage {
+	raw, err := json.Marshal(v)
+	if err != nil {
+		return nil
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &fields); err != nil {
+		return nil
+	}
+	for k, f := range fields {
+		var buf bytes.Buffer
+		if json.Compact(&buf, f) == nil {
+			fields[k] = buf.Bytes()
+		}
+	}
+	return fields
+}
+
+func auditKey(e store.AuditEntry) cursor { return cursor{T: e.At, ID: e.ID} }
+
+// listAuditEvents lists the organization's audit log, newest first, optionally only the entries with ?action=, about
+// ?target_id=, or made by ?actor_id= (an API key's ID or a user's). Only owners and admins may read it.
+func (s *Server) listAuditEvents(w http.ResponseWriter, r *http.Request, p auth.Principal) {
+	if !auth.CanManageTeam(p.Role) {
+		writeError(w, http.StatusForbidden, "forbidden", "only owners and admins read the audit log")
+		return
+	}
+	pg, ok := parsePage(w, r)
+	if !ok {
+		return
+	}
+	q := r.URL.Query()
+	entries := s.store.AuditEntries(p.OrgID, store.AuditFilter{Action: q.Get("action"), TargetID: q.Get("target_id"), ActorID: q.Get("actor_id")})
+	items, next := pageOfNewestFirst(entries, auditKey, pg)
+	writeJSON(w, http.StatusOK, list{Items: items, NextCursor: next})
+}
+
+// pageOfNewestFirst is pageOf for items sorted newest first: a page starts after the cursor's item, at older items.
+func pageOfNewestFirst[T any](items []T, key func(T) cursor, p page) ([]T, string) {
+	start := 0
+	if p.after != nil {
+		start = len(items)
+		for i, it := range items {
+			if key(it).less(*p.after) {
+				start = i
+				break
+			}
+		}
+	}
+	end := min(start+p.limit, len(items))
+	out := items[start:end]
+	next := ""
+	if end < len(items) && len(out) > 0 {
+		next = encodeCursor(key(out[len(out)-1]))
+	}
+	return out, next
+}
diff --git a/internal/api/audit_test.go b/internal/api/audit_test.go
new file mode 100644
index 0000000..41985e3
--- /dev/null
+++ b/internal/api/audit_test.go
@@ -0,0 +1,99 @@
+package api_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/store"
+)
+
+type auditEntry struct {
+	ID     string
+	Action string
+	Actor  struct {
+		Type   string
+		ID     string
+		UserID string `json:"user_id"`
+	}
+	Target    struct{ Type, ID string }
+	RequestID string `json:"request_id"`
+	At        time.Time
+	Changes   map[string]struct{ From, To any }
+}
+
+func auditLog(t *testing.T, e *apitest.Env, query string) []auditEntry {
+	t.Helper()
+	var page struct{ Items []auditEntry }
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events?"+query, e.Acme.Key, nil, &page)
+	return page.Items
+}
+
+func TestAuditLog(t *testing.T) {
+	e := apitest.New(t)
+	var me struct {
+		APIKeyID string `json:"api_key_id"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/me", e.Acme.Key, nil, &me)
+	r := e.DoWith("POST", "/v1/customers", e.Acme.Key, map[string]string{"name": "Jane", "email": "jane@example.com"}, http.Header{"X-Request-Id": {"req-1"}})
+	var c store.Customer
+	r.JSON(t, &c)
+	e.Clock.Advance(time.Minute)
+	e.MustDo(http.StatusOK, "PATCH", "/v1/customers/"+c.ID, e.Acme.Key, map[string]string{"name": "Jane Doe", "email": "jane@example.com"}, nil)
+	if r := e.Do("PATCH", "/v1/customers/"+c.ID, e.Acme.Key, map[string]string{"email": "nope"}); r.Code != http.StatusUnprocessableEntity {
+		t.Fatalf("bad email: %s", r)
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/customers", e.Acme.Key, nil, nil)
+	var k store.APIKey
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", e.Acme.Key, map[string]string{"name": "CI"}, &k)
+	var ep store.WebhookEndpoint
+	e.MustDo(http.StatusCreated, "POST", "/v1/webhook-endpoints", e.Acme.Key, map[string]any{"url": "https://hooks.acme.example/", "events": []string{"*"}}, &ep)
+
+	log := auditLog(t, e, "")
+	if len(log) != 4 || log[0].Action != "webhook_endpoint.created" || log[1].Action != "api_key.created" || log[2].Action != "customer.updated" || log[3].Action != "customer.created" {
+		t.Fatalf("log = %+v", log)
+	}
+	created, updated := log[3], log[2]
+	if created.Actor.Type != "api_key" || created.Actor.ID != me.APIKeyID || created.Actor.UserID != e.Acme.Owner.ID || created.Target.Type != "customer" ||
+		created.Target.ID != c.ID || created.RequestID != "req-1" || !created.At.Equal(apitest.Start) {
+		t.Fatalf("customer.created = %+v", created)
+	}
+	if len(updated.Changes) != 1 || updated.Changes["name"].From != "Jane" || updated.Changes["name"].To != "Jane Doe" || !updated.At.Equal(apitest.Start.Add(time.Minute)) {
+		t.Fatalf("customer.updated = %+v", updated)
+	}
+	raw, _ := json.Marshal(log)
+	if strings.Contains(string(raw), k.Token) || strings.Contains(string(raw), ep.Secret) || strings.Contains(string(raw), e.Acme.Key) {
+		t.Fatalf("a secret is in the log: %s", raw)
+	}
+	if got := auditLog(t, e, "target_id="+c.ID); len(got) != 2 {
+		t.Fatalf("by target = %+v", got)
+	}
+	if got := auditLog(t, e, "actor_id="+e.Acme.Owner.ID+"&action=api_key.created"); len(got) != 1 || got[0].Target.ID != k.ID {
+		t.Fatalf("by actor and action = %+v", got)
+	}
+	first := auditLog(t, e, "limit=3")
+	var page struct {
+		Items      []auditEntry
+		NextCursor string `json:"next_cursor"`
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events?limit=3", e.Acme.Key, nil, &page)
+	cursor := page.NextCursor
+	page.Items, page.NextCursor = nil, ""
+	e.MustDo(http.StatusOK, "GET", "/v1/audit-events?limit=3&cursor="+cursor, e.Acme.Key, nil, &page)
+	if len(first) != 3 || len(page.Items) != 1 || page.Items[0].ID != log[3].ID || page.NextCursor != "" {
+		t.Fatalf("pages = %+v then %+v", first, page)
+	}
+	_, member := e.AddMember(e.Acme, "m@acme.example", store.RoleMember)
+	if r := e.Do("GET", "/v1/audit-events", member, nil); r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+		t.Fatalf("a member reads the log: %s", r)
+	}
+	if r := e.Do("DELETE", "/v1/audit-events/"+log[0].ID, e.Acme.Key, nil); r.Code < 400 {
+		t.Fatalf("delete an entry: %s", r)
+	}
+	if got := auditLog(t, e, ""); len(got) != 4 {
+		t.Fatalf("the log changed: %+v", got)
+	}
+}
