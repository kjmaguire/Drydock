+func TestAuditEntries(t *testing.T) {
+	s := New()
+	a, b := newOrg(t, s, "A"), newOrg(t, s, "B")
+	add := func(org, action, target, key string, at time.Time) AuditEntry {
+		e, err := s.AddAuditEntry(AuditEntry{OrgID: org, Action: action, Actor: AuditActor{Type: "api_key", ID: key, UserID: "usr_" + key},
+			Target: AuditTarget{Type: "customer", ID: target}, At: at})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return e
+	}
+	e1 := add(a.ID, "customer.created", "cus_1", "k1", t0)
+	e2 := add(a.ID, "customer.updated", "cus_1", "k2", t0)
+	e3 := add(a.ID, "customer.created", "cus_2", "k1", t0.Add(time.Second))
+	add(b.ID, "customer.created", "cus_3", "k3", t0)
+	ids := func(es []AuditEntry) string {
+		var out []string
+		for _, e := range es {
+			out = append(out, e.ID)
+		}
+		return strings.Join(out, ",")
+	}
+	if got, want := ids(s.AuditEntries(a.ID, AuditFilter{})), strings.Join([]string{e3.ID, e2.ID, e1.ID}, ","); got != want {
+		t.Fatalf("newest first: %s, want %s", got, want)
+	}
+	if got := ids(s.AuditEntries(a.ID, AuditFilter{ActorID: "usr_k1"})); got != e3.ID+","+e1.ID {
+		t.Fatalf("by user: %s", got)
+	}
+	if got := ids(s.AuditEntries(a.ID, AuditFilter{ActorID: "k2", TargetID: "cus_1", Action: "customer.updated"})); got != e2.ID {
+		t.Fatalf("by key, target and action: %s", got)
+	}
+	st := s.Export()
+	s2, err := FromState(st)
+	if err != nil || !reflect.DeepEqual(s2.Export(), st) {
+		t.Fatalf("the log does not survive a snapshot: %v", err)
+	}
+}
