diff --git a/internal/store/audit.go b/internal/store/audit.go
new file mode 100644
index 0000000..230d0a7
--- /dev/null
+++ b/internal/store/audit.go
@@ -0,0 +1,93 @@
+package store
+
+import (
+	"encoding/json"
+	"sort"
+	"time"
+)
+
+// AuditEntry records one change a member made through the API: who (the API key and its member), what (the action and the
+// object), when, in which request, and for updates the fields that changed. Entries are only ever added; nothing changes or
+// removes one.
+type AuditEntry struct {
+	ID        string                 `json:"id"`
+	OrgID     string                 `json:"org_id"`
+	Action    string                 `json:"action"` // for example "customer.updated"
+	Actor     AuditActor             `json:"actor"`
+	Target    AuditTarget            `json:"target"`
+	Changes   map[string]AuditChange `json:"changes,omitzero"` // set (maybe empty) for updates, nil for other actions
+	RequestID string                 `json:"request_id"`
+	At        time.Time              `json:"at"`
+}
+
+// AuditActor is who made a change: the API key a request presented and the member (user) it acts for.
+type AuditActor struct {
+	Type   string `json:"type"` // "api_key"
+	ID     string `json:"id"`
+	UserID string `json:"user_id"`
+}
+
+// AuditTarget is the object a change was made to: its type ("customer", "plan", ..., "org") and ID (a member's user ID).
+type AuditTarget struct {
+	Type string `json:"type"`
+	ID   string `json:"id"`
+}
+
+// AuditChange is a field's JSON value before and after a change (null when the field was or became absent).
+type AuditChange struct {
+	From json.RawMessage `json:"from"`
+	To   json.RawMessage `json:"to"`
+}
+
+// AuditFilter narrows AuditEntries. Empty fields match everything.
+type AuditFilter struct {
+	Action   string
+	TargetID string
+	ActorID  string // the API key's ID or its member's user ID
+}
+
+// AddAuditEntry records an entry of an organization and returns it with its ID.
+func (s *Store) AddAuditEntry(e AuditEntry) (AuditEntry, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.orgs[e.OrgID]; !ok {
+		return AuditEntry{}, ErrNotFound
+	}
+	e.ID = s.newID("aud")
+	e.At = e.At.UTC()
+	e = copyAuditEntry(e)
+	s.audit = append(s.audit, e)
+	return copyAuditEntry(e), nil
+}
+
+// AuditEntries returns an organization's entries that match f, newest first (ties: the one recorded last first).
+func (s *Store) AuditEntries(orgID string, f AuditFilter) []AuditEntry {
+	s.mu.Lock()
+	out := []AuditEntry{}
+	for _, e := range s.audit {
+		if e.OrgID != orgID || (f.Action != "" && e.Action != f.Action) || (f.TargetID != "" && e.Target.ID != f.TargetID) ||
+			(f.ActorID != "" && e.Actor.ID != f.ActorID && e.Actor.UserID != f.ActorID) {
+			continue
+		}
+		out = append(out, copyAuditEntry(e))
+	}
+	s.mu.Unlock()
+	sort.SliceStable(out, func(i, j int) bool {
+		if !out[i].At.Equal(out[j].At) {
+			return out[i].At.After(out[j].At)
+		}
+		return out[i].ID > out[j].ID
+	})
+	return out
+}
+
+func copyAuditEntry(e AuditEntry) AuditEntry {
+	if e.Changes != nil {
+		m := make(map[string]AuditChange, len(e.Changes))
+		for k, c := range e.Changes {
+			m[k] = AuditChange{From: append(json.RawMessage(nil), c.From...), To: append(json.RawMessage(nil), c.To...)}
+		}
+		e.Changes = m
+	}
+	return e
+}
