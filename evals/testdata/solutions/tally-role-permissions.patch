+// isPrivileged reports whether a role is owner or admin: only an owner gives these roles, and only an owner changes or
+// removes a member who has one.
+func isPrivileged(r store.Role) bool { return r == store.RoleOwner || r == store.RoleAdmin }
+
+// CanGiveRole reports whether a member with role actor may give someone role (by changing their role or inviting them).
+func CanGiveRole(actor, role store.Role) bool {
