+// Permission is something a request needs to be allowed to do. Every API endpoint names one.
+type Permission int
+
+// Permissions.
+const (
+	// AnyMember is granted to every member. Endpoints that need only it apply finer rules themselves (leaving the
+	// organization, a member's own API keys).
+	AnyMember Permission = iota
+	// Read is reading customers, plans, subscriptions, invoices and payments (including the customer export), the
+	// organization, its members and its pending invites.
+	Read
+	// WriteCustomers is creating, updating and deleting customers.
+	WriteCustomers
+	// WritePlans is creating and updating plans.
+	WritePlans
+	// WriteSubscriptions is creating, updating and canceling subscriptions, and reporting usage.
+	WriteSubscriptions
+	// WriteInvoices is creating, paying and voiding invoices.
+	WriteInvoices
+	// ReadReports is the revenue report.
+	ReadReports
+	// ManageWebhooks is every request about webhook endpoints, their deliveries, and events.
+	ManageWebhooks
+	// ManageOrg is changing the organization's settings.
+	ManageOrg
+	// ManageTeam is inviting people, revoking invites, changing members' roles and removing members.
+	ManageTeam
+)
+
+var (
+	everyone = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer}
+	writers  = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember}
+	finance  = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling}
+	managers = []store.Role{store.RoleOwner, store.RoleAdmin}
+)
+
+// grants is the role matrix: the roles that have each permission.
+var grants = map[Permission][]store.Role{
+	AnyMember:          everyone,
+	Read:               everyone,
+	WriteCustomers:     writers,
+	WritePlans:         finance,
+	WriteSubscriptions: writers,
+	WriteInvoices:      finance,
+	ReadReports:        finance,
+	ManageWebhooks:     managers,
+	ManageOrg:          managers,
+	ManageTeam:         managers,
+}
+
+// Allowed reports whether a role has a permission.
+func Allowed(r store.Role, p Permission) bool {
+	for _, g := range grants[p] {
+		if g == r {
+			return true
+		}
+	}
+	return false
+}
