--- /dev/null
+++ b/internal/api/roles_test.go
@@ -0,0 +1,187 @@
+package api_test
+
+import (
+	"fmt"
+	"net/http"
+	"reflect"
+	"slices"
+	"testing"
+
+	"example.com/tally/internal/apitest"
+	"example.com/tally/internal/money"
+	"example.com/tally/internal/store"
+)
+
+// roleEnv is an organization with one member of each role (the owner is Acme's) and objects to act on.
+type roleEnv struct {
+	e        *apitest.Env
+	keys     map[store.Role]string
+	users    map[store.Role]store.User
+	customer store.Customer
+	plan     store.Plan
+	n        int
+}
+
+func newRoleEnv(t *testing.T) *roleEnv {
+	t.Helper()
+	e := apitest.New(t)
+	x := &roleEnv{e: e, keys: map[store.Role]string{store.RoleOwner: e.Acme.Key}, users: map[store.Role]store.User{store.RoleOwner: e.Acme.Owner}}
+	for _, r := range []store.Role{store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer} {
+		x.users[r], x.keys[r] = e.AddMember(e.Acme, string(r)+"@acme.example", r)
+	}
+	x.customer = e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	x.plan = e.CreatePlan(e.Acme, "Team", "USD", "10.00")
+	return x
+}
+
+func (x *roleEnv) invoice(t *testing.T) string {
+	t.Helper()
+	inv, err := x.e.Store.CreateInvoice(store.Invoice{OrgID: x.e.Acme.ID, CustomerID: x.customer.ID, Currency: money.USD,
+		Lines: []store.Line{{Description: "Work", Quantity: 1, UnitAmount: 100}}}, x.e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return inv.ID
+}
+
+func (x *roleEnv) endpoint(t *testing.T) string {
+	t.Helper()
+	ep, err := x.e.Store.CreateWebhookEndpoint(store.WebhookEndpoint{OrgID: x.e.Acme.ID, URL: "https://hooks.acme.example/", Events: []string{"*"}, Enabled: true}, x.e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ep.ID
+}
+
+func (x *roleEnv) next() int { x.n++; return x.n }
+
+var (
+	allRoles = []store.Role{store.RoleOwner, store.RoleAdmin, store.RoleBilling, store.RoleMember, store.RoleViewer}
+	writers  = allRoles[:4]
+	finance  = allRoles[:3]
+	managers = allRoles[:2]
+)
+
+func TestRoleMatrix(t *testing.T) {
+	x := newRoleEnv(t)
+	for _, c := range []struct {
+		allowed []store.Role
+		req     func() (string, string, any)
+	}{
+		{allRoles, func() (string, string, any) { return "GET", "/v1/customers/export.csv", nil }},
+		{allRoles, func() (string, string, any) { return "GET", "/v1/invoices/" + x.invoice(t) + "/lines", nil }},
+		{allRoles, func() (string, string, any) { return "GET", "/v1/payments", nil }},
+		{allRoles, func() (string, string, any) { return "GET", "/v1/invites", nil }},
+		{writers, func() (string, string, any) {
+			return "POST", "/v1/customers", map[string]string{"name": "C", "email": fmt.Sprintf("c%d@example.com", x.next())}
+		}},
+		{writers, func() (string, string, any) {
+			return "POST", "/v1/subscriptions", map[string]any{"customer_id": x.customer.ID, "plan_id": x.plan.ID}
+		}},
+		{finance, func() (string, string, any) {
+			return "PATCH", "/v1/plans/" + x.plan.ID, map[string]any{"name": "Renamed"}
+		}},
+		{finance, func() (string, string, any) { return "POST", "/v1/invoices/" + x.invoice(t) + "/void", nil }},
+		{finance, func() (string, string, any) { return "GET", "/v1/reports/revenue?from=2026-01-01&to=2026-01-31", nil }},
+		{managers, func() (string, string, any) { return "GET", "/v1/events", nil }},
+		{managers, func() (string, string, any) { return "DELETE", "/v1/webhook-endpoints/" + x.endpoint(t), nil }},
+		{managers, func() (string, string, any) { return "PATCH", "/v1/org", map[string]any{"name": "Acme"} }},
+		{managers, func() (string, string, any) {
+			return "POST", "/v1/invites", map[string]string{"email": fmt.Sprintf("i%d@people.example", x.next()), "role": "member"}
+		}},
+	} {
+		for _, role := range allRoles {
+			method, path, body := c.req()
+			before := x.e.Store.Export()
+			r := x.e.Do(method, path, x.keys[role], body)
+			switch {
+			case slices.Contains(c.allowed, role) && (r.Code < 200 || r.Code > 299):
+				t.Errorf("%s %s as %s: want success, got %s", method, path, role, r)
+			case !slices.Contains(c.allowed, role):
+				if r.Code != http.StatusForbidden || r.Map(t)["error"] != "forbidden" {
+					t.Errorf("%s %s as %s: want 403 forbidden, got %s", method, path, role, r)
+				}
+				after := x.e.Store.Export()
+				before.APIKeys, after.APIKeys = nil, nil
+				if !reflect.DeepEqual(before, after) {
+					t.Errorf("%s %s as %s was refused but changed the store", method, path, role)
+				}
+			}
+		}
+	}
+}
+
+func TestMemberRules(t *testing.T) {
+	x := newRoleEnv(t)
+	e, owner, admin := x.e, x.keys[store.RoleOwner], x.keys[store.RoleAdmin]
+	patch := func(key string, user store.User, role string) *apitest.Response {
+		return e.Do("PATCH", "/v1/members/"+user.ID, key, map[string]string{"role": role})
+	}
+	for _, r := range []*apitest.Response{
+		patch(admin, x.users[store.RoleMember], "admin"),  // only owners give the admin role
+		patch(admin, x.users[store.RoleOwner], "billing"), // or change an owner's role
+		patch(admin, x.users[store.RoleAdmin], "billing"), // nobody changes their own role
+		patch(x.keys[store.RoleViewer], x.users[store.RoleViewer], "member"),
+		e.Do("DELETE", "/v1/members/"+x.users[store.RoleOwner].ID, admin, nil), // only owners remove owners
+	} {
+		if r.Code != http.StatusForbidden {
+			t.Errorf("want 403, got %s", r)
+		}
+	}
+	if r := patch(admin, x.users[store.RoleMember], "viewer"); r.Code != http.StatusOK {
+		t.Fatalf("an admin changes a member's role: %s", r)
+	}
+	if r := patch(owner, x.users[store.RoleMember], "admin"); r.Code != http.StatusOK {
+		t.Fatalf("an owner gives the admin role: %s", r)
+	}
+
+	// the only owner can neither leave nor demote themselves
+	if r := e.Do("DELETE", "/v1/members/"+x.users[store.RoleOwner].ID, owner, nil); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the only owner leaves: %s", r)
+	}
+	if r := patch(owner, x.users[store.RoleOwner], "admin"); r.Code != http.StatusConflict || r.Map(t)["error"] != "last_owner" {
+		t.Fatalf("the only owner demotes themselves: %s", r)
+	}
+	// anyone else may leave
+	for _, role := range []store.Role{store.RoleViewer, store.RoleBilling, store.RoleAdmin} {
+		e.MustDo(http.StatusNoContent, "DELETE", "/v1/members/"+x.users[role].ID, x.keys[role], nil, nil)
+		if r := e.Do("GET", "/v1/org", x.keys[role], nil); r.Code != http.StatusUnauthorized {
+			t.Fatalf("the key of a %s who left: %s", role, r)
+		}
+	}
+}
+
+func TestAPIKeyRules(t *testing.T) {
+	x := newRoleEnv(t)
+	e := x.e
+	var k struct{ ID, Token string }
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", x.keys[store.RoleViewer], map[string]string{"name": "mine"}, &k)
+	if r := e.Do("DELETE", "/v1/api-keys/"+k.ID, x.keys[store.RoleMember], nil); r.Code != http.StatusForbidden {
+		t.Fatalf("a member revokes a viewer's key: %s", r)
+	}
+	var page struct {
+		Items []struct {
+			UserID string `json:"user_id"`
+		}
+	}
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", x.keys[store.RoleViewer], nil, &page)
+	if len(page.Items) != 2 {
+		t.Fatalf("a viewer lists %d keys, want their own 2", len(page.Items))
+	}
+	for _, it := range page.Items {
+		if it.UserID != x.users[store.RoleViewer].ID {
+			t.Fatalf("a viewer sees another member's key: %+v", page.Items)
+		}
+	}
+	page.Items = nil
+	e.MustDo(http.StatusOK, "GET", "/v1/api-keys", x.keys[store.RoleAdmin], nil, &page)
+	if len(page.Items) != 6 {
+		t.Fatalf("an admin lists %d keys, want all 6", len(page.Items))
+	}
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+k.ID, x.keys[store.RoleViewer], nil, nil)
+	e.MustDo(http.StatusCreated, "POST", "/v1/api-keys", x.keys[store.RoleBilling], map[string]string{"name": "b"}, &k)
+	e.MustDo(http.StatusNoContent, "DELETE", "/v1/api-keys/"+k.ID, x.keys[store.RoleAdmin], nil, nil)
+	if r := e.Do("GET", "/v1/org", k.Token, nil); r.Code != http.StatusUnauthorized {
+		t.Fatalf("a revoked key: %s", r)
+	}
+}
