+func TestLastOwner(t *testing.T) {
+	s := New()
+	o := newOrg(t, s, "Acme")
+	ann, _ := s.CreateUser("ann@example.com", "Ann", t0)
+	bob, _ := s.CreateUser("bob@example.com", "Bob", t0)
+	_, _ = s.AddMember(o.ID, ann.ID, RoleOwner, t0)
+	_, _ = s.AddMember(o.ID, bob.ID, RoleOwner, t0)
+	if _, err := s.SetMemberRole(o.ID, bob.ID, RoleAdmin); err != nil {
+		t.Fatalf("demoting one of two owners: %v", err)
+	}
+	if _, err := s.SetMemberRole(o.ID, ann.ID, RoleAdmin); !errors.Is(err, ErrLastOwner) {
+		t.Fatalf("demoting the only owner: %v", err)
+	}
+	if err := s.RemoveMember(o.ID, ann.ID); !errors.Is(err, ErrLastOwner) {
+		t.Fatalf("removing the only owner: %v", err)
+	}
+	refuse := errors.New("no")
+	if err := s.RemoveMemberIf(o.ID, bob.ID, func(Member) error { return refuse }); !errors.Is(err, refuse) {
+		t.Fatalf("RemoveMemberIf ignored its check: %v", err)
+	}
+	if err := s.RemoveMember(o.ID, bob.ID); err != nil {
+		t.Fatal(err)
+	}
+	if m, ok := s.Member(o.ID, ann.ID); !ok || m.Role != RoleOwner {
+		t.Fatalf("the owner = %+v, %v", m, ok)
+	}
+}
