+
+// next waits for the next queued job and takes it; it reports false once the runner is stopping.
+func (r *Runner) next() (entry, bool) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for len(r.queue) == 0 && !r.stopping {
+		r.idle++
+		r.wake.Wait()
+		r.idle--
+	}
+	if r.stopping {
+		return entry{}, false
+	}
+	e := r.queue[0]
+	r.queue[0] = entry{}
+	r.queue = r.queue[1:]
+	r.running++
+	return e, true
+}
+
+func (r *Runner) exit() {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.alive--; r.alive == 0 {
+		close(r.exited)
+	}
+}
+
+// run runs one job. A job that fails is logged; one that returned an error after Shutdown canceled its context is kept for
+// Pending. A job that panics is logged and not run again.
+func (r *Runner) run(e entry) {
+	ok, err := r.call(e.job)
+	canceled := ok && err != nil && r.ctx.Err() != nil
+	r.mu.Lock()
+	r.running--
+	if canceled {
+		r.canceled = append(r.canceled, e)
+	}
+	r.mu.Unlock()
+	switch {
+	case canceled:
+		r.log.Warn("job canceled by shutdown", "job", e.job.Name, "err", err)
+	case ok && err != nil:
+		r.log.Error("job failed", "job", e.job.Name, "err", err)
 	}
