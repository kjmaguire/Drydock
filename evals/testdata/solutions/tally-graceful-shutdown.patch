 		t.Fatalf("err = %v, want ErrQueueFull", err)
 	}
 }
+
+// held returns a job that tells started it runs, then waits for release or for its context to be canceled.
+func held(name string, started chan<- string, release <-chan struct{}) Job {
+	return Job{Name: name, Run: func(ctx context.Context) error {
+		started <- name
+		select {
+		case <-release:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}}
+}
+
+func names(js []Job) []string {
+	out := []string{}
+	for _, j := range js {
+		out = append(out, j.Name)
+	}
+	return out
+}
+
+func TestShutdownWaitsForRunningJobs(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	started, release := make(chan string, 1), make(chan struct{})
+	ran := make(chan string, 10)
+	quick := func(name string) Job {
+		return Job{Name: name, Run: func(context.Context) error { ran <- name; return nil }}
+	}
+	_ = r.Enqueue(held("a", started, release))
+	<-started
+	_ = r.Enqueue(quick("b"))
+	_ = r.Enqueue(quick("c"))
+	if got := names(r.Pending()); len(got) != 2 || got[0] != "b" || got[1] != "c" {
+		t.Fatalf("pending = %v", got)
+	}
+	done := make(chan error, 1)
+	go func() { done <- r.Shutdown(context.Background()) }()
+	for !errors.Is(r.Enqueue(quick("late")), ErrStopped) {
+		time.Sleep(time.Millisecond) // until Shutdown has started; the jobs queued meanwhile never start
+	}
+	select {
+	case err := <-done:
+		t.Fatalf("Shutdown returned %v while a job was running", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatalf("Shutdown = %v", err)
+	}
+	if len(ran) != 0 {
+		t.Fatalf("a queued job was started after Shutdown: %s", <-ran)
+	}
+	if got := names(r.Pending()); len(got) < 2 || got[0] != "b" || got[1] != "c" {
+		t.Fatalf("pending after Shutdown = %v", got)
+	}
+	if err := r.Shutdown(context.Background()); err != nil {
+		t.Fatalf("second Shutdown = %v", err)
+	}
+	r.Stop()
+}
+
+func TestShutdownCancelsWhenContextEnds(t *testing.T) {
+	r := NewRunner(2, 10, nil)
+	r.Start()
+	started := make(chan string, 2)
+	_ = r.Enqueue(held("a", started, nil))
+	_ = r.Enqueue(Job{Name: "b", Run: func(ctx context.Context) error { started <- "b"; <-ctx.Done(); return nil }})
+	<-started
+	<-started
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if err := r.Shutdown(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Shutdown = %v, want the context's error", err)
+	}
+	if got := names(r.Pending()); len(got) != 1 || got[0] != "a" {
+		t.Fatalf("pending = %v, want only the canceled job that returned an error", got)
+	}
+}
+
+func TestEnqueueAfterStop(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	r.Stop()
+	if err := r.Enqueue(Job{Name: "x", Run: func(context.Context) error { return nil }}); !errors.Is(err, ErrStopped) {
+		t.Fatalf("Enqueue after Stop = %v", err)
+	}
+	if len(r.Pending()) != 0 {
+		t.Fatalf("pending = %v", names(r.Pending()))
+	}
+}
+
+func TestPanickingJobDoesNotStopTheWorker(t *testing.T) {
+	r := NewRunner(1, 10, nil)
+	r.Start()
+	defer r.Stop()
+	var mu sync.Mutex
+	panics := 0
+	_ = r.Enqueue(Job{Name: "boom", Run: func(context.Context) error {
+		mu.Lock()
+		panics++
+		mu.Unlock()
+		panic("boom")
+	}})
+	ok := make(chan struct{})
+	_ = r.Enqueue(Job{Name: "next", Run: func(context.Context) error { close(ok); return nil }})
+	select {
+	case <-ok:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the job after a panicking one did not run")
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if panics != 1 {
+		t.Fatalf("the panicking job ran %d times", panics)
+	}
+}
