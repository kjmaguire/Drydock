-// Stop stops the runner.
+// Shutdown stops the runner. From the moment it is called, Enqueue returns ErrStopped and no queued job is started. It waits
+// for the running jobs to finish and returns nil; when ctx ends first, it cancels the context of every running job, waits
+// for them to return and returns ctx.Err(). When it returns, all the runner's workers have exited. Another call, or Stop,
+// after it returns at once: nil once the first call has finished. Pending tells what was left undone.
+func (r *Runner) Shutdown(ctx context.Context) error {
+	r.mu.Lock()
+	if r.stopping {
+		r.mu.Unlock()
+		select {
+		case <-r.done:
+			return nil
+		default:
+			return fmt.Errorf("%w: a shutdown is already in progress", ErrStopped)
+		}
+	}
+	r.stopping = true
+	if !r.started {
+		close(r.exited)
+	}
+	r.wake.Broadcast()
+	r.mu.Unlock()
+
+	var err error
+	select {
+	case <-r.exited:
+	case <-ctx.Done():
+		r.mu.Lock()
+		busy := r.running > 0
+		r.mu.Unlock()
+		if busy {
+			r.cancel()
+			err = ctx.Err()
+		}
+		<-r.exited
+	}
+	r.cancel()
+	close(r.done)
+	return err
+}
+
+// Stop does what Shutdown does, giving the running jobs StopTimeout to finish.
 func (r *Runner) Stop() {
-	close(r.queue)
+	ctx, cancel := context.WithTimeout(context.Background(), StopTimeout)
+	defer cancel()
+	if err := r.Shutdown(ctx); err != nil && !errors.Is(err, ErrStopped) {
+		r.log.Warn("stop: running jobs were canceled", "err", err)
+	}
+}
+
+// Pending returns the jobs that still need to run, in the order they were enqueued: before Shutdown, the queued jobs that
+// have not started; after it, the jobs that never started followed by the jobs whose context Shutdown canceled and that
+// returned an error. The caller saves them.
+func (r *Runner) Pending() []Job {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	canceled := slices.Clone(r.canceled)
+	slices.SortFunc(canceled, func(a, b entry) int { return cmp.Compare(a.seq, b.seq) })
+	out := make([]Job, 0, len(r.queue)+len(canceled))
+	for _, e := range r.queue {
+		out = append(out, e.job)
+	}
+	for _, e := range canceled {
+		out = append(out, e.job)
+	}
+	return out
 }
