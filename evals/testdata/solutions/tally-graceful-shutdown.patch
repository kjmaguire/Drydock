+// call runs a job, recovering a panic; ok is false when the job panicked.
+func (r *Runner) call(j Job) (ok bool, err error) {
+	defer func() {
+		if v := recover(); v != nil {
+			r.log.Error("job panicked", "job", j.Name, "panic", v, "stack", string(debug.Stack()))
+			ok, err = false, nil
+		}
+	}()
+	return true, j.Run(r.ctx)
+}
+
+// Enqueue adds a job to the queue without waiting. It returns ErrQueueFull when the queue has no room, and ErrStopped once
+// Shutdown or Stop was called.
 func (r *Runner) Enqueue(j Job) error {
-	select {
-	case r.queue <- j:
-		return nil
-	default:
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.stopping {
+		return ErrStopped
+	}
+	if len(r.queue) >= r.queueSize+r.idle {
 		return ErrQueueFull
 	}
+	r.seq++
+	r.queue = append(r.queue, entry{seq: r.seq, job: j})
+	r.wake.Signal()
+	return nil
