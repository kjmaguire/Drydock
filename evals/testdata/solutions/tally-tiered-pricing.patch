+// TieredAmount returns the charge for a quantity of a tiered plan, in minor units. A tier's UpTo is inclusive; the tiers are
+// sorted by UpTo and the last one has no upper limit (store.Plan's tiers always are).
+//
+//   - Graduated: each unit is priced at the unit amount of the tier it falls in (units 1 to UpTo of the first tier, the next
+//     units in the next tier, and so on), plus the flat amount of every tier that at least one unit falls in.
+//   - Volume: every unit is priced at the unit amount of the one tier the whole quantity falls in, plus that tier's flat
+//     amount.
+//
+// A quantity of 0 (or less) costs 0 in both modes.
+func TieredAmount(tiers []store.Tier, mode store.TiersMode, quantity int64) int64 {
+	if quantity <= 0 || len(tiers) == 0 {
+		return 0
+	}
+	if mode == store.Volume {
+		t := tiers[len(tiers)-1]
+		for _, tier := range tiers {
+			if tier.UpTo == nil || quantity <= *tier.UpTo {
+				t = tier
+				break
+			}
+		}
+		return quantity*t.UnitAmount + t.FlatAmount
+	}
+	var total, done int64 // done: the units priced so far
+	for _, t := range tiers {
+		upper := quantity
+		if t.UpTo != nil && *t.UpTo < upper {
+			upper = *t.UpTo
+		}
+		if upper <= done {
+			continue
+		}
+		total += (upper-done)*t.UnitAmount + t.FlatAmount
+		done = upper
+		if done == quantity {
+			break
+		}
+	}
+	return total
+}
