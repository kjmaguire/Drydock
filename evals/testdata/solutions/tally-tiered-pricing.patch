+func TestTieredPlanBillsUsageAtRenewal(t *testing.T) {
+	e := apitest.New(t)
+	ctx := context.Background()
+	limit := int64(100)
+	p, err := e.Store.CreatePlan(store.Plan{OrgID: e.Acme.ID, Name: "API calls", Currency: money.USD, Interval: store.Monthly, UsageType: store.Metered,
+		TiersMode: store.Graduated, Tiers: []store.Tier{{UpTo: &limit, UnitAmount: 10}, {UnitAmount: 5, FlatAmount: 300}}}, e.Clock.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	busy := e.CreateCustomer(e.Acme, "Busy", "busy@example.com")
+	idle := e.CreateCustomer(e.Acme, "Idle", "idle@example.com")
+	sub, _ := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: busy.ID, PlanID: p.ID})
+	quiet, _ := e.Subs.Create(ctx, e.Acme.ID, subscriptions.CreateInput{CustomerID: idle.ID, PlanID: p.ID})
+	if _, err := e.Store.AddUsage(e.Acme.ID, sub.ID, 150, e.Clock.Now(), e.Clock.Now()); err != nil {
+		t.Fatal(err)
+	}
+	e.Clock.Set(sub.CurrentPeriodEnd)
+	if _, err := e.Subs.RenewDue(ctx); err != nil {
+		t.Fatal(err)
+	}
+	invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: sub.ID})
+	if len(invs) != 1 || len(invs[0].Lines) != 1 || invs[0].Lines[0].Quantity != 1 || invs[0].Lines[0].UnitAmount != 1550 ||
+		!strings.HasPrefix(invs[0].Lines[0].Description, "API calls") {
+		t.Fatalf("invoices = %+v (100 x 10 + 50 x 5 + 300)", invs)
+	}
+	if invs := e.Store.ListInvoices(e.Acme.ID, store.InvoiceFilter{SubscriptionID: quiet.ID}); len(invs) != 0 {
+		t.Fatalf("a period without usage was invoiced: %+v", invs)
+	}
