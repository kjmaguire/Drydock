+// checkTiers checks a plan's tiers: only a metered plan has them, with the mode graduated or volume; there is at least one
+// tier; every tier's up_to is a positive whole number, strictly greater than the one before, except the last tier's, which
+// is nil (no upper limit); and no amount is negative.
+func checkTiers(p Plan) error {
+	if len(p.Tiers) == 0 && p.TiersMode == "" {
+		return nil
+	}
+	bad := func(format string, args ...any) error {
+		return fmt.Errorf("%w: %s", ErrInvalidTiers, fmt.Sprintf(format, args...))
+	}
+	switch {
+	case p.UsageType != Metered:
+		return bad("only a metered plan has tiers")
+	case p.TiersMode != Graduated && p.TiersMode != Volume:
+		return bad("tiers_mode is graduated or volume")
+	case len(p.Tiers) == 0:
+		return bad("a tiered plan needs at least one tier")
+	}
+	for i, t := range p.Tiers {
+		last := i == len(p.Tiers)-1
+		switch {
+		case t.UnitAmount < 0 || t.FlatAmount < 0:
+			return bad("tier %d has a negative amount", i+1)
+		case last && t.UpTo != nil:
+			return bad("the last tier has no upper limit: its up_to is null")
+		case !last && t.UpTo == nil:
+			return bad("only the last tier has no upper limit")
+		case !last && *t.UpTo <= 0:
+			return bad("tier %d: up_to is a positive whole number", i+1)
+		case !last && i > 0 && *t.UpTo <= *p.Tiers[i-1].UpTo:
+			return bad("tier %d: up_to must be greater than the tier before's", i+1)
+		}
+	}
 	return nil
 }
 
+// copyPlan is a deep copy, so callers cannot change stored tiers.
+func copyPlan(p Plan) Plan {
+	if p.Tiers != nil {
+		tiers := make([]Tier, len(p.Tiers))
+		for i, t := range p.Tiers {
+			if t.UpTo != nil {
+				n := *t.UpTo
+				t.UpTo = &n
+			}
+			tiers[i] = t
+		}
+		p.Tiers = tiers
+	}
+	return p
+}
