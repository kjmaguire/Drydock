+// parseTiers reads tiers as POST /v1/plans takes them. The store checks the rest (store.ErrInvalidTiers).
+func parseTiers(in []tierInput, c money.Currency) ([]store.Tier, error) {
+	if len(in) == 0 {
+		return nil, errors.New("a tiered plan needs at least one tier")
+	}
+	if !c.Valid() {
+		return nil, fmt.Errorf("unknown currency %q", c)
+	}
+	out := make([]store.Tier, 0, len(in))
+	for i, t := range in {
+		var tier store.Tier
+		if raw := strings.TrimSpace(string(t.UpTo)); raw != "" && raw != "null" {
+			n, err := strconv.ParseInt(raw, 10, 64)
+			if err != nil {
+				return nil, fmt.Errorf("tier %d: up_to is a whole number or null", i+1)
+			}
+			tier.UpTo = &n
+		}
+		var err error
+		if tier.UnitAmount, err = money.ParseMajor(t.UnitAmount, c); err != nil {
+			return nil, fmt.Errorf("tier %d: unit_amount: %v", i+1, err)
+		}
+		if t.FlatAmount != "" {
+			if tier.FlatAmount, err = money.ParseMajor(t.FlatAmount, c); err != nil {
+				return nil, fmt.Errorf("tier %d: flat_amount: %v", i+1, err)
+			}
+		}
+		out = append(out, tier)
+	}
+	return out, nil
+}
