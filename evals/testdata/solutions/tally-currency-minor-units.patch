+func TestPricesWithTheCurrencysDecimals(t *testing.T) {
+	e := apitest.New(t)
+	type plan struct {
+		UnitAmount     int64  `json:"unit_amount"`
+		Price          string `json:"price"`
+		PriceFormatted string `json:"price_formatted"`
+	}
+	for _, c := range []struct {
+		currency, price string
+		want            plan
+	}{
+		{"JPY", "1000", plan{1000, "1000", "¥1,000"}},
+		{"KWD", "1.25", plan{1250, "1.250", "KWD 1.250"}},
+		{"KWD", "7", plan{7000, "7.000", "KWD 7.000"}},
+		{"USD", "1234.5", plan{123450, "1234.50", "$1,234.50"}},
+	} {
+		var got plan
+		e.MustDo(http.StatusCreated, "POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "P", "currency": c.currency, "price": c.price, "interval": "month"}, &got)
+		if got != c.want {
+			t.Errorf("%s %s: plan = %+v, want %+v", c.price, c.currency, got, c.want)
+		}
+	}
+	for _, c := range []struct{ currency, price string }{{"JPY", "1000.5"}, {"JPY", "1000.0"}, {"KWD", "1.2345"}, {"USD", "1.234"}} {
+		if r := e.Do("POST", "/v1/plans", e.Acme.Key, map[string]any{"name": "P", "currency": c.currency, "price": c.price, "interval": "month"}); r.Code != http.StatusUnprocessableEntity || r.Map(t)["error"] != "invalid_amount" {
+			t.Errorf("%s %s: %s", c.price, c.currency, r)
+		}
+	}
+	cust := e.CreateCustomer(e.Acme, "Jane", "jane@example.com")
+	var inv struct {
+		Total          int64  `json:"total"`
+		TotalFormatted string `json:"total_formatted"`
+	}
+	e.MustDo(http.StatusCreated, "POST", "/v1/invoices", e.Acme.Key, map[string]any{"customer_id": cust.ID, "currency": "KWD",
+		"lines": []map[string]any{{"description": "Seats", "quantity": 2, "unit_amount": 1250}}}, &inv)
+	if inv.Total != 2500 || inv.TotalFormatted != "KWD 2.500" {
+		t.Fatalf("KWD invoice = %+v", inv)
+	}
+}
